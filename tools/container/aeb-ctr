#!/usr/bin/env bash
# aeb-ctr — aeb for an immutable host: COMPILE in a container, EXECUTE on the host.
#
# Identical CLI to `aeb`, but the toolchain-needing work runs in a podman
# container (the host has no gcc/aetherc), while the build program and the
# binaries it produces RUN on the host. The two-aeb duality (one binary, two
# instances) — see docs/two-aeb-duality.md.
#
# Aether is COMPILED, so a build has two phases:
#   Phase 1 (--noexe, IN container): compile the .ae build scripts into the
#            native orchestrator (target/_ae_build_all). Lands on the host via
#            the bind mount; not run.
#   Phase 2 (ON host): run the orchestrator. It does the build; each per-target
#            `ae build` it triggers is delegated back into the container by
#            AEB_COMPILE_CONTAINER (the lib/aether seam). Execution / tests run
#            native on the host with the host's runtimes.
# Net: all compilation in the container, all execution on the host.
#
# Both phases were verified by hand on a real Bazzite box before this script
# existed; aeb-ctr just sequences them.
#
# Usage:   aeb-ctr <target> [aeb args...]      # e.g. aeb-ctr app/.build.ae
#
# Env (all optional):
#   AEB_CTR_IMAGE     toolchain+aeb image   (default: aeb-toolchain:slim)
#   AEB_CTR_ROOT      repo root (mounted)   (default: $PWD)
#   AEB_CONTAINER_ENGINE   podman|docker    (default: podman)
#   AEB_CONTAINER_SELABEL  SELinux mount label suffix (default: Z; "" to omit)
#
# Bazzite/SELinux notes (proven the hard way, see ../../../aether ctr_notes):
#   - mounts use :Z (relabel); do NOT relabel $HOME — run from a repo subdir.
#   - NO --userns=keep-id (crashes this crun; output is correctly user-owned
#     without it).
set -euo pipefail

IMAGE="${AEB_CTR_IMAGE:-aeb-toolchain:slim}"
ROOT="${AEB_CTR_ROOT:-$PWD}"
ENGINE="${AEB_CONTAINER_ENGINE:-podman}"
SELABEL="${AEB_CONTAINER_SELABEL-Z}"

if [ $# -eq 0 ]; then
    sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
fi

# Refuse to relabel $HOME (Bazzite rejects it) — the run dir must be a subdir.
if [ "$ROOT" = "$HOME" ]; then
    echo "aeb-ctr: run from a repo SUBDIR, not \$HOME (SELinux refuses :Z relabel of \$HOME)" >&2
    exit 2
fi

mount="-v ${ROOT}:/work"
if [ -n "$SELABEL" ]; then mount="${mount}:${SELABEL}"; fi

say() { printf '\n\033[1m== aeb-ctr: %s\033[0m\n' "$*"; }

# --- Host-language runtime soname: EXPLICIT, no probing, no fallback ---------
# The aether bridges (python/ruby/perl/lua/js/tcl) dlopen the host lib at
# runtime — NO -lfoo / link flags (the bridge .a has no unresolved interpreter
# symbols; ae build adds nothing). As of aether v0.213.0 the bridge uses a
# STRICT contract: it tries ${AETHER_<LANG>_SONAME} then a bare libfoo.so, then
# errors clearly. aeb-ctr does NOT probe/guess the soname — no ldconfig scans,
# no sysconfig/RbConfig/tclsh introspection, no version pattern-matching. You
# hand in the EXACT soname for the host language(s) your build hosts, via env:
#
#   AETHER_PYTHON_SONAME=libpython3.11.so.1.0 \
#   AETHER_RUBY_SONAME=libruby.so.3.4          \
#   AETHER_LUA_SONAME=liblua-5.4.so            \
#   AEB_CTR_IMAGE=aeb-toolchain-lua:slim aeb-ctr hostlua/.build.ae
#
# Only the vars you set are forwarded; anything unset just isn't passed, and the
# bridge reports its strict error (which names the var). Explicit and
# deterministic — the orchestrator states the contract, it does not infer it.
PASS_ENV=""
for _v in AETHER_PYTHON_SONAME AETHER_RUBY_SONAME AETHER_PERL_SONAME \
          AETHER_LUA_SONAME AETHER_JS_SONAME AETHER_TCL_SONAME; do
    # shellcheck disable=SC2154
    eval "_val=\${$_v:-}"
    if [ -n "$_val" ]; then PASS_ENV="$PASS_ENV -e $_v"; fi
done

# --- Phase 1: COMPILE in the container (--compile-only) ---------------------
# In-container aeb builds the orchestrator (_ae_build_all) AND runs it in
# compile-only mode: every node compiles (every SDK — the container has the
# toolchain), nothing runs. The orchestrator binary AND all node artifacts
# land on the host via the mount. Host-runtime link flags passed in so
# host-language binaries link against the HOST's libs.
say "phase 1 — compile in $IMAGE (--compile-only)"
"$ENGINE" run --rm $mount -w /work $PASS_ENV --entrypoint aeb "$IMAGE" --compile-only "$@"

ORCH="${ROOT}/target/_ae_build_all"
if [ ! -x "$ORCH" ]; then
    echo "aeb-ctr: phase 1 did not produce $ORCH — aborting" >&2
    exit 1
fi

# --- Phase 2: EXECUTE on the host (--execute-only) --------------------------
# RUN the orchestrator Phase 1 already built (don't rebuild it — the host has
# no toolchain). In execute-only mode it walks the same DAG and runs only the
# execute steps (produced binaries / tests) natively on the host, with the
# host's runtimes (libpython, …). No container, no recompile. Composite exes
# carry their dep closure, so no manifest is needed. Any AETHER_<LANG>_SONAME you
# set is already in aeb-ctr's environment, so the orchestrator (and the binaries
# it execs) inherit it here — this is where the host-side dlopen actually uses
# it, so an explicit soname is what makes the bridge find the lib on hosts with
# no bare libfoo.so symlink (e.g. Bazzite/Fedora).
say "phase 2 — execute on host (--execute-only)"
AEB_EXECUTE_ONLY=1 "$ORCH" "$ROOT"

say "done — compiled in $IMAGE, executed on host"
