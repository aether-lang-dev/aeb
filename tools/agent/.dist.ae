// Build the aeb-agent binary WITH aeb (dogfood) — the "produce the
// artifact" node. Paired with .install.ae (which deps this and PLACES
// the binary + wrapper). aeb building its own remote-agent satellite;
// exercises aether.program on a real multi-import Aether program (the
// agent imports the `agent` SDK from lib/ + std.http.client).
//
//   aeb tools/agent/.dist.ae      # → target/tools/agent/bin/aeb-agent
//
// NOT wired into `make`. The agent is an opt-in network server; `make`
// must not recurse into aeb to build it. Build + install it deliberately:
//   aeb tools/agent/.install.ae   (deps this, then installs to ~/.local)
import bldr
import aether
import aether (source, output)
main() {
    bldr.build() {
        aether.program() {
            source("../aeb-agent.ae")
            output("aeb-agent")
        }
    }
}
