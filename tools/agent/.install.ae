// Install the aeb-agent binary + wrapper — the "place the artifact" node.
// Deps .dist.ae (which builds the binary via aeb), then copies it into
// the install tree and writes the bin/aeb-agent wrapper. This REPLACES
// the old `make install-agent` target: if aeb builds the agent, aeb
// installs it too — `make` stays out of the remote-agent path entirely.
//
//   aeb tools/agent/.install.ae
//
// Prefix is hardcoded to ~/.local for now (skeleton; a PREFIX env knob is
// a later thickening). The wrapper pins AEB_HOME and puts ~/.local/bin on
// PATH so the agent's own `aeb <target>` runs resolve the installed aeb.
//
// dep on .dist.ae is the aeb-native sequencing: the binary is built
// before this node runs (topo order), and a build failure of .dist
// reddens this install via the normal DAG.
import bldr
import bldr (dep)
import std.os
import std.io
import std.string

extern println(s: string)

main() {
    bldr.build() {
        dep("tools/agent/.dist.ae")
    
        root = root()
        // .dist.ae is a `.dist.ae` node, so aeb lands its aether.program output
        // under target/dist/<module>/bin/ (the dist: node type prefixes "dist/").
        // (Was target/tools/agent/bin — the missing "dist/" made the copy fail.)
        src_bin = string.concat(root, "/target/dist/tools/agent/bin/aeb-agent")
    
        home = os.getenv("HOME")
        share = string.concat(home, "/.local/share/aeb")
        bindir = string.concat(home, "/.local/bin")
        dst_bin = string.concat(share, "/tools/aeb-agent")
        wrapper = string.concat(bindir, "/aeb-agent")
    
        // Copy the built binary into the installed runtime tree.
        _m1 = os.system(string.concat(string.concat("mkdir -p '", string.concat(share, "/tools'")), ""))
        _m2 = os.system(string.concat("mkdir -p '", string.concat(bindir, "'")))
        rc = os.system(string.concat(string.concat("cp -f '", src_bin), string.concat("' '", string.concat(dst_bin, "'"))))
        if rc != 0 {
            println("aeb-agent install: failed to copy ${src_bin} → ${dst_bin}")
            fail("aeb-agent install: copy failed (did .dist build it?)")
            return 1
        }
    
        // Write the wrapper (pins AEB_HOME, puts ~/.local/bin on PATH so the
        // agent's `aeb <target>` runs resolve). Built via a heredoc to a temp
        // then moved, to dodge ${...} interpolation eating the bash bits.
        w = "#!/usr/bin/env bash\n"
        w = string.concat(w, "# aeb-agent wrapper — generated by aeb tools/agent/.install.ae\n")
        w = string.concat(w, string.concat(string.concat("export AEB_HOME=\"", share), "\"\n"))
        w = string.concat(w, string.concat(string.concat("export PATH=\"", bindir), ":$PATH\"\n"))
        w = string.concat(w, string.concat(string.concat("exec \"", dst_bin), "\" \"$@\"\n"))
        werr = io.write_file(wrapper, w)
        if string.length(werr) > 0 {
            println("aeb-agent install: failed to write wrapper ${wrapper}: ${werr}")
            fail("aeb-agent install: wrapper write failed")
            return 1
        }
        _c = os.system(string.concat("chmod +x '", string.concat(wrapper, "'")))
    
        println("aeb-agent installed:")
        println("  binary:  ${dst_bin}")
        println("  wrapper: ${wrapper}")
        println("  (run:  aeb-agent --port N --accept '<glob>' --workdir DIR --tokens <file>)")
        return 0
    }
}
