// Install the aeb-agent binary + wrapper — the "place the artifact" node.
// Deps .dist.ae (which builds the binary via aeb), then installs it via
// bldr.install_launcher: copy into ~/.local/share/aeb/tools + write a
// ~/.local/bin/aeb-agent wrapper. This REPLACES the old `make install-agent`
// target: if aeb builds the agent, aeb installs it too — `make` stays out of
// the remote-agent path entirely.
//
//   aeb tools/agent/.install.ae
//
// with_path(): the agent's own `aeb <target>` runs must resolve the installed
// aeb, so the wrapper puts ~/.local/bin on PATH. dep on .dist.ae is the
// aeb-native sequencing — the binary builds first (topo order), and a .dist
// failure reddens this install via the normal DAG.
import bldr
import bldr (dep, install_launcher, from_dist, with_path)

aeb(cap) {
    bldr.build() {
        dep("tools/agent/.dist.ae")
        bldr.install_launcher("aeb-agent") {
            from_dist("tools/agent")
            with_path()
        }
    }
}
