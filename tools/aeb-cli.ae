// aeb-cli — the Aether-native aeb entrypoint (replacing the bash trampoline).
//
// This is the IMPURE executor that runs the pure directive plan produced by
// tools/aebcli's parse_argv. The split is deliberate: the whole argv grammar
// (flag table, synonym resolution, coordinate/timeout/missing-arg errors) is
// pure and unit-tested in aebcli; this file does only the effects — read
// argv, set env, resolve synonyms against the filesystem, print, exit. See
// TODO.md § "Full Aether CLI entrypoint".
//
// STATUS: DONE for the base case. Front-end complete AND the supervised exec
// is WIRED (the os.run_supervised call below) — own process group,
// signal-forward, timeout, group-reap, one cross-platform call (POSIX process
// groups / Windows Job Objects). The upstream argv-corruption blocker
// (aether #688 — os.run* mangled heap-allocated argv strings) is FIXED in ae
// 0.239.0, and a Phase-1 A/B against ../google-monorepo-sim now passes:
// aeb-cli builds a target with IDENTICAL output + artifacts + exit code to the
// bash trampoline. Remaining: the --sandbox prefix arm (prepend aeb-sandbox)
// and the full-repo A/B harness (ab.sh). See mingw_a_b_plan.md.

import aebcli
import build
import std.string
import std.list
import std.os
import std.file
import std.fs
import std.io

extern println(s: string)
extern exit(code: int)
extern aether_args_count() -> int
extern aether_args_get(i: int) -> string

_err(msg: string) {
    _w = io.stderr_write(string.concat(msg, "\n"))
}

// AEB_HOME: the env override, else the directory of argv[0] (this binary).
// Mirrors the bash `AEB_HOME="$(cd "$(dirname "$0")" && pwd)"`, but uses the
// native cross-platform _dirname (no `dirname` shell-out).
_resolve_aeb_home() {
    h = os.getenv("AEB_HOME")
    if string.length(h) > 0 {
        return h
    }
    // The bash trampoline lives AT <repo>/aeb, so dirname($0) = <repo>. This
    // binary builds to <repo>/tools/aeb-cli, so dirname(argv0) = <repo>/tools
    // — one level too deep (lib/ is at <repo>/lib). Walk up out of tools/.
    d = build._dirname(aether_args_get(0))
    base = build._basename(d)
    if string.equals(base, "tools") == 1 {
        return build._dirname(d)
    }
    return d
}

// The build root (cwd), as the bash captures with ROOT="$(pwd)". Uses the
// native cross-platform os.getcwd() (ae 0.231+) — no `pwd` shell-out.
_resolve_root() {
    return os.getcwd()
}

// `--version`: provenance from $AEB_HOME/AEB_STAMP (parsed with the pure
// stamp_field), then the underlying ae version. Mirrors the bash.
_print_version(aeb_home: string) {
    stamp = string.concat(aeb_home, "/AEB_STAMP")
    if file.exists(stamp) == 1 {
        text, _e = fs.read(stamp)
        src = aebcli.stamp_field(text, "src")
        commit = aebcli.stamp_field(text, "commit")
        installed = aebcli.stamp_field(text, "installed")
        toolchain = aebcli.stamp_field(text, "toolchain")
        println("aeb 0.0.0-dev+${src}   (git ${commit}, installed ${installed})")
        println("  AEB_HOME     ${aeb_home}")
        println("  tools built  ${toolchain}")
    }
    else {
        println("aeb 0.0.0-dev   (no AEB_STAMP — un-installed tree at ${aeb_home})")
    }
    aether = os.getenv("AETHER")
    if string.length(aether) == 0 { aether = "ae" }
    av, _ae = build._sh_capture("${aether} --version 2>/dev/null | head -1")
    av_t = string.trim(av)
    if string.length(av_t) > 0 { println(av_t) }
}

// Podman socket autodetect for TestContainers — the bash
// `[[ -z DOCKER_HOST ]] && [[ -S /run/user/<uid>/podman/podman.sock ]]`.
// POSIX-only (no Windows socket path); a no-op when DOCKER_HOST is set or
// the socket is absent.
_maybe_podman() {
    if string.length(os.getenv("DOCKER_HOST")) > 0 {
        return 0
    }
    if build._is_windows() == 1 {
        return 0
    }
    uid, _u = build._sh_capture("id -u")
    sock = string.concat(string.concat("/run/user/", string.trim(uid)), "/podman/podman.sock")
    if file.exists(sock) == 1 {
        _s = os.setenv("DOCKER_HOST", string.concat("unix://", sock))
    }
    return 0
}

main() {
    argc = aether_args_count()
    aeb_home = _resolve_aeb_home()
    _se = os.setenv("AEB_HOME", aeb_home)

    // --version short-circuit (the bash inspects $1 only).
    if argc >= 2 {
        if string.equals(aether_args_get(1), "--version") == 1 {
            _print_version(aeb_home)
            exit(0)
        }
    }

    _maybe_podman()

    // argv (excluding arg 0) -> the pure directive plan.
    av = list.new()
    i = 1
    while i < argc {
        _xa = list.add(av, aether_args_get(i))
        i = i + 1
    }
    directives = aebcli.parse_argv(av)

    // Execute the plan: env-set / accumulate, collect targets, resolve
    // synonyms (file-check + the `aeb synonym match:` echo), fail on error.
    targets = list.new()
    env_shown = list.new()
    n = list.size(directives)
    j = 0
    while j < n {
        d, _gd = list.get(directives, j)
        kind = aebcli.directive_kind(d)
        if string.equals(kind, "error") == 1 {
            code_s = aebcli.directive_field(d, 1)
            msg = aebcli.directive_field(d, 2)
            _err(msg)
            exit(_atoi(code_s))
        }
        if string.equals(kind, "env") == 1 {
            name = aebcli.directive_field(d, 1)
            val = aebcli.directive_field(d, 2)
            _e1 = os.setenv(name, val)
            _ev1 = list.add(env_shown, string.concat(string.concat(name, "="), val))
        }
        if string.equals(kind, "env-append") == 1 {
            name = aebcli.directive_field(d, 1)
            val = aebcli.directive_field(d, 2)
            merged = aebcli.env_append_value(os.getenv(name), val)
            _e2 = os.setenv(name, merged)
            _ev2 = list.add(env_shown, string.concat(string.concat(name, "="), merged))
        }
        if string.equals(kind, "arg") == 1 {
            _t1 = list.add(targets, aebcli.directive_field(d, 1))
        }
        if string.equals(kind, "synonym") == 1 {
            relpath = aebcli.directive_field(d, 1)
            fqn = aebcli.directive_field(d, 2)
            if file.exists(relpath) == 0 {
                _err("aeb: synonym '${fqn}' → no such build file '${relpath}'")
                exit(2)
            }
            println("aeb synonym match: ${fqn}")
            _t2 = list.add(targets, fqn)
        }
        j = j + 1
    }

    // Resolve the launch the supervision tail execs.
    aether = os.getenv("AETHER")
    if string.length(aether) == 0 { aether = "ae" }
    root = _resolve_root()

    // The Aether-native entry point: tools/aeb-main, lazy-built if absent
    // (mirrors the bash `[[ ! -x ]] && ae build …`).
    main_bin = string.concat(aeb_home, "/tools/aeb-main")
    if file.exists(main_bin) == 0 {
        src = string.concat(aeb_home, "/tools/aeb-main.ae")
        _bc = build._sh("'${aether}' build '${src}' -o '${main_bin}' 2>/dev/null")
    }

    // Assemble the argv the bash supervision tail passes:
    //   aeb-main <aether> <aeb_home> <root> <targets...>
    // (Under --sandbox the bash prepends the aeb-sandbox wrapper; that arm is
    // a follow-up — base case first per the MINGW A/B plan.)
    // Copy each string (concat "") into the argv list. os.getcwd()'s buffer and
    // the list.get'd target strings are pointers into storage that can be
    // reused before run_supervised serialises argv — a fresh copy pins the
    // bytes. (Without this, the child sees corrupted/aliased argv — observed:
    // root + targets came through as garbage pointer bytes.)
    argv = list.new()
    _a0 = list.add(argv, string.concat(aether, ""))
    _a1 = list.add(argv, string.concat(aeb_home, ""))
    _a2 = list.add(argv, string.concat(root, ""))
    ti = 0
    tn = list.size(targets)
    while ti < tn {
        t, _gt = list.get(targets, ti)
        _at = list.add(argv, string.concat(t, ""))
        ti = ti + 1
    }

    // --timeout N / AEB_TIMEOUT=N (seconds; unset/0 = none) — already in env
    // (the directive plan setenv'd it from the flag); read it back.
    timeout_secs = _atoi(os.getenv("AEB_TIMEOUT"))

    // Supervised exec: own process group, forward Ctrl-C/TERM to the group,
    // enforce the timeout, group-reap any survivors. ONE cross-platform call
    // (POSIX process groups / Windows Job Objects) — the whole bash `set -m` +
    // trap + watchdog + reap tail. env=null inherits this process's env (we
    // already setenv'd AEB_HOME + the directive-plan vars in-process).
    code, _outcome = os.run_supervised(main_bin, argv, null, 1, 1, timeout_secs, 1)
    exit(code)
}

// Tiny non-negative atoi for the error exit code (directive codes are "1"/"2").
_atoi(s: string) {
    n = string.length(s)
    v = 0
    digits = "0123456789"
    i = 0
    while i < n {
        ch = string.substring(s, i, i + 1)
        idx = string.index_of(digits, ch)
        if idx >= 0 { v = v * 10 + idx }
        i = i + 1
    }
    return v
}

_print_list(prefix: string, l: ptr) {
    n = list.size(l)
    i = 0
    while i < n {
        item, _g = list.get(l, i)
        println(string.concat(prefix, item))
        i = i + 1
    }
}
