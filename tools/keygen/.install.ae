// Install the aeb-keygen binary + wrapper — the "place the artifact" node.
// Deps .dist.ae (which builds the binary via aeb), then installs it via
// bldr.install_launcher: copy into ~/.local/share/aeb/tools + write a
// ~/.local/bin/aeb-keygen wrapper that pins AEB_HOME and exec's it.
//
//   aeb tools/keygen/.install.ae
//
// No with_path(): aeb-keygen is a plain tool (generates agent keypairs), it
// doesn't shell `aeb <target>` itself, so its wrapper needs no PATH export.
import bldr
import bldr (dep, install_launcher, from_dist)

aeb(cap) {
    bldr.build() {
        dep("tools/keygen/.dist.ae")
        bldr.install_launcher("aeb-keygen") {
            from_dist("tools/keygen")
        }
    }
}
