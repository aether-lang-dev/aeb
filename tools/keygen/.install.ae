// Install the aeb-keygen binary + wrapper — generates an aeb lease signing
// SECRET ("aeb-secret-v1:<random>"). Deps .dist.ae (builds it via aeb), then
// copies it into the install tree and writes the bin/aeb-keygen wrapper.
// Mirrors tools/lease/.install.ae; OPT-IN, NOT in `make` (you only need a
// secret generator if you run agents).
//
//   aeb tools/keygen/.install.ae
//
// Prefix hardcoded to ~/.local (skeleton). The wrapper pins AEB_HOME for
// parity with the agent/lease wrappers, though aeb-keygen only needs the lib.
import bldr
import bldr (dep)
import std.os
import std.io
import std.string

extern println(s: string)

main() {
    b = bldr.start()
    dep(b, "tools/keygen/.dist.ae")

    root = bldr.root(b)
    src_bin = string.concat(root, "/target/dist/tools/keygen/bin/aeb-keygen")

    home = os.getenv("HOME")
    share = string.concat(home, "/.local/share/aeb")
    bindir = string.concat(home, "/.local/bin")
    dst_bin = string.concat(share, "/tools/aeb-keygen")
    wrapper = string.concat(bindir, "/aeb-keygen")

    _m1 = os.system(string.concat("mkdir -p '", string.concat(share, "/tools'")))
    _m2 = os.system(string.concat("mkdir -p '", string.concat(bindir, "'")))
    rc = os.system(string.concat(string.concat("cp -f '", src_bin), string.concat("' '", string.concat(dst_bin, "'"))))
    if rc != 0 {
        println("aeb-keygen install: failed to copy ${src_bin} → ${dst_bin}")
        bldr.fail(b, "aeb-keygen install: copy failed (did .dist build it?)")
        return 1
    }

    w = "#!/usr/bin/env bash\n"
    w = string.concat(w, "# aeb-keygen wrapper — generated by aeb tools/keygen/.install.ae\n")
    w = string.concat(w, string.concat(string.concat("export AEB_HOME=\"", share), "\"\n"))
    w = string.concat(w, string.concat(string.concat("exec \"", dst_bin), "\" \"$@\"\n"))
    werr = io.write_file(wrapper, w)
    if string.length(werr) > 0 {
        println("aeb-keygen install: failed to write wrapper ${wrapper}: ${werr}")
        bldr.fail(b, "aeb-keygen install: wrapper write failed")
        return 1
    }
    _c = os.system(string.concat("chmod +x '", string.concat(wrapper, "'")))

    println("aeb-keygen installed:")
    println("  binary:  ${dst_bin}")
    println("  wrapper: ${wrapper}")
    println("  (make a secret:  mkdir -p ~/.local/share/aeb && aeb-keygen > ~/.local/share/aeb/lease.secret)")
    return 0
}
