// aeb-driver — per-node runner for nodes-as-subprocesses
// (docs/nodes-as-subprocesses.md).
//
// Runs each build node as its own invocation of the linked orchestrator
// binary (`out_bin <root> <label>`, slice A's selector), redirecting that
// node's stdout+stderr into target/.aeb/logs/<label>.log. aeb's own
// stdout then carries only framing + the telemetry summary — per-target
// tool output (javac/junit/jest…) is compartmentalized into the logs.
//
// Parallelism: the driver emits a Makefile (one PHONY target per node,
// prerequisites = its dep nodes from the edges file, recipe = the per-node
// run) and lets `make -jN` schedule it — dep-respecting concurrency + the
// job cap, for free. If `make` is unavailable (or AEB_JOBS=1) it falls
// back to the sequential loop, so the default path never hard-breaks.
//
// Usage: aeb-driver <root> <out_bin> <edges_file>
//   edges_file: one line per node — "<node.ae> <dep1.ae> <dep2.ae> ..."
//   (topo-ordered, first word is the node). Same file aeb-link consumes.
//
// Reuses lib/build's marker readers + render so the summary is identical
// to the all-in-one path.
import build
import aeblabel (file_to_label, infer_type)
import agent (prereq_to_image)
import std.string
import std.os
import std.io
import std.file
import std.fs
import std.list
import std.map
import std.path

// Map any string to a flat, safe token (non-[alnum._-] -> '_').
_san(s: string) {
    keep = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.-"
    out = ""
    n = string.length(s)
    i = 0
    while i < n {
        ch = string.substring(s, i, i + 1)
        if string.index_of(keep, ch) >= 0 { out = string.concat(out, ch) }
        else { out = string.concat(out, "_") }
        i = i + 1
    }
    return out
}

_log_name(label: string) { return string.concat(_san(label), ".log") }

// First whitespace-separated word of a line, and the remainder (deps).
_first_word(line: string) {
    sp = string.index_of(line, " ")
    if sp < 0 { return line }
    return string.substring(line, 0, sp)
}

// _node_image(node, extract_deps_bin) — the toolchain image THIS node should
// build in, or "" for host-native. Reads the node's OWN prereq token (NOT the
// transitive set: `extract-deps --prereqs <one-file>` returns that file's own
// prereqs) and maps it via agent.prereq_to_image (rust:1.75 → aeb-tc:rust-1.75).
// Per-node-image routing (ladder Rung 4): a cross-language DAG builds each node
// in its own image — the rust node in the rust image, the jdk node in the jdk
// image — instead of forcing one image on the whole flattened target. Only the
// FIRST prereq token is used (a single node is one toolchain; multi-toolchain
// belongs to separate dep nodes). "" prereq → "" image (host-native node).
_node_image(node: string, extract_deps_bin: string) {
    raw, eerr = build._sh_capture(string.concat(extract_deps_bin, string.concat(" --prereqs '", string.concat(node, "' 2>/dev/null"))))
    if string.length(eerr) > 0 { return string.concat("", "") }
    t = string.trim(raw)
    if string.length(t) == 0 { return string.concat("", "") }
    // first whitespace/newline-delimited token
    sp = string.index_of(t, " ")
    nl = string.index_of(t, "\n")
    cut = sp
    if nl >= 0 {
        if cut < 0 { cut = nl }
        else { if nl < cut { cut = nl } }
    }
    tok = t
    if cut >= 0 { tok = string.substring(t, 0, cut) }
    if string.length(tok) == 0 { return string.concat("", "") }
    return prereq_to_image(tok)
}

// _container_node_invocation(node, root, label, image, engine, selabel) — run
// ONE node in its toolchain image, building it with the IMAGE's OWN aeb (NOT the
// host orchestrator binary: a host-linked `_ae_build_all` is built against the
// host glibc and won't run in an image with a different one — verified host
// 2.42 vs image 2.36 → `GLIBC_2.42 not found`). root is bind-mounted at /work,
// so a sibling node's artifact (a rust .so under target/) threads to a consumer
// node (the jdk javac link) through the shared mount.
//
// CRITICAL — single-node, NOT the dep closure: the deps are SEPARATE driver
// nodes already built in THEIR own images (their .so on the mount). Running
// `aeb <node>` (whole closure) in this image would rebuild the rust dep here →
// `cargo: not found` in the jdk image. So a TWO-STEP, both in the same image:
//   1. `aeb --noexe <node>` — generate + LINK the in-image orchestrator (runs
//      no node; glibc-matched to the image).
//   2. `_ae_build_all /work <label>` — run ONLY this node via the orchestrator's
//      per-node label selector (gen-orchestrator: run iff the label matches), so
//      deps (whose labels don't match) are NOT recompiled.
// Pure string assembly.
//
// REQUIRES: the image carries a recent-enough aeb. A stale image aeb fails
// cryptically — see asks/toolchain-image-aether-version-floor.md.
_container_node_invocation(node: string, root: string, label: string, image: string, engine: string, selabel: string) {
    // Build THIS ONE node in its toolchain image, NOT its dep closure. The deps
    // are separate driver nodes already built in THEIR images; their artifacts
    // are on the shared /work mount. So:
    //   1. `aeb --noexe <node>` — generate + LINK the orchestrator in-image
    //      (glibc-matched to the image; runs NO node) — cheap.
    //   2. `_ae_build_all /work <label>` — run ONLY this node via the
    //      orchestrator's per-node selector (gen-orchestrator: run iff label
    //      matches). This compiles just this node (e.g. cargo build → .so) with
    //      the image's toolchain; it does NOT rebuild the deps (whose labels
    //      don't match), so a rust dep is never compiled in the jdk image.
    // Running `aeb <node>` (whole closure) instead would rebuild the rust dep in
    // the jdk image → `cargo: not found`. The single-node selector is the fix.
    // -e AEB_NODE_CONTAINER=0: the inner aeb must not nest containers.
    mnt = string.concat(root, string.concat(":/work:", selabel))
    pfx = string.concat(engine, " run --rm -e AEB_NODE_CONTAINER=0 -v '")
    pfx = string.concat(pfx, mnt)
    pfx = string.concat(pfx, "' -w /work ")
    link = string.concat(pfx, "--entrypoint aeb '")
    link = string.concat(link, image)
    link = string.concat(link, "' --noexe '")
    link = string.concat(link, string.concat(node, "'"))
    run1 = string.concat(pfx, "--entrypoint /work/target/_ae_build_all '")
    run1 = string.concat(run1, image)
    run1 = string.concat(run1, "' /work '")
    run1 = string.concat(run1, string.concat(label, "'"))
    return string.concat(link, string.concat(" && ", run1))
}

// One per-node shell command: run the node, log it, record rc, fail with
// the node's rc. Written for a Makefile recipe (`$` -> `$$`) AND reused
// verbatim by the sequential fallback (where `$$`/`$?` are plain shell).
//
// `image` (Rung 4): when non-empty AND AEB_NODE_CONTAINER=1, the node-subprocess
// runs INSIDE that toolchain image via `<engine> run`, instead of host-native —
// so each node of a cross-language DAG builds in its own image. "" → host-native
// (today's behaviour, unchanged).
_node_cmd(out_bin: string, root: string, node: string, label: string, log: string, rcmark: string, image: string, engine: string, selabel: string) {
    inner = string.concat("'", out_bin)
    inner = string.concat(inner, "' '")
    inner = string.concat(inner, root)
    inner = string.concat(inner, "' '")
    inner = string.concat(inner, label)
    inner = string.concat(inner, "'")
    if string.length(image) > 0 {
        inner = _container_node_invocation(node, root, label, image, engine, selabel)
    }
    c = string.concat(inner, " > '")
    c = string.concat(c, log)
    c = string.concat(c, "' 2>&1; _r=$$?; echo $$_r > '")
    c = string.concat(c, rcmark)
    c = string.concat(c, "'; exit $$_r")
    return c
}

_node_cmd_timed(out_bin: string, root: string, node: string, label: string, log: string, rcmark: string, msmark: string, image: string, engine: string, selabel: string) {
    inner = string.concat("'", out_bin)
    inner = string.concat(inner, "' '")
    inner = string.concat(inner, root)
    inner = string.concat(inner, "' '")
    inner = string.concat(inner, label)
    inner = string.concat(inner, "'")
    if string.length(image) > 0 {
        inner = _container_node_invocation(node, root, label, image, engine, selabel)
    }
    c = string.concat("_s=$$(date +%s%3N 2>/dev/null || date +%s000); ", "")
    c = string.concat(c, inner)
    c = string.concat(c, " > '")
    c = string.concat(c, log)
    c = string.concat(c, "' 2>&1; _r=$$?; _e=$$(date +%s%3N 2>/dev/null || date +%s000); echo $$_r > '")
    c = string.concat(c, rcmark)
    c = string.concat(c, "'; echo $$((_e-_s)) > '")
    c = string.concat(c, msmark)
    c = string.concat(c, "'; exit $$_r")
    return c
}

main() {
    argc = aether_args_count()
    if argc < 4 {
        println("usage: aeb-driver <root> <out_bin> <edges_file>")
        exit(1)
    }
    root = aether_args_get(1)
    out_bin = aether_args_get(2)
    edges_file = aether_args_get(3)

    aeb_dir = path.join(path.join(root, "target"), ".aeb")
    logs_dir = path.join(aeb_dir, "logs")
    rc_dir = path.join(aeb_dir, "rc")
    build._mkdirs(logs_dir)
    build._mkdirs(rc_dir)

    // --- Parse the edges file: ordered node list + per-node deps ---
    content, rerr = io.read_file(edges_file)
    if string.equals(rerr, "") == 0 {
        println("aeb-driver: cannot read edges file ${edges_file}")
        exit(1)
    }
    nodes = list.new()
    deps_of = map.new()      // node file -> newline-joined dep files
    rest = content
    while string.length(rest) > 0 {
        nl = string.index_of(rest, "\n")
        line = ""
        if nl < 0 { line = rest  rest = "" }
        else { line = string.substring(rest, 0, nl)  rest = string.substring(rest, nl + 1, string.length(rest)) }
        line = string.trim(line)
        if string.length(line) > 0 {
            node = _first_word(line)
            deps = ""
            if string.length(node) < string.length(line) {
                deps = string.trim(string.substring(line, string.length(node), string.length(line)))
            }
            _na = list.add(nodes, string.copy(node))
            _da = map.put(deps_of, string.copy(node), string.copy(deps))
        }
    }
    nn = list.size(nodes)

    // --- Per-node container routing (ladder Rung 4) ---
    // AEB_NODE_CONTAINER=1 runs each node-subprocess inside the toolchain image
    // its OWN prereq maps to (rust node → aeb-tc:rust-1.75, jdk node →
    // aeb-tc:jdk-21), so a cross-language DAG builds each node in the right
    // image and artifacts thread across the shared /work mount. Off (default) =
    // host-native, unchanged. node_image[node] = "" for host-native nodes.
    node_container = 0
    if string.equals(os.getenv("AEB_NODE_CONTAINER"), "1") == 1 { node_container = 1 }
    engine = os.getenv("AEB_CONTAINER_ENGINE")
    if string.length(engine) == 0 { engine = "podman" }
    selabel = os.getenv("AEB_CONTAINER_SELABEL")
    if string.length(selabel) == 0 { selabel = "Z" }
    // extract-deps lives in $AEB_HOME/tools (NOT beside out_bin, which is the
    // generated target/_ae_build_all). Fall back to bare "extract-deps" on PATH.
    aebhome = os.getenv("AEB_HOME")
    extract_deps_bin = "extract-deps"
    if string.length(aebhome) > 0 {
        cand = path.join(path.join(aebhome, "tools"), "extract-deps")
        if file.exists(cand) == 1 { extract_deps_bin = cand }
    }
    node_image = map.new()
    if node_container == 1 {
        ii = 0
        while ii < nn {
            nd, _ = list.get(nodes, ii)
            ii = ii + 1
            img = _node_image(nd, extract_deps_bin)
            map.put(node_image, string.copy(nd), string.copy(img))
            if string.length(img) > 0 {
                println("aeb-driver: node ${nd} → image ${img}")
            }
        }
    }

    // --- Choose parallel (make) or sequential ---
    jobs = os.getenv("AEB_JOBS")
    if string.length(jobs) == 0 {
        np, _npe = build._sh_capture("nproc 2>/dev/null || echo 4")
        jobs = string.trim(np)
    }
    have_make = 0
    if string.equals(jobs, "1") == 0 {
        mk_probe, _mpe = build._sh_capture("command -v make >/dev/null 2>&1 && echo y || echo n")
        if string.equals(string.trim(mk_probe), "y") == 1 { have_make = 1 }
    }

    session_start = clock_ns()

    if have_make == 1 {
        // --- Emit the Makefile and let `make -jN` schedule it ---
        mk = ".PHONY: all"
        i = 0
        while i < nn {
            node, _ = list.get(nodes, i)
            mk = string.concat(mk, " ")
            mk = string.concat(mk, _san(node))
            i = i + 1
        }
        mk = string.concat(mk, "\nall:")
        i = 0
        while i < nn {
            node, _ = list.get(nodes, i)
            mk = string.concat(mk, " ")
            mk = string.concat(mk, _san(node))
            i = i + 1
        }
        mk = string.concat(mk, "\n")
        i = 0
        while i < nn {
            node, _ = list.get(nodes, i)
            i = i + 1
            label = file_to_label(node)
            log = path.join(logs_dir, _log_name(label))
            rcmark = path.join(rc_dir, string.concat(_san(node), ".rc"))
            msmark = path.join(rc_dir, string.concat(_san(node), ".ms"))
            // target line: <san(node)>: <san(dep)>...
            mk = string.concat(mk, _san(node))
            mk = string.concat(mk, ":")
            mdeps, _ = map.get(deps_of, node)
            drest = string.concat(mdeps, "")
            while string.length(drest) > 0 {
                dsp = string.index_of(drest, " ")
                dep = ""
                if dsp < 0 { dep = drest  drest = "" }
                else { dep = string.substring(drest, 0, dsp)  drest = string.trim(string.substring(drest, dsp + 1, string.length(drest))) }
                if string.length(dep) > 0 {
                    mk = string.concat(mk, " ")
                    mk = string.concat(mk, _san(dep))
                }
            }
            nimg = ""
            if node_container == 1 {
                nimg, _ = map.get(node_image, node)
            }
            mk = string.concat(mk, "\n\t@")
            mk = string.concat(mk, _node_cmd_timed(out_bin, root, node, label, log, rcmark, msmark, nimg, engine, selabel))
            mk = string.concat(mk, "\n")
        }
        mk_path = path.join(aeb_dir, "build.mk")
        _we = fs.write_atomic(mk_path, mk, string.length(mk))
        // -k: keep building independent nodes after a failure (parity with
        // the all-in-one run-everything behavior); rc != 0 if any failed.
        run = string.concat("make -j", jobs)
        run = string.concat(run, " -k -f '")
        run = string.concat(run, mk_path)
        run = string.concat(run, "' all")
        _mrc = build._sh(run)
    } else {
        // --- Sequential fallback (no make / AEB_JOBS=1) ---
        i = 0
        while i < nn {
            node, _ = list.get(nodes, i)
            i = i + 1
            label = file_to_label(node)
            log = path.join(logs_dir, _log_name(label))
            rcmark = path.join(rc_dir, string.concat(_san(node), ".rc"))
            // _node_cmd uses $$ for the Makefile; a plain `sh -c` collapses
            // $$ to the shell's PID, so run it through bash where the
            // intent ($?) still works by stripping one '$'. Simpler: run
            // the node directly and write the rc ourselves.
            seq_inner = string.concat("'", out_bin)
            seq_inner = string.concat(seq_inner, "' '")
            seq_inner = string.concat(seq_inner, root)
            seq_inner = string.concat(seq_inner, "' '")
            seq_inner = string.concat(seq_inner, label)
            seq_inner = string.concat(seq_inner, "'")
            if node_container == 1 {
                simg, _ = map.get(node_image, node)
                if string.length(simg) > 0 {
                    seq_inner = _container_node_invocation(node, root, label, simg, engine, selabel)
                }
            }
            cmd = string.concat(seq_inner, " > '")
            cmd = string.concat(cmd, log)
            cmd = string.concat(cmd, "' 2>&1")
            // Time the node + write a per-node duration marker (ms), so the
            // record-build pass below can report per-node wall (the orchestrator
            // times in-process; the driver reconstructs from markers — this is
            // the timing equivalent of the .rc marker). See msmark read below.
            _n_start = clock_ns()
            rc1 = build._sh(cmd)
            _n_end = clock_ns()
            _we = io.write_file(rcmark, string.from_int(rc1))
            msmark = path.join(rc_dir, string.concat(_san(node), ".ms"))
            _wm = io.write_file(msmark, string.from_int((_n_end - _n_start) / 1000000))
        }
    }

    session_end = clock_ns()
    total_ms = (session_end - session_start) / 1000000

    // --- Collect records from on-disk markers + render (uniform) ---
    records = list.new()
    any_failed = 0
    i = 0
    while i < nn {
        node, _ = list.get(nodes, i)
        i = i + 1
        label = file_to_label(node)
        // The displayed word IS the literal type from the .<type>.ae filename
        // — no inference, no compile/test/dist relabel. .build.ae→build,
        // .install.ae→install, .essais.ae→essais. (The route IS the filename.)
        type = infer_type(node)
        type_word = type

        node_failed = 0
        rc_value = "0"
        rcmark = path.join(rc_dir, string.concat(_san(node), ".rc"))
        if file.exists(rcmark) == 1 {
            rctxt, _rce = io.read_file(rcmark)
            rc_value = string.trim(rctxt)
            if string.equals(rc_value, "0") == 0 { node_failed = 1 }
        } else {
            // No rc marker: make skipped it (a dependency failed).
            node_failed = 1
            rc_value = "1"
        }

        rec = map.new()
        _rl = map.put(rec, "label", string.copy(label))
        _rt = map.put(rec, "type", string.copy(type_word))
        _rrc = map.put(rec, "rc", string.copy(rc_value))
        // Per-node wall from the .ms marker the node-run wrote (driver
        // reconstructs from markers; absent → 0, e.g. a skipped make node.
        // Without this the row shows 0.00s.
        msmark = path.join(rc_dir, string.concat(_san(node), ".ms"))
        if file.exists(msmark) == 1 {
            mstxt, _mse = io.read_file(msmark)
            _rw = map.put(rec, "wall_ms", string.trim(mstxt))
        } else {
            _rw0 = map.put(rec, "wall_ms", "0")
        }
        td = build._label_to_target_dir(root, label)
        _rcc = map.put(rec, "cache", build._read_cache_outcome(td))
        // Test results are gated on the MARKER EXISTING, not on the type name —
        // any node whose build wrote pass/fail markers (via *_test SDK verbs)
        // gets the row, whatever its filename. No "type == test" inference.
        tp, tf, thr = build._read_test_result(td)
        if thr == 1 {
            _rp = map.put(rec, "test_passed", string.from_int(tp))
            _rf = map.put(rec, "test_failed", string.from_int(tf))
            if tf > 0 { node_failed = 1 }
            tfn = build._read_test_failures(td)
            if string.length(tfn) > 0 { _rn = map.put(rec, "test_failed_names", tfn) }
        }
        rec_status = "pass"
        if node_failed == 1 { rec_status = "fail" }
        if file.exists(rcmark) == 0 { rec_status = "skipped" }
        _rst = map.put(rec, "status", string.copy(rec_status))
        _ra = list.add(records, rec)

        if node_failed == 1 {
            any_failed = 1
            log = path.join(logs_dir, _log_name(label))
            println("  ${type_word}: ${label} — FAILED (see ${log}):")
            _cat = build._sh(string.concat(string.concat("cat '", log), "' 2>/dev/null"))
        }
    }

    // JSON dumps — parity with the orchestrator's all-in-one path.
    telemetry_json = os.getenv("AEB_TELEMETRY_JSON")
    if string.length(telemetry_json) > 0 {
        tj_dir = path.dirname(telemetry_json)
        if string.length(tj_dir) > 0 { build._mkdirs(tj_dir) }
        tj_body = build.render_telemetry_json(records, total_ms)
        _tje = fs.write_atomic(telemetry_json, tj_body, string.length(tj_body))
    }
    tests_json = os.getenv("AEB_TESTS_JSON")
    if string.length(tests_json) > 0 {
        testj_dir = path.dirname(tests_json)
        if string.length(testj_dir) > 0 { build._mkdirs(testj_dir) }
        testj_body = build.render_tests_json(records)
        _testje = fs.write_atomic(tests_json, testj_body, string.length(testj_body))
    }
    artifacts_json = os.getenv("AEB_ARTIFACTS_JSON")
    if string.length(artifacts_json) > 0 {
        artj_dir = path.dirname(artifacts_json)
        if string.length(artj_dir) > 0 { build._mkdirs(artj_dir) }
        artj_body = build.render_artifacts_json(root, records)
        _artje = fs.write_atomic(artifacts_json, artj_body, string.length(artj_body))
    }

    println(build.render_telemetry(records, total_ms))
    if any_failed == 1 { exit(1) }
    return 0
}
