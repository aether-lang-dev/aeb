// aeb-link — compile each .ae file, generate the orchestrator, link the
// final binary, and exec it.
//
// Pure-Aether port of the compile/transform/link/exec loop in aeb. This
// replaces the largest remaining bash-side block.
//
// Usage:
//   aeb-link <edges-file> <build-dir> <aeb-lib> <aether-dir> <aether-bin> <out-bin> <root>
//
// <edges-file> : same format as topo-sort: each line is
//                "<file> <dep1> <dep2> ..." (deps are ignored here, but the
//                file_to_label / encode_name logic uses the file path).
//                The file order in <edges-file> IS the build order — caller
//                must already have run topo-sort.
// <build-dir>  : where the per-file .ae/.c artifacts get written
//                (typically $ROOT/target/_aeb)
// <aeb-lib>    : --lib path passed to aetherc (typically $ROOT/.aeb/lib)
// <aether-dir> : directory containing aetherc + libaether.a
// <aether-bin> : path to the `ae` driver (used for `ae build` of helpers)
// <out-bin>    : path to write the final native binary
// <root>       : monorepo root, passed as argv[1] to the linked binary
//
// On success this exec()s out-bin with root as its sole argument and
// never returns. On failure the process exits with the error code from
// the failing step.

import std.string
import std.file
import std.dir
import std.fs
import std.io
import std.os
import std.list
import std.strbuilder

// Label / tag derivation is shared via the aeblabel module (built
// with `--lib tools`) — one canonical copy, no drift across tools.
import aeblabel (infer_type, dirname_pure, extract_tag, file_to_label, counts_line, encode_name)

extern println(s: string)
extern exit(code: int)

// Discover the project root to use as an extra aetherc module-search
// root, so a build script can share a source module in another directory
// via a root-relative dotted import (`import gen.genengine` resolving
// <reporoot>/gen/genengine/module.ae, called namespaced by its last
// segment: genengine.generate()) REGARDLESS of which subdirectory the
// user invoked `aeb` from.
//
// Why this is needed: aetherc resolves a bare/dotted import against its
// module-search roots (cwd + --lib), not against the input file's own
// directory — and aeb hands aetherc a relocated copy under target/_aeb/,
// so the build script's authored location is never a search root. When
// `aeb` is run from the repo root, cwd already covers it; when run from a
// subdir, cwd is the subdir and a cross-dir share is invisible. Anchoring
// on the discovered project root makes the import path the reader sees
// (from the project root) the path aetherc actually resolves, from any dir.
//
// Two-pass, preference-ordered:
//   1. `.aeb` is the PREFERRED anchor — it marks an explicit aeb project
//      boundary. We walk the whole way up looking only for `.aeb` first,
//      so a `.aeb` root wins even when a VCS marker sits at a *deeper*
//      directory (e.g. a git submodule nested below the aeb root anchors
//      on the aeb root, not the submodule).
//   2. If no `.aeb` is found, fall back to the nearest VCS working-copy /
//      checkout marker (`.git`, `.svn`, ...).
// If NEITHER is found, return "" — the caller then adds nothing to --lib.
// (cwd is already an implicit aetherc search root, so same-dir imports
// still work; there is simply no principled root to widen resolution to
// in a marker-less tree, so we don't pretend there is one.)
//
// Marker probes use `fs.exists` (path-agnostic), NOT `dir.exists`, because
// several markers are FILES not directories: a git worktree or submodule
// has a `.git` *file* pointing elsewhere; Fossil uses a `.fslckout` file.
// Subversion note: assumes svn ≥1.7, which keeps a single `.svn` at the
// working-copy root (pre-1.7 put `.svn` in every dir and would anchor too
// deep — but 1.7 shipped in 2011).
// DELIBERATELY LOOSE: any `.aeb` directory anchors the root, NOT the
// stricter `.aeb/lib` that `aeb --init` actually writes. Considered and
// declined (2026-07-26).
//
// The looseness is real: a stray `.aeb` anywhere above a build silently
// becomes the project root, and aeb-link appends the discovered root to
// the aetherc `--lib` search path. That bit here — a user-level
// `~/.aeb` holding cache/secrets made `$HOME` satisfy this test for any
// build run underneath it. The fix for THAT was to move user state to
// XDG dirs (`~/.cache/aeb`, `~/.local/share/aeb`), which removed the
// collision at its source.
//
// Tightening to `.aeb/lib` would also work and is a one-liner, but it
// changes root discovery for every consumer to fix a case we no longer
// have, and a project with a hand-made `.aeb/` (no `lib/`) would
// silently stop being found as root. Not worth the blast radius:
// `--init` is the only writer, and a bare `.aeb` is a reasonable thing
// for a project to mean by it.
//
// Note aeb-main's SDK *resolution* is already stricter — it probes
// `.aeb/lib/build/module.ae` so a dangling symlink is caught. That
// asymmetry is intentional: "where is the root" is a broader question
// than "are the SDK symlinks usable".
_has_aeb_marker(d: string) {
    if fs.exists(string.concat(d, "/.aeb")) == 1 { return 1 }      // aeb project root
    return 0
}

_has_vcs_marker(d: string) {
    if fs.exists(string.concat(d, "/.avn")) == 1 { return 1 }      // avn working-copy root
    if fs.exists(string.concat(d, "/.git")) == 1 { return 1 }      // git (dir or worktree/submodule file)
    if fs.exists(string.concat(d, "/.hg")) == 1 { return 1 }       // Mercurial
    if fs.exists(string.concat(d, "/.svn")) == 1 { return 1 }      // Subversion (≥1.7: root-only)
    if fs.exists(string.concat(d, "/.bzr")) == 1 { return 1 }      // Bazaar
    if fs.exists(string.concat(d, "/.fslckout")) == 1 { return 1 } // Fossil checkout marker
    if fs.exists(string.concat(d, "/_FOSSIL_")) == 1 { return 1 }  // Fossil (older / Windows marker)
    if fs.exists(string.concat(d, "/.pijul")) == 1 { return 1 }    // Pijul
    return 0
}

// Walk up from <start> looking for an `.aeb` marker. Returns the dir, or
// "" if none up to the filesystem root.
_walk_for_aeb(start: string) {
    cur = string.concat(start, "")
    while string.length(cur) > 0 {
        if _has_aeb_marker(cur) == 1 { return cur }
        if cur == "/" { return string.concat("", "") }
        parent = dirname_pure(cur)
        if parent == cur { return string.concat("", "") }
        if string.length(parent) == 0 { return string.concat("", "") }
        cur = parent
    }
    return string.concat("", "")
}

// Walk up from <start> looking for the nearest VCS marker. Returns the
// dir, or "" if none up to the filesystem root.
_walk_for_vcs(start: string) {
    cur = string.concat(start, "")
    while string.length(cur) > 0 {
        if _has_vcs_marker(cur) == 1 { return cur }
        if cur == "/" { return string.concat("", "") }
        parent = dirname_pure(cur)
        if parent == cur { return string.concat("", "") }
        if string.length(parent) == 0 { return string.concat("", "") }
        cur = parent
    }
    return string.concat("", "")
}

// Returns the project root, or "" when no marker is found anywhere up the
// tree (caller adds nothing to --lib in that case).
_discover_repo_root(start: string) {
    aeb_root = _walk_for_aeb(start)
    if string.length(aeb_root) > 0 { return aeb_root }
    return _walk_for_vcs(start)
}

// Platform detection for OS-specific linker flags. See
// lib/build/module.ae for the shared version; aeb-link is a standalone
// tool so the helper is inlined here. Called once per link step. Reads
// the compile-time os.platform() (ae 0.202+) — correct on native Windows
// (no `uname`) and no coreutils shell-out.
_is_macos_link() {
    if os.platform() == "darwin" { return 1 }
    return 0
}

_is_windows_link() {
    if os.platform() == "windows" { return 1 }
    return 0
}

// aetherc's lib-search-path separator: `;` on Windows, `:` on POSIX
// (compiler/aether_lib_path.h AETHER_LIB_PATH_SEP_CHAR — `:` collides with the
// drive-letter colon on Windows, so the toolchain uses `;` there). Used ONLY to
// build the separator-joined AEB_COMPILE_LIB env value, which downstream tools
// feed to aetherc's separator parser (a non-shell path, so `;` is safe there).
// Command-LINE --lib args use repeated flags instead (compile_lib_flags) — see
// the note there for why a joined value breaks under the Windows shell.
// Mirrors build._path_sep().
_lib_sep_link() {
    if _is_windows_link() == 1 { return ";" }
    return ":"
}

// `.exe` suffix for native binaries on Windows, "" elsewhere. MinGW gcc and
// `ae build` both emit <name>.exe; the tools aeb-link invokes (transform-ae,
// gen-orchestrator, aeb-driver, aetherc) only EXIST and are only RUNNABLE under
// their .exe name on Windows. Mirrors build._exe_suffix (aeb-link is
// standalone, so inlined here alongside _is_macos_link / _resolve_*).
_exe_suffix_link() {
    if _is_windows_link() == 1 { return ".exe" }
    return ""
}

// --- POSIX-shell-on-Windows chokepoint (mirrors lib/build's _sh family) ---
//
// On Windows os.system() runs the command through cmd.exe, which rejects every
// POSIX idiom aeb-link emits: `2>/dev/null`, `> file`, `mkdir -p`, the `$(find
// ...)` / `$(pkg-config ...)` command substitutions on the gcc line, and bare
// forward-slash tool paths it reads as switches. A MinGW box always has `sh`
// (C:\msys64\usr\bin\sh.exe on PATH under -l), so we wrap each command
// `sh -c '<cmd>'`; passthrough unchanged on POSIX. sh also EVALUATES the
// `$(...)` substitutions, which cmd.exe never would.
//
// Two subtleties, both found on the box:
//  - sh single-quoting: ' -> '\'' (close, escaped quote, reopen).
//  - cmd.exe still acts on > < & | ^ INSIDE the sh single-quotes (it doesn't
//    honour POSIX quoting), so caret-escape them (^>, ^&, ...) — that makes
//    cmd.exe pass the literal through to sh instead of consuming it.
_sh_quote_link(s: string) {
    out = "'"
    rest = s
    while string.length(rest) > 0 {
        ch = string.substring(rest, 0, 1)
        rest = string.substring(rest, 1, string.length(rest))
        if string.equals(ch, "'") == 1 { out = string.concat(out, "'\\''") }
        else { out = string.concat(out, ch) }
    }
    return string.concat(out, "'")
}

_cmd_caret_escape_link(s: string) {
    out = ""
    rest = s
    while string.length(rest) > 0 {
        ch = string.substring(rest, 0, 1)
        rest = string.substring(rest, 1, string.length(rest))
        if string.equals(ch, ">") == 1 { out = string.concat(out, "^>") }
        else { if string.equals(ch, "<") == 1 { out = string.concat(out, "^<") }
        else { if string.equals(ch, "&") == 1 { out = string.concat(out, "^&") }
        else { if string.equals(ch, "|") == 1 { out = string.concat(out, "^|") }
        else { if string.equals(ch, "^") == 1 { out = string.concat(out, "^^") }
        else { out = string.concat(out, ch) } } } } }
    }
    return out
}

_sh_wrap_link(cmd: string) {
    if _is_windows_link() == 1 {
        return string.concat("sh -c ", _cmd_caret_escape_link(_sh_quote_link(cmd)))
    }
    return cmd
}

// THE hardened Windows chokepoint (mirrors lib/build's _sh): write the raw
// command to a temp .sh via Aether io, then run `sh <nativepath>`. cmd.exe only
// ever sees `sh C:/.../x.sh` — it NEVER parses the command contents, so embedded
// single quotes (e.g. the per-node `'aeb_driver' 'root' 'out_bin' ...` dcmd),
// `;`, redirects, and spaces all survive. The old `sh -c '<quoted>'` form
// (_sh_wrap_link) could not carry quoted commands — cmd.exe mangles the POSIX
// '\'' escape, so the per-node dcmd died with "unexpected EOF matching `'`".
// Kept _sh_wrap_link only as the temp-write-failed fallback.
_sh_slashes_link(s: string) {
    out = ""
    rest = s
    while string.length(rest) > 0 {
        ch = string.substring(rest, 0, 1)
        rest = string.substring(rest, 1, string.length(rest))
        if string.equals(ch, "\\") == 1 { out = string.concat(out, "/") }
        else { out = string.concat(out, ch) }
    }
    return out
}

_sh_hash_link(s: string) {
    h = 5381
    rest = s
    while string.length(rest) > 0 {
        c = string.char_at(rest, 0)
        rest = string.substring(rest, 1, string.length(rest))
        h = ((h * 33) + c) & 2147483647
    }
    return h
}

// _is_abs_native_link(p) — Windows-native absolute path (drive letter or UNC).
// Twin of lib/build's _is_abs_native; aeb-link is a separate binary.
_is_abs_native_link(p: string) {
    if string.length(p) < 2 { return 0 }
    if string.equals(string.substring(p, 0, 2), "\\\\") == 1 { return 1 }
    if string.equals(string.substring(p, 1, 2), ":") == 1 { return 1 }
    return 0
}

// _cygpath_m_via_sh_link(posix) — native form of a POSIX/MSYS path, via cygpath
// run INSIDE sh. Twin of lib/build's _cygpath_m_via_sh; see that comment for
// why a bare os.exec("cygpath ...") is unreliable (cmd.exe PATH differs between
// the login shell and a make-spawned grandchild) while `sh -c "cygpath ..."` is
// not. "" on failure.
_cygpath_m_via_sh_link(posix: string) {
    out, err = os.exec("sh -c \"cygpath -m '${posix}'\"")
    if string.length(err) > 0 { return "" }
    return string.trim(out)
}

// _to_native_path_link(p) — MSYS "/c/.." → native "C:/..". No-op off Windows,
// and no-op for an already-native path. Twin of lib/build's _to_native_path;
// aeb-link is a separate binary with no access to that copy, which is exactly
// how the toolchain dir reached here raw and aetherc was invoked by a path the
// shell mis-resolved (asks/windows-two-path-form-bugs-aeb-link-and-tmp.md,
// Bug 1). Same lib-vs-tools duplication as the pkg-config fix.
_to_native_path_link(p: string) {
    if _is_windows_link() == 0 { return p }
    if string.length(p) == 0 { return p }
    if _is_abs_native_link(p) == 1 { return p }
    if string.equals(string.substring(p, 0, 1), "/") == 0 { return p }
    nat = _cygpath_m_via_sh_link(p)
    if string.length(nat) == 0 { return p }
    return nat
}

_sh_script_path_link(cmd: string) {
    tmp = _sh_slashes_link(os.getenv("TMP"))
    if string.length(tmp) == 0 { tmp = _sh_slashes_link(os.getenv("TEMP")) }
    if string.length(tmp) == 0 { tmp = _sh_slashes_link(os.getenv("TMPDIR")) }
    if string.length(tmp) == 0 { tmp = "/tmp" }
    // On Windows the temp path MUST be native ("C:/msys64/tmp/.."): io.write_file
    // (native Win32) and `sh` resolve a POSIX "/tmp/.." to DIFFERENT physical
    // dirs (C:\tmp vs C:\msys64\tmp — measured), so a POSIX path is written to
    // one place and executed from another → `sh: /tmp/_aeb_link_*.sh: No such
    // file or directory`. Convert whatever we picked to native. (Same fix as
    // lib/build's _sh_script_path — Bug 2 of the two-path-form ask.)
    if _is_windows_link() == 1 {
        if _is_abs_native_link(tmp) == 0 {
            nat = _cygpath_m_via_sh_link(tmp)
            if string.length(nat) > 0 { tmp = nat }
        }
    }
    name = string.concat("_aeb_link_", string.concat(string.from_int(os.getpid()),
           string.concat("_", string.concat(string.from_int(_sh_hash_link(cmd)), ".sh"))))
    return string.concat(tmp, string.concat("/", name))
}

// Set AEB_LINK_TRACE=1 to echo each command before running (Windows debugging).
_sh_link(cmd: string) {
    if string.equals(os.getenv("AEB_LINK_TRACE"), "1") == 1 {
        println(string.concat("[aeb-link trace] ", cmd))
    }
    if _is_windows_link() == 0 {
        return os.system(cmd)
    }
    scriptf = _sh_script_path_link(cmd)
    werr = io.write_file(scriptf, cmd)
    if string.length(werr) > 0 {
        return os.system(_sh_wrap_link(cmd))
    }
    rc = os.system(string.concat("sh ", scriptf))
    _d = fs.delete(scriptf)
    return rc
}

// _sh_capture_link(cmd) — os.exec through the same Windows chokepoint as
// _sh_link. Needed so pkg-config can be RESOLVED here rather than emitted as
// `$(...)` into the gcc line (see _resolve_sysdeps_link).
_sh_capture_link(cmd: string) {
    if string.equals(os.getenv("AEB_LINK_TRACE"), "1") == 1 {
        println(string.concat("[aeb-link trace] ", cmd))
    }
    if _is_windows_link() == 0 {
        out, err = os.exec(cmd)
        return out, err
    }
    scriptf = _sh_script_path_link(cmd)
    werr = io.write_file(scriptf, cmd)
    if string.length(werr) > 0 {
        out2, err2 = os.exec(_sh_wrap_link(cmd))
        return out2, err2
    }
    out3, err3 = os.exec(string.concat("sh ", scriptf))
    _d = fs.delete(scriptf)
    return out3, err3
}

// _pkg_config_libs_link(module) / _resolve_sysdeps_link() — the aeb-link twin
// of lib/aether's _resolve_sysdeps. Same three fixes, same rationale; inlined
// because aeb-link is deliberately standalone (it cannot import the SDK it is
// in the middle of compiling). Keep the two in step.
//   1. resolve NOW instead of emitting `$(pkg-config …)` into a command line
//      whose shell we do not control — on MSYS2 that reached cmd.exe, which
//      cannot substitute, so the flags were absent and the orchestrator link
//      died on undefined deflate/EVP_*/pcre2_*;
//   2. include pcre2 (libaether.a's aether_regex.o references pcre2_*);
//   3. seed PKG_CONFIG_PATH with /mingw64/lib/pkgconfig on Windows, since the
//      pkg-config on PATH searches /usr/lib/pkgconfig and the .pc files are
//      not there.
// (asks/windows-pkg-config-substitution-runs-in-cmd.md)
// _flags_from_lines_link(text) — newline-separated flags -> one space-joined
// run. The sed in the find pipeline already prefixes each line with `-I`, so
// this only joins; it does not re-prefix. Blank lines dropped.
_flags_from_lines_link(text: string) {
    out = ""
    rest = text
    while string.length(rest) > 0 {
        nl = string.index_of(rest, "\n")
        line = ""
        if nl < 0 {
            line = rest
            rest = ""
        } else {
            line = string.substring(rest, 0, nl)
            rest = string.substring(rest, nl + 1, string.length(rest))
        }
        f = string.trim(line)
        if string.length(f) > 0 {
            out = string.concat(out, string.concat(" ", f))
        }
    }
    return out
}

// Twin of lib/build's @link-header readers (aeb-link is a separate binary and
// cannot import lib/build). Read a module's native @link deps back from the
// generated C's `// aether-link:` header (aether #1549/#1555) and append the
// surviving `-l` tokens to the orchestrator link, dropping the ones the
// toolchain already supplies. See lib/build for the full rationale.
_link_managed_link(tok: string) {
    if string.equals(tok, "-lssl") == 1 { return 1 }
    if string.equals(tok, "-lcrypto") == 1 { return 1 }
    if string.equals(tok, "-lnghttp2") == 1 { return 1 }
    if string.equals(tok, "-lpcre2-8") == 1 { return 1 }
    if string.equals(tok, "-lz") == 1 { return 1 }
    if string.equals(tok, "-lpthread") == 1 { return 1 }
    if string.equals(tok, "-ldl") == 1 { return 1 }
    if string.equals(tok, "-lm") == 1 { return 1 }
    return 0
}
// Return the surviving `-l` tokens from one c-file's header, each as a leading-
// space token, skipping any already in `seen` (a "<space>-lx<space>" string) so
// the orchestrator's many TUs don't repeat a shared dep.
_aether_link_libs_link(c_path: string, seen: string) {
    if string.length(c_path) == 0 { return "" }
    if file.exists(c_path) == 0 { return "" }
    raw, rerr = io.read_file(c_path)
    if string.length(rerr) > 0 { return "" }
    rest = raw
    n = 0
    payload = ""
    found = 0
    while n < 8 {
        nl = string.index_of(rest, "\n")
        line = rest
        if nl >= 0 {
            line = string.substring(rest, 0, nl)
            rest = string.substring(rest, nl + 1, string.length(rest))
        }
        mi = string.index_of(line, "// aether-link:")
        if mi >= 0 {
            payload = string.substring(line, mi + 15, string.length(line))
            found = 1
            n = 8
        }
        if nl < 0 { n = 8 }
        n = n + 1
    }
    if found == 0 { return "" }
    out = ""
    toks = string.trim(payload)
    while string.length(toks) > 0 {
        sp = string.index_of(toks, " ")
        tok = toks
        if sp >= 0 {
            tok = string.substring(toks, 0, sp)
            toks = string.trim(string.substring(toks, sp + 1, string.length(toks)))
        } else { toks = "" }
        if string.length(tok) > 0 {
            if _link_managed_link(tok) == 0 {
                probe = string.concat(" ", string.concat(tok, " "))
                if string.index_of(seen, probe) < 0 {
                    out = string.concat(out, string.concat(" ", tok))
                    seen = string.concat(seen, string.concat(tok, " "))
                }
            }
        }
    }
    return out
}
// ` -L<lib_dir>/contrib` when it exists, else "".
_contrib_L_link(lib_dir: string) {
    if string.length(lib_dir) == 0 { return "" }
    cdir = string.concat(lib_dir, "/contrib")
    if dir.exists(cdir) == 1 { return string.concat(" -L", cdir) }
    return ""
}

_pkg_config_libs_link(mod: string) {
    out, err = _sh_capture_link(string.concat("pkg-config --libs ", string.concat(mod, " 2>/dev/null")))
    if string.length(err) > 0 { return "" }
    return string.trim(out)
}

// _aether_published_libs(aether_bin) — the EXTERNAL link libs aether says
// libaether.a needs, from `ae cflags --libs`, as a space-joined " -lx -ly" run.
// This is aether's own probe result for this box (the same flags `ae build`
// links with), so aeb never hand-curates the list. We keep only the external
// `-l<name>` tokens: `-L<dir>`, `-laether`, `-pthread`, `-lm` are dropped
// because aeb already adds them (and a duplicated `-laether` can disturb static
// link ordering on MinGW). Returns "" if the command fails or emits nothing
// (an ae too old for the subcommand) — the caller then falls back to pkg-config.
// (asks/win32-link-needs-ldbghelp-after-0541.md)
_aether_published_libs(aether_bin: string) {
    raw, _e = _sh_capture_link(string.concat(aether_bin, " cflags --libs 2>/dev/null"))
    s = string.trim(raw)
    if string.length(s) == 0 { return "" }
    out = ""
    rest = s
    while string.length(rest) > 0 {
        // Next whitespace-delimited token.
        sp = string.index_of(rest, " ")
        tok = ""
        if sp < 0 { tok = rest  rest = "" }
        else { tok = string.substring(rest, 0, sp)  rest = string.substring(rest, sp + 1, string.length(rest)) }
        tok = string.trim(tok)
        if string.length(tok) > 0 {
            // Keep external -l<name>; drop -laether / -lpthread / -lm (aeb adds),
            // and anything that isn't a -l flag (-L dirs, stray tokens).
            keep = 0
            if string.starts_with(tok, "-l") == 1 { keep = 1 }
            if string.equals(tok, "-laether") == 1 { keep = 0 }
            if string.equals(tok, "-lpthread") == 1 { keep = 0 }
            if string.equals(tok, "-lm") == 1 { keep = 0 }
            if keep == 1 {
                out = string.concat(out, string.concat(" ", tok))
            }
        }
    }
    return out
}

_resolve_sysdeps_link() {
    if _is_windows_link() == 1 {
        existing = os.getenv("PKG_CONFIG_PATH")
        mingw = "/mingw64/lib/pkgconfig"
        if string.length(existing) == 0 {
            _sp = os.setenv("PKG_CONFIG_PATH", mingw)
        } else {
            if string.index_of(existing, mingw) < 0 {
                _sp2 = os.setenv("PKG_CONFIG_PATH", string.concat(existing, string.concat(_lib_sep_link(), mingw)))
            }
        }
    }
    out = ""
    mods = list.new()
    list.add(mods, "zlib")
    list.add(mods, "openssl")
    list.add(mods, "libpcre2-8")
    n = list.size(mods)
    i = 0
    while i < n {
        m, _ = list.get(mods, i)
        flags = _pkg_config_libs_link(m)
        if string.length(flags) > 0 {
            out = string.concat(out, string.concat(" ", flags))
        }
        i = i + 1
    }
    return out
}

// Resolve the directory containing libaether.a. Aether's own driver
// (tools/ae.c) probes these locations, so we mirror that:
//   1. ${aether_dir}/../lib/aether/libaether.a   (FHS install — current default)
//   2. ${aether_dir}/../lib/libaether.a          (legacy)
//   3. ${aether_dir}/libaether.a                 (next to the driver)
// Returns the dir to pass to -L, or "" if none found — caller treats
// that as a misconfigured Aether install and exits.
_resolve_libaether_dir(aether_dir: string) {
    cand1 = string.concat(aether_dir, "/../lib/aether/libaether.a")
    if fs.exists(cand1) == 1 {
        return string.concat(aether_dir, "/../lib/aether")
    }
    cand2 = string.concat(aether_dir, "/../lib/libaether.a")
    if fs.exists(cand2) == 1 {
        return string.concat(aether_dir, "/../lib")
    }
    cand3 = string.concat(aether_dir, "/libaether.a")
    if fs.exists(cand3) == 1 {
        return aether_dir
    }
    return ""
}

// Resolve the Aether include root. Generated C files include headers
// with bare names (#include "aether_panic.h"), but a real install
// nests them under include/aether/{runtime,std}/<subdir>/. We probe
// for the include root and the caller adds -I for every subdir.
//   1. $AETHER_INCLUDE (explicit override)
//   2. ${aether_dir}/../include/aether       (FHS install)
//   3. ${aether_dir}/..                       (DEV TREE — headers live
//      scattered under runtime/<sub>/ and std/<sub>/ next to the sources;
//      a built `ae` in <root>/build has no include/ at all. Common on the
//      Windows MinGW box, which builds aether in-tree.)
//   4. "" if none exists (caller falls back to no -I).
// Cases 2 and 3 both point at a tree whose -type d subdirs hold the headers;
// the caller's `find <root> -type d | sed 's|^|-I|'` covers either layout.
_resolve_aether_include(aether_dir: string) {
    env_inc = os.getenv("AETHER_INCLUDE")
    if string.length(env_inc) > 0 {
        if dir.exists(env_inc) == 1 {
            return env_inc
        }
    }
    // FHS install (ae via get.sh, >= ~0.3xx): the runtime headers are nested
    // under <prefix>/share/aether/{runtime,std}, while <prefix>/include/aether
    // may exist but carry only the umbrella libaether.h. Prefer share/aether
    // when it actually holds the runtime headers, else the -I block matches an
    // empty include/aether and aether_panic.h is never found.
    share = string.concat(aether_dir, "/../share/aether")
    if dir.exists(string.concat(share, "/runtime")) == 1 {
        return share
    }
    cand = string.concat(aether_dir, "/../include/aether")
    if dir.exists(cand) == 1 {
        return cand
    }
    // Dev-tree fallback: the aether source root (one up from the build dir),
    // whose runtime/ + std/ subtrees carry the headers. Probe a known header
    // dir so we only return this when it really is a dev tree.
    dev_root = string.concat(aether_dir, "/..")
    if dir.exists(string.concat(dev_root, "/runtime")) == 1 {
        return dev_root
    }
    return ""
}

// --- Inline helpers ------------------------------------------------------
// encode_name + its replace-all helper now live in aeblabel (imported
// above), alongside file_to_label/infer_type. They were local copies named
// `string_replace_all`, which collides with a C symbol std.string gained in
// aether 0.463.0 — a hard link error, not a style issue.

// First word of a space-separated string
first_word(s: string) {
    sp = string.index_of(s, " ")
    if sp < 0 { return string.concat(s, "") }
    return string.substring(s, 0, sp)
}

// Read the edges file and return a list of file paths in build order.
load_files(path: string) {
    files = list.new()
    raw, rerr = io.read_file(path)
    if rerr != "" {
        println(string.concat("aeb-link: ", rerr))
        exit(1)
    }
    rest = raw
    line = string.concat("", "")
    while string.length(rest) > 0 {
        nl = string.index_of(rest, "\n")
        if nl < 0 {
            line = string.concat(rest, "")
            rest = ""
        } else {
            line = string.substring(rest, 0, nl)
            rest = string.substring(rest, nl + 1, string.length(rest))
        }
        line = string.trim(line)
        if string.length(line) > 0 {
            _la = list.add(files, first_word(line))
        }
    }
    return files
}

// _helper_stale(bin, src, dep) — 1 if the lazy-built helper tool `bin` needs
// (re)building: it is MISSING, or its source `src` (or `dep`, an optional
// second source it imports, "" to skip) is NEWER than the compiled binary.
//
// The old check was `file.exists(bin) == 0` — absence only — so a helper
// compiled before a source fix survived any update that did not delete it. On
// one box gen-orchestrator kept emitting the PRE-b1bfa5e broken entry symbol
// (__D_all_D_ae) though the repo was well past that fix, because its binary
// still existed. A toolchain whose components can be individually stale is the
// "version skew wearing a costume" family (dotted-root, /usr/local skew, payload
// vs repo skew) — an mtime check turns "installed, but stale" into a rebuild.
// gen-orchestrator's `dep` is aeblabel (it imports encode_name), so an aeblabel
// edit — exactly the fix that box was missing — now invalidates it too.
// (asks/orchestrator-failures-silenced-and-stale-helper-tools.md, ask 2)
_helper_stale(bin: string, src: string, dep: string) {
    if file.exists(bin) == 0 { return 1 }
    bin_mt = file.mtime(bin)
    if file.exists(src) == 1 {
        if file.mtime(src) > bin_mt { return 1 }
    }
    if string.length(dep) > 0 {
        if file.exists(dep) == 1 {
            if file.mtime(dep) > bin_mt { return 1 }
        }
    }
    return 0
}

main() {
    if aether_args_count() < 8 {
        println("Usage: aeb-link <edges-file> <build-dir> <aeb-lib> <aether-dir> <aether-bin> <out-bin> <root>")
        exit(1)
    }
    edges_file = aether_args_get(1)
    build_dir  = aether_args_get(2)
    aeb_lib    = aether_args_get(3)
    // The toolchain dir arrives in whatever form `command -v ae` produced —
    // on Windows that is the MSYS "/c/.." form (measured: it stays POSIX even
    // when PATH holds the native form). aetherc/libaether paths built from a
    // raw "/c/.." are then mis-resolved by the native-Win32 file probes and by
    // the shell, so normalise to native here — the same normalisation lib/build
    // does at its toolchain-dir chokepoint, which aeb-link (a separate binary)
    // never inherited. (asks/windows-two-path-form-bugs-aeb-link-and-tmp.md, Bug 1.)
    aether_dir = _to_native_path_link(aether_args_get(4))
    aether_bin = aether_args_get(5)
    out_bin    = aether_args_get(6)
    root       = aether_args_get(7)

    // On Windows, MinGW gcc emits <out_bin>.exe; suffix once here so the `-o`
    // target, the per-node `out_bin <root> <label>` exec, and the aeb-driver
    // invocation all name the file that actually exists. No-op off Windows.
    if os.platform() == "windows" {
        out_bin = string.concat(out_bin, ".exe")
    }

    aebhome = os.getenv("AEB_HOME")
    if string.length(aebhome) == 0 {
        // Fall back; aeb always exports AEB_HOME so this is just a guard.
        aebhome = string.concat(".", "")
    }

    // .exe on Windows: aetherc and the helper tools only exist/run as <name>.exe.
    esuf           = _exe_suffix_link()
    aetherc        = string.concat(string.concat(aether_dir, "/aetherc"), esuf)
    libaether_dir  = _resolve_libaether_dir(aether_dir)

    // PATH-style --lib for the per-file + orchestrator aetherc compiles.
    // <aeb_lib> resolves the shipped/consumer SDK modules; appending the
    // discovered project root lets a build script reach a SHARED source
    // module in another directory via a root-relative dotted import (see
    // _discover_repo_root for the full rationale). The discovered root —
    // not the bare <root>=cwd — is what makes the share resolve from a
    // subdir invocation too. When discovery finds no marker (marker-less
    // tree) it returns "", and we add NOTHING: cwd is already an implicit
    // aetherc search root, so same-dir imports still work, and there is no
    // principled root to widen cross-dir resolution to.
    repo_root   = _discover_repo_root(root)
    compile_lib = string.concat(aeb_lib, "")
    if string.length(repo_root) > 0 {
        compile_lib = string.concat(aeb_lib, string.concat(_lib_sep_link(), repo_root))
    }
    // For COMMAND LINES we emit ONE `--lib <entry>` flag per search-path
    // entry, NOT a single separator-joined `--lib a;b` value. This is the
    // toolchain's designed answer to a Windows-specific trap (aetherc.c's
    // --lib handler documents it): os.system routes through cmd.exe, and a
    // `;`-joined value inside `sh -c '...'` gets re-split by the shell as a
    // statement separator (cmd.exe doesn't honour the single quotes, MSYS2
    // sh does — the `;` leaks out as a separator). aetherc's first `--lib`
    // resets the chain and each subsequent one appends, so repeated flags
    // compose into the same search path with zero shell-quoting fragility.
    // The separator-joined `compile_lib` is kept ONLY for the AEB_COMPILE_LIB
    // env export below, which routes through aetherc's separator parser
    // (not a shell), where `;`/`:` is correct.
    compile_lib_flags = string.concat("--lib ", aeb_lib)
    if string.length(repo_root) > 0 {
        compile_lib_flags = string.concat(compile_lib_flags, string.concat(" --lib ", repo_root))
    }
    // Export the same search path the per-file orchestrator compile uses
    // so the `aether.program` manual path (lib/aether's _compile_and_link)
    // can resolve the entry's `import`s when it runs its own standalone
    // `aetherc entry.ae entry.c`. Without this, an entry that imports an
    // extern-backed sibling module (the no_closure_regen / thin-Aether-
    // over-C shape) fails the plain compile with E0301 — the import
    // resolves to nothing because the relocated/standalone compile never
    // had the SDK lib + repo root on its search path. Inherited by the
    // orchestrator binary / aeb-driver / make / per-node children through
    // the process env (all spawned via os.system after this point).
    _sl = os.setenv("AEB_COMPILE_LIB", compile_lib)
    // Helper tool paths: suffixless base for `ae build -o` (ae auto-appends
    // .exe on Windows, so an explicit .exe there would double-suffix to
    // .exe.exe), and the .exe-suffixed name for file.exists + invocation.
    transform_ae_base    = string.concat(aebhome, "/tools/transform-ae")
    gen_orchestrator_base = string.concat(aebhome, "/tools/gen-orchestrator")
    transform_ae   = string.concat(transform_ae_base, esuf)
    gen_orchestrator = string.concat(gen_orchestrator_base, esuf)

    // (Re)build the helper tools if missing OR their source is newer than the
    // compiled binary — not absence-only, which let a stale binary survive a
    // source fix (see _helper_stale).
    transform_src = string.concat(aebhome, "/tools/transform-ae.ae")
    gen_src       = string.concat(aebhome, "/tools/gen-orchestrator.ae")
    aeblabel_src  = string.concat(aebhome, "/tools/aeblabel/module.ae")
    if _helper_stale(transform_ae, transform_src, "") == 1 {
        _sh_link(string.concat(string.concat(aether_bin, " build "), string.concat(transform_src, string.concat(" -o ", string.concat(transform_ae_base, " 2>/dev/null")))))
    }
    // gen-orchestrator imports aeblabel (encode_name), so an aeblabel edit must
    // invalidate it too — that is the exact drift that left a box emitting the
    // pre-fix __D_all_D_ae symbol.
    if _helper_stale(gen_orchestrator, gen_src, aeblabel_src) == 1 {
        // --lib <aebhome>/tools resolves gen-orchestrator's `import aeblabel`.
        _sh_link(string.concat(string.concat(aether_bin, " build "), string.concat(gen_src, string.concat(" -o ", string.concat(gen_orchestrator_base, string.concat(" --lib ", string.concat(aebhome, "/tools 2>/dev/null")))))))
    }

    _sh_link(string.concat("mkdir -p ", build_dir))

    files = load_files(edges_file)
    n = list.size(files)

    // --- Build display counts: one clause per DISTINCT verbatim type ---
    // (aeblabel.counts_line). No fixed compile/dist/test buckets: the
    // pre-d6340b4 hardcoded spellings silently dropped `.tests.ae` (plural)
    // nodes from the count, and any non-canonical type (.install.ae,
    // .essais.ae, .構築.ae) was invisible. The summary now speaks the
    // repo's own filename vocabulary, per docs/filename-is-the-route.md.
    //
    // UNBUFFERED (io.stdout_write, not println): this is a PLAN echo — it
    // announces what is about to be built. But aeb-link's stdout is a pipe,
    // so stdio block-buffers it and the whole block flushed at process exit,
    // landing AFTER the driver's telemetry. On a failing build that put
    //     aeb: 1 build
    //       build: app
    // as the last two lines on screen, where it reads as a success summary —
    // the same "output says fine, reality says broken" trap as issue #13's
    // telemetry row. Writing straight to fd 1 keeps the plan where it belongs:
    // before the work it describes. Nothing buffered precedes it here (the
    // earlier println()s are usage/error paths that exit), so bypassing stdio
    // cannot reorder anything ahead of it.
    _pc = io.stdout_write(string.concat(counts_line(files), "\n"))

    // --- Per-file transform + aetherc compile ---
    c_files = list.new()
    i = 0
    while i < n {
        file_path, _ = list.get(files, i)
        fname     = encode_name(file_path)
        label     = file_to_label(file_path)
        type      = infer_type(file_path)
        src       = string.concat("./", file_path)
        ae_tmp    = string.concat(string.concat(build_dir, "/"), string.concat(fname, ".ae"))
        c_out     = string.concat(string.concat(build_dir, "/"), string.concat(fname, ".c"))
        dir       = dirname_pure(file_path)
        tag       = extract_tag(file_path)
        display   = dir
        if string.length(tag) > 0 {
            display = string.concat(string.concat(dir, ":"), tag)
        }

        // Verbatim type, matching counts_line — the pre-verbatim code
        // relabelled build→compile and printed NOTHING for non-canonical
        // types (.install.ae, .essais.ae, …), so those nodes were invisible
        // in the pre-build listing too.
        // Unbuffered for the same reason as counts_line above: these lines
        // belong to the plan echo and must not drift past the build's output.
        _pl = io.stdout_write("  ${type}: ${display}\n")

        // transform-ae <src> <fname> <label> <out> <aeb-lib> <aeb-home>
        tr_cmd = string.concat(transform_ae, " ")
        tr_cmd = string.concat(tr_cmd, src)
        tr_cmd = string.concat(tr_cmd, " ")
        tr_cmd = string.concat(tr_cmd, fname)
        tr_cmd = string.concat(tr_cmd, " ")
        tr_cmd = string.concat(tr_cmd, label)
        tr_cmd = string.concat(tr_cmd, " ")
        tr_cmd = string.concat(tr_cmd, ae_tmp)
        tr_cmd = string.concat(tr_cmd, " ")
        tr_cmd = string.concat(tr_cmd, aeb_lib)
        tr_cmd = string.concat(tr_cmd, " ")
        tr_cmd = string.concat(tr_cmd, aebhome)
        _sh_link(tr_cmd)

        // aetherc <--lib aeb_lib [--lib repo_root]> <ae_tmp> <c_out>
        // One --lib flag per entry (compile_lib_flags) so SDK imports AND
        // root-relative dotted cross-dir source imports both resolve,
        // without a `;`-joined value the Windows shell would re-split.
        ac_cmd = string.concat(aetherc, " ")
        ac_cmd = string.concat(ac_cmd, compile_lib_flags)
        ac_cmd = string.concat(ac_cmd, " ")
        ac_cmd = string.concat(ac_cmd, ae_tmp)
        ac_cmd = string.concat(ac_cmd, " ")
        ac_cmd = string.concat(ac_cmd, c_out)
        _sh_link(ac_cmd)

        _lc = list.add(c_files, c_out)
        i = i + 1
    }

    // --- Generate orchestrator .ae ---
    orch_file = string.concat(build_dir, "/_orchestrator.ae")
    orch_c    = string.concat(build_dir, "/_orchestrator.c")

    // gen-orchestrator file1 file2 ... > orch_file
    // The file list scales with the build's module count; strbuilder
    // keeps the accumulation amortised O(1) per file.
    go_cmd = string.concat(gen_orchestrator, " ")
    gofiles = strbuilder.new(512)
    j = 0
    while j < n {
        if j > 0 { strbuilder.append(gofiles, " ") }
        _f, _ = list.get(files, j)
        strbuilder.append(gofiles, _f)
        j = j + 1
    }
    go_cmd = string.concat(go_cmd, strbuilder.finish(gofiles))
    go_cmd = string.concat(go_cmd, " > ")
    go_cmd = string.concat(go_cmd, orch_file)
    _sh_link(go_cmd)

    // Compile orchestrator .ae -> .c. Uses compile_lib_flags (not aeb_lib):
    // the orchestrator imports each transformed per-file .ae, which carry the
    // user's root-relative dotted cross-dir imports, so the repo root must
    // be on the search path here too (matters for subdir invocations).
    oc_cmd = string.concat(aetherc, " ")
    oc_cmd = string.concat(oc_cmd, compile_lib_flags)
    oc_cmd = string.concat(oc_cmd, " ")
    oc_cmd = string.concat(oc_cmd, orch_file)
    oc_cmd = string.concat(oc_cmd, " ")
    oc_cmd = string.concat(oc_cmd, orch_c)
    // The orchestrator compile is one of the two commands a fan-out cannot
    // survive losing: if it fails, out_bin never links and make then runs every
    // node's recipe against a missing binary (Error 127 × N — one root failure
    // wearing N coats). So do NOT discard its stderr, and stop LOUDLY on failure
    // rather than letting make fan the 127s out with the real error silenced.
    // aeb-link has no skip logic (it recompiles the orchestrator every run), so
    // a failure here is always this run's failure — nothing stale to blame.
    // (asks/orchestrator-failures-silenced-and-stale-helper-tools.md)
    oc_cmd = string.concat(oc_cmd, " 2>&1")
    oc_rc = _sh_link(oc_cmd)
    if oc_rc != 0 {
        println("aeb-link: FATAL — failed to compile the fan-out orchestrator (${orch_c}).")
        println("aeb-link:   the error above is the real cause; the build is stopping here")
        println("aeb-link:   rather than running every node against a binary that was never built.")
        exit(1)
    }

    // --- Link with gcc ---
    cc = "gcc -O2 -pipe -w "
    cc = string.concat(cc, orch_c)
    // The per-module object list scales with the build's module
    // count; strbuilder keeps the link-line accumulation O(1)/file.
    objs = strbuilder.new(1024)
    k = 0
    while k < n {
        strbuilder.append(objs, " ")
        _cf, _ = list.get(c_files, k)
        strbuilder.append(objs, _cf)
        k = k + 1
    }
    cc = string.concat(cc, strbuilder.finish(objs))
    // Include path: generated C files use bare #include names but
    // real installs nest headers under include/aether/{runtime,std}/...
    // Add -I for every dir under the include root.
    inc_root = _resolve_aether_include(aether_dir)
    if string.length(inc_root) > 0 {
        // -I for every dir under the include root that ACTUALLY CONTAINS a
        // header. Three constraints shape this one-liner:
        //
        //  - `sed -e s,...,...,` (comma delim, NO surrounding quotes) instead
        //    of `sed 's|^|-I|'`: the single quotes collide with the
        //    chokepoint's own `sh -c '...'` wrap (cmd.exe mangles the POSIX
        //    `'\''` escape) and abort the whole link with "unexpected EOF
        //    matching `'`". A quote-free sed script survives both the cmd.exe
        //    and sh layers. Same reason `*.h` is unquoted: it is a find
        //    operand, not a glob the shell should expand — and it cannot be,
        //    because `find` is given a directory, so no `*.h` exists in cwd
        //    to expand against. (If one ever did, the pattern would expand
        //    and break; that is why the whole expression stays inside `$(...)`
        //    with a directory-only cwd contract.)
        //
        //  - **Header-bearing dirs only.** This used to `-print` every
        //    directory. On a *dev tree* (`_resolve_aether_include`'s last
        //    fallback is the Aether source root) that is 600+ dirs —
        //    `.github`, `asks`, `benchmarks/cross-language/...` — none of
        //    which hold a `.h`. The resulting link line measured **39 KB /
        //    621 args**, which blows Windows' ~32 KB `CreateProcess` ceiling
        //    and fails EVERY build on native Windows with
        //    "gcc: Argument list too long" (POSIX `ARG_MAX` ~2 MB just
        //    tolerated it, so Linux carried the cost silently). Finding the
        //    `*.h` files and stripping to their parent dirs cuts a dev tree
        //    to ~90 and an installed tree from 136 to 53. See
        //    `asks/windows-gcc-argument-list-too-long.md`.
        //
        //  - `sort -u` because one dir yields one line per header it holds.
        //
        //  - `.git`/`build` are still pruned: it keeps the find fast, and
        //    `build/` in a dev tree holds generated headers we do not want.
        //  - RESOLVED IN aeb, not left as `$(...)` on the gcc line. The
        //    quote-free sed above makes the expression survive the cmd.exe
        //    layer, but survival still assumes a POSIX shell EXPANDS it — and
        //    when the command reaches cmd.exe directly (or falls back to the
        //    `sh -c '...'` wrap) it does not, leaving the -I block empty with
        //    no diagnostic. Running the pipeline here through the capture
        //    chokepoint and splicing the literal flags is shell-agnostic. The
        //    find/prune/sed/sort pipeline is UNCHANGED — it still runs, just
        //    now via _sh_capture_link, so the 32 KB arg-limit work above is
        //    preserved exactly.
        //    (asks/windows-pkg-config-substitution-runs-in-cmd.md)
        find_cmd = string.concat("find ", inc_root)
        find_cmd = string.concat(find_cmd, " -type d -name .git -prune -o -type d -name build -prune -o -name *.h -print | sed -e s,/[^/]*$,, -e s,^,-I, | sort -u")
        inc_raw, _ferr = _sh_capture_link(find_cmd)
        cc = string.concat(cc, _flags_from_lines_link(inc_raw))
    }

    if string.length(libaether_dir) == 0 {
        println("aeb-link: libaether.a not found near ${aether_dir} — your Aether install looks incomplete")
        exit(1)
    }
    cc = string.concat(cc, " -L")
    cc = string.concat(cc, libaether_dir)
    // Dev-layout contrib search path, so a module @link'ing a make-contrib
    // veneer archive (e.g. -laether_sqlite) resolves without consumer config.
    cc = string.concat(cc, _contrib_L_link(libaether_dir))
    cc = string.concat(cc, " -laether")
    // Module-declared native deps from each TU's `// aether-link:` header
    // (aether #1549/#1555): -D-sensitive, transitive, deduped across TUs, with
    // toolchain-managed libs dropped. aeb's manual orchestrator link bypasses
    // `ae build`, so it reads the headers itself. Empty in the common case.
    _al_seen = " "
    _kk = 0
    while _kk < n {
        _alcf, _ = list.get(c_files, _kk)
        _alnew = _aether_link_libs_link(_alcf, _al_seen)
        cc = string.concat(cc, _alnew)
        // Fold this file's kept tokens (each " -lx") into seen as "-lx " so the
        // next TU's index_of(" -lx ") dedup sees them.
        _al_seen = string.concat(_al_seen, string.concat(string.trim(_alnew), " "))
        _kk = _kk + 1
    }
    cc = string.concat(cc, " -o ")
    cc = string.concat(cc, out_bin)
    // No duplicate-symbol flag: as of aether 0.538.0 (pinned) the compiler
    // clones each imported-module function per TU as `static`, so N objects no
    // longer define one external symbol. The old `-Wl,--allow-multiple-definition`
    // was GNU-ld-only — Apple's ld64 rejects it — so carrying it also gated
    // macOS off (a full multi-node build could not link there). With the
    // upstream fix the flag is unnecessary on EVERY platform, and dropping it
    // unblocks macOS. Proven by aether's own multi_tu_import_link integration
    // test (4 TUs → 4 objects → 1 link, no dedup flags, runs) which runs on
    // every CI platform incl. macOS. See asks (aether):
    // imported-module-fns-not-static-break-macos-link.md.
    // libaether.a unconditionally references zlib/openssl symbols
    // when the Aether toolchain was built with them detected. Pull
    // the link flags from pkg-config; no-op when libs absent.
    //
    // RESOLVED HERE, not emitted as `$(pkg-config …)`. Embedding the
    // substitution only works if a POSIX shell runs the string; on MSYS2 it
    // reached cmd.exe, which cannot perform it, so the flags came out ABSENT
    // and the link died on undefined deflate/EVP_*/pcre2_* with pkg-config's
    // stderr swallowed by a `2>/dev/null` cmd.exe never interpreted. Still one
    // invocation per module (d55f064) — `--libs zlib openssl` is
    // all-or-nothing, so a missing zlib.pc would drop -lcrypto too.
    // AUTHORITATIVE external libs: ask aether what libaether.a needs, don't
    // hand-curate. `ae cflags --libs` emits the exact probe-derived set for THIS
    // box (`-lssl -lcrypto -lz -lnghttp2 -lpcre2-8 -lfyaml -ldbghelp …`), which
    // is what `ae build`'s own link uses — the list is aether's, it changes with
    // aether's per-box detection, and a duplicated copy here loses by
    // construction: aether adds a dependency (dbghelp at 0.541, zlib at 0.580),
    // its own builds keep working, and aeb's fan-out dies at link with the real
    // error silenced. Reading the list is the fix.
    // (asks/win32-link-needs-ldbghelp-after-0541.md)
    //
    // Fallback to the pkg-config probe (_resolve_sysdeps_link) only when
    // `cflags --libs` yields nothing — an ae too old to have the subcommand.
    sysdeps = _aether_published_libs(aether_bin)
    if string.length(string.trim(sysdeps)) == 0 {
        sysdeps = _resolve_sysdeps_link()
    }
    // Windows SYSTEM libs libaether's crypto/net code needs (BCryptGenRandom ->
    // bcrypt, winsock -> ws2_32). These are MinGW system libraries, not
    // aether-probed deps, so `cflags --libs` may not name them and there is no
    // .pc for them — add them explicitly. Empty off Windows. The probed crypto/
    // compress libs (ssl/crypto/z/dbghelp) now come from cflags --libs above, so
    // they are no longer duplicated here.
    winsysdeps = ""
    if _is_windows_link() == 1 { winsysdeps = " -lbcrypt -lws2_32" }
    // Same link tail on every platform now — no dup-symbol flag, so no macOS
    // gate. (_is_macos_link is still used elsewhere; only this branch is gone.)
    cc = string.concat(cc, " -pthread -lm")
    cc = string.concat(cc, sysdeps)
    cc = string.concat(cc, winsysdeps)
    cc = string.concat(cc, " 2>&1")
    link_rc = _sh_link(cc)
    // The orchestrator LINK is the second command a fan-out cannot survive
    // losing. gcc's error is printed (2>&1 above), but interleaved in a long
    // plan echo where nothing marks it fatal — so when the link fails, say so
    // ONCE, loudly, and stop, rather than letting make discover a missing
    // out_bin as Error 127 across every node. The link error above (undefined
    // symbols, a missing -l) is the real cause.
    // (asks/orchestrator-failures-silenced-and-stale-helper-tools.md)
    if link_rc != 0 || file.exists(out_bin) == 0 {
        println("aeb-link: FATAL — failed to link the fan-out orchestrator (${out_bin}).")
        println("aeb-link:   the gcc error above (undefined symbols / a missing -l) is the real cause;")
        println("aeb-link:   the build is stopping here rather than running every node against a")
        println("aeb-link:   binary that was never linked (which surfaces as Error 127 × N nodes).")
        exit(1)
    }

    // --noexe (AEB_NOEXE=1): stop here. The orchestrator binary (out_bin) is
    // linked and on disk, but we do NOT run it — so no build work executes.
    // This is Cut 1 of the two-aeb duality (docs/two-aeb-duality.md): compile
    // the .ae build scripts into the native orchestrator IN the container,
    // then a host-side launcher (aeb-ctr) RUNS out_bin on the host. Aether is
    // compiled, so "build the build scripts" and "run the build" are two
    // phases; --noexe is the cut between them.
    if string.equals(os.getenv("AEB_NOEXE"), "1") == 1 {
        println("aeb --noexe: orchestrator linked at ${out_bin} (not run)")
        exit(0)
    }

    // --- Run: per-node driver (default) or all-in-one orchestrator ---
    // Per-node (nodes-as-subprocesses, docs/nodes-as-subprocesses.md) is
    // the DEFAULT: each node runs as its own `out_bin <root> <label>` via
    // aeb-driver, redirecting per-node tool output into target/.aeb/logs/
    // (compartmentalized stdout). Opt back to the all-in-one in-process
    // run with `aeb --in-process` (AEB_IN_PROCESS=1) or AEB_PER_NODE=0 —
    // faster for small builds, simplest to debug. AEB_PER_NODE, if set,
    // wins (1=per-node, 0=in-process).
    per_node = 1
    if string.equals(os.getenv("AEB_IN_PROCESS"), "1") == 1 { per_node = 0 }
    _pn = os.getenv("AEB_PER_NODE")
    if string.length(_pn) > 0 {
        per_node = 1
        if string.equals(_pn, "0") == 1 { per_node = 0 }
    }
    if per_node == 1 {
        aeb_driver_base = string.concat(aebhome, "/tools/aeb-driver")
        aeb_driver = string.concat(aeb_driver_base, esuf)
        // (Re)build if missing OR its source / imported aeblabel is newer than
        // the binary — not absence-only (see _helper_stale). aeb-driver imports
        // `build` (lib) + aeblabel (tools); the aeblabel dep is the shared
        // encode_name source whose staleness left a box on the pre-fix symbol.
        aeb_driver_src = string.concat(aebhome, "/tools/aeb-driver.ae")
        aeblabel_src2  = string.concat(aebhome, "/tools/aeblabel/module.ae")
        if _helper_stale(aeb_driver, aeb_driver_src, aeblabel_src2) == 1 {
            // -o uses the suffixless base (ae appends .exe on Windows).
            db = string.concat(aether_bin, " build ")
            db = string.concat(db, string.concat(aeb_driver_src, " -o "))
            db = string.concat(db, aeb_driver_base)
            db = string.concat(db, " ")
            db = string.concat(db, compile_lib_flags)
            db = string.concat(db, string.concat(" --lib ", string.concat(aebhome, "/tools 2>/dev/null")))
            _sh_link(db)
        }
        // aeb-driver reads the edges file (node + its deps per line) to
        // generate the parallel Makefile. NB: aeb-link's arg1
        // (`edges_file`) is actually the topo-sorted *list* (_sorted.txt,
        // no deps); the real deps live in build_dir/_edges.txt.
        real_edges = string.concat(build_dir, "/_edges.txt")
        dcmd = string.concat("'", aeb_driver)
        dcmd = string.concat(dcmd, "' '")
        dcmd = string.concat(dcmd, root)
        dcmd = string.concat(dcmd, "' '")
        dcmd = string.concat(dcmd, out_bin)
        dcmd = string.concat(dcmd, "' '")
        dcmd = string.concat(dcmd, real_edges)
        dcmd = string.concat(dcmd, "'")
        rc = _sh_link(dcmd)
        exit(rc)
    }

    // --- Run the orchestrator binary (child process) and propagate exit ---
    // We don't have execv in stdlib so this stays a fork+wait rather than a
    // true exec. The parent process holds for the duration; otherwise it's
    // semantically identical to the bash `exec` it replaces.
    exec_cmd = string.concat(out_bin, " ")
    exec_cmd = string.concat(exec_cmd, root)
    rc = _sh_link(exec_cmd)
    exit(rc)
}
