// aeb-link — compile each .ae file, generate the orchestrator, link the
// final binary, and exec it.
//
// Pure-Aether port of the compile/transform/link/exec loop in aeb. This
// replaces the largest remaining bash-side block.
//
// Usage:
//   aeb-link <edges-file> <build-dir> <aeb-lib> <aether-dir> <aether-bin> <out-bin> <root>
//
// <edges-file> : same format as topo-sort: each line is
//                "<file> <dep1> <dep2> ..." (deps are ignored here, but the
//                file_to_label / encode_name logic uses the file path).
//                The file order in <edges-file> IS the build order — caller
//                must already have run topo-sort.
// <build-dir>  : where the per-file .ae/.c artifacts get written
//                (typically $ROOT/target/_aeb)
// <aeb-lib>    : --lib path passed to aetherc (typically $ROOT/.aeb/lib)
// <aether-dir> : directory containing aetherc + libaether.a
// <aether-bin> : path to the `ae` driver (used for `ae build` of helpers)
// <out-bin>    : path to write the final native binary
// <root>       : monorepo root, passed as argv[1] to the linked binary
//
// On success this exec()s out-bin with root as its sole argument and
// never returns. On failure the process exits with the error code from
// the failing step.

import std.string
import std.file
import std.dir
import std.fs
import std.io
import std.os
import std.list
import std.strbuilder

// Label / tag derivation is shared via the aeblabel module (built
// with `--lib tools`) — one canonical copy, no drift across tools.
import aeblabel (infer_type, dirname_pure, extract_tag, file_to_label)

extern println(s: string)
extern exit(code: int)

// Discover the project root to use as an extra aetherc module-search
// root, so a build script can share a source module in another directory
// via a root-relative dotted import (`import gen.genengine` resolving
// <reporoot>/gen/genengine/module.ae, called namespaced by its last
// segment: genengine.generate()) REGARDLESS of which subdirectory the
// user invoked `aeb` from.
//
// Why this is needed: aetherc resolves a bare/dotted import against its
// module-search roots (cwd + --lib), not against the input file's own
// directory — and aeb hands aetherc a relocated copy under target/_aeb/,
// so the build script's authored location is never a search root. When
// `aeb` is run from the repo root, cwd already covers it; when run from a
// subdir, cwd is the subdir and a cross-dir share is invisible. Anchoring
// on the discovered project root makes the import path the reader sees
// (from the project root) the path aetherc actually resolves, from any dir.
//
// Two-pass, preference-ordered:
//   1. `.aeb` is the PREFERRED anchor — it marks an explicit aeb project
//      boundary. We walk the whole way up looking only for `.aeb` first,
//      so a `.aeb` root wins even when a VCS marker sits at a *deeper*
//      directory (e.g. a git submodule nested below the aeb root anchors
//      on the aeb root, not the submodule).
//   2. If no `.aeb` is found, fall back to the nearest VCS working-copy /
//      checkout marker (`.git`, `.svn`, ...).
// If NEITHER is found, return "" — the caller then adds nothing to --lib.
// (cwd is already an implicit aetherc search root, so same-dir imports
// still work; there is simply no principled root to widen resolution to
// in a marker-less tree, so we don't pretend there is one.)
//
// Marker probes use `fs.exists` (path-agnostic), NOT `dir.exists`, because
// several markers are FILES not directories: a git worktree or submodule
// has a `.git` *file* pointing elsewhere; Fossil uses a `.fslckout` file.
// Subversion note: assumes svn ≥1.7, which keeps a single `.svn` at the
// working-copy root (pre-1.7 put `.svn` in every dir and would anchor too
// deep — but 1.7 shipped in 2011).
_has_aeb_marker(d: string) {
    if fs.exists(string.concat(d, "/.aeb")) == 1 { return 1 }      // aeb project root
    return 0
}

_has_vcs_marker(d: string) {
    if fs.exists(string.concat(d, "/.avn")) == 1 { return 1 }      // avn working-copy root
    if fs.exists(string.concat(d, "/.git")) == 1 { return 1 }      // git (dir or worktree/submodule file)
    if fs.exists(string.concat(d, "/.hg")) == 1 { return 1 }       // Mercurial
    if fs.exists(string.concat(d, "/.svn")) == 1 { return 1 }      // Subversion (≥1.7: root-only)
    if fs.exists(string.concat(d, "/.bzr")) == 1 { return 1 }      // Bazaar
    if fs.exists(string.concat(d, "/.fslckout")) == 1 { return 1 } // Fossil checkout marker
    if fs.exists(string.concat(d, "/_FOSSIL_")) == 1 { return 1 }  // Fossil (older / Windows marker)
    if fs.exists(string.concat(d, "/.pijul")) == 1 { return 1 }    // Pijul
    return 0
}

// Walk up from <start> looking for an `.aeb` marker. Returns the dir, or
// "" if none up to the filesystem root.
_walk_for_aeb(start: string) {
    cur = string.concat(start, "")
    while string.length(cur) > 0 {
        if _has_aeb_marker(cur) == 1 { return cur }
        if cur == "/" { return string.concat("", "") }
        parent = dirname_pure(cur)
        if parent == cur { return string.concat("", "") }
        if string.length(parent) == 0 { return string.concat("", "") }
        cur = parent
    }
    return string.concat("", "")
}

// Walk up from <start> looking for the nearest VCS marker. Returns the
// dir, or "" if none up to the filesystem root.
_walk_for_vcs(start: string) {
    cur = string.concat(start, "")
    while string.length(cur) > 0 {
        if _has_vcs_marker(cur) == 1 { return cur }
        if cur == "/" { return string.concat("", "") }
        parent = dirname_pure(cur)
        if parent == cur { return string.concat("", "") }
        if string.length(parent) == 0 { return string.concat("", "") }
        cur = parent
    }
    return string.concat("", "")
}

// Returns the project root, or "" when no marker is found anywhere up the
// tree (caller adds nothing to --lib in that case).
_discover_repo_root(start: string) {
    aeb_root = _walk_for_aeb(start)
    if string.length(aeb_root) > 0 { return aeb_root }
    return _walk_for_vcs(start)
}

// Platform detection for OS-specific linker flags. See
// lib/build/module.ae for the shared version; aeb-link is a standalone
// tool so the helper is inlined here. Called once per link step. Reads
// the compile-time os.platform() (ae 0.202+) — correct on native Windows
// (no `uname`) and no coreutils shell-out.
_is_macos_link() {
    if os.platform() == "darwin" { return 1 }
    return 0
}

// Resolve the directory containing libaether.a. Aether's own driver
// (tools/ae.c) probes these locations, so we mirror that:
//   1. ${aether_dir}/../lib/aether/libaether.a   (FHS install — current default)
//   2. ${aether_dir}/../lib/libaether.a          (legacy)
//   3. ${aether_dir}/libaether.a                 (next to the driver)
// Returns the dir to pass to -L, or "" if none found — caller treats
// that as a misconfigured Aether install and exits.
_resolve_libaether_dir(aether_dir: string) {
    cand1 = string.concat(aether_dir, "/../lib/aether/libaether.a")
    if fs.exists(cand1) == 1 {
        return string.concat(aether_dir, "/../lib/aether")
    }
    cand2 = string.concat(aether_dir, "/../lib/libaether.a")
    if fs.exists(cand2) == 1 {
        return string.concat(aether_dir, "/../lib")
    }
    cand3 = string.concat(aether_dir, "/libaether.a")
    if fs.exists(cand3) == 1 {
        return aether_dir
    }
    return ""
}

// Resolve the Aether include root. Generated C files include headers
// with bare names (#include "aether_panic.h"), but a real install
// nests them under include/aether/{runtime,std}/<subdir>/. We probe
// for the include root and the caller adds -I for every subdir.
//   1. $AETHER_INCLUDE (explicit override)
//   2. ${aether_dir}/../include/aether
//   3. "" if neither exists (caller falls back to no -I, which works
//      only on dev-tree layouts where the headers sit beside the .c)
_resolve_aether_include(aether_dir: string) {
    env_inc = os.getenv("AETHER_INCLUDE")
    if string.length(env_inc) > 0 {
        if dir.exists(env_inc) == 1 {
            return env_inc
        }
    }
    cand = string.concat(aether_dir, "/../include/aether")
    if dir.exists(cand) == 1 {
        return cand
    }
    return ""
}

// --- Inline helpers (deliberate duplication; we don't yet have a shared lib) ---

string_replace_all(haystack: string, find: string, replace: string) {
    flen = string.length(find)
    if flen == 0 { return string.substring(haystack, 0, string.length(haystack)) }
    out = string.concat("", "")
    rest = haystack
    while string.length(rest) > 0 {
        idx = string.index_of(rest, find)
        if idx < 0 {
            return string.concat(out, rest)
        }
        out = string.concat(out, string.substring(rest, 0, idx))
        out = string.concat(out, replace)
        rest = string.substring(rest, idx + flen, string.length(rest))
    }
    return string.concat(out, "")
}

encode_name(input: string) {
    sentinel = "0DBLUND0"
    s = string_replace_all(input, "__", sentinel)
    s = string_replace_all(s, "/", "_")
    s = string_replace_all(s, "-", "_H_")
    s = string_replace_all(s, ".", "_D_")
    s = string_replace_all(s, sentinel, "__")
    return string.concat(s, "")
}

// First word of a space-separated string
first_word(s: string) {
    sp = string.index_of(s, " ")
    if sp < 0 { return string.concat(s, "") }
    return string.substring(s, 0, sp)
}

// Read the edges file and return a list of file paths in build order.
load_files(path: string) {
    files = list.new()
    raw, rerr = io.read_file(path)
    if rerr != "" {
        println(string.concat("aeb-link: ", rerr))
        exit(1)
    }
    rest = raw
    line = string.concat("", "")
    while string.length(rest) > 0 {
        nl = string.index_of(rest, "\n")
        if nl < 0 {
            line = string.concat(rest, "")
            rest = ""
        } else {
            line = string.substring(rest, 0, nl)
            rest = string.substring(rest, nl + 1, string.length(rest))
        }
        line = string.trim(line)
        if string.length(line) > 0 {
            _la = list.add(files, first_word(line))
        }
    }
    return files
}

main() {
    if aether_args_count() < 8 {
        println("Usage: aeb-link <edges-file> <build-dir> <aeb-lib> <aether-dir> <aether-bin> <out-bin> <root>")
        exit(1)
    }
    edges_file = aether_args_get(1)
    build_dir  = aether_args_get(2)
    aeb_lib    = aether_args_get(3)
    aether_dir = aether_args_get(4)
    aether_bin = aether_args_get(5)
    out_bin    = aether_args_get(6)
    root       = aether_args_get(7)

    aebhome = os.getenv("AEB_HOME")
    if string.length(aebhome) == 0 {
        // Fall back; aeb always exports AEB_HOME so this is just a guard.
        aebhome = string.concat(".", "")
    }

    aetherc        = string.concat(aether_dir, "/aetherc")
    libaether_dir  = _resolve_libaether_dir(aether_dir)

    // PATH-style --lib for the per-file + orchestrator aetherc compiles.
    // <aeb_lib> resolves the shipped/consumer SDK modules; appending the
    // discovered project root lets a build script reach a SHARED source
    // module in another directory via a root-relative dotted import (see
    // _discover_repo_root for the full rationale). The discovered root —
    // not the bare <root>=cwd — is what makes the share resolve from a
    // subdir invocation too. When discovery finds no marker (marker-less
    // tree) it returns "", and we add NOTHING: cwd is already an implicit
    // aetherc search root, so same-dir imports still work, and there is no
    // principled root to widen cross-dir resolution to.
    repo_root   = _discover_repo_root(root)
    compile_lib = string.concat(aeb_lib, "")
    if string.length(repo_root) > 0 {
        compile_lib = string.concat(aeb_lib, string.concat(":", repo_root))
    }
    // Export the same search path the per-file orchestrator compile uses
    // so the `aether.program` manual path (lib/aether's _compile_and_link)
    // can resolve the entry's `import`s when it runs its own standalone
    // `aetherc entry.ae entry.c`. Without this, an entry that imports an
    // extern-backed sibling module (the no_closure_regen / thin-Aether-
    // over-C shape) fails the plain compile with E0301 — the import
    // resolves to nothing because the relocated/standalone compile never
    // had the SDK lib + repo root on its search path. Inherited by the
    // orchestrator binary / aeb-driver / make / per-node children through
    // the process env (all spawned via os.system after this point).
    _sl = os.setenv("AEB_COMPILE_LIB", compile_lib)
    transform_ae   = string.concat(aebhome, "/tools/transform-ae")
    gen_orchestrator = string.concat(aebhome, "/tools/gen-orchestrator")

    // Lazy-build the helper tools if they aren't compiled yet.
    if file.exists(transform_ae) == 0 {
        os.system(string.concat(string.concat(aether_bin, " build "), string.concat(string.concat(aebhome, "/tools/transform-ae.ae -o "), string.concat(transform_ae, " 2>/dev/null"))))
    }
    if file.exists(gen_orchestrator) == 0 {
        // --lib <aebhome>/tools resolves gen-orchestrator's `import aeblabel`.
        os.system(string.concat(string.concat(aether_bin, " build "), string.concat(string.concat(aebhome, "/tools/gen-orchestrator.ae -o "), string.concat(gen_orchestrator, string.concat(" --lib ", string.concat(aebhome, "/tools 2>/dev/null"))))))
    }

    os.system(string.concat("mkdir -p ", build_dir))

    files = load_files(edges_file)
    n = list.size(files)

    // --- Build display counts (compile / dist / test) ---
    nb = 0
    nt = 0
    nd = 0
    i = 0
    while i < n {
        f, _ = list.get(files, i)
        t = infer_type(f)
        if t == "build" { nb = nb + 1 }
        if t == "test"  { nt = nt + 1 }
        if t == "dist"  { nd = nd + 1 }
        i = i + 1
    }
    println("aeb: ${nb} compile + ${nd} dist + ${nt} test")

    // --- Per-file transform + aetherc compile ---
    c_files = list.new()
    i = 0
    while i < n {
        file_path, _ = list.get(files, i)
        fname     = encode_name(file_path)
        label     = file_to_label(file_path)
        type      = infer_type(file_path)
        src       = string.concat("./", file_path)
        ae_tmp    = string.concat(string.concat(build_dir, "/"), string.concat(fname, ".ae"))
        c_out     = string.concat(string.concat(build_dir, "/"), string.concat(fname, ".c"))
        dir       = dirname_pure(file_path)
        tag       = extract_tag(file_path)
        display   = dir
        if string.length(tag) > 0 {
            display = string.concat(string.concat(dir, ":"), tag)
        }

        if type == "build" { println("  compile: ${display}") }
        if type == "test"  { println("  test:    ${display}") }
        if type == "dist"  { println("  dist:    ${display}") }

        // transform-ae <src> <fname> <label> <out> <aeb-lib> <aeb-home>
        tr_cmd = string.concat(transform_ae, " ")
        tr_cmd = string.concat(tr_cmd, src)
        tr_cmd = string.concat(tr_cmd, " ")
        tr_cmd = string.concat(tr_cmd, fname)
        tr_cmd = string.concat(tr_cmd, " ")
        tr_cmd = string.concat(tr_cmd, label)
        tr_cmd = string.concat(tr_cmd, " ")
        tr_cmd = string.concat(tr_cmd, ae_tmp)
        tr_cmd = string.concat(tr_cmd, " ")
        tr_cmd = string.concat(tr_cmd, aeb_lib)
        tr_cmd = string.concat(tr_cmd, " ")
        tr_cmd = string.concat(tr_cmd, aebhome)
        os.system(tr_cmd)

        // aetherc --lib <compile_lib> <ae_tmp> <c_out>
        // compile_lib = <aeb_lib>:<repo_root> so SDK imports AND
        // root-relative dotted cross-dir source imports both resolve.
        ac_cmd = string.concat(aetherc, " --lib ")
        ac_cmd = string.concat(ac_cmd, compile_lib)
        ac_cmd = string.concat(ac_cmd, " ")
        ac_cmd = string.concat(ac_cmd, ae_tmp)
        ac_cmd = string.concat(ac_cmd, " ")
        ac_cmd = string.concat(ac_cmd, c_out)
        os.system(ac_cmd)

        _lc = list.add(c_files, c_out)
        i = i + 1
    }

    // --- Generate orchestrator .ae ---
    orch_file = string.concat(build_dir, "/_orchestrator.ae")
    orch_c    = string.concat(build_dir, "/_orchestrator.c")

    // gen-orchestrator file1 file2 ... > orch_file
    // The file list scales with the build's module count; strbuilder
    // keeps the accumulation amortised O(1) per file.
    go_cmd = string.concat(gen_orchestrator, " ")
    gofiles = strbuilder.new(512)
    j = 0
    while j < n {
        if j > 0 { strbuilder.append(gofiles, " ") }
        _f, _ = list.get(files, j)
        strbuilder.append(gofiles, _f)
        j = j + 1
    }
    go_cmd = string.concat(go_cmd, strbuilder.finish(gofiles))
    go_cmd = string.concat(go_cmd, " > ")
    go_cmd = string.concat(go_cmd, orch_file)
    os.system(go_cmd)

    // Compile orchestrator .ae -> .c. Uses compile_lib (not aeb_lib): the
    // orchestrator imports each transformed per-file .ae, which carry the
    // user's root-relative dotted cross-dir imports, so the repo root must
    // be on the search path here too (matters for subdir invocations).
    oc_cmd = string.concat(aetherc, " --lib ")
    oc_cmd = string.concat(oc_cmd, compile_lib)
    oc_cmd = string.concat(oc_cmd, " ")
    oc_cmd = string.concat(oc_cmd, orch_file)
    oc_cmd = string.concat(oc_cmd, " ")
    oc_cmd = string.concat(oc_cmd, orch_c)
    oc_cmd = string.concat(oc_cmd, " 2>/dev/null")
    os.system(oc_cmd)

    // --- Link with gcc ---
    cc = "gcc -O2 -pipe -w "
    cc = string.concat(cc, orch_c)
    // The per-module object list scales with the build's module
    // count; strbuilder keeps the link-line accumulation O(1)/file.
    objs = strbuilder.new(1024)
    k = 0
    while k < n {
        strbuilder.append(objs, " ")
        _cf, _ = list.get(c_files, k)
        strbuilder.append(objs, _cf)
        k = k + 1
    }
    cc = string.concat(cc, strbuilder.finish(objs))
    // Include path: generated C files use bare #include names but
    // real installs nest headers under include/aether/{runtime,std}/...
    // Add -I for every dir under the include root.
    inc_root = _resolve_aether_include(aether_dir)
    if string.length(inc_root) > 0 {
        cc = string.concat(cc, " $(find ")
        cc = string.concat(cc, inc_root)
        cc = string.concat(cc, " -type d -print | sed 's|^|-I|')")
    }

    if string.length(libaether_dir) == 0 {
        println("aeb-link: libaether.a not found near ${aether_dir} — your Aether install looks incomplete")
        exit(1)
    }
    cc = string.concat(cc, " -L")
    cc = string.concat(cc, libaether_dir)
    cc = string.concat(cc, " -laether")
    cc = string.concat(cc, " -o ")
    cc = string.concat(cc, out_bin)
    // Duplicate-symbol tolerance: GNU ld accepts --allow-multiple-definition
    // to silently dedupe imported module functions that the Aether compiler
    // currently emits into every translation unit. Apple's ld64 rejects the
    // flag outright, so on macOS we omit it entirely. Programs with genuine
    // duplicate symbols will still fail to link on macOS; the permanent fix
    // is upstream in the Aether compiler (see TODO.md).
    // libaether.a unconditionally references zlib/openssl symbols
    // when the Aether toolchain was built with them detected. Pull
    // the link flags from pkg-config; no-op when libs absent.
    sysdeps = " $(pkg-config --libs zlib openssl 2>/dev/null)"
    if _is_macos_link() == 1 {
        cc = string.concat(cc, " -pthread -lm")
        cc = string.concat(cc, sysdeps)
        cc = string.concat(cc, " 2>&1")
    } else {
        cc = string.concat(cc, " -pthread -lm")
        cc = string.concat(cc, sysdeps)
        cc = string.concat(cc, " -Wl,--allow-multiple-definition 2>&1")
    }
    os.system(cc)

    // --noexe (AEB_NOEXE=1): stop here. The orchestrator binary (out_bin) is
    // linked and on disk, but we do NOT run it — so no build work executes.
    // This is Cut 1 of the two-aeb duality (docs/two-aeb-duality.md): compile
    // the .ae build scripts into the native orchestrator IN the container,
    // then a host-side launcher (aeb-ctr) RUNS out_bin on the host. Aether is
    // compiled, so "build the build scripts" and "run the build" are two
    // phases; --noexe is the cut between them.
    if string.equals(os.getenv("AEB_NOEXE"), "1") == 1 {
        println("aeb --noexe: orchestrator linked at ${out_bin} (not run)")
        exit(0)
    }

    // --- Run: per-node driver (default) or all-in-one orchestrator ---
    // Per-node (nodes-as-subprocesses, docs/nodes-as-subprocesses.md) is
    // the DEFAULT: each node runs as its own `out_bin <root> <label>` via
    // aeb-driver, redirecting per-node tool output into target/.aeb/logs/
    // (compartmentalized stdout). Opt back to the all-in-one in-process
    // run with `aeb --in-process` (AEB_IN_PROCESS=1) or AEB_PER_NODE=0 —
    // faster for small builds, simplest to debug. AEB_PER_NODE, if set,
    // wins (1=per-node, 0=in-process).
    per_node = 1
    if string.equals(os.getenv("AEB_IN_PROCESS"), "1") == 1 { per_node = 0 }
    _pn = os.getenv("AEB_PER_NODE")
    if string.length(_pn) > 0 {
        per_node = 1
        if string.equals(_pn, "0") == 1 { per_node = 0 }
    }
    if per_node == 1 {
        aeb_driver = string.concat(aebhome, "/tools/aeb-driver")
        if file.exists(aeb_driver) == 0 {
            // Lazy-build: aeb-driver imports `build` (lib) + aeblabel (tools).
            db = string.concat(aether_bin, " build ")
            db = string.concat(db, string.concat(aebhome, "/tools/aeb-driver.ae -o "))
            db = string.concat(db, aeb_driver)
            db = string.concat(db, string.concat(" --lib ", compile_lib))
            db = string.concat(db, string.concat(" --lib ", string.concat(aebhome, "/tools 2>/dev/null")))
            os.system(db)
        }
        // aeb-driver reads the edges file (node + its deps per line) to
        // generate the parallel Makefile. NB: aeb-link's arg1
        // (`edges_file`) is actually the topo-sorted *list* (_sorted.txt,
        // no deps); the real deps live in build_dir/_edges.txt.
        real_edges = string.concat(build_dir, "/_edges.txt")
        dcmd = string.concat("'", aeb_driver)
        dcmd = string.concat(dcmd, "' '")
        dcmd = string.concat(dcmd, root)
        dcmd = string.concat(dcmd, "' '")
        dcmd = string.concat(dcmd, out_bin)
        dcmd = string.concat(dcmd, "' '")
        dcmd = string.concat(dcmd, real_edges)
        dcmd = string.concat(dcmd, "'")
        rc = os.system(dcmd)
        exit(rc)
    }

    // --- Run the orchestrator binary (child process) and propagate exit ---
    // We don't have execv in stdlib so this stays a fork+wait rather than a
    // true exec. The parent process holds for the duration; otherwise it's
    // semantically identical to the bash `exec` it replaces.
    exec_cmd = string.concat(out_bin, " ")
    exec_cmd = string.concat(exec_cmd, root)
    rc = os.system(exec_cmd)
    exit(rc)
}
