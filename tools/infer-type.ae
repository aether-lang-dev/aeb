// infer-type — CLI wrapper over the canonical aeblabel.infer_type.
//
// The type is read LITERALLY from the filename (NOT inferred into a fixed set):
// the type IS the `<type>` segment of `.<type>[-tag].ae`. The route is the
// filename (docs/filename-is-the-route.md). Any name routes to itself:
//   .build.ae→build, .install.ae→install, .essais.ae→essais (French & all).
//   .tests[-tag].ae → "test" (the one legacy alias: plural file, singular word).
//   bare dir / non-".<type>.ae" → "build".
//
// This CLI delegates to the single canonical implementation in
// tools/aeblabel (so there is no second copy to drift). Build with --lib tools.
//
// Usage: infer-type <file> [<file>...]   — prints the type per input, one/line.

import std.os
import aeblabel (infer_type)

extern println(s: string)
extern exit(code: int)

main() {
    argc = aether_args_count()
    if argc < 2 {
        println("Usage: infer-type <file> [<file>...]")
        exit(1)
    }
    i = 1
    while i < argc {
        println(infer_type(aether_args_get(i)))
        i = i + 1
    }
}
