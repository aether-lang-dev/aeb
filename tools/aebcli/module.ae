// aeb CLI front-end — pure argument / target classification.
//
// This is the FIRST Aether-native slice of the bash `aeb` trampoline
// (TODO.md § "Full Aether CLI entrypoint (replace the bash trampoline)").
// The trampoline's hardest-to-test bulk is its argv grammar: flag stripping,
// the `path/to:name` synonym resolution, and the coordinate-vs-target
// rejection. Those are pure string transforms, so they belong in a tested
// Aether module — the file-existence probe, env-export, and dispatch stay in
// the (future) compiled entrypoint around these.
//
// WINDOWS-CORRECT BY CONSTRUCTION. The bash trampoline classifies a target
// with `[[ "$a" == *:* ]]` / `*:*:*`, which mis-reads a Windows drive path
// `C:\proj\app` as a `:name` synonym (and `C:\a\b:c` as a coordinate). Here a
// leading drive-letter prefix is stripped before the synonym colon is counted
// (`_has_drive_prefix`), so drive paths classify as plain targets and a
// drive-qualified synonym still resolves. Drive detection is purely syntactic
// (a letter + ':' + sep-or-end), so it is host-independent here — there are no
// Windows drives on POSIX, but a token shaped like one is never a valid aeb
// synonym anyway, so classifying it as plain on every host is both safe and
// simpler. See docs/windows-cross-platform-notes.md (Nushell-derived rule).

import std.string
import std.list

// NOTE: this is a deliberate copy of lib/build's `_has_windows_drive_prefix`.
// It cannot `import build` and call `build._has_windows_drive_prefix` because
// a two-level transitive qualified call (test -> aebcli -> build) trips the
// known Aether qualified-symbol-resolution bug (TODO.md § "Aether compiler
// issues", the `maven.classpath` two-level item). Consolidate onto the single
// lib/build copy once that upstream bug is fixed. Pure/syntactic; in sync with
// lib/build. Portions copyright The Nushell Project Developers (rule from
// nu-path, MIT — see NOTICE).
_has_drive_prefix(s: string) {
    if string.length(s) < 2 { return 0 }
    if string.equals(string.substring(s, 1, 2), ":") == 0 { return 0 }
    c0 = string.substring(s, 0, 1)
    letters = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
    if string.contains(letters, c0) == 0 { return 0 }
    if string.length(s) == 2 { return 1 }
    c2 = string.substring(s, 2, 3)
    if string.equals(c2, "/") == 1 { return 1 }
    if string.equals(c2, "\\") == 1 { return 1 }
    return 0
}

// Count ':' in `s` from byte index `from` to the end.
_count_colons_from(s: string, from: int) {
    n = string.length(s)
    cnt = 0
    i = from
    while i < n {
        ch = string.substring(s, i, i + 1)
        if string.equals(ch, ":") == 1 {
            cnt = cnt + 1
        }
        i = i + 1
    }
    return cnt
}

// Byte offset just past a leading Windows drive prefix ("C:"), else 0.
_drive_off(tok: string) {
    if _has_drive_prefix(tok) == 1 {
        return 2
    }
    return 0
}

// 1 if `tok` is an option flag (starts with '-'). Flags are stripped/handled
// before target classification in the trampoline loop.
is_flag(tok: string) {
    if string.length(tok) == 0 {
        return 0
    }
    if string.equals(string.substring(tok, 0, 1), "-") == 1 {
        return 1
    }
    return 0
}

// Classify a NON-flag argv token by its colon count (after any drive prefix):
//   "coordinate" — 2+ colons (a Maven `g:a:v`; rejected, exit 2 in the loop)
//   "synonym"    — exactly 1 colon (`path/to:name` or bare `:name`)
//   "plain"      — 0 colons (a file path / bare arg, incl. a Windows drive path)
classify_target(tok: string) {
    off = _drive_off(tok)
    colons = _count_colons_from(tok, off)
    if colons == 0 {
        return string.concat("plain", "")
    }
    if colons == 1 {
        return string.concat("synonym", "")
    }
    return string.concat("coordinate", "")
}

// Index of the synonym colon (the first ':' after any drive prefix), or -1.
_synonym_colon(tok: string) {
    off = _drive_off(tok)
    n = string.length(tok)
    i = off
    while i < n {
        ch = string.substring(tok, i, i + 1)
        if string.equals(ch, ":") == 1 {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

// Directory part of a synonym: "path/to:name" -> "path/to", ":name" -> "".
synonym_dir(tok: string) {
    c = _synonym_colon(tok)
    if c <= 0 {
        return string.concat("", "")
    }
    return string.substring(tok, 0, c)
}

// Name part of a synonym: "path/to:name" -> "name", ":name" -> "name".
// "" when the name is empty (e.g. a trailing-colon token) — the caller
// treats an empty name as the "empty target name" error (exit 2).
synonym_name(tok: string) {
    c = _synonym_colon(tok)
    if c < 0 {
        return string.concat("", "")
    }
    return string.substring(tok, c + 1, string.length(tok))
}

// The `.name.ae` relative path a synonym resolves to. Bare ":name" anchors
// to the cwd as "./.name.ae"; "path/to:name" -> "path/to/.name.ae".
synonym_relpath(tok: string) {
    d = synonym_dir(tok)
    nm = synonym_name(tok)
    if string.length(d) == 0 {
        return string.concat(string.concat("./.", nm), ".ae")
    }
    return string.concat(string.concat(string.concat(d, "/."), nm), ".ae")
}

// Canonical FQN echoed back to teach the long form: strip a leading "./".
// "./.build.ae" -> ".build.ae"; "app/.build.ae" -> "app/.build.ae".
synonym_fqn(relpath: string) {
    if string.length(relpath) >= 2 {
        if string.equals(string.substring(relpath, 0, 2), "./") == 1 {
            return string.substring(relpath, 2, string.length(relpath))
        }
    }
    return relpath
}

// --- Flag table -------------------------------------------------------
//
// The bash trampoline's flag loop is, at its core, a static table: each
// recognised `--flag` maps to (a) the AEB_* env var it sets, (b) whether
// it is a boolean (sets "1") or consumes the next argv as its value, and
// (c) the env var it IMPLIES (e.g. `--sbom-json` implies AEB_RESOLVE_ONLY).
// `flag_spec` is that table as pure data; the entrypoint reads it to drive
// the loop. The IMPURE parts the bash also does (file-existence checks,
// absolute-path resolution, the `--timeout` numeric validation, the
// `--vet-tool` newline accumulation) stay in the entrypoint around this —
// here we only encode the static shape so the grammar is testable.
//
// Returns "" for an unrecognised token (the bash `else` branch passes such
// args through to aeb-main untouched). Otherwise "ENV KIND" or
// "ENV KIND IMPLIESENV", where KIND is "bool" or "value".
flag_spec(flag: string) {
    // boolean flags (presence sets the env var to "1")
    if string.equals(flag, "--coverage") == 1 { return "AEB_COVERAGE bool" }
    if string.equals(flag, "--in-process") == 1 { return "AEB_IN_PROCESS bool" }
    if string.equals(flag, "--compile-only") == 1 { return "AEB_COMPILE_ONLY bool" }
    if string.equals(flag, "--execute-only") == 1 { return "AEB_EXECUTE_ONLY bool" }
    if string.equals(flag, "--noexe") == 1 { return "AEB_NOEXE bool" }
    if string.equals(flag, "--use-remote-agents") == 1 { return "AEB_USE_REMOTE_AGENTS bool" }
    if string.equals(flag, "--resolve-only") == 1 { return "AEB_RESOLVE_ONLY bool" }
    if string.equals(flag, "--trace-intent") == 1 { return "AEB_TRACE_INTENT bool" }
    if string.equals(flag, "--vet") == 1 { return "AEB_VET bool" }
    if string.equals(flag, "--sandbox") == 1 { return "AEB_SANDBOX bool" }
    // value flags (consume the next argv as the value)
    if string.equals(flag, "--scan") == 1 { return "AEB_SCAN value" }
    if string.equals(flag, "--shard") == 1 { return "AEB_SHARD value" }
    if string.equals(flag, "--telemetry-json") == 1 { return "AEB_TELEMETRY_JSON value" }
    if string.equals(flag, "--agents") == 1 { return "AEB_AGENTS value" }
    if string.equals(flag, "--artifacts-json") == 1 { return "AEB_ARTIFACTS_JSON value" }
    if string.equals(flag, "--tests-json") == 1 { return "AEB_TESTS_JSON value" }
    if string.equals(flag, "--timeout") == 1 { return "AEB_TIMEOUT value" }
    // value flags that ALSO imply another env var
    if string.equals(flag, "--sbom-json") == 1 { return "AEB_SBOM_JSON value AEB_RESOLVE_ONLY" }
    if string.equals(flag, "--intent-json") == 1 { return "AEB_INTENT_JSON value AEB_TRACE_INTENT" }
    if string.equals(flag, "--veto-policy") == 1 { return "AEB_VETO_POLICY value AEB_VET" }
    if string.equals(flag, "--vet-tool") == 1 { return "AEB_VET_TOOLS value AEB_VET" }
    if string.equals(flag, "--sandbox-profile") == 1 { return "AEB_SANDBOX_PROFILE value AEB_SANDBOX" }
    return string.concat("", "")
}

// 1 if `flag` is a recognised aeb option (has a flag_spec entry).
flag_known(flag: string) {
    if string.length(flag_spec(flag)) > 0 { return 1 }
    return 0
}

// The AEB_* env var a flag sets (first spec field), or "" if unknown.
flag_env(flag: string) {
    spec = flag_spec(flag)
    if string.length(spec) == 0 { return string.concat("", "") }
    sp = string.index_of(spec, " ")
    return string.substring(spec, 0, sp)
}

// 1 if the flag consumes the next argv as its value, 0 for a boolean flag
// (and 0 for an unknown token).
flag_takes_value(flag: string) {
    spec = flag_spec(flag)
    if string.length(spec) == 0 { return 0 }
    if string.index_of(spec, " value") >= 0 { return 1 }
    return 0
}

// The env var this flag IMPLIES (the third spec field), or "" if none.
// e.g. flag_implies("--sbom-json") -> "AEB_RESOLVE_ONLY".
flag_implies(flag: string) {
    spec = flag_spec(flag)
    // third field after "ENV KIND " — present only for the implying flags.
    first = string.index_of(spec, " ")
    if first < 0 { return string.concat("", "") }
    rest = string.substring(spec, first + 1, string.length(spec))
    second = string.index_of(rest, " ")
    if second < 0 { return string.concat("", "") }
    return string.substring(rest, second + 1, string.length(rest))
}

// 1 if `s` is one or more ASCII digits (the `--timeout` validation the bash
// does with `^[0-9]+$`). Empty string is NOT all-digits.
_is_all_digits(s: string) {
    n = string.length(s)
    if n == 0 { return 0 }
    digits = "0123456789"
    i = 0
    while i < n {
        ch = string.substring(s, i, i + 1)
        if string.contains(digits, ch) == 0 { return 0 }
        i = i + 1
    }
    return 1
}

// --- The argv interpreter --------------------------------------------
//
// `parse_argv` is the Aether-native port of the bash trampoline's flag
// loop. It consumes the raw argv (a list of strings) and returns an
// ordered list of DIRECTIVE strings the (compiled) entrypoint executes —
// keeping this function PURE (no env mutation, no file I/O, no exit), so
// the whole grammar is unit-testable. Each directive is tab-separated:
//
//   env\t<NAME>\t<VALUE>          export NAME=VALUE
//   env-append\t<NAME>\t<VALUE>   append VALUE to NAME (newline-joined;
//                                 only AEB_VET_TOOLS, which accumulates)
//   arg\t<VALUE>                  a build target / passthrough arg
//   synonym\t<RELPATH>\t<FQN>     a `path/to:name` synonym — the entrypoint
//                                 checks RELPATH exists (else exit 2), echoes
//                                 "aeb synonym match: <FQN>", passes FQN as arg
//   error\t<CODE>\t<MESSAGE>      print MESSAGE to stderr, exit CODE
//
// An error directive is terminal: the bash loop exits on the first error,
// so parse_argv stops emitting after it. The file-existence / absolute-path
// resolution / env mutation the bash also does stay in the entrypoint that
// interprets these directives.
_d2(a: string, b: string) {
    return string.concat(string.concat(a, "\t"), b)
}
_d3(a: string, b: string, c: string) {
    return string.concat(string.concat(string.concat(a, "\t"), b), string.concat("\t", c))
}

// index_of `needle` in `s` at or after byte offset `from`, or -1.
_index_of_from(s: string, needle: string, from: int) {
    sub = string.substring(s, from, string.length(s))
    r = string.index_of(sub, needle)
    if r < 0 { return 0 - 1 }
    return r + from
}

// The 0-based nth tab-separated field of a directive ("" if absent).
// directive_field("env\tA\t1", 0) -> "env"; (.., 2) -> "1".
directive_field(d: string, n: int) {
    start = 0
    idx = 0
    while idx < n {
        t = _index_of_from(d, "\t", start)
        if t < 0 { return string.concat("", "") }
        start = t + 1
        idx = idx + 1
    }
    e = _index_of_from(d, "\t", start)
    if e < 0 { return string.substring(d, start, string.length(d)) }
    return string.substring(d, start, e)
}

// The directive kind (its first field): "env" | "env-append" | "arg" |
// "synonym" | "error".
directive_kind(d: string) {
    return directive_field(d, 0)
}

// The accumulation rule for `--vet-tool` (the AEB_VET_TOOLS env var): the
// bash joins repeated values with a newline. Pure, given the prior value.
env_append_value(prior: string, addition: string) {
    if string.length(prior) == 0 {
        return addition
    }
    return string.concat(string.concat(prior, "\n"), addition)
}

// Extract a field from AEB_STAMP content (the `--version` provenance file,
// written by `make install`). Each line is "<key> <value...>"; returns the
// remainder after the first space of the first line whose first token is
// `key`, or "" if absent. Ports the bash `awk '$1=="key"{...}'` extraction
// (handles multi-word values like `installed 2026-06-11 ...`).
stamp_field(text: string, key: string) {
    rest = text
    going = 1
    while going == 1 {
        nl = string.index_of(rest, "\n")
        line = rest
        if nl >= 0 {
            line = string.substring(rest, 0, nl)
        }
        sp = string.index_of(line, " ")
        if sp >= 0 {
            tok = string.substring(line, 0, sp)
            if string.equals(tok, key) == 1 {
                return string.substring(line, sp + 1, string.length(line))
            }
        }
        if nl < 0 {
            going = 0
        }
        else {
            rest = string.substring(rest, nl + 1, string.length(rest))
        }
    }
    return string.concat("", "")
}

parse_argv(argv: ptr) {
    out = list.new()
    n = list.size(argv)
    i = 0
    going = 1
    while i < n {
        if going == 1 {
            a, _ga = list.get(argv, i)
            spec = flag_spec(a)
            if string.length(spec) > 0 {
                // A recognised flag.
                env = flag_env(a)
                implies = flag_implies(a)
                if flag_takes_value(a) == 1 {
                    if i + 1 >= n {
                        _x1 = list.add(out, _d3("error", "1", string.concat(string.concat("aeb: ", a), " requires an argument")))
                        going = 0
                    }
                    else {
                        val, _gv = list.get(argv, i + 1)
                        i = i + 1
                        if string.equals(a, "--timeout") == 1 {
                            if _is_all_digits(val) == 0 {
                                _x2 = list.add(out, _d3("error", "1", string.concat(string.concat("aeb: --timeout must be a whole number of seconds, got '", val), "'")))
                                going = 0
                            }
                            else {
                                _x3 = list.add(out, _d3("env", env, val))
                            }
                        }
                        else {
                            if string.equals(env, "AEB_VET_TOOLS") == 1 {
                                _x4 = list.add(out, _d3("env-append", env, val))
                            }
                            else {
                                _x5 = list.add(out, _d3("env", env, val))
                            }
                            if string.length(implies) > 0 {
                                _x6 = list.add(out, _d3("env", implies, "1"))
                            }
                        }
                    }
                }
                else {
                    // Boolean flag.
                    _x7 = list.add(out, _d3("env", env, "1"))
                }
            }
            else {
                // Not a recognised flag.
                if is_flag(a) == 1 {
                    // Unknown option — the bash `else` branch passes it through.
                    _x8 = list.add(out, _d2("arg", a))
                }
                else {
                    kind = classify_target(a)
                    if string.equals(kind, "coordinate") == 1 {
                        _x9 = list.add(out, _d3("error", "2", string.concat(string.concat("aeb: '", a), "' looks like a coordinate, not a target (a target is 'path/to:name' or ':name')")))
                        going = 0
                    }
                    else {
                        if string.equals(kind, "synonym") == 1 {
                            nm = synonym_name(a)
                            if string.length(nm) == 0 {
                                _x10 = list.add(out, _d3("error", "2", string.concat(string.concat("aeb: empty target name in synonym '", a), "' (use 'path/to:name' or ':name')")))
                                going = 0
                            }
                            else {
                                rp = synonym_relpath(a)
                                _x11 = list.add(out, _d3("synonym", rp, synonym_fqn(rp)))
                            }
                        }
                        else {
                            _x12 = list.add(out, _d2("arg", a))
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    return out
}
