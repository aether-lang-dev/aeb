// aeblabel — the single canonical implementation of build-file
// label / tag derivation, shared by every tool that needs it.
//
// Historically this logic was copy-pasted into three places
// (tools/file-to-label.ae, tools/gen-orchestrator.ae,
// tools/aeb-link.ae) with no drift detection — TODO.md § Test
// coverage gaps tracked the hazard. Multi-entry `--lib` (aether
// 0.150) made it possible to keep tool sources importable, so the
// three copies now collapse to this one module. Every consumer
// does `import aeblabel (...)`; `tests/test_file_to_label.ae`
// imports the same module, so the test exercises the real code
// rather than a fourth inlined copy.
//
// Label grammar (see tools/file-to-label.ae for the CLI):
//
//   path/to/.build.ae          → "path/to"
//   path/to/.build-seed.ae     → "path/to:seed"
//   path/to/.tests.ae          → "test:path/to"
//   path/to/.tests-extra.ae    → "test:path/to:extra"
//   path/to/.dist.ae           → "dist:path/to"
//   path/to/.dist-fat.ae       → "dist:path/to:fat"
//
// The `:tag` suffix lets multiple .build*.ae / .tests*.ae /
// .dist*.ae files coexist in one directory without colliding on
// bldr.begin's visited-set dedup. Canonical (untagged) names keep
// today's labels unchanged.

import std.string
import std.list

// The build file's type IS the WHOLE `.<type>.ae` segment, verbatim — the route
// is the filename (docs/design/filename-is-the-route.md). No inference into a fixed set,
// no `-`-split, no tags: the literal name between the leading '.' and trailing
// '.ae' is the type, dashes and all. Any name routes to itself:
//   .build.ae→build, .install.ae→install, .essais.ae→essais (French & all),
//   .bidi-codegen.ae→bidi-codegen, .quantum-signal.ae→quantum-signal.
// Co-located variants are just different-named types (.build.ae + .seed.ae),
// naturally distinct — no tag mechanism needed.
// A bare dir / non-".<name>.ae" file → "build" (depend on its build output).
//
// NO bias toward any spelling: .tes.ae→tes, .test.ae→test, .tests.ae→tests are
// all equally literal. Whether a testing thing is named singular or plural is
// the QA team's call when they name the file, not aeb's to normalize.
infer_type(file: string) {
    base = file
    sl = dirname_pure(file)
    if string.equals(sl, ".") == 0 {
        base = string.substring(file, string.length(sl) + 1, string.length(file))
    }
    if string.index_of(base, ".") == 0 {
        if string.ends_with(base, ".ae") == 1 {
            // the whole stem IS the type — verbatim, no '-' split.
            stem = string.substring(base, 1, string.length(base) - 3)  // drop leading '.' + trailing '.ae'
            if string.length(stem) > 0 { return stem }
        }
    }
    return "build"
}

// dirname: last '/'-bounded prefix, or "." if no slash. Pure — no
// shell `dirname` call, so it is cross-platform and subprocess-free.
dirname_pure(path: string) {
    n = string.length(path)
    last = -1
    i = 0
    while i < n {
        ch = string.substring(path, i, i + 1)
        if string.index_of(ch, "/") == 0 {
            last = i
        }
        i = i + 1
    }
    if last < 0 {
        return string.concat(".", "")
    }
    if last == 0 {
        return string.concat("/", "")
    }
    return string.substring(path, 0, last)
}

// basename: the final '/'-bounded component, or the whole path if
// there is no slash.
basename_pure(path: string) {
    n = string.length(path)
    last = -1
    i = 0
    while i < n {
        ch = string.substring(path, i, i + 1)
        if string.index_of(ch, "/") == 0 {
            last = i
        }
        i = i + 1
    }
    if last < 0 { return path }
    return string.substring(path, last + 1, n)
}

// DEPRECATED — tags are gone. The whole `.<name>.ae` segment is the type now,
// so co-located variants are different-named types (.build.ae + .seed.ae), not
// a base+tag. Always returns "". Kept only so existing importers don't break;
// new code should not call it.
extract_tag(file: string) {
    return string.concat("", "")
}

// counts_line(files) — the end-of-scan display summary: one "<n> <type>"
// clause per DISTINCT verbatim type (infer_type) across the given build-file
// paths, in first-seen order, joined with " + ":
//
//   aeb: 3 build + 2 dist + 4 tests + 2 構築
//
// Verbatim on purpose: no normalization of build→compile or tests→test —
// the filename is the route (docs/design/filename-is-the-route.md), so the summary
// speaks the repo's own vocabulary, whatever language or spelling that is.
// A type absent from the tree is simply not shown (no zero rows). Empty
// input renders "aeb: 0 targets". Counting is a two-pass O(n·types) scan;
// n is the node count of one invocation, so no strbuilder needed.
counts_line(files: ptr) {
    n = list.size(files)
    if n == 0 {
        return string.concat("aeb: 0 targets", "")
    }
    // Pass 1: distinct types, first-seen order.
    types = list.new()
    i = 0
    while i < n {
        f, _ = list.get(files, i)
        t = infer_type(f)
        seen = 0
        j = 0
        m = list.size(types)
        while j < m {
            u, _ = list.get(types, j)
            if string.equals(u, t) == 1 { seen = 1 }
            j = j + 1
        }
        if seen == 0 { _d = list.add(types, t) }
        i = i + 1
    }
    // Pass 2: count each type, render " + "-joined clauses.
    out = "aeb:"
    m = list.size(types)
    j = 0
    while j < m {
        u, _ = list.get(types, j)
        c = 0
        i = 0
        while i < n {
            f, _ = list.get(files, i)
            t = infer_type(f)
            if string.equals(t, u) == 1 { c = c + 1 }
            i = i + 1
        }
        if j > 0 { out = string.concat(out, " +") }
        out = string.concat(out, " ")
        out = string.concat(out, string.from_int(c))
        out = string.concat(out, " ")
        out = string.concat(out, u)
        j = j + 1
    }
    return out
}

// Derive the bldr.begin() label for a build file path:
//   <type>:<dir>   for any NON-"build" type  (test:foo, dist:foo, install:foo,
//                  bidi-codegen:itests/selenium/py, quantum-signal:foo, …)
//   <dir>          for the "build" type (the unprefixed default — keeps every
//                  existing .build.ae label unchanged).
// The type is the WHOLE literal segment (infer_type); no tag suffix. The reader
// (_dep_target_dir) and the writer (bldr.begin) both strip a leading "<type>:"
// generically, so any name round-trips to target/<type>/<dir>/.
file_to_label(file: string) {
    type = infer_type(file)
    dir = dirname_pure(file)
    if string.equals(type, "build") == 1 {
        return dir
    }
    return string.concat(string.concat(type, ":"), dir)
}

// --- Name encoding -------------------------------------------------------
//
// encode_name(path) — turn a build-file path into a C-identifier-safe
// name for the generated orchestrator's function symbols.
//
// WHY IT LIVES HERE. This was copy-pasted into tools/aeb-link.ae,
// tools/gen-orchestrator.ae and tools/encode-name.ae — the same three-copy
// hazard this module was created to end, and with drift already visible
// (one copy had picked up explanatory comments the others lacked).
//
// It also had to move for a HARD reason. The local copies each defined a
// helper named `string_replace_all`, and aether 0.463.0 added a C function
// with exactly that name to std.string's runtime. Two definitions of one
// symbol is a link error:
//
//   multiple definition of `string_replace_all';
//   aeb-link.c:(.text+0x2e70): first defined here
//
// which broke `make` outright on any aether >= 0.463.
//
// The replacement is now std's own `string.replace_all`, not a local
// helper. That is only possible because AETHER_PIN was raised to 0.463.0
// — the first release that has it. Before that bump a local copy was
// mandatory: calling the native one would have fixed newer toolchains by
// breaking the version aeb actually pinned (0.452.0).
//
// Semantics were differential-tested against the previous local
// implementation on 0.463.0 across 11 cases — including the empty-needle
// guard (returns the input rather than looping) and the sentinel
// round-trip below — and are identical.
//
// Still no shell, which is load-bearing: encode_name once shelled out to
// `printf '%s' | sed`, which returns EMPTY on Windows (cmd.exe cannot run
// the POSIX pipeline). Every extern/call name then came out blank and
// produced an unparseable orchestrator (`extern (s: ptr)`). The native
// function is in-process, so that trap stays closed.

encode_name(input: string) {
    sentinel = "0DBLUND0"
    s = string.replace_all(input, "__", sentinel)
    s = string.replace_all(s, "/", "_")
    s = string.replace_all(s, "-", "_H_")
    s = string.replace_all(s, ".", "_D_")
    s = string.replace_all(s, sentinel, "__")
    // The result is used verbatim as a C FUNCTION NAME (the per-node module
    // entry) — both the definition (transform-ae renames the user's main() to
    // it) and the orchestrator's `extern`. A name that LEADS WITH '_' desyncs
    // those two: aetherc escapes a leading-underscore top-level function OUT of
    // C's reserved namespace by prefixing "ae" (the 0.516 cf4f2bd5 fix — `_write`
    // once collided with MSVCRT's `_write`), so the .o defines `ae_D_build_D_ae`
    // while the orchestrator externs `_D_build_D_ae` → `undefined reference`.
    // The only path that produces a leading '_' is one whose FIRST char is '.'
    // (a leading '.' → '_D_'), i.e. a ROOT-level target like ".build.ae" (label
    // "."). Mirror the compiler's own escape here so the name aeb generates is
    // already the one aetherc will emit, keeping definition and extern in sync.
    // (Corner: a real file literally named "ae.build.ae" at the repo root would
    // encode to the same "ae_D_build_D_ae" — accepted as a documented, absurd
    // collision that mirrors the compiler's namespace exactly.)
    if string.length(s) > 0 {
        if string.equals(string.substring(s, 0, 1), "_") == 1 {
            s = string.concat("ae", s)
        }
    }
    // Wrap the final return in an extern string fn so Aether's type
    // inference sees encode_name as returning string (user-fn return types
    // aren't chased through to the caller).
    return string.concat(s, "")
}

// --- Edges-file / path helpers shared by the graph-walking tools ---------
//
// `tools/aeb-query.ae` and `tools/affected-targets.ae` both parse the same
// edges file and walk the same directory ancestry, and both carried
// byte-identical copies of the three functions below. That is the
// three-copy hazard this module exists to end (see the header) — caught by
// the std-vs-aeb helper audit, which noticed the duplicate `_dirname`.
//
// `_build_indices` deliberately stays local to each tool: the two versions
// genuinely differ (affected-targets also registers a dep as a known
// target, since deps-of-deps may have no first-column row of their own in
// target-mode edges). Same name, different contract — not a copy.

// _walk_dirname(p) — parent directory, or "" at the top.
//
// DELIBERATELY NOT `path.dirname` OR build's `_dirname`, and the
// difference is load-bearing rather than sloppy. Both of those return "."
// for a bare name; this returns "". The callers walk UP the ancestry with
//
//     while ... { if string.length(cur) == 0 { done = 1 }
//                 else { cur = _walk_dirname(cur) } }
//
// so "" is the loop's TERMINATION SENTINEL. Traced with "."-semantics
// substituted in, `a/b/c.ae` walks a/b -> a -> "." -> "." -> "." forever.
// Anyone "fixing" this to match POSIX dirname(1) hangs `aeb --since` and
// `aeb query`. Hence the distinct name: it is a walk helper, not a
// general-purpose dirname.
//
// Forward slash only — edges-file paths are repo-relative and always
// written with '/', so no Windows separator handling is needed here.
_walk_dirname(p: string) {
    n = string.length(p)
    last = 0 - 1
    i = 0
    while i < n {
        ch = string.substring(p, i, i + 1)
        if string.equals(ch, "/") == 1 {
            last = i
        }
        i = i + 1
    }
    if last < 0 { return "" }
    return string.substring(p, 0, last)
}

// split_lines(buf) — newline-separated buffer to a list, dropping a
// trailing newline's empty final element (`start < n` guard). Blank lines
// in the MIDDLE are preserved.
split_lines(buf: string) {
    lines = list.new()
    n = string.length(buf)
    start = 0
    i = 0
    while i < n {
        ch = string.substring(buf, i, i + 1)
        if string.equals(ch, "\n") == 1 {
            line = string.substring(buf, start, i)
            list.add(lines, line)
            start = i + 1
        }
        i = i + 1
    }
    if start < n {
        list.add(lines, string.substring(buf, start, n))
    }
    return lines
}

// split_tokens(line) — space-separated fields, runs of spaces collapsed
// and empties dropped (`i > start` guard). Matches how the edges file
// writes a node and its deps on one line.
split_tokens(line: string) {
    tokens = list.new()
    n = string.length(line)
    start = 0
    i = 0
    while i < n {
        ch = string.substring(line, i, i + 1)
        if string.equals(ch, " ") == 1 {
            if i > start {
                list.add(tokens, string.substring(line, start, i))
            }
            start = i + 1
        }
        i = i + 1
    }
    if start < n {
        list.add(tokens, string.substring(line, start, n))
    }
    return tokens
}
