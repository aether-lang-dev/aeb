// aeblabel — the single canonical implementation of build-file
// label / tag derivation, shared by every tool that needs it.
//
// Historically this logic was copy-pasted into three places
// (tools/file-to-label.ae, tools/gen-orchestrator.ae,
// tools/aeb-link.ae) with no drift detection — TODO.md § Test
// coverage gaps tracked the hazard. Multi-entry `--lib` (aether
// 0.150) made it possible to keep tool sources importable, so the
// three copies now collapse to this one module. Every consumer
// does `import aeblabel (...)`; `tests/test_file_to_label.ae`
// imports the same module, so the test exercises the real code
// rather than a fourth inlined copy.
//
// Label grammar (see tools/file-to-label.ae for the CLI):
//
//   path/to/.build.ae          → "path/to"
//   path/to/.build-seed.ae     → "path/to:seed"
//   path/to/.tests.ae          → "test:path/to"
//   path/to/.tests-extra.ae    → "test:path/to:extra"
//   path/to/.dist.ae           → "dist:path/to"
//   path/to/.dist-fat.ae       → "dist:path/to:fat"
//
// The `:tag` suffix lets multiple .build*.ae / .tests*.ae /
// .dist*.ae files coexist in one directory without colliding on
// build.begin's visited-set dedup. Canonical (untagged) names keep
// today's labels unchanged.

import std.string

// The build file's type IS the WHOLE `.<type>.ae` segment, verbatim — the route
// is the filename (docs/filename-is-the-route.md). No inference into a fixed set,
// no `-`-split, no tags: the literal name between the leading '.' and trailing
// '.ae' is the type, dashes and all. Any name routes to itself:
//   .build.ae→build, .install.ae→install, .essais.ae→essais (French & all),
//   .bidi-codegen.ae→bidi-codegen, .quantum-signal.ae→quantum-signal.
// Co-located variants are just different-named types (.build.ae + .seed.ae),
// naturally distinct — no tag mechanism needed.
// A bare dir / non-".<name>.ae" file → "build" (depend on its build output).
//
// NO bias toward any spelling: .tes.ae→tes, .test.ae→test, .tests.ae→tests are
// all equally literal. Whether a testing thing is named singular or plural is
// the QA team's call when they name the file, not aeb's to normalize.
infer_type(file: string) {
    base = file
    sl = dirname_pure(file)
    if string.equals(sl, ".") == 0 {
        base = string.substring(file, string.length(sl) + 1, string.length(file))
    }
    if string.index_of(base, ".") == 0 {
        if string.ends_with(base, ".ae") == 1 {
            // the whole stem IS the type — verbatim, no '-' split.
            stem = string.substring(base, 1, string.length(base) - 3)  // drop leading '.' + trailing '.ae'
            if string.length(stem) > 0 { return stem }
        }
    }
    return "build"
}

// dirname: last '/'-bounded prefix, or "." if no slash. Pure — no
// shell `dirname` call, so it is cross-platform and subprocess-free.
dirname_pure(path: string) {
    n = string.length(path)
    last = -1
    i = 0
    while i < n {
        ch = string.substring(path, i, i + 1)
        if string.index_of(ch, "/") == 0 {
            last = i
        }
        i = i + 1
    }
    if last < 0 {
        return string.concat(".", "")
    }
    if last == 0 {
        return string.concat("/", "")
    }
    return string.substring(path, 0, last)
}

// basename: the final '/'-bounded component, or the whole path if
// there is no slash.
basename_pure(path: string) {
    n = string.length(path)
    last = -1
    i = 0
    while i < n {
        ch = string.substring(path, i, i + 1)
        if string.index_of(ch, "/") == 0 {
            last = i
        }
        i = i + 1
    }
    if last < 0 { return path }
    return string.substring(path, last + 1, n)
}

// DEPRECATED — tags are gone. The whole `.<name>.ae` segment is the type now,
// so co-located variants are different-named types (.build.ae + .seed.ae), not
// a base+tag. Always returns "". Kept only so existing importers don't break;
// new code should not call it.
extract_tag(file: string) {
    return string.concat("", "")
}

// Derive the build.begin() label for a build file path:
//   <type>:<dir>   for any NON-"build" type  (test:foo, dist:foo, install:foo,
//                  bidi-codegen:itests/selenium/py, quantum-signal:foo, …)
//   <dir>          for the "build" type (the unprefixed default — keeps every
//                  existing .build.ae label unchanged).
// The type is the WHOLE literal segment (infer_type); no tag suffix. The reader
// (_dep_target_dir) and the writer (build.begin) both strip a leading "<type>:"
// generically, so any name round-trips to target/<type>/<dir>/.
file_to_label(file: string) {
    type = infer_type(file)
    dir = dirname_pure(file)
    if string.equals(type, "build") == 1 {
        return dir
    }
    return string.concat(string.concat(type, ":"), dir)
}
