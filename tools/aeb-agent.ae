// aeb-agent — remote-aeb listener (walking skeleton).
//
// A sovereign build agent: listens on HTTP, decides accept/busy/reject
// for an incoming dispatch against its scope, runs `aeb <target>`
// locally on the bare host, and returns a terse verdict. Stood up on a
// remote box (oldnuc / mac-mini / bazzite); an originating aeb's
// `agent.dispatch` fires requests at it.
//
// Usage:
//   aeb agent [--port N] [--host H] [--scope NAME] [--accept GLOB]
//             [--max-jobs N] [--workdir DIR]
//
// Walking skeleton — synchronous: POST /dispatch decides, runs aeb
// inline, and returns the final verdict in the same response (the
// fire-async + webhook-back + details_url split from the design doc is a
// later thickening). One scope from CLI flags for now; the composable
// scope-TREE config (.ae closure DSL, podman/vm run_on kinds) slots in
// without reshaping the decision core, which lives in lib/agent and is
// shared + unit-tested.
//
// Decision core (pure): agent._decision(scope, purpose, active).
// NOT yet: token auth, cache partitioning. See
// docs/run-policy-class-and-cloud-leverage.md.

import build
import std.http
import std.string
import std.os
import std.map
import std.list
import std.fs

import agent (_scope_accepts, dispatch_reply_json, ping_json, ping_json_ex, _json_field,
              _parse_tokens, _bearer_strip, _veto_run_rules,
              _image_match, _lease_verify, _lease_verify_any, _lease_field,
              _mode_offered, _branch_allowed, _autoclone_allowed, _secrets_have_token,
              _secrets_weak_line, _secrets_no_marker_line)
import veto (emit_ast_cmd, _lib_flags, decide, default_rules, rules_from_lines)
import std.io
import std.file
import std.json
import std.path

extern println(s: string)
extern exit(code: int)
extern http_server_start_raw(server: ptr) -> int
extern http_get_header(req: ptr, name: string) -> string
// The trusted TCP peer address (getpeername) is http.request_remote_addr (the
// std.http wrapper, Aether >=0.256) — distinct from the spoofable
// X-Forwarded-For header. Drives the --allow-from source-IP gate. No local
// extern: std.http already exports it.

// Config travels to the (state-less, can't-close-over-locals) route
// handler through the process env, set by main() before the server
// starts: AEB_AGENT_ACCEPT (glob), AEB_AGENT_MAX_JOBS, AEB_AGENT_WORKDIR.
// The handler reconstructs the scope map per request from these — cheap,
// and avoids module-level mutable globals (which Aether doesn't have).
// max_jobs enforcement is exercised by the lib/agent unit tests; under
// the skeleton's synchronous handling `active` is effectively 0, so the
// gate becomes load-bearing only when the handler goes async (a later
// thickening).

_scope_from_env() {
    s = map.new()
    ron = os.getenv("AEB_AGENT_RUN_ON")
    if string.length(ron) == 0 { ron = "host" }
    _r = map.put(s, "run_on", ron)
    mj = os.getenv("AEB_AGENT_MAX_JOBS")
    if string.length(mj) > 0 { _m = map.put(s, "max_jobs", mj) }
    glob = os.getenv("AEB_AGENT_ACCEPT")
    if string.length(glob) == 0 { glob = "preint/*" }
    globs = list.new()
    _g = list.add(globs, glob)
    _a = map.put(s, "accept_scope", globs)
    return s
}

// --- Build-slot gate: N capacity slots via atomic lock-dirs --------------
//
// CONCURRENCY: the HTTP server runs handlers on a worker-thread pool, so two
// dispatches genuinely race. We serialize with atomic `mkdir` (POSIX-atomic:
// exactly one caller wins a create, the rest get EEXIST) — race-safe across
// threads AND processes, no app-level mutex (Aether has none; the idiomatic
// actor-owned-state version awaits a synchronous actor `call`, filed as
// github.com/aether-lang-dev/aether/issues/736; lockdir ships now).
//
// CAPACITY (--max-jobs N, AEB_AGENT_MAX_JOBS): N slots → up to N concurrent
// builds; a dispatch claims the first free slot-<i>, else `busy`. A big box
// (64 cores) declares a large N; a NUC/Mac, 1.
//
// CAVEAT — true capacity is 1 with one shared --workdir: _prepare_tree does
// `git reset --hard && clean -ffdx` IN PLACE, so two builds in one tree clobber
// each other. So the safe default is 1. N>1 is only correct once each slot
// builds in its OWN checkout (per-slot workdir isolation — a TODO); until then
// an operator setting N>1 is opting into shared-tree risk (we warn at startup).

// _slot_root() — the per-agent lock directory (keyed by port so co-located
// agents don't share slots). Under TMPDIR/tmp.
_slot_root() {
    base = os.getenv("TMPDIR")
    if string.length(base) == 0 { base = "/tmp" }
    port = os.getenv("AEB_AGENT_PORT")
    if string.length(port) == 0 { port = "0" }
    return path.join(base, string.concat("aeb-agent-slots-", port))
}

// _slot_capacity() — N from AEB_AGENT_MAX_JOBS; default + floor 1.
_slot_capacity() {
    mj = os.getenv("AEB_AGENT_MAX_JOBS")
    if string.length(mj) == 0 { return 1 }
    n = _atoi(mj)
    if n < 1 { return 1 }
    return n
}

// _slot_claim() — atomically claim the first free slot. Returns the claimed
// lock-dir path, or "" if all N are taken (=> busy). The mkdir is the claim:
// fs.create_dir is a single mkdir(2) that FAILS if the dir exists (unlike
// mkdir_p), so the first thread to create slot-<i> owns it.
_slot_claim() {
    root = _slot_root()
    _mk = fs.mkdir_p(root)   // ensure the parent exists (idempotent)
    cap = _slot_capacity()
    i = 0
    while i < cap {
        slot = path.join(root, string.concat("slot-", string.from_int(i)))
        err = fs.create_dir(slot)
        if string.length(err) == 0 { return slot }   // we won this slot
        i = i + 1
    }
    return ""   // all slots taken
}

// _slot_release(slot) — free a claimed slot (best-effort). "" = nothing to do.
_slot_release(slot: string) {
    if string.length(slot) == 0 { return 0 }
    _d = fs.delete_dir(slot)
    return 0
}

// _first_csv(csv) — the first comma item, trimmed. "" → "". For the default
// provision mode (= first of --provision-modes).
_first_csv(csv: string) {
    c = string.index_of(csv, ",")
    if c < 0 { return string.trim(csv) }
    return string.trim(string.substring(csv, 0, c))
}

// _slot_index(slot_path) — the bare index <i> from a ".../slot-<i>" lock path.
// "" → "". The index NAMES the per-slot build tree (<workdir>/<i>), so each of
// the N slots builds in its own isolated checkout (no shared-tree clobbering).
_slot_index(slot_path: string) {
    base = path.basename(slot_path)
    pfx = "slot-"
    if string.length(base) <= string.length(pfx) { return "" }
    if string.equals(string.substring(base, 0, string.length(pfx)), pfx) == 0 { return "" }
    return string.substring(base, string.length(pfx), string.length(base))
}

// _check_preclone(base, n, offered) — startup check: if a pre-cloned mode
// (patch/advance) is offered, each <base>/<i> must be a git working copy (the
// agent never clones in those modes). Returns "" if ok, else a message naming
// the missing slot trees. autoclone-only agents skip this (they clone on demand).
_check_preclone(base: string, n: int, offered: string) {
    needs_preclone = 0
    if _mode_offered(offered, "patch") == 1 { needs_preclone = 1 }
    if _mode_offered(offered, "advance") == 1 { needs_preclone = 1 }
    if needs_preclone == 0 { return "" }
    missing = ""
    i = 0
    while i < n {
        // Match the actual build path: capacity 1 => <base>; >1 => <base>/<i>.
        tree = _slot_tree(base, string.from_int(i), n)
        if fs.exists(path.join(tree, ".git")) == 0 {
            missing = string.concat(missing, string.concat(" ", tree))
        }
        i = i + 1
    }
    return string.trim(missing)
}

// _slot_tree(base_dir, idx, cap) — the per-slot build tree under base_dir.
// CAPACITY 1 (the common single-builder case — one Mac, one tree): build
// DIRECTLY in base_dir, so `--workdir ~/proj` just works (no numbered subdir to
// pre-create). CAPACITY >1: each slot gets <base>/<i> so concurrent builds don't
// clobber. idx "" → base_dir (defensive).
_slot_tree(base_dir: string, idx: string, cap: int) {
    if cap <= 1 { return base_dir }
    if string.length(idx) == 0 { return base_dir }
    return path.join(base_dir, idx)
}

// _slot_clear_all() — remove the whole slot root at startup, so a crash that
// leaked lock-dirs doesn't wedge the agent permanently "busy". (The OTP answer
// is a supervisor restarting the slot-owner with clean state; here, a fresh
// start IS the reset.)
_slot_clear_all() {
    root = _slot_root()
    // delete each slot-<i> for a generous range, then the root. delete_dir only
    // removes empty dirs; slots are empty marker dirs, so this suffices.
    i = 0
    while i < 256 {
        slot = path.join(root, string.concat("slot-", string.from_int(i)))
        if fs.exists(slot) == 1 { _d = fs.delete_dir(slot) }
        i = i + 1
    }
    _dr = fs.delete_dir(root)
    return 0
}


// _presented_token(req) — pull the bearer from X-AEB-Token (preferred) or
// Authorization, stripping a "Bearer " prefix. "" if neither present.
_presented_token(req: ptr) {
    p = _bearer_strip(http_get_header(req, "X-AEB-Token"))
    if string.length(p) == 0 {
        p = _bearer_strip(http_get_header(req, "Authorization"))
    }
    return p
}

// _ip_allowed(req) — the source-IP gate, checked BEFORE auth (cheapest gate
// first; an off-list peer never reaches token verification). Uses the TRUSTED
// TCP peer address (getpeername via http_request_remote_addr, Aether >=0.256),
// NOT the spoofable X-Forwarded-For header — so it's a real access control, not
// theater. Defense-in-depth UNDER auth, not a replacement for it.
//
//   --allow-from <ip>[,<ip>...]  (AEB_AGENT_ALLOW_FROM): an exact-IP allow-list.
//   Unset → no IP restriction (bind-address still governs reachability).
//   Set → the peer's IP must EXACTLY match a listed IP, else reject. Fail-closed:
//   if the peer address can't be read (""), a configured list REFUSES (can't
//   verify ⇒ deny). Exact IPs only (no CIDR yet); matches v4 dotted-quad / v6
//   inet_ntop form as returned by the accessor.
// Returns 1 (allowed) / 0 (refused).
_ip_allowed(req: ptr) {
    allow = os.getenv("AEB_AGENT_ALLOW_FROM")
    if string.length(allow) == 0 { return 1 }   // no list → no IP restriction
    peer = http.request_remote_addr(req)
    if string.length(peer) == 0 { return 0 }     // list set but no addr → fail-closed
    // exact match against any comma-separated entry (trimmed).
    rest = allow
    while string.length(rest) > 0 {
        comma = string.index_of(rest, ",")
        item = ""
        if comma < 0 {
            item = rest
            rest = ""
        } else {
            item = string.substring(rest, 0, comma)
            rest = string.substring(rest, comma + 1, string.length(rest))
        }
        item = string.trim(item)
        if string.length(item) > 0 {
            if string.equals(item, peer) == 1 { return 1 }
        }
    }
    return 0
}

// _authed_for(req, purpose) — the auth gate (fail-closed), shared by /dispatch
// and /ping. Returns "" when the request is authorized for `purpose`, else a
// non-empty REASON to refuse.
//
// LEASE auth (--lease-secrets, AEB_AGENT_LEASE_SECRETS set): the presented token
// must be a valid ae1.<purpose>.<expiry>.<sig> lease — signature checks against
// ANY secret in the file (one per line, multiple = zero-downtime ROTATION), not
// expired, and its embedded purpose COVERS the requested purpose. Unforgeable,
// expiring, purpose-bound. The agent only VERIFIES (the lessor mints). See
// lib/agent _lease_verify_any + the trust-model doc.
//
// With no --lease-secrets the agent is fail-closed (refuses all). `purpose` is
// the dispatch's purpose; for /ping (no build) pass the token's own purpose so a
// lease probe gates on signature+expiry, not coverage.
_authed_for(req: ptr, purpose: string) {
    presented = _presented_token(req)
    // AEB_AGENT_LEASE_SECRETS holds the WHOLE --lease-secrets file (one secret
    // per non-blank line). _lease_verify_any accepts a token signed by ANY of
    // them — the rotation primitive (accept old+new during overlap).
    secrets = os.getenv("AEB_AGENT_LEASE_SECRETS")
    if string.length(secrets) == 0 { return "auth: no --lease-secrets configured (fail-closed)" }
    return _lease_verify_any(secrets, presented, os.now_unix_ms(), purpose)
}

// _authed(req) — back-compat boolean wrapper for the purpose-less /ping probe.
// /ping is identity, not a build: a lease only needs a valid signature + to be
// unexpired, NOT to cover a particular build purpose. So we probe with the
// token's OWN embedded purpose (coverage then trivially holds — exact match),
// leaving signature+expiry as the real gate. Legacy mode ignores `purpose`.
// Returns 1/0.
_authed(req: ptr) {
    own = _lease_field(_presented_token(req), 1)
    if string.length(own) == 0 { own = "preint" }
    if string.length(_authed_for(req, own)) == 0 { return 1 }
    return 0
}

// GET /ping — auth-gated identity + capability descriptor. An authorized
// originator/sysop confirms this is really an aeb-agent and learns its
// platform / accept-scope / busy / auth posture BEFORE committing a
// dispatch. Gated like /dispatch: no/ bad token => 401, reveals nothing
// (an unauthenticated prober can't even fingerprint the agent). The
// dumb unauthenticated liveness check stays at /health.
handle_ping(req: ptr, res: ptr, ud: ptr) {
    // Source-IP gate first (same as /dispatch): an off-list prober can't even
    // fingerprint the agent via /ping. Returns the same opaque 403/401 either way.
    if _ip_allowed(req) == 0 {
        http.response_set_status(res, 403)
        http.response_set_header(res, "Content-Type", "application/json")
        http.response_set_body(res, "{\"error\":\"forbidden\"}")
        return 0
    }
    if _authed(req) == 0 {
        http.response_set_status(res, 401)
        http.response_set_header(res, "Content-Type", "application/json")
        http.response_set_body(res, "{\"error\":\"unauthorized\"}")
        return 0
    }
    accept = os.getenv("AEB_AGENT_ACCEPT")
    if string.length(accept) == 0 { accept = "preint/*" }
    mj = os.getenv("AEB_AGENT_MAX_JOBS")
    // Toolchain versions (probed once at startup, cached in env) so an
    // originator sees WHICH aeb/aether would build a dispatch before committing.
    aebv = os.getenv("AEB_AGENT_AEB_VERSION")
    aev = os.getenv("AEB_AGENT_AETHER_VERSION")
    // auth is always "required" here — /ping only succeeds when authed,
    // and the agent is fail-closed, so a reachable authed ping implies
    // tokens are configured.
    body = ping_json_ex(os.platform(), accept, "false", mj, "required", aebv, aev)
    http.response_set_status(res, 200)
    http.response_set_header(res, "Content-Type", "application/json")
    http.response_set_body(res, body)
    return 0
}

// _prepare_tree(guid, repo, ref, hash, patch_b64) — materialize the tree
// to build, in the agent's own repo, BEFORE the build runs. Returns "" on
// success or an error string. Steps (each skipped when its field is ""):
//   - git fetch origin <ref> && git checkout <hash>  (trusted base)
//   - decode patch_b64 (shell base64 -d -> temp file) && git apply
//     (the untrusted pre-integration delta)
// The agent owns the origin (the dispatch never names a remote URL), so
// fetch pulls only from where the operator configured the clone.
// `mode` gates the fetch: "patch" SKIPS git fetch (the tree stays at its
// pre-cloned base; the patch is the only delta). "advance"/"autoclone" fetch
// normally. Empty mode = legacy behaviour (fetch when ghash set).
_prepare_tree(guid: string, repo: string, gref: string, ghash: string, patch_b64: string, mode: string) {
    skip_fetch = 0
    if string.equals(mode, "patch") == 1 { skip_fetch = 1 }
    if string.length(ghash) > 0 {
        // Inter-dispatch isolation: scrub the worktree to a pristine state
        // BEFORE checkout, so dispatch N is not poisoned by dispatch N-1's
        // build outputs or applied patch. Without this, a prior `git apply`
        // leaves local modifications that make this checkout fail (git
        // refuses to clobber them) or, worse, silently build on stale state.
        //   reset --hard      → discard tracked-file modifications
        //   clean -ffdx       → remove untracked + ignored (build outputs)
        // This is a correctness property (repeatable builds), independent of
        // the security hardening in docs/agent-lifecycle.md.
        scrub_cmd = string.concat(string.concat("cd '", repo), "' && git reset --hard --quiet && git clean -ffdxq")
        src = build._sh(scrub_cmd)
        if src != 0 { return "git worktree scrub failed (reset/clean)" }

        // ref is optional (fetch a specific ref before checkout); default
        // to fetching all from origin when ref is empty. SKIPPED in patch mode:
        // the tree stays at its pre-cloned base, the dispatch's patch is the
        // only delta — the agent does NOT advance a leasing tree.
        if skip_fetch == 0 {
            fr = gref
            if string.length(fr) == 0 { fr = "" }
            fetch_cmd = string.concat("cd '", repo)
            if string.length(fr) > 0 {
                fetch_cmd = string.concat(fetch_cmd, "' && git fetch origin '")
                fetch_cmd = string.concat(fetch_cmd, fr)
                fetch_cmd = string.concat(fetch_cmd, "'")
            } else {
                fetch_cmd = string.concat(fetch_cmd, "' && git fetch origin")
            }
            frc = build._sh(fetch_cmd)
            if frc != 0 { return "git fetch failed" }
        }

        co_cmd = string.concat(string.concat("cd '", repo), string.concat("' && git checkout --quiet '", string.concat(ghash, "'")))
        crc = build._sh(co_cmd)
        if crc != 0 { return "git checkout ${ghash} failed" }
    }

    if string.length(patch_b64) > 0 {
        // Decode via shell (no Aether handling of the binary-ish diff) to
        // a temp file, then git apply. printf the b64 then base64 -d.
        pf = string.concat("/tmp/aeb-agent-patch-", string.concat(guid, ".diff"))
        dec_cmd = string.concat(string.concat("printf '%s' '", patch_b64), string.concat("' | base64 -d > '", string.concat(pf, "'")))
        drc = build._sh(dec_cmd)
        if drc != 0 { return "patch base64 decode failed" }
        ap_cmd = string.concat(string.concat("cd '", repo), string.concat("' && git apply '", string.concat(pf, "'")))
        arc = build._sh(ap_cmd)
        // NB: the decoded patch file (pf) is deliberately NOT removed here — the
        // Tier-A veto's patch-scope rules scan it (the highest-signal target).
        // handle_dispatch removes it after the veto decision. On apply failure
        // we still leave it; the dispatch short-circuits and the next dispatch's
        // unique guid path + /tmp churn bound the leftover.
        if arc != 0 { return "git apply failed (patch does not apply to base)" }
    }

    return ""
}

// _provision_slot(mode, tree, ac_repo, log_path) — make the per-slot tree ready
// BEFORE _prepare_tree, per the requested mode. Returns "" on success or an
// error string (=> prep-failed). See docs/agent-provisioning-modes.md.
//   patch / advance — the tree must already be a git working copy (the operator
//     pre-cloned it). If <tree> is missing, FAIL: the agent never clones in
//     these modes. (advance then fetches in _prepare_tree; patch does not.)
//   autoclone — clone ac_repo INTO <tree> if it isn't already a clone of it.
//     The repo/branch were already allow-list-checked by the caller. We git
//     clone (or reuse if the dir is a clone with the right origin).
_provision_slot(mode: string, tree: string, ac_repo: string, log_path: string) {
    is_clone = 0
    if fs.exists(path.join(tree, ".git")) == 1 { is_clone = 1 }
    if string.equals(mode, "autoclone") == 1 {
        if is_clone == 1 {
            // Reuse: point origin at ac_repo (idempotent) so fetch/checkout work.
            so = build._sh(string.concat(string.concat("cd '", tree), string.concat("' && git remote set-url origin '", string.concat(ac_repo, string.concat("' >> '", string.concat(log_path, "' 2>&1"))))))
            if so != 0 { return "autoclone: could not set origin on existing slot tree" }
            return ""
        }
        // Fresh clone of ac_repo into the slot tree. Parent must exist.
        _mp = fs.mkdir_p(path.dirname(tree))
        cl = build._sh(string.concat("git clone '", string.concat(ac_repo, string.concat("' '", string.concat(tree, string.concat("' >> '", string.concat(log_path, "' 2>&1")))))))
        if cl != 0 { return "autoclone: git clone ${ac_repo} failed" }
        return ""
    }
    // patch / advance: pre-cloned only — the agent does NOT clone here.
    if is_clone == 0 {
        return "mode '${mode}': slot tree ${tree} is not a pre-cloned git working copy (operator must provision it)"
    }
    return ""
}

// _patch_path_for(guid) — the per-dispatch decoded-patch temp path. Mirrors the
// pf built in _prepare_tree, so handle_dispatch can hand it to the veto and then
// clean it up. "" guid → "" (no patch scanned).
_patch_path_for(guid: string, patch_b64: string) {
    if string.length(patch_b64) == 0 { return "" }
    return string.concat("/tmp/aeb-agent-patch-", string.concat(guid, ".diff"))
}

// _maybe_veto_build(repo, target, purpose) — the agent's OWN gate, run
// after the tree is prepared and BEFORE the build. Returns "" to allow,
// or a non-empty reason to VETO (refuse to build). This is the agent
// exercising sovereign policy over what it will run — distinct from the
// orchestrator and from whether the build would pass.
//
// Walking skeleton: a single, conservative example veto (reject a tree
// that contains an obvious committed secret marker) to prove the
// architecture. The real design is a PLUGGABLE three-tier list — see
// docs/build-veto-and-sandbox.md:
//   A. tree scan (NOW: pluggable rule list)  — cheap, raw tree + patch
//   B. resolved-coordinate / SBOM    — dependency CVE/OWASP (design)
//   C. doppelganger-compile trace    — build-grammar intent via a
//      `--lib <doppelganger>` swap recording os.system/dep/link_flag
//      instead of executing (the Action!/tsyne-designer trick; design)
// CRITICAL scope: these guard BUILD-GRAMMAR escapes (what the .build.ae
// orchestration does), NOT the application being built. A clean veto is
// not a clean program — see the SCOPE section of the doc. Veto rules are
// the agent operator's policy, not the requester's.
//
// Tier A is now a data-driven rule list in lib/agent (_veto_run_rules): built-in
// secret/banned-marker rules + operator extras via AEB_AGENT_VETO_PATTERNS, each
// scoped to the whole tree or to the applied patch specifically (the
// highest-signal target — the untrusted delta introduced the hit). patch_path is
// the decoded patch left by _prepare_tree ("" when the dispatch carried none).
_maybe_veto_build(repo: string, target: string, purpose: string, patch_path: string, image: string) {
    // Tier A (cheap, text): secret/banned markers over the target's dep-closure
    // subtree + patch. Scoping the tree/file scan to the target's subtree (not
    // the whole worktree) avoids vetoing on an UNRELATED sibling subtree — e.g.
    // a stray binding.gyp in libs/javascript when building a rust target.
    a = _veto_run_rules(repo, target, patch_path)
    if string.length(a) > 0 { return a }
    // Layer 2b (AST): the same lib/veto gate `aeb --vet` runs — over the
    // prepared tree's target .ae. extern/exec/net/banned, origin-scoped,
    // fail-closed on no-AST / computed exec arg. Skipped when target isn't
    // an .ae path (nothing to emit an AST for). `image` is the effective
    // per-dispatch container image (local, thread-safe) for the podman veto.
    if string.length(target) > 0 {
        if string.ends_with(target, ".ae") == 1 {
            return _veto_ast(repo, target, image)
        }
    }
    return ""
}

// _veto_ast(repo, target) — run the 2b AST veto over repo/target. Resolves
// rules the same way aeb-vet does (AEB_VETO_POLICY operator policy → compile
// +run → its rules; else the built-in default), emits the target's AST, and
// runs lib/veto decide(). Returns "" (clear) or a veto reason. Fail-closed:
// a policy that won't compile, or no clean AST, is a veto.
_veto_ast(repo: string, target: string, image: string) {
    aetherc = _agent_aetherc()
    rules = _agent_veto_rules(aetherc)
    if rules == null {
        return "veto policy did not compile (fail-closed)"
    }
    if list.size(rules) == 0 {
        // No operator policy + no built-in? default_rules is non-empty, so
        // this only happens if an operator policy resolved to zero rules.
        return "veto policy resolved to zero rules (fail-closed)"
    }

    // Trusted --lib roots for origin scoping: aeb's SDK tree + the prepared
    // tree's own .aeb/lib. Use _agent_sdk_lib() (NOT bare $AEB_HOME/lib) — when
    // the agent is installed apart from aeb (container: AEB_HOME points at the
    // agent's tools-only tree), $AEB_HOME/lib is absent and the AST emit would
    // fail → every SDK-importing target fail-closes to `vetoed`. _agent_sdk_lib
    // falls back to the real SDK home reported by `aeb --version`.
    lib_roots = list.new()
    sdk_lib = _agent_sdk_lib()
    if string.length(sdk_lib) > 0 { list.add(lib_roots, sdk_lib) }
    // The Aether stdlib is part of the trusted toolchain too — the SDK's
    // modules import std.os/etc, whose exec/extern live under the aether tree,
    // not the aeb SDK tree. Without this trusted root, a build whose SDK
    // transitively shells out (java→javac) is spuriously vetoed.
    aether_std = _agent_aether_std()
    if string.length(aether_std) > 0 { list.add(lib_roots, aether_std) }
    proj_lib = path.join(repo, ".aeb/lib")
    if file.exists(proj_lib) == 1 { list.add(lib_roots, proj_lib) }

    // run_on=podman: the agent host may be toolchain-less, so the veto's
    // aetherc --emit=ast must run IN the container too (the build already
    // delegates — this closes the last host-aetherc dependency). The repo binds
    // at /work; the container's own aetherc + SDK + stdlib resolve the target's
    // imports, and decide()'s trusted origins are the CONTAINER's SDK/stdlib
    // paths (which is where the emitted AST attributes SDK-internal calls).
    run_on = os.getenv("AEB_AGENT_RUN_ON")
    if string.equals(run_on, "podman") == 1 {
        return _veto_ast_in_container(repo, target, rules, image)
    }

    // Run the emit from INSIDE repo (the target path is relative to the
    // prepared tree, exactly as the build sees it — the build cd's into
    // workdir too). repo may be relative ("." default), so cd makes the
    // target resolvable regardless of the agent's own cwd.
    emit = emit_ast_cmd(aetherc, _lib_flags(lib_roots), target)
    cmd = string.concat(string.concat("cd '", repo), string.concat("' && ", emit))
    ast_json, _e = build._sh_capture(cmd)
    rc = build._sh(string.concat(cmd, " >/dev/null 2>&1"))
    return decide(ast_json, rc, lib_roots, rules)
}

// _veto_ast_in_container(repo, target, rules) — the run_on=podman veto: emit the
// target's AST with the CONTAINER's aetherc (the host may have none), then
// decide() with the container's trusted SDK/stdlib origins. The repo is
// bind-mounted at /work, aetherc is the entrypoint, and the target path is
// relative to /work (same as the build sees it). Honors AEB_CONTAINER_ENGINE /
// AEB_CONTAINER_SELABEL like the build phase + aeb-ctr.
_veto_ast_in_container(repo: string, target: string, rules: ptr, image: string) {
    if string.length(image) == 0 {
        return "run_on=podman veto: no --ctr-image (fail-closed)"
    }
    engine = os.getenv("AEB_CONTAINER_ENGINE")
    if string.length(engine) == 0 { engine = "podman" }
    selabel = os.getenv("AEB_CONTAINER_SELABEL")
    if string.length(selabel) == 0 { selabel = "Z" }

    // Container-side trusted origins: where the image's aetherc attributes
    // SDK-internal + stdlib calls. The stdlib prefix mirrors what aetherc emits
    // (<bin>/../share/aether); the aeb SDK is /usr/local/share/aeb/lib.
    lib_roots = list.new()
    list.add(lib_roots, "/usr/local/share/aeb/lib")
    list.add(lib_roots, "/usr/local/bin/../share/aether")
    list.add(lib_roots, "/usr/local/share/aether")
    // The prepared tree's own .aeb/lib resolves under /work in-container.
    list.add(lib_roots, "/work/.aeb/lib")

    mnt = string.concat(repo, string.concat(":/work:", selabel))
    // podman run --rm -v repo:/work:Z -w /work --entrypoint aetherc image
    //   --emit=ast --lib '<ctr-root>' ... '<target>'
    emit = emit_ast_cmd("aetherc", _lib_flags(lib_roots), target)
    // Strip the leading "'aetherc' " emit_ast_cmd prepends — the entrypoint IS
    // aetherc, so we pass only its args. emit_ast_cmd returns
    // "'aetherc' --emit=ast<libs> 'target'"; we want everything after "'aetherc' ".
    args = emit
    pfx = "'aetherc' "
    if string.index_of(emit, pfx) == 0 {
        args = string.substring(emit, string.length(pfx), string.length(emit))
    }
    base = string.concat(engine, string.concat(" run --rm -v '", string.concat(mnt, string.concat("' -w /work --entrypoint aetherc '", string.concat(image, string.concat("' ", args))))))
    ast_json, _e = build._sh_capture(base)
    rc = build._sh(string.concat(base, " >/dev/null 2>&1"))
    return decide(ast_json, rc, lib_roots, rules)
}

// _agent_aetherc() — the aetherc the agent emits ASTs with. AEB_AGENT_AETHERC
// override, else "aetherc" on PATH.
_agent_aetherc() {
    e = os.getenv("AEB_AGENT_AETHERC")
    if string.length(e) > 0 { return e }
    return "aetherc"
}

// _agent_veto_rules(aetherc) — the rule list for the agent's 2b veto.
// AEB_VETO_POLICY (operator policy.ae on the agent host) → compile+run → its
// emitted rules; else lib/veto's built-in default_rules(). null = the policy
// failed to compile (caller fail-closes).
_agent_veto_rules(aetherc: string) {
    policy = os.getenv("AEB_VETO_POLICY")
    if string.length(policy) == 0 { return default_rules() }
    if file.exists(policy) == 0 { return default_rules() }
    home = os.getenv("AEB_HOME")
    lib = "lib"
    if string.length(home) > 0 { lib = path.join(home, "lib") }
    ae = _agent_ae()
    // -o uses the suffixless base; ae appends .exe on Windows, so the file that
    // exists/runs is binbase + _exe_suffix(). Splitting them avoids the
    // /tmp/...bin.exe-vs-/tmp/...bin mismatch (the run/cleanup must name the
    // actually-produced file).
    binbase = string.concat("/tmp/aeb-agent-veto-policy-", string.from_int(os_getpid_safe()))
    bin = string.concat(binbase, build._exe_suffix())
    brc = build._sh("'${ae}' build '${policy}' --lib '${lib}' -o '${binbase}' 2>/dev/null")
    if brc != 0 { return null }
    out, _e = build._sh_capture("'${bin}'")
    _d = fs.delete(bin)
    return rules_from_lines(out)
}

// _agent_ae() — the `ae` build driver (sibling of aetherc / override).
_agent_ae() {
    e = os.getenv("AEB_AGENT_AE")
    if string.length(e) > 0 { return e }
    return "ae"
}

// _agent_aeb() — the `aeb` binary (override AEB_AGENT_AEB, else on PATH).
_agent_aeb() {
    e = os.getenv("AEB_AGENT_AEB")
    if string.length(e) > 0 { return e }
    return "aeb"
}

// _first_line(text) — the first line, trimmed. "" if empty. Pure.
_first_line(text: string) {
    nl = string.index_of(text, "\n")
    if nl < 0 { return string.trim(text) }
    return string.trim(string.substring(text, 0, nl))
}

// _probe_aeb_version() / _probe_aether_version() — the version strings the
// /ping capability descriptor reports, so an originator can see WHICH toolchain
// would build a dispatch BEFORE committing it (load-bearing for a mixed-version
// fleet — e.g. an agent whose Aether is too old for a feature the build uses).
//   aeb: the first line of `aeb --version` ("aeb 0.0.0-dev+<sha> (git …)").
//   aether: the first line of `aetherc --version` ("Aether Compiler vX.Y.Z") —
//     the LIVE compiler the agent would actually build with (NOT the older
//     "tools built ae …" line `aeb --version` also prints; those can differ).
// "" if the probe fails (binary absent). Run once at startup, cached in env.
_probe_aeb_version() {
    out, _e = build._sh_capture(string.concat(_agent_aeb(), " --version 2>/dev/null"))
    return _first_line(out)
}
_probe_aether_version() {
    out, _e = build._sh_capture(string.concat(_agent_aetherc(), " --version 2>/dev/null"))
    return _first_line(out)
}

// _agent_sdk_lib() — the aeb SDK `lib/` dir the veto's `aetherc --emit=ast`
// needs so a target importing SDK modules (build/java/c/…) resolves. NOT just
// `$AEB_HOME/lib`: when aeb-agent is installed separately from aeb (the
// container case — the agent wrapper sets AEB_HOME=/root/.local/share/aeb, which
// holds ONLY the agent's tools/, while the real SDK is at /usr/local/share/aeb),
// `$AEB_HOME/lib` doesn't exist and the AST emit fails → every such target
// fail-closes to `vetoed`. So:
//   1. `$AEB_HOME/lib` if it exists (normal: AEB_HOME points at the full SDK);
//   2. else ask `aeb` itself — `aeb --version` prints `AEB_HOME <dir>`, the
//      authoritative SDK home (the inner aeb that actually builds knows where
//      its lib is) → use `<that>/lib`;
//   3. else "" (caller adds no SDK --lib; same as before).
_agent_sdk_lib() {
    home = os.getenv("AEB_HOME")
    if string.length(home) > 0 {
        cand = path.join(home, "lib")
        // fs.exists (path-agnostic), NOT file.exists — `build` is a DIRECTORY
        // (lib/build/), and file.exists returns 0 for dirs (that was the bug:
        // _agent_sdk_lib silently returned "" so the veto got no SDK --lib and
        // fail-closed-vetoed every SDK-importing target).
        if fs.exists(path.join(cand, "build")) == 1 { return cand }
    }
    // Probe the real SDK home from `aeb --version`'s "AEB_HOME <dir>" line —
    // `aeb` is on PATH (its install wrapper exports the true SDK AEB_HOME and
    // --version echoes it). AEB_AGENT_AEB overrides for an unusual layout.
    aeb = os.getenv("AEB_AGENT_AEB")
    if string.length(aeb) == 0 { aeb = "aeb" }
    out, _e = build._sh_capture(string.concat(aeb, " --version 2>/dev/null"))
    real = _parse_aeb_home(out)
    if string.length(real) > 0 {
        cand2 = path.join(real, "lib")
        if fs.exists(path.join(cand2, "build")) == 1 { return cand2 }
    }
    return ""
}

// _agent_aether_std() — the Aether STDLIB dir, a trusted origin for the veto
// alongside the aeb SDK lib. The veto exempts calls whose source file is under a
// trusted --lib root (the SDK legitimately does exec/extern); but the SDK's
// modules import std.os etc., and those stdlib calls live under the AETHER
// tree, not the aeb SDK tree — so without this they get flagged (observed:
// `denied exec: os_run_full_raw (.../share/aether/std/os/module.ae)`), vetoing
// every build whose SDK transitively shells out (java→javac, c→gcc, …). The
// stdlib is part of the trusted toolchain, not untrusted build code, so its dir
// is a legitimate trusted origin.
//
// aetherc emits the source path as `<aetherc-dir>/../share/aether/std/...`
// (unnormalised `bin/../share`), so we return `<aetherc-dir>/../share/aether`
// to starts_with-match it. aetherc-dir comes from `command -v <aetherc>`.
// Returns "" if aetherc can't be located (caller adds no extra root).
_agent_aether_std() {
    aetherc = _agent_aetherc()
    // If it's a bare name, resolve to an absolute path the same way aetherc
    // resolves its own argv0 (PATH lookup) so the prefix matches what it emits.
    resolved, _e = build._sh_capture(string.concat("command -v ", string.concat(aetherc, " 2>/dev/null")))
    resolved = string.trim(resolved)
    if string.length(resolved) == 0 { return "" }
    bindir = path.dirname(resolved)
    if string.length(bindir) == 0 { return "" }
    // The emitted form is <bindir>/../share/aether/...; match that prefix.
    return string.concat(bindir, "/../share/aether")
}

// _parse_aeb_home(version_text) — pull the dir from an `aeb --version` line
// `  AEB_HOME     <dir>`. Returns "" if not found. Pure string scan.
_parse_aeb_home(text: string) {
    needle = "AEB_HOME"
    idx = string.index_of(text, needle)
    if idx < 0 { return "" }
    rest = string.substring(text, idx + string.length(needle), string.length(text))
    // skip leading spaces
    while string.length(rest) > 0 {
        ch = string.substring(rest, 0, 1)
        if string.equals(ch, " ") == 0 { break }
        rest = string.substring(rest, 1, string.length(rest))
    }
    // take up to end-of-line
    nl = string.index_of(rest, "\n")
    if nl >= 0 { rest = string.substring(rest, 0, nl) }
    return string.trim(rest)
}

// os_getpid_safe() — a per-process suffix for the temp policy binary so
// concurrent dispatches don't clash. Falls back to a constant if getpid
// isn't available.
os_getpid_safe() {
    return os.getpid()
}

// _reap_wrap(inner) — wrap a shell command so anything it backgrounds is REAPED
// when it returns, matching the `aeb` trampoline's own discipline (see aeb
// lines ~560-626). The footgun this closes: a raw dispatch command that ends in
// `… &` (the driver-gate pattern the macOS/Windows guide itself recommends —
// stand up a server, then drive it) used to leave that server running on the
// host indefinitely, holding ports and wedging the single build slot. Now the
// inner command runs as a BACKGROUNDED JOB in its OWN process group (`set -m`
// gives pid==pgid), we capture its rc, then group-kill survivors: TERM → 1s
// grace → KILL. No-op when the command leaked nothing. The inner command's
// exit code is preserved as the wrapper's exit code (the verdict is unchanged).
//
// Opt-out is keep_alive (handled by the caller, which simply doesn't wrap) —
// for the legitimate long-lived-server case the reap would otherwise kill.
// POSIX job-control + negative-PID group kill works on both macOS (the Mac
// agent) and the Linux VM shells. Keep it a single bash -c string so `set -m`
// and `wait` see the same shell.
_reap_wrap(inner: string) {
    w = "set -m; { "
    w = string.concat(w, inner)
    w = string.concat(w, " ; } & __ap=$!; wait $__ap; __arc=$?; ")
    w = string.concat(w, "kill -TERM -$__ap 2>/dev/null; ")
    w = string.concat(w, "__ag=0; while [ $__ag -lt 10 ]; do kill -0 -$__ap 2>/dev/null || break; sleep 0.1; __ag=$((__ag+1)); done; ")
    w = string.concat(w, "kill -KILL -$__ap 2>/dev/null; ")
    w = string.concat(w, "exit $__arc")
    return w
}

// _run_on_vm(workdir, target, log_path) — run the whole build on an SSH-reachable
// VM node and bring the result back. The agent host need not have a toolchain at
// all (mirrors run_on=podman, one indirection further out): agent → ssh (often
// via the VM-host's ProxyJump, encoded in the ssh-config alias) → VM.
//
//   --vm-host <ssh-target>   (AEB_AGENT_VM_HOST) — the VM, as an ssh target/alias
//                            (e.g. "winbaz", whose config carries ProxyJump
//                            bazzite@…). The VM owns its own aeb + toolchain.
//   --vm-dir <remote-dir>    (AEB_AGENT_VM_DIR, default /tmp/aeb-vm-build) — where
//                            the prepared tree is rsync'd on the VM.
//
// Steps: ship the prepared tree → VM, run the build there (tee'd to the local
// log), exit code is the verdict, then bring the VM's artifacts JSON back to
// AEB_ARTIFACTS_JSON so the rich reply still reports what got built.
//
// TWO build verbs, selected per-dispatch:
//   - default: `aeb <target>` on the VM's own toolchain (the proven path).
//   - RAW COMMAND (AEB_AGENT_VM_COMMAND, the dispatch's "command" field): run
//     THAT command in the tree root instead — for projects that build with a
//     hand-rolled build.sh / make / cmake and have no `.build.ae` (e.g.
//     aether-ui's Win32 bring-up on winbaz). aeb does NOT parse the command's
//     output: exit 0 → pass, non-zero → fail; whatever the command leaves in
//     the artifacts path comes back. The command runs through the same shell on
//     the VM, in the tree root, so MSYS2/Windows POSIX idioms work.
//
// TRANSPORT: rsync both ways when the VM has it; otherwise fall back to
// `tar | ssh` (a fresh/locked-down VM — e.g. winbaz, no rsync — then needs ZERO
// install). _vm_has_rsync probes once.
//
// VM SHELL: a bare `ssh <vm> '<cmd>'` runs <cmd> in the VM's DEFAULT ssh shell.
// On a POSIX VM that's a POSIX shell (fine). On a Windows VM (winbaz) it's
// cmd.exe — which can't `cd /tmp && tar …`. So --vm-shell <prefix>
// (AEB_AGENT_VM_SHELL) wraps the remote, POSIX-side command: with it set, the
// agent runs `ssh <vm> '<prefix> "<posix_cmd>"'` — e.g. prefix
// `C:\msys64\usr\bin\bash.exe -lc` forces MSYS bash. Empty prefix = bare
// (POSIX VM). The inner <posix_cmd> must stay double-quote-free (the wrapper
// uses "…" around it) — see [[win-cmdexe-sh-quoting-law]].
//
// (The VM-host *spawning/loaning* the VM — `virsh start`/`clone` a transient
// domain — is a later layer; this first cut treats the VM as an already-running,
// SSH-reachable build node, which is the common fleet shape and what the
// bazzite/win11 setup already provides.)

// _vm_remote(vm, posix_cmd) — build the `ssh` invocation that runs a POSIX-shell
// command on the VM, honouring AEB_AGENT_VM_SHELL. No --vm-shell → bare
// `ssh <vm> '<posix_cmd>'`. With one → `ssh <vm> '<prefix> "<posix_cmd>"'`
// (the prefix's own shell then interprets posix_cmd). posix_cmd must be
// double-quote-free when a shell prefix is used.
_vm_remote(vm: string, posix_cmd: string) {
    shell = os.getenv("AEB_AGENT_VM_SHELL")
    if string.length(shell) == 0 {
        return string.concat("ssh ", string.concat(vm, string.concat(" '", string.concat(posix_cmd, "'"))))
    }
    inner = string.concat(shell, string.concat(" \"", string.concat(posix_cmd, "\"")))
    return string.concat("ssh ", string.concat(vm, string.concat(" '", string.concat(inner, "'"))))
}

// _vm_has_rsync(vm) — 1 if `rsync` is on the VM's PATH (probed via ssh,
// through the VM shell), else 0.
_vm_has_rsync(vm: string) {
    probe = _vm_remote(vm, "command -v rsync >/dev/null 2>&1 && echo yes || echo no")
    out, _e = build._sh_capture(probe)
    if string.index_of(out, "yes") >= 0 { return 1 }
    return 0
}

// _vm_push(vm, workdir, vmdir, use_rsync, log_path) — ship workdir/ → vm:vmdir/.
// rsync (mirror w/ --delete) when available; else stream a tarball over ssh
// (clears vmdir first so it's a clean mirror, like --delete). Returns rc.
_vm_push(vm: string, workdir: string, vmdir: string, use_rsync: int, log_path: string) {
    mk = _vm_remote(vm, string.concat("mkdir -p ", vmdir))
    _ = build._sh(string.concat(mk, " >> '${log_path}' 2>&1"))
    if use_rsync == 1 {
        rp = string.concat("rsync -az --delete -e ssh '", string.concat(workdir, string.concat("/' '", string.concat(vm, string.concat(":", string.concat(vmdir, "/'"))))))
        return build._sh(string.concat(rp, " >> '${log_path}' 2>&1"))
    }
    // tar fallback: clean the remote dir, then stream `tar c` from workdir into
    // `tar x` on the VM. -C workdir . = copy the tree's CONTENTS into vmdir.
    clean = _vm_remote(vm, string.concat("rm -rf ", string.concat(vmdir, string.concat("/* ", string.concat(vmdir, "/.[!.]* 2>/dev/null; true")))))
    _c = build._sh(string.concat(clean, " >> '${log_path}' 2>&1"))
    rx = _vm_remote(vm, string.concat("tar xzf - -C ", vmdir))
    tp = string.concat("tar czf - -C '", string.concat(workdir, string.concat("' . | ", rx)))
    return build._sh(string.concat(tp, " >> '${log_path}' 2>&1"))
}

// _vm_fetch_file(vm, remote, local, use_rsync, log_path) — bring a single file
// vm:remote → local. Best-effort (caller ignores rc). rsync or `ssh cat`.
_vm_fetch_file(vm: string, remote: string, local: string, use_rsync: int, log_path: string) {
    if use_rsync == 1 {
        f = string.concat("rsync -az -e ssh '", string.concat(vm, string.concat(":", string.concat(remote, string.concat("' '", string.concat(local, "'"))))))
        return build._sh(string.concat(f, " >> '${log_path}' 2>&1"))
    }
    // tar/cat fallback: `ssh cat remote > local` (file may be absent → empty).
    f = string.concat(_vm_remote(vm, string.concat("cat ", string.concat(remote, " 2>/dev/null"))), string.concat(" > '", string.concat(local, "'")))
    return build._sh(string.concat(f, " 2>> '${log_path}'"))
}

_run_on_vm(workdir: string, target: string, log_path: string, raw_cmd: string, keep_alive: int) {
    vm = os.getenv("AEB_AGENT_VM_HOST")
    if string.length(vm) == 0 {
        _w = io.write_file(log_path, "run_on=vm: no --vm-host configured (fail-closed)\n")
        return 1
    }
    vmdir = os.getenv("AEB_AGENT_VM_DIR")
    if string.length(vmdir) == 0 { vmdir = "/tmp/aeb-vm-build" }
    // raw_cmd is passed in (local per-dispatch value), not read from global env —
    // concurrent dispatches must not race on a shared command var.

    // Transport: prefer rsync; fall back to tar|ssh on a VM without it.
    use_rsync = _vm_has_rsync(vm)
    transport = "tar|ssh"
    if use_rsync == 1 { transport = "rsync" }
    println("agent: run_on=vm — building on ${vm}:${vmdir} (transport=${transport})")

    // 1. Ship the prepared tree to the VM.
    prc = _vm_push(vm, workdir, vmdir, use_rsync, log_path)
    if prc != 0 {
        _wp = io.write_file(log_path, "run_on=vm: ship tree to ${vm}:${vmdir} failed (transport=${transport})\n")
        return prc
    }

    // 2. Build on the VM — raw command OR aeb <target>.
    vm_art = string.concat(vmdir, "/.aeb-vm-artifacts.json")
    runc = ""
    if string.length(raw_cmd) > 0 {
        // Raw foreign build (build.sh / make / cmake …). cd into the tree, run
        // the command verbatim. Its exit code IS the verdict; aeb parses nothing.
        // Reap-by-default on the VM too (a backgrounded server leaked there is
        // just as wedging — it holds the slot for the whole dispatch and lingers
        // on the VM). Wrap the remote verb in the same process-group reap unless
        // keep_alive. _reap_wrap nests inside the `cd … && …` so the group spans
        // exactly what the command spawns on the VM.
        println("agent: run_on=vm raw command: ${raw_cmd}")
        vm_inner = string.concat("cd ", string.concat(vmdir, string.concat(" && ", raw_cmd)))
        if keep_alive == 0 { vm_inner = _reap_wrap(vm_inner) }
        runc = _vm_remote(vm, vm_inner)
    } else {
        // Default: the VM's own aeb resolves its AEB_HOME/toolchain; point
        // AEB_ARTIFACTS_JSON at a VM-side path we fetch back in step 3.
        runc = _vm_remote(vm, string.concat("cd ", string.concat(vmdir, string.concat(" && AEB_ARTIFACTS_JSON=", string.concat(vm_art, string.concat(" aeb ", target))))))
    }
    rc = build._sh(string.concat(runc, " >> '${log_path}' 2>&1"))

    // 3. Bring the artifacts JSON back (best-effort). For the aeb path this is
    //    what the build wrote; for the raw path a build.sh MAY have written it
    //    (if not, the fetch yields an empty file → empty artifacts, fine).
    local_art = os.getenv("AEB_ARTIFACTS_JSON")
    if string.length(local_art) > 0 {
        _f = _vm_fetch_file(vm, vm_art, local_art, use_rsync, log_path)
    }
    return rc
}

// _image_allowed(image) — is this requester-supplied image one the agent will
// run? Fail-closed lease gate: a leased agent must NOT be coerced into pulling
// /running an arbitrary image. An empty `image` (no override) is always allowed
// — the build uses the agent's default --ctr-image. A non-empty override is
// allowed iff it equals the default --ctr-image OR matches the --allow-image
// glob (AEB_AGENT_ALLOW_IMAGE). With NO --allow-image set, only the default
// image is runnable: the requester can name it but cannot substitute another.
_image_allowed(image: string) {
    if string.length(image) == 0 { return 1 }
    deflt = os.getenv("AEB_AGENT_CTR_IMAGE")
    if string.length(deflt) > 0 { if string.equals(image, deflt) == 1 { return 1 } }
    allow = os.getenv("AEB_AGENT_ALLOW_IMAGE")
    if string.length(allow) == 0 { return 0 }
    return _image_match(allow, image)
}

handle_dispatch(req: ptr, res: ptr, ud: ptr) {
    body = http.request_body(req)
    guid = _json_field(body, "guid")
    target = _json_field(body, "target")
    purpose = _json_field(body, "purpose")
    if string.length(purpose) == 0 { purpose = "preint" }

    // --- Source-IP gate (--allow-from) — BEFORE auth (cheapest gate first;
    //     an off-list peer never reaches token verification). Trusted peer
    //     address, fail-closed. No --allow-from → no restriction. ---
    if _ip_allowed(req) == 0 {
        println("agent: REFUSE guid=${guid} (source IP ${http.request_remote_addr(req)} not in --allow-from)")
        http.response_set_status(res, 403)
        http.response_set_header(res, "Content-Type", "application/json")
        http.response_set_body(res, dispatch_reply_json(guid, "rejected", ""))
        return 0
    }

    // --- Auth gate (fail-closed) — BEFORE the scope decision. ---
    // The presented token must be a valid ae1.<purpose>.<expiry>.<sig> lease
    // whose purpose COVERS this dispatch's purpose, not expired, signature valid
    // (against any --lease-secrets). No creds configured / bad token => refuse.
    // The reason is logged (names WHY: expired vs forged vs purpose-mismatch) but
    // NOT returned on the wire (an attacker learns only "rejected").
    auth_err = _authed_for(req, purpose)
    if string.length(auth_err) > 0 {
        println("agent: REFUSE guid=${guid} (${auth_err})")
        http.response_set_status(res, 401)
        http.response_set_header(res, "Content-Type", "application/json")
        http.response_set_body(res, dispatch_reply_json(guid, "rejected", ""))
        return 0
    }

    scope = _scope_from_env()
    // Scope-accept only (reject if out of scope). The busy decision is now the
    // real slot claim below — NOT _decision's old active=0 placeholder.
    if _scope_accepts(scope, purpose) == 0 {
        println("agent: REJECT guid=${guid} purpose=${purpose} (out of scope)")
        http.response_set_status(res, 403)
        http.response_set_header(res, "Content-Type", "application/json")
        http.response_set_body(res, dispatch_reply_json(guid, "rejected", ""))
        return 0
    }
    // Claim a build slot (atomic, race-safe). All N taken => busy. EVERY exit
    // path below MUST _slot_release(claimed_slot) before returning — a leaked
    // slot wedges capacity. (Startup clears stale slots after a crash.)
    claimed_slot = _slot_claim()
    if string.length(claimed_slot) == 0 {
        println("agent: BUSY guid=${guid} (all ${_slot_capacity()} build slot(s) in use)")
        http.response_set_status(res, 503)
        http.response_set_header(res, "Content-Type", "application/json")
        http.response_set_body(res, dispatch_reply_json(guid, "busy", ""))
        return 0
    }

    // accept → prepare the tree, then run aeb <target>. With capacity >1 each
    // slot builds in its OWN tree <workdir>/<i> (no clobbering); with capacity 1
    // the single build uses <workdir> directly (the common one-builder case —
    // `--workdir ~/proj` just works). (See docs/agent-provisioning-modes.md.)
    slot_idx = _slot_index(claimed_slot)
    slot_cap = _slot_capacity()
    base_workdir = os.getenv("AEB_AGENT_WORKDIR")
    if string.length(base_workdir) == 0 { base_workdir = "." }
    base_repo = os.getenv("AEB_AGENT_REPO")
    if string.length(base_repo) == 0 { base_repo = base_workdir }
    workdir = _slot_tree(base_workdir, slot_idx, slot_cap)
    repo = _slot_tree(base_repo, slot_idx, slot_cap)
    println("agent: ACCEPT guid=${guid} purpose=${purpose} target=${target} slot=${slot_idx} tree=${workdir}")

    // --- Provisioning mode (per-slot tree lifecycle). The dispatch REQUESTS a
    //   mode; the agent OFFERS a set (--provision-modes, fail-closed). Reject if
    //   not offered, or (advance) branch not in --advance-branches, or
    //   (autoclone) repo#branch not in --autoclone-allow. Then provision the
    //   slot tree per mode. See docs/agent-provisioning-modes.md.
    offered = os.getenv("AEB_AGENT_PROVISION_MODES")
    if string.length(offered) == 0 { offered = "patch" }
    req_mode = _json_field(body, "mode")
    if string.length(req_mode) == 0 { req_mode = _first_csv(offered) }   // default = first offered
    dispatch_branch = _json_field(body, "branch")
    dispatch_repo = _json_field(body, "repo")
    if _mode_offered(offered, req_mode) == 0 {
        println("agent: REJECT guid=${guid} mode=${req_mode} (not in --provision-modes '${offered}')")
        _rs = _slot_release(claimed_slot)
        http.response_set_status(res, 403)
        http.response_set_header(res, "Content-Type", "application/json")
        http.response_set_body(res, dispatch_reply_json(guid, "rejected", ""))
        return 0
    }
    if string.equals(req_mode, "advance") == 1 {
        if _branch_allowed(os.getenv("AEB_AGENT_ADVANCE_BRANCHES"), dispatch_branch) == 0 {
            println("agent: REJECT guid=${guid} mode=advance branch='${dispatch_branch}' (not in --advance-branches)")
            _rs = _slot_release(claimed_slot)
            http.response_set_status(res, 403)
            http.response_set_header(res, "Content-Type", "application/json")
            http.response_set_body(res, dispatch_reply_json(guid, "rejected", ""))
            return 0
        }
    }
    if string.equals(req_mode, "autoclone") == 1 {
        if _autoclone_allowed(os.getenv("AEB_AGENT_AUTOCLONE_ALLOW"), dispatch_repo, dispatch_branch) == 0 {
            println("agent: REJECT guid=${guid} mode=autoclone repo='${dispatch_repo}' branch='${dispatch_branch}' (not in --autoclone-allow)")
            _rs = _slot_release(claimed_slot)
            http.response_set_status(res, 403)
            http.response_set_header(res, "Content-Type", "application/json")
            http.response_set_body(res, dispatch_reply_json(guid, "rejected", ""))
            return 0
        }
    }
    // Provision the slot tree (clone for autoclone; require pre-clone otherwise).
    prov_log = string.concat(string.concat("/tmp/aeb-agent-", guid), ".log")
    prov_err = _provision_slot(req_mode, workdir, dispatch_repo, prov_log)
    if string.length(prov_err) > 0 {
        println("agent: PREP-FAILED guid=${guid} (${prov_err})")
        _rs = _slot_release(claimed_slot)
        http.response_set_status(res, 409)
        http.response_set_header(res, "Content-Type", "application/json")
        http.response_set_body(res, dispatch_reply_json(guid, "prep-failed", ""))
        return 0
    }

    // --- Per-dispatch container image (run_on=podman): the requester may name
    //   the toolchain image this job needs ("image" field) — e.g. a Rust job
    //   asks for aeb-tc:rust, a JDK job for aeb-tc:jdk21 — so ONE agent serves
    //   fine-grained jobs whose layers the bare host lacks, choosing the image
    //   PER JOB instead of one image for the agent's whole life. aeb owns no
    //   token→image map (that resolution lives with the requester's agent, like
    //   install-resolution); aeb only RUNS the image it's handed, and only if
    //   _image_allowed lets it (fail-closed lease gate). The override is applied
    //   to AEB_AGENT_CTR_IMAGE for THIS dispatch (both the veto and the build
    //   phase read it) and restored after, so the next dispatch w/o an image
    //   falls back to the agent default. Single-job-at-a-time => safe to mutate.
    //   The effective image is a LOCAL (eff_image) threaded into the veto + the
    //   podman build branch — NOT stashed in global env (concurrent dispatches
    //   would race). Defaults to the agent's --ctr-image when no override.
    dispatch_image = _json_field(body, "image")
    eff_image = os.getenv("AEB_AGENT_CTR_IMAGE")
    if string.length(dispatch_image) > 0 {
        if _image_allowed(dispatch_image) == 0 {
            println("agent: REJECT guid=${guid} image=${dispatch_image} (not in --allow-image; fail-closed)")
            _rs = _slot_release(claimed_slot)
            http.response_set_status(res, 403)
            http.response_set_header(res, "Content-Type", "application/json")
            http.response_set_body(res, dispatch_reply_json(guid, "rejected", ""))
            return 0
        }
        println("agent: image-override guid=${guid} -> ${dispatch_image}")
        eff_image = dispatch_image
    }

    // --- Per-dispatch raw build command (run_on=host OR vm): a non-aeb project
    //   (its build is build.sh / make / cmake, no .build.ae) names the command
    //   to run via the "command" field, instead of `aeb <target>`. run_on=host
    //   runs it in the workdir (agent NATIVE on the build box — e.g. a Mac mini
    //   doing AppKit builds, no ssh hop); run_on=vm runs it on the VM. Either
    //   way it's arbitrary command execution, so OPT-IN + fail-closed: honoured
    //   ONLY with --allow-vm-command (AEB_AGENT_ALLOW_VM_COMMAND=1); without it a
    //   "command" is REJECTED. Published to AEB_AGENT_VM_COMMAND for THIS
    //   dispatch (read by the host branch / _run_on_vm) and restored after.
    //   run_on=podman ignores it (that verb is container-shaped, not command-shaped).
    // dispatch_command stays a LOCAL — passed to the build branch / _run_on_vm
    // directly, never through global env (concurrent dispatches would race).
    dispatch_command = _json_field(body, "command")
    if string.length(dispatch_command) > 0 {
        allow_cmd = os.getenv("AEB_AGENT_ALLOW_VM_COMMAND")
        if string.equals(allow_cmd, "1") == 0 {
            println("agent: REJECT guid=${guid} (dispatch carries a raw command but agent lacks --allow-vm-command; fail-closed)")
            _rs = _slot_release(claimed_slot)
            http.response_set_status(res, 403)
            http.response_set_header(res, "Content-Type", "application/json")
            http.response_set_body(res, dispatch_reply_json(guid, "rejected", ""))
            return 0
        }
        println("agent: raw-command guid=${guid} -> ${dispatch_command}")
    }
    // keep_alive: opt OUT of dispatch-end process reaping. By default a raw
    // command is run in its own process group and group-reaped when it returns
    // (TERM→grace→KILL), so a backgrounded server (`… &`) can't outlive the
    // dispatch and wedge the build slot — closing the footgun the driver-gate
    // guide created. A dispatch that LEGITIMATELY needs a server to survive
    // (the AetherUIDriver "serve then drive" pattern) sets "keep_alive": true;
    // the agent then runs the command unreaped and reports it left a process up
    // (so the leak is intentional + accountable, not silent). LOCAL, not env.
    keep_alive = 0
    ka = _json_field(body, "keep_alive")
    if string.equals(ka, "true") == 1 { keep_alive = 1 }
    if string.equals(ka, "1") == 1 { keep_alive = 1 }
    if keep_alive == 1 { println("agent: keep_alive guid=${guid} — dispatch-spawned processes will NOT be reaped (caller owns teardown)") }

    // --- Prepare (wire ops, the agent's own lifecycle — NOT build grammar):
    //   1. git fetch origin <ref> && git checkout <hash>  (fetch-base)
    //   2. git apply <patch>                              (pre-integration delta)
    //   3. maybe_veto_build                               (agent's OWN gate)
    // Each step can fail/veto and short-circuit BEFORE the build runs. ---
    gref = _json_field(body, "ref")
    ghash = _json_field(body, "hash")
    patch_b64 = _json_field(body, "patch_b64")
    // advance/autoclone: the allowed branch is the ref to fetch + checkout (so a
    // CI agent tracks the branch HEAD). patch mode leaves gref as the dispatch's.
    if string.equals(req_mode, "advance") == 1 { if string.length(dispatch_branch) > 0 { gref = dispatch_branch } }
    if string.equals(req_mode, "autoclone") == 1 { if string.length(dispatch_branch) > 0 { gref = dispatch_branch } }
    // For advance/autoclone we want a checkout even when the dispatch gave no
    // explicit hash — checkout the fetched branch tip. _prepare_tree keys its
    // fetch/checkout on ghash being non-empty, so default ghash to the branch.
    if string.length(ghash) == 0 {
        if string.equals(req_mode, "advance") == 1 { ghash = dispatch_branch }
        if string.equals(req_mode, "autoclone") == 1 { ghash = dispatch_branch }
    }

    prep_err = _prepare_tree(guid, repo, gref, ghash, patch_b64, req_mode)
    if string.length(prep_err) > 0 {
        println("agent: PREP-FAILED guid=${guid} (${prep_err})")
        _rs = _slot_release(claimed_slot)
        http.response_set_status(res, 409)
        http.response_set_header(res, "Content-Type", "application/json")
        http.response_set_body(res, dispatch_reply_json(guid, "prep-failed", ""))
        return 0
    }

    // maybe_veto_build — the agent decides, on ITS OWN authority, whether
    // to build the prepared tree. Independent of whether the build would
    // succeed. A vetoed dispatch is NOT a build failure — it's a refusal.
    // The decoded patch (left by _prepare_tree) is scanned by patch-scope
    // rules, then removed regardless of outcome.
    patch_path = _patch_path_for(guid, patch_b64)
    // In raw-command mode the build verb is the foreign command, NOT `aeb
    // <target>` — there's no aeb target to emit an AST for (target is often a
    // placeholder like ".build.ae" that doesn't exist). So pass "" as the veto
    // target to skip the AST-emit layer; Tier-A (secret/banned markers over the
    // tree + the untrusted patch) STILL runs — that's the load-bearing gate for
    // an opaque foreign build.
    veto_target = target
    if string.length(dispatch_command) > 0 { veto_target = "" }
    veto = _maybe_veto_build(repo, veto_target, purpose, patch_path, eff_image)
    if string.length(patch_path) > 0 {
        _dp = fs.delete(patch_path)
    }
    if string.length(veto) > 0 {
        println("agent: VETOED guid=${guid} (${veto})")
        _rs = _slot_release(claimed_slot)
        http.response_set_status(res, 422)
        http.response_set_header(res, "Content-Type", "application/json")
        http.response_set_body(res, dispatch_reply_json(guid, "vetoed", ""))
        return 0
    }

    // Run the build, but DON'T throw away what it did — inform the developer.
    // aeb already produces structured output if asked: AEB_ARTIFACTS_JSON
    // lists what landed in target/ (the answer to "what got built"),
    // AEB_TELEMETRY_JSON the per-module timing. Point both at per-guid temp
    // files, tee stdout+stderr to a log, and keep os.system for the EXIT CODE
    // (os.exec swallows it). Then fold log-tail + artifacts into the reply so
    // a `result:fail` says WHY and a `result:pass` says WHAT was produced.
    artifacts_path = string.concat(string.concat("/tmp/aeb-agent-", guid), ".artifacts.json")
    log_path = string.concat(string.concat("/tmp/aeb-agent-", guid), ".log")
    _ea = os.setenv("AEB_ARTIFACTS_JSON", artifacts_path)

    // run_on: where the build runs.
    //   host (default): `aeb <target>` on the agent host (needs the toolchain).
    //   podman: the aeb-ctr TWO-PHASE duality (docs/two-aeb-duality.md) so an
    //     agent on an IMMUTABLE/toolchain-less host still builds —
    //       Phase 1 (IN container): `aeb --compile-only <target>` compiles the
    //         orchestrator (_ae_build_all) AND every node, with the image's full
    //         toolchain; artifacts land on the host via the :Z bind mount.
    //       Phase 2 (ON host): run the host-native orchestrator with
    //         AEB_EXECUTE_ONLY=1 — runs/tests against the host's runtimes.
    //     (The per-node AEB_COMPILE_CONTAINER seam alone is NOT enough: the
    //     orchestrator's OWN bootstrap compile still needs a host toolchain —
    //     verified on oldnuc, the build failed at _orchestrator.c with host
    //     aetherc hidden. Phase 1 compiles the whole thing in-container instead.)
    //   vm: run the WHOLE build on an SSH-reachable VM node (--vm-host, e.g. an
    //     ssh-config alias whose ProxyJump routes through the VM host). The
    //     agent rsyncs the prepared tree to the VM, runs `aeb <target>` there
    //     (the VM owns its own toolchain + aeb), then rsyncs artifacts + the log
    //     back. Mirrors run_on(podman)'s delegate-and-collect, one indirection
    //     out: agent → (ssh, maybe via the VM-host) → VM. The VM-host
    //     spawning/loaning the VM (virsh start/clone) is a later layer — for now
    //     the VM is an already-running, SSH-reachable build node. Lets a Linux
    //     agent dispatch a build onto e.g. a Windows VM.
    run_on = os.getenv("AEB_AGENT_RUN_ON")
    rc = 0
    if string.equals(run_on, "podman") == 1 {
        ctr_image = eff_image   // local per-dispatch image (thread-safe)
        engine = os.getenv("AEB_CONTAINER_ENGINE")
        if string.length(engine) == 0 { engine = "podman" }
        selabel = os.getenv("AEB_CONTAINER_SELABEL")
        if string.length(selabel) == 0 { selabel = "Z" }
        mnt = string.concat(workdir, string.concat(":/work:", selabel))
        // --all-in-container: run the WHOLE build (orchestrator + every node
        // step) in ONE `podman run`, instead of the two-phase
        // compile-in-container / execute-on-host duality. Required when the
        // toolchain lives ONLY in the image and the host can't run any node step
        // — e.g. a rust cdylib whose `cargo build` (a compile step run as a host
        // _sh, NOT through the AEB_COMPILE_CONTAINER seam) would hit
        // `cargo: command not found` on a toolchain-less host. This is exactly
        // the hand-proven Rung-1 path (`aeb <target>` in the image → .so via the
        // bind mount). The duality (phase split) stays the default — it's right
        // when the host HAS runtimes to execute/test against (host-Python etc.).
        // See asks/run-on-podman-all-in-container-mode-for-pure-compile-toolchains.md.
        if string.equals(os.getenv("AEB_AGENT_ALL_IN_CONTAINER"), "1") == 1 {
            println("agent: run_on=podman — all-in-container build in ${ctr_image}")
            allc = string.concat(engine, string.concat(" run --rm -v '", string.concat(mnt, string.concat("' -w /work --entrypoint aeb '", string.concat(ctr_image, string.concat("' '", string.concat(target, "'")))))))
            allc = string.concat(allc, " > '${log_path}' 2>&1")
            rc = build._sh(allc)
        } else {
            println("agent: run_on=podman — phase 1 compile-only in ${ctr_image}")
            // Phase 1: compile (orchestrator + all nodes) IN the container.
            p1 = string.concat(engine, string.concat(" run --rm -v '", string.concat(mnt, string.concat("' -w /work --entrypoint aeb '", string.concat(ctr_image, string.concat("' --compile-only '", string.concat(target, "'")))))))
            p1 = string.concat(p1, " > '${log_path}' 2>&1")
            rc = build._sh(p1)
            if rc == 0 {
                // Phase 2: run the host-native orchestrator (execute-only) on the host.
                orch = string.concat(workdir, "/target/_ae_build_all")
                p2 = string.concat("AEB_EXECUTE_ONLY=1 '", string.concat(orch, string.concat("' '", string.concat(workdir, "' >> '${log_path}' 2>&1"))))
                rc = build._sh(p2)
            }
        }
    } else {
        if string.equals(run_on, "vm") == 1 {
            // Pass the per-dispatch command as a LOCAL (dispatch_command), NOT via
            // global env — concurrent dispatches (per-slot trees) would race on a
            // shared env var. "" => default aeb <target>.
            rc = _run_on_vm(workdir, target, log_path, dispatch_command, keep_alive)
        } else {
            // run_on=host. Default verb is `aeb <target>`; but a raw command (the
            // dispatch's local "command" field, gated by --allow-vm-command) runs
            // verbatim in the workdir instead — for a non-aeb project
            // (build.sh/make/cmake, no .build.ae) built by an agent running
            // NATIVELY on the build box (e.g. a Mac mini doing AppKit builds).
            // Uses the LOCAL dispatch_command (thread-safe under concurrency).
            if string.length(dispatch_command) > 0 {
                println("agent: run_on=host raw command: ${dispatch_command}")
                // Reap-by-default: run the command in its own process group and
                // group-reap survivors when it returns, UNLESS keep_alive. The
                // inner verb still redirects to the log; the reap wrapper owns
                // job-control around it. (See _reap_wrap + the keep_alive note.)
                inner = "cd '${workdir}' && ${dispatch_command} > '${log_path}' 2>&1"
                if keep_alive == 1 {
                    rc = build._sh(inner)
                } else {
                    rc = build._sh(_reap_wrap(inner))
                }
            } else {
                cmd = "cd '${workdir}' && aeb '${target}' > '${log_path}' 2>&1"
                rc = build._sh(cmd)
            }
        }
    }

    result = "pass"
    if rc != 0 { result = "fail" }

    // Read back what the build told us (best-effort; absent files → empty).
    // Pass aeb's RAW {"artifacts":[...]} body straight to the reply builder,
    // which parses it with std.json (no string surgery here).
    artifacts_body = ""
    if file.exists(artifacts_path) == 1 {
        aj_raw, _aje = io.read_file(artifacts_path)
        artifacts_body = aj_raw
    }
    log_tail = ""
    if file.exists(log_path) == 1 {
        log_tail = _tail_capture(log_path, 40)
    }
    // Tidy the per-guid temp files now that we've read them (pure, no shell).
    _da = fs.delete(artifacts_path)
    _dl = fs.delete(log_path)

    // (image + command are LOCALS threaded into the build/veto — no global env
    // to restore, so concurrent dispatches don't race. See eff_image below.)
    // scrub-after (autoclone + --scrub-after): delete the slot's cloned tree so
    // nothing persists between jobs (ephemeral/untrusted builds). Only the clone
    // is removed; the slot lock is released below. Best-effort.
    if string.equals(req_mode, "autoclone") == 1 {
        if string.equals(os.getenv("AEB_AGENT_SCRUB_AFTER"), "1") == 1 {
            println("agent: scrub-after guid=${guid} — removing slot tree ${workdir}")
            _scr = build._sh(string.concat("rm -rf '", string.concat(workdir, "' 2>/dev/null; true")))
        }
    }
    // Release the build slot — the build is done (this is the success path; all
    // earlier short-circuits released already). Frees capacity for the next.
    _rsd = _slot_release(claimed_slot)

    println("agent: DONE guid=${guid} result=${result} (rc=${rc})")
    http.response_set_status(res, 200)
    http.response_set_header(res, "Content-Type", "application/json")
    http.response_set_body(res, _dispatch_reply_rich(guid, "done", result, artifacts_body, log_tail, keep_alive))
    return 0
}

// _tail_capture(path, n) — last n lines of the build log, shelled out (tail
// is simplest + robust for an arbitrarily large log). Returns "" on failure.
_tail_capture(path: string, n: int) {
    tmp = string.concat(path, ".tail")
    _r = build._sh(string.concat(string.concat("tail -n ", string.from_int(n)), string.concat(string.concat(" '", path), string.concat("' > '", string.concat(tmp, "' 2>/dev/null")))))
    out = ""
    if file.exists(tmp) == 1 {
        out_raw, _e = io.read_file(tmp)
        out = out_raw
        _dt = fs.delete(tmp)
    }
    return out
}

// _dispatch_reply_rich(guid, status, result, artifacts_body, log) — the
// "inform the developer" reply: the terse verdict PLUS what got built
// (the artifacts array, lifted straight from aeb's AEB_ARTIFACTS_JSON) and a
// log tail (so a fail says why, a pass says what). Built with std.json, so
// the log's arbitrary build output is escaped correctly and the artifacts
// nest as a real JSON value — no hand-rolled string surgery. The skinny
// dispatch_reply_json (in lib/agent) stays for the policy-class "skinny
// callback + details_url" path.
//
// artifacts_body is aeb's raw {"artifacts":[...]} file content (or "" if the
// build wrote none). We parse it and graft its "artifacts" array onto our
// reply; a parse failure / absent file degrades to an empty array.
_dispatch_reply_rich(guid: string, status: string, result: string, artifacts_body: string, log: string, kept_alive: int) {
    reply_obj = json.create_object()
    _s1 = json.object_set(reply_obj, "guid", json.create_string(guid))
    _s2 = json.object_set(reply_obj, "status", json.create_string(status))
    _s3 = json.object_set(reply_obj, "result", json.create_string(result))
    _s4 = json.object_set(reply_obj, "log", json.create_string(log))
    // kept_alive: true = this dispatch opted out of reaping, so a process it
    // spawned may still be running on the host. Surfaced so the leak is
    // ACCOUNTABLE (the ask's requirement) — the caller sees it must tear the
    // process down (a follow-up command:"pkill …" / "kill …" dispatch). Absent
    // / false on a normal reaped dispatch.
    if kept_alive == 1 { _sk = json.object_set(reply_obj, "kept_alive", json.create_string("true")) }

    // Lift the artifacts array out of aeb's wrapper object, if present.
    arts = json.create_array()
    if string.length(artifacts_body) > 0 {
        parsed, perr = json.parse(artifacts_body)
        if string.length(perr) == 0 {
            inner, _ge = json.object_get(parsed, "artifacts")
            if inner != null {
                // Re-home each element onto our owned array (the parsed
                // tree is freed below; array_add takes ownership, so we
                // copy via stringify/parse-free-of-ownership avoidance:
                // simplest is to move the whole parsed array by detaching).
                m = json.array_size(inner)
                k = 0
                while k < m {
                    el, _ae = json.array_get(inner, k)
                    if el != null {
                        // Deep-copy the element by round-tripping its text,
                        // so freeing `parsed` doesn't invalidate our array.
                        el_txt, _se = json.stringify(el)
                        el_copy, _pe = json.parse(el_txt)
                        if el_copy != null { _aa = json.array_add(arts, el_copy) }
                    }
                    k = k + 1
                }
            }
            json.free(parsed)
        }
    }
    _s5 = json.object_set(reply_obj, "artifacts", arts)

    body, _serr = json.stringify(reply_obj)
    json.free(reply_obj)
    return body
}

handle_health(req: ptr, res: ptr, ud: ptr) {
    http.response_set_status(res, 200)
    http.response_set_body(res, "ok")
    return 0
}

// Run the blocking server loop off an actor, mirroring the stdlib
// integration-test idiom (a plain call to http_server_start_raw in main
// ties up the scheduler before the bind is observable).
message StartSrv { raw: ptr }
actor SrvActor {
    state s = 0
    receive { StartSrv(raw) -> { s = raw; http_server_start_raw(raw) } }
}

main() {
    argc = aether_args_count()
    port = 9440
    host = "127.0.0.1"
    scope_name = "preint"
    accept_glob = "preint/*"
    max_jobs = 1
    workdir = "."
    repo_dir = ""
    lease_secrets_file = ""
    run_on = "host"
    ctr_image = ""
    allow_image = ""
    all_in_container = 0
    allow_vm_command = 0
    vm_host = ""
    vm_dir = ""
    vm_shell = ""
    allow_from = ""
    provision_modes = ""
    advance_branches = ""
    autoclone_allow = ""
    scrub_after = 0

    i = 1
    while i < argc {
        a = aether_args_get(i)
        // --help / -h / unknown flag: print usage and EXIT — do NOT fall
        // through to starting the server (that footgun hung a container
        // build when `aeb-agent --help` silently launched with defaults).
        if string.equals(a, "--help") == 1 { _usage(); exit(0) }
        if string.equals(a, "-h") == 1 { _usage(); exit(0) }
        if string.equals(a, "--port") == 1 { i = i + 1; port = _atoi(aether_args_get(i)) }
        if string.equals(a, "--host") == 1 { i = i + 1; host = aether_args_get(i) }
        if string.equals(a, "--scope") == 1 { i = i + 1; scope_name = aether_args_get(i) }
        if string.equals(a, "--accept") == 1 { i = i + 1; accept_glob = aether_args_get(i) }
        if string.equals(a, "--max-jobs") == 1 { i = i + 1; max_jobs = _atoi(aether_args_get(i)) }
        if string.equals(a, "--workdir") == 1 { i = i + 1; workdir = aether_args_get(i) }
        if string.equals(a, "--repo") == 1 { i = i + 1; repo_dir = aether_args_get(i) }
        // --lease-secrets FILE: enable LEASE auth (HMAC-signed, expiring,
        // purpose-bound tokens). The file holds ONE OR MORE signing secrets, one
        // per non-blank line (read from a file so they're never on the command
        // line / in ps). A token signed by ANY listed secret is accepted —
        // multiple lines = zero-downtime rotation (accept old+new, then drop
        // old). REQUIRED — without it the agent is fail-closed (refuses all).
        // The lessor mints with one of these secrets; the agent only verifies.
        // See lib/agent _lease_verify_any.
        if string.equals(a, "--lease-secrets") == 1 { i = i + 1; lease_secrets_file = aether_args_get(i) }
        // --run-on host|podman: where the agent runs the build it accepts.
        // "podman" delegates each compile step into --ctr-image via the
        // AEB_COMPILE_CONTAINER seam (the compile-in-container/execute-on-host
        // duality, docs/two-aeb-duality.md) — so an agent on an immutable host
        // (no toolchain) can still build. Default "host" = today's bare build.
        if string.equals(a, "--run-on") == 1 { i = i + 1; run_on = aether_args_get(i) }
        if string.equals(a, "--ctr-image") == 1 { i = i + 1; ctr_image = aether_args_get(i) }
        // --allow-image GLOB: per-dispatch "image" overrides the agent default
        // ONLY if they match this glob (trailing "*" = prefix, "*" = any). With
        // no --allow-image, only the default --ctr-image is runnable — a leased
        // agent can't be talked into pulling an arbitrary image. Fail-closed.
        if string.equals(a, "--allow-image") == 1 { i = i + 1; allow_image = aether_args_get(i) }
        // --run-on vm: build on an SSH-reachable VM node (rsync tree → ssh aeb →
        // rsync artifacts back). --vm-host is the ssh target/alias (its config may
        // ProxyJump through the VM host); --vm-dir is the remote build dir.
        if string.equals(a, "--vm-host") == 1 { i = i + 1; vm_host = aether_args_get(i) }
        if string.equals(a, "--vm-dir") == 1 { i = i + 1; vm_dir = aether_args_get(i) }
        // --vm-shell PREFIX: wrap remote VM commands in PREFIX "<cmd>" (e.g.
        // 'C:\msys64\usr\bin\bash.exe -lc' for a Windows VM whose default ssh
        // shell is cmd.exe). Empty = the VM's default ssh shell is POSIX.
        if string.equals(a, "--vm-shell") == 1 { i = i + 1; vm_shell = aether_args_get(i) }
        // --allow-vm-command: opt-in to honouring a dispatch's "command" field
        // (run_on=vm raw build verb — build.sh/make/cmake instead of aeb
        // <target>). Arbitrary command execution on the VM, so fail-closed:
        // without this flag a dispatch carrying a command is rejected.
        if string.equals(a, "--allow-vm-command") == 1 { allow_vm_command = 1 }
        // --all-in-container (run_on=podman): run the WHOLE build in one
        // `podman run` of the per-job image, instead of the compile-in-container
        // / execute-on-host duality. For a toolchain-only-in-image build (rust
        // cargo, go, ...) where the host can't run node steps. Default off (the
        // duality stays default — right when the host has runtimes to execute).
        if string.equals(a, "--all-in-container") == 1 { all_in_container = 1 }
        // --allow-from <ip>[,<ip>...]: source-IP allow-list (exact IPs), checked
        // before auth against the trusted TCP peer address. Unset = no IP
        // restriction. Defense-in-depth under auth; needs Aether >=0.256.
        if string.equals(a, "--allow-from") == 1 { i = i + 1; allow_from = aether_args_get(i) }
        // Provisioning modes (per-slot tree lifecycle — docs/agent-provisioning-modes.md).
        // --provision-modes: the set this agent OFFERS (default patch). --advance-branches:
        // branch allow-list for `advance`. --autoclone-allow: <repo>[#<branch>] allow-list
        // for `autoclone`. --scrub-after: delete the autoclone tree after each job.
        if string.equals(a, "--provision-modes") == 1 { i = i + 1; provision_modes = aether_args_get(i) }
        if string.equals(a, "--advance-branches") == 1 { i = i + 1; advance_branches = aether_args_get(i) }
        if string.equals(a, "--autoclone-allow") == 1 { i = i + 1; autoclone_allow = aether_args_get(i) }
        if string.equals(a, "--scrub-after") == 1 { scrub_after = 1 }
        i = i + 1
    }
    // --repo defaults to --workdir (the agent's clone IS the build dir
    // unless an operator separates them).
    if string.length(repo_dir) == 0 { repo_dir = workdir }

    // Publish the single scope's config to the env the handler reads.
    _e1 = os.setenv("AEB_AGENT_ACCEPT", accept_glob)
    // Capacity (--max-jobs) — the number of build slots. Default 1 (one shared
    // --workdir can host only one build safely). Always published so the slot
    // gate sees it. PORT keys the slot lock-root (co-located agents don't share).
    _e2 = os.setenv("AEB_AGENT_MAX_JOBS", string.from_int(max_jobs))
    _e2p = os.setenv("AEB_AGENT_PORT", string.from_int(port))
    _e3 = os.setenv("AEB_AGENT_WORKDIR", workdir)
    _e3b = os.setenv("AEB_AGENT_REPO", repo_dir)
    // Lease auth: read the WHOLE secrets file (one-or-more secrets, one per
    // line) and publish it verbatim. Its presence flips _authed_for into lease
    // mode; _lease_verify_any accepts a token signed by any listed secret.
    lease_secrets = ""
    lease_secret_count = 0
    if string.length(lease_secrets_file) > 0 {
        ls_raw, ls_err = io.read_file(lease_secrets_file)
        if string.length(ls_err) > 0 {
            println("aeb-agent: --lease-secrets file UNREADABLE: ${lease_secrets_file} (${ls_err}); refusing to start.")
            println("aeb-agent:   Check it exists + is readable; for a container bind mount on SELinux")
            println("aeb-agent:   (Bazzite/Fedora) mount it :Z, e.g.  -v host/secrets:${lease_secrets_file}:ro,Z")
            exit(2)
        }
        // Count non-blank/non-comment lines (the actual secrets); refuse to
        // start with an effectively-empty file (would silently accept nothing).
        lease_secret_count = map.size(_parse_tokens(ls_raw))
        if lease_secret_count == 0 {
            println("aeb-agent: --lease-secrets file has no secrets (blank/comments only): ${lease_secrets_file}; refusing to start.")
            exit(2)
        }
        // Footgun guard: a line that's a minted TOKEN ("ae1.…") means a token was
        // pasted where the opaque signing secret belongs. Refuse loudly.
        if _secrets_have_token(ls_raw) == 1 {
            println("aeb-agent: --lease-secrets file ${lease_secrets_file} contains a LEASE TOKEN (ae1.…), not a signing secret.")
            println("aeb-agent:   The secret is the opaque key that verifies tokens; a token is its OUTPUT. Refusing to start.")
            println("aeb-agent:   Generate a real secret:  aeb-keygen > ${lease_secrets_file}")
            exit(2)
        }
        // Envelope (hard): every secret must carry the 'aeb-secret-v1:' marker —
        // greppable for security sweeps + refuse a bare blob that isn't an aeb
        // secret. The HMAC keys on the material after the marker (crypto same).
        nomark = _secrets_no_marker_line(ls_raw)
        if string.length(nomark) > 0 {
            println("aeb-agent: --lease-secrets file ${lease_secrets_file} has a secret missing the 'aeb-secret-v1:' marker. Refusing to start.")
            println("aeb-agent:   Generate enveloped secrets:  aeb-keygen   (writes aeb-secret-v1:<random>)")
            exit(2)
        }
        // Entropy floor (hard): refuse any weak (< 32-char) key MATERIAL — it's
        // guessable. The minter runs the SAME test, so every real secret passes.
        weak = _secrets_weak_line(ls_raw)
        if string.length(weak) > 0 {
            println("aeb-agent: --lease-secrets file ${lease_secrets_file} has a WEAK secret (material < 32 chars) — guessable. Refusing to start.")
            println("aeb-agent:   Generate strong secrets:  aeb-keygen")
            exit(2)
        }
        lease_secrets = ls_raw
        _e4b = os.setenv("AEB_AGENT_LEASE_SECRETS", lease_secrets)
    }

    // run_on plumbing: publish the run mode + container image so the handler
    // (state-less) reconstructs them per dispatch. --run-on podman REQUIRES a
    // --ctr-image; refuse to start otherwise (a silent fall-back to host on an
    // immutable host would fail every build confusingly).
    if string.equals(run_on, "podman") == 1 {
        if string.length(ctr_image) == 0 {
            println("aeb-agent: --run-on podman requires --ctr-image <toolchain-image>; refusing to start.")
            exit(2)
        }
    }
    if string.equals(run_on, "vm") == 1 {
        if string.length(vm_host) == 0 {
            println("aeb-agent: --run-on vm requires --vm-host <ssh-target>; refusing to start.")
            exit(2)
        }
    }
    _e5 = os.setenv("AEB_AGENT_RUN_ON", run_on)
    if string.length(ctr_image) > 0 { _e6 = os.setenv("AEB_AGENT_CTR_IMAGE", ctr_image) }
    if string.length(allow_image) > 0 { _e6b = os.setenv("AEB_AGENT_ALLOW_IMAGE", allow_image) }
    if allow_vm_command == 1 { _e6c = os.setenv("AEB_AGENT_ALLOW_VM_COMMAND", "1") }
    if all_in_container == 1 { _e6d = os.setenv("AEB_AGENT_ALL_IN_CONTAINER", "1") }
    if string.length(allow_from) > 0 { _e6d = os.setenv("AEB_AGENT_ALLOW_FROM", allow_from) }
    // Provisioning-mode config (the handler reconstructs per dispatch).
    if string.length(provision_modes) > 0 { _ep1 = os.setenv("AEB_AGENT_PROVISION_MODES", provision_modes) }
    if string.length(advance_branches) > 0 { _ep2 = os.setenv("AEB_AGENT_ADVANCE_BRANCHES", advance_branches) }
    if string.length(autoclone_allow) > 0 { _ep3 = os.setenv("AEB_AGENT_AUTOCLONE_ALLOW", autoclone_allow) }
    if scrub_after == 1 { _ep4 = os.setenv("AEB_AGENT_SCRUB_AFTER", "1") }
    if string.length(vm_host) > 0 { _e7 = os.setenv("AEB_AGENT_VM_HOST", vm_host) }
    if string.length(vm_dir) > 0 { _e8 = os.setenv("AEB_AGENT_VM_DIR", vm_dir) }
    if string.length(vm_shell) > 0 { _e9 = os.setenv("AEB_AGENT_VM_SHELL", vm_shell) }

    // Fail-closed auth posture. The --lease-secrets read above already
    // exit(2)'d on an unreadable/empty file (a misconfiguration must not
    // masquerade as intended fail-closed), so by here it's either armed or
    // never-given.
    if string.length(lease_secrets) > 0 {
        // Lease mode armed. Show the secret COUNT (never the bytes).
        println("aeb-agent: LEASE auth armed (HMAC-signed, expiring, purpose-bound tokens) — ${lease_secret_count} secret(s) from ${lease_secrets_file}")
    } else {
        println("aeb-agent: no --lease-secrets given; REFUSING ALL dispatches (fail-closed). Pass --lease-secrets <file>.")
    }

    // Probe the toolchain versions ONCE at startup (shelling out per /ping would
    // be wasteful) and cache in env for handle_ping to report. An originator's
    // /ping then sees which aeb/aether this agent would build with.
    _av = _probe_aeb_version()
    if string.length(_av) > 0 { _eav = os.setenv("AEB_AGENT_AEB_VERSION", _av) }
    _tv = _probe_aether_version()
    if string.length(_tv) > 0 { _etv = os.setenv("AEB_AGENT_AETHER_VERSION", _tv) }

    // Clear any slot lock-dirs leaked by a previous crash — a fresh start IS the
    // capacity reset (the OTP answer would be a supervisor restart). Safe: the
    // agent isn't serving yet, so no live build owns a slot.
    _sc = _slot_clear_all()
    // Per-slot tree isolation: each slot i builds in <workdir>/<i>, so N>1 is now
    // safe (no shared tree). Offered provisioning modes + the pre-clone check:
    offered_disp = provision_modes
    if string.length(offered_disp) == 0 { offered_disp = "patch" }
    println("aeb-agent: provision modes offered: ${offered_disp}")
    miss = _check_preclone(workdir, max_jobs, offered_disp)
    if string.length(miss) > 0 {
        println("aeb-agent: WARNING pre-cloned mode(s) offered but these slot trees are missing a .git:")
        println("aeb-agent:   ${miss}")
        println("aeb-agent:   patch/advance dispatches to those slots will prep-fail until you clone them")
        println("aeb-agent:   (e.g. git clone <src> ${workdir}/0 ; … up to ${workdir}/$((N-1))).")
    }

    raw = http.server_create(port)
    if raw == 0 { println("aeb-agent: FAIL server_create"); exit(1) }
    http.server_set_host(raw, host)
    http.server_post(raw, "/dispatch", handle_dispatch, 0)
    http.server_get(raw, "/ping", handle_ping, 0)
    http.server_get(raw, "/health", handle_health, 0)

    println("aeb-agent: listening on ${host}:${port} scope=${scope_name} accept=${accept_glob} slots=${max_jobs} workdir=${workdir}")
    println("aeb-agent: toolchain — ${_av} / ${_tv}")

    // Distinct name: `a` was the arg-loop string above; reusing it for the
    // actor handle is a const-char*-vs-actor* type conflict that a strict
    // gcc (e.g. Debian's, -Wincompatible-pointer-types as an error) rejects.
    srv = spawn(SrvActor())
    srv ! StartSrv { raw: raw }
    sleep(86400000)
    exit(0)
}

_usage() {
    println("aeb-agent — remote build agent (listens for dispatch requests)")
    println("")
    println("Usage: aeb-agent [options]")
    println("  --host H        bind address (default 127.0.0.1; use 0.0.0.0 to be reachable off-box)")
    println("  --allow-from IPS  comma-list of exact source IPs allowed to dispatch (checked before auth,")
    println("                  fail-closed; unset = no IP restriction). Defense-in-depth under auth.")
    println("  --provision-modes M[,M]  per-slot tree modes this agent OFFERS: patch (pre-cloned, no-fetch / dev),")
    println("                  advance (pre-cloned, branch-track / CI), autoclone (clone from allow-list). Default patch.")
    println("  --advance-branches GLOB[,GLOB]  for advance: which branches may be tracked (fail-closed; empty = none).")
    println("  --autoclone-allow R[#B][,…]  for autoclone: approved <repo>[#<branch>] (fail-closed; empty = none).")
    println("  --scrub-after   for autoclone: delete the per-slot clone after each job (ephemeral builds).")
    println("  --port N        listen port (default 9440)")
    println("  --accept GLOB   purpose scope to accept (default 'preint/*')")
    println("  --workdir DIR   directory the agent runs builds in (default '.')")
    println("  --max-jobs N    build-slot capacity — N concurrent builds; over-capacity dispatches get 'busy' (default 1).")
    println("                  N>1 needs per-slot workdir isolation (TODO); >1 on one shared --workdir clobbers the tree.")
    println("  --lease-secrets FILE  LEASE auth (REQUIRED — without it the agent refuses ALL, fail-closed):")
    println("                  HMAC-signed, expiring, purpose-bound tokens (ae1.<purpose>.<expiry>.<sig>). Holds ONE OR")
    println("                  MORE signing secrets, one per line (multiple = zero-downtime rotation). The lessor mints; the agent verifies.")
    println("  --scope NAME    scope label for display (default 'preint')")
    println("  --run-on KIND   host (default) | podman | vm — where builds run")
    println("  --ctr-image IMG toolchain image for --run-on podman (e.g. aeb-toolchain:slim); required then")
    println("  --allow-image GLOB  let a dispatch's \"image\" field override --ctr-image if it matches")
    println("                  (trailing '*' = prefix, '*' = any). Without it, only --ctr-image runs.")
    println("  --all-in-container  (--run-on podman) build the WHOLE target in one container run")
    println("                  instead of compile-in-container/execute-on-host. For toolchain-")
    println("                  only-in-image builds (rust cargo, go, ...) on a toolchain-less host.")
    println("  --vm-host HOST  ssh target/alias for --run-on vm (its config may ProxyJump); required then")
    println("  --vm-dir DIR    remote build dir on the VM (--run-on vm; default /tmp/aeb-vm-build)")
    println("  --vm-shell PFX  wrap VM commands as PFX \"<cmd>\" for a non-POSIX default ssh shell, e.g.")
    println("                  'C:\\msys64\\usr\\bin\\bash.exe -lc' on a Windows VM (winbaz)")
    println("  --allow-vm-command  honour a dispatch's \"command\" field on --run-on host OR vm (run")
    println("                  build.sh/make instead of aeb <target>). Arbitrary command exec — off by default (fail-closed).")
    println("  -h, --help      this message")
    println("")
    println("Endpoints: GET /health (open), GET /ping (auth), POST /dispatch (auth)")
}

_atoi(s: string) {
    n = string.length(s)
    if n == 0 { return 0 }
    i = 0
    v = 0
    digits = "0123456789"
    while i < n {
        c = string.substring(s, i, i + 1)
        d = string.index_of(digits, c)
        if d < 0 { return v }
        v = v * 10 + d
        i = i + 1
    }
    return v
}
