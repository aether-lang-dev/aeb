// aeb-agent — remote-aeb listener (walking skeleton).
//
// A sovereign build agent: listens on HTTP, decides accept/busy/reject
// for an incoming dispatch against its scope, runs `aeb <target>`
// locally on the bare host, and returns a terse verdict. Stood up on a
// remote box (oldnuc / mac-mini / bazzite); an originating aeb's
// `agent.dispatch` fires requests at it.
//
// Usage:
//   aeb agent [--port N] [--host H] [--scope NAME] [--accept GLOB]
//             [--max-jobs N] [--workdir DIR]
//
// Walking skeleton — synchronous: POST /dispatch decides, runs aeb
// inline, and returns the final verdict in the same response (the
// fire-async + webhook-back + details_url split from the design doc is a
// later thickening). One scope from CLI flags for now; the composable
// scope-TREE config (.ae closure DSL, podman/vm run_on kinds) slots in
// without reshaping the decision core, which lives in lib/agent and is
// shared + unit-tested.
//
// Decision core (pure): agent._decision(scope, purpose, active).
// NOT yet: token auth, cache partitioning. See
// docs/run-policy-class-and-cloud-leverage.md.

import std.http
import std.string
import std.os
import std.map
import std.list

import agent (_decision, dispatch_reply_json, ping_json, _json_field,
              _parse_tokens, _token_ok, _bearer_strip, _veto_run_rules)
import std.io
import std.file
import std.json

extern println(s: string)
extern exit(code: int)
extern http_server_start_raw(server: ptr) -> int
extern http_get_header(req: ptr, name: string) -> string

// Config travels to the (state-less, can't-close-over-locals) route
// handler through the process env, set by main() before the server
// starts: AEB_AGENT_ACCEPT (glob), AEB_AGENT_MAX_JOBS, AEB_AGENT_WORKDIR.
// The handler reconstructs the scope map per request from these — cheap,
// and avoids module-level mutable globals (which Aether doesn't have).
// max_jobs enforcement is exercised by the lib/agent unit tests; under
// the skeleton's synchronous handling `active` is effectively 0, so the
// gate becomes load-bearing only when the handler goes async (a later
// thickening).

_scope_from_env() {
    s = map.new()
    _r = map.put(s, "run_on", "host")
    mj = os.getenv("AEB_AGENT_MAX_JOBS")
    if string.length(mj) > 0 { _m = map.put(s, "max_jobs", mj) }
    glob = os.getenv("AEB_AGENT_ACCEPT")
    if string.length(glob) == 0 { glob = "preint/*" }
    globs = list.new()
    _g = list.add(globs, glob)
    _a = map.put(s, "accept_scope", globs)
    return s
}

// Re-read the tokens file per request (skeleton-simple; gives free
// reload). Returns the token set, or null when no --tokens was given.
_load_tokens() {
    tf = os.getenv("AEB_AGENT_TOKENS")
    if string.length(tf) == 0 { return null }
    if file.exists(tf) == 0 { return null }
    content, _e = io.read_file(tf)
    return _parse_tokens(content)
}

// _authed(req) — the naive token gate (fail-closed), shared by /dispatch
// and /ping. Returns 1 when the request presents a known token, 0 when it
// must be refused (no --tokens file, or bad/missing token).
_authed(req: ptr) {
    toks = _load_tokens()
    if toks == null { return 0 }
    presented = _bearer_strip(http_get_header(req, "X-AEB-Token"))
    if string.length(presented) == 0 {
        presented = _bearer_strip(http_get_header(req, "Authorization"))
    }
    return _token_ok(toks, presented)
}

// GET /ping — auth-gated identity + capability descriptor. An authorized
// originator/sysop confirms this is really an aeb-agent and learns its
// platform / accept-scope / busy / auth posture BEFORE committing a
// dispatch. Gated like /dispatch: no/ bad token => 401, reveals nothing
// (an unauthenticated prober can't even fingerprint the agent). The
// dumb unauthenticated liveness check stays at /health.
handle_ping(req: ptr, res: ptr, ud: ptr) {
    if _authed(req) == 0 {
        http.response_set_status(res, 401)
        http.response_set_header(res, "Content-Type", "application/json")
        http.response_set_body(res, "{\"error\":\"unauthorized\"}")
        return 0
    }
    accept = os.getenv("AEB_AGENT_ACCEPT")
    if string.length(accept) == 0 { accept = "preint/*" }
    mj = os.getenv("AEB_AGENT_MAX_JOBS")
    // auth is always "required" here — /ping only succeeds when authed,
    // and the agent is fail-closed, so a reachable authed ping implies
    // tokens are configured.
    body = ping_json(os.platform(), accept, "false", mj, "required")
    http.response_set_status(res, 200)
    http.response_set_header(res, "Content-Type", "application/json")
    http.response_set_body(res, body)
    return 0
}

// _prepare_tree(guid, repo, ref, hash, patch_b64) — materialize the tree
// to build, in the agent's own repo, BEFORE the build runs. Returns "" on
// success or an error string. Steps (each skipped when its field is ""):
//   - git fetch origin <ref> && git checkout <hash>  (trusted base)
//   - decode patch_b64 (shell base64 -d -> temp file) && git apply
//     (the untrusted pre-integration delta)
// The agent owns the origin (the dispatch never names a remote URL), so
// fetch pulls only from where the operator configured the clone.
_prepare_tree(guid: string, repo: string, gref: string, ghash: string, patch_b64: string) {
    if string.length(ghash) > 0 {
        // Inter-dispatch isolation: scrub the worktree to a pristine state
        // BEFORE checkout, so dispatch N is not poisoned by dispatch N-1's
        // build outputs or applied patch. Without this, a prior `git apply`
        // leaves local modifications that make this checkout fail (git
        // refuses to clobber them) or, worse, silently build on stale state.
        //   reset --hard      → discard tracked-file modifications
        //   clean -ffdx       → remove untracked + ignored (build outputs)
        // This is a correctness property (repeatable builds), independent of
        // the security hardening in docs/agent-lifecycle.md.
        scrub_cmd = string.concat(string.concat("cd '", repo), "' && git reset --hard --quiet && git clean -ffdxq")
        src = os.system(scrub_cmd)
        if src != 0 { return "git worktree scrub failed (reset/clean)" }

        // ref is optional (fetch a specific ref before checkout); default
        // to fetching all from origin when ref is empty.
        fr = gref
        if string.length(fr) == 0 { fr = "" }
        fetch_cmd = string.concat("cd '", repo)
        if string.length(fr) > 0 {
            fetch_cmd = string.concat(fetch_cmd, "' && git fetch origin '")
            fetch_cmd = string.concat(fetch_cmd, fr)
            fetch_cmd = string.concat(fetch_cmd, "'")
        } else {
            fetch_cmd = string.concat(fetch_cmd, "' && git fetch origin")
        }
        frc = os.system(fetch_cmd)
        if frc != 0 { return "git fetch failed" }

        co_cmd = string.concat(string.concat("cd '", repo), string.concat("' && git checkout --quiet '", string.concat(ghash, "'")))
        crc = os.system(co_cmd)
        if crc != 0 { return "git checkout ${ghash} failed" }
    }

    if string.length(patch_b64) > 0 {
        // Decode via shell (no Aether handling of the binary-ish diff) to
        // a temp file, then git apply. printf the b64 then base64 -d.
        pf = string.concat("/tmp/aeb-agent-patch-", string.concat(guid, ".diff"))
        dec_cmd = string.concat(string.concat("printf '%s' '", patch_b64), string.concat("' | base64 -d > '", string.concat(pf, "'")))
        drc = os.system(dec_cmd)
        if drc != 0 { return "patch base64 decode failed" }
        ap_cmd = string.concat(string.concat("cd '", repo), string.concat("' && git apply '", string.concat(pf, "'")))
        arc = os.system(ap_cmd)
        // NB: the decoded patch file (pf) is deliberately NOT removed here — the
        // Tier-A veto's patch-scope rules scan it (the highest-signal target).
        // handle_dispatch removes it after the veto decision. On apply failure
        // we still leave it; the dispatch short-circuits and the next dispatch's
        // unique guid path + /tmp churn bound the leftover.
        if arc != 0 { return "git apply failed (patch does not apply to base)" }
    }

    return ""
}

// _patch_path_for(guid) — the per-dispatch decoded-patch temp path. Mirrors the
// pf built in _prepare_tree, so handle_dispatch can hand it to the veto and then
// clean it up. "" guid → "" (no patch scanned).
_patch_path_for(guid: string, patch_b64: string) {
    if string.length(patch_b64) == 0 { return "" }
    return string.concat("/tmp/aeb-agent-patch-", string.concat(guid, ".diff"))
}

// _maybe_veto_build(repo, target, purpose) — the agent's OWN gate, run
// after the tree is prepared and BEFORE the build. Returns "" to allow,
// or a non-empty reason to VETO (refuse to build). This is the agent
// exercising sovereign policy over what it will run — distinct from the
// orchestrator and from whether the build would pass.
//
// Walking skeleton: a single, conservative example veto (reject a tree
// that contains an obvious committed secret marker) to prove the
// architecture. The real design is a PLUGGABLE three-tier list — see
// docs/veto-alternates.md:
//   A. tree scan (NOW: pluggable rule list)  — cheap, raw tree + patch
//   B. resolved-coordinate / SBOM    — dependency CVE/OWASP (design)
//   C. doppelganger-compile trace    — build-grammar intent via a
//      `--lib <doppelganger>` swap recording os.system/dep/link_flag
//      instead of executing (the Action!/tsyne-designer trick; design)
// CRITICAL scope: these guard BUILD-GRAMMAR escapes (what the .build.ae
// orchestration does), NOT the application being built. A clean veto is
// not a clean program — see the SCOPE section of the doc. Veto rules are
// the agent operator's policy, not the requester's.
//
// Tier A is now a data-driven rule list in lib/agent (_veto_run_rules): built-in
// secret/banned-marker rules + operator extras via AEB_AGENT_VETO_PATTERNS, each
// scoped to the whole tree or to the applied patch specifically (the
// highest-signal target — the untrusted delta introduced the hit). patch_path is
// the decoded patch left by _prepare_tree ("" when the dispatch carried none).
_maybe_veto_build(repo: string, target: string, purpose: string, patch_path: string) {
    return _veto_run_rules(repo, patch_path)
}

handle_dispatch(req: ptr, res: ptr, ud: ptr) {
    body = http.request_body(req)
    guid = _json_field(body, "guid")
    target = _json_field(body, "target")
    purpose = _json_field(body, "purpose")
    if string.length(purpose) == 0 { purpose = "preint" }

    // --- Naive token gate (fail-closed) — BEFORE the scope decision. ---
    // No --tokens file => refuse ALL dispatches. With a file => the
    // presented X-AEB-Token (or Authorization: Bearer) must be in it.
    if _authed(req) == 0 {
        println("agent: REFUSE guid=${guid} (no/bad token; fail-closed)")
        http.response_set_status(res, 401)
        http.response_set_header(res, "Content-Type", "application/json")
        http.response_set_body(res, dispatch_reply_json(guid, "rejected", ""))
        return 0
    }

    scope = _scope_from_env()
    decision = _decision(scope, purpose, 0)

    if string.equals(decision, "reject") == 1 {
        println("agent: REJECT guid=${guid} purpose=${purpose} (out of scope)")
        http.response_set_status(res, 403)
        http.response_set_header(res, "Content-Type", "application/json")
        http.response_set_body(res, dispatch_reply_json(guid, "rejected", ""))
        return 0
    }
    if string.equals(decision, "busy") == 1 {
        println("agent: BUSY guid=${guid} (no free slot)")
        http.response_set_status(res, 503)
        http.response_set_header(res, "Content-Type", "application/json")
        http.response_set_body(res, dispatch_reply_json(guid, "busy", ""))
        return 0
    }

    // accept → prepare the tree, then run aeb <target>.
    workdir = os.getenv("AEB_AGENT_WORKDIR")
    if string.length(workdir) == 0 { workdir = "." }
    repo = os.getenv("AEB_AGENT_REPO")
    if string.length(repo) == 0 { repo = workdir }
    println("agent: ACCEPT guid=${guid} purpose=${purpose} target=${target}")

    // --- Prepare (wire ops, the agent's own lifecycle — NOT build grammar):
    //   1. git fetch origin <ref> && git checkout <hash>  (fetch-base)
    //   2. git apply <patch>                              (pre-integration delta)
    //   3. maybe_veto_build                               (agent's OWN gate)
    // Each step can fail/veto and short-circuit BEFORE the build runs. ---
    gref = _json_field(body, "ref")
    ghash = _json_field(body, "hash")
    patch_b64 = _json_field(body, "patch_b64")

    prep_err = _prepare_tree(guid, repo, gref, ghash, patch_b64)
    if string.length(prep_err) > 0 {
        println("agent: PREP-FAILED guid=${guid} (${prep_err})")
        http.response_set_status(res, 409)
        http.response_set_header(res, "Content-Type", "application/json")
        http.response_set_body(res, dispatch_reply_json(guid, "prep-failed", ""))
        return 0
    }

    // maybe_veto_build — the agent decides, on ITS OWN authority, whether
    // to build the prepared tree. Independent of whether the build would
    // succeed. A vetoed dispatch is NOT a build failure — it's a refusal.
    // The decoded patch (left by _prepare_tree) is scanned by patch-scope
    // rules, then removed regardless of outcome.
    patch_path = _patch_path_for(guid, patch_b64)
    veto = _maybe_veto_build(repo, target, purpose, patch_path)
    if string.length(patch_path) > 0 {
        os.system(string.concat("rm -f '", string.concat(patch_path, "'")))
    }
    if string.length(veto) > 0 {
        println("agent: VETOED guid=${guid} (${veto})")
        http.response_set_status(res, 422)
        http.response_set_header(res, "Content-Type", "application/json")
        http.response_set_body(res, dispatch_reply_json(guid, "vetoed", ""))
        return 0
    }

    // Run the build, but DON'T throw away what it did — inform the developer.
    // aeb already produces structured output if asked: AEB_ARTIFACTS_JSON
    // lists what landed in target/ (the answer to "what got built"),
    // AEB_TELEMETRY_JSON the per-module timing. Point both at per-guid temp
    // files, tee stdout+stderr to a log, and keep os.system for the EXIT CODE
    // (os.exec swallows it). Then fold log-tail + artifacts into the reply so
    // a `result:fail` says WHY and a `result:pass` says WHAT was produced.
    artifacts_path = string.concat(string.concat("/tmp/aeb-agent-", guid), ".artifacts.json")
    log_path = string.concat(string.concat("/tmp/aeb-agent-", guid), ".log")
    _ea = os.setenv("AEB_ARTIFACTS_JSON", artifacts_path)

    cmd = "cd '${workdir}' && aeb '${target}' > '${log_path}' 2>&1"
    rc = os.system(cmd)

    result = "pass"
    if rc != 0 { result = "fail" }

    // Read back what the build told us (best-effort; absent files → empty).
    // Pass aeb's RAW {"artifacts":[...]} body straight to the reply builder,
    // which parses it with std.json (no string surgery here).
    artifacts_body = ""
    if file.exists(artifacts_path) == 1 {
        aj_raw, _aje = io.read_file(artifacts_path)
        artifacts_body = aj_raw
    }
    log_tail = ""
    if file.exists(log_path) == 1 {
        log_tail = _tail_capture(log_path, 40)
    }
    // Tidy the per-guid temp files now that we've read them.
    os.system(string.concat("rm -f '", string.concat(artifacts_path, string.concat("' '", string.concat(log_path, "'")))))

    println("agent: DONE guid=${guid} result=${result} (rc=${rc})")
    http.response_set_status(res, 200)
    http.response_set_header(res, "Content-Type", "application/json")
    http.response_set_body(res, _dispatch_reply_rich(guid, "done", result, artifacts_body, log_tail))
    return 0
}

// _tail_capture(path, n) — last n lines of the build log, shelled out (tail
// is simplest + robust for an arbitrarily large log). Returns "" on failure.
_tail_capture(path: string, n: int) {
    tmp = string.concat(path, ".tail")
    _r = os.system(string.concat(string.concat("tail -n ", string.from_int(n)), string.concat(string.concat(" '", path), string.concat("' > '", string.concat(tmp, "' 2>/dev/null")))))
    out = ""
    if file.exists(tmp) == 1 {
        out_raw, _e = io.read_file(tmp)
        out = out_raw
        os.system(string.concat("rm -f '", string.concat(tmp, "'")))
    }
    return out
}

// _dispatch_reply_rich(guid, status, result, artifacts_body, log) — the
// "inform the developer" reply: the terse verdict PLUS what got built
// (the artifacts array, lifted straight from aeb's AEB_ARTIFACTS_JSON) and a
// log tail (so a fail says why, a pass says what). Built with std.json, so
// the log's arbitrary build output is escaped correctly and the artifacts
// nest as a real JSON value — no hand-rolled string surgery. The skinny
// dispatch_reply_json (in lib/agent) stays for the policy-class "skinny
// callback + details_url" path.
//
// artifacts_body is aeb's raw {"artifacts":[...]} file content (or "" if the
// build wrote none). We parse it and graft its "artifacts" array onto our
// reply; a parse failure / absent file degrades to an empty array.
_dispatch_reply_rich(guid: string, status: string, result: string, artifacts_body: string, log: string) {
    reply_obj = json.create_object()
    _s1 = json.object_set(reply_obj, "guid", json.create_string(guid))
    _s2 = json.object_set(reply_obj, "status", json.create_string(status))
    _s3 = json.object_set(reply_obj, "result", json.create_string(result))
    _s4 = json.object_set(reply_obj, "log", json.create_string(log))

    // Lift the artifacts array out of aeb's wrapper object, if present.
    arts = json.create_array()
    if string.length(artifacts_body) > 0 {
        parsed, perr = json.parse(artifacts_body)
        if string.length(perr) == 0 {
            inner, _ge = json.object_get(parsed, "artifacts")
            if inner != null {
                // Re-home each element onto our owned array (the parsed
                // tree is freed below; array_add takes ownership, so we
                // copy via stringify/parse-free-of-ownership avoidance:
                // simplest is to move the whole parsed array by detaching).
                m = json.array_size(inner)
                k = 0
                while k < m {
                    el, _ae = json.array_get(inner, k)
                    if el != null {
                        // Deep-copy the element by round-tripping its text,
                        // so freeing `parsed` doesn't invalidate our array.
                        el_txt, _se = json.stringify(el)
                        el_copy, _pe = json.parse(el_txt)
                        if el_copy != null { _aa = json.array_add(arts, el_copy) }
                    }
                    k = k + 1
                }
            }
            json.free(parsed)
        }
    }
    _s5 = json.object_set(reply_obj, "artifacts", arts)

    body, _serr = json.stringify(reply_obj)
    json.free(reply_obj)
    return body
}

handle_health(req: ptr, res: ptr, ud: ptr) {
    http.response_set_status(res, 200)
    http.response_set_body(res, "ok")
    return 0
}

// Run the blocking server loop off an actor, mirroring the stdlib
// integration-test idiom (a plain call to http_server_start_raw in main
// ties up the scheduler before the bind is observable).
message StartSrv { raw: ptr }
actor SrvActor {
    state s = 0
    receive { StartSrv(raw) -> { s = raw; http_server_start_raw(raw) } }
}

main() {
    argc = aether_args_count()
    port = 9440
    host = "127.0.0.1"
    scope_name = "preint"
    accept_glob = "preint/*"
    max_jobs = 0
    workdir = "."
    repo_dir = ""
    tokens_file = ""

    i = 1
    while i < argc {
        a = aether_args_get(i)
        // --help / -h / unknown flag: print usage and EXIT — do NOT fall
        // through to starting the server (that footgun hung a container
        // build when `aeb-agent --help` silently launched with defaults).
        if string.equals(a, "--help") == 1 { _usage(); exit(0) }
        if string.equals(a, "-h") == 1 { _usage(); exit(0) }
        if string.equals(a, "--port") == 1 { i = i + 1; port = _atoi(aether_args_get(i)) }
        if string.equals(a, "--host") == 1 { i = i + 1; host = aether_args_get(i) }
        if string.equals(a, "--scope") == 1 { i = i + 1; scope_name = aether_args_get(i) }
        if string.equals(a, "--accept") == 1 { i = i + 1; accept_glob = aether_args_get(i) }
        if string.equals(a, "--max-jobs") == 1 { i = i + 1; max_jobs = _atoi(aether_args_get(i)) }
        if string.equals(a, "--workdir") == 1 { i = i + 1; workdir = aether_args_get(i) }
        if string.equals(a, "--repo") == 1 { i = i + 1; repo_dir = aether_args_get(i) }
        if string.equals(a, "--tokens") == 1 { i = i + 1; tokens_file = aether_args_get(i) }
        i = i + 1
    }
    // --repo defaults to --workdir (the agent's clone IS the build dir
    // unless an operator separates them).
    if string.length(repo_dir) == 0 { repo_dir = workdir }

    // Publish the single scope's config to the env the handler reads.
    _e1 = os.setenv("AEB_AGENT_ACCEPT", accept_glob)
    if max_jobs > 0 { _e2 = os.setenv("AEB_AGENT_MAX_JOBS", string.from_int(max_jobs)) }
    _e3 = os.setenv("AEB_AGENT_WORKDIR", workdir)
    _e3b = os.setenv("AEB_AGENT_REPO", repo_dir)
    if string.length(tokens_file) > 0 { _e4 = os.setenv("AEB_AGENT_TOKENS", tokens_file) }

    // Fail-closed auth posture announcement. Distinguish the three
    // operator-visible states so a MISCONFIGURATION (unreadable mount)
    // doesn't masquerade as intended fail-closed:
    //   - no --tokens          → intended: no auth configured
    //   - --tokens, unreadable → likely a bad mount / permissions /
    //     SELinux (on Fedora-atomic e.g. Bazzite, a bind mount needs :Z)
    //   - --tokens, N tokens   → armed
    if string.length(tokens_file) == 0 {
        println("aeb-agent: no --tokens given; REFUSING ALL dispatches (fail-closed). Pass --tokens <file> to enable.")
    } else {
        probe, perr = io.read_file(tokens_file)
        if string.length(perr) > 0 {
            println("aeb-agent: --tokens file UNREADABLE: ${tokens_file} (${perr})")
            println("aeb-agent:   REFUSING ALL dispatches. Check the file exists, is readable, and — for a")
            println("aeb-agent:   container bind mount on SELinux (Bazzite/Fedora) — was mounted with :Z, e.g.")
            println("aeb-agent:   -v host/agent.tokens:${tokens_file}:ro,Z")
        } else {
            ntok = map.size(_parse_tokens(probe))
            println("aeb-agent: --tokens loaded ${ntok} token(s) from ${tokens_file}")
        }
    }

    raw = http.server_create(port)
    if raw == 0 { println("aeb-agent: FAIL server_create"); exit(1) }
    http.server_set_host(raw, host)
    http.server_post(raw, "/dispatch", handle_dispatch, 0)
    http.server_get(raw, "/ping", handle_ping, 0)
    http.server_get(raw, "/health", handle_health, 0)

    mj_disp = "unbounded"
    if max_jobs > 0 { mj_disp = string.from_int(max_jobs) }
    println("aeb-agent: listening on ${host}:${port} scope=${scope_name} accept=${accept_glob} max_jobs=${mj_disp} workdir=${workdir}")

    // Distinct name: `a` was the arg-loop string above; reusing it for the
    // actor handle is a const-char*-vs-actor* type conflict that a strict
    // gcc (e.g. Debian's, -Wincompatible-pointer-types as an error) rejects.
    srv = spawn(SrvActor())
    srv ! StartSrv { raw: raw }
    sleep(86400000)
    exit(0)
}

_usage() {
    println("aeb-agent — remote build agent (listens for dispatch requests)")
    println("")
    println("Usage: aeb-agent [options]")
    println("  --host H        bind address (default 127.0.0.1; use 0.0.0.0 to be reachable off-box)")
    println("  --port N        listen port (default 9440)")
    println("  --accept GLOB   purpose scope to accept (default 'preint/*')")
    println("  --workdir DIR   directory the agent runs builds in (default '.')")
    println("  --max-jobs N    concurrent job cap (default unbounded)")
    println("  --tokens FILE   bearer-token file; WITHOUT it the agent refuses ALL dispatches (fail-closed)")
    println("  --scope NAME    scope label for display (default 'preint')")
    println("  -h, --help      this message")
    println("")
    println("Endpoints: GET /health (open), GET /ping (auth), POST /dispatch (auth)")
}

_atoi(s: string) {
    n = string.length(s)
    if n == 0 { return 0 }
    i = 0
    v = 0
    digits = "0123456789"
    while i < n {
        c = string.substring(s, i, i + 1)
        d = string.index_of(digits, c)
        if d < 0 { return v }
        v = v * 10 + d
        i = i + 1
    }
    return v
}
