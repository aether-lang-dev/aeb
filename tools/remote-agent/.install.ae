// Install BOTH the remote-build-agent capability in one step: the agent (the
// verifier/listener) AND aeb-lease (the lessor-side token minter). They're a
// pair — an agent without a way to mint leases is unusable, and minting without
// an agent to present to is pointless — so this is the convenient single target
// the `make install` hint points at:
//
//   aeb tools/remote-agent/.install.ae    # → ~/.local/bin/{aeb-agent, aeb-lease, aeb-keygen}
//
// It just deps the three existing per-tool installers; aeb's DAG builds + places
// all of them. (The individual targets tools/agent/.install.ae,
// tools/lease/.install.ae and tools/keygen/.install.ae still work if you want
// only one.) Opt-in like its parts — NOT wired into `make` (a network server,
// a credential minter, and a secret generator are deliberate installs, not core
// build machinery).
import bldr
import bldr (dep)

extern println(s: string)

main() {
    b = bldr.start()
    dep(b, "tools/agent/.install.ae")
    dep(b, "tools/lease/.install.ae")
    dep(b, "tools/keygen/.install.ae")
    println("remote-agent: installed aeb-agent (verifier) + aeb-lease (minter) + aeb-keygen (secret gen).")
    println("  make a secret:   mkdir -p ~/.local/share/aeb && aeb-keygen > ~/.local/share/aeb/lease.secret")
    println("                   chmod 600 ~/.local/share/aeb/lease.secret")
    println("  start an agent:  aeb-agent --lease-secrets <file> --accept 'preint/*' ...")
    println("  mint a lease:    aeb-lease  --secret <file> --purpose preint/<scope> --ttl-mins 30")
    return 0
}
