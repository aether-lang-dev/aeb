// Dogfood: build the aeb-agent binary WITH aeb (aether.program), rather
// than `ae build`. aeb building its own satellite — exercises the
// aether.program shell-out path on a real multi-import Aether program
// (the agent imports the `agent` SDK from lib/ + std.http.client).
//
// This is the HUMAN-run path, NOT wired into `make`. `make install` does
// not build the agent at all (it's an opt-in network server); `make
// install-agent` builds it via `ae build --lib lib` (bootstrap-safe, no
// aeb recursion). This .build.ae is the alternative once a working aeb
// exists:
//
//   aeb tools/agentbuild/.build.ae      # → target/tools/agentbuild/bin/aeb-agent
//
// Output lands under target/ (aeb's convention); copy it to where the
// aeb-agent wrapper expects, or run the target/ binary directly.
import build
import aether
import aether (source, output)
main() {
    b = build.start()
    aether.program(b) {
        source("../aeb-agent.ae")
        output("aeb-agent")
    }
}
