// aeb-graph — render the build-file DAG as DOT or Mermaid.
//
// Reads an edges file in the same format aeb-main writes
// (target/_aeb/_edges.txt) — one line per build file, formatted as
// `<file> <space-separated dep paths>`. Emits a graph description on
// stdout suitable for piping to graphviz (`dot -Tsvg`) or pasting into
// a Markdown file (Mermaid mode renders inline on GitHub).
//
// Usage: aeb-graph <edges-file> [dot|mermaid]
//
// Default format is DOT. `mermaid` emits a `graph TD` Mermaid flowchart.
//
// Pure helpers (node_id, mermaid_id, dot_render, mermaid_render) are
// covered by tests/test_aeb_graph.ae.

import std.string
import std.file
import std.fs
import std.io
import std.os
import std.list
import std.map
import std.path
import std.strbuilder

extern println(s: string)
extern exit(code: int)

// Convert a file path to a DOT-safe identifier. DOT IDs containing /
// or . need quoting; the simplest safe form is to wrap in double
// quotes and escape any embedded quotes (rare in build paths).
node_id(path: string) {
    return string.concat(string.concat("\"", path), "\"")
}

// Convert a file path to a Mermaid-safe identifier. Mermaid IDs are
// strict: no /, no ., no -. Replace each disallowed char with _.
// The display label is rendered separately via id["label"] so the
// munged ID is only ever a graph internal.
mermaid_id(path: string) {
    n = string.length(path)
    sb = strbuilder.new(n + 1)
    i = 0
    while i < n {
        ch = string.substring(path, i, i + 1)
        if string.equals(ch, "/") == 1 {
            strbuilder.append(sb, "_")
        } else {
            if string.equals(ch, ".") == 1 {
                strbuilder.append(sb, "_")
            } else {
                if string.equals(ch, "-") == 1 {
                    strbuilder.append(sb, "_")
                } else {
                    strbuilder.append(sb, ch)
                }
            }
        }
        i = i + 1
    }
    return strbuilder.finish(sb)
}

// Split a buffer on '\n' into a list. Trailing empty line ignored.
_split_lines(buf: string) {
    lines = list.new()
    n = string.length(buf)
    start = 0
    i = 0
    while i < n {
        ch = string.substring(buf, i, i + 1)
        if string.equals(ch, "\n") == 1 {
            line = string.substring(buf, start, i)
            list.add(lines, line)
            start = i + 1
        }
        i = i + 1
    }
    if start < n {
        list.add(lines, string.substring(buf, start, n))
    }
    return lines
}

// Split a single edges line "<file> <dep1> <dep2> ..." into a list.
// First token is the source; remainder are deps. Returns the list
// (always at least one element if the line is non-empty).
_split_tokens(line: string) {
    tokens = list.new()
    n = string.length(line)
    start = 0
    i = 0
    while i < n {
        ch = string.substring(line, i, i + 1)
        if string.equals(ch, " ") == 1 {
            if i > start {
                list.add(tokens, string.substring(line, start, i))
            }
            start = i + 1
        }
        i = i + 1
    }
    if start < n {
        list.add(tokens, string.substring(line, start, n))
    }
    return tokens
}

// Walk the parsed edges and collect every node that appears either
// as a source (line head) or a referenced dep. Used for the node-
// declaration section of the graph (Mermaid needs explicit nodes
// with display labels; DOT can also use them but doesn't require it).
_collect_nodes(edges_text: string) {
    nodes = list.new()
    seen = map.new()
    lines = _split_lines(edges_text)
    n = list.size(lines)
    i = 0
    while i < n {
        line, _ = list.get(lines, i)
        if string.length(line) > 0 {
            tokens = _split_tokens(line)
            tn = list.size(tokens)
            j = 0
            while j < tn {
                tok, _ = list.get(tokens, j)
                if map.has(seen, tok) == 0 {
                    list.add(nodes, tok)
                    map.put(seen, tok, "1")
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    return nodes
}

// Render the edges text as a DOT digraph. Output is a complete file
// _dot_fill(status) — the `[style=filled, fillcolor=...]` attribute for a DOT
// node, matching the mermaid palette: ok green / fail red / uninvoked grey.
// Empty string for an unknown status (leaves the node unstyled).
_dot_fill(status: string) {
    if string.equals(status, "ok") == 1 { return " [style=filled, fillcolor=\"#c6f6d5\"]" }
    if string.equals(status, "fail") == 1 { return " [style=filled, fillcolor=\"#fed7d7\"]" }
    if string.equals(status, "uninvoked") == 1 { return " [style=filled, fillcolor=\"#edf2f7\", fontcolor=\"#a0aec0\", color=\"#a0aec0\"]" }
    return ""
}

// (digraph + brace block + nodes + edges + closing brace) suitable for
// piping to graphviz `dot`. Nodes are explicitly declared (DOT would
// auto-declare from edge usage, but explicit lines make per-node
// styling/attribute additions trivial later).
//
// rc_dir: same contract as mermaid_render — when non-empty, each node gets a
// fillcolor from this run's outcome (ok/fail/uninvoked, read from the driver's
// <san>.rc markers), so the SVG/PNG shows executed paths vs muted parsed-only
// deps just like the inline mermaid. Empty rc_dir → plain uncoloured DOT
// (backward-compatible).
dot_render(edges_text: string, rc_dir: string) {
    sb = strbuilder.new(1024)
    strbuilder.append(sb, "digraph aeb {\n")
    strbuilder.append(sb, "  rankdir=LR;\n")
    strbuilder.append(sb, "  node [shape=box, fontname=\"Helvetica\"];\n")

    color_on = 0
    if string.length(rc_dir) > 0 { color_on = 1 }

    nodes = _collect_nodes(edges_text)
    nn = list.size(nodes)
    k = 0
    while k < nn {
        node, _ = list.get(nodes, k)
        strbuilder.append(sb, "  ")
        strbuilder.append(sb, node_id(node))
        if color_on == 1 {
            strbuilder.append(sb, _dot_fill(_node_status(rc_dir, node)))
        }
        strbuilder.append(sb, ";\n")
        k = k + 1
    }

    lines = _split_lines(edges_text)
    n = list.size(lines)
    i = 0
    while i < n {
        line, _ = list.get(lines, i)
        if string.length(line) > 0 {
            tokens = _split_tokens(line)
            tn = list.size(tokens)
            if tn >= 1 {
                src, _ = list.get(tokens, 0)
                src_id = node_id(src)
                j = 1
                while j < tn {
                    dep, _ = list.get(tokens, j)
                    strbuilder.append(sb, "  ")
                    strbuilder.append(sb, src_id)
                    strbuilder.append(sb, " -> ")
                    strbuilder.append(sb, node_id(dep))
                    strbuilder.append(sb, ";\n")
                    j = j + 1
                }
            }
        }
        i = i + 1
    }
    strbuilder.append(sb, "}\n")
    return strbuilder.finish(sb)
}

// _san(s) — map any string to a flat [alnum._-] token (others -> '_').
// MUST match tools/aeb-driver.ae's _san so a node path resolves to the same
// `<san>.rc` filename the driver wrote for it.
_san(s: string) {
    keep = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.-"
    out = ""
    n = string.length(s)
    i = 0
    while i < n {
        ch = string.substring(s, i, i + 1)
        if string.index_of(keep, ch) >= 0 { out = string.concat(out, ch) }
        else { out = string.concat(out, "_") }
        i = i + 1
    }
    return out
}

// _node_status(rc_dir, node) — this run's outcome for a build-file node, read
// from the driver's per-node `.rc` marker (0 = ok, non-zero = fail; ABSENT =
// the node was NOT part of this invocation). Returns "ok" / "fail" /
// "uninvoked". rc_dir empty => always "uninvoked" (a static graph, no run).
_node_status(rc_dir: string, node: string) {
    if string.length(rc_dir) == 0 { return "uninvoked" }
    rcf = path.join(rc_dir, string.concat(_san(node), ".rc"))
    if file.exists(rcf) == 0 { return "uninvoked" }
    rc, _e = fs.read(rcf)
    if string.equals(string.trim(rc), "0") == 1 { return "ok" }
    return "fail"
}

// Render the edges text as a Mermaid flowchart. Output is a complete
// `graph TD` block suitable for embedding in a Markdown ```mermaid
// fence. Node IDs are munged (no / or . allowed); display labels
// preserve the original path via `id["path"]` declarations.
//
// rc_dir: when non-empty, each node is CLASSED by this run's outcome (read from
// the driver's <san>.rc markers) — invoked-ok / invoked-fail / uninvoked — and
// classDefs are emitted so the graph shows what THIS `aeb <target>` (or
// `--since`) actually touched vs the rest of the static tree. Empty rc_dir
// reproduces the plain, uncolored graph (backward-compatible).
mermaid_render(edges_text: string, rc_dir: string) {
    sb = strbuilder.new(1024)
    strbuilder.append(sb, "graph TD\n")

    // classDefs (only meaningful when rc_dir is set, but harmless if unused).
    color_on = 0
    if string.length(rc_dir) > 0 { color_on = 1 }
    if color_on == 1 {
        strbuilder.append(sb, "    classDef ok fill:#c6f6d5,stroke:#276749,color:#1a202c\n")
        strbuilder.append(sb, "    classDef fail fill:#fed7d7,stroke:#9b2c2c,color:#1a202c\n")
        strbuilder.append(sb, "    classDef uninvoked fill:#edf2f7,stroke:#a0aec0,color:#a0aec0\n")
    }

    // Emit node declarations with display labels first, so the
    // edges below render against named nodes rather than introducing
    // anonymous ones with no label.
    nodes = _collect_nodes(edges_text)
    nn = list.size(nodes)
    k = 0
    while k < nn {
        node, _ = list.get(nodes, k)
        strbuilder.append(sb, "    ")
        strbuilder.append(sb, mermaid_id(node))
        strbuilder.append(sb, "[\"")
        strbuilder.append(sb, node)
        strbuilder.append(sb, "\"]")
        if color_on == 1 {
            strbuilder.append(sb, ":::")
            strbuilder.append(sb, _node_status(rc_dir, node))
        }
        strbuilder.append(sb, "\n")
        k = k + 1
    }

    lines = _split_lines(edges_text)
    n = list.size(lines)
    i = 0
    while i < n {
        line, _ = list.get(lines, i)
        if string.length(line) > 0 {
            tokens = _split_tokens(line)
            tn = list.size(tokens)
            if tn >= 1 {
                src, _ = list.get(tokens, 0)
                src_id = mermaid_id(src)
                j = 1
                while j < tn {
                    dep, _ = list.get(tokens, j)
                    strbuilder.append(sb, "    ")
                    strbuilder.append(sb, src_id)
                    strbuilder.append(sb, " --> ")
                    strbuilder.append(sb, mermaid_id(dep))
                    strbuilder.append(sb, "\n")
                    j = j + 1
                }
            }
        }
        i = i + 1
    }
    return strbuilder.finish(sb)
}

main() {
    argc = aether_args_count()
    if argc < 2 {
        println("Usage: aeb-graph <edges-file> [dot|mermaid]")
        exit(1)
    }
    edges_path = aether_args_get(1)
    format = "dot"
    if argc >= 3 {
        f = aether_args_get(2)
        if string.length(f) > 0 { format = f }
    }
    // Optional 4th positional: an rc-dir (target/.aeb/rc) from a completed run.
    // When given (mermaid only), nodes are colored by this run's outcome —
    // invoked-ok / invoked-fail / uninvoked (see mermaid_render). Absent =
    // today's plain static graph.
    rc_dir = ""
    if argc >= 4 {
        rc_dir = aether_args_get(3)
    }

    edges_text, _err = fs.read(edges_path)
    if string.length(edges_text) == 0 {
        println("aeb-graph: no edges to render (empty or missing edges file)")
        exit(1)
    }

    out = ""
    if string.equals(format, "mermaid") == 1 {
        out = mermaid_render(edges_text, rc_dir)
    } else {
        if string.equals(format, "dot") == 1 {
            out = dot_render(edges_text, rc_dir)
        } else {
            println(string.concat("aeb-graph: unknown format: ", format))
            exit(1)
        }
    }
    println(out)
}
