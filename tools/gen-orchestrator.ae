// gen-orchestrator — generates the _orchestrator.ae source from a sorted file list
//
// Usage: ae run tools/gen-orchestrator.ae -- file1.ae file2.ae ...
// Output: orchestrator .ae source to stdout
//
// Each argument is a sorted .ae file path. The tool generates:
// - extern declarations for each module function
// - main() that calls them in order with build_session/build_done

import std.string
import std.os

// Label / tag derivation comes from the shared aeblabel module
// (built with `--lib tools`) — the single source of truth, so this
// tool can never drift from tools/file-to-label.ae or aeb-link.ae.
import aeblabel (file_to_label, infer_type, encode_name)

// encode_name + its replace-all helper come from aeblabel too (imported
// above). They were local copies named `string_replace_all` — which
// collides with a C symbol std.string gained in aether 0.463.0, a hard
// link error. The Windows rationale for keeping them shell-free (a
// `printf | sed` shell-out returns empty under cmd.exe, yielding an
// unparseable orchestrator) moved with them.



main() {
    argc = aether_args_count()
    if argc < 2 {
        println("Usage: ae run tools/gen-orchestrator.ae -- file1.ae file2.ae ...")
        exit(1)
    }

    // Header. The orchestrator imports `build` so it gets its own static
    // copies of bldr.session and bldr.done — each translation unit is
    // self-contained because aetherc emits cloned-from-import functions
    // with C `static` storage class, so the build helpers can no longer
    // be called across TU boundaries via extern. The full std.* import
    // block must be repeated here because `import std.*` scope does not
    // propagate transitively through `import build`.
    println("import bldr")
    println("import std.string")
    println("import std.io")
    println("import std.os")
    println("import std.file")
    println("import std.fs")
    println("import std.list")
    println("import std.map")
    println("import std.path")
    println("import std.dir")
    println("")
    // exit(code) for non-zero termination when a node fails. Declared
    // extern (matching tools/aeb-driver) so the orchestrator can redden
    // the build — see the record_status + any_failed wiring in main().
    println("extern exit(code: int)")
    println("")

    // Extern declarations for all per-module entry points. These ARE
    // cross-TU calls because each user .build.ae compiles to a separate
    // .o whose top-level entry function (e.g. _D_build_D_ae) is NOT
    // marked is_imported and therefore stays externally visible.
    file = ""
    fname = ""
    label = ""
    i = 1
    while i < argc {
        file = aether_args_get(i)
        fname = encode_name(file)
        println("extern ${fname}(s: ptr) -> int")
        i = i + 1
    }
    println("")

    // The per-node bookkeeping (selector gate, rc capture, status, the
    // telemetry record) used to be emitted INLINE for every node: ~360
    // tokens each, so a 138-node fan-out (aether-ui) produced a 49,800-token
    // orchestrator and aetherc's 50,000-token cap on a main file failed the
    // whole build the day one more `.build.ae` was added — "source file
    // exceeds maximum token limit" with no file named, pointing at nothing
    // the author touched. It is emitted ONCE here as two helpers, and each
    // node costs ~35 tokens: the only thing that genuinely differs per node
    // is the extern it calls, which cannot be a value (a fn passed from a
    // separately-compiled TU is DCE'd, aether #2037), so that one call stays
    // inline and everything around it moves here.
    //
    // Same TU as main(), so bldr's cloned-from-import statics are visible.
    println("_aeb_selected(sel: string, label: string) -> int {")
    println("    if string.length(sel) == 0 { return 1 }")
    println("    if string.equals(sel, label) == 1 { return 1 }")
    println("    return 0")
    println("}")
    println("")
    // A non-zero node return that did NOT already go through bldr.fail()
    // (e.g. a custom gate that just `return 1`s) is marked failed here, so
    // both the status/JSON and the any_failed gate in main() see it. The
    // explicit bldr.fail() channel still works and takes precedence (a node
    // that failed via fail() stays failed regardless of its rc). Marked at
    // the SESSION level: bldr.fail() takes a NODE ctx, we hold the session.
    println("_aeb_record(s: ptr, root: string, records: ptr, label: string, type_word: string, nrc: int, start: long) {")
    println("    if nrc != 0 { bldr._mark_failed(s, label, string.concat(\"node returned non-zero rc=\", string.from_int(nrc))) }")
    println("    bldr.done(s, label)")
    println("    end = clock_ns()")
    println("    rec = map.new()")
    println("    map.put(rec, \"label\", label)")
    println("    map.put(rec, \"type\", type_word)")
    println("    map.put(rec, \"wall_ms\", string.from_int((end - start) / 1000000))")
    println("    st = bldr.status_of(s, label)")
    println("    if string.length(st) == 0 { st = \"passed\" }")
    println("    map.put(rec, \"status\", st)")
    // rc reflects the node's logical outcome so the JSON's rc agrees with
    // status (a failed test can't report rc:0). The in-process orchestrator
    // has no child exit code to read — status IS the outcome here — so map
    // failed→1, everything else→0. (The driver's per-node make path reads a
    // real child rc from the .rc marker.)
    println("    rc = \"0\"")
    println("    if string.equals(st, \"failed\") == 1 { rc = \"1\" }")
    println("    map.put(rec, \"rc\", rc)")
    println("    td = bldr._label_to_target_dir(root, label)")
    println("    map.put(rec, \"cache\", bldr._read_cache_outcome(td))")
    // Read the test-result marker for EVERY node — gated at runtime on the
    // marker existing (thr), NOT on the type name. A node whose build wrote
    // pass/fail markers (via a *_test SDK verb) gets the row whatever its
    // filename; one that didn't leaves thr=0 and renders the plain line.
    // No "type == test" inference.
    println("    tp, tf, tsk, thr = bldr._read_test_result(td)")
    println("    if thr == 1 {")
    println("        map.put(rec, \"test_passed\", string.from_int(tp))")
    println("        map.put(rec, \"test_failed\", string.from_int(tf))")
    println("        map.put(rec, \"test_skipped\", string.from_int(tsk))")
    println("        map.put(rec, \"test_has_report\", string.from_int(bldr._read_test_report_flag(td)))")
    println("    }")
    println("    tfn = bldr._read_test_failures(td)")
    println("    if string.length(tfn) > 0 {")
    println("        map.put(rec, \"test_failed_names\", tfn)")
    println("    }")
    println("    list.add(records, rec)")
    println("}")
    println("")

    // main() calls everything in topo order, accumulating per-module
    // telemetry records (label, type, wall_ms, cache outcome). At the
    // end it hands the records list to bldr.render_telemetry for the
    // stdout summary block.
    //
    // Records live only for the orchestrator's lifetime — the
    // in-memory structure IS the storage for now. Future renderers
    // (file dump, web viewer, etc.) plug in here without touching
    // the data model.
    println("main() {")
    println("    s = bldr.session(aether_args_get(1))")
    println("    _root = aether_args_get(1)")
    // Optional per-node selector (nodes-as-subprocesses, slice A): when a
    // second arg is present, run ONLY the node whose label matches it and
    // skip the end-of-run summary (the per-node driver renders). With no
    // selector this is the unchanged all-in-one run.
    println("    _sel = string.concat(\"\", \"\")")
    println("    if aether_args_count() > 2 { _sel = aether_args_get(2) }")
    println("    _records = list.new()")
    println("    _session_start = clock_ns()")

    i = 1
    while i < argc {
        file = aether_args_get(i)
        fname = encode_name(file)
        label = file_to_label(file)
        // The displayed word IS the literal type from the .<type>.ae filename
        // — no inference, no compile/test/dist relabel. .build.ae→build,
        // .install.ae→install, .essais.ae→essais. (The route IS the filename.)
        type = infer_type(file)
        type_word = type
        // Per-node selector gate (slice A): run this node iff no selector
        // was given (all-in-one) or it names this label. Then run the node
        // and CAPTURE its return. This is trustworthy: every SDK builder is
        // declared `: int` (whole-tree sweep) and transform-ae rewrites the
        // node entry to `<fname>(s: ptr): int {`, so a node whose last
        // statement is a bare builder call flows that builder's real rc as
        // its own return — no longer the void-through-`extern -> int`
        // register garbage that forced us to discard it (which in turn let a
        // hand-written node `return 1` exit falsely-green — the presubmit
        // bug, asks/node-nonzero-return-not-propagated-to-exit-code.md).
        println("    if _aeb_selected(_sel, \"${label}\") == 1 {")
        println("        _start = clock_ns()")
        println("        _nrc = ${fname}(s)")
        println("        _aeb_record(s, _root, _records, \"${label}\", \"${type_word}\", _nrc, _start)")
        println("    }")
        i = i + 1
    }

    println("    _session_end = clock_ns()")
    println("    _total_ms = (_session_end - _session_start) / 1000000")
    // Summary + JSON dumps only in all-in-one mode; the per-node driver
    // renders the summary itself from on-disk markers.
    println("    if string.length(_sel) == 0 {")
    println("    _telemetry_json = os.getenv(\"AEB_TELEMETRY_JSON\")")
    println("    if string.length(_telemetry_json) > 0 {")
    println("        _tj_dir = path.dirname(_telemetry_json)")
    println("        if string.length(_tj_dir) > 0 { bldr._mkdirs(_tj_dir) }")
    println("        _tj_body = bldr.render_telemetry_json(_records, _total_ms)")
    println("        _tj_err = fs.write_atomic(_telemetry_json, _tj_body, string.length(_tj_body))")
    println("    }")
    println("    _tests_json = os.getenv(\"AEB_TESTS_JSON\")")
    println("    if string.length(_tests_json) > 0 {")
    println("        _testj_dir = path.dirname(_tests_json)")
    println("        if string.length(_testj_dir) > 0 { bldr._mkdirs(_testj_dir) }")
    println("        _testj_body = bldr.render_tests_json(_records)")
    println("        _testj_err = fs.write_atomic(_tests_json, _testj_body, string.length(_testj_body))")
    println("    }")
    println("    _artifacts_json = os.getenv(\"AEB_ARTIFACTS_JSON\")")
    println("    if string.length(_artifacts_json) > 0 {")
    println("        _artj_dir = path.dirname(_artifacts_json)")
    println("        if string.length(_artj_dir) > 0 { bldr._mkdirs(_artj_dir) }")
    println("        _artj_body = bldr.render_artifacts_json(_root, _records)")
    println("        _artj_err = fs.write_atomic(_artifacts_json, _artj_body, string.length(_artj_body))")
    println("    }")
    println("    println(bldr.render_telemetry(_records, _total_ms))")
    println("    }")
    // NOTE (aeb#9): structured node-failure capture (target/_aeb/_failures.jsonl)
    // is written by aeb-driver, the DEFAULT run path. This all-in-one in-process
    // orchestrator (AEB_IN_PROCESS=1 / AEB_PER_NODE=0) does NOT yet emit it — a
    // follow-up would add the same _failures_jsonl_line append in the loop above
    // where a node's rc/status is known. Kept driver-only for now: #9's
    // acceptance criteria are the driver engines (-jN / native / sequential).
    // Redden the build on any recorded failure. OUTSIDE the _sel guard so
    // it fires in BOTH modes: per-node, this node-subprocess exits
    // non-zero → aeb-driver's rc mark for it is non-zero → the driver's
    // any_failed gate (aeb-driver.ae) catches it; in-process (all-in-one),
    // this is the whole run, so the build exits non-zero directly. A
    // green run still falls through to the implicit 0 return.
    println("    if bldr.any_failed(s) == 1 { exit(1) }")
    println("}")
}
