import bldr
import bldr (dep, dep_artifact)
import java
import java (jar_name, from_classes, main_class)
main() {
    bldr.build() {
        dep("tools/resolver/.build.ae")
        java.package_jar() {
            jar_name("aeb-resolve.jar")
            main_class("aeb.maven.BldResolve")
            from_classes(dep_artifact("tools/resolver/.build.ae", "jvm_classpath_deps_including_transitive"))
        }
    }
}
