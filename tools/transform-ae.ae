// transform-ae — transforms a .build.ae/.tests.ae/.dist.ae for linking
//
// Usage: transform-ae <source> <func_name> <label> <output> <lib_dir> <aeb_home>
//
// Transforms:
// 1. Renames the entrypoint to func_name(s: ptr). The entrypoint may be
//    written either as legacy `main()` or as the modern capability form
//    `aeb(cap)` — both lower to the same context-receiving function (aeb
//    already injects a build context; `cap` is just the nicer spelling for
//    "the handle the trusted host passed in"). The build body uses
//    `build.start()` regardless, so the param NAME the user chose is sugar.
// 2. Replaces build.start() with build.begin(s, "label") + guard
// 3. Strips .ae filenames from dep() references (runtime needs dirs)
// 4. Injects transitive SDK imports at the top

import std.string
import std.io
import std.os
import std.fs
import std.list

// --- Pure-Aether transitive-import resolver (replaces resolve-imports.sh) ---
//
// Was a fork-heavy POSIX bash script (nested `while read` + cmp/cp/sort/comm).
// On Windows, run under os.exec → cmd.exe → MSYS2 sh, its fork storm hit the
// MSYS2 `fork()` emulation failure (`0xC0000142` "child died", then
// `fork: retry: Resource temporarily unavailable` FOREVER) — a hard hang. The
// BFS is trivial, so do it in pure Aether: no shell, no fork, identical on
// every platform.
//
// extract_imports: every `^import <id>` (dotted ok), parens/selectors stripped.
// extract_bare_imports: only `^import <id>$` (the "already covered" set — a
// selective `import foo (sel)` does NOT count as namespace-in-scope, matching
// the old script's rationale for dotted transitive calls).

// One import id from a line, or "" if the line isn't an import. If bare_only,
// a line with anything after the id (parens/selector) yields "".
_import_id(line: string, bare_only: int) {
    pfx = "import "
    if string.index_of(line, pfx) != 0 { return "" }
    rest = string.substring(line, string.length(pfx), string.length(line))
    // id = leading run of [A-Za-z0-9_.]
    idlen = 0
    n = string.length(rest)
    while idlen < n {
        ch = string.substring(rest, idlen, idlen + 1)
        if _is_id_char(ch) == 0 { break }
        idlen = idlen + 1
    }
    if idlen == 0 { return "" }
    id = string.substring(rest, 0, idlen)
    if bare_only == 1 {
        // anything non-empty after the id (e.g. " (sel)") disqualifies it
        tail = string.trim(string.substring(rest, idlen, string.length(rest)))
        if string.length(tail) > 0 { return "" }
    }
    return id
}

_is_id_char(ch: string) {
    if string.equals(ch, ".") == 1 { return 1 }
    if string.equals(ch, "_") == 1 { return 1 }
    // letters/digits: compare via a cheap range check on the single char
    if string.compare(ch, "0") >= 0 { if string.compare(ch, "9") <= 0 { return 1 } }
    if string.compare(ch, "A") >= 0 { if string.compare(ch, "Z") <= 0 { return 1 } }
    if string.compare(ch, "a") >= 0 { if string.compare(ch, "z") <= 0 { return 1 } }
    return 0
}

// Append each `import` id found in file `path` to `acc`. bare_only filters to
// parens-free imports. Dedup is the caller's job (via _seen_has).
_collect_imports(path: string, bare_only: int, acc: ptr) {
    raw, rerr = io.read_file(path)
    if rerr != "" { return }
    rest = raw
    while string.length(rest) > 0 {
        nl = string.index_of(rest, "\n")
        line = ""
        if nl < 0 { line = rest  rest = "" }
        else { line = string.substring(rest, 0, nl)  rest = string.substring(rest, nl + 1, string.length(rest)) }
        id = _import_id(string.trim(line), bare_only)
        if string.length(id) > 0 { list.add(acc, id) }
    }
}

_seen_has(seen: ptr, v: string) {
    n = list.size(seen)
    i = 0
    while i < n {
        e, _ = list.get(seen, i)
        if string.equals(e, v) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

// Resolve transitive imports of <src> against <lib_dir>. Returns a newline-
// joined block of `import X` lines for every transitively-reached module that
// <src> does NOT already cover with a bare import. Pure; no shell.
_resolve_imports(src: string, lib_dir: string) {
    seen = list.new()       // every import id reached (BFS frontier + visited)
    direct = list.new()     // src's BARE imports (the "already covered" set)
    _collect_imports(src, 0, seen)
    _collect_imports(src, 1, direct)

    // Fixed-point BFS: expand each seen module's own imports until stable.
    // `cursor` marks how far we've expanded; new ids appended past it are
    // processed on the next sweep. Terminates because ids are deduped into
    // `seen` and the module set is finite.
    cursor = 0
    while cursor < list.size(seen) {
        mod, _ = list.get(seen, cursor)
        cursor = cursor + 1
        mf = string.concat(lib_dir, string.concat("/", string.concat(mod, "/module.ae")))
        if fs.exists(mf) == 0 { continue }
        mods = list.new()
        _collect_imports(mf, 0, mods)
        mn = list.size(mods)
        j = 0
        while j < mn {
            m, _ = list.get(mods, j)
            j = j + 1
            if _seen_has(seen, m) == 0 { list.add(seen, m) }
        }
    }

    // Emit seen modules not in the direct (bare) set.
    out = ""
    sn = list.size(seen)
    k = 0
    while k < sn {
        m, _ = list.get(seen, k)
        k = k + 1
        if _seen_has(direct, m) == 0 {
            if string.length(out) > 0 { out = string.concat(out, "\n") }
            out = string.concat(out, string.concat("import ", m))
        }
    }
    return out
}

// --- POSIX-shell-on-Windows chokepoint (mirrors tools/aeb-link.ae) ---
//
// transform-ae's transforms are POSIX shell pipelines: `sed -f script src >
// out`, a bash helper script (resolve-imports.sh), and `printf | cat - | mv`.
// On Windows os.system/os.exec route through cmd.exe, which can't run any of
// them — the `resolve-imports.sh` invocation in particular HANGS (cmd.exe
// can't execute a .sh). A MinGW box always has `sh`, so wrap each command
// `sh -c '<cmd>'` (passthrough on POSIX). Caret-escape cmd.exe's metachars
// (> < & | ^) so they survive the cmd.exe layer and reach sh as redirects.
// Hardened temp-script chokepoint (mirrors lib/build._sh and aeb-link): write
// the raw command to a %TMP% .sh via Aether io, run `sh <nativepath>`. cmd.exe
// only ever sees `sh C:/.../x.sh`, so any quoting/redirect/space in the command
// survives intact. POSIX = passthrough.
_is_windows_tr() {
    if os.platform() == "windows" { return 1 }
    return 0
}
_slashes_tr(s: string) {
    out = ""
    rest = s
    while string.length(rest) > 0 {
        ch = string.substring(rest, 0, 1)
        rest = string.substring(rest, 1, string.length(rest))
        if string.equals(ch, "\\") == 1 { out = string.concat(out, "/") }
        else { out = string.concat(out, ch) }
    }
    return out
}
_hash_tr(s: string) {
    h = 5381
    rest = s
    while string.length(rest) > 0 {
        c = string.char_at(rest, 0)
        rest = string.substring(rest, 1, string.length(rest))
        h = ((h * 33) + c) & 2147483647
    }
    return h
}
// Native-form Windows absolute path (drive letter / UNC).
_is_abs_native_tr(p: string) {
    if string.length(p) < 2 { return 0 }
    if string.equals(string.substring(p, 0, 2), "\\\\") == 1 { return 1 }
    if string.equals(string.substring(p, 1, 2), ":") == 1 { return 1 }
    return 0
}
// Native form of a POSIX/MSYS path via cygpath run INSIDE sh (reliable where a
// bare os.exec cygpath is not — cmd.exe PATH differs in a make grandchild). "".
_cygpath_m_tr(posix: string) {
    out, err = os.exec("sh -c \"cygpath -m '${posix}'\"")
    if string.length(err) > 0 { return "" }
    return string.trim(out)
}
_script_path_tr(cmd: string) {
    tmp = _slashes_tr(os.getenv("TMP"))
    if string.length(tmp) == 0 { tmp = _slashes_tr(os.getenv("TEMP")) }
    if string.length(tmp) == 0 { tmp = _slashes_tr(os.getenv("TMPDIR")) }
    if string.length(tmp) == 0 { tmp = "/tmp" }
    // On Windows the temp path MUST be native: io.write_file (native Win32) and
    // `sh` resolve a POSIX "/tmp/.." to different physical dirs (C:\tmp vs
    // C:\msys64\tmp), so a POSIX path is written to one and executed from the
    // other → `sh: /tmp/_aeb_tr_*.sh: No such file or directory`. Convert to
    // native. (asks/windows-two-path-form-bugs-aeb-link-and-tmp.md, Bug 2.)
    if _is_windows_tr() == 1 {
        if _is_abs_native_tr(tmp) == 0 {
            nat = _cygpath_m_tr(tmp)
            if string.length(nat) > 0 { tmp = nat }
        }
    }
    name = string.concat("_aeb_tr_", string.concat(string.from_int(os.getpid()),
           string.concat("_", string.concat(string.from_int(_hash_tr(cmd)), ".sh"))))
    return string.concat(tmp, string.concat("/", name))
}
_sh_tr(cmd: string) {
    if _is_windows_tr() == 0 {
        return os.system(cmd)
    }
    scriptf = _script_path_tr(cmd)
    werr = io.write_file(scriptf, cmd)
    if string.length(werr) > 0 {
        return os.system(cmd)
    }
    rc = os.system(string.concat("sh ", scriptf))
    _d = fs.delete(scriptf)
    return rc
}

main() {
    argc = aether_args_count()
    if argc < 7 {
        println("Usage: transform-ae <source> <func_name> <label> <output> <lib_dir> <aeb_home>")
        exit(1)
    }

    src = aether_args_get(1)
    func_name = aether_args_get(2)
    label = aether_args_get(3)
    out = aether_args_get(4)
    lib_dir = aether_args_get(5)
    aeb_home = aether_args_get(6)

    // Step 1: write a sed script to a temp file (avoids shell quoting issues)
    // Two entrypoint spellings lower to the same `func_name(s: ptr) {`:
    //   legacy  `main() {`
    //   modern  `aeb(<anything>) {`   (the capability form; param name is sugar)
    // The `aeb(` rule matches any single identifier between the parens.
    // Emit `: int` so the node entry is int-typed: its last statement is a
    // builder call (now `: int`, whole-tree), and an int-typed function
    // flows that tail-call's rc as its own return — so gen-orchestrator can
    // read a REAL rc instead of the register garbage a void node produced
    // under its `extern … -> int` decl (the falsely-green-presubmit bug,
    // asks/node-nonzero-return-not-propagated-to-exit-code.md).
    sed_script = "s/^main() {/"
    sed_script = string.concat(sed_script, func_name)
    sed_script = string.concat(sed_script, "(s: ptr): int {/\n")
    sed_script = string.concat(sed_script, "s/^aeb([A-Za-z_][A-Za-z0-9_]*) {/")
    sed_script = string.concat(sed_script, func_name)
    sed_script = string.concat(sed_script, "(s: ptr): int {/\n")
    sed_script = string.concat(sed_script, "s|b = build\\.start()|b = build.begin(s, \"")
    sed_script = string.concat(sed_script, label)
    sed_script = string.concat(sed_script, "\")\\n    if b == 0 { return 0 }|\n")
    sed_script = string.concat(sed_script, "s|dep(b, \"\\([^\"]*\\)/\\.[^\"/]*\\.ae\")|dep(b, \"\\1\")|g\n")
    // Shape A (b-free node grammar): the user writes `build() {` (or
    // `build.build() {` if qualified). Thread the session `s` and the label in,
    // exactly as the build.start()→build.begin rule does for the old form — `s`
    // is reachable only as the node fn's parameter, never via injection. The
    // wrapper (lib/build/module.ae `build(s, label)`) branches on `s` for the
    // standalone-vs-orchestrated duality and returns the graph ctx the block
    // threads to every nested dep()/builder. See dsl_rework.md §4.5.
    sed_script = string.concat(sed_script, "s|build() {|build(s, \"")
    sed_script = string.concat(sed_script, label)
    sed_script = string.concat(sed_script, "\") {|\n")
    sed_script = string.concat(sed_script, "s|build.build() {|build.build(s, \"")
    sed_script = string.concat(sed_script, label)
    sed_script = string.concat(sed_script, "\") {|\n")
    // b-free dep-path normalization (Shape A): strip a trailing /.<name>.ae
    // filename from a bare dep("…") the same way the b-form rule does for
    // dep(b, "…"). Without this the runtime dep-dir contract breaks for Shape A.
    sed_script = string.concat(sed_script, "s|dep(\"\\([^\"]*\\)/\\.[^\"/]*\\.ae\")|dep(\"\\1\")|g\n")

    sed_file = string.concat(out, ".sed")
    werr = io.write_file(sed_file, sed_script)
    if werr != "" {
        println(string.concat("transform-ae: ", werr))
        exit(1)
    }
    // Quoted paths are safe now: the hardened _sh_tr writes the command to a
    // temp .sh and runs `sh <file>`, so cmd.exe never parses the contents — the
    // single quotes (and any space in a path) survive intact.
    _sh_tr("sed -f '${sed_file}' '${src}' > '${out}'")
    _sh_tr("rm -f '${sed_file}'")

    // Step 2: resolve transitive imports — PURE Aether (was resolve-imports.sh,
    // a fork-heavy bash script that hung under MSYS2's fork() emulation on
    // Windows). No shell, no fork, identical on every platform.
    extra = string.trim(_resolve_imports(src, lib_dir))

    // Step 3: prepend transitive imports to output file. Done in PURE Aether
    // (read out, rewrite as extra + "\n" + out) rather than the old
    // `printf '%s\n' '${extra}' | cat - out > tmp && mv` shell pipeline: the
    // single quotes that pipeline needs around the multi-line ${extra} collide
    // with the Windows chokepoint's own single-quote wrap (cmd.exe mangles the
    // POSIX `'\''` escape), and there's no reason to shell out for a string
    // prepend. No shell = no quoting hazard, identical on every platform.
    if string.length(extra) > 0 {
        body, berr = io.read_file(out)
        if berr == "" {
            merged = string.concat(extra, string.concat("\n", body))
            werr2 = io.write_file(out, merged)
            if werr2 != "" {
                println(string.concat("transform-ae: ", werr2))
                exit(1)
            }
        }
    }
}
