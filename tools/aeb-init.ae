// aeb-init — initialise the consuming repo's .aeb/lib symlinks
//
// Pure-Aether port of the bash `--init` block in aeb. Walks the shipped
// SDK module list, ensures each lives at .aeb/lib/<sdk> as a symlink to
// $AEB_HOME/lib/<sdk>, and (if absent) appends a `.aeb/` line to
// .gitignore so the symlinks aren't accidentally tracked.
//
// Usage:
//   aeb-init <aeb-home>
//
// <aeb-home> is the directory containing the shipped lib/<sdk> trees
// (i.e. the aeb checkout). Operates on the current working
// directory; aeb is expected to chdir to the consuming repo root before
// invoking this tool.

import std.string
import std.file
import std.os
import std.list
import std.io
import std.fs

extern println(s: string)
extern exit(code: int)

// Inline POSIX-shell-on-Windows chokepoint (hardened temp-script form; mirrors
// lib/build._sh / aeb-link / transform-ae). aeb-init is lazy-built WITHOUT
// --lib lib (bash + aeb-cli build it bare), so it can't `import build` — hence
// the inline copy. On Windows os.system/os.exec route through cmd.exe, which
// can't run aeb-init's POSIX commands (mkdir -p, ln -s, test -L, readlink,
// grep -Fx, printf >> redirect). Writing the cmd to a temp .sh and running
// `sh <nativepath>` makes cmd.exe never parse the contents, so quotes/redirects
// all survive. POSIX = passthrough.
_is_windows_init() {
    if os.platform() == "windows" { return 1 }
    return 0
}
_slashes_init(s: string) {
    out = ""
    rest = s
    while string.length(rest) > 0 {
        ch = string.substring(rest, 0, 1)
        rest = string.substring(rest, 1, string.length(rest))
        if string.equals(ch, "\\") == 1 { out = string.concat(out, "/") }
        else { out = string.concat(out, ch) }
    }
    return out
}
_hash_init(s: string) {
    h = 5381
    rest = s
    while string.length(rest) > 0 {
        c = string.char_at(rest, 0)
        rest = string.substring(rest, 1, string.length(rest))
        h = ((h * 33) + c) & 2147483647
    }
    return h
}
// Native-form Windows absolute path (drive letter / UNC).
_is_abs_native_init(p: string) {
    if string.length(p) < 2 { return 0 }
    if string.equals(string.substring(p, 0, 2), "\\\\") == 1 { return 1 }
    if string.equals(string.substring(p, 1, 2), ":") == 1 { return 1 }
    return 0
}
// Native form of a POSIX/MSYS path via cygpath run INSIDE sh (reliable where a
// bare os.exec cygpath is not — cmd.exe PATH differs in a make grandchild). "".
_cygpath_m_init(posix: string) {
    out, err = os.exec("sh -c \"cygpath -m '${posix}'\"")
    if string.length(err) > 0 { return "" }
    return string.trim(out)
}
_script_path_init(cmd: string) {
    tmp = _slashes_init(os.getenv("TMP"))
    if string.length(tmp) == 0 { tmp = _slashes_init(os.getenv("TEMP")) }
    if string.length(tmp) == 0 { tmp = _slashes_init(os.getenv("TMPDIR")) }
    if string.length(tmp) == 0 { tmp = "/tmp" }
    // On Windows the temp path MUST be native: io.write_file (native Win32) and
    // `sh` resolve a POSIX "/tmp/.." to different physical dirs (C:\tmp vs
    // C:\msys64\tmp), so a POSIX path is written to one and executed from the
    // other → `sh: /tmp/_aeb_init_*.sh: No such file or directory`. Convert to
    // native. (asks/windows-two-path-form-bugs-aeb-link-and-tmp.md, Bug 2.)
    if _is_windows_init() == 1 {
        if _is_abs_native_init(tmp) == 0 {
            nat = _cygpath_m_init(tmp)
            if string.length(nat) > 0 { tmp = nat }
        }
    }
    name = string.concat("_aeb_init_", string.concat(string.from_int(os.getpid()),
           string.concat("_", string.concat(string.from_int(_hash_init(cmd)), ".sh"))))
    return string.concat(tmp, string.concat("/", name))
}
_sh_init(cmd: string) {
    if _is_windows_init() == 0 { return os.system(cmd) }
    scriptf = _script_path_init(cmd)
    werr = io.write_file(scriptf, cmd)
    if string.length(werr) > 0 { return os.system(cmd) }
    rc = os.system(string.concat("sh ", scriptf))
    _d = fs.delete(scriptf)
    return rc
}
_sh_capture_init(cmd: string) {
    if _is_windows_init() == 0 {
        out, err = os.exec(cmd)
        return out, err
    }
    scriptf = _script_path_init(cmd)
    werr = io.write_file(scriptf, cmd)
    if string.length(werr) > 0 {
        out, err = os.exec(cmd)
        return out, err
    }
    out, err = os.exec(string.concat("sh ", scriptf))
    _d = fs.delete(scriptf)
    return out, err
}

// Shipped SDK modules — the lib/<sdk> trees aeb ships and symlinks
// into a project's .aeb/lib/ on `aeb --init`.
// Space-separated so we don't need an array literal in Aether.
shipped_modules() {
    return string.concat("build java kotlin go rust c cpp ts scala clojure dotnet python dart moonbit gleam swift zig ruby elixir nim lua erlang haskell php javascript pharo groovy aether bash brew cache container maven meta pnpm jest webpack angular approval webhook fetch copy agent veto", "")
}

// Returns 1 if `path` is a symlink (regardless of validity), 0 otherwise.
is_symlink(path: string) {
    cmd = string.concat("test -L \"", path)
    cmd = string.concat(cmd, "\" && echo yes || echo no")
    out, eerr = _sh_capture_init(cmd)
    if eerr != "" { return 0 }
    if string.trim(out) == "yes" { return 1 }
    return 0
}

// Returns the symlink target, or "" if not a symlink.
readlink_pure(path: string) {
    cmd = string.concat("readlink \"", path)
    cmd = string.concat(cmd, "\" 2>/dev/null")
    out, eerr = _sh_capture_init(cmd)
    if eerr != "" { return string.concat("", "") }
    return string.trim(out)
}

// Append `.gitignore` marker if absent. Idempotency check looks for
// the `.aeb/` line itself rather than the comment marker — avoids
// duplicate appends if the comment text drifts (it changed once
// already, from "aetherBuild" to "aeb"; repos initialized under the
// old name shouldn't get re-appended on a fresh `aeb --init` run).
finalize_gitignore() {
    if file.exists(".gitignore") == 1 {
        check_cmd = "grep -Fx '.aeb/' .gitignore 2>/dev/null && echo yes || echo no"
        check_out, cerr = _sh_capture_init(check_cmd)
        if cerr == "" {
            if string.trim(check_out) == "yes" {
                println("  .gitignore already configured")
                return 0
            }
        }
    }
    _sh_init("printf '\\n# aeb modules\\n.aeb/\\n' >> .gitignore")
    println("  updated .gitignore")
    return 0
}

main() {
    if aether_args_count() < 2 {
        println("Usage: aeb-init <aeb-home>")
        exit(1)
    }
    aebhome = aether_args_get(1)
    aeb_lib = string.concat(".aeb/lib", "")

    _sh_init(string.concat("mkdir -p ", aeb_lib))

    // Split shipped modules on spaces into a list (pure Aether).
    mods = list.new()
    rest = shipped_modules()
    word = string.concat("", "")
    while string.length(rest) > 0 {
        sp = string.index_of(rest, " ")
        if sp < 0 {
            word = string.concat(rest, "")
            rest = ""
        } else {
            word = string.substring(rest, 0, sp)
            rest = string.substring(rest, sp + 1, string.length(rest))
        }
        if string.length(word) > 0 {
            // Clone via string.concat — list.add stores raw pointers and
            // word's underlying buffer may be reused by string.substring.
            word_copy = string.concat(word, "")
            _la = list.add(mods, word_copy)
        }
    }

    // Pre-seed heap-string vars so the heap-tracker flags are declared at
    // function scope (works around an aetherc edge case with lazy decls in
    // nested if/else branches).
    msg = string.concat("", "")
    ln_cmd = string.concat("", "")
    n = list.size(mods)
    i = 0
    while i < n {
        mod, _ = list.get(mods, i)
        target = string.concat(aebhome, "/lib/")
        target = string.concat(target, mod)
        link = string.concat(aeb_lib, "/")
        link = string.concat(link, mod)

        if is_symlink(link) == 1 {
            existing = readlink_pure(link)
            if existing == target {
                println(string.concat("  ok: .aeb/lib/", mod))
            } else {
                _sh_init(string.concat("rm \"", string.concat(link, "\"")))
                ln_cmd = string.concat("ln -s \"", target)
                ln_cmd = string.concat(ln_cmd, "\" \"")
                ln_cmd = string.concat(ln_cmd, link)
                ln_cmd = string.concat(ln_cmd, "\"")
                _sh_init(ln_cmd)
                msg = string.concat("  updated: .aeb/lib/", mod)
                msg = string.concat(msg, " -> ")
                msg = string.concat(msg, target)
                println(msg)
            }
        } else {
            if file.exists(link) == 1 {
                msg = string.concat("  skip: .aeb/lib/", mod)
                msg = string.concat(msg, " (exists and is not a symlink)")
                println(msg)
            } else {
                ln_cmd = string.concat("ln -s \"", target)
                ln_cmd = string.concat(ln_cmd, "\" \"")
                ln_cmd = string.concat(ln_cmd, link)
                ln_cmd = string.concat(ln_cmd, "\"")
                _sh_init(ln_cmd)
                msg = string.concat("  linked: .aeb/lib/", mod)
                msg = string.concat(msg, " -> ")
                msg = string.concat(msg, target)
                println(msg)
            }
        }
        i = i + 1
    }

    finalize_gitignore()
    println("aeb initialized.")
    return 0
}
