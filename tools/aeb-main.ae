// aeb-main — the Aether-side entry point for `aeb`.
//
// Subsumes everything aeb does after --init handling:
//   1. argument parsing (single optional target)
//   2. scan mode (no target) — find every .*.ae build file
//      OR target mode — start from the target file and walk its deps
//   3. topo sort the resulting file set
//   4. exec aeb-link, which compiles + links + runs the orchestrator
//
// Usage:
//   aeb-main <aether-bin> <aeb-home> <root> [target]
//
// <aether-bin> : path to the `ae` driver (so we can lazy-build helpers)
// <aeb-home>   : path to the aeb checkout
// <root>       : monorepo root (cwd at invocation time)
// [target]     : optional file path or directory; same semantics as aeb
//
// Operates on the current working directory; the bash trampoline must
// chdir to <root> before calling.

import build
import provision
import std.string
import std.file
import std.fs
import std.io
import std.os
import std.list
import std.map
import std.path

extern println(s: string)
extern exit(code: int)

// _toolbase(aebhome, name) — the helper tool's path WITHOUT an exe suffix.
// Use this for the `ae build -o <target>` output: `ae` auto-appends `.exe` on
// Windows, so passing `foo.exe` here would produce `foo.exe.exe`. Pass the
// bare name and let `ae` add the suffix.
_toolbase(aebhome: string, name: string) {
    return string.concat(string.concat(aebhome, "/tools/"), name)
}

// _toolbin(aebhome, name) — the helper tool's path WITH the platform suffix
// (`.exe` on Windows, "" on POSIX). Use this for file.exists() and for
// INVOKING the tool — cmd.exe/sh need the real on-disk name, and `ae build`
// will have produced `<name>.exe` on Windows.
_toolbin(aebhome: string, name: string) {
    return string.concat(_toolbase(aebhome, name), build._exe_suffix())
}

// Strip trailing slash from a path (cosmetic match with bash's TARGET%/).
strip_trailing_slash(s: string) {
    n = string.length(s)
    if n == 0 { return string.concat(s, "") }
    last = string.substring(s, n - 1, n)
    if last == "/" {
        return string.substring(s, 0, n - 1)
    }
    return string.concat(s, "")
}

// Resolve a directory target to one of .build.ae / .tests.ae / .dist.ae,
// preferring tests if both exist (matches bash precedence).
resolve_target_dir(target: string) {
    tests = string.concat(target, "/.tests.ae")
    if file.exists(tests) == 1 { return tests }
    build = string.concat(target, "/.build.ae")
    if file.exists(build) == 1 { return build }
    dist = string.concat(target, "/.dist.ae")
    if file.exists(dist) == 1 { return dist }
    return string.concat("", "")
}

// Run a shell command and return stdout (trimmed) or "" on failure. Routed
// through build._sh_capture so POSIX shell idioms (pipes, redirects, mkdir -p,
// command -v) work on Windows (sh -c wrap) and pass through unchanged on POSIX.
run_capture(cmd: string) {
    out, eerr = build._sh_capture(cmd)
    if eerr != "" {
        return string.concat("", "")
    }
    return string.trim(out)
}

// _collect_prereqs(extract_deps_bin, files) — flatten the prerequisite set over
// a dep closure. For each file in `files` (already the transitive closure), run
// `extract-deps --prereqs` and union the emitted tokens, deduped, preserving
// first-seen order. Returns a list of token strings. Shared by --prereqs (list)
// and --preflight (probe). See docs/build-prerequisites-and-provisioning.md.
_collect_prereqs(extract_deps_bin: string, files: ptr) {
    tokens = list.new()
    seen = map.new()
    n = list.size(files)
    i = 0
    while i < n {
        f, _ = list.get(files, i)
        i = i + 1
        raw = run_capture(string.concat(string.concat(extract_deps_bin, " --prereqs "), f))
        rest = string.trim(raw)
        while string.length(rest) > 0 {
            sp = string.index_of(rest, " ")
            tok = ""
            if sp < 0 {
                tok = rest
                rest = ""
            } else {
                tok = string.substring(rest, 0, sp)
                rest = string.substring(rest, sp + 1, string.length(rest))
            }
            tok = string.trim(tok)
            if string.length(tok) > 0 {
                if map.has(seen, tok) == 0 {
                    _a = list.add(tokens, tok)
                    _m = map.put(seen, tok, "1")
                }
            }
        }
    }
    return tokens
}

_split_lines(buf: string) {
    lines = list.new()
    n = string.length(buf)
    start = 0
    i = 0
    while i < n {
        ch = string.substring(buf, i, i + 1)
        if string.equals(ch, "\n") == 1 {
            line = string.substring(buf, start, i)
            list.add(lines, line)
            start = i + 1
        }
        i = i + 1
    }
    if start < n {
        list.add(lines, string.substring(buf, start, n))
    }
    return lines
}

_sort_file_list(files: ptr) {
    out = list.new()
    buf = ""
    n = list.size(files)
    i = 0
    while i < n {
        f, _ = list.get(files, i)
        if string.length(buf) > 0 { buf = string.concat(buf, "\n") }
        buf = string.concat(buf, f)
        i = i + 1
    }
    if string.length(buf) == 0 { return out }
    sorted_raw, _serr = build._sh_capture("printf '%s\\n' '${buf}' | sort -u")
    sorted = string.trim(sorted_raw)
    if string.length(sorted) == 0 { return out }
    lines = _split_lines(sorted)
    ln = list.size(lines)
    j = 0
    while j < ln {
        line, _ = list.get(lines, j)
        if string.length(line) > 0 {
            list.add(out, line)
        }
        j = j + 1
    }
    return out
}

_parse_shard(spec: string) {
    slash = string.index_of(spec, "/")
    if slash <= 0 { return 0, 0, 0 }
    if slash >= string.length(spec) - 1 { return 0, 0, 0 }
    left = string.substring(spec, 0, slash)
    right = string.substring(spec, slash + 1, string.length(spec))
    idx, ierr = string.to_int(left)
    total, terr = string.to_int(right)
    if idx < 1 { return 0, 0, 0 }
    if total < 1 { return 0, 0, 0 }
    if idx > total { return 0, 0, 0 }
    return idx, total, 1
}

main() {
    if aether_args_count() < 4 {
        println("Usage: aeb-main <aether-bin> <aeb-home> <root> [target]")
        exit(1)
    }
    aether_bin = aether_args_get(1)
    aebhome    = aether_args_get(2)
    root       = aether_args_get(3)

    // argv[4] is either a target path (compile this and its deps), a
    // query subcommand (`query`, `owners`, `path`, `why`), or
    // a `--<flag>` (modal action that uses the same scan/extract
    // pipeline as a build but exits before linking). argv[5] is an
    // optional flag/subcommand argument.
    //
    // `target` holds the FIRST positional (kept for every downstream
    // consumer that reasons about a single target — dir resolution,
    // --preflight/--prereqs, the affected-set "since <target>" note).
    // `targets` holds ALL positionals in plain build mode: `aeb a b c`
    // builds each of a, b, c and their transitive deps in one DAG. When
    // a modal flag is present (argv[4] is a --flag or a query subcommand)
    // there is exactly one target directive and argv[5]/argv[6] are the
    // flag's arguments, NOT more targets — so `targets` collects only in
    // the plain-build case.
    target = string.concat("", "")
    targets = list.new()
    flag = string.concat("", "")
    flag_arg = string.concat("", "")
    flag_arg2 = string.concat("", "")
    if aether_args_count() >= 5 {
        a4 = aether_args_get(4)
        is_flag = 0
        if string.length(a4) >= 2 {
            if string.equals(string.substring(a4, 0, 2), "--") == 1 {
                flag = a4
                is_flag = 1
            }
        }
        if is_flag == 0 {
            if string.equals(a4, "query") == 1 {
                flag = "--query"
            } else {
                if string.equals(a4, "owners") == 1 {
                    flag = "--owners"
                } else {
                    if string.equals(a4, "path") == 1 {
                        flag = "--path"
                    } else {
                        if string.equals(a4, "why") == 1 {
                            flag = "--why"
                        } else {
                            // Plain build mode: argv[4..] are ALL targets.
                            target = strip_trailing_slash(a4)
                            _t0 = list.add(targets, target)
                            ti = 5
                            tc = aether_args_count()
                            while ti <= tc {
                                at = aether_args_get(ti)
                                if string.length(at) > 0 {
                                    _tn = list.add(targets, strip_trailing_slash(at))
                                }
                                ti = ti + 1
                            }
                        }
                    }
                }
            }
        }
    }
    if aether_args_count() >= 6 {
        flag_arg = aether_args_get(5)
    }
    if aether_args_count() >= 7 {
        flag_arg2 = aether_args_get(6)
    }

    // Query-style commands always need the whole scanned graph. They
    // are read-only; no target-mode dep closure or build/link step.
    if string.equals(flag, "--query") == 1 {
        target = ""
    }
    if string.equals(flag, "--owners") == 1 {
        target = ""
    }
    if string.equals(flag, "--path") == 1 {
        target = ""
    }
    if string.equals(flag, "--why") == 1 {
        target = ""
    }
    // --preflight and --prereqs are TARGET-mode (they need that target's dep
    // closure, not the whole graph), but the target arrives as flag_arg (arg 5)
    // since arg 4 is the flag itself. Pull it across so the BFS runs from it.
    //   --prereqs  : LIST the flattened prerequisite set (one token per line) —
    //                what the target needs, OS-agnostic, doesn't probe/install.
    //   --preflight: PROBE the set vs the host, emit the unmet-prereqs verdict.
    if string.equals(flag, "--preflight") == 1 {
        target = strip_trailing_slash(flag_arg)
    }
    if string.equals(flag, "--prereqs") == 1 {
        target = strip_trailing_slash(flag_arg)
    }

    // --- Lazy-build helper tools ---
    extract_deps_bin = _toolbin(aebhome, "extract-deps")
    if file.exists(extract_deps_bin) == 0 {
        build._sh(string.concat(string.concat(aether_bin, " build "), string.concat(string.concat(aebhome, "/tools/extract-deps.ae -o "), string.concat(_toolbase(aebhome, "extract-deps"), " >/dev/null 2>&1"))))
    }
    scan_ae_files_bin = _toolbin(aebhome, "scan-ae-files")
    if file.exists(scan_ae_files_bin) == 0 {
        build._sh(string.concat(string.concat(aether_bin, " build "), string.concat(string.concat(aebhome, "/tools/scan-ae-files.ae -o "), string.concat(_toolbase(aebhome, "scan-ae-files"), " >/dev/null 2>&1"))))
    }
    topo_sort_bin = _toolbin(aebhome, "topo-sort")
    if file.exists(topo_sort_bin) == 0 {
        build._sh(string.concat(string.concat(aether_bin, " build "), string.concat(string.concat(aebhome, "/tools/topo-sort.ae -o "), string.concat(_toolbase(aebhome, "topo-sort"), " >/dev/null 2>&1"))))
    }
    aeb_link_bin = _toolbin(aebhome, "aeb-link")
    if file.exists(aeb_link_bin) == 0 {
        // --lib <aebhome>/tools resolves aeb-link's `import aeblabel`.
        build._sh(string.concat(string.concat(aether_bin, " build "), string.concat(string.concat(aebhome, "/tools/aeb-link.ae -o "), string.concat(_toolbase(aebhome, "aeb-link"), string.concat(" --lib ", string.concat(aebhome, "/tools >/dev/null 2>&1"))))))
    }
    aeb_graph_bin = _toolbin(aebhome, "aeb-graph")
    if file.exists(aeb_graph_bin) == 0 {
        build._sh(string.concat(string.concat(aether_bin, " build "), string.concat(string.concat(aebhome, "/tools/aeb-graph.ae -o "), string.concat(_toolbase(aebhome, "aeb-graph"), " >/dev/null 2>&1"))))
    }
    aeb_query_bin = _toolbin(aebhome, "aeb-query")
    if file.exists(aeb_query_bin) == 0 {
        build._sh(string.concat(string.concat(aether_bin, " build "), string.concat(string.concat(aebhome, "/tools/aeb-query.ae -o "), string.concat(_toolbase(aebhome, "aeb-query"), " >/dev/null 2>&1"))))
    }
    affected_bin = _toolbin(aebhome, "affected-targets")
    if file.exists(affected_bin) == 0 {
        build._sh(string.concat(string.concat(aether_bin, " build "), string.concat(string.concat(aebhome, "/tools/affected-targets.ae -o "), string.concat(_toolbase(aebhome, "affected-targets"), " >/dev/null 2>&1"))))
    }

    // --- Discover the file set ---
    files = list.new()
    file_deps = map.new()
    seen = map.new()
    queue = list.new()

    if string.length(target) == 0 {
        // Scan mode: walk every .*.ae file under cwd via scan-ae-files.
        //
        // Plain build-mode scan (no modal flag) is OPT-IN and must be
        // scoped by a glob: `aeb --scan '<glob>'` sets AEB_SCAN. A bare
        // `aeb` with neither a target nor --scan is an error — we never
        // build the whole tree implicitly (that's the un-scoped posture
        // --scan exists to forbid, and the dangerous one under --vet).
        // Modal flags (--query/--since/--affected/…) legitimately need
        // the full graph, so they set `flag` and skip this guard.
        if string.length(flag) == 0 {
            if string.length(os.getenv("AEB_SCAN")) == 0 {
                println("aeb: nothing to build — name a target (e.g. `aeb path/to/.build.ae`)")
                println("     or scope a tree scan with a glob (e.g. `aeb --scan '.build.ae'`).")
                exit(2)
            }
        }
        scan_out = run_capture(scan_ae_files_bin)
        rest = scan_out
        line = string.concat("", "")
        while string.length(rest) > 0 {
            nl = string.index_of(rest, "\n")
            if nl < 0 {
                line = string.concat(rest, "")
                rest = ""
            } else {
                line = string.substring(rest, 0, nl)
                rest = string.substring(rest, nl + 1, string.length(rest))
            }
            if string.length(line) > 0 {
                copy = string.concat(line, "")
                _lf = list.add(files, copy)
                _ms = map.put(seen, copy, "1")
            }
        }
        // For each file, run extract-deps to populate file_deps.
        nf = list.size(files)
        i = 0
        while i < nf {
            f, _ = list.get(files, i)
            d = run_capture(string.concat(string.concat(extract_deps_bin, " "), f))
            _md = map.put(file_deps, f, string.concat(d, ""))
            i = i + 1
        }
    } else {
        // Target mode: resolve every positional target (a dir resolves to
        // its .build/.tests/.dist file) and seed the BFS from all of them.
        // A modal flag (--preflight/--prereqs) sets `target` directly and
        // leaves `targets` empty — fall back to the single `target` then.
        seed_targets = targets
        if list.size(seed_targets) == 0 {
            seed_targets = list.new()
            _st0 = list.add(seed_targets, target)
        }
        st_n = list.size(seed_targets)
        sti = 0
        while sti < st_n {
            tgt, _ = list.get(seed_targets, sti)
            sti = sti + 1
            if string.ends_with(tgt, ".ae") == 1 {
                check_path = string.concat("./", tgt)
                if file.exists(check_path) == 0 {
                    println(string.concat("error: ", string.concat(tgt, " not found")))
                    exit(1)
                }
            } else {
                resolved = resolve_target_dir(tgt)
                if string.length(resolved) == 0 {
                    println(string.concat("error: no .ae files found in ", tgt))
                    exit(1)
                }
                tgt = resolved
            }
            // `target` (singular) tracks the first resolved target for the
            // downstream single-target consumers; seed the BFS from each.
            if sti == 1 { target = string.concat(tgt, "") }
            if map.has(seen, tgt) == 0 {
                _lq = list.add(queue, string.concat(tgt, ""))
                _mq = map.put(seen, tgt, "1")
            }
        }

        // BFS from the seeded targets through transitive deps.
        head = 0
        qs = list.size(queue)
        d = string.concat("", "")
        dword = string.concat("", "")
        while head < qs {
            f, _ = list.get(queue, head)
            head = head + 1
            _lf2 = list.add(files, string.concat(f, ""))
            d = run_capture(string.concat(string.concat(extract_deps_bin, " "), f))
            d = string.concat(d, "")
            _md2 = map.put(file_deps, f, d)
            // Enqueue any unseen dep that exists on disk.
            drest = d
            while string.length(drest) > 0 {
                sp = string.index_of(drest, " ")
                if sp < 0 {
                    dword = string.concat(drest, "")
                    drest = ""
                } else {
                    dword = string.substring(drest, 0, sp)
                    drest = string.substring(drest, sp + 1, string.length(drest))
                }
                if string.length(dword) > 0 {
                    if map.has(seen, dword) == 0 {
                        if file.exists(dword) == 1 {
                            _ms2 = map.put(seen, dword, "1")
                            _lq2 = list.add(queue, string.concat(dword, ""))
                            qs = qs + 1
                        }
                    }
                }
            }
        }
    }

    if list.size(files) == 0 {
        println("No .ae build files found")
        return 0
    }

    // --- --prereqs / --preflight: flatten the prerequisite set over the dep
    // closure, then either LIST it (--prereqs) or PROBE it (--preflight).
    // Read-only, no build/link, no install. `files` is already the transitive
    // dep closure (target-mode BFS / scan). For each file collect its prereq()
    // tokens (extract-deps --prereqs) and union them.
    //   --prereqs  : print the set, one token per line (OS-agnostic — same on
    //                Windows and Linux), exit 0. The "what does this need?" query.
    //   --preflight: hand the set to provision.preflight → "all prerequisites
    //                met" or the distinct "unmet-prereqs: [...]" verdict (exit 3,
    //                NOT build-failed=1). The "what's missing?" check. Pure
    //                probing through the build chokepoint — cross-platform.
    if string.equals(flag, "--prereqs") == 1 {
        target = string.concat(target, "")  // keep target-mode (already pulled)
    }
    if string.equals(flag, "--prereqs") == 1 {
        prereq_tokens = _collect_prereqs(extract_deps_bin, files)
        // Reject known misnames (node not nodejs, jdk not java/openjdk, …) so a
        // token never reaches a resolver ambiguously. Loud, fail-closed.
        nm = provision.check_token_names(prereq_tokens)
        if string.length(nm) > 0 { println(nm)  exit(3) }
        pq_n = list.size(prereq_tokens)
        if pq_n == 0 {
            // No output on an empty set — greppable / scriptable (like
            // extract-deps' silent-on-none). Exit 0.
        } else {
            pq_i = 0
            while pq_i < pq_n {
                pq_t, _ = list.get(prereq_tokens, pq_i)
                println(pq_t)
                pq_i = pq_i + 1
            }
        }
        exit(0)
    }
    if string.equals(flag, "--preflight") == 1 {
        prereq_tokens = _collect_prereqs(extract_deps_bin, files)
        nm = provision.check_token_names(prereq_tokens)
        if string.length(nm) > 0 { println(nm)  exit(3) }
        pf_rc = provision.preflight(prereq_tokens)
        exit(pf_rc)
    }
    // NB: aeb deliberately has NO install verb. `--prereqs` states what a build
    // needs (OS-agnostic tokens); `--preflight` probes whether they're present.
    // Turning a token into a per-OS install command (jdk:21 → openjdk-21-jdk on
    // apt, jdk-openjdk on pacman, a Temurin tarball, …) is an unbounded,
    // per-distro, per-version, drifting problem aeb would never keep correct.
    // That resolution belongs to a capable agent in the loop (the user's
    // Claude: `aeb --prereqs` + the host's package manager → the right installs)
    // — NOT to a synonym map aeb must perfect, and NOT to a case-switch in
    // .build.ae files (which would put the host into the build graph and shove
    // the burden onto every repo author). aeb states the need; something that
    // actually knows package ecosystems satisfies it.

    // --- Resolve the SDK lib dir ---
    // `.aeb/lib` is a per-project SDK pin — a tree of symlinks set by
    // `aeb --init`. Two distinct missing-pin cases, handled
    // differently (split deliberately; they used to both fall back):
    //
    //   1. `.aeb/lib` ABSENT entirely (project never init'd, or aeb
    //      run from a subdir below where .aeb lives) → fall back to
    //      the running aeb's own SDK tree ($AEB_HOME/lib, always
    //      exported by the trampoline). This keeps `aeb --init`
    //      optional for a fresh clone: it "just works" against the
    //      global install.
    //
    //   2. `.aeb/lib` PRESENT but its `build` symlink is dangling /
    //      broken (the pinned SDK tree moved or was deleted) → FAST
    //      FAIL. The project explicitly pinned an SDK and it's gone;
    //      silently swapping in the global tree masks the breakage
    //      (you can build against a different — possibly stale — SDK
    //      than the project declares, which is exactly the footgun
    //      that hid a bad pin for an entire debugging session). Error
    //      loudly and point at `aeb --init` to re-point the links.
    //
    // Probe a concrete file (`build/module.ae`) so a dangling symlink
    // fails the usability check; then disambiguate absent-vs-broken by
    // whether the `.aeb/lib` directory itself exists.
    aeb_lib_dir = string.concat(root, "/.aeb/lib")
    if fs.exists(string.concat(aeb_lib_dir, "/build/module.ae")) == 0 {
        if fs.exists(aeb_lib_dir) == 1 {
            // Case 2: broken pin — fail loud, don't silently fall back.
            println("aeb: .aeb/lib exists but its SDK symlinks are dangling")
            println("aeb:   (e.g. .aeb/lib/build does not resolve to a build/module.ae)")
            println("aeb:   the pinned SDK tree has moved or been deleted.")
            println("aeb: re-run `aeb --init` to re-point .aeb/lib at this aeb install,")
            println("aeb:   or remove .aeb/lib to fall back to the global SDK ($AEB_HOME/lib).")
            exit(1)
        }
        // Case 1: never init'd — fall back to the global SDK tree.
        aeb_lib_dir = string.concat(aebhome, "/lib")
    }
    build_dir = string.concat(root, "/target/_aeb")
    out_bin = string.concat(root, "/target/_ae_build_all")
    build._sh(string.concat("mkdir -p ", build_dir))

    edges_path = string.concat(build_dir, "/_edges.txt")
    edges_buf = string.concat("", "")
    line = string.concat("", "")
    nfiles = list.size(files)
    j = 0
    while j < nfiles {
        f, _ = list.get(files, j)
        ds = string.concat("", "")
        if map.has(file_deps, f) == 1 {
            ds, _ = map.get(file_deps, f)
        }
        line = string.concat(f, " ")
        line = string.concat(line, ds)
        edges_buf = string.concat(edges_buf, line)
        edges_buf = string.concat(edges_buf, "\n")
        j = j + 1
    }
    werr = io.write_file(edges_path, edges_buf)
    if werr != "" {
        println(string.concat("aeb-main: ", werr))
        exit(1)
    }

    // --- --graph: emit DAG as DOT or Mermaid, then exit ---
    if string.equals(flag, "--graph") == 1 {
        gfmt = "dot"
        if string.length(flag_arg) > 0 { gfmt = flag_arg }
        gcmd = string.concat(string.concat(aeb_graph_bin, " "), edges_path)
        gcmd = string.concat(gcmd, " ")
        gcmd = string.concat(gcmd, gfmt)
        build._sh(gcmd)
        return 0
    }

    // --- graph queries: answer from _edges.txt, then exit ---
    if string.equals(flag, "--query") == 1 {
        if string.length(flag_arg) == 0 {
            println("aeb: query requires an expression, e.g. `aeb query 'deps(path/.build.ae)'`")
            exit(1)
        }
        qcmd = string.concat(aeb_query_bin, " ")
        qcmd = string.concat(qcmd, edges_path)
        qcmd = string.concat(qcmd, " query '")
        qcmd = string.concat(qcmd, flag_arg)
        qcmd = string.concat(qcmd, "'")
        rc_query = build._sh(qcmd)
        exit(rc_query)
    }
    if string.equals(flag, "--owners") == 1 {
        if string.length(flag_arg) == 0 {
            println("aeb: owners requires a source path")
            exit(1)
        }
        ocmd = string.concat(aeb_query_bin, " ")
        ocmd = string.concat(ocmd, edges_path)
        ocmd = string.concat(ocmd, " owners ")
        ocmd = string.concat(ocmd, flag_arg)
        rc_owners = build._sh(ocmd)
        exit(rc_owners)
    }
    if string.equals(flag, "--path") == 1 || string.equals(flag, "--why") == 1 {
        if string.length(flag_arg) == 0 || string.length(flag_arg2) == 0 {
            println("aeb: path/why require two targets")
            exit(1)
        }
        pcmd = string.concat(aeb_query_bin, " ")
        pcmd = string.concat(pcmd, edges_path)
        if string.equals(flag, "--why") == 1 {
            pcmd = string.concat(pcmd, " why ")
        } else {
            pcmd = string.concat(pcmd, " path ")
        }
        pcmd = string.concat(pcmd, flag_arg)
        pcmd = string.concat(pcmd, " ")
        pcmd = string.concat(pcmd, flag_arg2)
        rc_q = build._sh(pcmd)
        exit(rc_q)
    }

    // --- --since / --affected / --print-affected: filter the build set ---
    //
    // Given a git ref (default HEAD for --affected, explicit for
    // --since), shell out to git diff for the changed-files list,
    // hand it to the affected-targets tool, get back the impacted
    // targets, and either print them (--print-affected) or rewrite
    // the build set so only those targets and their deps build.
    // narrowed: did --since or --scan shrink `files`/`seen` from
    // the full scanned set? Drives the edges-file rewrite below
    // (single rewrite covers both code paths).
    narrowed = 0
    // AEB_SCAN read up here so --print-affected can also honour
    // it. The actual filter (against `files`/`seen`) happens after
    // the --since block; for --print-affected we filter `aff_out`
    // (a string) inline since that path returns early.
    pattern = os.getenv("AEB_SCAN")
    is_since   = string.equals(flag, "--since")
    is_aff     = string.equals(flag, "--affected")
    is_print   = string.equals(flag, "--print-affected")
    is_cpf     = string.equals(flag, "--changed-paths-from")
    if is_since == 1 {
        if string.length(flag_arg) == 0 {
            println("aeb: --since requires a git ref (e.g. `aeb --since main`)")
            exit(1)
        }
        _since_env = os.setenv("AEB_SINCE_REF", flag_arg)
    }
    if is_cpf == 1 {
        if string.length(flag_arg) == 0 {
            println("aeb: --changed-paths-from requires a file path")
            exit(1)
        }
        if file.exists(flag_arg) == 0 {
            println(string.concat("aeb: changed-paths file not found: ", flag_arg))
            exit(1)
        }
    }
    if (is_since + is_aff + is_print + is_cpf) > 0 {
        // Two ways to populate the changed-paths file:
        // 1. Git-derived (`--since`/`--affected`/`--print-affected`):
        //    write `git diff --name-only <ref>` to _changed.txt.
        // 2. Caller-provided (`--changed-paths-from <file>`): use
        //    the file directly. Used by `aeb --watch` to feed
        //    inotify-derived change lists into the same affected-
        //    target pipeline.
        changed_path_file = string.concat(build_dir, "/_changed.txt")
        if is_cpf == 1 {
            // Copy caller's file into our well-known location so the
            // affected-targets tool reads from a stable path. (Also
            // means a transient watch event file in /tmp doesn't
            // race against the build pipeline reading it.)
            cpf_content, cpf_rerr = fs.read(flag_arg)
            if string.length(cpf_rerr) > 0 {
                println(string.concat("aeb: cannot read changed-paths file: ", cpf_rerr))
                exit(1)
            }
            werr_c = io.write_file(changed_path_file, cpf_content)
            if werr_c != "" {
                println(string.concat("aeb-main: ", werr_c))
                exit(1)
            }
        } else {
            git_ref = flag_arg
            if string.length(git_ref) == 0 { git_ref = "HEAD" }
            // Resolve changed paths via git. We use --name-only so
            // we get one path per line; deletion paths are included
            // (the affected-targets tool silently skips paths with
            // no enclosing target).
            diff_cmd = string.concat("git diff --name-only ", git_ref)
            diff_out, diff_err = build._sh_capture(diff_cmd)
            if diff_err != "" {
                println(string.concat("aeb: git diff failed: ", diff_err))
                exit(1)
            }
            werr_c2 = io.write_file(changed_path_file, diff_out)
            if werr_c2 != "" {
                println(string.concat("aeb-main: ", werr_c2))
                exit(1)
            }
        }
        aff_cmd = string.concat(affected_bin, " ")
        aff_cmd = string.concat(aff_cmd, edges_path)
        aff_cmd = string.concat(aff_cmd, " ")
        aff_cmd = string.concat(aff_cmd, changed_path_file)
        aff_out_raw, _aff_err = build._sh_capture(aff_cmd)
        aff_out = string.trim(aff_out_raw)

        if is_print == 1 {
            // Print the list and exit. If --scan is also set,
            // filter the lines by basename glob first; empty
            // output is meaningful ("nothing affected after the
            // scan-glob filter") and we just emit nothing.
            out_str = aff_out
            if string.length(pattern) > 0 {
                filtered = ""
                rest_p = aff_out
                while string.length(rest_p) > 0 {
                    nl_p = string.index_of(rest_p, "\n")
                    line_p = ""
                    if nl_p < 0 {
                        line_p = rest_p
                        rest_p = ""
                    } else {
                        line_p = string.substring(rest_p, 0, nl_p)
                        rest_p = string.substring(rest_p, nl_p + 1, string.length(rest_p))
                    }
                    if string.length(line_p) > 0 {
                        if string.glob_match(pattern, path.basename(line_p)) == 1 {
                            if string.length(filtered) > 0 {
                                filtered = string.concat(filtered, "\n")
                            }
                            filtered = string.concat(filtered, line_p)
                        }
                    }
                }
                out_str = filtered
            }
            if string.length(out_str) > 0 {
                println(out_str)
            }
            return 0
        }

        // Build mode: replace the file set with only the affected
        // targets. Empty set → exit 0 with a note (no work to do).
        if string.length(aff_out) == 0 {
            change_source = flag_arg
            if string.length(change_source) == 0 { change_source = "HEAD" }
            println("aeb: no targets affected by changes (since ${change_source})")
            return 0
        }
        new_files = list.new()
        new_seen  = map.new()
        rest_a = aff_out
        while string.length(rest_a) > 0 {
            nl_a = string.index_of(rest_a, "\n")
            la = ""
            if nl_a < 0 {
                la = rest_a
                rest_a = ""
            } else {
                la = string.substring(rest_a, 0, nl_a)
                rest_a = string.substring(rest_a, nl_a + 1, string.length(rest_a))
            }
            if string.length(la) > 0 {
                _e_la = list.add(new_files, la)
                _e_ms = map.put(new_seen, la, "1")
            }
        }
        // Replace files / seen with the affected set. file_deps
        // is left as-is — it has entries for the originally
        // scanned set, and the topo-sort below will only walk the
        // entries it sees in `files`.
        files = new_files
        seen  = new_seen
        narrowed = 1
        // Edges-file rewrite happens once below, after both --since
        // and --scan have had a chance to narrow.
    }

    // --- AEB_SCAN: scan-mode glob; also filters files by basename ---
    //
    // Set by the trampoline when the user passes `--scan <glob>`. In
    // plain build mode it BOTH selects scan mode (above) and narrows
    // the scanned set to paths whose basename matches the POSIX fnmatch
    // glob. Composes with --since: a glob after --since further narrows
    // the affected set.
    //
    // Designed for CI shapes:
    //   aeb --since main --scan '.tests.ae'      # PR-impact tests only
    //   aeb --since main --scan '.tests*.ae'     # incl .tests-it.ae
    //   aeb --scan '.tests.ae'                   # all tests, no diff filter
    //
    // The match target is the file's basename (path.basename), so
    // `.tests.ae` matches both `lib/foo/.tests.ae` and
    // `apps/bar/.tests.ae`. Users can scope by cd'ing or by
    // running aeb from a sub-directory.
    //
    // (Already read into `pattern` at function top; --print-affected
    // applies it inline, this block applies it for build mode.)
    if string.length(pattern) > 0 {
        pat_files = list.new()
        pat_seen  = map.new()
        pn = list.size(files)
        pi = 0
        while pi < pn {
            f, _ = list.get(files, pi)
            base = path.basename(f)
            if string.glob_match(pattern, base) == 1 {
                _e_pl = list.add(pat_files, f)
                _e_pm = map.put(pat_seen, f, "1")
            }
            pi = pi + 1
        }
        if list.size(pat_files) == 0 {
            // Empty intersection — distinct from "nothing affected"
            // because the user asked for a specific filter. Be
            // explicit so a CI green-light isn't ambiguous with
            // "your pattern was wrong."
            scope = "scanned set"
            if narrowed == 1 {
                ref_str = flag_arg
                if string.length(ref_str) == 0 { ref_str = "HEAD" }
                scope = "affected set (since ${ref_str})"
            }
            println("aeb: no targets matching --scan glob '${pattern}' in ${scope}")
            return 0
        }
        files = pat_files
        seen  = pat_seen
        narrowed = 1

        // Dep-close the narrowed set. The glob filters the BUILD SET by
        // basename, but a matched node may dep on a node whose basename
        // does NOT match — e.g. a `.build.ae` depending on a vendored
        // registry node (`.jni.crate.ae`, `.ffi-napi.npm.ae`). Those deps
        // were populated into `file_deps` during the full scan above; the
        // basename filter dropped them from `files` while leaving the dep
        // edge in the rewritten edges file, so make/topo-sort would see a
        // target with no rule ("No rule to make target ..."). Re-add each
        // matched node's transitive deps (BFS over file_deps, same shape as
        // the target-mode closure) so every emitted edge has a row. Only
        // deps present in the original scan are re-added; `seen` dedups.
        chead = 0
        cn = list.size(files)
        cword = string.concat("", "")
        while chead < cn {
            cf, _ = list.get(files, chead)
            chead = chead + 1
            cdeps = string.concat("", "")
            if map.has(file_deps, cf) == 1 {
                cdeps, _ = map.get(file_deps, cf)
            }
            crest = cdeps
            while string.length(crest) > 0 {
                csp = string.index_of(crest, " ")
                if csp < 0 {
                    cword = string.concat(crest, "")
                    crest = ""
                } else {
                    cword = string.substring(crest, 0, csp)
                    crest = string.substring(crest, csp + 1, string.length(crest))
                }
                if string.length(cword) > 0 {
                    if map.has(seen, cword) == 0 {
                        if file.exists(cword) == 1 {
                            _mcc = map.put(seen, cword, "1")
                            _lcc = list.add(files, string.concat(cword, ""))
                            cn = cn + 1
                        }
                    }
                }
            }
        }
    }

    // --- AEB_SHARD: deterministic target partitioning for CI ---
    //
    // Set by the trampoline when the user passes `--shard N/M`.
    // Applied after --since and --scan, so a common CI shape is:
    //   aeb --since main --scan '.tests*.ae' --shard 2/8
    //
    // The partition key is the sorted target path list. Position is
    // zero-based after sorting; shard 1/M receives positions 0, M,
    // 2M..., shard 2/M receives 1, M+1, and so on. CI systems own
    // runner distribution; aeb owns stable target selection.
    shard_spec = os.getenv("AEB_SHARD")
    if string.length(shard_spec) > 0 {
        shard_idx, shard_total, shard_ok = _parse_shard(shard_spec)
        if shard_ok == 0 {
            println(string.concat("aeb: invalid --shard value: ", string.concat(shard_spec, " (expected N/M, e.g. 2/8)")))
            exit(1)
        }
        sorted_files = _sort_file_list(files)
        shard_files = list.new()
        shard_seen = map.new()
        sn = list.size(sorted_files)
        si = 0
        while si < sn {
            f, _ = list.get(sorted_files, si)
            rem = si - ((si / shard_total) * shard_total)
            want = shard_idx - 1
            if rem == want {
                _sf = list.add(shard_files, f)
                _ss = map.put(shard_seen, f, "1")
            }
            si = si + 1
        }
        if list.size(shard_files) == 0 {
            println(string.concat("aeb: no targets in shard ", shard_spec))
            return 0
        }
        files = shard_files
        seen = shard_seen
        narrowed = 1
    }

    // --- Rewrite edges file if narrowed (by --since, --scan, and/or --shard) ---
    //
    // Topo-sort + aeb-link read the edges file; if we narrowed the
    // file set above, only emit rows whose first column is in the
    // narrowed set. Deps reference the same paths so unaffected
    // entries are silently dropped.
    if narrowed == 1 {
        narrowed_buf = ""
        nlines = list.size(files)
        nf = 0
        while nf < nlines {
            f, _ = list.get(files, nf)
            ds = string.concat("", "")
            if map.has(file_deps, f) == 1 {
                ds, _ = map.get(file_deps, f)
            }
            row = string.concat(f, " ")
            row = string.concat(row, ds)
            narrowed_buf = string.concat(narrowed_buf, row)
            narrowed_buf = string.concat(narrowed_buf, "\n")
            nf = nf + 1
        }
        werr_n = io.write_file(edges_path, narrowed_buf)
        if werr_n != "" {
            println(string.concat("aeb-main: ", werr_n))
            exit(1)
        }
    }

    // --- Run topo-sort, capture output, write sorted edges file ---
    sorted_raw, serr = build._sh_capture(string.concat(string.concat(topo_sort_bin, " "), edges_path))
    if serr != "" {
        println(string.concat("aeb-main: ", serr))
        exit(1)
    }
    sorted_path = string.concat(build_dir, "/_sorted.txt")
    werr2 = io.write_file(sorted_path, sorted_raw)
    if werr2 != "" {
        println(string.concat("aeb-main: ", werr2))
        exit(1)
    }

    // --- Find the aether toolchain dir (where libaether.a lives) ---
    aether_dir_cmd = string.concat("dirname $(command -v ", string.concat(aether_bin, ")"))
    aether_dir = run_capture(aether_dir_cmd)

    // --- Exec aeb-link to do the build + run ---
    cmd = string.concat(aeb_link_bin, " ")
    cmd = string.concat(cmd, sorted_path)
    cmd = string.concat(cmd, " ")
    cmd = string.concat(cmd, build_dir)
    cmd = string.concat(cmd, " ")
    cmd = string.concat(cmd, aeb_lib_dir)
    cmd = string.concat(cmd, " ")
    cmd = string.concat(cmd, aether_dir)
    cmd = string.concat(cmd, " ")
    cmd = string.concat(cmd, aether_bin)
    cmd = string.concat(cmd, " ")
    cmd = string.concat(cmd, out_bin)
    cmd = string.concat(cmd, " ")
    cmd = string.concat(cmd, root)
    rc = build._sh(cmd)
    exit(rc)
}
