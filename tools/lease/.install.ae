// Install the aeb-lease binary + wrapper — the "place the artifact" node.
// Deps .dist.ae (which builds the binary via aeb), then installs it via
// bldr.install_launcher: copy into ~/.local/share/aeb/tools + write a
// ~/.local/bin/aeb-lease wrapper that pins AEB_HOME and exec's it.
//
//   aeb tools/lease/.install.ae
//
// No with_path(): aeb-lease is a plain tool (mints lease tokens), it doesn't
// shell `aeb <target>` itself, so its wrapper needs no PATH export.
import bldr
import bldr (dep, install_launcher, from_dist)

aeb(cap) {
    bldr.build() {
        dep("tools/lease/.dist.ae")
        bldr.install_launcher("aeb-lease") {
            from_dist("tools/lease")
        }
    }
}
