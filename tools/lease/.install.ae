// Install the aeb-lease binary + wrapper — the lessor-side mint tool. Deps
// .dist.ae (builds it via aeb), then copies it into the install tree and writes
// the bin/aeb-lease wrapper. Mirrors tools/agent/.install.ae; OPT-IN, NOT in
// `make` (minting is the lessor's role, kept off the default build path).
//
//   aeb tools/lease/.install.ae
//
// Prefix hardcoded to ~/.local (skeleton). The wrapper pins AEB_HOME for
// parity with the agent wrapper, though aeb-lease itself only needs the lib.
import bldr
import bldr (dep)
import std.os
import std.io
import std.string

extern println(s: string)

main() {
    b = bldr.start()
    dep(b, "tools/lease/.dist.ae")

    root = bldr.root(b)
    src_bin = string.concat(root, "/target/dist/tools/lease/bin/aeb-lease")

    home = os.getenv("HOME")
    share = string.concat(home, "/.local/share/aeb")
    bindir = string.concat(home, "/.local/bin")
    dst_bin = string.concat(share, "/tools/aeb-lease")
    wrapper = string.concat(bindir, "/aeb-lease")

    _m1 = os.system(string.concat("mkdir -p '", string.concat(share, "/tools'")))
    _m2 = os.system(string.concat("mkdir -p '", string.concat(bindir, "'")))
    rc = os.system(string.concat(string.concat("cp -f '", src_bin), string.concat("' '", string.concat(dst_bin, "'"))))
    if rc != 0 {
        println("aeb-lease install: failed to copy ${src_bin} → ${dst_bin}")
        bldr.fail(b, "aeb-lease install: copy failed (did .dist build it?)")
        return 1
    }

    w = "#!/usr/bin/env bash\n"
    w = string.concat(w, "# aeb-lease wrapper — generated by aeb tools/lease/.install.ae\n")
    w = string.concat(w, string.concat(string.concat("export AEB_HOME=\"", share), "\"\n"))
    w = string.concat(w, string.concat(string.concat("exec \"", dst_bin), "\" \"$@\"\n"))
    werr = io.write_file(wrapper, w)
    if string.length(werr) > 0 {
        println("aeb-lease install: failed to write wrapper ${wrapper}: ${werr}")
        bldr.fail(b, "aeb-lease install: wrapper write failed")
        return 1
    }
    _c = os.system(string.concat("chmod +x '", string.concat(wrapper, "'")))

    println("aeb-lease installed:")
    println("  binary:  ${dst_bin}")
    println("  wrapper: ${wrapper}")
    println("  (mint:  aeb-lease --secret <file> --purpose <p> --ttl-mins N)")
    return 0
}
