// aeb-lease — the LESSOR-side minting tool for agent lease tokens.
//
// The counterpart to the agent's --lease-secret verify path: a holder of the
// shared signing secret mints an ae1.<purpose>.<expiry>.<sig> bearer token,
// scoped to a purpose and expiring after a TTL. The requester then presents it
// to the agent (X-AEB-Token), which verifies (signature + expiry + purpose
// coverage) but NEVER mints — issuance lives here, with the secret holder.
//
//   aeb-lease --secret <file> --purpose preint/phammant/rust --ttl-mins 30
//     → prints the token to stdout (one line, nothing else — pipe/capture it)
//
// Why a separate tool: the agent must not be able to self-issue (the trust
// model's hard rule). Minting is a distinct capability the lessor runs; the
// agent binary has no mint path at all. See lib/agent _lease_mint and
// docs/run-policy-class-and-cloud-leverage.md §trust model.

import std.os
import std.string
import std.io

import agent (_lease_mint, _lease_purpose_valid, _looks_like_token, _secret_strength_ok, _secret_key_material)

extern println(s: string)
extern exit(code: int)
extern aether_args_count() -> int
extern aether_args_get(i: int) -> string

_usage() {
    println("aeb-lease — mint an agent lease token (lessor-side)")
    println("")
    println("Usage: aeb-lease --secret <file> --purpose <p> [--ttl-mins N]")
    println("  --secret FILE   file holding the shared signing secret (matches the agent's --lease-secret)")
    println("  --purpose P     the lease purpose, embedded + signed. Canonical slash-path:")
    println("                  lowercase a-z, 0-9, '-', '_', '/'; optional trailing '/*' (e.g. preint/phammant/rust, ci/aether/main, preint/macos/*).")
    println("  --ttl-mins N    minutes until the lease expires (default 30)")
    println("")
    println("Prints the token (ae1.<purpose>.<expiry-ms>.<sig>) to stdout. The agent VERIFIES it; only the secret holder can mint.")
}

main() {
    argc = aether_args_count()
    secret_file = ""
    purpose = ""
    ttl_mins = 30
    i = 1
    while i < argc {
        a = aether_args_get(i)
        if string.equals(a, "--help") == 1 { _usage(); exit(0) }
        if string.equals(a, "-h") == 1 { _usage(); exit(0) }
        if string.equals(a, "--secret") == 1 { i = i + 1; secret_file = aether_args_get(i) }
        if string.equals(a, "--purpose") == 1 { i = i + 1; purpose = aether_args_get(i) }
        if string.equals(a, "--ttl-mins") == 1 { i = i + 1; ttl_mins = _atoi(aether_args_get(i)) }
        i = i + 1
    }
    if string.length(secret_file) == 0 { println("aeb-lease: --secret <file> required"); exit(2) }
    if string.length(purpose) == 0 { println("aeb-lease: --purpose <p> required"); exit(2) }
    // Enforce the CANONICAL purpose grammar at issuance ("A Purpose in a Token",
    // 2021: constrained-at-issuance, legible everywhere). Rejects spaces,
    // uppercase, ".", unicode, empty segments — anything that would make the
    // purpose ambiguous when read back across systems (or break the "."-split
    // token structure). Fail-closed: a malformed purpose never gets minted.
    pv = _lease_purpose_valid(purpose)
    if string.length(pv) > 0 {
        println("aeb-lease: invalid --purpose: ${pv}"); exit(2)
    }
    secret_raw, serr = io.read_file(secret_file)
    if string.length(serr) > 0 { println("aeb-lease: cannot read --secret file: ${secret_file} (${serr})"); exit(2) }
    secret = string.trim(secret_raw)
    if string.length(secret) == 0 { println("aeb-lease: --secret file is empty: ${secret_file}"); exit(2) }
    // Footgun guard: a --secret that's actually a minted TOKEN ("ae1.…") means
    // a token was pasted into the secret slot (e.g. `aeb-lease … > lease.secret`
    // clobbered the key). The signing secret must be an aeb-secret-v1 envelope.
    if _looks_like_token(secret) == 1 {
        println("aeb-lease: --secret file ${secret_file} contains a LEASE TOKEN (ae1.…), not a signing secret.")
        println("aeb-lease:   The secret is the opaque key that mints+verifies tokens; a token is its OUTPUT.")
        println("aeb-lease:   Generate a real secret:  aeb-keygen > ${secret_file}")
        exit(2)
    }
    // Require the aeb-secret-v1 envelope (greppable marker) and key on the
    // material AFTER it — so a bare blob isn't a usable aeb secret, and the
    // marker is discoverable by a security sweep. Crypto unchanged.
    keymat = _secret_key_material(secret)
    if string.length(keymat) == 0 {
        println("aeb-lease: --secret in ${secret_file} is missing the 'aeb-secret-v1:' marker — not an aeb secret.")
        println("aeb-lease:   Generate one:  aeb-keygen > ${secret_file}   (writes aeb-secret-v1:<random>)")
        exit(2)
    }
    // Entropy floor (hard) on the KEY MATERIAL: a too-short / hand-typed key is
    // guessable. The verifier keys on the same material, so refusing here is
    // safe — a generated secret (aeb-keygen = 64 hex chars) always passes.
    if _secret_strength_ok(keymat) == 0 {
        println("aeb-lease: --secret material in ${secret_file} is too weak (< 32 chars) — guessable.")
        println("aeb-lease:   Generate a strong secret:  aeb-keygen > ${secret_file}")
        exit(2)
    }

    // expiry = now + ttl, in unix-ms. ttl_mins * 60_000. Sign with the MATERIAL.
    ttl_ms = ttl_mins * 60000
    expiry = os.now_unix_ms() + ttl_ms
    token = _lease_mint(keymat, purpose, string.from_long(expiry))
    if string.length(token) == 0 { println("aeb-lease: mint failed (openssl unavailable?)"); exit(1) }
    println(token)
    exit(0)
}

_atoi(s: string) {
    n = string.length(s)
    if n == 0 { return 0 }
    i = 0
    v = 0
    digits = "0123456789"
    while i < n {
        c = string.substring(s, i, i + 1)
        d = string.index_of(digits, c)
        if d < 0 { return v }
        v = v * 10 + d
        i = i + 1
    }
    return v
}
