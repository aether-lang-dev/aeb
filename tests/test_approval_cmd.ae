// Tests for lib/approval/module.ae's Jira approval script renderer.
//
// No live Jira server is required. We validate that the generated
// script references token env vars rather than literal tokens, calls
// Jira's REST API, exports requirements for the Python checker, and
// includes the requested go/no-go checks.

import std.string
import std.io
import std.os
import std.file
import std.fs
import std.list
import std.map
import std.path
import std.dir
import std.cryptography

import std.spec
import approval (jira_check_script, approval_json_check_script, canonicalize_attestation, attestation_evidence_json, _shell_quote)
import bldr (_sh, _sh_capture)

// Native-form tmpdir via the _sh chokepoint. This test writes fake curl/bash
// scripts (native fs.write_atomic), chmods and runs them under a real shell,
// and reads back evidence files natively — all of which must agree on ONE path
// form. On Windows the native C:/.. form is the only one both worlds see, and a
// raw os.system("mkdir -p /tmp/..") routes through cmd.exe and never creates
// it. No-op off Windows.
_mktempdir() {
    raw, _err = _sh_capture("mktemp -d")
    d = string.trim(raw)
    nat, _nerr = _sh_capture("cygpath -m ${d}")
    n = string.trim(nat)
    if string.length(n) > 0 { return n }
    return d
}

// _posix_path(p) — the POSIX/MSYS form ("/c/..") of a native path. Needed when
// a path goes into a ':'-separated PATH: a native "C:/.." carries a colon that
// the shell reads as a PATH separator, so `PATH=C:/msys64/..:$PATH` splits into
// bogus entries "C" and "/msys64/.." and the dir is never searched. cygpath -u
// converts it. No-op off Windows (cygpath absent → passthrough).
_posix_path(p: string) {
    raw, err = _sh_capture("cygpath -u ${p}")
    if string.length(err) > 0 { return p }
    t = string.trim(raw)
    if string.length(t) == 0 { return p }
    return t
}

main() {
    fw = spec.init()

    spec.describe(fw, "approval script renderer") {
        spec.it("renders and executes jira/generic/attestation approval scripts") callback {
            _run(fw)
        }
    }

    spec.run_summary(fw)
}

_run(fw: ptr) {
    spec.assert_str_eq(_shell_quote("abc"), "'abc'", "shell quote simple")
    spec.assert_str_eq(_shell_quote("a'b"), "'a'\\''b'", "shell quote single quote")

    labels = list.new()
    list.add(labels, "release-approved")
    list.add(labels, "cab-ok")
    fields = list.new()
    list.add(fields, "Risk\tAccepted")
    list.add(fields, "customfield_123\tApproved")

    script = jira_check_script("https://jira.example.com", "REL-1234",
                               "JIRA_TOKEN", "Approved",
                               labels, fields,
                               "target/release-approval.json", "30")

    spec.assert_contains(script, "BASE_URL='https://jira.example.com'", "sets base url")
    spec.assert_contains(script, "ISSUE='REL-1234'", "sets issue")
    spec.assert_contains(script, "TOKEN_ENV='JIRA_TOKEN'", "uses token env name")
    token_exp = "TOKEN=\"$"
    token_exp = string.concat(token_exp, "{!TOKEN_ENV:-}\"")
    spec.assert_contains(script, token_exp, "indirect token expansion")
    spec.assert_false(string.index_of(script, "secret-token") >= 0, "does not embed token value")
    issue_exp = "/rest/api/2/issue/$"
    issue_exp = string.concat(issue_exp, "{ISSUE}")
    spec.assert_contains(script, issue_exp, "curl jira REST")
    spec.assert_contains(script, "Authorization: Bearer $TOKEN", "bearer header")
    spec.assert_contains(script, "export REQUIRE_STATUS REQUIRE_LABELS REQUIRE_FIELDS", "exports requirements")
    spec.assert_contains(script, "REQUIRE_STATUS='Approved'", "requires status")
    spec.assert_contains(script, "release-approved\ncab-ok", "requires labels")
    spec.assert_contains(script, "Risk\tAccepted\ncustomfield_123\tApproved", "requires fields")
    spec.assert_contains(script, "json.dump(result, f, sort_keys=True)", "writes evidence")
    spec.assert_contains(script, "approval.jira: NOT APPROVED", "fails no-go")
    spec.assert_contains(script, "approval.jira: approved", "success message")

    root = _mktempdir()
    _sh(string.concat("mkdir -p ", string.concat(root, "/bin")))
    fake_curl = "#!/usr/bin/env bash\nout=\"\"\nwhile [ $# -gt 0 ]; do\n  if [ \"$1\" = \"-o\" ]; then shift; out=\"$1\"; fi\n  shift || true\ndone\ncat > \"$out\" <<'JSON'\n{\"key\":\"REL-1234\",\"fields\":{\"status\":{\"name\":\"Approved\"},\"labels\":[\"release-approved\",\"cab-ok\"],\"Risk\":{\"value\":\"Accepted\"},\"customfield_123\":\"Approved\"}}\nJSON\n"
    curl_path = string.concat(root, "/bin/curl")
    fs.write_atomic(curl_path, fake_curl, string.length(fake_curl))
    _sh(string.concat("chmod +x ", curl_path))
    script_path = string.concat(root, "/check.sh")
    evidence_path = string.concat(root, "/evidence.json")
    run_script = jira_check_script("https://jira.example.com", "REL-1234",
                                   "JIRA_TOKEN", "Approved",
                                   labels, fields,
                                   evidence_path, "30")
    fs.write_atomic(script_path, run_script, string.length(run_script))
    _sh(string.concat("chmod +x ", script_path))
    // POSIX form for the PATH prepend — a native "C:/..bin" would split on its
    // own colon inside a ':'-separated PATH and the fake curl would never be
    // found (the real curl would run instead). See _posix_path.
    bin_posix = _posix_path(string.concat(root, "/bin"))
    cmd = string.concat("PATH=", string.concat(bin_posix, ":$PATH JIRA_TOKEN=fake-token bash "))
    cmd = string.concat(cmd, script_path)
    run_out, run_err = _sh_capture(cmd)
    spec.assert_str_eq(string.trim(run_err), "", "fake jira execution stderr")
    spec.assert_contains(run_out, "approval.jira: approved REL-1234", "fake jira execution approved")
    evidence_body, _rerr = fs.read(evidence_path)
    spec.assert_contains(evidence_body, "\"ok\": true", "evidence ok true")
    spec.assert_contains(evidence_body, "\"issue\": \"REL-1234\"", "evidence issue")

    req_json = list.new()
    list.add(req_json, "change.status\tapproved")
    req_approvers = list.new()
    list.add(req_approvers, "person1")
    list.add(req_approvers, "person2")
    list.add(req_approvers, "person3")
    generic_json = "{\"change\":{\"status\":\"approved\"},\"approvals\":[{\"id\":\"person1\",\"approved_at\":\"2026-05-09T10:00:00Z\",\"status\":\"approved\"},{\"id\":\"person2\",\"approved_at\":\"2026-05-09T10:05:00Z\",\"status\":\"approved\"},{\"id\":\"person3\",\"approved_at\":\"2026-05-09T10:07:00Z\",\"status\":\"approved\"}]}\n"
    generic_src = string.concat(root, "/generic-response.json")
    generic_evidence = string.concat(root, "/generic-evidence.json")
    fs.write_atomic(generic_src, generic_json, string.length(generic_json))
    fetch_cmd = string.concat("cat ", string.concat(generic_src, " > \"$tmp\""))
    generic_script = approval_json_check_script("command", "release-1", fetch_cmd,
                                                req_json, req_approvers,
                                                "approvals", "id", "approved_at",
                                                "status", "approved",
                                                generic_evidence, "30")
    generic_script_path = string.concat(root, "/generic-check.sh")
    fs.write_atomic(generic_script_path, generic_script, string.length(generic_script))
    _sh(string.concat("chmod +x ", generic_script_path))
    generic_out, generic_err = _sh_capture(string.concat("bash ", generic_script_path))
    spec.assert_str_eq(string.trim(generic_err), "", "generic approval stderr")
    spec.assert_contains(generic_out, "approval.command: approved release-1", "generic approval stdout")
    generic_body, _gerr = fs.read(generic_evidence)
    spec.assert_contains(generic_body, "\"id\": \"person1\"", "generic evidence person1")
    spec.assert_contains(generic_body, "\"id\": \"person2\"", "generic evidence person2")
    spec.assert_contains(generic_body, "\"id\": \"person3\"", "generic evidence person3")
    spec.assert_contains(generic_body, "\"approved_at\": \"2026-05-09T10:07:00Z\"", "generic evidence timestamp")

    att_text = "Release: R-2026-05-09  \r\nChange: CHG123456\t\r\nperson1: approved at 2026-05-09T10:00:00Z\nperson2: approved at 2026-05-09T10:05:00Z\nperson3: approved at 2026-05-09T10:07:00Z\n\n\n"
    att_canon = "Release: R-2026-05-09\nChange: CHG123456\nperson1: approved at 2026-05-09T10:00:00Z\nperson2: approved at 2026-05-09T10:05:00Z\nperson3: approved at 2026-05-09T10:07:00Z\n"
    spec.assert_str_eq(canonicalize_attestation(att_text), att_canon, "attestation canonicalizes text")
    verify_prefix = "https://verify.example.com/c"
    digest, derr = cryptography.sha256_hex(att_canon, string.length(att_canon))
    spec.assert_str_eq(derr, "", "attestation sha256 err")
    att_url = string.concat(string.concat(verify_prefix, "/"), digest)
    att_body = attestation_evidence_json("attestation", "CHG123456", digest, att_url, att_canon)
    spec.assert_contains(att_body, "\"attestation_sha256\":", "attestation evidence hash")
    spec.assert_contains(att_body, "\"verify_url\":\"https://verify.example.com/c/", "attestation evidence verify url")
    spec.assert_contains(att_body, "person3: approved at 2026-05-09T10:07:00Z", "attestation evidence claim")
}
