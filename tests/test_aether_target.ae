// Unit tests for the aether.program cross-compile target() helpers in
// lib/aether/module.ae. Pure map/string helpers — no toolchain, no
// filesystem:
//   _node_target(b)         — declared triple or ""
//   _target_flag(b)         — " --target=<triple>" fragment or ""
//   _program_out_suffix(b)  — ".wasm" / ".exe" / "" / host default
//
// (target() cross-compiles via the `ae build` shell-out; these helpers
// decide the flag spliced into that command and the output extension.)

import std.spec
import std.string
import std.map

import aether (_node_target, _target_flag, _program_out_suffix, target)
import bldr (_exe_suffix)

// A builder map carrying a declared target(), the way the closure DSL
// populates it: target(b, triple) writes map key "target".
_with_target(triple: string) {
    b = map.new()
    target(b, triple)
    return b
}

main() {
    fw = spec.init()

    spec.describe(fw, "_node_target") {
        spec.it("empty builder → \"\"") callback {
            spec.assert_str_eq(_node_target(map.new()), "", "empty builder")
        }
        spec.it("null builder → \"\"") callback {
            spec.assert_str_eq(_node_target(null), "", "null builder")
        }
        spec.it("reads declared triple") callback {
            spec.assert_str_eq(_node_target(_with_target("wasm32-wasi")), "wasm32-wasi", "declared triple")
        }
        spec.it("last target() wins") callback {
            b_lw = _with_target("aarch64-linux")
            target(b_lw, "wasm32-wasi")
            spec.assert_str_eq(_node_target(b_lw), "wasm32-wasi", "last wins")
        }
    }

    spec.describe(fw, "_target_flag") {
        spec.it("host build → \"\"") callback {
            spec.assert_str_eq(_target_flag(map.new()), "", "host build")
        }
        spec.it("wasm32-wasi") callback {
            spec.assert_str_eq(_target_flag(_with_target("wasm32-wasi")), " --target=wasm32-wasi", "wasm32-wasi")
        }
        spec.it("aarch64-linux") callback {
            spec.assert_str_eq(_target_flag(_with_target("aarch64-linux")), " --target=aarch64-linux", "aarch64-linux")
        }
    }

    spec.describe(fw, "_program_out_suffix") {
        // Host (no target): whatever the host default is — assert it MATCHES
        // _exe_suffix() rather than hardcoding, so the test is host-agnostic.
        spec.it("host build → host _exe_suffix()") callback {
            spec.assert_true(string.equals(_program_out_suffix(map.new()), _exe_suffix()), "host suffix")
        }
        spec.it("wasm32-wasi → .wasm") callback {
            spec.assert_str_eq(_program_out_suffix(_with_target("wasm32-wasi")), ".wasm", "wasm32-wasi")
        }
        spec.it("wasm (emcc) → .wasm") callback {
            spec.assert_str_eq(_program_out_suffix(_with_target("wasm")), ".wasm", "wasm emcc")
        }
        spec.it("x86_64-windows cross → .exe") callback {
            spec.assert_str_eq(_program_out_suffix(_with_target("x86_64-windows")), ".exe", "windows")
        }
        spec.it("aarch64-linux cross → \"\"") callback {
            spec.assert_str_eq(_program_out_suffix(_with_target("aarch64-linux")), "", "aarch64-linux")
        }
        spec.it("x86_64-macos cross → \"\"") callback {
            spec.assert_str_eq(_program_out_suffix(_with_target("x86_64-macos")), "", "macos")
        }
    }

    return spec.run_summary(fw)
}
