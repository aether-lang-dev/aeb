// std.spec driver with 3 specs, 1 deliberately failing → 2/3 FAIL.
//
// Run under aether.driver_test. A std.spec `run_summary()` writes a structured
// per-it() report to AE_SPEC_REPORT (set by aeb's driver_test spawn), which aeb
// reads via bldr._parse_aeocha_report, so the telemetry JSON records
// tests: {total:3, passed:2, failed:1, errored:0} — the granularity the CI
// daemon wants, not a binary 0/1. main() returns run_summary's verdict, so a
// spec failing makes the process exit non-zero — the driver's rc!=0 branch then
// reports FAILED, which is the path this fixture exists to exercise. (Under
// pre-0.612 std.spec run_summary exit(1)-ed itself; as of 0.612 it RETURNS the
// verdict, so we must return it — a bare call + `return 0` would exit 0 and make
// this deliberately-failing driver look green.)
//
// Migrated off contrib.aeocha (sunset). The modern std.spec API is fw-free in
// the asserts: spec.assert_eq(actual, expected, msg), not assert_eq(fw, …).
import std.spec

main() {
    fw = spec.init()

    spec.describe(fw, "telemetry smoke specs") {
        spec.it("passes first") callback {
            spec.assert_eq(1 + 1, 2, "math one")
        }
        spec.it("fails on purpose") callback {
            spec.assert_eq(1, 2, "intentional failure")
        }
        spec.it("passes last") callback {
            spec.assert_str_eq("ok", "ok", "string eq")
        }
    }

    return spec.run_summary(fw)
}
