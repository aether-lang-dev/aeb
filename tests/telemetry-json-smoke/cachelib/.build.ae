// Cache-hit target for the telemetry-JSON smoke.
//
// aether.program with an extra_source() takes the manual aetherc+gcc
// path (lib/aether _compile_and_link), which is content-address cached.
// First build → cache miss; an unchanged re-build → cache: hit, which
// the telemetry JSON must render as status "cache-hit".
import bldr
import aether
import aether (source, output, extra_source)

aeb(cap) {
    bldr.build() {
        aether.program() {
            source("cachelib.ae")
            output("cachelib")
            extra_source("src/extra.c")
        }
    }
}
