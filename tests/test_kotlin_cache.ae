// Tests for the kotlinc cache-key derivation in lib/kotlin/module.ae.
//
// _cache_key_for_kotlinc(ctx, builder_map, argfile_path, cmd, stdlib_jar)
// reads .kt sources via cache.hash_file, the stdlib jar via
// cache.hash_file, and dep artifacts via bldr._read_dep_artifact, so
// tests stage real fixtures under a tmpdir per case. Same shape as
// test_java_cache.ae. Unlike java's test, this does NOT assert the
// toolchain probe is non-empty: kotlinc is often absent on a dev box,
// and _kotlinc_version() returns "" then — the key is still
// deterministic within a run, which is what we test.
import std.spec
import std.string
import std.os
import std.fs
import std.list
import std.map
import std.path

import bldr
import kotlin (_cache_key_for_kotlinc)

_mktempdir() {
    // Native form on Windows. `mktemp -d` answers in the SHELL's vocabulary
    // ("/tmp/tmp.XXXX" under MSYS), but std.fs/std.dir/std.file are native
    // Win32 calls that cannot see MSYS paths — dir.exists("/tmp/tmp.X") is 0
    // while dir.exists("C:/msys64/tmp/tmp.X") is 1. Without this the suite
    // fails on Windows for an environment reason, not a real defect.
    // No-op off Windows: cygpath is absent, so the value passes through.
    raw, _err = os.exec("mktemp -d")
    d = string.trim(raw)
    // NO quotes, NO redirect: os.exec routes through cmd.exe on Windows,
    // which does not honour POSIX single quotes or `2>/dev/null` — with them
    // the call returns EMPTY and the path silently stays POSIX. Bare works.
    nat, _nerr = os.exec("cygpath -m ${d}")
    n = string.trim(nat)
    if string.length(n) > 0 { return n }
    return d
}

_write(p: string, content: string) {
    fs.write_atomic(p, content, string.length(content))
}

_minimal_ctx(root: string) {
    ctx = map.new()
    map.put(ctx, "deps", list.new())
    map.put(ctx, "root", root)
    return ctx
}

main() {
    fw = spec.init()

    spec.describe(fw, "kotlinc cache-key derivation") {
        spec.it("cache-key lifecycle: determinism, content-addressing, invalidation") callback {
            tdir = _mktempdir()

            // Stage one Kotlin source.
            src = path.join(tdir, "Hello.kt")
            _write(src, "class Hello\n")

            argfile = path.join(tdir, "argfile.txt")
            _write(argfile, string.concat(src, "\n"))

            ctx = _minimal_ctx(tdir)
            b_map = map.new()

            // --- determinism: same inputs → same key ---
            k1, e1 = _cache_key_for_kotlinc(ctx, b_map, argfile, "kotlinc -d /target -cp /target ${src}", "")
            spec.assert_str_eq(e1, "", "key: no error on fresh inputs")
            spec.assert_true(string.length(k1) > 0, "key: non-empty hash")

            k2, _e2 = _cache_key_for_kotlinc(ctx, b_map, argfile, "kotlinc -d /target -cp /target ${src}", "")
            spec.assert_str_eq(k1, k2, "determinism: same inputs → same key")

            // --- src content change → different key ---
            _write(src, "class Hello { fun f() {} }\n")
            k3, _e3 = _cache_key_for_kotlinc(ctx, b_map, argfile, "kotlinc -d /target -cp /target ${src}", "")
            spec.assert_false(string.equals(k1, k3), "invalidation: src content change → different key")

            // --- restore content → original key ---
            _write(src, "class Hello\n")
            k4, _e4 = _cache_key_for_kotlinc(ctx, b_map, argfile, "kotlinc -d /target -cp /target ${src}", "")
            spec.assert_str_eq(k1, k4, "content-addressed: same content → same key")

            // --- cmd string change (flag added) → different key ---
            k_flag, _e5 = _cache_key_for_kotlinc(ctx, b_map, argfile, "kotlinc -d /target -cp /target -Werror ${src}", "")
            spec.assert_false(string.equals(k1, k_flag), "invalidation: cmd string change → different key")

            // --- adding a second source file → different key ---
            src2 = path.join(tdir, "Other.kt")
            _write(src2, "class Other\n")
            argfile2 = path.join(tdir, "argfile2.txt")
            _write(argfile2, string.concat(string.concat(src, "\n"), string.concat(src2, "\n")))
            k_two, _e6 = _cache_key_for_kotlinc(ctx, b_map, argfile2, "kotlinc -d /target -cp /target ${src} ${src2}", "")
            spec.assert_false(string.equals(k1, k_two), "invalidation: extra .kt added → different key")

            // --- argfile order doesn't matter (sources sorted internally) ---
            argfile_rev = path.join(tdir, "argfile_rev.txt")
            _write(argfile_rev, string.concat(string.concat(src2, "\n"), string.concat(src, "\n")))
            k_two_rev, _e7 = _cache_key_for_kotlinc(ctx, b_map, argfile_rev, "kotlinc -d /target -cp /target ${src} ${src2}", "")
            spec.assert_str_eq(k_two, k_two_rev, "ordering: argfile listing order doesn't change key")

            // --- stdlib jar content change → different key (false-hit hazard guard) ---
            stdlib = path.join(tdir, "kotlin-stdlib.jar")
            _write(stdlib, "STDLIB-V1")
            k_s1, _es1 = _cache_key_for_kotlinc(ctx, b_map, argfile, "kotlinc -d /target -cp /target ${src}", stdlib)
            spec.assert_false(string.equals(k1, k_s1), "stdlib: keying on stdlib differs from no-stdlib key")
            _write(stdlib, "STDLIB-V2-different-bytes")
            k_s2, _es2 = _cache_key_for_kotlinc(ctx, b_map, argfile, "kotlinc -d /target -cp /target ${src}", stdlib)
            spec.assert_false(string.equals(k_s1, k_s2), "invalidation: stdlib content change → different key")

            // --- missing src returns error, empty key ---
            bad_argfile = path.join(tdir, "bad.txt")
            _write(bad_argfile, string.concat(path.join(tdir, "nonexistent.kt"), "\n"))
            k_bad, e_bad = _cache_key_for_kotlinc(ctx, b_map, bad_argfile, "kotlinc", "")
            spec.assert_str_eq(k_bad, "", "error path: missing src returns empty key")
            spec.assert_true(string.length(e_bad) > 0, "error path: missing src reports error")

            os.system("rm -rf '${tdir}'")
        }
    }

    return spec.run_summary(fw)
}
