// Tests for lib/javascript's pure command-string builders.
import std.spec
import javascript (npm_install_cmd, npx_jest_cmd, npm_test_cmd)

main() {
    fw = spec.init()

    spec.describe(fw, "npm_install_cmd") {
        spec.it("bare") callback {
            spec.assert_str_eq(npm_install_cmd("/proj", ""),
                "cd '/proj' && npm install", "bare")
        }
        spec.it("with flags") callback {
            spec.assert_str_eq(npm_install_cmd("/proj", "--silent --no-audit --no-fund"),
                "cd '/proj' && npm install --silent --no-audit --no-fund", "flags")
        }
    }

    spec.describe(fw, "npx_jest_cmd") {
        spec.it("bare") callback {
            spec.assert_str_eq(npx_jest_cmd("/proj", ""), "cd '/proj' && npx jest", "bare")
        }
        spec.it("--runInBand") callback {
            spec.assert_str_eq(npx_jest_cmd("/proj", "--runInBand"),
                "cd '/proj' && npx jest --runInBand", "runInBand")
        }
    }

    spec.describe(fw, "npm_test_cmd") {
        spec.it("default runner") callback {
            spec.assert_str_eq(npm_test_cmd("/proj"), "cd '/proj' && npm test", "default")
        }
    }

    return spec.run_summary(fw)
}
