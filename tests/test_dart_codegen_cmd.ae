// Tests for dart.codegen's pure command-string builder AND the
// closure-DSL setters that feed it. Mirror of
// tests/test_python_codegen_cmd.ae.
//
// Two surfaces:
//   1. `dart_codegen_cmd(dart, cwd, driver_form, driver_name, args)`
//      — the pure exec-string assembler. Asserts on the literal
//      `cd '<cwd>' && '<dart>' [run <pkg> | <script>] <args>` shape.
//   2. The grammar setters (codegen_driver, codegen_script,
//      codegen_input, codegen_input_dir, codegen_arg, codegen_output,
//      codegen_cwd, codegen_dart) — each accumulates into the builder
//      map; this drives them on a fresh map and reads the keys back.

import std.spec
import dart (dart_codegen_cmd, codegen_driver, codegen_script,
            codegen_input, codegen_input_dir, codegen_arg,
            codegen_output, codegen_cwd, codegen_dart)
import std.list
import std.map

_list_size_at(m: ptr, k: string) {
    if map.has(m, k) == 0 { return 0 }
    l, _ = map.get(m, k)
    return list.size(l)
}
_list_get_at(m: ptr, k: string, i: int) {
    l, _ = map.get(m, k)
    v, _ = list.get(l, i)
    return v
}
_str_at(m: ptr, k: string) {
    if map.has(m, k) == 0 { return "" }
    v, _ = map.get(m, k)
    return v
}

main() {
    fw = spec.init()

    spec.describe(fw, "dart_codegen_cmd") {
        // --- Package-form driver (build_runner), no args.
        spec.it("package form has 'run <pkg>'") callback {
            args0 = list.new()
            cmd0 = dart_codegen_cmd("dart", "/proj", "package", "build_runner", args0)
            spec.assert_str_eq(cmd0, "cd '/proj' && 'dart' run build_runner", "package form has 'run <pkg>'")
        }

        // --- Script-form driver, no args.
        spec.it("script form omits 'run' and uses script path") callback {
            args1 = list.new()
            cmd1 = dart_codegen_cmd("dart", "/proj", "script", "tool/gen.dart", args1)
            spec.assert_str_eq(cmd1, "cd '/proj' && 'dart' tool/gen.dart", "script form omits 'run' and uses script path")
        }

        // --- The canonical build_runner invocation:
        //     dart run build_runner build --delete-conflicting-outputs
        spec.it("build_runner build with args in order") callback {
            args2 = list.new()
            list.add(args2, "build")
            list.add(args2, "--delete-conflicting-outputs")
            cmd2 = dart_codegen_cmd("dart", "/proj", "package", "build_runner", args2)
            spec.assert_str_eq(cmd2, "cd '/proj' && 'dart' run build_runner build --delete-conflicting-outputs",
                "build_runner build with args in order")
        }

        // --- Custom dart binary (e.g. Flutter-bundled) is quoted.
        spec.it("custom dart bin is quoted") callback {
            args3 = list.new()
            list.add(args3, "build")
            cmd3 = dart_codegen_cmd("/opt/flutter/bin/dart", "/proj", "package", "build_runner", args3)
            spec.assert_str_eq(cmd3, "cd '/proj' && '/opt/flutter/bin/dart' run build_runner build", "custom dart bin is quoted")
        }

        // --- Unknown driver_form → bare dart invocation (defensive; the
        //     builder validates upstream).
        spec.it("missing driver_form → bare dart invocation") callback {
            args4 = list.new()
            cmd4 = dart_codegen_cmd("dart", "/proj", "", "", args4)
            spec.assert_str_eq(cmd4, "cd '/proj' && 'dart'", "missing driver_form → bare dart invocation")
        }

        // --- cwd with spaces is single-quoted.
        spec.it("cwd with spaces is quoted") callback {
            args5 = list.new()
            list.add(args5, "tool/gen.dart")
            cmd5 = dart_codegen_cmd("dart", "/path with spaces/repo", "script", "tool/gen.dart", args5)
            spec.assert_str_eq(cmd5, "cd '/path with spaces/repo' && 'dart' tool/gen.dart tool/gen.dart", "cwd with spaces is quoted")
        }
    }

    // === Setter accumulation tests ====================================

    spec.describe(fw, "codegen setters") {
        // --- codegen_input: list accumulator, order preserved.
        spec.it("codegen_input accumulates, order preserved") callback {
            bm1 = map.new()
            codegen_input(bm1, "lib/a.dart")
            codegen_input(bm1, "lib/b.dart")
            codegen_input(bm1, "lib/c.dart")
            spec.assert_true(_list_size_at(bm1, "codegen_inputs") == 3, "codegen_input accumulates 3")
            spec.assert_str_eq(_list_get_at(bm1, "codegen_inputs", 0), "lib/a.dart", "codegen_input order: first lib/a.dart")
            spec.assert_str_eq(_list_get_at(bm1, "codegen_inputs", 2), "lib/c.dart", "codegen_input order: third lib/c.dart")
        }

        // --- codegen_input_dir: separate list from codegen_input.
        spec.it("codegen_input_dir is a separate list") callback {
            bm2 = map.new()
            codegen_input(bm2, "lib/models.dart")
            codegen_input_dir(bm2, "lib")
            codegen_input_dir(bm2, "lib/src")
            spec.assert_true(_list_size_at(bm2, "codegen_input_dirs") == 2, "input_dir stored in own key")
            spec.assert_true(_list_size_at(bm2, "codegen_inputs") == 1, "input and input_dir don't cross-contaminate")
            spec.assert_str_eq(_list_get_at(bm2, "codegen_input_dirs", 0), "lib", "input_dir entry 0 is lib")
        }

        // --- codegen_arg: list accumulator → CLI tail.
        spec.it("setter-accumulated args produce expected cmd") callback {
            bm3 = map.new()
            codegen_arg(bm3, "build")
            codegen_arg(bm3, "--delete-conflicting-outputs")
            args_acc, _ = map.get(bm3, "codegen_args")
            cmd_acc = dart_codegen_cmd("dart", "/proj", "package", "build_runner", args_acc)
            spec.assert_str_eq(cmd_acc,
                "cd '/proj' && 'dart' run build_runner build --delete-conflicting-outputs",
                "setter-accumulated args produce expected cmd")
        }

        // --- codegen_output: list accumulator.
        spec.it("codegen_output accumulates") callback {
            bm4 = map.new()
            codegen_output(bm4, "lib/models.g.dart")
            codegen_output(bm4, "lib/models.freezed.dart")
            spec.assert_true(_list_size_at(bm4, "codegen_outputs") == 2, "codegen_output accumulates 2")
        }

        // --- Scalar setters: codegen_cwd / codegen_driver / codegen_dart.
        spec.it("scalar setters store scalars") callback {
            bm5 = map.new()
            codegen_cwd(bm5, "..")
            codegen_driver(bm5, "build_runner")
            codegen_dart(bm5, "/opt/flutter/bin/dart")
            spec.assert_str_eq(_str_at(bm5, "codegen_cwd"), "..", "codegen_cwd scalar")
            spec.assert_str_eq(_str_at(bm5, "codegen_driver"), "build_runner", "codegen_driver scalar")
            spec.assert_str_eq(_str_at(bm5, "codegen_dart"), "/opt/flutter/bin/dart", "codegen_dart scalar")
        }

        // --- codegen_driver and codegen_script coexist (driver wins in the
        //     builder, but storage is independent).
        spec.it("driver and script coexist") callback {
            bm6 = map.new()
            codegen_driver(bm6, "build_runner")
            codegen_script(bm6, "tool/gen.dart")
            spec.assert_str_eq(_str_at(bm6, "codegen_driver"), "build_runner", "driver and script coexist")
            spec.assert_str_eq(_str_at(bm6, "codegen_script"), "tool/gen.dart", "script also stored")
        }

        // --- Untouched map: no list keys, empty scalars.
        spec.it("untouched map") callback {
            bm7 = map.new()
            spec.assert_true(_list_size_at(bm7, "codegen_inputs") == 0, "untouched: no codegen_inputs")
            spec.assert_str_eq(_str_at(bm7, "codegen_cwd"), "", "untouched: empty codegen_cwd")
        }
    }

    spec.run_summary(fw)
}
