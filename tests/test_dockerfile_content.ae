// Tests for dockerfile_content() — Dockerfile string generation
import std.spec
import std.map

import container (dockerfile_content)

main() {
    fw = spec.init()

    spec.describe(fw, "dockerfile_content") {
        // No config: default base + default workdir + artifact copy
        spec.it("defaults: base + workdir + artifact copy") callback {
            df1 = dockerfile_content("target/bin/app.jar", null)
            spec.assert_contains(df1, "FROM debian:bookworm-slim", "default base")
            spec.assert_contains(df1, "WORKDIR /app", "default workdir")
            spec.assert_contains(df1, "COPY target/bin/app.jar /app/", "artifact copy")
        }

        // Custom base
        spec.it("custom base") callback {
            opts2 = map_new()
            map_put(opts2, "base", "eclipse-temurin:21-jre-alpine")
            df2 = dockerfile_content("app.jar", opts2)
            spec.assert_contains(df2, "FROM eclipse-temurin:21-jre-alpine", "custom base")
        }

        // Custom workdir
        spec.it("custom workdir") callback {
            opts3 = map_new()
            map_put(opts3, "workdir", "/opt/myapp")
            df3 = dockerfile_content("app.jar", opts3)
            spec.assert_contains(df3, "WORKDIR /opt/myapp", "custom workdir")
        }

        // Entrypoint
        spec.it("entrypoint") callback {
            opts4 = map_new()
            map_put(opts4, "entrypoint", "[\"java\", \"-jar\", \"/app/app.jar\"]")
            df4 = dockerfile_content("app.jar", opts4)
            spec.assert_contains(df4, "ENTRYPOINT [\"java\", \"-jar\", \"/app/app.jar\"]", "entrypoint")
        }

        // Port
        spec.it("single port") callback {
            opts5 = map_new()
            map_put(opts5, "ports", "8080")
            df5 = dockerfile_content("app.jar", opts5)
            spec.assert_contains(df5, "EXPOSE 8080", "single port")
        }

        // Multiple ports
        spec.it("multiple ports") callback {
            opts6 = map_new()
            map_put(opts6, "ports", "8080 9090")
            df6 = dockerfile_content("app.jar", opts6)
            spec.assert_contains(df6, "EXPOSE 8080", "port 8080")
            spec.assert_contains(df6, "EXPOSE 9090", "port 9090")
        }

        // Env var
        spec.it("env var") callback {
            opts7 = map_new()
            map_put(opts7, "env_vars", "JAVA_OPTS=-Xmx512m")
            df7 = dockerfile_content("app.jar", opts7)
            spec.assert_contains(df7, "ENV JAVA_OPTS=-Xmx512m", "env var")
        }

        // Full combo
        spec.it("full combo") callback {
            opts8 = map_new()
            map_put(opts8, "base", "node:22-alpine")
            map_put(opts8, "workdir", "/srv")
            map_put(opts8, "ports", "3000")
            map_put(opts8, "entrypoint", "[\"node\", \"index.js\"]")
            df8 = dockerfile_content("dist/index.js", opts8)
            spec.assert_contains(df8, "FROM node:22-alpine", "combo base")
            spec.assert_contains(df8, "WORKDIR /srv", "combo workdir")
            spec.assert_contains(df8, "EXPOSE 3000", "combo port")
            spec.assert_contains(df8, "ENTRYPOINT [\"node\", \"index.js\"]", "combo entrypoint")
            spec.assert_contains(df8, "COPY dist/index.js /srv/", "combo artifact")
        }
    }

    return spec.run_summary(fw)
}
