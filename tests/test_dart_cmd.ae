// Tests for lib/dart's pure command-string builders and the
// `dart test` summary-line parser.
//
// Covers: pub_get_cmd, analyze_cmd, test_cmd, compile_cmd, and
// _parse_dart_test_counts. All pure (I/O-free) — they assert the
// exact string that would be passed to os.system, or the (pass,fail)
// tuple parsed from captured `dart test` output.

import std.spec
import dart (pub_get_cmd, analyze_cmd, analyze_args_part, test_cmd, test_args_part,
            compile_cmd, _parse_dart_test_counts, _strip_dart_ext)
import std.string
import std.list
import std.map

main() {
    fw = spec.init()

    spec.describe(fw, "pub_get_cmd / analyze_cmd / test_cmd / compile_cmd builders") {
        // --- pub_get_cmd: cd into source_dir, run from there so .dart_tool
        //     resolves. offline flag is appended only when non-empty.
        spec.it("pub_get_cmd + analyze_cmd + test_cmd + compile_cmd strings") callback {
            spec.assert_str_eq(
                pub_get_cmd("dart", "/proj", ""),
                "cd '/proj' && 'dart' pub get", "pub get online")
            spec.assert_str_eq(
                pub_get_cmd("dart", "/proj", " --offline"),
                "cd '/proj' && 'dart' pub get --offline", "pub get offline")
            spec.assert_str_eq(
                pub_get_cmd("/opt/flutter/bin/dart", "/proj", ""),
                "cd '/proj' && '/opt/flutter/bin/dart' pub get", "pub get custom dart bin is quoted")

            // --- analyze_cmd (args_part suffix appended only when non-empty)
            spec.assert_str_eq(
                analyze_cmd("dart", "/proj", ""),
                "cd '/proj' && 'dart' analyze", "analyze runs from source_dir")
            spec.assert_str_eq(
                analyze_cmd("flutter", "/proj", " --no-fatal-infos"),
                "cd '/proj' && 'flutter' analyze --no-fatal-infos", "analyze with flags suffix")

            // --- analyze_args_part: the DSL → `analyze` flag suffix.
            spec.assert_str_eq(analyze_args_part(null), "", "analyze args: nothing set")
            afl = list.new()
            _af1 = list.add(afl, "--no-fatal-infos")
            spec.assert_str_eq(analyze_args_part(afl), " --no-fatal-infos", "analyze args: one flag")
            _af2 = list.add(afl, "--fatal-warnings")
            spec.assert_str_eq(analyze_args_part(afl),
                " --no-fatal-infos --fatal-warnings", "analyze args: two flags")

            // --- test_cmd: arg suffix appended only when non-empty.
            spec.assert_str_eq(
                test_cmd("dart", "/proj", ""),
                "cd '/proj' && 'dart' test", "test no args → dart's own discovery")
            spec.assert_str_eq(
                test_cmd("dart", "/proj", " test/unit"),
                "cd '/proj' && 'dart' test test/unit", "test with path")

            // --- test_args_part: the DSL → `dart test` flag suffix.
            spec.assert_str_eq(test_args_part("", null, null, ""), "", "args: nothing set")
            // The headline: dart.test { concurrency(1) } → `dart test -j 1`.
            spec.assert_str_eq(test_args_part("1", null, null, ""), " -j 1", "args: -j 1")
            nm = list.new()
            _n1 = list.add(nm, "smoke")
            spec.assert_str_eq(test_args_part("2", nm, null, ""),
                " -j 2 --name 'smoke'", "args: -j 2 + --name")
            nm2 = list.new()
            _n2 = list.add(nm2, "a b")
            _n3 = list.add(nm2, "c")
            spec.assert_str_eq(test_args_part("", nm2, null, ""),
                " --name 'a b' --name 'c'", "args: two --name, value quoted")
            fl = list.new()
            _f1 = list.add(fl, "--reporter=expanded")
            spec.assert_str_eq(test_args_part("", null, fl, "test/unit"),
                " --reporter=expanded test/unit", "args: verbatim flag + path")
            // Order: -j, then names, then flags, then positional path last.
            nm3 = list.new()
            _n4 = list.add(nm3, "x")
            fl3 = list.new()
            _f3 = list.add(fl3, "--tags=ffi")
            spec.assert_str_eq(test_args_part("1", nm3, fl3, "test/ffi"),
                " -j 1 --name 'x' --tags=ffi test/ffi", "args: full order")
            // End-to-end through test_cmd — the exact string servirtium's binding runs.
            spec.assert_str_eq(
                test_cmd("dart", "/proj", test_args_part("1", null, null, "")),
                "cd '/proj' && 'dart' test -j 1", "test -j 1 end to end")

            // --- compile_cmd: format + entry + -o output, all single-quoted
            //     where they could carry spaces.
            spec.assert_str_eq(
                compile_cmd("dart", "/proj", "exe", "bin/main.dart", "/proj/target/dart/main"),
                "cd '/proj' && 'dart' compile exe 'bin/main.dart' -o '/proj/target/dart/main'", "compile exe")
            spec.assert_str_eq(
                compile_cmd("dart", "/proj", "js", "web/main.dart", "/proj/target/dart/main.js"),
                "cd '/proj' && 'dart' compile js 'web/main.dart' -o '/proj/target/dart/main.js'", "compile js format")
            spec.assert_str_eq(
                compile_cmd("dart", "/proj", "exe", "bin/main.dart", "/out dir/app"),
                "cd '/proj' && 'dart' compile exe 'bin/main.dart' -o '/out dir/app'", "compile output path with spaces is quoted")

            // --- _strip_dart_ext: derives the default output name.
            spec.assert_str_eq(_strip_dart_ext("main.dart"), "main", "strip .dart")
            spec.assert_str_eq(_strip_dart_ext("server"), "server", "strip leaves non-dart untouched")
            spec.assert_str_eq(_strip_dart_ext("x"), "x", "strip short name untouched")
        }
    }

    spec.describe(fw, "_parse_dart_test_counts") {
        // --- _parse_dart_test_counts: dart's +N/-N summary tokens.
        spec.it("all-pass / mixed / zero / multi-line / no-summary") callback {
            // all-pass: "00:01 +14: All tests passed!"
            pp0, pf0 = _parse_dart_test_counts("00:01 +14: All tests passed!")
            spec.assert_eq(pp0, 14, "all-pass: 14 passed")
            spec.assert_eq(pf0, 0, "all-pass: 0 failed")

            // mixed: "00:02 +13 -1: Some tests failed."
            pp1, pf1 = _parse_dart_test_counts("00:02 +13 -1: Some tests failed.")
            spec.assert_eq(pp1, 13, "mixed: 13 passed")
            spec.assert_eq(pf1, 1, "mixed: 1 failed")

            // zero-pass one-fail: "00:00 +0 -1: Some tests failed."
            pp2, pf2 = _parse_dart_test_counts("00:00 +0 -1: Some tests failed.")
            spec.assert_eq(pp2, 0, "0 passed")
            spec.assert_eq(pf2, 1, "1 failed")

            // Progress lines precede the final summary; the LAST +N / -N wins.
            multi = "00:00 +3: running\n00:01 +9: running\n00:02 +14 -2: Some tests failed."
            pp3, pf3 = _parse_dart_test_counts(multi)
            spec.assert_eq(pp3, 14, "multi-line: final +14 wins over progress +3/+9")
            spec.assert_eq(pf3, 2, "multi-line: final -2 is read")

            // No recognisable summary → (0, 0) rather than crashing.
            pp4, pf4 = _parse_dart_test_counts("no counts here")
            spec.assert_eq(pp4, 0, "no summary → 0 passed")
            spec.assert_eq(pf4, 0, "no summary → 0 failed")
        }
    }

    return spec.run_summary(fw)
}
