// Tests for the command-string builders in lib/aether/module.ae:
//   aetherc_emit_lib_cmd  — `aetherc --emit=lib [--with=...] X.ae X.c`
//   aether_link_cmd       — full gcc link command
import std.spec
import std.string

import aether (aetherc_emit_lib_cmd, aether_link_cmd, _test_bin_stem)

_link_opts(c_path: string, bin_path: string, lib_dir: string, inc_flags: string,
           extras_str: string, extra_link: string, rpath_link: string,
           user_flags: string, dup_flag: string) {
    o = map_new()
    map_put(o, "c_path", c_path)
    map_put(o, "bin_path", bin_path)
    map_put(o, "lib_dir", lib_dir)
    map_put(o, "inc_flags", inc_flags)
    map_put(o, "extras_str", extras_str)
    map_put(o, "extra_link", extra_link)
    map_put(o, "rpath_link", rpath_link)
    map_put(o, "user_flags", user_flags)
    map_put(o, "dup_flag", dup_flag)
    // sysdeps arrives ALREADY RESOLVED — literal `-l…` text that
    // _resolve_sysdeps produced by running pkg-config, not a `$(pkg-config
    // …)` substitution for a shell to expand. Emitting the substitution was
    // portable only while a POSIX shell ran the string; on MSYS2 it reached
    // cmd.exe, which cannot perform it, so the flags came out ABSENT and the
    // link failed on undefined deflate/EVP_*/pcre2_*.
    // (asks/windows-pkg-config-substitution-runs-in-cmd.md)
    map_put(o, "sysdeps", " -lz -lssl -lcrypto -lpcre2-8")
    // Default the fixtures to the real-gcc case so the existing assertions (which
    // expect -fno-ipa-bit-cp) reflect a gcc host. The clang case (no flag) is
    // covered by its own it-block below. _cc_is_real_gcc() gates this at runtime;
    // aether_link_cmd is pure and just reads opts "cc_is_gcc".
    map_put(o, "cc_is_gcc", "1")
    return o
}

main() {
    fw = spec.init()

    spec.describe(fw, "aetherc_emit_lib_cmd") {
        // no caps, no lib dirs
        spec.it("no caps") callback {
            spec.assert_str_eq(
                aetherc_emit_lib_cmd("/usr/bin/aetherc", "lib.ae", "lib_generated.c", "", ""),
                "/usr/bin/aetherc --emit=lib lib.ae lib_generated.c", "no caps")
        }
        // single cap
        spec.it("--with=net") callback {
            spec.assert_str_eq(
                aetherc_emit_lib_cmd("aetherc", "auth.ae", "auth_generated.c", "net", ""),
                "aetherc --emit=lib --with=net auth.ae auth_generated.c", "net")
        }
        spec.it("--with=fs") callback {
            spec.assert_str_eq(
                aetherc_emit_lib_cmd("aetherc", "x.ae", "x.c", "fs", ""),
                "aetherc --emit=lib --with=fs x.ae x.c", "fs")
        }
        // multi-cap
        spec.it("--with=net,fs") callback {
            spec.assert_str_eq(
                aetherc_emit_lib_cmd("aetherc", "x.ae", "x.c", "net,fs", ""),
                "aetherc --emit=lib --with=net,fs x.ae x.c", "net,fs")
        }
        spec.it("all three caps") callback {
            spec.assert_str_eq(
                aetherc_emit_lib_cmd("aetherc", "x.ae", "x.c", "net,fs,os", ""),
                "aetherc --emit=lib --with=net,fs,os x.ae x.c", "net,fs,os")
        }
        // absolute paths
        spec.it("absolute paths") callback {
            spec.assert_str_eq(
                aetherc_emit_lib_cmd("/home/u/.local/bin/aetherc",
                                     "/repo/ae/svnserver/auth.ae",
                                     "/repo/ae/svnserver/auth_generated.c", "net", ""),
                "/home/u/.local/bin/aetherc --emit=lib --with=net /repo/ae/svnserver/auth.ae /repo/ae/svnserver/auth_generated.c",
                "absolute")
        }
        // lib dirs — a regen'd module's imports resolve via --lib (the bug fix):
        // lib_flags sits right after --with= and before the source path.
        spec.it("caps + lib dirs") callback {
            spec.assert_str_eq(
                aetherc_emit_lib_cmd("aetherc", "webdriver.ae", "webdriver_generated.c",
                                     "net,os,fs", " --lib ../selenium_core --lib ../selenium_core/drivermgr"),
                "aetherc --emit=lib --with=net,os,fs --lib ../selenium_core --lib ../selenium_core/drivermgr webdriver.ae webdriver_generated.c",
                "caps+lib")
        }
        // lib dirs without caps — no --with=, lib_flags still placed correctly.
        spec.it("lib dirs, no caps") callback {
            spec.assert_str_eq(
                aetherc_emit_lib_cmd("aetherc", "x.ae", "x.c", "", " --lib ."),
                "aetherc --emit=lib --lib . x.ae x.c", "lib-nocaps")
        }
    }

    // Distinct per-source test binary names, so >1 program_test() per node
    // don't clobber a shared "test_program" output.
    spec.describe(fw, "_test_bin_stem") {
        spec.it("simple .ae") callback {
            spec.assert_str_eq(_test_bin_stem("probe.ae"), "test_probe", "probe")
        }
        spec.it("relative path .ae") callback {
            spec.assert_str_eq(_test_bin_stem("../bidi_slice.ae"), "test_bidi_slice", "relpath")
        }
        spec.it("nested path .ae") callback {
            spec.assert_str_eq(_test_bin_stem("test/live_test.ae"), "test_live_test", "nested")
        }
        spec.it("no .ae extension") callback {
            spec.assert_str_eq(_test_bin_stem("runner"), "test_runner", "noext")
        }
    }

    spec.describe(fw, "aether_link_cmd") {
        // minimal (no extras, no inc, no shared libs)
        spec.it("minimal") callback {
            o1 = _link_opts(
                "target/_aeb/main.c", "target/hello/bin/hello",
                "/usr/lib/aether",
                "", "", "", "", "",
                "-Wl,--allow-multiple-definition")
            spec.assert_str_eq(aether_link_cmd(o1),
                "gcc -O2 -fno-ipa-bit-cp -pipe -w target/_aeb/main.c -L/usr/lib/aether -laether   -o target/hello/bin/hello -pthread -lm -lz -lssl -lcrypto -lpcre2-8 -Wl,--allow-multiple-definition",
                "minimal")
        }

        // sysdeps: NO SHELL SUBSTITUTION on the command line.
        // The link line must carry LITERAL flags. `$(pkg-config …)` is only
        // expanded if a POSIX shell runs the string; on MSYS2 it reached cmd.exe,
        // which cannot perform `$(...)` or honour `2>/dev/null`, so the flags came
        // out ABSENT rather than wrong and the link died on undefined
        // deflate/EVP_*/pcre2_* with pkg-config's stderr swallowed by a redirect
        // cmd.exe never interpreted. Pinning the SHAPE, not the flag values:
        // whatever _resolve_sysdeps returns, nothing shell-evaluated may reach
        // the emitted command. (asks/windows-pkg-config-substitution-runs-in-cmd.md)
        spec.it("no $( ) substitution in the link line") callback {
            o1 = _link_opts(
                "target/_aeb/main.c", "target/hello/bin/hello",
                "/usr/lib/aether",
                "", "", "", "", "",
                "-Wl,--allow-multiple-definition")
            spec.assert_false(string.contains(aether_link_cmd(o1), "$("), "no $( )")
        }
        spec.it("no pkg-config call left on the line") callback {
            o1 = _link_opts(
                "target/_aeb/main.c", "target/hello/bin/hello",
                "/usr/lib/aether",
                "", "", "", "", "",
                "-Wl,--allow-multiple-definition")
            spec.assert_false(string.contains(aether_link_cmd(o1), "pkg-config"), "no pkg-config")
        }
        spec.it("literal sysdeps flags spliced in") callback {
            o1 = _link_opts(
                "target/_aeb/main.c", "target/hello/bin/hello",
                "/usr/lib/aether",
                "", "", "", "", "",
                "-Wl,--allow-multiple-definition")
            spec.assert_contains(aether_link_cmd(o1), "-lz -lssl -lcrypto -lpcre2-8", "literal flags")
        }

        // with one extra source (relative)
        spec.it("one extra_source") callback {
            o2 = _link_opts(
                "target/_aeb/main.c", "target/hello/bin/hello",
                "/usr/lib/aether",
                "", " /repo/contrib/extra.c", "", "", "",
                "-Wl,--allow-multiple-definition")
            spec.assert_str_eq(aether_link_cmd(o2),
                "gcc -O2 -fno-ipa-bit-cp -pipe -w target/_aeb/main.c /repo/contrib/extra.c -L/usr/lib/aether -laether   -o target/hello/bin/hello -pthread -lm -lz -lssl -lcrypto -lpcre2-8 -Wl,--allow-multiple-definition",
                "one extra")
        }

        // with user link_flags
        spec.it("user link_flags") callback {
            o3 = _link_opts(
                "main.c", "out/bin",
                "/lib", "", "", "", "", " -pthread -lm",
                "-Wl,--allow-multiple-definition")
            spec.assert_str_eq(aether_link_cmd(o3),
                "gcc -O2 -fno-ipa-bit-cp -pipe -w main.c -L/lib -laether   -pthread -lm -o out/bin -pthread -lm -lz -lssl -lcrypto -lpcre2-8 -Wl,--allow-multiple-definition",
                "user flags")
        }

        // macOS dup_flag (empty)
        spec.it("macOS (no dup_flag)") callback {
            o4 = _link_opts(
                "main.c", "out/bin", "/lib", "", "", "", "", "", "")
            spec.assert_str_eq(aether_link_cmd(o4),
                "gcc -O2 -fno-ipa-bit-cp -pipe -w main.c -L/lib -laether   -o out/bin -pthread -lm -lz -lssl -lcrypto -lpcre2-8 ",
                "macOS")
        }

        // with shared-lib deps + rpath
        spec.it("shared lib + rpath") callback {
            o5 = _link_opts(
                "main.c", "out/bin", "/lib", "",
                "", "/repo/target/rust/libfoo.so", "-Wl,-rpath,/repo/target/rust", "",
                "-Wl,--allow-multiple-definition")
            spec.assert_str_eq(aether_link_cmd(o5),
                "gcc -O2 -fno-ipa-bit-cp -pipe -w main.c -L/lib -laether /repo/target/rust/libfoo.so -Wl,-rpath,/repo/target/rust -o out/bin -pthread -lm -lz -lssl -lcrypto -lpcre2-8 -Wl,--allow-multiple-definition",
                "shared lib")
        }

        // with -I include block (FHS install)
        spec.it("nested -I block") callback {
            o6 = _link_opts(
                "main.c", "out/bin", "/lib",
                " -I/inc/runtime -I/inc/runtime/actors -I/inc/std",
                "", "", "", "",
                "-Wl,--allow-multiple-definition")
            spec.assert_str_eq(aether_link_cmd(o6),
                "gcc -O2 -fno-ipa-bit-cp -pipe -w -I/inc/runtime -I/inc/runtime/actors -I/inc/std main.c -L/lib -laether   -o out/bin -pthread -lm -lz -lssl -lcrypto -lpcre2-8 -Wl,--allow-multiple-definition",
                "-I block")
        }

        // kitchen sink
        spec.it("kitchen sink") callback {
            o7 = _link_opts(
                "target/_aeb/main.c", "target/hello/bin/svn",
                "/home/u/.local/lib/aether",
                " $(find /home/u/.local/include/aether -type d -print | sed 's|^|-I|')",
                " /repo/contrib/sqlite.c /repo/ae/svn/auth_generated.c",
                "/repo/target/rust/libnative.so",
                "-Wl,-rpath,/repo/target/rust",
                " -pthread",
                "-Wl,--allow-multiple-definition")
            spec.assert_str_eq(aether_link_cmd(o7),
                "gcc -O2 -fno-ipa-bit-cp -pipe -w $(find /home/u/.local/include/aether -type d -print | sed 's|^|-I|') target/_aeb/main.c /repo/contrib/sqlite.c /repo/ae/svn/auth_generated.c -L/home/u/.local/lib/aether -laether /repo/target/rust/libnative.so -Wl,-rpath,/repo/target/rust -pthread -o target/hello/bin/svn -pthread -lm -lz -lssl -lcrypto -lpcre2-8 -Wl,--allow-multiple-definition",
                "kitchen sink")
        }

        // --coverage flag swaps -O2 → -O0 -g and inserts --coverage
        spec.it("coverage replaces -O2 with -O0 -g and inserts --coverage") callback {
            o_cov = _link_opts(
                "main.c", "out/bin", "/lib", "", "", "", "", "", "")
            map_put(o_cov, "coverage", "1")
            spec.assert_str_eq(aether_link_cmd(o_cov),
                "gcc -O0 -g -pipe -w --coverage main.c -L/lib -laether   -o out/bin -pthread -lm -lz -lssl -lcrypto -lpcre2-8 ",
                "coverage on")
        }

        // Coverage="" (or missing) → default -O2, no --coverage.
        spec.it("coverage=\"\" → default -O2, no --coverage") callback {
            o_nocov = _link_opts(
                "main.c", "out/bin", "/lib", "", "", "", "", "", "")
            map_put(o_nocov, "coverage", "")
            spec.assert_str_eq(aether_link_cmd(o_nocov),
                "gcc -O2 -fno-ipa-bit-cp -pipe -w main.c -L/lib -laether   -o out/bin -pthread -lm -lz -lssl -lcrypto -lpcre2-8 ",
                "coverage off")
        }

        // strip_unused=1 → -ffunction-sections -fdata-sections on the compile
        // side + -Wl,--gc-sections before -o. Dead-strips unreferenced C.
        spec.it("strip_unused adds -ffunction-sections/-fdata-sections + --gc-sections") callback {
            o_su = _link_opts(
                "main.c", "out/bin", "/lib", "", "", "", "", "", "")
            map_put(o_su, "strip_unused", "1")
            spec.assert_str_eq(aether_link_cmd(o_su),
                "gcc -O2 -fno-ipa-bit-cp -ffunction-sections -fdata-sections -pipe -w main.c -L/lib -laether   -Wl,--gc-sections -o out/bin -pthread -lm -lz -lssl -lcrypto -lpcre2-8 ",
                "strip_unused on")
        }

        // strip_unused off (missing/"") → no section flags.
        spec.it("strip_unused=\"\" → no section flags") callback {
            o_nosu = _link_opts(
                "main.c", "out/bin", "/lib", "", "", "", "", "", "")
            map_put(o_nosu, "strip_unused", "")
            spec.assert_false(string.contains(aether_link_cmd(o_nosu), "gc-sections"), "no gc-sections")
            spec.assert_false(string.contains(aether_link_cmd(o_nosu), "function-sections"), "no function-sections")
        }

        // -fno-ipa-bit-cp is GCC-ONLY: gated on cc_is_gcc so a clang shim (macOS
        // `gcc`) is never handed a flag it rejects (unknown argument).
        spec.it("cc_is_gcc=\"1\" → -fno-ipa-bit-cp present") callback {
            o_gcc = _link_opts(
                "main.c", "out/bin", "/lib", "", "", "", "", "", "")
            map_put(o_gcc, "cc_is_gcc", "1")
            spec.assert_contains(aether_link_cmd(o_gcc), "-O2 -fno-ipa-bit-cp", "gcc gets the flag")
        }
        spec.it("cc_is_gcc=\"0\" (clang) → plain -O2, NO -fno-ipa-bit-cp") callback {
            o_clang = _link_opts(
                "main.c", "out/bin", "/lib", "", "", "", "", "", "")
            map_put(o_clang, "cc_is_gcc", "0")
            cmd = aether_link_cmd(o_clang)
            spec.assert_contains(cmd, "gcc -O2 -pipe", "clang gets plain -O2")
            spec.assert_false(string.contains(cmd, "fno-ipa-bit-cp"), "no gcc-only flag for clang")
        }
        spec.it("cc_is_gcc missing → plain -O2 (safe default, no gcc-only flag)") callback {
            o_none = _link_opts(
                "main.c", "out/bin", "/lib", "", "", "", "", "", "")
            // _link_opts sets it to "1"; override to unset by putting "".
            map_put(o_none, "cc_is_gcc", "")
            spec.assert_false(string.contains(aether_link_cmd(o_none), "fno-ipa-bit-cp"), "unset → no flag")
        }

        // Coverage WINS over strip_unused: a coverage build must not carry the
        // size-stripping flags (it forces -O0 -g).
        spec.it("coverage suppresses strip_unused's section flags") callback {
            o_both = _link_opts(
                "main.c", "out/bin", "/lib", "", "", "", "", "", "")
            map_put(o_both, "strip_unused", "1")
            map_put(o_both, "coverage", "1")
            cmd = aether_link_cmd(o_both)
            spec.assert_contains(cmd, "-O0 -g", "coverage -O0 -g")
            spec.assert_false(string.contains(cmd, "gc-sections"), "no gc-sections under coverage")
            spec.assert_false(string.contains(cmd, "function-sections"), "no function-sections under coverage")
        }
    }

    return spec.run_summary(fw)
}
