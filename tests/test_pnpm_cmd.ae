// Tests for pnpm.pnpm_spec_from_dep, pnpm.pnpm_add_cmd
import std.spec
import std.list
import std.map

import pnpm (pnpm_spec_from_dep, pnpm_add_cmd, pnpm_install_cmd,
             pnpm_run_cmd, script_arg, frozen_lockfile,
             pnpm_locked_cmd, pnpm_wait_unlocked_cmd, _line_present)

main() {
    fw = spec.init()

    // --- pnpm_spec_from_dep: name:version translation ---
    spec.describe(fw, "pnpm_spec_from_dep") {
        spec.it("simple name:version") callback {
            spec.assert_str_eq(pnpm_spec_from_dep("react:18.3.1"), "react@18.3.1",
                "simple name:version")
        }
        spec.it("scoped @angular/core:11.2.4") callback {
            spec.assert_str_eq(pnpm_spec_from_dep("@angular/core:11.2.4"), "@angular/core@11.2.4",
                "scoped @angular/core:11.2.4")
        }
        spec.it("scoped with caret @types/node:^20") callback {
            spec.assert_str_eq(pnpm_spec_from_dep("@types/node:^20.0.0"), "@types/node@^20.0.0",
                "scoped with caret @types/node:^20")
        }
        spec.it("no colon — pass through") callback {
            spec.assert_str_eq(pnpm_spec_from_dep("react"), "react", "no colon — pass through")
        }
    }

    // --- pnpm_add_cmd: command assembly ---
    spec.describe(fw, "pnpm_add_cmd") {
        spec.it("empty deps list") callback {
            spec.assert_str_eq(pnpm_add_cmd("/proj/.aeb", null),
                "COREPACK_ENABLE_STRICT=0 pnpm add --prefix '/proj/.aeb'", "empty deps list")
        }
        spec.it("zero-size deps") callback {
            deps2 = list_new()
            spec.assert_str_eq(pnpm_add_cmd("/proj/.aeb", deps2),
                "COREPACK_ENABLE_STRICT=0 pnpm add --prefix '/proj/.aeb'", "zero-size deps")
        }
        spec.it("single dep") callback {
            deps3 = list_new()
            list_add(deps3, "react:18.3.1")
            spec.assert_str_eq(pnpm_add_cmd("/proj/.aeb", deps3),
                "COREPACK_ENABLE_STRICT=0 pnpm add --prefix '/proj/.aeb' 'react@18.3.1'", "single dep")
        }
        spec.it("mixed deps (versioned scoped + bare)") callback {
            deps4 = list_new()
            list_add(deps4, "react:18.3.1")
            list_add(deps4, "@angular/core:11.2.4")
            list_add(deps4, "lodash")
            spec.assert_str_eq(pnpm_add_cmd("/proj/.aeb", deps4),
                "COREPACK_ENABLE_STRICT=0 pnpm add --prefix '/proj/.aeb' 'react@18.3.1' '@angular/core@11.2.4' 'lodash'",
                "mixed deps (versioned scoped + bare)")
        }
    }

    // --- pnpm_install_cmd: from-project-package.json shape ---
    spec.describe(fw, "pnpm_install_cmd") {
        spec.it("pnpm install (no frozen-lockfile)") callback {
            spec.assert_str_eq(pnpm_install_cmd("/proj", 0),
                "cd '/proj' && COREPACK_ENABLE_STRICT=0 pnpm install", "pnpm install (no frozen-lockfile)")
        }
        spec.it("pnpm install --frozen-lockfile") callback {
            spec.assert_str_eq(pnpm_install_cmd("/proj", 1),
                "cd '/proj' && COREPACK_ENABLE_STRICT=0 pnpm install --frozen-lockfile", "pnpm install --frozen-lockfile")
        }
    }

    // --- pnpm_run_cmd: scripts from package.json ---
    spec.describe(fw, "pnpm_run_cmd") {
        spec.it("pnpm run bare script") callback {
            spec.assert_str_eq(pnpm_run_cmd("/proj", "lint", ""),
                "cd '/proj' && COREPACK_ENABLE_STRICT=0 pnpm run lint", "pnpm run bare script")
        }
        spec.it("pnpm run script with args (after --)") callback {
            spec.assert_str_eq(pnpm_run_cmd("/proj", "lint", "--fix --quiet"),
                "cd '/proj' && COREPACK_ENABLE_STRICT=0 pnpm run lint -- --fix --quiet",
                "pnpm run script with args (after --)")
        }
    }

    // --- Setter accumulation for the new builders ---
    spec.describe(fw, "setters") {
        spec.it("script_arg accumulates in order") callback {
            bm1 = map_new()
            script_arg(bm1, "--silent")
            script_arg(bm1, "--reporter=tap")
            args1, _ = map_get(bm1, "pnpm_script_args")
            arg0, _ = list_get(args1, 0)
            arg1, _ = list_get(args1, 1)
            spec.assert_str_eq(arg0, "--silent", "script_arg first stored")
            spec.assert_str_eq(arg1, "--reporter=tap", "script_arg second stored")
        }
        spec.it("frozen_lockfile marker set") callback {
            bm2 = map_new()
            frozen_lockfile(bm2)
            frozen_marker, _ = map_get(bm2, "pnpm_frozen_lockfile")
            spec.assert_str_eq(frozen_marker, "1", "frozen_lockfile marker set")
        }
    }

    // --- Concurrency: one shared .aeb prefix, parallel make subprocesses ---
    //
    // `pnpm add` rewrites package.json and prunes node_modules to match, so
    // two adds racing means one reverts the other, and a compile overlapping
    // an add reads a half-relinked tree. Both guards are plain POSIX shell —
    // `sh` is dash on Debian/Ubuntu, so no flock and no bashisms.
    spec.describe(fw, "pnpm locking") {
        spec.it("locked_cmd takes the lock, runs, unlocks, preserves $?") callback {
            spec.assert_str_eq(pnpm_locked_cmd("/t/.lock", "pnpm add x"),
                "__i=0; while [ $__i -lt 900 ]; do mkdir '/t/.lock' 2>/dev/null && break; __i=$((__i+1)); sleep 0.2; done; pnpm add x; __rc=$?; rmdir '/t/.lock' 2>/dev/null; exit $__rc",
                "locked_cmd shape")
        }
        // The spin is BOUNDED: a lock left behind by a killed process must not
        // wedge every later build, so it gives up and proceeds.
        spec.it("wait_unlocked_cmd spins on the lock dir, bounded") callback {
            spec.assert_str_eq(pnpm_wait_unlocked_cmd("/t/.lock"),
                "__i=0; while [ -d '/t/.lock' ] && [ $__i -lt 900 ]; do __i=$((__i+1)); sleep 0.2; done; exit 0",
                "wait_unlocked_cmd shape")
        }
    }

    // --- Which specs have already been added to the shared prefix ---
    // Whole-line matching: the marker decides whether `pnpm add` runs at all,
    // so a substring match would skip installing a package that shares a
    // prefix with one already there.
    spec.describe(fw, "_line_present") {
        spec.it("matches a whole line") callback {
            spec.assert_eq(_line_present("react@18.3.1\ntslib@2.8.1\n", "tslib@2.8.1"), 1,
                "whole line matches")
        }
        spec.it("does not match a prefix of a longer line") callback {
            spec.assert_eq(_line_present("react-dom@18.3.1\n", "react"), 0,
                "react does not match react-dom")
        }
        spec.it("distinguishes versions") callback {
            spec.assert_eq(_line_present("vite@5.1.0\n", "vite@5"), 0,
                "vite@5 does not match vite@5.1.0")
        }
        spec.it("empty marker matches nothing") callback {
            spec.assert_eq(_line_present("", "react@18.3.1"), 0, "empty marker")
        }
    }

    return spec.run_summary(fw)
}
