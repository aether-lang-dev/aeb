// Tests for dart.pubspec_yaml_content(). Mirrors tests/test_gleam_toml.ae.
import std.spec
import std.list
import std.map

import dart (pubspec_yaml_content)

main() {
    fw = spec.init()
    spec.describe(fw, "pubspec_yaml_content") {
        spec.it("minimal defaults") callback {
            t = pubspec_yaml_content(null)
            spec.assert_contains(t, "name: app", "default name")
            spec.assert_contains(t, "version: 0.1.0", "default version")
            spec.assert_contains(t, "sdk: \">=3.0.0 <4.0.0\"", "sdk constraint")
            spec.assert_false(string_contains(t, "dependencies:"), "no dependencies when none")
        }
        spec.it("explicit name + version") callback {
            o = map_new()
            map_put(o, "manifest_name", "selenium")
            map_put(o, "manifest_version", "0.8.0")
            t = pubspec_yaml_content(o)
            spec.assert_contains(t, "name: selenium", "explicit name")
            spec.assert_contains(t, "version: 0.8.0", "explicit version")
        }
        spec.it("dependencies") callback {
            o = map_new()
            deps = list_new()
            list_add(deps, "http~^1.0.0")
            map_put(o, "manifest_pub_deps", deps)
            t = pubspec_yaml_content(o)
            spec.assert_contains(t, "dependencies:", "has dependencies")
            spec.assert_contains(t, "  http: \"^1.0.0\"", "dep entry")
        }
    }
    return spec.run_summary(fw)
}
