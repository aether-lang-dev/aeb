// Unit tests for the remote-aeb agent scope-decision + wire helpers.
// All pure (I/O-free) — no networking, no agent process.
//
// Design: docs/design/run-policy-class-and-cloud-leverage.md

import std.spec
import agent (_scope_glob_match, _scope_accepts, _has_free_slot,
              _decision, dispatch_request_json, dispatch_request_json_ex, dispatch_reply_json,
              _json_field, run_on, max_jobs, accept_scope,
              _parse_tokens, _bearer_strip, ping_json, ping_json_ex,
              _parse_pool, _pool_url_of, _pool_token_of,
              _veto_rule_field, _veto_scan_cmd, _veto_default_rules, _veto_scan_root,
              _image_match,
              _lease_mint, _lease_verify, _lease_verify_any, _lease_field, _lease_sign,
              _lease_purpose_valid, _looks_like_token, _secrets_have_token,
              _secret_strength_ok, _secrets_weak_line,
              _secret_marker, _secret_key_material, _secrets_no_marker_line,
              _csv_contains, _mode_offered, _branch_allowed, _autoclone_allowed)
import std.string
import std.list
import std.map
import std.fs

main() {
    fw = spec.init()

    spec.describe(fw, "_scope_glob_match") {
        spec.it("glob / prefix / exact matching") callback {
            spec.assert_true(_scope_glob_match("*", "ci/aether/main"), "glob * matches anything")
            spec.assert_true(_scope_glob_match("preint/*", "preint/phammant/feat"), "preint/* matches preint/x")
            spec.assert_true(_scope_glob_match("preint/*", "preint"), "preint/* matches bare preint")
            spec.assert_true(1 - _scope_glob_match("preint/*", "ci/aether/main"), "preint/* rejects ci/x")
            spec.assert_true(1 - _scope_glob_match("preint/*", "preintXYZ"),
                "preint/* rejects preintXYZ (prefix not boundary)")
            spec.assert_true(_scope_glob_match("preint", "preint"), "exact match")
            spec.assert_true(1 - _scope_glob_match("preint", "ci"), "exact mismatch")
        }
    }

    spec.describe(fw, "_image_match: per-dispatch image vs --allow-image glob (run_on=podman)") {
        spec.it("glob / exact / prefix-boundary") callback {
            spec.assert_true(_image_match("*", "aeb-tc:rust"), "image * allows anything")
            spec.assert_true(_image_match("aeb-tc:*", "aeb-tc:rust"), "aeb-tc:* allows aeb-tc:rust")
            spec.assert_true(_image_match("aeb-tc:*", "aeb-tc:jdk21"), "aeb-tc:* allows aeb-tc:jdk21")
            spec.assert_true(_image_match("aeb-tc:*", "aeb-tc:"), "aeb-tc:* allows bare prefix aeb-tc:")
            spec.assert_true(1 - _image_match("aeb-tc:*", "evil/exfil:latest"),
                "aeb-tc:* rejects other-registry image")
            spec.assert_true(_image_match("aeb-tc:jdk21", "aeb-tc:jdk21"), "exact image allowed")
            spec.assert_true(1 - _image_match("aeb-tc:jdk21", "aeb-tc:rust"),
                "exact image mismatch rejected")
            spec.assert_true(1 - _image_match("aeb-tc:*", "aeb"),
                "prefix shorter than glob rejected (aeb not aeb-tc:)")
        }
    }

    spec.describe(fw, "_scope_accepts") {
        spec.it("no accept_scope => open") callback {
            open_scope = map.new()
            spec.assert_true(_scope_accepts(open_scope, "anything/goes"),
                "scope with no accept_scope accepts all")
        }
        spec.it("with globs") callback {
            s = map.new()
            accept_scope(s, "preint/*")
            accept_scope(s, "adhoc/phammant/*")
            spec.assert_true(_scope_accepts(s, "preint/x"), "accepts preint/x")
            spec.assert_true(_scope_accepts(s, "adhoc/phammant/exp7"), "accepts adhoc/phammant/exp7")
            spec.assert_true(1 - _scope_accepts(s, "ci/aether/main"), "rejects ci/main")
        }
    }

    spec.describe(fw, "_has_free_slot") {
        spec.it("bounded / unbounded slots") callback {
            spec.assert_true(_has_free_slot(99, ""), "unbounded ('') always free")
            spec.assert_true(_has_free_slot(99, "0"), "cap 0 = unbounded")
            spec.assert_true(1 - _has_free_slot(2, "2"), "2/2 busy")
            spec.assert_true(_has_free_slot(1, "2"), "1/2 free")
        }
    }

    spec.describe(fw, "_decision: accept / busy / reject") {
        spec.it("scope + slot combine, reject beats busy") callback {
            sc = map.new()
            accept_scope(sc, "preint/*")
            max_jobs(sc, 2)
            spec.assert_str_eq(_decision(sc, "preint/x", 1), "accept", "in-scope + slot => accept")
            spec.assert_str_eq(_decision(sc, "preint/x", 2), "busy", "in-scope + no slot => busy")
            spec.assert_str_eq(_decision(sc, "ci/main", 0), "reject", "out-of-scope => reject")
            // reject takes precedence over busy: out-of-scope AND full => reject
            spec.assert_str_eq(_decision(sc, "ci/main", 9), "reject", "out-of-scope + full => reject (not busy)")
        }
    }

    spec.describe(fw, "wire payloads round-trip through the skeleton extractor") {
        spec.it("dispatch_request_json fields") callback {
            req = dispatch_request_json("G123", "app/.tests.ae", "preint/x", "main", "abc123", "")
            spec.assert_str_eq(_json_field(req, "guid"), "G123", "req guid")
            spec.assert_str_eq(_json_field(req, "target"), "app/.tests.ae", "req target")
            spec.assert_str_eq(_json_field(req, "purpose"), "preint/x", "req purpose")
            spec.assert_str_eq(_json_field(req, "ref"), "main", "req ref")
            spec.assert_str_eq(_json_field(req, "hash"), "abc123", "req hash")
            spec.assert_str_eq(_json_field(req, "patch_b64"), "", "req patch_b64 empty")
            req2 = dispatch_request_json("G2", "t.ae", "p", "", "", "YmFzZTY0")
            spec.assert_str_eq(_json_field(req2, "patch_b64"), "YmFzZTY0", "req2 patch_b64")
            // 6-field form omits the optional image/command (agent sees "").
            spec.assert_str_eq(_json_field(req, "image"), "", "req omits image when unset")
            spec.assert_str_eq(_json_field(req, "command"), "", "req omits command when unset")
        }

        spec.it("_ex form: optional image (podman) + command (vm raw build)") callback {
            reqi = dispatch_request_json_ex("G3", "t.ae", "preint", "", "", "", "aeb-tc:rust", "")
            spec.assert_str_eq(_json_field(reqi, "image"), "aeb-tc:rust", "ex image present")
            spec.assert_str_eq(_json_field(reqi, "command"), "", "ex command absent when empty")
            reqc = dispatch_request_json_ex("G4", "t.ae", "preint", "", "", "", "", "./build.sh ex.ae build/ex")
            spec.assert_str_eq(_json_field(reqc, "command"), "./build.sh ex.ae build/ex", "ex command present")
            spec.assert_str_eq(_json_field(reqc, "image"), "", "ex image absent when empty")
            spec.assert_str_eq(_json_field(reqc, "guid"), "G4", "ex still carries guid")
        }

        spec.it("dispatch_reply_json + missing field") callback {
            rep = dispatch_reply_json("G123", "done", "fail")
            spec.assert_str_eq(_json_field(rep, "guid"), "G123", "reply guid")
            spec.assert_str_eq(_json_field(rep, "status"), "done", "reply status")
            spec.assert_str_eq(_json_field(rep, "result"), "fail", "reply result")
            spec.assert_str_eq(_json_field(rep, "nope"), "", "missing field => empty")
        }
    }

    spec.describe(fw, "_parse_tokens + _bearer_strip") {
        spec.it("_parse_tokens: generic line-set parser (used to count --lease-secrets)") callback {
            tf = "# comment line\nsecret-alpha\n\nsecret-bravo\n  trimmed-secret  \n"
            toks = _parse_tokens(tf)
            spec.assert_true(map.size(toks) == 3, "parse: 3 non-comment/blank lines")
            spec.assert_true(map.has(toks, "secret-alpha") == 1, "parse: keeps secret-alpha")
            spec.assert_true(map.has(toks, "trimmed-secret") == 1, "parse: trims surrounding whitespace")
            spec.assert_true(1 - map.has(toks, "# comment line"), "parse: drops the comment line")
        }
        spec.it("_bearer_strip: handles both 'Bearer X' and a raw value") callback {
            spec.assert_str_eq(_bearer_strip("Bearer s3cr3t-alice"), "s3cr3t-alice", "bearer strip prefix")
            spec.assert_str_eq(_bearer_strip("s3cr3t-ci"), "s3cr3t-ci", "bearer strip raw value")
            spec.assert_str_eq(_bearer_strip("  Bearer  s3cr3t-ci  "), "s3cr3t-ci", "bearer strip trims")
        }
    }

    spec.describe(fw, "ping_json identity + capability descriptor") {
        spec.it("base ping_json fields") callback {
            pj = ping_json("linux", "preint/*", "false", "2", "required")
            spec.assert_str_eq(_json_field(pj, "agent"), "aeb-agent", "ping agent field")
            spec.assert_str_eq(_json_field(pj, "platform"), "linux", "ping platform")
            spec.assert_str_eq(_json_field(pj, "accept"), "preint/*", "ping accept")
            spec.assert_str_eq(_json_field(pj, "auth"), "required", "ping auth")
            spec.assert_true(string.index_of(pj, "\"busy\":false") >= 0, "ping carries busy:false")
            spec.assert_true(string.index_of(pj, "\"max_jobs\":2") >= 0, "ping carries max_jobs:2")
            // empty max_jobs renders 0 (unbounded)
            pj0 = ping_json("linux", "*", "false", "", "open")
            spec.assert_true(string.index_of(pj0, "\"max_jobs\":0") >= 0, "ping empty max_jobs -> 0")
            // base ping_json omits the optional version fields
            spec.assert_str_eq(_json_field(pj, "aeb_version"), "", "ping omits aeb_version when base form")
            spec.assert_str_eq(_json_field(pj, "aether_version"), "", "ping omits aether_version when base form")
        }
        spec.it("ping_json_ex: toolchain versions for the originator") callback {
            pjv = ping_json_ex("macos", "preint/*", "false", "1", "required",
                               "aeb 0.0.0-dev+abc123 (git v0.160)", "Aether Compiler v0.256.0")
            spec.assert_str_eq(_json_field(pjv, "aeb_version"), "aeb 0.0.0-dev+abc123 (git v0.160)", "ex aeb_version")
            spec.assert_str_eq(_json_field(pjv, "aether_version"), "Aether Compiler v0.256.0", "ex aether_version")
            spec.assert_str_eq(_json_field(pjv, "platform"), "macos", "ex still carries platform")
            // empty versions are omitted (probe-failure degrades cleanly)
            pjv0 = ping_json_ex("linux", "*", "false", "", "open", "", "")
            spec.assert_str_eq(_json_field(pjv0, "aeb_version"), "", "ex omits empty aeb_version")
            spec.assert_str_eq(_json_field(pjv0, "aether_version"), "", "ex omits empty aether_version")
        }
    }

    spec.describe(fw, "agent pool parsing (the --agents file)") {
        spec.it("dash-separated pool lines") callback {
            pool = "# my agents\nhttp://192.168.0.57:9440 - ping-secret-123\n\nhttp://mac.local:9440 - mac-tok\nhttp://nostoken:9440\n"
            lines = _parse_pool(pool)
            spec.assert_true(list.size(lines) == 3, "pool: 3 non-comment lines")
            l0, _ = list.get(lines, 0)
            spec.assert_str_eq(_pool_url_of(l0), "http://192.168.0.57:9440", "pool line0 url")
            spec.assert_str_eq(_pool_token_of(l0), "ping-secret-123", "pool line0 token")
            l1, _ = list.get(lines, 1)
            spec.assert_str_eq(_pool_url_of(l1), "http://mac.local:9440", "pool line1 url")
            spec.assert_str_eq(_pool_token_of(l1), "mac-tok", "pool line1 token")
            l2, _ = list.get(lines, 2)
            spec.assert_str_eq(_pool_url_of(l2), "http://nostoken:9440", "pool line2 url (no token)")
            spec.assert_str_eq(_pool_token_of(l2), "", "pool line2 token empty")
            spec.assert_true(1, "pool skips comments + blanks")
        }
        spec.it("TAB separator (scripted printf form)") callback {
            // TAB separator (the natural scripted form: printf '%s\t%s'). The historic
            // bug: only " - " was accepted, so a tab-separated line returned the WHOLE
            // line as the URL (token mashed in) + an empty token → silent lease failure.
            tpool = "http://192.168.0.57:9440\tae1.preint.123.deadbeef\nhttp://mac.local:9440\tmac-tok\n"
            tlines = _parse_pool(tpool)
            spec.assert_true(list.size(tlines) == 2, "tab pool: 2 lines")
            tl0, _ = list.get(tlines, 0)
            spec.assert_str_eq(_pool_url_of(tl0), "http://192.168.0.57:9440", "tab line0 url")
            spec.assert_str_eq(_pool_token_of(tl0), "ae1.preint.123.deadbeef", "tab line0 token")
            tl1, _ = list.get(tlines, 1)
            spec.assert_str_eq(_pool_url_of(tl1), "http://mac.local:9440", "tab line1 url")
            spec.assert_str_eq(_pool_token_of(tl1), "mac-tok", "tab line1 token")
            // A token containing " - " is NOT mis-split when a tab is present (tab wins).
            mixed = "http://h:9440\tab1 - cd"
            spec.assert_str_eq(_pool_url_of(mixed), "http://h:9440", "tab beats dash url")
            spec.assert_str_eq(_pool_token_of(mixed), "ab1 - cd", "tab beats dash token")
        }
    }

    spec.describe(fw, "Tier-A veto: pure rule helpers (docs/design/build-veto-and-sandbox.md)") {
        spec.it("_veto_rule_field: tab-split field extraction") callback {
            row = "aws-akid\tpatch\tAKIA[0-9A-Z]\\{16\\}\tpatch introduces an AWS access-key id"
            spec.assert_str_eq(_veto_rule_field(row, 0), "aws-akid", "veto field id")
            spec.assert_str_eq(_veto_rule_field(row, 1), "patch", "veto field scope")
            spec.assert_str_eq(_veto_rule_field(row, 3), "patch introduces an AWS access-key id", "veto field reason")
            spec.assert_str_eq(_veto_rule_field(row, 9), "", "veto field out-of-range empty")
        }
        spec.it("_veto_scan_cmd: scope → scan command") callback {
            // tree-scope → recursive grep over repo.
            spec.assert_str_eq(_veto_scan_cmd("tree", "BEGIN RSA PRIVATE KEY", "/srv/repo", ""),
                "grep -rqI -e 'BEGIN RSA PRIVATE KEY' '/srv/repo' 2>/dev/null", "veto cmd tree-scope")
            // patch-scope → grep the patch file only.
            spec.assert_str_eq(_veto_scan_cmd("patch", "AKIA", "/srv/repo", "/tmp/p.diff"),
                "grep -qI -e 'AKIA' '/tmp/p.diff' 2>/dev/null", "veto cmd patch-scope")
            // patch-scope with NO patch → "" (caller skips the rule).
            spec.assert_str_eq(_veto_scan_cmd("patch", "AKIA", "/srv/repo", ""), "", "veto cmd patch-scope no patch")
            // file-scope → find-by-name existence check (exit 0 = file present).
            spec.assert_str_eq(_veto_scan_cmd("file", "binding.gyp", "/srv/repo", ""),
                "find '/srv/repo' -name 'binding.gyp' 2>/dev/null | grep -q .", "veto cmd file-scope")
            // patchpath-scope → grep the diff's file headers for the path pattern.
            spec.assert_str_eq(_veto_scan_cmd("patchpath", "\\.github/", "/srv/repo", "/tmp/p.diff"),
                "grep -qE '^(\\+\\+\\+ |diff --git ).*\\.github/' '/tmp/p.diff' 2>/dev/null", "veto cmd patchpath-scope")
            // patchpath with NO patch → "" (skip).
            spec.assert_str_eq(_veto_scan_cmd("patchpath", "x", "/srv/repo", ""), "", "veto cmd patchpath no patch")
        }
        spec.it("_veto_scan_root: narrow tree/file scans to target subtree") callback {
            // Pure-logic branches return `repo` (no filesystem narrowing) for the
            // cases where narrowing isn't safe/meaningful:
            spec.assert_str_eq(_veto_scan_root("/srv/repo", ""), "/srv/repo", "scan-root empty target → repo")
            spec.assert_str_eq(_veto_scan_root("/srv/repo", "rust/components"), "/srv/repo", "scan-root non-.ae target → repo")
            spec.assert_str_eq(_veto_scan_root("/srv/repo", ".build.ae"), "/srv/repo", "scan-root bare .build.ae → repo")
            spec.assert_str_eq(_veto_scan_root("/srv/repo", "./.build.ae"), "/srv/repo", "scan-root ./.build.ae → repo")
            // Positive: a real existing dir narrows to repo/<dir>. /tmp always exists, so
            // repo="/" + target="tmp/x/.build.ae" → "/tmp/x" IF it exists; build it.
            _mk = fs.mkdir_p("/tmp/aeb_veto_scope_test/sub")
            spec.assert_str_eq(_veto_scan_root("/tmp/aeb_veto_scope_test", "sub/.build.ae"),
                "/tmp/aeb_veto_scope_test/sub", "scan-root real dir narrows")
            // Nonexistent target dir → fail-safe back to repo (never narrow to a path
            // that isn't there, which would scan nothing).
            spec.assert_str_eq(_veto_scan_root("/tmp/aeb_veto_scope_test", "nope/.build.ae"),
                "/tmp/aeb_veto_scope_test", "scan-root missing dir → repo")
            _cl = fs.delete("/tmp/aeb_veto_scope_test/sub")
        }
        spec.it("_veto_default_rules: built-in list is non-empty + well-formed") callback {
            drules = _veto_default_rules()
            spec.assert_true(1 - _lt(list.size(drules), 1), "veto default rules present")
            r0, _ = list.get(drules, 0)
            spec.assert_str_eq(_veto_rule_field(r0, 0), "secret-rsa", "veto default rule0 id")
            spec.assert_true(1 - _streq(_veto_rule_field(r0, 3), ""), "veto default rule0 has reason")

            // June-2026 supply-chain rules are present + well-formed. Find them by id
            // and assert their scope/reason are set (scan the list).
            spec.assert_true(1 - _lt(list.size(drules), 8),
                "default rules include the June-2026 install-script class (>= 8 rules)")
            spec.assert_true(_has_rule_with_scope(drules, "npm-binding-gyp", "file"), "binding.gyp rule is file-scope")
            spec.assert_true(_has_rule_with_scope(drules, "npm-install-hook", "tree"), "install-hook rule is tree-scope")
            spec.assert_true(_has_rule_with_scope(drules, "curl-pipe-sh", "tree"), "curl-pipe-sh rule is tree-scope")
            spec.assert_true(_has_rule_with_scope(drules, "patch-extern", "patch"), "patch-extern rule is patch-scope")
        }
    }

    spec.describe(fw, "Lease tokens: HMAC-signed, purpose-bound, expiring") {
        spec.it("mint/verify, tamper, expiry, purpose binding") callback {
            // Fixed clock + fixed secret so tests are deterministic (no wall clock).
            // `secret` is the ENVELOPE (what the agent verifies with); `mat` is the key
            // material (what the lessor mints with) — mirrors the real tools.
            secret = "aeb-secret-v1:shhh-lessor-secret-material-xyz-32+"
            mat = _secret_key_material(secret)
            now = 1000000000000  // a fixed "now" in unix-ms
            future = "1000000600000"  // now + 10 min
            past   = "999999990000"   // now - ~10s

            // A well-formed lease for preint/phammant/rust, not expired, verifies ("").
            good = _lease_mint(mat, "preint/phammant/rust", future)
            spec.assert_str_eq(_lease_verify(secret, good, now, "preint/phammant/rust"), "", "valid lease verifies")

            // Tamper: flip the purpose in the token but keep the old signature => bad sig.
            forged = _lease_mint(mat, "preint/phammant/rust", future)
            // rebuild with a DIFFERENT purpose but splice the ORIGINAL sig back on.
            orig_sig = _lease_field(good, 3)
            tampered = "ae1.ci/aether/main.${future}.${orig_sig}"
            spec.assert_true(1 - _streq(_lease_verify(secret, tampered, now, "ci/aether/main"), ""),
                "tampered purpose => bad signature (rejected)")

            // Wrong secret => bad signature.
            spec.assert_true(1 - _streq(_lease_verify("not-the-secret", good, now, "preint/phammant/rust"), ""),
                "wrong secret => rejected")

            // Expired lease => rejected (even though signature is valid).
            expired = _lease_mint(mat, "preint/phammant/rust", past)
            spec.assert_true(1 - _streq(_lease_verify(secret, expired, now, "preint/phammant/rust"), ""),
                "expired lease => rejected")

            // Purpose binding: a token for preint/* COVERS preint/rust (glob).
            broad = _lease_mint(mat, "preint/*", future)
            spec.assert_str_eq(_lease_verify(secret, broad, now, "preint/rust"), "", "preint/* token covers preint/rust")
            // ...but a token for preint/rust does NOT cover a different purpose.
            narrow = _lease_mint(mat, "preint/rust", future)
            spec.assert_true(1 - _streq(_lease_verify(secret, narrow, now, "ci/main"), ""),
                "preint/rust token does NOT cover ci/main (purpose-bound)")

            // DEFENSE-IN-DEPTH: a VALIDLY-SIGNED but NON-CANONICAL purpose (as a rogue/
            // patched minter could produce) is rejected at VERIFY, not just at mint. The
            // verifier re-applies the grammar at the trust boundary.
            rogue_upper = _lease_mint(mat, "preint/Rust", future)   // uppercase R
            spec.assert_true(1 - _streq(_lease_verify(secret, rogue_upper, now, "preint/Rust"), ""),
                "verify rejects signed non-canonical purpose (uppercase)")
            rogue_space = _lease_mint(mat, "preint/my rust", future)  // space
            spec.assert_true(1 - _streq(_lease_verify(secret, rogue_space, now, "preint/my rust"), ""),
                "verify rejects signed non-canonical purpose (space)")
            // a canonical purpose with a trailing /* scope still verifies fine.
            scoped = _lease_mint(mat, "preint/macos/*", future)
            spec.assert_str_eq(_lease_verify(secret, scoped, now, "preint/macos/x"), "", "verify accepts canonical /* scope")

            // No secret configured => fail-closed.
            spec.assert_true(1 - _streq(_lease_verify("", good, now, "preint/phammant/rust"), ""),
                "empty secret => fail-closed")
            // Empty/garbage token => rejected.
            spec.assert_true(1 - _streq(_lease_verify(secret, "", now, "preint/rust"), ""),
                "empty token => rejected")
            spec.assert_true(1 - _streq(_lease_verify(secret, "garbage.foo.bar.baz", now, "preint/rust"), ""),
                "non-ae1 token => rejected")

            // Field accessor + signing are stable (mint is deterministic for fixed inputs).
            spec.assert_str_eq(_lease_field(good, 0), "ae1", "lease field 0 is the ae1 tag")
            spec.assert_str_eq(_lease_field(good, 1), "preint/phammant/rust", "lease field 1 is the purpose")
            spec.assert_str_eq(_lease_sign(secret, "preint/rust", future),
                _lease_sign(secret, "preint/rust", future), "sign is deterministic")
        }

        spec.it("_lease_purpose_valid: canonical purpose grammar (mint-time gate)") callback {
            // Valid canonical slash-paths return "".
            spec.assert_str_eq(_lease_purpose_valid("preint/phammant/rust"), "", "valid: preint/phammant/rust")
            spec.assert_str_eq(_lease_purpose_valid("ci/aether/main"), "", "valid: ci/aether/main")
            spec.assert_str_eq(_lease_purpose_valid("preint"), "", "valid: single segment")
            spec.assert_str_eq(_lease_purpose_valid("preint/phammant/*"), "", "valid: trailing /* scope")
            spec.assert_str_eq(_lease_purpose_valid("preint/feature-x9"), "", "valid: feature-x (hyphen+digit)")
            spec.assert_str_eq(_lease_purpose_valid("ci/v1_builds"), "", "valid: under_score")
            // Rejections (non-empty reason).
            spec.assert_true(string.length(_lease_purpose_valid("")) > 0, "reject: empty purpose")
            spec.assert_true(string.length(_lease_purpose_valid("*")) > 0, "reject: bare '*' too broad")
            spec.assert_true(string.length(_lease_purpose_valid("preint/my build")) > 0, "reject: a space")
            spec.assert_true(string.length(_lease_purpose_valid("preint/Rust")) > 0, "reject: uppercase")
            spec.assert_true(string.length(_lease_purpose_valid("ci/aether/main.0")) > 0, "reject: a dot")
            spec.assert_true(string.length(_lease_purpose_valid("preint//rust")) > 0, "reject: empty middle segment")
            spec.assert_true(string.length(_lease_purpose_valid("preint/rust/")) > 0, "reject: trailing slash")
            spec.assert_true(string.length(_lease_purpose_valid("/preint")) > 0, "reject: leading slash")
            spec.assert_true(string.length(_lease_purpose_valid("preint/café")) > 0, "reject: unicode é")
            spec.assert_true(string.length(_lease_purpose_valid("preint/*/rust")) > 0, "reject: '*' mid-path (only trailing /* allowed)")
            // The rejection names the offending character where applicable.
            spec.assert_true(string.index_of(_lease_purpose_valid("a b"), "' '") >= 0, "reject reason names the space")
        }

        spec.it("_lease_verify_any: a SET of secrets (rotation)") callback {
            // mint with key MATERIAL; the set lines are ENVELOPES (agent-side form).
            now = 1000000000000
            future = "1000000600000"
            past   = "999999990000"
            sA = "secret-alpha-material-long-enough"
            sB = "secret-bravo-material-long-enough"
            tokA = _lease_mint(sA, "preint/*", future)   // signed by alpha
            tokB = _lease_mint(sB, "preint/*", future)   // signed by bravo
            twoset = "aeb-secret-v1:secret-alpha-material-long-enough\naeb-secret-v1:secret-bravo-material-long-enough\n"
            // a token signed by EITHER listed secret verifies under the set
            spec.assert_str_eq(_lease_verify_any(twoset, tokA, now, "preint/x"), "", "verify_any accepts alpha-signed")
            spec.assert_str_eq(_lease_verify_any(twoset, tokB, now, "preint/x"), "", "verify_any accepts bravo-signed")
            // a token signed by a secret NOT in the set is rejected (bad signature)
            tokC = _lease_mint("secret-charlie-material-long-enough", "preint/*", future)
            spec.assert_true(string.length(_lease_verify_any(twoset, tokC, now, "preint/x")) > 0,
                "verify_any rejects unknown-key token")
            // comments + blank lines in the set are ignored; alpha still works
            setcmt = "# rotation: old then new\n\naeb-secret-v1:secret-alpha-material-long-enough\n# bravo retired\n"
            spec.assert_str_eq(_lease_verify_any(setcmt, tokA, now, "preint/x"), "", "verify_any ignores comments/blanks")
            // an effectively-empty set fails closed
            spec.assert_true(string.length(_lease_verify_any("# only a comment\n", tokA, now, "preint/x")) > 0,
                "verify_any empty set => fail-closed")
            // REASON SELECTION: a token correctly signed (alpha) but EXPIRED reports
            // 'expired', not the bad-signature noise from the other (bravo) secret.
            tokAexp = _lease_mint(sA, "preint/*", past)
            rexp = _lease_verify_any(twoset, tokAexp, now, "preint/x")
            spec.assert_true(string.index_of(rexp, "expired") >= 0,
                "verify_any: signed-but-expired reports expiry, not bad-sig")
            // single-secret set behaves exactly like _lease_verify
            spec.assert_str_eq(_lease_verify_any("aeb-secret-v1:secret-alpha-material-long-enough\n", tokA, now, "preint/x"),
                "", "verify_any single-secret == verify")
        }
    }

    spec.describe(fw, "provisioning-mode helpers") {
        spec.it("csv_contains / mode_offered / branch_allowed / autoclone_allowed") callback {
            spec.assert_true(_csv_contains("patch,advance", "advance") == 1, "csv_contains hit")
            spec.assert_true(_csv_contains("patch,advance", "autoclone") == 0, "csv_contains miss")
            spec.assert_true(_csv_contains("patch , advance", "advance") == 1, "csv_contains trims")
            // _mode_offered: empty offered defaults to patch only
            spec.assert_true(_mode_offered("", "patch") == 1, "mode_offered default patch")
            spec.assert_true(_mode_offered("", "advance") == 0, "mode_offered default rejects advance")
            spec.assert_true(_mode_offered("patch,autoclone", "autoclone") == 1, "mode_offered explicit set")
            spec.assert_true(_mode_offered("patch", "advance") == 0, "mode_offered not in set")
            // _branch_allowed: glob over branch names, empty allow-list = fail-closed
            spec.assert_true(_branch_allowed("main", "main") == 1, "branch_allowed exact")
            spec.assert_true(_branch_allowed("release/*", "release/1.2") == 1, "branch_allowed glob")
            spec.assert_true(_branch_allowed("main", "feature/x") == 0, "branch_allowed reject")
            spec.assert_true(_branch_allowed("", "main") == 0, "branch_allowed empty list fail-closed")
            spec.assert_true(_branch_allowed("main", "") == 0, "branch_allowed empty branch fail-closed")
            // _autoclone_allowed: <repo> (any branch) or <repo>#<branchglob>
            spec.assert_true(_autoclone_allowed("https://x/r.git", "https://x/r.git", "anything") == 1,
                "autoclone repo-only any branch")
            spec.assert_true(_autoclone_allowed("https://x/r.git#main", "https://x/r.git", "main") == 1,
                "autoclone repo#branch match")
            spec.assert_true(_autoclone_allowed("https://x/r.git#release/*", "https://x/r.git", "release/9") == 1,
                "autoclone repo#branchglob match")
            spec.assert_true(_autoclone_allowed("https://x/r.git#main", "https://x/r.git", "dev") == 0,
                "autoclone wrong branch rejected")
            spec.assert_true(_autoclone_allowed("https://x/r.git", "https://evil/r.git", "main") == 0,
                "autoclone wrong repo rejected")
            spec.assert_true(_autoclone_allowed("", "https://x/r.git", "main") == 0,
                "autoclone empty allow fail-closed")
        }
    }

    spec.describe(fw, "token-in-secret-slot footgun guard") {
        spec.it("_looks_like_token") callback {
            spec.assert_true(_looks_like_token("ae1.preint/macos.1781.df1f") == 1, "looks_like_token: a real token")
            spec.assert_true(_looks_like_token("  ae1.x.1.y") == 1, "looks_like_token: trims leading ws")
            spec.assert_true(_looks_like_token("df1f18759213d6bc566314ec33c114ee") == 0,
                "looks_like_token: opaque secret is NOT a token")
            spec.assert_true(_looks_like_token("a3f9c0e1b2d4") == 0, "looks_like_token: hex-only secret")
            spec.assert_true(_looks_like_token("") == 0, "looks_like_token: empty")
            spec.assert_true(_looks_like_token("ae1secretish") == 0, "looks_like_token: 'ae1' without dot is not a token")
        }
        spec.it("_secrets_have_token") callback {
            spec.assert_true(_secrets_have_token("# rotation\nsecret-alpha\nsecret-bravo\n") == 0,
                "secrets_have_token: good multi-line set is clean")
            spec.assert_true(_secrets_have_token("secret-alpha\nae1.preint/x.1.sig\n") == 1,
                "secrets_have_token: a token line is caught")
            spec.assert_true(_secrets_have_token("# ae1.example.1.x\nreal-secret\n") == 0,
                "secrets_have_token: comment-only token ignored (it's a comment)")
        }
    }

    spec.describe(fw, "secret strength (entropy floor; length >= 32)") {
        spec.it("_secret_strength_ok") callback {
            spec.assert_true(_secret_strength_ok("99b9ef77f006f7d69ce338e92e7e26d5816267b78d37de4c468b011f748f73ae") == 1,
                "strength: openssl rand -hex 32 (64 chars) ok")
            spec.assert_true(_secret_strength_ok("7J0B3XoMFljVw52kSQjLwfUmJ86vFuNi") == 1,
                "strength: rand -base64 24 (32 chars) ok")
            spec.assert_true(_secret_strength_ok("St4ndrdT1ngTh3yC4nRmbr") == 0,
                "strength: lazy 'St4ndrdT1ngTh3yC4nRmbr' (22) too weak")
            spec.assert_true(_secret_strength_ok("password123") == 0, "strength: 'password123' too weak")
            spec.assert_true(_secret_strength_ok("") == 0, "strength: empty too weak")
            spec.assert_true(_secret_strength_ok("01234567890123456789012345678901") == 1, "strength: exactly 32 chars ok")
            spec.assert_true(_secret_strength_ok("0123456789012345678901234567890") == 0, "strength: 31 chars too weak")
        }
        spec.it("_secrets_weak_line: checks the key MATERIAL, names first weak line") callback {
            spec.assert_str_eq(
                _secrets_weak_line("aeb-secret-v1:99b9ef77f006f7d69ce338e92e7e26d5816267b78d37de4c468b011f748f73ae\naeb-secret-v1:7J0B3XoMFljVw52kSQjLwfUmJ86vFuNi\n"),
                "", "weak_line: all strong → empty")
            spec.assert_str_eq(
                _secrets_weak_line("aeb-secret-v1:99b9ef77f006f7d69ce338e92e7e26d5816267b78d37de4c468b011f748f73ae\naeb-secret-v1:password123\n"),
                "aeb-secret-v1:password123", "weak_line: catches the weak material")
            spec.assert_str_eq(
                _secrets_weak_line("# short comment\naeb-secret-v1:99b9ef77f006f7d69ce338e92e7e26d5816267b78d37de4c468b011f748f73ae\n"),
                "", "weak_line: comments skipped")
        }
    }

    spec.describe(fw, "secret envelope: marker + key-material extraction") {
        spec.it("marker / key_material / envelope-required verify / no_marker_line") callback {
            now = 1000000000000
            future = "1000000600000"
            spec.assert_str_eq(_secret_marker(), "aeb-secret-v1:", "marker is aeb-secret-v1:")
            spec.assert_str_eq(
                _secret_key_material("aeb-secret-v1:99b9ef77f006f7d69ce338e92e7e26d5816267b78d37de4c468b011f748f73ae"),
                "99b9ef77f006f7d69ce338e92e7e26d5816267b78d37de4c468b011f748f73ae", "key_material strips the marker")
            spec.assert_str_eq(
                _secret_key_material("99b9ef77f006f7d69ce338e92e7e26d5816267b78d37de4c468b011f748f73ae"),
                "", "key_material: no marker → empty (not an aeb secret)")
            spec.assert_str_eq(_secret_key_material("  aeb-secret-v1:abcd  "), "abcd", "key_material: trims surrounding ws")
            // a verify with a markerless secret is refused (envelope required)
            enveloped = string.concat("aeb-secret-v1:", "supersecret-256bit-key-material-xyz")
            tok = _lease_mint(_secret_key_material(enveloped), "preint/x", future)
            spec.assert_str_eq(_lease_verify(enveloped, tok, now, "preint/x"), "", "verify keys on material under the envelope")
            spec.assert_true(1 - _streq(_lease_verify("supersecret-256bit-key-material-xyz", tok, now, "preint/x"), ""),
                "verify refuses a markerless secret")
            // _secrets_no_marker_line: flags a line lacking the marker
            spec.assert_str_eq(_secrets_no_marker_line("aeb-secret-v1:keymat-one-long-enough-32chars-yes\n"),
                "", "no_marker_line: all enveloped → empty")
            spec.assert_str_eq(
                _secrets_no_marker_line("aeb-secret-v1:good-material-long-enough-32chars\nbare-blob-no-marker\n"),
                "bare-blob-no-marker", "no_marker_line: catches a bare line")
        }
    }

    return spec.run_summary(fw)
}

// tiny local helpers (the test file is self-contained)
_lt(a: int, b: int) { if a < b { return 1 } return 0 }
_streq(a: string, b: string) { return string.equals(a, b) }
// _has_rule_with_scope(rules, id, scope) — 1 if some rule row has both the
// given id (field 0) and scope (field 1).
_has_rule_with_scope(rules: ptr, rid: string, scope: string) {
    i = 0
    n = list.size(rules)
    while i < n {
        row, _ = list.get(rules, i)
        if string.equals(_veto_rule_field(row, 0), rid) == 1 {
            if string.equals(_veto_rule_field(row, 1), scope) == 1 { return 1 }
        }
        i = i + 1
    }
    return 0
}
