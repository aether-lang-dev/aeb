// Unit tests for the remote-aeb agent scope-decision + wire helpers.
// All pure (I/O-free) — no networking, no agent process.
//
// Design: docs/run-policy-class-and-cloud-leverage.md

import agent (_scope_glob_match, _scope_accepts, _has_free_slot,
              _decision, dispatch_request_json, dispatch_request_json_ex, dispatch_reply_json,
              _json_field, run_on, max_jobs, accept_scope,
              _parse_tokens, _bearer_strip, ping_json, ping_json_ex,
              _parse_pool, _pool_url_of, _pool_token_of,
              _veto_rule_field, _veto_scan_cmd, _veto_default_rules,
              _image_match,
              _lease_mint, _lease_verify, _lease_verify_any, _lease_field, _lease_sign,
              _lease_purpose_valid,
              _csv_contains, _mode_offered, _branch_allowed, _autoclone_allowed)
import std.string
import std.list
import std.map

extern println(s: string)

_assert(label: string, cond: int) {
    if cond == 1 { println("PASS: ${label}") } else { println("FAIL: ${label}") }
}
_eq(label: string, got: string, want: string) {
    if string.equals(got, want) == 1 { println("PASS: ${label}") }
    else { println("FAIL: ${label} (got '${got}' want '${want}')") }
}

main() {
    // --- _scope_glob_match ---
    _assert("glob * matches anything", _scope_glob_match("*", "ci/aether/main"))
    _assert("preint/* matches preint/x", _scope_glob_match("preint/*", "preint/phammant/feat"))
    _assert("preint/* matches bare preint", _scope_glob_match("preint/*", "preint"))
    _assert("preint/* rejects ci/x", 1 - _scope_glob_match("preint/*", "ci/aether/main"))
    _assert("preint/* rejects preintXYZ (prefix not boundary)",
        1 - _scope_glob_match("preint/*", "preintXYZ"))
    _assert("exact match", _scope_glob_match("preint", "preint"))
    _assert("exact mismatch", 1 - _scope_glob_match("preint", "ci"))

    // --- _image_match: per-dispatch image vs --allow-image glob (run_on=podman) ---
    _assert("image * allows anything", _image_match("*", "aeb-tc:rust"))
    _assert("aeb-tc:* allows aeb-tc:rust", _image_match("aeb-tc:*", "aeb-tc:rust"))
    _assert("aeb-tc:* allows aeb-tc:jdk21", _image_match("aeb-tc:*", "aeb-tc:jdk21"))
    _assert("aeb-tc:* allows bare prefix aeb-tc:", _image_match("aeb-tc:*", "aeb-tc:"))
    _assert("aeb-tc:* rejects other-registry image",
        1 - _image_match("aeb-tc:*", "evil/exfil:latest"))
    _assert("exact image allowed", _image_match("aeb-tc:jdk21", "aeb-tc:jdk21"))
    _assert("exact image mismatch rejected",
        1 - _image_match("aeb-tc:jdk21", "aeb-tc:rust"))
    _assert("prefix shorter than glob rejected (aeb not aeb-tc:)",
        1 - _image_match("aeb-tc:*", "aeb"))

    // --- _scope_accepts: no accept_scope => open ---
    open_scope = map.new()
    _assert("scope with no accept_scope accepts all",
        _scope_accepts(open_scope, "anything/goes"))

    // --- _scope_accepts: with globs ---
    s = map.new()
    accept_scope(s, "preint/*")
    accept_scope(s, "adhoc/phammant/*")
    _assert("accepts preint/x", _scope_accepts(s, "preint/x"))
    _assert("accepts adhoc/phammant/exp7", _scope_accepts(s, "adhoc/phammant/exp7"))
    _assert("rejects ci/main", 1 - _scope_accepts(s, "ci/aether/main"))

    // --- _has_free_slot ---
    _assert("unbounded ('') always free", _has_free_slot(99, ""))
    _assert("cap 0 = unbounded", _has_free_slot(99, "0"))
    _assert("2/2 busy", 1 - _has_free_slot(2, "2"))
    _assert("1/2 free", _has_free_slot(1, "2"))

    // --- _decision: accept / busy / reject ---
    sc = map.new()
    accept_scope(sc, "preint/*")
    max_jobs(sc, 2)
    _eq("in-scope + slot => accept", _decision(sc, "preint/x", 1), "accept")
    _eq("in-scope + no slot => busy", _decision(sc, "preint/x", 2), "busy")
    _eq("out-of-scope => reject", _decision(sc, "ci/main", 0), "reject")
    // reject takes precedence over busy: out-of-scope AND full => reject
    _eq("out-of-scope + full => reject (not busy)", _decision(sc, "ci/main", 9), "reject")

    // --- wire payloads round-trip through the skeleton extractor ---
    req = dispatch_request_json("G123", "app/.tests.ae", "preint/x", "main", "abc123", "")
    _eq("req guid", _json_field(req, "guid"), "G123")
    _eq("req target", _json_field(req, "target"), "app/.tests.ae")
    _eq("req purpose", _json_field(req, "purpose"), "preint/x")
    _eq("req ref", _json_field(req, "ref"), "main")
    _eq("req hash", _json_field(req, "hash"), "abc123")
    _eq("req patch_b64 empty", _json_field(req, "patch_b64"), "")
    req2 = dispatch_request_json("G2", "t.ae", "p", "", "", "YmFzZTY0")
    _eq("req2 patch_b64", _json_field(req2, "patch_b64"), "YmFzZTY0")
    // 6-field form omits the optional image/command (agent sees "").
    _eq("req omits image when unset", _json_field(req, "image"), "")
    _eq("req omits command when unset", _json_field(req, "command"), "")

    // --- _ex form: optional image (podman) + command (vm raw build) ---
    reqi = dispatch_request_json_ex("G3", "t.ae", "preint", "", "", "", "aeb-tc:rust", "")
    _eq("ex image present", _json_field(reqi, "image"), "aeb-tc:rust")
    _eq("ex command absent when empty", _json_field(reqi, "command"), "")
    reqc = dispatch_request_json_ex("G4", "t.ae", "preint", "", "", "", "", "./build.sh ex.ae build/ex")
    _eq("ex command present", _json_field(reqc, "command"), "./build.sh ex.ae build/ex")
    _eq("ex image absent when empty", _json_field(reqc, "image"), "")
    _eq("ex still carries guid", _json_field(reqc, "guid"), "G4")

    rep = dispatch_reply_json("G123", "done", "fail")
    _eq("reply guid", _json_field(rep, "guid"), "G123")
    _eq("reply status", _json_field(rep, "status"), "done")
    _eq("reply result", _json_field(rep, "result"), "fail")

    _eq("missing field => empty", _json_field(rep, "nope"), "")

    // --- _parse_tokens: generic line-set parser (used to count --lease-secrets) ---
    tf = "# comment line\nsecret-alpha\n\nsecret-bravo\n  trimmed-secret  \n"
    toks = _parse_tokens(tf)
    _assert("parse: 3 non-comment/blank lines", map.size(toks) == 3)
    _assert("parse: keeps secret-alpha", map.has(toks, "secret-alpha") == 1)
    _assert("parse: trims surrounding whitespace", map.has(toks, "trimmed-secret") == 1)
    _assert("parse: drops the comment line", 1 - map.has(toks, "# comment line"))

    // _bearer_strip: handles both "Bearer X" and a raw value (token extraction).
    _eq("bearer strip prefix", _bearer_strip("Bearer s3cr3t-alice"), "s3cr3t-alice")
    _eq("bearer strip raw value", _bearer_strip("s3cr3t-ci"), "s3cr3t-ci")
    _eq("bearer strip trims", _bearer_strip("  Bearer  s3cr3t-ci  "), "s3cr3t-ci")

    // --- ping_json identity + capability descriptor ---
    pj = ping_json("linux", "preint/*", "false", "2", "required")
    _eq("ping agent field", _json_field(pj, "agent"), "aeb-agent")
    _eq("ping platform", _json_field(pj, "platform"), "linux")
    _eq("ping accept", _json_field(pj, "accept"), "preint/*")
    _eq("ping auth", _json_field(pj, "auth"), "required")
    _assert("ping carries busy:false", string.index_of(pj, "\"busy\":false") >= 0)
    _assert("ping carries max_jobs:2", string.index_of(pj, "\"max_jobs\":2") >= 0)
    // empty max_jobs renders 0 (unbounded)
    pj0 = ping_json("linux", "*", "false", "", "open")
    _assert("ping empty max_jobs -> 0", string.index_of(pj0, "\"max_jobs\":0") >= 0)
    // base ping_json omits the optional version fields
    _eq("ping omits aeb_version when base form", _json_field(pj, "aeb_version"), "")
    _eq("ping omits aether_version when base form", _json_field(pj, "aether_version"), "")

    // --- ping_json_ex: toolchain versions for the originator ---
    pjv = ping_json_ex("macos", "preint/*", "false", "1", "required",
                       "aeb 0.0.0-dev+abc123 (git v0.160)", "Aether Compiler v0.256.0")
    _eq("ex aeb_version", _json_field(pjv, "aeb_version"), "aeb 0.0.0-dev+abc123 (git v0.160)")
    _eq("ex aether_version", _json_field(pjv, "aether_version"), "Aether Compiler v0.256.0")
    _eq("ex still carries platform", _json_field(pjv, "platform"), "macos")
    // empty versions are omitted (probe-failure degrades cleanly)
    pjv0 = ping_json_ex("linux", "*", "false", "", "open", "", "")
    _eq("ex omits empty aeb_version", _json_field(pjv0, "aeb_version"), "")
    _eq("ex omits empty aether_version", _json_field(pjv0, "aether_version"), "")

    // --- agent pool parsing (the --agents file) ---
    pool = "# my agents\nhttp://192.168.0.57:9440 - ping-secret-123\n\nhttp://mac.local:9440 - mac-tok\nhttp://nostoken:9440\n"
    lines = _parse_pool(pool)
    _assert("pool: 3 non-comment lines", list.size(lines) == 3)
    l0, _ = list.get(lines, 0)
    _eq("pool line0 url", _pool_url_of(l0), "http://192.168.0.57:9440")
    _eq("pool line0 token", _pool_token_of(l0), "ping-secret-123")
    l1, _ = list.get(lines, 1)
    _eq("pool line1 url", _pool_url_of(l1), "http://mac.local:9440")
    _eq("pool line1 token", _pool_token_of(l1), "mac-tok")
    l2, _ = list.get(lines, 2)
    _eq("pool line2 url (no token)", _pool_url_of(l2), "http://nostoken:9440")
    _eq("pool line2 token empty", _pool_token_of(l2), "")
    _assert("pool skips comments + blanks", 1)

    // --- Tier-A veto: pure rule helpers (docs/build-veto-and-sandbox.md) ---
    // _veto_rule_field: tab-split field extraction.
    row = "aws-akid\tpatch\tAKIA[0-9A-Z]\\{16\\}\tpatch introduces an AWS access-key id"
    _eq("veto field id", _veto_rule_field(row, 0), "aws-akid")
    _eq("veto field scope", _veto_rule_field(row, 1), "patch")
    _eq("veto field reason", _veto_rule_field(row, 3), "patch introduces an AWS access-key id")
    _eq("veto field out-of-range empty", _veto_rule_field(row, 9), "")

    // _veto_scan_cmd: tree-scope → recursive grep over repo.
    _eq("veto cmd tree-scope",
        _veto_scan_cmd("tree", "BEGIN RSA PRIVATE KEY", "/srv/repo", ""),
        "grep -rqI -e 'BEGIN RSA PRIVATE KEY' '/srv/repo' 2>/dev/null")
    // patch-scope → grep the patch file only.
    _eq("veto cmd patch-scope",
        _veto_scan_cmd("patch", "AKIA", "/srv/repo", "/tmp/p.diff"),
        "grep -qI -e 'AKIA' '/tmp/p.diff' 2>/dev/null")
    // patch-scope with NO patch → "" (caller skips the rule).
    _eq("veto cmd patch-scope no patch", _veto_scan_cmd("patch", "AKIA", "/srv/repo", ""), "")

    // file-scope → find-by-name existence check (exit 0 = file present).
    _eq("veto cmd file-scope",
        _veto_scan_cmd("file", "binding.gyp", "/srv/repo", ""),
        "find '/srv/repo' -name 'binding.gyp' 2>/dev/null | grep -q .")
    // patchpath-scope → grep the diff's file headers for the path pattern.
    _eq("veto cmd patchpath-scope",
        _veto_scan_cmd("patchpath", "\\.github/", "/srv/repo", "/tmp/p.diff"),
        "grep -qE '^(\\+\\+\\+ |diff --git ).*\\.github/' '/tmp/p.diff' 2>/dev/null")
    // patchpath with NO patch → "" (skip).
    _eq("veto cmd patchpath no patch", _veto_scan_cmd("patchpath", "x", "/srv/repo", ""), "")

    // _veto_default_rules: the built-in list is non-empty and well-formed
    // (every row has the 4 tab fields).
    drules = _veto_default_rules()
    _assert("veto default rules present", 1 - _lt(list.size(drules), 1))
    r0, _ = list.get(drules, 0)
    _eq("veto default rule0 id", _veto_rule_field(r0, 0), "secret-rsa")
    _assert("veto default rule0 has reason", 1 - _streq(_veto_rule_field(r0, 3), ""))

    // June-2026 supply-chain rules are present + well-formed. Find them by id
    // and assert their scope/reason are set (scan the list).
    _assert("default rules include the June-2026 install-script class (>= 8 rules)",
        1 - _lt(list.size(drules), 8))
    _assert("binding.gyp rule is file-scope", _has_rule_with_scope(drules, "npm-binding-gyp", "file"))
    _assert("install-hook rule is tree-scope", _has_rule_with_scope(drules, "npm-install-hook", "tree"))
    _assert("curl-pipe-sh rule is tree-scope", _has_rule_with_scope(drules, "curl-pipe-sh", "tree"))
    _assert("patch-extern rule is patch-scope", _has_rule_with_scope(drules, "patch-extern", "patch"))

    // --- Lease tokens: HMAC-signed, purpose-bound, expiring -------------
    // Fixed clock + fixed secret so tests are deterministic (no wall clock).
    secret = "shhh-lessor-secret-xyz"
    now = 1000000000000  // a fixed "now" in unix-ms
    future = "1000000600000"  // now + 10 min
    past   = "999999990000"   // now - ~10s

    // A well-formed lease for preint/phammant/rust, not expired, verifies ("").
    good = _lease_mint(secret, "preint/phammant/rust", future)
    _eq("valid lease verifies", _lease_verify(secret, good, now, "preint/phammant/rust"), "")

    // Tamper: flip the purpose in the token but keep the old signature => bad sig.
    forged = _lease_mint(secret, "preint/phammant/rust", future)
    // rebuild with a DIFFERENT purpose but splice the ORIGINAL sig back on.
    orig_sig = _lease_field(good, 3)
    tampered = "ae1.ci/aether/main.${future}.${orig_sig}"
    _assert("tampered purpose => bad signature (rejected)",
        1 - _streq(_lease_verify(secret, tampered, now, "ci/aether/main"), ""))

    // Wrong secret => bad signature.
    _assert("wrong secret => rejected",
        1 - _streq(_lease_verify("not-the-secret", good, now, "preint/phammant/rust"), ""))

    // Expired lease => rejected (even though signature is valid).
    expired = _lease_mint(secret, "preint/phammant/rust", past)
    _assert("expired lease => rejected",
        1 - _streq(_lease_verify(secret, expired, now, "preint/phammant/rust"), ""))

    // Purpose binding: a token for preint/* COVERS preint/rust (glob).
    broad = _lease_mint(secret, "preint/*", future)
    _eq("preint/* token covers preint/rust", _lease_verify(secret, broad, now, "preint/rust"), "")
    // ...but a token for preint/rust does NOT cover a different purpose.
    narrow = _lease_mint(secret, "preint/rust", future)
    _assert("preint/rust token does NOT cover ci/main (purpose-bound)",
        1 - _streq(_lease_verify(secret, narrow, now, "ci/main"), ""))

    // No secret configured => fail-closed.
    _assert("empty secret => fail-closed",
        1 - _streq(_lease_verify("", good, now, "preint/phammant/rust"), ""))
    // Empty/garbage token => rejected.
    _assert("empty token => rejected",
        1 - _streq(_lease_verify(secret, "", now, "preint/rust"), ""))
    _assert("non-ae1 token => rejected",
        1 - _streq(_lease_verify(secret, "garbage.foo.bar.baz", now, "preint/rust"), ""))

    // Field accessor + signing are stable (mint is deterministic for fixed inputs).
    _eq("lease field 0 is the ae1 tag", _lease_field(good, 0), "ae1")
    _eq("lease field 1 is the purpose", _lease_field(good, 1), "preint/phammant/rust")
    _eq("sign is deterministic",
        _lease_sign(secret, "preint/rust", future),
        _lease_sign(secret, "preint/rust", future))

    // --- _lease_purpose_valid: canonical purpose grammar (mint-time gate) ---
    // Valid canonical slash-paths return "".
    _eq("valid: preint/phammant/rust", _lease_purpose_valid("preint/phammant/rust"), "")
    _eq("valid: ci/aether/main", _lease_purpose_valid("ci/aether/main"), "")
    _eq("valid: single segment", _lease_purpose_valid("preint"), "")
    _eq("valid: trailing /* scope", _lease_purpose_valid("preint/phammant/*"), "")
    _eq("valid: feature-x (hyphen+digit)", _lease_purpose_valid("preint/feature-x9"), "")
    _eq("valid: under_score", _lease_purpose_valid("ci/v1_builds"), "")
    // Rejections (non-empty reason).
    _assert("reject: empty purpose", string.length(_lease_purpose_valid("")) > 0)
    _assert("reject: bare '*' too broad", string.length(_lease_purpose_valid("*")) > 0)
    _assert("reject: a space", string.length(_lease_purpose_valid("preint/my build")) > 0)
    _assert("reject: uppercase", string.length(_lease_purpose_valid("preint/Rust")) > 0)
    _assert("reject: a dot", string.length(_lease_purpose_valid("ci/aether/main.0")) > 0)
    _assert("reject: empty middle segment", string.length(_lease_purpose_valid("preint//rust")) > 0)
    _assert("reject: trailing slash", string.length(_lease_purpose_valid("preint/rust/")) > 0)
    _assert("reject: leading slash", string.length(_lease_purpose_valid("/preint")) > 0)
    _assert("reject: unicode é", string.length(_lease_purpose_valid("preint/café")) > 0)
    _assert("reject: '*' mid-path (only trailing /* allowed)", string.length(_lease_purpose_valid("preint/*/rust")) > 0)
    // The rejection names the offending character where applicable.
    _assert("reject reason names the space", string.index_of(_lease_purpose_valid("a b"), "' '") >= 0)

    // --- _lease_verify_any: a SET of secrets (rotation) ---
    sA = "secret-alpha"
    sB = "secret-bravo"
    tokA = _lease_mint(sA, "preint/*", future)   // signed by alpha
    tokB = _lease_mint(sB, "preint/*", future)   // signed by bravo
    twoset = "secret-alpha\nsecret-bravo\n"
    // a token signed by EITHER listed secret verifies under the set
    _eq("verify_any accepts alpha-signed", _lease_verify_any(twoset, tokA, now, "preint/x"), "")
    _eq("verify_any accepts bravo-signed", _lease_verify_any(twoset, tokB, now, "preint/x"), "")
    // a token signed by a secret NOT in the set is rejected (bad signature)
    tokC = _lease_mint("secret-charlie", "preint/*", future)
    _assert("verify_any rejects unknown-key token",
        string.length(_lease_verify_any(twoset, tokC, now, "preint/x")) > 0)
    // comments + blank lines in the set are ignored; alpha still works
    setcmt = "# rotation: old then new\n\nsecret-alpha\n# secret-bravo retired\n"
    _eq("verify_any ignores comments/blanks", _lease_verify_any(setcmt, tokA, now, "preint/x"), "")
    // an effectively-empty set fails closed
    _assert("verify_any empty set => fail-closed",
        string.length(_lease_verify_any("# only a comment\n", tokA, now, "preint/x")) > 0)
    // REASON SELECTION: a token correctly signed (alpha) but EXPIRED reports
    // 'expired', not the bad-signature noise from the other (bravo) secret.
    tokAexp = _lease_mint(sA, "preint/*", past)
    rexp = _lease_verify_any(twoset, tokAexp, now, "preint/x")
    _assert("verify_any: signed-but-expired reports expiry, not bad-sig",
        string.index_of(rexp, "expired") >= 0)
    // single-secret set behaves exactly like _lease_verify
    _eq("verify_any single-secret == verify", _lease_verify_any("secret-alpha\n", tokA, now, "preint/x"), "")

    // --- provisioning-mode helpers ---
    _assert("csv_contains hit", _csv_contains("patch,advance", "advance") == 1)
    _assert("csv_contains miss", _csv_contains("patch,advance", "autoclone") == 0)
    _assert("csv_contains trims", _csv_contains("patch , advance", "advance") == 1)
    // _mode_offered: empty offered defaults to patch only
    _assert("mode_offered default patch", _mode_offered("", "patch") == 1)
    _assert("mode_offered default rejects advance", _mode_offered("", "advance") == 0)
    _assert("mode_offered explicit set", _mode_offered("patch,autoclone", "autoclone") == 1)
    _assert("mode_offered not in set", _mode_offered("patch", "advance") == 0)
    // _branch_allowed: glob over branch names, empty allow-list = fail-closed
    _assert("branch_allowed exact", _branch_allowed("main", "main") == 1)
    _assert("branch_allowed glob", _branch_allowed("release/*", "release/1.2") == 1)
    _assert("branch_allowed reject", _branch_allowed("main", "feature/x") == 0)
    _assert("branch_allowed empty list fail-closed", _branch_allowed("", "main") == 0)
    _assert("branch_allowed empty branch fail-closed", _branch_allowed("main", "") == 0)
    // _autoclone_allowed: <repo> (any branch) or <repo>#<branchglob>
    _assert("autoclone repo-only any branch",
        _autoclone_allowed("https://x/r.git", "https://x/r.git", "anything") == 1)
    _assert("autoclone repo#branch match",
        _autoclone_allowed("https://x/r.git#main", "https://x/r.git", "main") == 1)
    _assert("autoclone repo#branchglob match",
        _autoclone_allowed("https://x/r.git#release/*", "https://x/r.git", "release/9") == 1)
    _assert("autoclone wrong branch rejected",
        _autoclone_allowed("https://x/r.git#main", "https://x/r.git", "dev") == 0)
    _assert("autoclone wrong repo rejected",
        _autoclone_allowed("https://x/r.git", "https://evil/r.git", "main") == 0)
    _assert("autoclone empty allow fail-closed",
        _autoclone_allowed("", "https://x/r.git", "main") == 0)

    println("agent scope + wire + token + ping + pool + veto + lease + provision tests done")
}

// tiny local helpers (the test file is self-contained)
_lt(a: int, b: int) { if a < b { return 1 } return 0 }
_streq(a: string, b: string) { return string.equals(a, b) }
// _has_rule_with_scope(rules, id, scope) — 1 if some rule row has both the
// given id (field 0) and scope (field 1).
_has_rule_with_scope(rules: ptr, rid: string, scope: string) {
    i = 0
    n = list.size(rules)
    while i < n {
        row, _ = list.get(rules, i)
        if string.equals(_veto_rule_field(row, 0), rid) == 1 {
            if string.equals(_veto_rule_field(row, 1), scope) == 1 { return 1 }
        }
        i = i + 1
    }
    return 0
}
