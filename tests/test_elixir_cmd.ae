// Tests for lib/elixir's pure command-string builders.
import std.spec
import std.list
import elixir (mix_deps_get_cmd, mix_test_cmd, _flag_part)

main() {
    fw = spec.init()

    spec.describe(fw, "mix command builders") {
        spec.it("deps.get runs from source_dir") callback {
            spec.assert_str_eq(mix_deps_get_cmd("/proj"),
                "cd '/proj' && mix deps.get", "deps.get")
        }
        spec.it("mix test, no flags") callback {
            spec.assert_str_eq(mix_test_cmd("/proj", ""),
                "cd '/proj' && mix test", "no flags")
        }
    }

    spec.describe(fw, "_flag_part suffix") {
        spec.it("empty (null) → \"\"") callback {
            spec.assert_str_eq(_flag_part(null), "", "empty")
        }
        spec.it("one flag → mix test --trace") callback {
            fl = list.new()
            _ = list.add(fl, "--trace")
            spec.assert_str_eq(mix_test_cmd("/proj", _flag_part(fl)),
                "cd '/proj' && mix test --trace", "one")
        }
        spec.it("multiple flags render in order, space-led") callback {
            fl = list.new()
            _ = list.add(fl, "--trace")
            _ = list.add(fl, "--seed")
            _ = list.add(fl, "0")
            spec.assert_str_eq(mix_test_cmd("/proj", _flag_part(fl)),
                "cd '/proj' && mix test --trace --seed 0", "multi")
        }
    }

    return spec.run_summary(fw)
}
