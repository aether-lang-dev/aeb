// Tests for the dotnet cache-key derivation in lib/dotnet/module.ae.
//
// _cache_key_for_dotnet(ctx, argfile, csproj_fingerprint, config,
// source_dir, root) reads .cs sources + optional props files via
// cache.hash_file and dep artifacts via build._read_dep_artifact.
// Stages fixtures under a tmpdir per case. Tolerates absent dotnet.
import std.string
import std.io
import std.os
import std.file
import std.fs
import std.list
import std.map
import std.path
import std.dir

import build
import dotnet (_cache_key_for_dotnet)

_assert_eq(label: string, actual: string, expected: string) {
    if actual == expected {
        println("PASS: ${label}")
    } else {
        println("FAIL: ${label}")
        println("  expected: '${expected}'")
        println("  actual:   '${actual}'")
    }
}

_assert_neq(label: string, a: string, b: string) {
    if a == b {
        println("FAIL: ${label}")
        println("  unexpected match: '${a}'")
    } else {
        println("PASS: ${label}")
    }
}

_assert_nonempty(label: string, s: string) {
    if string.length(s) > 0 {
        println("PASS: ${label}")
    } else {
        println("FAIL: ${label} (empty)")
    }
}

_mktempdir() {
    raw, _err = os.exec("mktemp -d")
    return string.trim(raw)
}

_write(p: string, content: string) {
    fs.write_atomic(p, content, string.length(content))
}

_minimal_ctx(root: string) {
    ctx = map.new()
    map.put(ctx, "deps", list.new())
    map.put(ctx, "root", root)
    return ctx
}

main() {
    tdir = _mktempdir()

    src = path.join(tdir, "Program.cs")
    _write(src, "class Program { static void Main() {} }\n")
    argfile = path.join(tdir, "argfile.txt")
    _write(argfile, string.concat(src, "\n"))

    ctx = _minimal_ctx(tdir)
    fp = "<Project Sdk=\"Microsoft.NET.Sdk\"><PropertyGroup><TargetFramework>net8.0</TargetFramework></PropertyGroup></Project>"

    // --- determinism ---
    k1, e1 = _cache_key_for_dotnet(ctx, argfile, fp, "Release", tdir, tdir)
    _assert_eq("key: no error on fresh inputs", e1, "")
    _assert_nonempty("key: non-empty hash", k1)
    k2, _e2 = _cache_key_for_dotnet(ctx, argfile, fp, "Release", tdir, tdir)
    _assert_eq("determinism: same inputs → same key", k1, k2)

    // --- src content change → different key ---
    _write(src, "class Program { static void Main() { System.Console.WriteLine(1); } }\n")
    k3, _e3 = _cache_key_for_dotnet(ctx, argfile, fp, "Release", tdir, tdir)
    _assert_neq("invalidation: src content change → different key", k1, k3)
    _write(src, "class Program { static void Main() {} }\n")
    k4, _e4 = _cache_key_for_dotnet(ctx, argfile, fp, "Release", tdir, tdir)
    _assert_eq("content-addressed: same content → same key", k1, k4)

    // --- csproj fingerprint change (e.g. nuget bump) → different key ---
    fp2 = "<Project Sdk=\"Microsoft.NET.Sdk\"><PropertyGroup><TargetFramework>net10.0</TargetFramework></PropertyGroup></Project>"
    k_fp, _e5 = _cache_key_for_dotnet(ctx, argfile, fp2, "Release", tdir, tdir)
    _assert_neq("invalidation: csproj fingerprint change → different key", k1, k_fp)

    // --- configuration change → different key ---
    k_cfg, _e6 = _cache_key_for_dotnet(ctx, argfile, fp, "Debug", tdir, tdir)
    _assert_neq("invalidation: configuration change → different key", k1, k_cfg)

    // --- Directory.Packages.props content change → different key ---
    props = path.join(tdir, "Directory.Packages.props")
    _write(props, "<Project><ItemGroup><PackageVersion Include=\"X\" Version=\"1.0.0\"/></ItemGroup></Project>")
    k_p1, _e7 = _cache_key_for_dotnet(ctx, argfile, fp, "Release", tdir, tdir)
    _assert_neq("props: keying on props differs from no-props key", k1, k_p1)
    _write(props, "<Project><ItemGroup><PackageVersion Include=\"X\" Version=\"2.0.0\"/></ItemGroup></Project>")
    k_p2, _e8 = _cache_key_for_dotnet(ctx, argfile, fp, "Release", tdir, tdir)
    _assert_neq("invalidation: props content change → different key", k_p1, k_p2)
    os.system("rm -f '${props}'")

    // --- missing src → error, empty key ---
    bad_argfile = path.join(tdir, "bad.txt")
    _write(bad_argfile, string.concat(path.join(tdir, "Nope.cs"), "\n"))
    k_bad, e_bad = _cache_key_for_dotnet(ctx, bad_argfile, fp, "Release", tdir, tdir)
    _assert_eq("error path: missing src returns empty key", k_bad, "")
    _assert_nonempty("error path: missing src reports error", e_bad)

    os.system("rm -rf '${tdir}'")
    println("dotnet cache-key tests done")
}
