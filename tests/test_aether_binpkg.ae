// Tests for the ae-add binary-package emitter in lib/aether/module.ae:
//   binary_package_toml_content(stem) — the released aether.toml `ae add` reads
//
// The contract is aether/tools/ae.c ae_try_binary_package() (0.694+): it reads
// `[package] binary = "<stem>"` (the single "this is a binary package" signal)
// and needs `modules = "."` so the installed lib lands on the import search
// path. These assertions pin exactly those two keys so a future edit can't drop
// the signal ae add depends on.
import std.spec
import std.string

import aether (binary_package_toml_content, _ae_build_triple_to_asset)

main() {
    fw = spec.init()

    spec.describe(fw, "binary_package_toml_content") {
        spec.it("declares [package] binary = \"<stem>\" — the ae add signal") callback {
            toml = binary_package_toml_content("selenium_core")
            spec.assert_contains(toml, "[package]", "has [package] table")
            spec.assert_contains(toml, "binary = \"selenium_core\"", "binary key names the stem")
        }

        spec.it("sets modules = \".\" (root export so the lib is import-visible)") callback {
            toml = binary_package_toml_content("libphonenumber")
            spec.assert_contains(toml, "modules = \".\"", "root export")
            spec.assert_contains(toml, "binary = \"libphonenumber\"", "stem carried")
        }

        spec.it("the stem is quoted verbatim (no mangling)") callback {
            // A stem with an underscore + digit round-trips exactly — ae's toml
            // parser reads the quoted value literally.
            toml = binary_package_toml_content("core_v2")
            spec.assert_contains(toml, "binary = \"core_v2\"", "verbatim stem")
        }
    }

    // The `ae build --target=` triple vocabulary (<arch>-<os>, aarch64) differs
    // from the ae-add asset triple (<os>-<arch>, arm64 = ae_host_triple/os.arch's
    // spelling) on BOTH axes. A target() reaches emit_binary_package in the ae
    // build spelling and MUST be translated, or an installing host fetches the
    // wrong asset. This is the drift-prone surface, so pin the whole cross set.
    spec.describe(fw, "_ae_build_triple_to_asset") {
        spec.it("aarch64 -> arm64, arch-first -> os-first, per OS") callback {
            spec.assert_str_eq(_ae_build_triple_to_asset("aarch64-linux"), "linux-arm64", "linux arm")
            spec.assert_str_eq(_ae_build_triple_to_asset("x86_64-linux"), "linux-x86_64", "linux x64")
            spec.assert_str_eq(_ae_build_triple_to_asset("aarch64-macos"), "macos-arm64", "macos arm")
            spec.assert_str_eq(_ae_build_triple_to_asset("x86_64-macos"), "macos-x86_64", "macos x64")
            spec.assert_str_eq(_ae_build_triple_to_asset("x86_64-windows"), "windows-x86_64", "win x64")
            spec.assert_str_eq(_ae_build_triple_to_asset("aarch64-windows"), "windows-arm64", "win arm")
            spec.assert_str_eq(_ae_build_triple_to_asset("x86_64-freebsd"), "freebsd-x86_64", "freebsd x64")
            spec.assert_str_eq(_ae_build_triple_to_asset("aarch64-freebsd"), "freebsd-arm64", "freebsd arm")
        }
        spec.it("musl folds to plain linux (same asset OS word)") callback {
            spec.assert_str_eq(_ae_build_triple_to_asset("x86_64-linux-musl"), "linux-x86_64", "musl x64")
            spec.assert_str_eq(_ae_build_triple_to_asset("aarch64-linux-musl"), "linux-arm64", "musl arm")
        }
        spec.it("an already-ae-add triple is a no-op (os-first, arm64)") callback {
            // A publisher who passes the asset spelling directly still gets the
            // right answer (os token matched first, arm64 matched as arm64).
            spec.assert_str_eq(_ae_build_triple_to_asset("linux-arm64"), "linux-arm64", "already asset arm")
            spec.assert_str_eq(_ae_build_triple_to_asset("windows-x86_64"), "windows-x86_64", "already asset x64")
        }
        spec.it("an unrecognised triple passes through unchanged") callback {
            spec.assert_str_eq(_ae_build_triple_to_asset("wasm32-wasi"), "wasm32-wasi", "wasm untouched")
        }
    }

    return spec.run_summary(fw)
}
