// Tests for aeb's deterministic --shard N/M selection rule.
//
// aeb-main applies sharding after --since/--scan narrowing:
// sort target paths, then keep entries whose zero-based position
// modulo M equals N-1.

import std.spec
import std.string
import std.list

_parse_shard(spec_str: string) {
    slash = string.index_of(spec_str, "/")
    if slash <= 0 { return 0, 0, 0 }
    if slash >= string.length(spec_str) - 1 { return 0, 0, 0 }
    left = string.substring(spec_str, 0, slash)
    right = string.substring(spec_str, slash + 1, string.length(spec_str))
    idx, _ierr = string.to_int(left)
    total, _terr = string.to_int(right)
    if idx < 1 { return 0, 0, 0 }
    if total < 1 { return 0, 0, 0 }
    if idx > total { return 0, 0, 0 }
    return idx, total, 1
}

_select_from_sorted(items: ptr, spec_str: string) {
    idx, total, ok = _parse_shard(spec_str)
    if ok == 0 { return "INVALID" }
    out = ""
    n = list.size(items)
    i = 0
    while i < n {
        item, _ = list.get(items, i)
        rem = i - ((i / total) * total)
        want = idx - 1
        if rem == want {
            if string.length(out) > 0 { out = string.concat(out, "\n") }
            out = string.concat(out, item)
        }
        i = i + 1
    }
    return out
}

main() {
    fw = spec.init()

    items = list.new()
    list.add(items, "a/.tests.ae")
    list.add(items, "b/.tests.ae")
    list.add(items, "c/.tests.ae")
    list.add(items, "d/.tests.ae")
    list.add(items, "e/.tests.ae")

    spec.describe(fw, "shard selection") {
        spec.it("shard 1/2") callback {
            spec.assert_str_eq(_select_from_sorted(items, "1/2"),
                "a/.tests.ae\nc/.tests.ae\ne/.tests.ae", "1/2")
        }
        spec.it("shard 2/2") callback {
            spec.assert_str_eq(_select_from_sorted(items, "2/2"),
                "b/.tests.ae\nd/.tests.ae", "2/2")
        }
        spec.it("shard 3/4") callback {
            spec.assert_str_eq(_select_from_sorted(items, "3/4"), "c/.tests.ae", "3/4")
        }
        spec.it("sparse shard valid") callback {
            spec.assert_str_eq(_select_from_sorted(items, "4/8"), "d/.tests.ae", "4/8")
        }
        spec.it("empty shard valid") callback {
            spec.assert_str_eq(_select_from_sorted(items, "8/8"), "", "8/8")
        }
    }

    spec.describe(fw, "invalid shard specs") {
        spec.it("invalid zero") callback {
            spec.assert_str_eq(_select_from_sorted(items, "0/2"), "INVALID", "0/2")
        }
        spec.it("invalid too high") callback {
            spec.assert_str_eq(_select_from_sorted(items, "3/2"), "INVALID", "3/2")
        }
        spec.it("invalid syntax") callback {
            spec.assert_str_eq(_select_from_sorted(items, "2"), "INVALID", "no slash")
        }
    }

    return spec.run_summary(fw)
}
