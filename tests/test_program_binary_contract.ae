// Tests the universal runnable-binary contract: bldr.program_binary_of
// resolves the `program_binary` artifact a binary builder publishes, and
// falls back to the legacy per-SDK keys (c_binary, aether_binary) so a
// dep built by an older builder still resolves. Lets one binary runner
// (c.tests) drive a c.program OR an aether.program binary.
//
// Offline: writes fake artifact files under <root>/target/<dep>/ and
// reads them back through the resolver.

import std.spec
import bldr (program_binary_of, _sh, _sh_capture)
import std.string
import std.os
import std.io
import std.map
import std.path

// Native-form tmpdir via the _sh chokepoint. program_binary_of reads its
// fakes through native file.exists/io.read_file, so the dir the shell creates
// must be the SAME native form. On Windows a raw os.system("mkdir -p /tmp/..")
// routes through cmd.exe (no POSIX mkdir) and never creates it. No-op off
// Windows. See lib/build _sh docstring.
_mktempdir() {
    raw, _err = _sh_capture("mktemp -d")
    d = string.trim(raw)
    nat, _nerr = _sh_capture("cygpath -m ${d}")
    n = string.trim(nat)
    if string.length(n) > 0 { return n }
    return d
}

// Write `content` to <root>/target/build/<dep>/<key>. A bare-name dep
// resolves to the "build" buildtype under the target/<buildtype>/<dir>
// layout (docs/filename-is-the-route.md), so fakes must live where
// _read_dep_artifact (via _dep_target_dir) now looks.
_put_artifact(root: string, dep: string, key: string, content: string) {
    d = path.join(path.join(path.join(root, "target"), "build"), dep)
    _sh("mkdir -p '${d}'")
    _w = io.write_file(path.join(d, key), content)
}

main() {
    fw = spec.init()

    spec.describe(fw, "program_binary_of runnable-binary contract") {
        spec.it("program_binary + legacy fallbacks + precedence + missing") callback {
            base = _mktempdir()
            _sh("rm -rf '${base}'; mkdir -p '${base}'")
            ctx = map.new()
            map.put(ctx, "root", base)

            // 1. program_binary present → used directly.
            _put_artifact(base, "uni", "program_binary", "/bin/uni\n")
            spec.assert_true(string.equals(program_binary_of(ctx, "uni"), "/bin/uni"),
                "program_binary resolves")

            // 2. only legacy c_binary → fallback.
            _put_artifact(base, "conly", "c_binary", "/bin/conly\n")
            spec.assert_true(string.equals(program_binary_of(ctx, "conly"), "/bin/conly"),
                "falls back to c_binary")

            // 3. only legacy aether_binary → fallback.
            _put_artifact(base, "aonly", "aether_binary", "/bin/aonly\n")
            spec.assert_true(string.equals(program_binary_of(ctx, "aonly"), "/bin/aonly"),
                "falls back to aether_binary")

            // 4. program_binary wins over a legacy key when both exist.
            _put_artifact(base, "both", "program_binary", "/bin/prog\n")
            _put_artifact(base, "both", "c_binary", "/bin/legacy\n")
            spec.assert_true(string.equals(program_binary_of(ctx, "both"), "/bin/prog"),
                "program_binary takes precedence over c_binary")

            // 5. nothing published → empty (caller treats as "not built / not deped").
            spec.assert_true(string.equals(program_binary_of(ctx, "nope"), ""),
                "missing dep resolves to empty")

            _sh("rm -rf '${base}'")
        }
    }

    spec.run_summary(fw)
}
