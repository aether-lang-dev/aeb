// Tests for lib/gleam's pure command-string builders and the
// gleeunit test-summary parser.
//
// Covers: deps_download_cmd, check_cmd, test_cmd, build_cmd,
// _target_flag, and _parse_gleeunit_counts (all three summary forms).
// All pure (I/O-free).

import std.spec
import gleam (deps_download_cmd, check_cmd, test_cmd, build_cmd,
             _target_flag, _parse_gleeunit_counts)

main() {
    fw = spec.init()

    spec.describe(fw, "gleam command builders") {
        // --- _target_flag
        spec.it("_target_flag") callback {
            spec.assert_str_eq(_target_flag(""), "", "target flag empty → ''")
            spec.assert_str_eq(_target_flag("erlang"), " --target erlang", "target flag erlang")
            spec.assert_str_eq(_target_flag("javascript"), " --target javascript", "target flag javascript")
        }

        // --- deps_download_cmd: runs from source_dir so gleam.toml resolves.
        spec.it("deps_download_cmd") callback {
            spec.assert_str_eq(deps_download_cmd("gleam", "/proj"),
                "cd '/proj' && 'gleam' deps download", "deps download runs from source_dir")
            spec.assert_str_eq(deps_download_cmd("/opt/gleam/bin/gleam", "/proj"),
                "cd '/proj' && '/opt/gleam/bin/gleam' deps download", "deps custom gleam bin quoted")
        }

        // --- check_cmd
        spec.it("check_cmd") callback {
            spec.assert_str_eq(check_cmd("gleam", "/proj", ""),
                "cd '/proj' && 'gleam' check", "check no target")
            spec.assert_str_eq(check_cmd("gleam", "/proj", " --target javascript"),
                "cd '/proj' && 'gleam' check --target javascript", "check with target")
        }

        // --- test_cmd
        spec.it("test_cmd") callback {
            spec.assert_str_eq(test_cmd("gleam", "/proj", ""),
                "cd '/proj' && 'gleam' test", "test no target")
            spec.assert_str_eq(test_cmd("gleam", "/proj", " --target erlang"),
                "cd '/proj' && 'gleam' test --target erlang", "test erlang target")
        }

        // --- build_cmd: target + warnings-as-errors, both optional.
        spec.it("build_cmd") callback {
            spec.assert_str_eq(build_cmd("gleam", "/proj", "", ""),
                "cd '/proj' && 'gleam' build", "build plain")
            spec.assert_str_eq(build_cmd("gleam", "/proj", "", " --warnings-as-errors"),
                "cd '/proj' && 'gleam' build --warnings-as-errors", "build werror")
            spec.assert_str_eq(build_cmd("gleam", "/proj", " --target erlang", " --warnings-as-errors"),
                "cd '/proj' && 'gleam' build --target erlang --warnings-as-errors", "build target + werror")
        }
    }

    spec.describe(fw, "_parse_gleeunit_counts") {
        // --- Form 1 "N tests, M failures" (JS runner).
        spec.it("form1: N tests, M failures (all-pass)") callback {
            pp0, pf0 = _parse_gleeunit_counts("7 tests, 0 failures")
            spec.assert_true(pp0 == 7, "form1 all-pass: 7 passed")
            spec.assert_true(pf0 == 0, "form1 all-pass: 0 failed")
        }
        spec.it("form1: N tests, M failures (mixed)") callback {
            pp1, pf1 = _parse_gleeunit_counts("10 tests, 3 failures")
            spec.assert_true(pp1 == 10, "form1 mixed: 10 passed-count")
            spec.assert_true(pf1 == 3, "form1 mixed: 3 failures")
        }

        // --- Form 2: EUnit "Passed: N" / "Failed: N" labels.
        spec.it("form2: EUnit Passed/Failed labels") callback {
            pp2, pf2 = _parse_gleeunit_counts("Failed: 2.  Skipped: 0.  Passed: 5.")
            spec.assert_true(pp2 == 5, "form2: 5 passed")
            spec.assert_true(pf2 == 2, "form2: 2 failed")
        }

        // --- Form 3: "All N tests passed."
        spec.it("form3: All N tests passed") callback {
            pp3, pf3 = _parse_gleeunit_counts("  All 12 tests passed.")
            spec.assert_true(pp3 == 12, "form3: 12 passed")
            spec.assert_true(pf3 == 0, "form3: 0 failed")
        }

        // --- Form precedence: when "N tests, M failures" is present it
        //     wins (Form 1 checked first).
        spec.it("form precedence: form1 wins") callback {
            pp4, pf4 = _parse_gleeunit_counts("noise\n4 tests, 1 failures\nmore noise")
            spec.assert_true(pp4 == 4, "precedence: form1 picks 4 passed-count")
            spec.assert_true(pf4 == 1, "precedence: form1 picks 1 failure")
        }

        // --- No recognisable summary → (0, 0), no crash.
        spec.it("no summary → (0, 0)") callback {
            pp5, pf5 = _parse_gleeunit_counts("compiling project...\ndone")
            spec.assert_true(pp5 == 0, "no summary → 0 passed")
            spec.assert_true(pf5 == 0, "no summary → 0 failed")
        }
    }

    spec.run_summary(fw)
}
