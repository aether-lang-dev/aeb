// Tests for python.pyproject_toml_content() — pyproject.toml generation
import std.spec
import std.list
import std.map

import python (pyproject_toml_content)

main() {
    fw = spec.init()

    spec.describe(fw, "pyproject_toml_content") {
        // --- Test 1: minimal defaults ---
        spec.it("minimal defaults") callback {
            toml1 = pyproject_toml_content(null, null)
            spec.assert_contains(toml1, "[build-system]", "minimal has [build-system]")
            spec.assert_contains(toml1, "[project]", "minimal has [project]")
            spec.assert_contains(toml1, "name = \"package\"", "minimal default name")
            spec.assert_contains(toml1, "version = \"0.1.0\"", "minimal default version")
            spec.assert_contains(toml1, "where = [\".\"]", "minimal default where")
            spec.assert_contains(toml1, "include = [\"package*\"]", "minimal default include")
            spec.assert_false(string_contains(toml1, "requires-python"), "minimal no requires-python")
            spec.assert_false(string_contains(toml1, "dependencies = ["), "minimal no dependencies")
        }

        // --- Test 2: explicit name + version ---
        spec.it("explicit name + version") callback {
            opts2 = map_new()
            map_put(opts2, "package_name", "monorepo-lib")
            map_put(opts2, "version", "1.2.3")
            toml2 = pyproject_toml_content(opts2, null)
            spec.assert_contains(toml2, "name = \"monorepo-lib\"", "explicit name")
            spec.assert_contains(toml2, "version = \"1.2.3\"", "explicit version")
            spec.assert_contains(toml2, "include = [\"monorepo-lib*\"]", "default include uses pkg name")
        }

        // --- Test 3: requires_python ---
        spec.it("requires_python") callback {
            opts3 = map_new()
            map_put(opts3, "package_name", "lib")
            map_put(opts3, "requires_python", ">=3.10")
            toml3 = pyproject_toml_content(opts3, null)
            spec.assert_contains(toml3, "requires-python = \">=3.10\"", "requires-python")
        }

        // --- Test 4: dep specs included ---
        spec.it("dep specs included") callback {
            opts4 = map_new()
            map_put(opts4, "package_name", "service")
            deps4 = list_new()
            list_add(deps4, "requests==2.31.0")
            list_add(deps4, "click>=8.0")
            toml4 = pyproject_toml_content(opts4, deps4)
            spec.assert_contains(toml4, "dependencies = [", "dependencies header")
            spec.assert_contains(toml4, "\"requests==2.31.0\"", "dep requests")
            spec.assert_contains(toml4, "\"click>=8.0\"", "dep click")
        }

        // --- Test 5: empty dep_specs list omits dependencies block ---
        spec.it("empty dep_specs list omits dependencies block") callback {
            opts5 = map_new()
            map_put(opts5, "package_name", "lib")
            deps5 = list_new()
            toml5 = pyproject_toml_content(opts5, deps5)
            spec.assert_false(string_contains(toml5, "dependencies = ["), "empty deps no dependencies block")
        }

        // --- Test 6: packages_where + packages_include override ---
        spec.it("packages_where + packages_include override") callback {
            opts6 = map_new()
            map_put(opts6, "package_name", "monorepo")
            map_put(opts6, "packages_where", "src")
            map_put(opts6, "packages_include", "monorepo.*")
            toml6 = pyproject_toml_content(opts6, null)
            spec.assert_contains(toml6, "where = [\"src\"]", "custom where")
            spec.assert_contains(toml6, "include = [\"monorepo.*\"]", "custom include")
        }

        // --- Test 7: full combo ---
        spec.it("full combo") callback {
            opts7 = map_new()
            map_put(opts7, "package_name", "data-pipeline")
            map_put(opts7, "version", "0.5.2")
            map_put(opts7, "requires_python", ">=3.11")
            map_put(opts7, "packages_where", "src")
            map_put(opts7, "packages_include", "pipeline*")
            deps7 = list_new()
            list_add(deps7, "pandas>=2.0")
            list_add(deps7, "pyarrow==15.0.0")
            list_add(deps7, "click")
            toml7 = pyproject_toml_content(opts7, deps7)
            spec.assert_contains(toml7, "name = \"data-pipeline\"", "combo: name")
            spec.assert_contains(toml7, "version = \"0.5.2\"", "combo: version")
            spec.assert_contains(toml7, "requires-python = \">=3.11\"", "combo: requires-python")
            spec.assert_contains(toml7, "\"pandas>=2.0\"", "combo: pandas dep")
            spec.assert_contains(toml7, "\"pyarrow==15.0.0\"", "combo: pyarrow dep")
            spec.assert_contains(toml7, "\"click\"", "combo: click dep")
            spec.assert_contains(toml7, "where = [\"src\"]", "combo: where src")
            spec.assert_contains(toml7, "include = [\"pipeline*\"]", "combo: include")
        }
    }

    spec.run_summary(fw)
}
