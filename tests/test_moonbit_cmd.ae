// Tests for lib/moonbit's pure command-string builders and the
// `moon test` summary-line parser.
//
// Covers: install_cmd, check_cmd, test_cmd, build_cmd, _target_flag,
// and _parse_moon_test_counts. All pure (I/O-free).
import std.spec
import moonbit (install_cmd, check_cmd, test_cmd, build_cmd,
                _target_flag, _parse_moon_test_counts)

main() {
    fw = spec.init()

    spec.describe(fw, "_target_flag") {
        spec.it("empty → ''") callback {
            spec.assert_str_eq(_target_flag(""), "", "target flag empty → ''")
        }
        spec.it("native") callback {
            spec.assert_str_eq(_target_flag("native"), " --target native", "target flag native")
        }
        spec.it("wasm-gc") callback {
            spec.assert_str_eq(_target_flag("wasm-gc"), " --target wasm-gc", "target flag wasm-gc")
        }
    }

    spec.describe(fw, "install_cmd") {
        // runs from source_dir so moon.mod.json resolves.
        spec.it("runs from source_dir") callback {
            spec.assert_str_eq(
                install_cmd("moon", "/proj"),
                "cd '/proj' && 'moon' install", "install runs from source_dir")
        }
        spec.it("custom moon bin quoted") callback {
            spec.assert_str_eq(
                install_cmd("/opt/moon/bin/moon", "/proj"),
                "cd '/proj' && '/opt/moon/bin/moon' install", "install custom moon bin quoted")
        }
    }

    spec.describe(fw, "check_cmd") {
        // with and without target.
        spec.it("no target") callback {
            spec.assert_str_eq(
                check_cmd("moon", "/proj", ""),
                "cd '/proj' && 'moon' check", "check no target")
        }
        spec.it("with target") callback {
            spec.assert_str_eq(
                check_cmd("moon", "/proj", " --target native"),
                "cd '/proj' && 'moon' check --target native", "check with target")
        }
    }

    spec.describe(fw, "test_cmd") {
        // pkg part + target part, both optional.
        spec.it("plain") callback {
            spec.assert_str_eq(
                test_cmd("moon", "/proj", "", ""),
                "cd '/proj' && 'moon' test", "test plain")
        }
        spec.it("with package") callback {
            spec.assert_str_eq(
                test_cmd("moon", "/proj", " --package foo", ""),
                "cd '/proj' && 'moon' test --package foo", "test with package")
        }
        spec.it("with package and target") callback {
            spec.assert_str_eq(
                test_cmd("moon", "/proj", " --package foo", " --target native"),
                "cd '/proj' && 'moon' test --package foo --target native", "test with package and target")
        }
    }

    spec.describe(fw, "build_cmd") {
        // target + release, both optional.
        spec.it("plain") callback {
            spec.assert_str_eq(
                build_cmd("moon", "/proj", "", ""),
                "cd '/proj' && 'moon' build", "build plain")
        }
        spec.it("release") callback {
            spec.assert_str_eq(
                build_cmd("moon", "/proj", "", " --release"),
                "cd '/proj' && 'moon' build --release", "build release")
        }
        spec.it("target + release") callback {
            spec.assert_str_eq(
                build_cmd("moon", "/proj", " --target native", " --release"),
                "cd '/proj' && 'moon' build --target native --release", "build target + release")
        }
    }

    spec.describe(fw, "_parse_moon_test_counts") {
        // "Total tests: N, passed: N, failed: N."
        spec.it("all-pass") callback {
            pp0, pf0 = _parse_moon_test_counts("Total tests: 2, passed: 2, failed: 0.")
            spec.assert_eq(pp0, 2, "all-pass: 2 passed")
            spec.assert_eq(pf0, 0, "all-pass: 0 failed")
        }
        spec.it("mixed") callback {
            pp1, pf1 = _parse_moon_test_counts("Total tests: 5, passed: 3, failed: 2.")
            spec.assert_eq(pp1, 3, "mixed: 3 passed")
            spec.assert_eq(pf1, 2, "mixed: 2 failed")
        }
        // Surrounding output before the summary line shouldn't fool the
        // label-anchored parser.
        spec.it("noisy") callback {
            noisy = "running tests...\nsome output\nTotal tests: 10, passed: 9, failed: 1.\n"
            pp2, pf2 = _parse_moon_test_counts(noisy)
            spec.assert_eq(pp2, 9, "noisy: 9 passed")
            spec.assert_eq(pf2, 1, "noisy: 1 failed")
        }
        // No summary → (0, 0) rather than crashing.
        spec.it("no summary → (0, 0)") callback {
            pp3, pf3 = _parse_moon_test_counts("no summary here")
            spec.assert_eq(pp3, 0, "no summary → 0 passed")
            spec.assert_eq(pf3, 0, "no summary → 0 failed")
        }
    }

    spec.run_summary(fw)
}
