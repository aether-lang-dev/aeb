// Tests for meta._vcs_version_cmd — the pure "which command asks this VCS
// for its version" builder behind meta.version_from_vcs.
//
// Pure by design (LLM.md's string-builder rule): it returns a command
// string and runs nothing, so all EIGHT supported VCSes are covered here
// without any of them being installed. Only git and svn could be
// exercised end-to-end on the dev box; this is what keeps the other six
// from silently rotting.
import std.spec
import meta (_vcs_version_cmd)

main() {
    fw = spec.init()

    r = "/repo"

    // Each VCS invokes its OWN tool, and addresses the root explicitly
    // rather than relying on cwd.
    spec.describe(fw, "each VCS invokes its own tool") {
        spec.it("git tool") callback {
            spec.assert_contains(_vcs_version_cmd("git", r), "git -C '/repo' describe", "git tool")
        }
        spec.it("git tags") callback {
            spec.assert_contains(_vcs_version_cmd("git", r), "--tags --dirty --always", "git tags")
        }
        spec.it("hg tool") callback {
            spec.assert_contains(_vcs_version_cmd("hg", r), "hg -R '/repo'", "hg tool")
        }
        spec.it("svn tool") callback {
            spec.assert_contains(_vcs_version_cmd("svn", r), "svnversion '/repo'", "svn tool")
        }
        spec.it("bzr tool") callback {
            spec.assert_contains(_vcs_version_cmd("bzr", r), "bzr revno '/repo'", "bzr tool")
        }
        spec.it("fossil") callback {
            spec.assert_contains(_vcs_version_cmd("fossil", r), "fossil info", "fossil")
        }
        spec.it("pijul") callback {
            spec.assert_contains(_vcs_version_cmd("pijul", r), "pijul log", "pijul")
        }
        spec.it("avn") callback {
            spec.assert_contains(_vcs_version_cmd("avn", r), "avn id", "avn")
        }
    }

    // Every command silences stderr, so a missing binary or an untagged
    // tree yields an empty capture instead of noise on the build log.
    spec.describe(fw, "every command silences stderr") {
        spec.it("git quiet") callback {
            spec.assert_contains(_vcs_version_cmd("git", r), "2>/dev/null", "git quiet")
        }
        spec.it("hg quiet") callback {
            spec.assert_contains(_vcs_version_cmd("hg", r), "2>/dev/null", "hg quiet")
        }
        spec.it("svn quiet") callback {
            spec.assert_contains(_vcs_version_cmd("svn", r), "2>/dev/null", "svn quiet")
        }
        spec.it("bzr quiet") callback {
            spec.assert_contains(_vcs_version_cmd("bzr", r), "2>/dev/null", "bzr quiet")
        }
        spec.it("fossil quiet") callback {
            spec.assert_contains(_vcs_version_cmd("fossil", r), "2>/dev/null", "fossil quiet")
        }
        spec.it("pijul quiet") callback {
            spec.assert_contains(_vcs_version_cmd("pijul", r), "2>/dev/null", "pijul quiet")
        }
        spec.it("avn quiet") callback {
            spec.assert_contains(_vcs_version_cmd("avn", r), "2>/dev/null", "avn quiet")
        }
    }

    // An unknown kind yields "" so the caller reports no version rather
    // than shelling out to something arbitrary.
    spec.describe(fw, "unknown / empty kind → ''") {
        spec.it("unknown kind") callback {
            spec.assert_str_eq(_vcs_version_cmd("cvs", r), "", "unknown kind")
        }
        spec.it("empty kind") callback {
            spec.assert_str_eq(_vcs_version_cmd("", r), "", "empty kind")
        }
    }

    // The root is interpolated, not ignored — a subdir module must ask
    // about the working copy it actually belongs to.
    spec.describe(fw, "root is interpolated") {
        spec.it("root used") callback {
            spec.assert_contains(_vcs_version_cmd("git", "/other/wc"), "/other/wc", "root used")
        }
    }

    spec.run_summary(fw)
}
