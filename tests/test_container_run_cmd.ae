// Tests for container_run_cmd() — one-shot `<engine> run` command builder
import std.spec
import container (container_run_cmd)

main() {
    fw = spec.init()

    spec.describe(fw, "container_run_cmd") {
        // Default engine podman, no command
        spec.it("default engine, no command") callback {
            spec.assert_str_eq(container_run_cmd("alpine", null),
                "podman run --rm alpine", "default engine, no command")
        }

        // With a command (appended as the container argv)
        spec.it("with command") callback {
            opts1 = map_new()
            map_put(opts1, "command", "echo hi")
            spec.assert_str_eq(container_run_cmd("ruby:alpine", opts1),
                "podman run --rm ruby:alpine echo hi", "with command")
        }

        // Explicit docker engine
        spec.it("docker engine") callback {
            opts2 = map_new()
            map_put(opts2, "engine", "docker")
            spec.assert_str_eq(container_run_cmd("alpine", opts2),
                "docker run --rm alpine", "docker engine")
        }

        // engine + command together
        spec.it("docker engine + command") callback {
            opts3 = map_new()
            map_put(opts3, "engine", "docker")
            map_put(opts3, "command", "ls /")
            spec.assert_str_eq(container_run_cmd("debian:slim", opts3),
                "docker run --rm debian:slim ls /", "docker engine + command")
        }
    }

    return spec.run_summary(fw)
}
