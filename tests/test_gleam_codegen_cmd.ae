// Tests for gleam.codegen's pure command-string builder AND the
// closure-DSL setters that feed it. Mirror of
// tests/test_moonbit_codegen_cmd.ae.
//
// Two surfaces:
//   1. `gleam_codegen_cmd(gleam, cwd, driver_form, driver_name, args)`
//      — "prog" form runs the program directly; "script" form runs it
//      as `gleam run -m <name> --`.
//   2. The grammar setters (codegen_program, codegen_script,
//      codegen_input, codegen_input_dir, codegen_arg, codegen_output,
//      codegen_cwd).

import std.spec
import gleam (gleam_codegen_cmd, codegen_program, codegen_script,
             codegen_input, codegen_input_dir, codegen_arg,
             codegen_output, codegen_cwd)
import std.list
import std.map

_list_size_at(m: ptr, k: string) {
    if map.has(m, k) == 0 { return 0 }
    l, _ = map.get(m, k)
    return list.size(l)
}
_list_get_at(m: ptr, k: string, i: int) {
    l, _ = map.get(m, k)
    v, _ = list.get(l, i)
    return v
}
_str_at(m: ptr, k: string) {
    if map.has(m, k) == 0 { return "" }
    v, _ = map.get(m, k)
    return v
}

main() {
    fw = spec.init()

    spec.describe(fw, "gleam_codegen_cmd") {
        // --- prog-form driver, no args: the program is run directly.
        spec.it("prog form runs the program directly (quoted)") callback {
            args0 = list.new()
            cmd0 = gleam_codegen_cmd("gleam", "/proj", "prog", "protoc-gen-gleam", args0)
            spec.assert_str_eq(cmd0, "cd '/proj' && 'protoc-gen-gleam'", "prog form runs the program directly (quoted)")
        }

        // --- script-form driver, no args: `gleam run -m <name> --`.
        spec.it("script form runs via gleam run -m <name> --") callback {
            args1 = list.new()
            cmd1 = gleam_codegen_cmd("gleam", "/proj", "script", "gen", args1)
            spec.assert_str_eq(cmd1, "cd '/proj' && 'gleam' run -m gen --", "script form runs via gleam run -m <name> --")
        }

        // --- prog form with args in order.
        spec.it("prog form args in order") callback {
            args2 = list.new()
            list.add(args2, "--schema=api.proto")
            list.add(args2, "--out=src/gen")
            cmd2 = gleam_codegen_cmd("gleam", "/proj", "prog", "protoc-gen-gleam", args2)
            spec.assert_str_eq(cmd2, "cd '/proj' && 'protoc-gen-gleam' --schema=api.proto --out=src/gen", "prog form args in order")
        }

        // --- script form with args after the `--` separator.
        spec.it("script form args after --") callback {
            args3 = list.new()
            list.add(args3, "--out=src/gen")
            cmd3 = gleam_codegen_cmd("gleam", "/proj", "script", "gen", args3)
            spec.assert_str_eq(cmd3, "cd '/proj' && 'gleam' run -m gen -- --out=src/gen", "script form args after --")
        }

        // --- custom gleam bin only matters for the script form.
        spec.it("script form uses custom gleam bin") callback {
            args4 = list.new()
            cmd4 = gleam_codegen_cmd("/opt/gleam/bin/gleam", "/proj", "script", "gen", args4)
            spec.assert_str_eq(cmd4, "cd '/proj' && '/opt/gleam/bin/gleam' run -m gen --", "script form uses custom gleam bin")
        }

        // --- unknown driver_form → bare cd (defensive; builder validates).
        spec.it("missing driver_form → bare cd") callback {
            args5 = list.new()
            cmd5 = gleam_codegen_cmd("gleam", "/proj", "", "", args5)
            spec.assert_str_eq(cmd5, "cd '/proj' &&", "missing driver_form → bare cd")
        }

        // --- cwd with spaces is single-quoted.
        spec.it("cwd with spaces is quoted") callback {
            args6 = list.new()
            cmd6 = gleam_codegen_cmd("gleam", "/path with spaces/repo", "prog", "gen", args6)
            spec.assert_str_eq(cmd6, "cd '/path with spaces/repo' && 'gen'", "cwd with spaces is quoted")
        }
    }

    // === Setter accumulation tests ====================================

    spec.describe(fw, "codegen setters") {
        // --- codegen_input: list accumulator, order preserved.
        spec.it("codegen_input accumulates, order preserved") callback {
            bm1 = map.new()
            codegen_input(bm1, "schema/a.proto")
            codegen_input(bm1, "schema/b.proto")
            spec.assert_true(_list_size_at(bm1, "codegen_inputs") == 2, "codegen_input accumulates 2")
            spec.assert_str_eq(_list_get_at(bm1, "codegen_inputs", 0), "schema/a.proto", "codegen_input order: first")
        }

        // --- codegen_input_dir: separate list.
        spec.it("codegen_input_dir is a separate list") callback {
            bm2 = map.new()
            codegen_input(bm2, "schema/api.proto")
            codegen_input_dir(bm2, "schema")
            spec.assert_true(_list_size_at(bm2, "codegen_input_dirs") == 1, "input_dir own key")
            spec.assert_true(_list_size_at(bm2, "codegen_inputs") == 1, "no cross-contamination")
        }

        // --- codegen_arg: list accumulator → CLI tail.
        spec.it("setter-accumulated args produce expected cmd") callback {
            bm3 = map.new()
            codegen_arg(bm3, "--out=src/gen")
            args_acc, _ = map.get(bm3, "codegen_args")
            cmd_acc = gleam_codegen_cmd("gleam", "/proj", "prog", "gen", args_acc)
            spec.assert_str_eq(cmd_acc, "cd '/proj' && 'gen' --out=src/gen", "setter-accumulated args produce expected cmd")
        }

        // --- codegen_output: list accumulator.
        spec.it("codegen_output accumulates") callback {
            bm4 = map.new()
            codegen_output(bm4, "src/gen/api.gleam")
            codegen_output(bm4, "src/gen/types.gleam")
            spec.assert_true(_list_size_at(bm4, "codegen_outputs") == 2, "codegen_output accumulates 2")
        }

        // --- scalar setters: codegen_cwd, and prog/script coexistence.
        spec.it("codegen_cwd + codegen_program scalars") callback {
            bm5 = map.new()
            codegen_cwd(bm5, "..")
            codegen_program(bm5, "protoc-gen-gleam")
            spec.assert_str_eq(_str_at(bm5, "codegen_cwd"), "..", "codegen_cwd scalar")
            spec.assert_str_eq(_str_at(bm5, "codegen_cmd_prog"), "protoc-gen-gleam", "codegen_program stored as codegen_cmd_prog")
        }

        spec.it("prog and script coexist in the map") callback {
            bm6 = map.new()
            codegen_program(bm6, "protoc-gen-gleam")
            codegen_script(bm6, "gen")
            spec.assert_str_eq(_str_at(bm6, "codegen_cmd_prog"), "protoc-gen-gleam", "prog and script coexist in the map")
            spec.assert_str_eq(_str_at(bm6, "codegen_script"), "gen", "script also stored")
        }

        // --- untouched map.
        spec.it("untouched map") callback {
            bm7 = map.new()
            spec.assert_true(_list_size_at(bm7, "codegen_inputs") == 0, "untouched: no codegen_inputs")
            spec.assert_str_eq(_str_at(bm7, "codegen_cwd"), "", "untouched: empty codegen_cwd")
        }
    }

    spec.run_summary(fw)
}
