// Tests for the go_build cache-key derivation in lib/go/module.ae.
//
// _cache_key_for_go(ctx, argfile_path, go_build_cmd_str, source_dir)
// reads .go sources + go.mod/go.sum via cache.hash_file and dep
// artifacts via bldr._read_dep_artifact. Stages fixtures under a
// tmpdir per case. Tolerates an absent go toolchain.
import std.spec
import std.string
import std.io
import std.os
import std.file
import std.fs
import std.list
import std.map
import std.path
import std.dir

import bldr
import go (_cache_key_for_go)

_mktempdir() {
    // Native form on Windows. `mktemp -d` answers in the SHELL's vocabulary
    // ("/tmp/tmp.XXXX" under MSYS), but std.fs/std.dir/std.file are native
    // Win32 calls that cannot see MSYS paths — dir.exists("/tmp/tmp.X") is 0
    // while dir.exists("C:/msys64/tmp/tmp.X") is 1. Without this the suite
    // fails on Windows for an environment reason, not a real defect.
    // No-op off Windows: cygpath is absent, so the value passes through.
    raw, _err = os.exec("mktemp -d")
    d = string.trim(raw)
    // NO quotes, NO redirect: os.exec routes through cmd.exe on Windows,
    // which does not honour POSIX single quotes or `2>/dev/null` — with them
    // the call returns EMPTY and the path silently stays POSIX. Bare works.
    nat, _nerr = os.exec("cygpath -m ${d}")
    n = string.trim(nat)
    if string.length(n) > 0 { return n }
    return d
}

_write(p: string, content: string) {
    fs.write_atomic(p, content, string.length(content))
}

_minimal_ctx(root: string) {
    ctx = map.new()
    map.put(ctx, "deps", list.new())
    map.put(ctx, "root", root)
    return ctx
}

main() {
    fw = spec.init()

    spec.describe(fw, "_cache_key_for_go") {
        spec.it("key derivation, invalidation, and content-addressing") callback {
            tdir = _mktempdir()

            src = path.join(tdir, "main.go")
            _write(src, "package main\nfunc main() {}\n")
            gomod = path.join(tdir, "go.mod")
            _write(gomod, "module example.com/m\n\ngo 1.22\n")

            argfile = path.join(tdir, "argfile.txt")
            _write(argfile, string.concat(src, "\n"))

            ctx = _minimal_ctx(tdir)
            cmd = "cd ${tdir} && go build -o ${tdir}/out"

            // --- determinism ---
            k1, e1 = _cache_key_for_go(ctx, argfile, cmd, tdir)
            spec.assert_str_eq(e1, "", "key: no error on fresh inputs")
            spec.assert_true(string.length(k1) > 0, "key: non-empty hash")
            k2, _e2 = _cache_key_for_go(ctx, argfile, cmd, tdir)
            spec.assert_str_eq(k1, k2, "determinism: same inputs → same key")

            // --- src content change → different key ---
            _write(src, "package main\nfunc main() { println(1) }\n")
            k3, _e3 = _cache_key_for_go(ctx, argfile, cmd, tdir)
            spec.assert_false(string.equals(k1, k3), "invalidation: src content change → different key")
            _write(src, "package main\nfunc main() {}\n")
            k4, _e4 = _cache_key_for_go(ctx, argfile, cmd, tdir)
            spec.assert_str_eq(k1, k4, "content-addressed: same content → same key")

            // --- cmd flag change (e.g. -tags) → different key ---
            k_cmd, _e5 = _cache_key_for_go(ctx, argfile, "cd ${tdir} && go build -tags netgo -o ${tdir}/out", tdir)
            spec.assert_false(string.equals(k1, k_cmd), "invalidation: cmd flag change → different key")

            // --- go.mod change → different key ---
            _write(gomod, "module example.com/m\n\ngo 1.23\n")
            k_mod, _e6 = _cache_key_for_go(ctx, argfile, cmd, tdir)
            spec.assert_false(string.equals(k1, k_mod), "invalidation: go.mod change → different key")
            _write(gomod, "module example.com/m\n\ngo 1.22\n")

            // --- second source → different key, order-independent ---
            src2 = path.join(tdir, "util.go")
            _write(src2, "package main\nvar x = 1\n")
            argfile2 = path.join(tdir, "argfile2.txt")
            _write(argfile2, string.concat(string.concat(src, "\n"), string.concat(src2, "\n")))
            k_two, _e7 = _cache_key_for_go(ctx, argfile2, cmd, tdir)
            spec.assert_false(string.equals(k1, k_two), "invalidation: extra .go added → different key")
            argfile_rev = path.join(tdir, "argfile_rev.txt")
            _write(argfile_rev, string.concat(string.concat(src2, "\n"), string.concat(src, "\n")))
            k_two_rev, _e8 = _cache_key_for_go(ctx, argfile_rev, cmd, tdir)
            spec.assert_str_eq(k_two, k_two_rev, "ordering: argfile listing order doesn't change key")

            // --- missing src → error, empty key ---
            bad_argfile = path.join(tdir, "bad.txt")
            _write(bad_argfile, string.concat(path.join(tdir, "nope.go"), "\n"))
            k_bad, e_bad = _cache_key_for_go(ctx, bad_argfile, cmd, tdir)
            spec.assert_str_eq(k_bad, "", "error path: missing src returns empty key")
            spec.assert_true(string.length(e_bad) > 0, "error path: missing src reports error")

            os.system("rm -rf '${tdir}'")
        }
    }

    spec.run_summary(fw)
}
