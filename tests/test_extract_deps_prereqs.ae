// Tests for tools/extract-deps.ae's --prereqs mode (prereq(b, "<token>")).
//
// extract-deps is a tool (not a lib), so the test invokes it as a
// subprocess against tmpdir fixtures — same shape as
// test_extract_deps_scan.ae.
//
// What we cover:
//   - --prereqs emits each prereq(b, "tok") token (space-separated)
//   - duplicate tokens within one file collapse to one
//   - prereq tokens do NOT leak into the normal dep-path output, and
//     dep paths do NOT leak into --prereqs output (the two modes are
//     cleanly separated)
//   - a file with no prereq() emits nothing
//
// See docs/design/build-prerequisites-and-provisioning.md.

import std.spec
import std.string
import std.io
import std.os
import std.file
import std.fs
import std.list
import std.map
import std.path
import std.dir

import bldr (_sh, _sh_capture)

_mktempdir() {
    // Native form on Windows. `mktemp -d` answers in the SHELL's vocabulary
    // ("/tmp/tmp.XXXX" under MSYS), but std.fs/std.dir/std.file are native
    // Win32 calls that cannot see MSYS paths — dir.exists("/tmp/tmp.X") is 0
    // while dir.exists("C:/msys64/tmp/tmp.X") is 1. Without this the suite
    // fails on Windows for an environment reason, not a real defect.
    // No-op off Windows: cygpath is absent, so the value passes through.
    raw, _err = _sh_capture("mktemp -d")
    d = string.trim(raw)
    // NO quotes, NO redirect: os.exec routes through cmd.exe on Windows,
    // which does not honour POSIX single quotes or `2>/dev/null` — with them
    // the call returns EMPTY and the path silently stays POSIX. Bare works.
    nat, _nerr = _sh_capture("cygpath -m ${d}")
    n = string.trim(nat)
    if string.length(n) > 0 { return n }
    return d
}

_abs_bin() {
    extract_bin = os.getenv("AEB_EXTRACT_DEPS_BIN")
    if string.length(extract_bin) == 0 {
        extract_bin = "tools/extract-deps"
    }
    abs_raw, _e1 = _sh_capture("readlink -f '${extract_bin}'")
    return string.trim(abs_raw)
}

// Invoke extract-deps --prereqs <target> from workdir; trimmed stdout.
_run_prereqs(workdir: string, target: string) {
    abs_bin = _abs_bin()
    if string.length(abs_bin) == 0 { return "ERROR: extract-deps not found" }
    raw, _e2 = _sh_capture("cd '${workdir}' && '${abs_bin}' --prereqs '${target}'")
    return string.trim(raw)
}

// Invoke extract-deps (normal dep mode) from workdir; trimmed stdout.
_run_deps(workdir: string, target: string) {
    abs_bin = _abs_bin()
    if string.length(abs_bin) == 0 { return "ERROR: extract-deps not found" }
    raw, _e2 = _sh_capture("cd '${workdir}' && '${abs_bin}' '${target}'")
    return string.trim(raw)
}

// Sort whitespace-separated tokens so assertions don't depend on order.
_normalise(out: string) {
    if string.length(out) == 0 { return out }
    sorted_raw, _err = _sh_capture("printf '%s' '${out}' | tr ' ' '\\n' | grep -v '^$' | sort | tr '\\n' ' ' | sed 's/ $//'")
    return string.trim(sorted_raw)
}

_ensure_built() {
    if string.length(os.getenv("AEB_EXTRACT_DEPS_BIN")) > 0 { return 0 }
    if file.exists("tools/extract-deps") == 1 { return 0 }
    ae_bin = os.getenv("AETHER")
    if string.length(ae_bin) == 0 { ae_bin = "ae" }
    _sh("${ae_bin} build tools/extract-deps.ae -o tools/extract-deps --lib lib --lib tools >/dev/null 2>&1")
    return 0
}

main() {
    fw = spec.init()

    spec.describe(fw, "extract-deps --prereqs") {
        spec.it("emits deduped prereq tokens, kept separate from dep paths") callback {
            _ensure_built()
            root = _mktempdir()

            // A leaf with two distinct prereqs + a dep + a duplicate prereq.
            leaf = "import bldr\nimport bldr (prereq)\nmain() {\n    b = bldr.start()\n    dep(\"shared/.build.ae\")\n    prereq(\"zig:0.13\")\n    prereq(\"python:3.14\")\n    prereq(\"zig:0.13\")\n}\n"
            fs.write_atomic("${root}/.build.ae", leaf, string.length(leaf))

            // --- tokens emitted, deduped, sorted ---
            out_pq = _run_prereqs(root, ".build.ae")
            spec.assert_str_eq(_normalise(out_pq), "python:3.14 zig:0.13", "prereqs: distinct tokens deduped")

            // --- prereq tokens do NOT appear in normal dep output ---
            out_dep = _run_deps(root, ".build.ae")
            spec.assert_false(string.index_of(out_dep, "zig:0.13") >= 0, "prereq tokens absent from dep output")

            // --- dep paths do NOT appear in --prereqs output ---
            spec.assert_false(string.index_of(out_pq, "shared/.build.ae") >= 0, "dep paths absent from prereqs output")

            // --- a file with no prereq() emits nothing ---
            noprq = "import bldr\nmain() {\n    b = bldr.start()\n    dep(\"x/.build.ae\")\n}\n"
            fs.write_atomic("${root}/.noprq.ae", noprq, string.length(noprq))
            out_none = _run_prereqs(root, ".noprq.ae")
            spec.assert_str_eq(out_none, "", "prereqs: none declared -> empty")

            _sh("rm -rf '${root}'")
        }
    }

    spec.run_summary(fw)
}
