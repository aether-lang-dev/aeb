// Tests for _canonical_path — the '.'/'..'/empty-segment collapser that
// lets transitive-regen dedup recognise an explicit relative
// regen_with("../client/module.ae") (joined onto source_dir) as the same
// module the import walk resolves to a clean absolute path. Without this
// the duplicate is re-added with weaker auto-detected caps and aetherc
// 0.190's emit=lib cap-gate rejects it
// (asks/transitive-regen-caps-shadowed-by-duplicate.md).

import std.spec
import aether (_canonical_path)

main() {
    fw = spec.init()

    spec.describe(fw, "_canonical_path: motivating dedup case") {
        // The motivating case: source_dir + "../client/module.ae" must
        // canonicalise to the same thing the import walk resolves.
        spec.it("collapse ../ against a dir") callback {
            spec.assert_str_eq(_canonical_path("/home/x/avnserver/../client/module.ae"),
                "/home/x/client/module.ae", "collapse ../")
        }
        spec.it("clean path is unchanged (the match target)") callback {
            spec.assert_str_eq(_canonical_path("/home/x/client/module.ae"),
                "/home/x/client/module.ae", "clean unchanged")
        }
    }

    spec.describe(fw, "_canonical_path: general behaviour") {
        spec.it("single dot dropped") callback {
            spec.assert_str_eq(_canonical_path("/a/./b/c"), "/a/b/c", "single dot")
        }
        spec.it("two .. collapse") callback {
            spec.assert_str_eq(_canonical_path("/a/b/../../c"), "/c", "two ..")
        }
        spec.it("cannot ascend past root") callback {
            spec.assert_str_eq(_canonical_path("/a/../../c"), "/c", "past root")
        }
        spec.it("double slash") callback {
            spec.assert_str_eq(_canonical_path("/a//b"), "/a/b", "double slash")
        }
        spec.it("trailing slash") callback {
            spec.assert_str_eq(_canonical_path("/a/b/"), "/a/b", "trailing slash")
        }
        spec.it("root stays root") callback {
            spec.assert_str_eq(_canonical_path("/"), "/", "root")
        }
        spec.it("bare name") callback {
            spec.assert_str_eq(_canonical_path("foo"), "foo", "bare name")
        }
    }

    spec.describe(fw, "_canonical_path: relative paths") {
        // Relative paths: leading .. is preserved (no base to pop).
        spec.it("relative collapses inner ..") callback {
            spec.assert_str_eq(_canonical_path("a/b/../c"), "a/c", "inner ..")
        }
        spec.it("relative keeps leading ..") callback {
            spec.assert_str_eq(_canonical_path("../x/y"), "../x/y", "leading ..")
        }
        spec.it("relative .. then descend") callback {
            spec.assert_str_eq(_canonical_path("../a/../b"), "../b", ".. then descend")
        }
    }

    spec.describe(fw, "_canonical_path: guard") {
        // Empty in, empty out (guard).
        spec.it("empty stays empty") callback {
            spec.assert_str_eq(_canonical_path(""), "", "empty")
        }
    }

    spec.run_summary(fw)
}
