// Tests for --overrideDep phase 1 (read-redirect): bldr._override_dep_dir parses
// AEB_OVERRIDE_DEP, and _read_dep_artifact reads an overridden dep's artifact
// from the supplied dir. (Phase 2, the build-set prune in aeb-main, is exercised
// by the end-to-end path, not this pure unit test.)
import std.spec
import std.string
import std.os
import std.map

import bldr (_override_dep_dir, _read_dep_artifact)

main() {
    fw = spec.init()

    spec.describe(fw, "overrideDep") {
        spec.it("_override_dep_dir matches a label, else empty") callback {
            _s = os.setenv("AEB_OVERRIDE_DEP", "erlang/.build.ae\t/pre/erl\ncore/.build.ae\t/pre/core")
            spec.assert_str_eq(_override_dep_dir("erlang/.build.ae"), "/pre/erl", "first label")
            spec.assert_str_eq(_override_dep_dir("core/.build.ae"), "/pre/core", "second label")
            spec.assert_str_eq(_override_dep_dir("other/.build.ae"), "", "unmatched label -> empty")
            _u = os.setenv("AEB_OVERRIDE_DEP", "")
            spec.assert_str_eq(_override_dep_dir("erlang/.build.ae"), "", "no env -> empty")
        }

        spec.it("_read_dep_artifact redirects to the override dir") callback {
            // prebuilt artifact under a temp dir
            _m = os.system("rm -rf /tmp/aeb-ovr-t && mkdir -p /tmp/aeb-ovr-t && printf 'REDIRECTED' > /tmp/aeb-ovr-t/edge_x")
            _s = os.setenv("AEB_OVERRIDE_DEP", "p/.build.ae\t/tmp/aeb-ovr-t")
            ctx = map.new()
            _r = map.put(ctx, "root", "/nonexistent-root-xyz")
            got = _read_dep_artifact(ctx, "p/.build.ae", "edge_x")
            spec.assert_str_eq(got, "REDIRECTED", "overridden dep read from the supplied dir")
            // a missing artifact under the override falls through (returns "")
            miss = _read_dep_artifact(ctx, "p/.build.ae", "no_such_edge")
            spec.assert_str_eq(miss, "", "missing override artifact falls through")
            _u = os.setenv("AEB_OVERRIDE_DEP", "")
        }
    }

    return spec.run_summary(fw)
}
