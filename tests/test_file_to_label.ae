// Tests for file_to_label() and extract_tag() — the label/tag
// derivation that disambiguates multiple .build*.ae / .tests*.ae /
// .dist*.ae files in the same directory.
//
// This imports the SAME `aeblabel` module that tools/file-to-label.ae,
// tools/gen-orchestrator.ae and tools/aeb-link.ae import. There is no
// inlined copy any more — the three former copies were consolidated
// into tools/aeblabel/module.ae, so this test exercises the exact
// code the build path runs. Drift is structurally impossible: there
// is only one implementation. (tests/run.sh builds with `--lib lib
// --lib tools` so the import resolves — multi-entry --lib, aether
// 0.150.)
import std.spec
import aeblabel (extract_tag, file_to_label, infer_type)

main() {
    fw = spec.init()

    // --- extract_tag: DEPRECATED — tags are gone, always "" ---
    spec.describe(fw, "extract_tag (deprecated → always empty)") {
        spec.it("empty (.build.ae)") callback {
            spec.assert_str_eq(extract_tag("ae/svnserver/.build.ae"), "", "tag: deprecated always empty (.build.ae)")
        }
        spec.it("empty (.build-seed.ae)") callback {
            spec.assert_str_eq(extract_tag("ae/svnserver/.build-seed.ae"), "", "tag: deprecated always empty (.build-seed.ae)")
        }
        spec.it("empty (.tests-int.ae)") callback {
            spec.assert_str_eq(extract_tag("ae/x/.tests-int.ae"), "", "tag: deprecated always empty (.tests-int.ae)")
        }
        spec.it("empty (empty)") callback {
            spec.assert_str_eq(extract_tag(""), "", "tag: deprecated always empty (empty)")
        }
    }

    // --- infer_type: the WHOLE .<name>.ae segment IS the type, verbatim ---
    spec.describe(fw, "infer_type (verbatim segment)") {
        spec.it(".build.ae") callback {
            spec.assert_str_eq(infer_type("ae/svnserver/.build.ae"), "build", "type: .build.ae")
        }
        spec.it(".tests.ae (literal, no alias)") callback {
            spec.assert_str_eq(infer_type("ae/svnserver/.tests.ae"), "tests", "type: .tests.ae (literal, no alias)")
        }
        spec.it(".test.ae (singular, equally literal)") callback {
            spec.assert_str_eq(infer_type("ae/x/.test.ae"), "test", "type: .test.ae (singular, equally literal)")
        }
        spec.it(".tes.ae (typo, still literal)") callback {
            spec.assert_str_eq(infer_type("ae/x/.tes.ae"), "tes", "type: .tes.ae (typo, still literal)")
        }
        spec.it(".dist.ae") callback {
            spec.assert_str_eq(infer_type("ae/svnserver/.dist.ae"), "dist", "type: .dist.ae")
        }
        spec.it(".install.ae") callback {
            spec.assert_str_eq(infer_type("tools/remote-agent/.install.ae"), "install", "type: .install.ae")
        }
        spec.it(".bidi-codegen.ae (dashes kept)") callback {
            spec.assert_str_eq(infer_type("py/.bidi-codegen.ae"), "bidi-codegen", "type: .bidi-codegen.ae (dashes kept)")
        }
        spec.it(".quantum-signal.ae") callback {
            spec.assert_str_eq(infer_type("foo/.quantum-signal.ae"), "quantum-signal", "type: .quantum-signal.ae")
        }
        spec.it(".essais.ae (French)") callback {
            spec.assert_str_eq(infer_type("foo/.essais.ae"), "essais", "type: .essais.ae (French)")
        }
        spec.it("bare dir → build") callback {
            spec.assert_str_eq(infer_type("ae/x"), "build", "type: bare dir → build")
        }
        spec.it("non-build-file → build") callback {
            spec.assert_str_eq(infer_type("ae/x/main.ae"), "build", "type: non-build-file → build")
        }
    }

    // --- file_to_label: <type>:<dir> for non-build, bare <dir> for build ---
    spec.describe(fw, "file_to_label") {
        spec.it(".build.ae (unprefixed)") callback {
            spec.assert_str_eq(file_to_label("ae/svnserver/.build.ae"), "ae/svnserver", "label: .build.ae (unprefixed)")
        }
        spec.it(".tests.ae (literal type prefix)") callback {
            spec.assert_str_eq(file_to_label("ae/svnserver/.tests.ae"), "tests:ae/svnserver", "label: .tests.ae (literal type prefix)")
        }
        spec.it(".dist.ae") callback {
            spec.assert_str_eq(file_to_label("ae/svnserver/.dist.ae"), "dist:ae/svnserver", "label: .dist.ae")
        }
        spec.it(".install.ae") callback {
            spec.assert_str_eq(file_to_label("tools/remote-agent/.install.ae"), "install:tools/remote-agent", "label: .install.ae")
        }
        spec.it(".bidi-codegen.ae") callback {
            spec.assert_str_eq(file_to_label("py/.bidi-codegen.ae"), "bidi-codegen:py", "label: .bidi-codegen.ae")
        }
        spec.it("top-level .build.ae") callback {
            spec.assert_str_eq(file_to_label(".build.ae"), ".", "label: top-level .build.ae")
        }
        spec.it("deep path") callback {
            spec.assert_str_eq(file_to_label("a/b/c/d/.build.ae"), "a/b/c/d", "label: deep path")
        }
    }

    // --- co-located variants are just different-named TYPES (no tags) ---
    // ae/svnserver/.build.ae and ae/svnserver/.seed.ae are types build + seed.
    spec.describe(fw, "co-located variants (distinct types, no tags)") {
        spec.it(".seed.ae is type 'seed'") callback {
            spec.assert_str_eq(file_to_label("ae/svnserver/.seed.ae"), "seed:ae/svnserver", "colocated: .seed.ae is type 'seed'")
        }
        spec.it("distinct from .build.ae") callback {
            spec.assert_str_eq(file_to_label("ae/svnserver/.build.ae"), "ae/svnserver", "colocated: distinct from .build.ae")
        }
    }

    return spec.run_summary(fw)
}
