// Tests for file_to_label() and extract_tag() — the label/tag
// derivation that disambiguates multiple .build*.ae / .tests*.ae /
// .dist*.ae files in the same directory.
//
// This imports the SAME `aeblabel` module that tools/file-to-label.ae,
// tools/gen-orchestrator.ae and tools/aeb-link.ae import. There is no
// inlined copy any more — the three former copies were consolidated
// into tools/aeblabel/module.ae, so this test exercises the exact
// code the build path runs. Drift is structurally impossible: there
// is only one implementation. (tests/run.sh builds with `--lib lib
// --lib tools` so the import resolves — multi-entry --lib, aether
// 0.150.)
import std.string

extern println(s: string)

import aeblabel (extract_tag, file_to_label, infer_type)

_assert_eq(label: string, actual: string, expected: string) {
    if actual == expected {
        println("PASS: ${label}")
    } else {
        println("FAIL: ${label}")
        println("  expected: '${expected}'")
        println("  actual:   '${actual}'")
    }
}

main() {
    // --- extract_tag: DEPRECATED — tags are gone, always "" ---
    _assert_eq("tag: deprecated always empty (.build.ae)",     extract_tag("ae/svnserver/.build.ae"),      "")
    _assert_eq("tag: deprecated always empty (.build-seed.ae)",extract_tag("ae/svnserver/.build-seed.ae"), "")
    _assert_eq("tag: deprecated always empty (.tests-int.ae)", extract_tag("ae/x/.tests-int.ae"),          "")
    _assert_eq("tag: deprecated always empty (empty)",         extract_tag(""),                            "")

    // --- infer_type: the WHOLE .<name>.ae segment IS the type, verbatim ---
    _assert_eq("type: .build.ae",          infer_type("ae/svnserver/.build.ae"),          "build")
    _assert_eq("type: .tests.ae (alias)",  infer_type("ae/svnserver/.tests.ae"),          "test")
    _assert_eq("type: .dist.ae",           infer_type("ae/svnserver/.dist.ae"),           "dist")
    _assert_eq("type: .install.ae",        infer_type("tools/remote-agent/.install.ae"),  "install")
    _assert_eq("type: .bidi-codegen.ae (dashes kept)", infer_type("py/.bidi-codegen.ae"), "bidi-codegen")
    _assert_eq("type: .quantum-signal.ae", infer_type("foo/.quantum-signal.ae"),          "quantum-signal")
    _assert_eq("type: .essais.ae (French)",infer_type("foo/.essais.ae"),                  "essais")
    _assert_eq("type: bare dir → build",   infer_type("ae/x"),                            "build")
    _assert_eq("type: non-build-file → build", infer_type("ae/x/main.ae"),                "build")

    // --- file_to_label: <type>:<dir> for non-build, bare <dir> for build ---
    _assert_eq("label: .build.ae (unprefixed)", file_to_label("ae/svnserver/.build.ae"), "ae/svnserver")
    _assert_eq("label: .tests.ae", file_to_label("ae/svnserver/.tests.ae"), "test:ae/svnserver")
    _assert_eq("label: .dist.ae",  file_to_label("ae/svnserver/.dist.ae"),  "dist:ae/svnserver")
    _assert_eq("label: .install.ae", file_to_label("tools/remote-agent/.install.ae"), "install:tools/remote-agent")
    _assert_eq("label: .bidi-codegen.ae", file_to_label("py/.bidi-codegen.ae"), "bidi-codegen:py")
    _assert_eq("label: top-level .build.ae", file_to_label(".build.ae"),    ".")
    _assert_eq("label: deep path",            file_to_label("a/b/c/d/.build.ae"), "a/b/c/d")

    // --- co-located variants are just different-named TYPES (no tags) ---
    // ae/svnserver/.build.ae and ae/svnserver/.seed.ae are types build + seed.
    _assert_eq("colocated: .seed.ae is type 'seed'", file_to_label("ae/svnserver/.seed.ae"), "seed:ae/svnserver")
    _assert_eq("colocated: distinct from .build.ae", file_to_label("ae/svnserver/.build.ae"), "ae/svnserver")

    println("file_to_label tests done")
}
