// Unit tests for the aether.program include-dir + out-of-tree regen
// helpers (the two mquickjs follow-up gaps):
//   Gap 1 — _resolved_user_include_dirs / _inc_flags_from_dirs build the
//           extra `-I` block for extra_source C compiles.
//   Gap 2 — _encode_path_for_filename / _regen_target_c place each
//           regen'd .c under target/regen/ with a collision-free name.
// Pure helpers — no toolchain or filesystem needed.

import std.spec
import std.string
import std.list
import std.map

import aether (_encode_path_for_filename, _regen_target_c,
               _inc_flags_from_dirs, _resolved_user_include_dirs)

main() {
    fw = spec.init()

    spec.describe(fw, "Gap 2: path encoding + target placement") {
        spec.it("encode replaces non-alnum with _") callback {
            spec.assert_str_eq(_encode_path_for_filename("/proj/ae/foo.ae"),
                "_proj_ae_foo_ae", "encode non-alnum")
        }
        spec.it("encode keeps digits") callback {
            spec.assert_str_eq(_encode_path_for_filename("a1/b2.ae"), "a1_b2_ae", "keeps digits")
        }
        spec.it("regen target lands under target/regen/") callback {
            spec.assert_str_eq(_regen_target_c("/t", "/proj/ae/foo.ae"),
                "/t/regen/_proj_ae_foo_ae_generated.c", "regen placement")
        }
        // Same basename in different dirs must NOT collide (the whole path
        // is encoded, so the outputs differ).
        spec.it("same-basename sources get distinct generated names") callback {
            a = _regen_target_c("/t", "/x/util.ae")
            b = _regen_target_c("/t", "/y/util.ae")
            spec.assert_false(string.equals(a, b), "distinct names")
        }
    }

    spec.describe(fw, "Gap 1: include-dir flag assembly") {
        spec.it("inc flags quote each dir") callback {
            dirs = list.new()
            list.add(dirs, "/i1")
            list.add(dirs, "/i2")
            spec.assert_str_eq(_inc_flags_from_dirs(dirs), " -I'/i1' -I'/i2'", "quoted dirs")
        }
        spec.it("inc flags empty for no dirs") callback {
            empty = list.new()
            spec.assert_str_eq(_inc_flags_from_dirs(empty), "", "empty")
        }
    }

    spec.describe(fw, "user include_dir() resolution") {
        // relative resolves against source_dir, absolute passes through.
        spec.it("two resolved user include dirs, relative + absolute") callback {
            bm = map.new()
            ud = list.new()
            list.add(ud, "inc")
            list.add(ud, "/abs/inc")
            map.put(bm, "include_dir", ud)
            res = _resolved_user_include_dirs(bm, "/src")
            spec.assert_eq(list.size(res), 2, "two dirs")
            r0, _ = list.get(res, 0)
            r1, _ = list.get(res, 1)
            spec.assert_str_eq(r0, "/src/inc", "relative → source_dir")
            spec.assert_str_eq(r1, "/abs/inc", "absolute passes through")
        }
        // No include_dir declared → empty list (no NPE on a bare builder).
        spec.it("no include_dir → empty resolved list") callback {
            bm2 = map.new()
            spec.assert_eq(list.size(_resolved_user_include_dirs(bm2, "/src")), 0, "empty")
        }
        spec.it("null builder → empty resolved list") callback {
            spec.assert_eq(list.size(_resolved_user_include_dirs(null, "/src")), 0, "null builder")
        }
    }

    spec.run_summary(fw)
}
