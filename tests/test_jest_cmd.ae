// Tests for jest.jest_cmd()
import std.spec
import std.map
import jest (jest_cmd)

main() {
    fw = spec.init()

    spec.describe(fw, "jest_cmd") {
        spec.it("basic 60s") callback {
            spec.assert_str_eq(
                jest_cmd("/proj/.aeb/.bin/jest", "/proj/apps/web/jest.config.ts", "60", null),
                "timeout 60 /proj/.aeb/.bin/jest --config '/proj/apps/web/jest.config.ts' --passWithNoTests", "basic 60s")
        }

        spec.it("300s") callback {
            spec.assert_str_eq(
                jest_cmd("/n/jest", "/p/jest.config.ts", "300", null),
                "timeout 300 /n/jest --config '/p/jest.config.ts' --passWithNoTests", "300s")
        }

        spec.it("extra coverage") callback {
            opts3 = map_new()
            map_put(opts3, "extra", "--coverage")
            spec.assert_str_eq(
                jest_cmd("/n/jest", "/p/cfg.ts", "60", opts3),
                "timeout 60 /n/jest --config '/p/cfg.ts' --passWithNoTests --coverage", "extra coverage")
        }

        spec.it("multiple extra flags") callback {
            opts4 = map_new()
            map_put(opts4, "extra", "--bail --maxWorkers=2")
            spec.assert_str_eq(
                jest_cmd("/n/jest", "/p/cfg.ts", "120", opts4),
                "timeout 120 /n/jest --config '/p/cfg.ts' --passWithNoTests --bail --maxWorkers=2", "multiple extra flags")
        }
    }

    return spec.run_summary(fw)
}
