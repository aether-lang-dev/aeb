// Tests for go.go_mod_content() — consumer go.mod generation.
// Mirrors tests/test_gleam_toml.ae.
import std.spec
import std.list
import std.map

import go (go_mod_content)

main() {
    fw = spec.init()

    spec.describe(fw, "go_mod_content") {
        spec.it("minimal defaults") callback {
            t = go_mod_content(null)
            spec.assert_contains(t, "module example.com/app", "default module path")
            spec.assert_contains(t, "go 1.21", "default go version")
            spec.assert_false(string_contains(t, "require ("), "no require block when empty")
        }

        spec.it("explicit module path + go version") callback {
            o = map_new()
            map_put(o, "manifest_name", "example.com/selenium")
            map_put(o, "manifest_go_version", "1.22")
            t = go_mod_content(o)
            spec.assert_contains(t, "module example.com/selenium", "explicit module path")
            spec.assert_contains(t, "go 1.22", "explicit go version")
        }

        spec.it("require block") callback {
            o = map_new()
            reqs = list_new()
            list_add(reqs, "golang.org/x/net~v0.17.0")
            list_add(reqs, "github.com/stretchr/testify~v1.9.0")
            map_put(o, "manifest_requires", reqs)
            t = go_mod_content(o)
            spec.assert_contains(t, "require (", "has require block")
            spec.assert_contains(t, "golang.org/x/net v0.17.0", "require 1 path+ver")
            spec.assert_contains(t, "github.com/stretchr/testify v1.9.0", "require 2 path+ver")
            spec.assert_contains(t, ")", "require block closes")
        }
    }

    return spec.run_summary(fw)
}
