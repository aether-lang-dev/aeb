// Tests for lib/brew/module.ae's pure helpers and renderer.
//
// brew_formula_render is the renderer; _camelize, _basename, and
// _strip_dotbuild handle name munging. All pure — no fs.
//
// Imports from lib/brew directly (tests/run.sh builds with --lib lib/),
// no inlining.

import std.spec
import std.string
import brew (brew_formula_render, _camelize, _basename, _strip_dotbuild)

main() {
    fw = spec.init()

    spec.describe(fw, "_camelize") {
        spec.it("simple") callback {
            spec.assert_str_eq(_camelize("hello"), "Hello", "camelize: simple")
        }
        spec.it("hyphenated") callback {
            spec.assert_str_eq(_camelize("hello-world"), "HelloWorld", "camelize: hyphenated")
        }
        spec.it("triple") callback {
            spec.assert_str_eq(_camelize("a-b-c"), "ABC", "camelize: triple")
        }
        spec.it("empty fallback") callback {
            spec.assert_str_eq(_camelize(""), "Formula", "camelize: empty fallback")
        }
        spec.it("already cap") callback {
            spec.assert_str_eq(_camelize("Foo"), "Foo", "camelize: already cap")
        }
        spec.it("with digits") callback {
            spec.assert_str_eq(_camelize("svn2git"), "Svn2git", "camelize: with digits")
        }
    }

    spec.describe(fw, "_basename") {
        spec.it("nested path") callback {
            spec.assert_str_eq(_basename("lib/hello/.build.ae"), ".build.ae", "basename: nested path")
        }
        spec.it("leaf only") callback {
            spec.assert_str_eq(_basename("hello"), "hello", "basename: leaf only")
        }
        spec.it("trailing slash") callback {
            spec.assert_str_eq(_basename("foo/"), "", "basename: trailing slash")
        }
        spec.it("empty") callback {
            spec.assert_str_eq(_basename(""), "", "basename: empty")
        }
    }

    spec.describe(fw, "_strip_dotbuild") {
        spec.it(".build.ae") callback {
            spec.assert_str_eq(_strip_dotbuild(".build.ae"), "build", "strip: .build.ae")
        }
        spec.it(".dist.ae") callback {
            spec.assert_str_eq(_strip_dotbuild(".dist.ae"), "dist", "strip: .dist.ae")
        }
        spec.it(".foo.ae") callback {
            spec.assert_str_eq(_strip_dotbuild(".foo.ae"), "foo", "strip: .foo.ae")
        }
        spec.it("no leading dot") callback {
            spec.assert_str_eq(_strip_dotbuild("foo.ae"), "foo", "strip: no leading dot")
        }
        spec.it("no .ae") callback {
            spec.assert_str_eq(_strip_dotbuild(".foo"), "foo", "strip: no .ae")
        }
        spec.it("empty") callback {
            spec.assert_str_eq(_strip_dotbuild(""), "", "strip: empty")
        }
    }

    spec.describe(fw, "brew_formula_render") {
        // minimal (only required)
        spec.it("minimal") callback {
            minimal = brew_formula_render("Hello", "hello", "lib/hello/.build.ae",
                                          "", "",
                                          "https://example.com/hello.tgz",
                                          "abc123", "", "", "")
            expected_min = "# Generated by aeb (do not edit; regenerate via `aeb <.dist.ae>`)\nclass Hello < Formula\n  url \"https://example.com/hello.tgz\"\n  sha256 \"abc123\"\n\n  depends_on \"aeb\" => :build\n\n  def install\n    system \"aeb\", \"lib/hello/.build.ae\"\n    bin.install \"target/build/hello/bin/hello\"\n  end\n\n  test do\n    # Placeholder smoke — refine to exercise real behaviour.\n    system bin/\"hello\", \"--version\"\n  end\nend\n"
            spec.assert_str_eq(minimal, expected_min, "render: minimal")
        }

        // full
        spec.it("full") callback {
            full = brew_formula_render("HelloWorld", "hello-world", "lib/hello/.build.ae",
                                       "Tiny greeter",
                                       "https://example.com",
                                       "https://example.com/hello.tgz",
                                       "abc123", "MIT", "0.1.0", "")
            expected_full = "# Generated by aeb (do not edit; regenerate via `aeb <.dist.ae>`)\nclass HelloWorld < Formula\n  desc \"Tiny greeter\"\n  homepage \"https://example.com\"\n  url \"https://example.com/hello.tgz\"\n  sha256 \"abc123\"\n  license \"MIT\"\n  version \"0.1.0\"\n\n  depends_on \"aeb\" => :build\n\n  def install\n    system \"aeb\", \"lib/hello/.build.ae\"\n    bin.install \"target/build/hello-world/bin/hello-world\"\n  end\n\n  test do\n    # Placeholder smoke — refine to exercise real behaviour.\n    system bin/\"hello-world\", \"--version\"\n  end\nend\n"
            spec.assert_str_eq(full, expected_full, "render: full")
        }

        // custom test_assertion replaces the default
        spec.it("custom test replaces the default placeholder") callback {
            with_test = brew_formula_render("X", "x", "p.ae", "", "", "u", "s", "", "",
                                            "assert_match \"x v1\", shell_output(\"#{bin}/x --version\")")
            spec.assert_false(string.contains(with_test, "Placeholder smoke"),
                "render: custom test replaces placeholder")
            spec.assert_contains(with_test, "assert_match", "render: custom test line is present")
        }

        // omits empty optional sections
        spec.it("empty desc → no desc line") callback {
            no_desc = brew_formula_render("X", "x", "p.ae", "", "", "u", "s", "", "", "")
            spec.assert_false(string.contains(no_desc, "  desc "), "render: empty desc → no desc line")
        }
    }

    return spec.run_summary(fw)
}
