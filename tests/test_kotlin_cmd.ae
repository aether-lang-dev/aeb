// Tests for lib/kotlin's pure surface: the kotlinc invocation string
// (kotlinc_cmd, opts-driven flags) and the jvm_args() setter added so a
// kotlin_test run can pass JVM args (nothing could set it before).
//
// Note: jvm_args is a RUNTIME arg consumed by kotlin_test, NOT a compile
// flag — kotlinc_cmd does not read it. The two are tested separately, on
// purpose.
import std.spec
import std.map
import kotlin (kotlinc_cmd, jvm_args, jvm_target, api_version,
               language_version, compiler_plugin)

main() {
    fw = spec.init()

    spec.describe(fw, "kotlinc_cmd") {
        // --- bare (null opts) → just -d + -cp + files.
        spec.it("bare, null opts") callback {
            spec.assert_str_eq(
                kotlinc_cmd("/opt/kotlinc/bin/kotlinc", "/t/classes", "/cp/a.jar:/cp/b.jar", "Foo.kt Bar.kt", null),
                "/opt/kotlinc/bin/kotlinc -d /t/classes -cp /cp/a.jar:/cp/b.jar Foo.kt Bar.kt", "kotlinc_cmd bare, null opts")
        }

        // --- opts drive the flags, in the module's fixed order
        // (jvm_target, api_version, language_version, then the rest).
        spec.it("with jvm_target + api/language version") callback {
            o = map.new()
            jvm_target(o, "21")
            api_version(o, "2.0")
            language_version(o, "2.0")
            spec.assert_str_eq(
                kotlinc_cmd("kotlinc", "/t", "cp", "F.kt", o),
                "kotlinc -d /t -jvm-target 21 -api-version 2.0 -language-version 2.0 -cp cp F.kt", "kotlinc_cmd with jvm_target + api/language version")
        }

        // --- compiler_plugin → -Xplugin=<path> (accumulates comma-joined in the
        // setter; kotlinc_cmd emits it verbatim).
        spec.it("with compiler_plugin") callback {
            o2 = map.new()
            compiler_plugin(o2, "/plugins/allopen.jar")
            spec.assert_str_eq(
                kotlinc_cmd("kotlinc", "/t", "cp", "F.kt", o2),
                "kotlinc -d /t -Xplugin=/plugins/allopen.jar -cp cp F.kt", "kotlinc_cmd with compiler_plugin")
        }
    }

    spec.describe(fw, "compiler_plugin setter") {
        // --- setter accumulates comma-joined, order preserved.
        spec.it("accumulates comma-joined") callback {
            cp = map.new()
            compiler_plugin(cp, "/p/a.jar")
            compiler_plugin(cp, "/p/b.jar")
            cpv, _ = map.get(cp, "compiler_plugin")
            spec.assert_str_eq(cpv, "/p/a.jar,/p/b.jar", "compiler_plugin accumulates comma-joined")
        }
    }

    spec.describe(fw, "jvm_args setter") {
        // --- jvm_args(arg): space-accumulating setter (a RUNTIME JVM arg for
        // kotlin_test; not a kotlinc flag). Stored under "jvm_args".
        spec.it("first arg stored, second space-appended") callback {
            ja = map.new()
            jvm_args(ja, "--enable-native-access=ALL-UNNAMED")
            jav, _ = map.get(ja, "jvm_args")
            spec.assert_str_eq(jav, "--enable-native-access=ALL-UNNAMED", "jvm_args first arg stored")
            jvm_args(ja, "-Xmx512m")
            jav2, _ = map.get(ja, "jvm_args")
            spec.assert_str_eq(jav2, "--enable-native-access=ALL-UNNAMED -Xmx512m", "jvm_args second arg space-appended")
        }
    }

    return spec.run_summary(fw)
}
