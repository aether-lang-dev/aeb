// Tests for the webhook SDK's pure on() gate evaluator,
// webhook.gate_passes. Environment facts (is_ci, ci_system, branch)
// are passed in as data, so the evaluator is exercised directly with
// no real environment probing.

import std.spec
import webhook (gate_passes)

main() {
    fw = spec.init()

    // gate_passes returns 1 (fire) / 0 (skip).
    spec.describe(fw, "ci / local") {
        spec.it("ci under CI") callback {
            spec.assert_eq(gate_passes("ci", 1, "github", "main"), 1, "ci under CI")
        }
        spec.it("ci while local") callback {
            spec.assert_eq(gate_passes("ci", 0, "local", "main"), 0, "ci while local")
        }
        spec.it("local while local") callback {
            spec.assert_eq(gate_passes("local", 0, "local", "x"), 1, "local while local")
        }
        spec.it("local under CI") callback {
            spec.assert_eq(gate_passes("local", 1, "github", "x"), 0, "local under CI")
        }
    }

    spec.describe(fw, "branch globs") {
        spec.it("branch exact hit") callback {
            spec.assert_eq(gate_passes("branch:main", 0, "local", "main"), 1, "branch exact hit")
        }
        spec.it("branch exact miss") callback {
            spec.assert_eq(gate_passes("branch:main", 0, "local", "dev"), 0, "branch exact miss")
        }
        spec.it("branch glob hit") callback {
            spec.assert_eq(gate_passes("branch:rel-*", 0, "local", "rel-9"), 1, "branch glob hit")
        }
        spec.it("branch glob miss") callback {
            spec.assert_eq(gate_passes("branch:rel-*", 0, "local", "main"), 0, "branch glob miss")
        }
    }

    spec.describe(fw, "CI-system match") {
        spec.it("ci-system hit") callback {
            spec.assert_eq(gate_passes("github", 1, "github", "x"), 1, "ci-system hit")
        }
        spec.it("ci-system miss") callback {
            spec.assert_eq(gate_passes("github", 1, "jenkins", "x"), 0, "ci-system miss")
        }
    }

    spec.describe(fw, "negation") {
        spec.it("!system hit") callback {
            spec.assert_eq(gate_passes("!jenkins", 1, "github", "x"), 1, "!system hit")
        }
        spec.it("!system miss") callback {
            spec.assert_eq(gate_passes("!jenkins", 1, "jenkins", "x"), 0, "!system miss")
        }
        spec.it("!branch excludes") callback {
            spec.assert_eq(gate_passes("!branch:wip-*", 0, "local", "wip-7"), 0, "!branch excludes")
        }
        spec.it("!branch allows") callback {
            spec.assert_eq(gate_passes("!branch:wip-*", 0, "local", "main"), 1, "!branch allows")
        }
        spec.it("!local under CI") callback {
            spec.assert_eq(gate_passes("!local", 1, "github", "x"), 1, "!local under CI")
        }
    }

    return spec.run_summary(fw)
}
