// Tests for dockerfile_full_content() — the "Containerfile lines inline as
// aeb DSL" generator (from/arg/run_step/workdir/expose/entrypoint), including
// that ordered steps (WORKDIR between two RUNs) render in call order.
import std.spec
import container (from, arg, run_step, expose, entrypoint, workdir, dockerfile_full_content)

main() {
    fw = spec.init()

    spec.describe(fw, "dockerfile_full_content") {
        // Minimal: just FROM.
        spec.it("from only") callback {
            b1 = map_new()
            from(b1, "alpine:3")
            spec.assert_str_eq(dockerfile_full_content(b1), "FROM alpine:3\n", "from only")
        }

        // ARG + a single RUN.
        spec.it("from + arg + run") callback {
            b2 = map_new()
            from(b2, "debian:trixie-slim")
            arg(b2, "REF", "main")
            run_step(b2, "apt-get update")
            spec.assert_str_eq(dockerfile_full_content(b2),
                "FROM debian:trixie-slim\nARG REF=main\nRUN apt-get update\n", "from + arg + run")
        }

        // Ordering: WORKDIR must land BETWEEN the two RUNs (call order).
        spec.it("ordered run/workdir/run") callback {
            b3 = map_new()
            from(b3, "debian:trixie-slim")
            run_step(b3, "step-one")
            workdir(b3, "/opt/aeb")
            run_step(b3, "step-two")
            spec.assert_str_eq(dockerfile_full_content(b3),
                "FROM debian:trixie-slim\nRUN step-one\nWORKDIR /opt/aeb\nRUN step-two\n", "ordered run/workdir/run")
        }

        // EXPOSE + ENTRYPOINT tail.
        spec.it("expose + entrypoint") callback {
            b4 = map_new()
            from(b4, "debian:trixie-slim")
            run_step(b4, "make install")
            expose(b4, "9440")
            entrypoint(b4, "[\"aeb-agent\", \"--port\", \"9440\"]")
            spec.assert_str_eq(dockerfile_full_content(b4),
                "FROM debian:trixie-slim\nRUN make install\nEXPOSE 9440\nENTRYPOINT [\"aeb-agent\", \"--port\", \"9440\"]\n", "expose + entrypoint")
        }

        // Multi-line heredoc RUN payloads: the step separator is RS (\x1e), so a
        // payload's OWN newlines must survive intact (not be mistaken for the
        // step delimiter). Two multi-line RUNs render with their internal
        // newlines preserved.
        spec.it("multi-line heredoc RUNs preserve internal newlines") callback {
            b5 = map_new()
            from(b5, "debian:trixie-slim")
            run_step(b5, <<SH
apt-get update \
    && apt-get install -y git
SH
)
            run_step(b5, <<SH
git clone foo \
    && make install
SH
)
            spec.assert_str_eq(dockerfile_full_content(b5),
                "FROM debian:trixie-slim\nRUN apt-get update \\\n    && apt-get install -y git\nRUN git clone foo \\\n    && make install\n",
                "multi-line heredoc RUNs preserve internal newlines")
        }
    }

    spec.run_summary(fw)
}
