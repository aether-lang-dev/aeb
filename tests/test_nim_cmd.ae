// Tests for nim_c_run_cmd() — the pure per-file `nim c -r` command builder.
import std.spec
import nim (nim_c_run_cmd)

main() {
    fw = spec.init()

    spec.describe(fw, "nim_c_run_cmd") {
        spec.it("no flags — just compile-and-run the quoted file") callback {
            spec.assert_str_eq(nim_c_run_cmd("tests/playback.nim", ""),
                "nim c -r \"tests/playback.nim\"", "no flags")
        }
        // The servirtium-vcr binding's exact flag set — replaces the old shell
        // `for t in …; do nim c -r --hints:off --threads:on … "$t"; done` loop.
        spec.it("full flag set") callback {
            spec.assert_str_eq(nim_c_run_cmd("tests/record_test.nim",
                "--hints:off --threads:on --path:src --path:tests"),
                "nim c -r --hints:off --threads:on --path:src --path:tests \"tests/record_test.nim\"", "full")
        }
        spec.it("one flag") callback {
            spec.assert_str_eq(nim_c_run_cmd("tests/a.nim", "--threads:on"),
                "nim c -r --threads:on \"tests/a.nim\"", "one flag")
        }
        spec.it("path with space stays quoted") callback {
            spec.assert_str_eq(nim_c_run_cmd("tests/my test.nim", "--path:src"),
                "nim c -r --path:src \"tests/my test.nim\"", "spaces")
        }
    }

    return spec.run_summary(fw)
}
