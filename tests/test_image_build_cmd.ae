// Tests for image_build_cmd() — OCI container build command builder
import std.spec
import std.map
import container (image_build_cmd)

main() {
    fw = spec.init()

    spec.describe(fw, "image_build_cmd") {
        // Default engine is podman
        spec.it("default engine") callback {
            spec.assert_str_eq(
                image_build_cmd("myapp:latest", "/workspace", "/tmp/Dockerfile", null),
                "podman build -t myapp:latest -f /tmp/Dockerfile /workspace", "default engine")
        }

        // Explicit docker
        spec.it("docker engine") callback {
            opts2 = map_new()
            map_put(opts2, "engine", "docker")
            spec.assert_str_eq(
                image_build_cmd("myapp:v1", "/ws", "/tmp/df", opts2),
                "docker build -t myapp:v1 -f /tmp/df /ws", "docker engine")
        }

        // With extra flags
        spec.it("extra flags") callback {
            opts3 = map_new()
            map_put(opts3, "extra", "--no-cache --squash")
            spec.assert_str_eq(
                image_build_cmd("web:latest", ".", "/tmp/Dockerfile", opts3),
                "podman build -t web:latest -f /tmp/Dockerfile --no-cache --squash .", "extra flags")
        }

        // Docker with extra
        spec.it("docker + extra") callback {
            opts4 = map_new()
            map_put(opts4, "engine", "docker")
            map_put(opts4, "extra", "--build-arg VERSION=1.0")
            spec.assert_str_eq(
                image_build_cmd("app:1.0", "/root", "/root/Dockerfile", opts4),
                "docker build -t app:1.0 -f /root/Dockerfile --build-arg VERSION=1.0 /root", "docker + extra")
        }
    }

    return spec.run_summary(fw)
}
