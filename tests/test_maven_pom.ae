// Tests for lib/maven's tier-2 (temp-pom) pure helpers: pom.xml generation
// and the mvn lifecycle command. No Maven install needed — pure string
// builders (the impure java.mvn_project() writes the pom + runs the cmd).
import std.spec
import std.string
import std.list
import maven (pom_xml, mvn_lifecycle_cmd, _pom_dependency, _pom_dependencies)

main() {
    fw = spec.init()

    spec.describe(fw, "_pom_dependency") {
        // --- group:artifact:version → <dependency> block.
        spec.it("g:a:v") callback {
            spec.assert_str_eq(
                _pom_dependency("org.foo:bar:1.2.3"),
                "    <dependency>\n      <groupId>org.foo</groupId>\n      <artifactId>bar</artifactId>\n      <version>1.2.3</version>\n    </dependency>\n", "dependency g:a:v")
        }

        // --- with a trailing :scope → <scope> emitted (e.g. junit :test).
        spec.it("with test scope") callback {
            spec.assert_str_eq(
                _pom_dependency("org.junit.jupiter:junit-jupiter:5.10.2:test"),
                "    <dependency>\n      <groupId>org.junit.jupiter</groupId>\n      <artifactId>junit-jupiter</artifactId>\n      <version>5.10.2</version>\n      <scope>test</scope>\n    </dependency>\n", "dependency with test scope")
        }
    }

    spec.describe(fw, "_pom_dependencies") {
        // --- empty list / null → "".
        spec.it("no deps → empty block") callback {
            spec.assert_str_eq(_pom_dependencies(list_new()), "", "no deps → empty block")
        }

        // --- wraps entries in <dependencies>.
        spec.it("wraps entries in <dependencies>") callback {
            coords = list_new()
            _ = list_add(coords, "com.google.guava:guava:33.0.0-jre")
            _ = list_add(coords, "org.junit.jupiter:junit-jupiter:5.10.2:test")
            deps_xml = _pom_dependencies(coords)
            spec.assert_contains(deps_xml, "  <dependencies>\n", "dependencies block opens")
            spec.assert_contains(deps_xml, "<artifactId>guava</artifactId>", "dependencies block includes guava")
            spec.assert_contains(deps_xml, "<scope>test</scope>", "dependencies block includes junit test scope")
            spec.assert_contains(deps_xml, "  </dependencies>\n", "dependencies block closes")
        }
    }

    spec.describe(fw, "pom_xml") {
        // --- full project, coords + java version.
        spec.it("full project, coords + java version") callback {
            coords = list_new()
            _ = list_add(coords, "com.google.guava:guava:33.0.0-jre")
            _ = list_add(coords, "org.junit.jupiter:junit-jupiter:5.10.2:test")
            pom = pom_xml("aeb.gen", "temp-build", "0.0.0", "21", coords)
            spec.assert_contains(pom, "<modelVersion>4.0.0</modelVersion>", "pom has modelVersion")
            spec.assert_contains(pom, "<groupId>aeb.gen</groupId>", "pom groupId")
            spec.assert_contains(pom, "<artifactId>temp-build</artifactId>", "pom artifactId")
            spec.assert_contains(pom, "<maven.compiler.source>21</maven.compiler.source>", "pom compiler source from java_ver")
            spec.assert_contains(pom, "<maven.compiler.target>21</maven.compiler.target>", "pom compiler target from java_ver")
            spec.assert_contains(pom, "<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>", "pom UTF-8 encoding")
            spec.assert_contains(pom, "<artifactId>guava</artifactId>", "pom carries the deps")
        }

        // --- empty java_ver defaults to 17; no coords → no <dependencies>.
        spec.it("empty java_ver defaults to 17; no coords → no <dependencies>") callback {
            pom2 = pom_xml("g", "a", "1.0", "", list_new())
            spec.assert_contains(pom2, "<maven.compiler.source>17</maven.compiler.source>", "pom default java 17 source")
            spec.assert_false(string.contains(pom2, "<dependencies>"), "pom with no coords has no <dependencies>")
        }
    }

    spec.describe(fw, "mvn_lifecycle_cmd") {
        // --- compile + test (surefire) invocations.
        spec.it("compile cmd") callback {
            spec.assert_str_eq(
                mvn_lifecycle_cmd("/proj/java", "/proj/target/.pom.xml", "compile"),
                "cd '/proj/java' && mvn -q -f '/proj/target/.pom.xml' compile", "mvn compile cmd")
        }
        spec.it("test (surefire) cmd") callback {
            spec.assert_str_eq(
                mvn_lifecycle_cmd("/proj/java", "/proj/target/.pom.xml", "test"),
                "cd '/proj/java' && mvn -q -f '/proj/target/.pom.xml' test", "mvn test (surefire) cmd")
        }
    }

    spec.run_summary(fw)
}
