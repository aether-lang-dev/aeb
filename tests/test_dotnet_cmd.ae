// Tests for the pure surface of lib/dotnet: the exec-string builders
// (dotnet_build_cmd / dotnet_test_cmd / dotnet_pack_cmd), the csproj-path
// resolver, the glob helpers, and csproj_content's generated XML.
//
// Written on std.spec — describe/it groups, assert_str_eq for exec strings,
// assert_contains for the generated csproj XML. run_summary exits non-zero
// on any failure, so tests/run.sh judges it by exit code.
import std.spec
import std.string
import std.list
import std.map

import dotnet (dotnet_build_cmd, dotnet_test_cmd, dotnet_pack_cmd, csproj_path,
               _resolve_csproj_path, csproj_content,
               content_files, content_files_mode, native_runtime,
               package_id, package_version, package_description,
               package_readme, packable, test_project,
               _glob_lead_dir, _last_index_of)

main() {
    fw = spec.init()

    spec.describe(fw, "exec-string builders") {
        spec.it("dotnet_build_cmd Release") callback {
            spec.assert_str_eq(dotnet_build_cmd("/proj/.app.generated.csproj", "Release"),
                "dotnet build '/proj/.app.generated.csproj' --configuration Release", "build Release")
        }
        spec.it("dotnet_build_cmd Debug") callback {
            spec.assert_str_eq(dotnet_build_cmd("/proj/app.csproj", "Debug"),
                "dotnet build '/proj/app.csproj' --configuration Debug", "build Debug")
        }
        spec.it("dotnet_test_cmd Release passes --no-build") callback {
            spec.assert_str_eq(dotnet_test_cmd("/proj/.tests.generated.csproj", "Release"),
                "dotnet test '/proj/.tests.generated.csproj' --configuration Release --no-build", "test Release")
        }
        spec.it("dotnet_test_cmd Debug") callback {
            spec.assert_str_eq(dotnet_test_cmd("/proj/tests.csproj", "Debug"),
                "dotnet test '/proj/tests.csproj' --configuration Debug --no-build", "test Debug")
        }
        // An upstream-shipped csproj (consumed by build_project_existing)
        // takes the same exec shape; the setter naming the file rides on the
        // builder map separately.
        spec.it("dotnet_build_cmd over an upstream csproj") callback {
            spec.assert_str_eq(dotnet_build_cmd("/proj/Selenium.WebDriver.csproj", "Release"),
                "dotnet build '/proj/Selenium.WebDriver.csproj' --configuration Release", "build upstream")
        }
        spec.it("dotnet_pack_cmd Release into out dir") callback {
            spec.assert_str_eq(dotnet_pack_cmd("/proj/.lib.generated.csproj", "Release", "/proj/target/nupkg"),
                "dotnet pack '/proj/.lib.generated.csproj' --configuration Release --output '/proj/target/nupkg'", "pack Release")
        }
    }

    // _resolve_csproj_path — the pure helper consumed by
    // build_project_existing: empty→glob signal, bare-relative→joined,
    // absolute→passthrough, subdir prefix→joined, trailing slash→collapsed.
    spec.describe(fw, "_resolve_csproj_path") {
        spec.it("empty rel returns empty (glob source_dir)") callback {
            spec.assert_str_eq(_resolve_csproj_path("/proj/dotnet", ""), "", "empty")
        }
        spec.it("bare-relative joins source_dir") callback {
            spec.assert_str_eq(_resolve_csproj_path("/proj/dotnet", "Selenium.WebDriver.csproj"),
                "/proj/dotnet/Selenium.WebDriver.csproj", "bare")
        }
        spec.it("absolute path passes through") callback {
            spec.assert_str_eq(_resolve_csproj_path("/proj/dotnet", "/abs/path/Other.csproj"),
                "/abs/path/Other.csproj", "absolute")
        }
        spec.it("subdir prefix joins source_dir") callback {
            spec.assert_str_eq(_resolve_csproj_path("/proj/dotnet", "src/webdriver/Selenium.WebDriver.csproj"),
                "/proj/dotnet/src/webdriver/Selenium.WebDriver.csproj", "subdir")
        }
        spec.it("trailing slash on source_dir collapses cleanly") callback {
            spec.assert_str_eq(_resolve_csproj_path("/proj/dotnet/", "A.csproj"),
                "/proj/dotnet/A.csproj", "trailing slash")
        }
    }

    spec.describe(fw, "glob + index helpers") {
        spec.it("_last_index_of finds the final slash") callback {
            spec.assert_eq(_last_index_of("a/b/c", "/"), 3, "final slash")
        }
        spec.it("_last_index_of returns -1 when absent") callback {
            spec.assert_eq(_last_index_of("abc", "/"), -1, "absent")
        }
        spec.it("_glob_lead_dir: recursive glob → leading dir") callback {
            spec.assert_str_eq(_glob_lead_dir("tapes/**/*"), "tapes", "recursive")
        }
        spec.it("_glob_lead_dir: plain path → itself") callback {
            spec.assert_str_eq(_glob_lead_dir("data/fixture.json"), "data/fixture.json", "plain")
        }
        spec.it("_glob_lead_dir: bare wildcard → cwd") callback {
            spec.assert_str_eq(_glob_lead_dir("*.txt"), ".", "bare")
        }
        spec.it("_glob_lead_dir: nested wildcard trims to segment") callback {
            spec.assert_str_eq(_glob_lead_dir("a/b/*.cs"), "a/b", "nested")
        }
    }

    spec.describe(fw, "csproj_path setter") {
        spec.it("stores the path, last-call-wins") callback {
            bm = map_new()
            csproj_path(bm, "Selenium.WebDriver.csproj")
            csp, _ = map_get(bm, "csproj_path")
            spec.assert_str_eq(csp, "Selenium.WebDriver.csproj", "stored")
            csproj_path(bm, "Other.csproj")
            csp2, _ = map_get(bm, "csproj_path")
            spec.assert_str_eq(csp2, "Other.csproj", "last-call-wins")
        }
    }

    // csproj_content generates the <Project> XML. Each `it` builds its opts
    // map, renders once, and asserts the markup it should contain — the XML
    // sits inline at the assertion, not buried in a data structure.
    spec.describe(fw, "csproj_content: content files") {
        spec.it("content_files → <None ... PreserveNewest>") callback {
            cf = map_new()
            content_files(cf, "tapes/**/*")
            xml = csproj_content(cf, list_new(), list_new(), list_new())
            spec.assert_contains(xml,
                "<None Include=\"tapes/**/*\" CopyToOutputDirectory=\"PreserveNewest\" />", "None item")
        }
        spec.it("content_files_mode honors an explicit mode; extra globs append") callback {
            cf = map_new()
            content_files_mode(cf, "seed.sql", "Always")
            content_files(cf, "extra/**/*")
            xml = csproj_content(cf, list_new(), list_new(), list_new())
            spec.assert_contains(xml,
                "<None Include=\"seed.sql\" CopyToOutputDirectory=\"Always\" />", "explicit Always")
            spec.assert_contains(xml,
                "<None Include=\"extra/**/*\" CopyToOutputDirectory=\"PreserveNewest\" />", "appended glob")
        }
    }

    spec.describe(fw, "csproj_content: packaging + native runtimes") {
        spec.it("package_* metadata + native_runtime → packed items") callback {
            pk = map_new()
            package_id(pk, "Servirtium.Vcr")
            package_version(pk, "1.2.3")
            package_description(pk, "Native VCR")
            package_readme(pk, "README.md")
            native_runtime(pk, "linux-x64", "runtimes/linux-x64/native/libengine.so")
            native_runtime(pk, "osx-arm64", "runtimes/osx-arm64/native/libengine.dylib")
            xml = csproj_content(pk, list_new(), list_new(), list_new())
            spec.assert_contains(xml, "<PackageId>Servirtium.Vcr</PackageId>", "PackageId")
            spec.assert_contains(xml, "<IsPackable>true</IsPackable>", "IsPackable true")
            spec.assert_contains(xml, "<Version>1.2.3</Version>", "Version")
            spec.assert_contains(xml, "<Description>Native VCR</Description>", "Description")
            spec.assert_contains(xml, "<PackageReadmeFile>README.md</PackageReadmeFile>", "PackageReadmeFile")
            spec.assert_contains(xml,
                "<None Include=\"README.md\" Pack=\"true\" PackagePath=\"\" />", "readme packed at root")
            spec.assert_contains(xml,
                "<None Include=\"runtimes/linux-x64/native/libengine.so\" Pack=\"true\" PackagePath=\"runtimes/linux-x64/native/\" CopyToOutputDirectory=\"PreserveNewest\" />",
                "linux runtime")
            spec.assert_contains(xml, "PackagePath=\"runtimes/osx-arm64/native/\"", "osx runtime")
        }
        spec.it("packable() alone flips IsPackable true") callback {
            pk2 = map_new()
            packable(pk2)
            xml = csproj_content(pk2, list_new(), list_new(), list_new())
            spec.assert_contains(xml, "<IsPackable>true</IsPackable>", "packable")
        }
        spec.it("test_project → IsPackable false, no PackageId") callback {
            tp = map_new()
            test_project(tp)
            package_id(tp, "ShouldNotAppear")
            xml = csproj_content(tp, list_new(), list_new(), list_new())
            spec.assert_contains(xml, "<IsPackable>false</IsPackable>", "IsPackable false")
            spec.assert_false(string.contains(xml, "ShouldNotAppear"), "PackageId suppressed")
        }
    }

    spec.run_summary(fw)
}
