import std.string
import std.io
import std.os
import std.file
import std.fs
import std.list
import std.map
import std.path
import std.dir

import build
// Tests for dotnet.dotnet_build_cmd, dotnet.dotnet_test_cmd

import dotnet
import dotnet (dotnet_build_cmd, dotnet_test_cmd, csproj_path)

_assert_eq(label: string, actual: string, expected: string) {
    if actual == expected {
        println("PASS: ${label}")
    } else {
        println("FAIL: ${label}")
        println("  expected: ${expected}")
        println("  actual:   ${actual}")
    }
}

main() {
    _assert_eq("dotnet_build_cmd Release",
        dotnet_build_cmd("/proj/.app.generated.csproj", "Release"),
        "dotnet build '/proj/.app.generated.csproj' --configuration Release")

    _assert_eq("dotnet_build_cmd Debug",
        dotnet_build_cmd("/proj/app.csproj", "Debug"),
        "dotnet build '/proj/app.csproj' --configuration Debug")

    _assert_eq("dotnet_test_cmd Release no-build",
        dotnet_test_cmd("/proj/.tests.generated.csproj", "Release"),
        "dotnet test '/proj/.tests.generated.csproj' --configuration Release --no-build")

    _assert_eq("dotnet_test_cmd Debug",
        dotnet_test_cmd("/proj/tests.csproj", "Debug"),
        "dotnet test '/proj/tests.csproj' --configuration Debug --no-build")

    // --- dotnet_build_cmd over an upstream-shipped csproj (consumed
    // by build_project_existing) — same exec-string shape; the
    // setter that names the file rides separately on the builder map.
    _assert_eq("dotnet_build_cmd against upstream csproj",
        dotnet_build_cmd("/proj/Selenium.WebDriver.csproj", "Release"),
        "dotnet build '/proj/Selenium.WebDriver.csproj' --configuration Release")

    // --- csproj_path setter accumulation.
    bm = map_new()
    csproj_path(bm, "Selenium.WebDriver.csproj")
    csp, _ = map_get(bm, "csproj_path")
    _assert_eq("csproj_path setter stores the path",
        csp, "Selenium.WebDriver.csproj")

    csproj_path(bm, "Other.csproj")
    csp2, _ = map_get(bm, "csproj_path")
    _assert_eq("csproj_path last-call-wins",
        csp2, "Other.csproj")

    println("dotnet cmd tests done")
}
