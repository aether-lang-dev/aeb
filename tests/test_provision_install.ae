// Tests for lib/provision's install-recipe resolution (the cross-distro
// package-name handling). Pure string ops — no host probing, no execution.
// See docs/build-prerequisites-and-provisioning.md "Cross-distro package names".

import provision (_pm_install, _pkg_name, _tarball_recipe, _resolve_recipe)
import std.string

extern println(s: string)

_eq_s(label: string, got: string, want: string) {
    if string.equals(got, want) == 1 { println("PASS: ${label}") }
    else { println("FAIL: ${label} (got '${got}' want '${want}')") }
}
_contains(label: string, hay: string, needle: string) {
    if string.index_of(hay, needle) >= 0 { println("PASS: ${label}") }
    else { println("FAIL: ${label} ('${needle}' not in '${hay}')") }
}

main() {
    // --- ONE token (jdk) -> DIFFERENT package names per package manager ---
    _eq_s("pkg jdk/apt",    _pkg_name("jdk", "apt"),    "openjdk-21-jdk")
    _eq_s("pkg jdk/dnf",    _pkg_name("jdk", "dnf"),    "java-21-openjdk-devel")
    _eq_s("pkg jdk/apk",    _pkg_name("jdk", "apk"),    "openjdk21")
    _eq_s("pkg jdk/pacman", _pkg_name("jdk", "pacman"), "jdk-openjdk")

    // python diverges too (python3 vs python on Arch)
    _eq_s("pkg python/apt",    _pkg_name("python", "apt"),    "python3")
    _eq_s("pkg python/pacman", _pkg_name("python", "pacman"), "python")

    // unmapped toolchain -> "" (fail-closed upstream)
    _eq_s("pkg unmapped -> empty", _pkg_name("haskell", "apt"), "")
    // mapped toolchain but unknown PM -> "" (fail-closed)
    _eq_s("pkg jdk/unknownpm -> empty", _pkg_name("jdk", "zypper"), "")

    // --- _pm_install: correct command verb per PM ---
    _eq_s("install apt",    _pm_install("apt", "foo"),    "apt-get install -y foo")
    _eq_s("install dnf",    _pm_install("dnf", "foo"),    "dnf install -y foo")
    _eq_s("install apk",    _pm_install("apk", "foo"),    "apk add foo")
    _eq_s("install pacman", _pm_install("pacman", "foo"), "pacman -S --noconfirm foo")
    _eq_s("install unknownpm -> empty", _pm_install("zypper", "foo"), "")

    // --- tarball recipe: no PM in it, version-pinned, HOST-specific artifact ---
    zig = _tarball_recipe("zig", "0.13")
    _contains("tarball zig: pinned version in URL", zig, "0.13")
    _contains("tarball zig: fetches from ziglang.org", zig, "ziglang.org")
    // The artifact is host-specific: this suite runs on Linux/macOS (not the
    // MINGW box), so the slug must NOT be "windows" here. Assert the recipe
    // names a non-Windows artifact (a .tar.xz, never a .zip) on this host.
    _contains("tarball zig: host extractor is tar (non-Windows runner)", zig, "tar -xJ")
    _eq_s("tarball unmapped -> empty", _tarball_recipe("python", "3.14"), "")

    // --- _resolve_recipe: tarball preferred, else PM, else "" ---
    // zig resolves to the tarball regardless of pm (OS-invariant)
    rz = _resolve_recipe("zig:0.13", "apt")
    _contains("resolve zig -> tarball (ignores pm)", rz, "ziglang.org")
    // jdk has no tarball recipe -> falls through to the apt package
    rj = _resolve_recipe("jdk:21", "apt")
    _eq_s("resolve jdk/apt -> apt package", rj, "apt-get install -y openjdk-21-jdk")
    // jdk with no detected pm ("") -> unprovisionable
    _eq_s("resolve jdk/no-pm -> empty (fail-closed)", _resolve_recipe("jdk:21", ""), "")
    // unmapped token -> empty
    _eq_s("resolve unmapped -> empty", _resolve_recipe("haskell:9.4", "apt"), "")

    println("provision install tests done")
}
