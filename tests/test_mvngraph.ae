// mvngraph.settle: which versions a classpath holds, and that a diamond is
// settled only by an arbitration that names every version in contention.
import std.spec
import std.string
import mvngraph

// app -> b:1 -> d:1.0 ; app -> c:1 -> d:1.2 -> e:1
_diamond() {
    t = "root x:b:1\nroot x:c:1\n"
    t = string.concat(t, "art x:b:1|sb|/j/b-1.jar|tp/x/b/1|x:d:1.0|\n")
    t = string.concat(t, "art x:c:1|sc|/j/c-1.jar|tp/x/c/1|x:d:1.2|\n")
    t = string.concat(t, "art x:d:1.0|sd0|/j/d-1.0.jar|tp/x/d/1.0||\n")
    t = string.concat(t, "art x:d:1.2|sd2|/j/d-1.2.jar|tp/x/d/1.2|x:e:1|\n")
    t = string.concat(t, "art x:e:1|se|/j/e-1.jar|tp/x/e/1||")
    return t
}

main() {
    fw = spec.init()

    spec.describe(fw, "coordinates") {
        spec.it("ga and version, with and without a classifier") callback {
            spec.assert_str_eq(mvngraph.coord_ga("g.h:a:1.2"), "g.h:a", "ga")
            spec.assert_str_eq(mvngraph.coord_version("g.h:a:1.2"), "1.2", "version")
            spec.assert_str_eq(mvngraph.coord_ga("g:a:1.2:linux"), "g:a:linux", "classifier is part of the artifact")
        }
    }

    spec.describe(fw, "settle") {
        spec.it("no diamond: everything reachable, in breadth-first order") callback {
            t = "root x:b:1\nart x:b:1|sb|/j/b.jar|n|x:d:1.0|\nart x:d:1.0|sd|/j/d.jar|n||"
            s, applied, problems = mvngraph.settle(t, "")
            spec.assert_str_eq(problems, "", "no problems")
            spec.assert_str_eq(applied, "", "nothing arbitrated")
            spec.assert_str_eq(mvngraph.jars_of(s), "/j/b.jar\n/j/d.jar", "jars")
        }
        spec.it("a diamond with no arbitration is a problem that names both versions") callback {
            s, applied, problems = mvngraph.settle(_diamond(), "")
            spec.assert_str_eq(problems, "x:d|none|1.0,1.2|", "the problem")
        }
        spec.it("an arbitration settles it, and the pick's own deps come with it") callback {
            arbs = mvngraph.arb_line("own", "x:d", "1.2", "1.0", "app")
            s, applied, problems = mvngraph.settle(_diamond(), arbs)
            spec.assert_str_eq(problems, "", "no problems")
            spec.assert_str_eq(mvngraph.jars_of(s), "/j/b-1.jar\n/j/c-1.jar\n/j/d-1.2.jar\n/j/e-1.jar", "1.2 and e, not 1.0")
            spec.assert_str_eq(applied, "x:d|1.2|1.0|app|1.0", "what was applied and what lost")
            spec.assert_str_eq(mvngraph.lost_jars(_diamond(), s), "/j/d-1.0.jar", "the jar to take off the classpath")
        }
        spec.it("picking the older version drops what only the newer one needed") callback {
            arbs = mvngraph.arb_line("own", "x:d", "1.0", "1.2", "app")
            s, applied, problems = mvngraph.settle(_diamond(), arbs)
            spec.assert_str_eq(problems, "", "no problems")
            spec.assert_str_eq(mvngraph.jars_of(s), "/j/b-1.jar\n/j/c-1.jar\n/j/d-1.0.jar", "no e")
        }
        spec.it("an arbitration that does not name a version in contention does not cover it") callback {
            arbs = mvngraph.arb_line("own", "x:d", "1.2", "0.9", "app")
            s, applied, problems = mvngraph.settle(_diamond(), arbs)
            spec.assert_str_eq(problems, "x:d|uncovered|1.0,1.2|1.0", "1.0 was never named")
        }
        spec.it("a pick that is not on the classpath is a problem") callback {
            arbs = mvngraph.arb_line("own", "x:d", "2.0", "1.0, 1.2", "app")
            s, applied, problems = mvngraph.settle(_diamond(), arbs)
            spec.assert_str_eq(problems, "x:d|nopick|1.0,1.2|2.0", "2.0 has no node here")
        }
        spec.it("a root at a losing version is moved to the pick") callback {
            t = string.concat(_diamond(), "\nroot x:d:1.0")
            arbs = mvngraph.arb_line("own", "x:d", "1.2", "1.0", "app")
            s, applied, problems = mvngraph.settle(t, arbs)
            spec.assert_str_eq(problems, "", "no problems")
            spec.assert_str_eq(mvngraph.roots_of(s), "x:b:1\nx:c:1\nx:d:1.2", "roots")
        }
        spec.it("a settled record from below, and the arbitration that settled it") callback {
            // What a node that picked 1.2 hands up: b's pom still names d:1.0,
            // and d:1.0 has no line. The inherited arbitration says where it went.
            t = "root x:b:1\nroot x:c:1\nart x:b:1|sb|/j/b-1.jar|n|x:d:1.0|\nart x:c:1|sc|/j/c-1.jar|n|x:d:1.2|\nart x:d:1.2|sd2|/j/d-1.2.jar|n||"
            s0, a0, p0 = mvngraph.settle(t, "")
            spec.assert_str_eq(p0, "x:d|missing|1.0|", "without it, 1.0 is just missing")
            arbs = mvngraph.arb_line("inherited", "x:d", "1.2", "1.0", "lib")
            s, applied, problems = mvngraph.settle(t, arbs)
            spec.assert_str_eq(problems, "", "no problems")
            spec.assert_str_eq(mvngraph.jars_of(s), "/j/b-1.jar\n/j/c-1.jar\n/j/d-1.2.jar", "jars")
            spec.assert_str_eq(applied, "x:d|1.2|1.0|lib|1.0", "the arbitration is carried on up")
        }
        spec.it("something asked for that no node records is a problem") callback {
            t = "root x:b:1\nart x:b:1|sb|/j/b.jar|n|x:d:1.0|"
            s, applied, problems = mvngraph.settle(t, "")
            spec.assert_str_eq(problems, "x:d|missing|1.0|", "missing")
        }
    }

    spec.describe(fw, "whose arbitration") {
        spec.it("own beats inherited beats default") callback {
            arbs = mvngraph.arb_line("default", "x:d", "1.0", "1.2", "tp/x/d")
            arbs = string.concat(string.concat(arbs, "\n"), mvngraph.arb_line("inherited", "x:d", "1.2", "1.0", "lib"))
            pick, nots, wh, err = mvngraph.effective_arb(arbs, "x:d")
            spec.assert_str_eq(pick, "1.2", "inherited over default")
            arbs = string.concat(string.concat(arbs, "\n"), mvngraph.arb_line("own", "x:d", "1.0", "1.2", "app"))
            pick2, nots2, wh2, err2 = mvngraph.effective_arb(arbs, "x:d")
            spec.assert_str_eq(pick2, "1.0", "own over inherited")
            spec.assert_str_eq(wh2, "app", "where")
        }
        spec.it("two inherited that agree are one, with both and-not lists") callback {
            arbs = mvngraph.arb_line("inherited", "x:d", "1.2", "1.0", "l1")
            arbs = string.concat(string.concat(arbs, "\n"), mvngraph.arb_line("inherited", "x:d", "1.2", "1.1", "l2"))
            pick, nots, wh, err = mvngraph.effective_arb(arbs, "x:d")
            spec.assert_str_eq(err, "", "no error")
            spec.assert_str_eq(nots, "1.0,1.1", "union")
        }
        spec.it("two inherited that pick differently are a disagreement") callback {
            arbs = mvngraph.arb_line("inherited", "x:d", "1.2", "1.0", "l1")
            arbs = string.concat(string.concat(arbs, "\n"), mvngraph.arb_line("inherited", "x:d", "1.0", "1.2", "l2"))
            s, applied, problems = mvngraph.settle(_diamond(), arbs)
            spec.assert_str_eq(problems, "x:d|disagree|1.0,1.2|l1 and l2", "names both")
        }
    }

    spec.describe(fw, "an arbitration read from a build file's text") {
        spec.it("the statement for the artifact asked about") callback {
            src = "main() {\n    bldr.build() {\n        dep_arbitration(\"x:d\", \"1.2\", and_not(\"1.0, 1.1\"))\n        dep_arbitration(\"x:e\", \"3\", and_not(\"2\"))\n    }\n}\n"
            pick, nots = mvngraph.arbitration_in(src, "x:d")
            spec.assert_str_eq(pick, "1.2", "pick")
            spec.assert_str_eq(nots, "1.0,1.1", "and not, as a list")
            pick2, nots2 = mvngraph.arbitration_in(src, "x:e")
            spec.assert_str_eq(pick2, "3", "the other artifact's")
        }
        spec.it("none for another artifact, and none in a comment") callback {
            src = "    // dep_arbitration(\"x:d\", \"9\", and_not(\"8\"))\n    dep(\"x/d/1.0/.jar.ae\")\n"
            pick, nots = mvngraph.arbitration_in(src, "x:d")
            spec.assert_str_eq(pick, "", "a commented-out line is not a decision")
        }
    }

    spec.describe(fw, "a node's own arbitration, with no contest") {
        spec.it("moves a lone request for a version it names as not") callback {
            // Only b asks, for d:1.0. The node says 1.2, and not 1.0, and d:1.2 is on hand.
            t = "root x:b:1\nart x:b:1|sb|/j/b.jar|n|x:d:1.0|\nart x:d:1.0|s0|/j/d0.jar|n||\nart x:d:1.2|s2|/j/d2.jar|n||"
            s, applied, problems = mvngraph.settle(t, mvngraph.arb_line("own", "x:d", "1.2", "1.0", "x.bom.ae"))
            spec.assert_str_eq(problems, "", "no problems")
            spec.assert_str_eq(mvngraph.jars_of(s), "/j/b.jar\n/j/d2.jar", "1.2")
        }
        spec.it("an inherited or default one does not: they speak only to a contest") callback {
            t = "root x:b:1\nart x:b:1|sb|/j/b.jar|n|x:d:1.0|\nart x:d:1.0|s0|/j/d0.jar|n||\nart x:d:1.2|s2|/j/d2.jar|n||"
            s, applied, problems = mvngraph.settle(t, mvngraph.arb_line("default", "x:d", "1.2", "1.0", "tp"))
            spec.assert_str_eq(mvngraph.jars_of(s), "/j/b.jar\n/j/d0.jar", "1.0 stays")
        }
        spec.it("one that names nothing asked for changes nothing") callback {
            t = "root x:b:1\nart x:b:1|sb|/j/b.jar|n|x:d:1.0|\nart x:d:1.0|s0|/j/d0.jar|n||"
            s, applied, problems = mvngraph.settle(t, mvngraph.arb_line("own", "x:d", "1.2", "0.9", "x.bom.ae"))
            spec.assert_str_eq(problems, "", "no problems")
            spec.assert_str_eq(applied, "", "not applied")
        }
    }

    spec.describe(fw, "a coordinate and the files that stand for it") {
        spec.it("the node directory") callback {
            spec.assert_str_eq(mvngraph.node_dir("third_party/java", "org.x.y:lib:1.2"), "third_party/java/org/x/y/lib/1.2", "group dirs")
            spec.assert_str_eq(mvngraph.node_dir("tp", "g:a:1:linux"), "tp/g/a/1-linux", "classifier")
            spec.assert_str_eq(mvngraph.node_dir("tp", "g:a"), "", "no version, no directory")
        }
        spec.it("what is a coordinate") callback {
            spec.assert_eq(mvngraph.is_coord("g:a:1"), 1, "g:a:v")
            spec.assert_eq(mvngraph.is_coord("npm:left-pad@1"), 0, "npm")
            spec.assert_eq(mvngraph.is_coord("git:https://x/y#d:n"), 0, "git")
            spec.assert_eq(mvngraph.is_coord("libs/java/x"), 0, "a path")
        }
        spec.it("calls read from a file's text, whole names only, not comments") callback {
            src = "dep(\"a/.jar.ae\")\n  dep(\"g:a:1\")  dep(\"b\")\n// dep(\"no\")\ndep_arbitration(\"g:a\", \"1\", and_not(\"2\"))\npkg_dep(\"x\", \"y\")\n"
            spec.assert_str_eq(mvngraph.calls_in(src, "dep"), "a/.jar.ae\ng:a:1\nb", "dep only")
        }
        spec.it("what a BOM's record manages") callback {
            m = "managed(\"g:a\", \"1.2\")\nmanaged(\"g:ab\", \"9\")\n"
            spec.assert_str_eq(mvngraph.managed_version(m, "g:a"), "1.2", "g:a")
            spec.assert_str_eq(mvngraph.managed_version(m, "g:ab"), "9", "not a prefix match")
            spec.assert_str_eq(mvngraph.managed_version(m, "g:z"), "", "not managed")
        }
        spec.it("the coordinate a generated node is") callback {
            spec.assert_str_eq(mvngraph.node_coord("        java.jar_maven(\"g:a:1\", \"abc\")\n"), "g:a:1", "jar")
            spec.assert_str_eq(mvngraph.node_coord("        java.pom_maven(\"g:p:2\")\n"), "g:p:2", "pom")
            spec.assert_str_eq(mvngraph.node_coord("        java.javac()\n"), "", "any other build file")
        }
        spec.it("several lines for one artifact with the same pick are one") callback {
            src = "dep_arbitration(\"g:a\", \"2\", and_not(\"1.0\"))\ndep_arbitration(\"g:a\", \"2\", and_not(\"1.1\"))\ndep_arbitration(\"g:a\", \"3\", and_not(\"2\"))\n"
            spec.assert_str_eq(mvngraph.arbitrations_in(src), "g:a|2|1.0,1.1", "the first pick, all its lists")
        }
    }

    spec.describe(fw, "exclusions") {
        spec.it("an exclusion on an edge holds for everything reached through it") callback {
            // b -> c excluding x:e ; c -> d -> e
            t = "root x:b:1\nart x:b:1|s|/j/b.jar|n|x:c:1|x:c>x:e\n"
            t = string.concat(t, "art x:c:1|s|/j/c.jar|n|x:d:1|\nart x:d:1|s|/j/d.jar|n|x:e:1|\nart x:e:1|s|/j/e.jar|n||")
            s, applied, problems = mvngraph.settle(t, "")
            spec.assert_str_eq(problems, "", "no problems")
            spec.assert_str_eq(mvngraph.jars_of(s), "/j/b.jar\n/j/c.jar\n/j/d.jar", "no e")
        }
        spec.it("reached by another path that does not exclude it, it stays") callback {
            t = "root x:b:1\nroot x:d:1\nart x:b:1|s|/j/b.jar|n|x:c:1|x:c>x:e\n"
            t = string.concat(t, "art x:c:1|s|/j/c.jar|n|x:d:1|\nart x:d:1|s|/j/d.jar|n|x:e:1|\nart x:e:1|s|/j/e.jar|n||")
            s, applied, problems = mvngraph.settle(t, "")
            spec.assert_contains(mvngraph.jars_of(s), "/j/e.jar", "e via the root d")
        }
        spec.it("an excluded version does not make a diamond") callback {
            // b -> d:1.0 ; c -> f excluding x:d ; f -> d:1.2
            t = "root x:b:1\nroot x:c:1\nart x:b:1|s|/j/b.jar|n|x:d:1.0|\nart x:c:1|s|/j/c.jar|n|x:f:1|x:f>x:d\n"
            t = string.concat(t, "art x:f:1|s|/j/f.jar|n|x:d:1.2|\nart x:d:1.0|s|/j/d0.jar|n||\nart x:d:1.2|s|/j/d2.jar|n||")
            s, applied, problems = mvngraph.settle(t, "")
            spec.assert_str_eq(problems, "", "no diamond")
            spec.assert_str_eq(mvngraph.jars_of(s), "/j/b.jar\n/j/c.jar\n/j/d0.jar\n/j/f.jar", "only 1.0")
        }
        spec.it("a group wildcard") callback {
            t = "root x:b:1\nart x:b:1|s|/j/b.jar|n|x:c:1;y:z:1|x:c>*:*\nart x:c:1|s|/j/c.jar|n|x:d:1|\nart x:d:1|s|/j/d.jar|n||\nart y:z:1|s|/j/z.jar|n||"
            s, applied, problems = mvngraph.settle(t, "")
            spec.assert_str_eq(mvngraph.jars_of(s), "/j/b.jar\n/j/c.jar\n/j/z.jar", "c's whole subtree, not z")
        }
    }

    return spec.run_summary(fw)
}
