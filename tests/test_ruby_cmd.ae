// Tests for lib/ruby's pure command builders AND the closure-DSL
// setters.
//
// Two surfaces, mirroring tests/test_python_cmd.ae +
// tests/test_python_codegen_cmd.ae:
//
//   1. Pure `*_cmd` helpers (bundle_install_cmd, bundle_exec_cmd,
//      rspec_cmd, rubocop_cmd, gem_build_cmd) — string-equality
//      assertions on the shell commands aeb constructs.
//
//   2. Setter accumulation — drive `gem` / `rspec_arg` /
//      `rubocop_config` / `gemspec` / `gemfile` / `bundle_path` /
//      `ruby_version` on a fresh map, read back the keys.

import std.spec
import ruby (bundle_install_cmd, bundle_exec_cmd, rspec_cmd,
             rubocop_cmd, gem_build_cmd, minitest_cmd,
             gem, rspec_arg, rubocop_config, gemspec, gemfile,
             bundle_path, ruby_version, minitest_file)
import std.list
import std.map

_list_size_at(m: ptr, k: string) {
    if map.has(m, k) == 0 { return 0 }
    l, _ = map.get(m, k)
    return list.size(l)
}

_list_get_at(m: ptr, k: string, i: int) {
    l, _ = map.get(m, k)
    v, _ = list.get(l, i)
    return v
}

_str_at(m: ptr, k: string) {
    if map.has(m, k) == 0 { return "" }
    v, _ = map.get(m, k)
    return v
}

main() {
    fw = spec.init()

    // === Pure command-builder tests ====================================

    spec.describe(fw, "pure command builders") {
        // --- bundle_install_cmd: `bundle config set --local path` then
        //     `bundle install` (replaces the removed --path flag).
        spec.it("bundle_install_cmd basic") callback {
            spec.assert_str_eq(
                bundle_install_cmd("bundle", "/proj/rb", "/proj/.aeb/bundle"),
                "cd '/proj/rb' && 'bundle' config set --local path '/proj/.aeb/bundle' && 'bundle' install",
                "bundle_install_cmd basic")
        }

        // --- bundle_install_cmd: spaces in paths survive quoting.
        spec.it("bundle_install_cmd with spaces") callback {
            spec.assert_str_eq(
                bundle_install_cmd("bundle", "/path with space/rb", "/path with space/bundle"),
                "cd '/path with space/rb' && 'bundle' config set --local path '/path with space/bundle' && 'bundle' install",
                "bundle_install_cmd with spaces")
        }

        // --- bundle_exec_cmd: generic exec passthrough.
        spec.it("bundle_exec_cmd basic") callback {
            spec.assert_str_eq(
                bundle_exec_cmd("bundle", "/proj/rb", "rake spec"),
                "cd '/proj/rb' && 'bundle' exec rake spec",
                "bundle_exec_cmd basic")
        }

        // --- rspec_cmd: no args.
        spec.it("rspec_cmd empty args") callback {
            spec.assert_str_eq(
                rspec_cmd("bundle", "/proj/rb", ""),
                "cd '/proj/rb' && 'bundle' exec rspec",
                "rspec_cmd empty args")
        }

        // --- rspec_cmd: appended args.
        spec.it("rspec_cmd with args") callback {
            spec.assert_str_eq(
                rspec_cmd("bundle", "/proj/rb", "--format=doc spec/foo_spec.rb"),
                "cd '/proj/rb' && 'bundle' exec rspec --format=doc spec/foo_spec.rb",
                "rspec_cmd with args")
        }

        // --- rubocop_cmd: no config (rubocop searches the tree).
        spec.it("rubocop_cmd default config") callback {
            spec.assert_str_eq(
                rubocop_cmd("bundle", "/proj/rb", ""),
                "cd '/proj/rb' && 'bundle' exec rubocop",
                "rubocop_cmd default config")
        }

        // --- rubocop_cmd: explicit config path.
        spec.it("rubocop_cmd explicit config") callback {
            spec.assert_str_eq(
                rubocop_cmd("bundle", "/proj/rb", "/proj/rb/.rubocop.yml"),
                "cd '/proj/rb' && 'bundle' exec rubocop --config '/proj/rb/.rubocop.yml'",
                "rubocop_cmd explicit config")
        }

        // --- gem_build_cmd: cd to source_dir + gem build <basename> +
        //     mv *.gem to dist_dir. The cwd has to be the gemspec's dir
        //     so relative `s.files` paths in the spec resolve correctly;
        //     the mv step moves the resulting .gem into dist_dir.
        spec.it("gem_build_cmd basic") callback {
            spec.assert_str_eq(
                gem_build_cmd("gem", "/proj/rb", "selenium-webdriver.gemspec", "/proj/target/rb/dist"),
                "cd '/proj/rb' && 'gem' build 'selenium-webdriver.gemspec' && mv -f *.gem '/proj/target/rb/dist/'",
                "gem_build_cmd basic")
        }

        // --- gem_build_cmd: spaces in source_dir + dist_dir survive
        //     single-quoting on both sides of the &&-chain.
        spec.it("gem_build_cmd spaces in source_dir and dist_dir") callback {
            spec.assert_str_eq(
                gem_build_cmd("gem", "/path with space/rb", "x.gemspec", "/path with space/dist"),
                "cd '/path with space/rb' && 'gem' build 'x.gemspec' && mv -f *.gem '/path with space/dist/'",
                "gem_build_cmd spaces in source_dir and dist_dir")
        }

        // --- gem_build_cmd: alt gem_bin (e.g., chruby-managed `gem3.3`).
        spec.it("gem_build_cmd alt gem_bin") callback {
            spec.assert_str_eq(
                gem_build_cmd("/opt/rubies/3.3/bin/gem", "/proj/rb", "x.gemspec", "/proj/dist"),
                "cd '/proj/rb' && '/opt/rubies/3.3/bin/gem' build 'x.gemspec' && mv -f *.gem '/proj/dist/'",
                "gem_build_cmd alt gem_bin")
        }

        // --- rspec_cmd: many args + space-sep ordering preserved.
        spec.it("rspec_cmd many args") callback {
            spec.assert_str_eq(
                rspec_cmd("bundle", "/proj/rb",
                    "--format=doc --order=random --tag focus spec/foo_spec.rb spec/bar_spec.rb"),
                "cd '/proj/rb' && 'bundle' exec rspec --format=doc --order=random --tag focus spec/foo_spec.rb spec/bar_spec.rb",
                "rspec_cmd many args")
        }

        // --- rubocop_cmd: config path with spaces (single-quoted survives).
        spec.it("rubocop_cmd config path with spaces") callback {
            spec.assert_str_eq(
                rubocop_cmd("bundle", "/proj/rb", "/proj/cfg with space/.rubocop.yml"),
                "cd '/proj/rb' && 'bundle' exec rubocop --config '/proj/cfg with space/.rubocop.yml'",
                "rubocop_cmd config path with spaces")
        }

        // --- bundle_exec_cmd: trailing argv with embedded quoting passes
        // through verbatim. (Caller is responsible for quoting; this just
        // documents the surface contract.)
        spec.it("bundle_exec_cmd argv passthrough") callback {
            spec.assert_str_eq(
                bundle_exec_cmd("bundle", "/proj/rb", "rake spec[selenium-webdriver]"),
                "cd '/proj/rb' && 'bundle' exec rake spec[selenium-webdriver]",
                "bundle_exec_cmd argv passthrough")
        }

        // --- minitest_cmd: explicit -r reqs. Runs under `bundle exec ruby`
        // when a Gemfile is present, else plain `ruby`, with lib/spec/test on
        // the load path and each file loaded via -r (minitest's at_exit runs
        // all defined tests once). Pure.
        spec.it("minitest_cmd explicit reqs") callback {
            spec.assert_str_eq(
                minitest_cmd("bundle", "/proj/rb", " -rfoo_test -rbar_test"),
                "cd '/proj/rb' && if [ -f Gemfile ]; then 'bundle' exec ruby -Ilib -Ispec -Itest  -rfoo_test -rbar_test -e ''; else ruby -Ilib -Ispec -Itest  -rfoo_test -rbar_test -e ''; fi",
                "minitest_cmd explicit reqs")
        }

        // --- minitest_cmd: empty reqs → shell glob builds the -r list from the
        // conventional *_test.rb / test_*.rb under spec/ + test/.
        spec.it("minitest_cmd empty reqs globs conventional locations") callback {
            spec.assert_str_eq(
                minitest_cmd("bundle", "/proj/rb", ""),
                "cd '/proj/rb' && if [ -f Gemfile ]; then 'bundle' exec ruby -Ilib -Ispec -Itest $(for f in spec/*_test.rb spec/test_*.rb test/*_test.rb test/test_*.rb; do [ -f \"$f\" ] && printf ' -r%s' \"$(basename \"$f\" .rb)\"; done) -e ''; else ruby -Ilib -Ispec -Itest $(for f in spec/*_test.rb spec/test_*.rb test/*_test.rb test/test_*.rb; do [ -f \"$f\" ] && printf ' -r%s' \"$(basename \"$f\" .rb)\"; done) -e ''; fi",
                "minitest_cmd empty reqs globs conventional locations")
        }
    }

    // === Setter accumulation tests =====================================

    spec.describe(fw, "setter accumulation") {
        // --- gem: list accumulator, order preserved.
        spec.it("gem accumulates and preserves order") callback {
            bm1 = map.new()
            gem(bm1, "rspec ~> 3.13")
            gem(bm1, "rubocop ~> 1.66")
            gem(bm1, "debug")
            spec.assert_eq(_list_size_at(bm1, "ruby_gems"), 3, "gem accumulates 3 entries")
            spec.assert_str_eq(_list_get_at(bm1, "ruby_gems", 0), "rspec ~> 3.13", "gem order: first is rspec")
            spec.assert_str_eq(_list_get_at(bm1, "ruby_gems", 2), "debug", "gem order: third is debug")
        }

        // --- rspec_arg: separate list from gem.
        spec.it("rspec_arg stores separately from gem") callback {
            bm2 = map.new()
            gem(bm2, "rspec")
            rspec_arg(bm2, "--format=doc")
            rspec_arg(bm2, "spec/foo_spec.rb")
            spec.assert_eq(_list_size_at(bm2, "ruby_rspec_args"), 2, "rspec_arg stores in its own key")
            spec.assert_eq(_list_size_at(bm2, "ruby_gems"), 1, "rspec_arg and gem don't cross-contaminate")
        }

        // --- minitest_file: list accumulator on its own key, order preserved.
        spec.it("minitest_file accumulates on its own key") callback {
            bmf = map.new()
            minitest_file(bmf, "test/alpha_test.rb")
            minitest_file(bmf, "test/beta_test.rb")
            spec.assert_eq(_list_size_at(bmf, "ruby_minitest_files"), 2, "minitest_file accumulates 2 entries")
            spec.assert_str_eq(_list_get_at(bmf, "ruby_minitest_files", 0), "test/alpha_test.rb", "minitest_file order: first preserved")
            spec.assert_eq(_list_size_at(bmf, "ruby_gems"), 0, "minitest_file separate from rspec/gem keys")
        }

        // --- Scalar setters (gemspec, gemfile, bundle_path,
        // rubocop_config, ruby_version) — each writes a single string
        // key. Later calls overwrite earlier (map.put semantics).
        spec.it("scalar setters each store a single string key") callback {
            bm3 = map.new()
            gemspec(bm3, "selenium-webdriver.gemspec")
            gemfile(bm3, "Gemfile.aeb")
            bundle_path(bm3, "vendor/bundle")
            rubocop_config(bm3, ".rubocop.yml")
            ruby_version(bm3, "3.3")
            spec.assert_str_eq(_str_at(bm3, "ruby_gemspec"), "selenium-webdriver.gemspec", "gemspec stored as scalar")
            spec.assert_str_eq(_str_at(bm3, "ruby_gemfile"), "Gemfile.aeb", "gemfile stored as scalar")
            spec.assert_str_eq(_str_at(bm3, "ruby_bundle_path"), "vendor/bundle", "bundle_path stored as scalar")
            spec.assert_str_eq(_str_at(bm3, "ruby_rubocop_config"), ".rubocop.yml", "rubocop_config stored as scalar")
            spec.assert_str_eq(_str_at(bm3, "ruby_version"), "3.3", "ruby_version stored as scalar")
        }

        // --- Scalar overwrite: last call wins.
        spec.it("scalar overwrite: last call wins") callback {
            bm4 = map.new()
            gemspec(bm4, "first.gemspec")
            gemspec(bm4, "second.gemspec")
            spec.assert_str_eq(_str_at(bm4, "ruby_gemspec"), "second.gemspec", "gemspec last-call-wins")
        }

        // --- Untouched map: list keys absent, scalar keys absent.
        spec.it("untouched map has no keys") callback {
            bm5 = map.new()
            spec.assert_eq(_list_size_at(bm5, "ruby_gems"), 0, "untouched map has no ruby_gems")
            spec.assert_str_eq(_str_at(bm5, "ruby_gemspec"), "", "untouched map has empty ruby_gemspec")
        }
    }

    spec.run_summary(fw)
}
