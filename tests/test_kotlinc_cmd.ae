// Tests for kotlinc_cmd()
import std.spec
import std.map
import kotlin (kotlinc_cmd)

main() {
    fw = spec.init()

    spec.describe(fw, "kotlinc_cmd") {
        // First arg is now the resolved compiler binary (home-local
        // kotlinc, not bare PATH `kotlinc`) so compiler + stdlib stay
        // version-consistent. A home-local path threads through verbatim.
        spec.it("no-config baseline (home-local binary)") callback {
            spec.assert_str_eq(
                kotlinc_cmd("/snap/kotlin/current/bin/kotlinc", "out/classes", "out/classes:stdlib.jar", "Main.kt", null),
                "/snap/kotlin/current/bin/kotlinc -d out/classes -cp out/classes:stdlib.jar Main.kt", "no-config baseline (home-local binary)")
        }

        // Bare "kotlinc" still works (the PATH fallback case).
        spec.it("jvm_target + api_version (bare binary)") callback {
            opts2 = map_new()
            map_put(opts2, "jvm_target", "17")
            map_put(opts2, "api_version", "1.9")
            spec.assert_str_eq(
                kotlinc_cmd("kotlinc", "out", "cp", "Main.kt", opts2),
                "kotlinc -d out -jvm-target 17 -api-version 1.9 -cp cp Main.kt", "jvm_target + api_version (bare binary)")
        }

        spec.it("language_version") callback {
            opts3 = map_new()
            map_put(opts3, "language_version", "2.0")
            spec.assert_str_eq(
                kotlinc_cmd("kotlinc", "out", "cp", "Main.kt", opts3),
                "kotlinc -d out -language-version 2.0 -cp cp Main.kt", "language_version")
        }

        spec.it("werror+nowarn+verbose") callback {
            opts4 = map_new()
            map_put(opts4, "werror", "true")
            map_put(opts4, "nowarn", "true")
            map_put(opts4, "verbose", "true")
            spec.assert_str_eq(
                kotlinc_cmd("kotlinc", "out", "cp", "Main.kt", opts4),
                "kotlinc -d out -Werror -nowarn -verbose -cp cp Main.kt", "werror+nowarn+verbose")
        }

        spec.it("extra") callback {
            opts5 = map_new()
            map_put(opts5, "extra", "-Xopt-in=kotlin.RequiresOptIn")
            spec.assert_str_eq(
                kotlinc_cmd("kotlinc", "out", "cp", "Main.kt", opts5),
                "kotlinc -d out -Xopt-in=kotlin.RequiresOptIn -cp cp Main.kt", "extra")
        }

        spec.it("all combined") callback {
            opts6 = map_new()
            map_put(opts6, "jvm_target", "17")
            map_put(opts6, "api_version", "1.9")
            map_put(opts6, "language_version", "2.0")
            map_put(opts6, "werror", "true")
            map_put(opts6, "extra", "-Xjsr305=strict")
            spec.assert_str_eq(
                kotlinc_cmd("kotlinc", "out", "cp", "Main.kt", opts6),
                "kotlinc -d out -jvm-target 17 -api-version 1.9 -language-version 2.0 -Werror -Xjsr305=strict -cp cp Main.kt", "all combined")
        }
    }

    spec.run_summary(fw)
}
