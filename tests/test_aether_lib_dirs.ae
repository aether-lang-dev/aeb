// Unit tests for the aether.program per-node lib() search-path helpers
// (asks/aether-program-per-node-lib-search-path.md) — the Aether-side twin of
// include_dir. _node_lib_dirs resolves the dirs (relative → source_dir,
// absolute passthrough); _node_lib_flags renders the repeated " --lib <dir>"
// fragment. Pure helpers — no toolchain or filesystem needed.

import std.spec
import std.string
import std.list
import std.map

import aether (_node_lib_dirs, _node_lib_flags)

main() {
    fw = spec.init()

    spec.describe(fw, "_node_lib_dirs: relative resolves, absolute passes") {
        spec.it("two resolved lib dirs") callback {
            bm = map.new()
            ld = list.new()
            list.add(ld, "aevg")              // relative → source_dir/aevg
            list.add(ld, "/abs/shared")        // absolute → passthrough
            map.put(bm, "lib", ld)
            res = _node_lib_dirs(bm, "/src")
            spec.assert_eq(list.size(res), 2, "two dirs")
            r0, _ = list.get(res, 0)
            r1, _ = list.get(res, 1)
            spec.assert_str_eq(r0, "/src/aevg", "relative → source_dir")
            spec.assert_str_eq(r1, "/abs/shared", "absolute passes through")
        }
    }

    spec.describe(fw, "_node_lib_flags: repeated \" --lib <dir>\", resolved") {
        spec.it("renders repeated --lib") callback {
            bm = map.new()
            ld = list.new()
            list.add(ld, "aevg")
            list.add(ld, "/abs/shared")
            map.put(bm, "lib", ld)
            spec.assert_str_eq(_node_lib_flags(bm, "/src"),
                " --lib /src/aevg --lib /abs/shared", "repeated --lib")
        }
        // Single absolute dir (the common `lib("${root}/aevg")` shape after the
        // .build.ae interpolates ${root} to an absolute path).
        spec.it("single absolute lib flag") callback {
            bm3 = map.new()
            ld3 = list.new()
            list.add(ld3, "/repo/aevg")
            map.put(bm3, "lib", ld3)
            spec.assert_str_eq(_node_lib_flags(bm3, "/repo/apps/x"), " --lib /repo/aevg", "single absolute")
        }
    }

    spec.describe(fw, "bare / null builder → empty (no NPE)") {
        spec.it("no lib() → empty dirs") callback {
            bm2 = map.new()
            spec.assert_eq(list.size(_node_lib_dirs(bm2, "/src")), 0, "empty dirs")
        }
        spec.it("no lib() → empty flags") callback {
            bm2 = map.new()
            spec.assert_str_eq(_node_lib_flags(bm2, "/src"), "", "empty flags")
        }
        // Null builder → empty (the block-less default-path case passes null-ish maps).
        spec.it("null builder → empty dirs") callback {
            spec.assert_eq(list.size(_node_lib_dirs(null, "/src")), 0, "null dirs")
        }
        spec.it("null builder → empty flags") callback {
            spec.assert_str_eq(_node_lib_flags(null, "/src"), "", "null flags")
        }
    }

    spec.run_summary(fw)
}
