// Regression test: an aether.program target's cache key covers the
// toolchain's *content*, not just its `ae --version` string.
//
// The bug this guards (filed by the avn project): `ae --version`
// reports the last release tag. A toolchain rebuilt from source
// between tags — e.g. with a codegen/typecheck fix landed as a HEAD
// commit — keeps the identical version string, so a version-string
// key gave a false cache hit and the consumer was never recompiled
// against the fixed compiler. _cache_key_for_aether_link now hashes
// the actual libaether.a (and aetherc binary) content.
//
// This exercises the libaether.a component with a synthetic archive;
// the aetherc-binary component is the identical cache.hash_file
// mechanism (the avn doc's manual procedure covers it end to end).

import std.spec
import aether (_cache_key_for_aether_link, _toolchain_version)
import bldr (_sh, _sh_capture)
import std.string
import std.os

// Native-form tmpdir via the _sh chokepoint (see e.g. test_aether_resolvers):
// mktemp answers in MSYS form, but the fixtures are read/run through paths that
// must be native on Windows. No-op off Windows.
_mktempdir() {
    raw, _err = _sh_capture("mktemp -d")
    d = string.trim(raw)
    nat, _nerr = _sh_capture("cygpath -m ${d}")
    n = string.trim(nat)
    if string.length(n) > 0 { return n }
    return d
}

// Regression guard: _toolchain_version() must read the version of the compiler
// aeb builds with ($AETHER), NOT bare `ae` on PATH. A fake `ae` prints a
// sentinel version; with $AETHER pointed at it, _toolchain_version must return
// that sentinel — proving it does not consult whatever `ae` happens to be on
// PATH (which historically gave a wrong or empty version into the cache key).
_test_toolchain_version_uses_aether(fw: ptr) {
    dir = _mktempdir()
    // A fake `ae` (with the host exe suffix so a bare `ae` name resolves on
    // Windows too) that prints a distinctive --version line.
    fake = string.concat(dir, "/ae")
    _sh("printf '#!/bin/sh\\necho \"ae 9.9.9-sentinel (fake)\"\\n' > '${fake}'")
    _sh("chmod +x '${fake}'")
    // On Windows the launched compiler is `<fake>.exe`; copy so both names work.
    _sh("cp '${fake}' '${fake}.exe' 2>/dev/null; true")

    prev = os.getenv("AETHER")
    _e = os.setenv("AETHER", fake)
    // Clear the per-build memo so this probe actually re-runs against the fake
    // (any earlier _toolchain_version call in this process would have stored a
    // real version there).
    _um = os.unsetenv("_AEB_AETHER_VERSION_CACHE")
    got = _toolchain_version()
    // restore env; also clear the memo we just populated with the sentinel so it
    // can't leak into a later real lookup in the same process.
    _um2 = os.unsetenv("_AEB_AETHER_VERSION_CACHE")
    if string.length(prev) > 0 { _r = os.setenv("AETHER", prev) }
    else { _r = os.unsetenv("AETHER") }

    spec.assert_true(string.equals(got, "ae 9.9.9-sentinel (fake)"),
        "_toolchain_version() reads $AETHER, not PATH `ae`")
    _sh("rm -rf '${dir}'")
}

main() {
    fw = spec.init()

    spec.describe(fw, "aether toolchain cache key") {
        spec.it("_toolchain_version() reads $AETHER, not PATH `ae`") callback {
            _test_toolchain_version_uses_aether(fw)
        }

        spec.it("cache key is content-addressed over libaether.a") callback {
            base = _mktempdir()
            _sh("mkdir -p '${base}/src' '${base}/libdir'")
            srcdir = "${base}/src"
            src = "${base}/src/main.ae"
            libdir = "${base}/libdir"
            _sh("printf 'main() {}\\n' > '${src}'")
            _sh("printf 'fake-libaether-content-v1\\n' > '${libdir}/libaether.a'")

            k1, e1 = _cache_key_for_aether_link(null, srcdir, src, libdir, "dup", "")
            // _cache_key_for_aether_link returns ("", err) when hashing is
            // unavailable (no OpenSSL/zlib) — skip cleanly in that case.
            if string.equals(e1, "") == 0 {
                spec.assert_true(1, "toolchain-key test skipped — ${e1}")
                _sh("rm -rf '${base}'")
                return 0
            }

            k1b, _eb = _cache_key_for_aether_link(null, srcdir, src, libdir, "dup", "")
            spec.assert_true(string.equals(k1, k1b), "key is stable across recomputation")

            // Simulate a toolchain rebuild: libaether.a content changes.
            _sh("printf 'fake-libaether-content-v2-rebuilt\\n' > '${libdir}/libaether.a'")
            k2, _e2 = _cache_key_for_aether_link(null, srcdir, src, libdir, "dup", "")
            spec.assert_true(1 - string.equals(k1, k2), "a rebuilt libaether.a busts the cache key")

            // Restore the original content — key must return (content-addressed,
            // SHA256, not mtime: same bytes → same key despite a newer mtime).
            _sh("printf 'fake-libaether-content-v1\\n' > '${libdir}/libaether.a'")
            k3, _e3 = _cache_key_for_aether_link(null, srcdir, src, libdir, "dup", "")
            spec.assert_true(string.equals(k1, k3), "restoring libaether.a content restores the key")

            _sh("rm -rf '${base}'")
        }
    }

    spec.run_summary(fw)
}
