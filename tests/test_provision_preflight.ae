// Tests for lib/provision's preflight probe logic.
//
// Pure-ish: _split_token / _probe_binary are pure string ops; preflight_missing
// probes the host (command -v) so it asserts against toolchains that are
// reliably present (sh, ls — always on any box that can run the suite) and a
// clearly-absent sentinel. See docs/build-prerequisites-and-provisioning.md.

import std.spec
import provision (_split_token, _probe_binary, preflight_missing, _fmt_set)
import std.list

main() {
    fw = spec.init()

    // --- _split_token ---
    spec.describe(fw, "_split_token") {
        spec.it("splits <toolchain>:<version>") callback {
            tc, ver = _split_token("zig:0.13")
            spec.assert_str_eq(tc, "zig", "split: toolchain")
            spec.assert_str_eq(ver, "0.13", "split: version")
            tc2, ver2 = _split_token("make")
            spec.assert_str_eq(tc2, "make", "split: no-colon toolchain")
            spec.assert_str_eq(ver2, "", "split: no-colon version empty")
        }
    }

    // --- _probe_binary mapping ---
    spec.describe(fw, "_probe_binary") {
        spec.it("maps toolchain to its probe binary") callback {
            spec.assert_str_eq(_probe_binary("jdk"), "javac", "probe-binary: jdk->javac")
            spec.assert_str_eq(_probe_binary("python"), "python3", "probe-binary: python->python3")
            spec.assert_str_eq(_probe_binary("rust"), "rustc", "probe-binary: rust->rustc")
            spec.assert_str_eq(_probe_binary("nodejs"), "node", "probe-binary: nodejs->node")
            spec.assert_str_eq(_probe_binary("zig"), "zig", "probe-binary: default identity")
        }
    }

    spec.describe(fw, "preflight_missing") {
        // --- preflight_missing: a present token + an absent one ---
        // `sh` is present on every box that runs this suite; the sentinel is not.
        spec.it("reports the absent token, not the present one") callback {
            toks = list.new()
            list.add(toks, "sh:1")
            list.add(toks, "definitely-not-a-real-toolchain-xyzzy:9")
            missing = preflight_missing(toks)
            spec.assert_eq(list.size(missing), 1, "preflight: exactly one missing")
            if list.size(missing) == 1 {
                m0, _ = list.get(missing, 0)
                spec.assert_str_eq(m0, "definitely-not-a-real-toolchain-xyzzy:9",
                    "preflight: the absent one is reported")
            }
        }
        // --- preflight_missing: all present -> empty ---
        spec.it("all present -> none missing") callback {
            toks2 = list.new()
            list.add(toks2, "sh:1")
            missing2 = preflight_missing(toks2)
            spec.assert_eq(list.size(missing2), 0, "preflight: all present -> none missing")
        }
        // --- preflight_missing: dedupe (same token twice -> probed once, and if
        // absent appears once in the missing set) ---
        spec.it("duplicate absent token deduped") callback {
            toks3 = list.new()
            list.add(toks3, "definitely-not-a-real-toolchain-xyzzy:9")
            list.add(toks3, "definitely-not-a-real-toolchain-xyzzy:9")
            missing3 = preflight_missing(toks3)
            spec.assert_eq(list.size(missing3), 1, "preflight: duplicate absent token deduped")
        }
    }

    // --- _fmt_set formatting ---
    spec.describe(fw, "_fmt_set") {
        spec.it("bracketed comma-joined") callback {
            fs = list.new()
            list.add(fs, "a:1")
            list.add(fs, "b:2")
            spec.assert_str_eq(_fmt_set(fs), "[a:1, b:2]", "fmt_set: bracketed comma-joined")
        }
    }

    spec.run_summary(fw)
}
