// Tests for bldr.post_build / _subst — the post-build ("output half of
// the sandwich") hook. The pure part under test is the {target_dir} /
// {module_dir} placeholder substitution: run_post_build itself shells
// out, so its behaviour is covered end-to-end by a smoke build rather
// than here (this file stays I/O-free, per the string-builder rule in
// LLM.md's "SDK extension shape").
import std.spec
import bldr (_subst)

main() {
    fw = spec.init()

    spec.describe(fw, "_subst placeholder substitution") {
        // Single occurrence — the common case.
        spec.it("single") callback {
            spec.assert_str_eq(_subst("sha256 {target_dir}/a.jar", "{target_dir}", "/t"),
                "sha256 /t/a.jar", "single")
        }
        // EVERY occurrence, not just the first. A step like
        // `cp {target_dir}/a {target_dir}/b` is the reason this matters.
        spec.it("repeated") callback {
            spec.assert_str_eq(_subst("cp {target_dir}/a {target_dir}/b", "{target_dir}", "/t"),
                "cp /t/a /t/b", "repeated")
        }
        // Absent needle: unchanged, no truncation.
        spec.it("absent") callback {
            spec.assert_str_eq(_subst("echo hi", "{target_dir}", "/t"),
                "echo hi", "absent")
        }
        // At the very start and very end of the string (boundary rebuild).
        spec.it("leading") callback {
            spec.assert_str_eq(_subst("{target_dir}/x", "{target_dir}", "/t"), "/t/x", "leading")
        }
        spec.it("trailing") callback {
            spec.assert_str_eq(_subst("x{target_dir}", "{target_dir}", "/t"), "x/t", "trailing")
        }
        // Empty replacement is legal (an unset dir must not corrupt the rest).
        spec.it("empty-repl") callback {
            spec.assert_str_eq(_subst("a{m}b", "{m}", ""), "ab", "empty-repl")
        }
        // Empty needle must be a no-op, NOT an infinite loop.
        spec.it("empty-needle") callback {
            spec.assert_str_eq(_subst("abc", "", "X"), "abc", "empty-needle")
        }
    }

    return spec.run_summary(fw)
}
