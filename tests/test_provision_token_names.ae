// Tests for lib/provision's canonical-token-name policy: aeb publishes a small
// closed set of canonical prereq names and REJECTS known misnames at declaration
// time (node not nodejs, jdk not java/openjdk, …). Pure string logic — no host,
// no install (aeb has no install verb). See
// docs/design/build-prerequisites-and-provisioning.md.

import std.spec
import provision (_misname_canonical, check_token_names)
import std.string
import std.list

main() {
    fw = spec.init()

    // --- _misname_canonical: known misnames map to canonical ---
    spec.describe(fw, "_misname_canonical") {
        spec.it("known misnames map to canonical") callback {
            spec.assert_str_eq(_misname_canonical("nodejs"),  "node",   "nodejs -> node")
            spec.assert_str_eq(_misname_canonical("openjdk"), "jdk",    "openjdk -> jdk")
            spec.assert_str_eq(_misname_canonical("java"),    "jdk",    "java -> jdk")
            spec.assert_str_eq(_misname_canonical("golang"),  "go",     "golang -> go")
            spec.assert_str_eq(_misname_canonical("python3"), "python", "python3 -> python")
            spec.assert_str_eq(_misname_canonical("rustc"),   "rust",   "rustc -> rust")
        }
        // --- canonical names are NOT misnames (return "") ---
        spec.it("canonical names are NOT misnames") callback {
            spec.assert_str_eq(_misname_canonical("node"),   "", "node ok")
            spec.assert_str_eq(_misname_canonical("jdk"),    "", "jdk ok")
            spec.assert_str_eq(_misname_canonical("zig"),    "", "zig ok")
            spec.assert_str_eq(_misname_canonical("python"), "", "python ok")
        }
    }

    spec.describe(fw, "check_token_names") {
        // --- check_token_names: all-canonical set passes ("") ---
        spec.it("all-canonical set passes") callback {
            ok = list.new()
            list.add(ok, "jdk:21")
            list.add(ok, "node:20")
            list.add(ok, "zig:0.13")
            spec.assert_str_eq(check_token_names(ok), "", "all-canonical set passes")
        }
        // --- a misname in the set is rejected, naming the offending token ---
        spec.it("a misname in the set is rejected, naming token + canonical fix") callback {
            bad = list.new()
            list.add(bad, "jdk:21")
            list.add(bad, "nodejs:20")
            rej = check_token_names(bad)
            spec.assert_true(string.length(rej) > 0, "misname set rejected (non-empty)")
            spec.assert_true(string.index_of(rej, "nodejs:20") >= 0, "rejection names the bad token")
            spec.assert_true(string.index_of(rej, "'node'") >= 0, "rejection names the canonical fix")
        }
        // --- empty set passes ---
        spec.it("empty set passes") callback {
            spec.assert_str_eq(check_token_names(list.new()), "", "empty set passes")
        }
    }

    return spec.run_summary(fw)
}
