// Tests for javascript.package_json_content() — consumer package.json (shared
// by javascript + ts). Mirrors tests/test_gleam_toml.ae.
import std.spec
import std.list
import std.map

import javascript (package_json_content)

main() {
    fw = spec.init()
    spec.describe(fw, "package_json_content") {
        spec.it("minimal defaults") callback {
            t = package_json_content(null)
            spec.assert_contains(t, "\"name\": \"app\"", "default name")
            spec.assert_contains(t, "\"version\": \"0.1.0\"", "default version")
            spec.assert_contains(t, "\"private\": true", "private flag")
            spec.assert_false(string_contains(t, "\"dependencies\""), "no dependencies when none")
        }
        spec.it("explicit name + version") callback {
            o = map_new()
            map_put(o, "manifest_name", "selenium")
            map_put(o, "manifest_version", "0.8.0")
            t = package_json_content(o)
            spec.assert_contains(t, "\"name\": \"selenium\"", "explicit name")
            spec.assert_contains(t, "\"version\": \"0.8.0\"", "explicit version")
        }
        spec.it("dependencies") callback {
            o = map_new()
            deps = list_new()
            list_add(deps, "selenium-webdriver~^4.0.0")
            list_add(deps, "ws~^8.0.0")
            map_put(o, "manifest_npm_deps", deps)
            t = package_json_content(o)
            spec.assert_contains(t, "\"dependencies\": {", "has dependencies")
            spec.assert_contains(t, "\"selenium-webdriver\": \"^4.0.0\"", "dep 1")
            spec.assert_contains(t, "\"ws\": \"^8.0.0\"", "dep 2")
        }
    }
    return spec.run_summary(fw)
}
