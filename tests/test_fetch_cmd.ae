// Tests for lib/fetch's pure command builders, format inference,
// and closure-DSL setters.
//
// Three surfaces, same shape as the other SDK test files:
//
//   1. Pure `*_cmd` helpers (fetch_curl_cmd, sha256_verify_cmd,
//      tar_extract_cmd, zip_extract_cmd) — string-equality
//      assertions on the shell command aeb constructs.
//
//   2. Pure inference helpers (_infer_archive_flags, _is_zip_url,
//      _ends_with_p) — URL-suffix → tar-flags / is-zip mapping.
//      These gate the format() override in fetch.archive(b).
//
//   3. Grammar setters (url, sha256, output_to, extract_to,
//      strip_components, format) — closure-DSL accumulation on
//      a fresh map.

import std.spec
import fetch (fetch_curl_cmd, sha256_verify_cmd, tar_extract_cmd,
              zip_extract_cmd, _infer_archive_flags, _is_zip_url,
              _ends_with_p, _format_to_flags, _format_is_zip,
              url, sha256, output_to, extract_to, strip_components,
              format)
import std.string
import std.map

_str_at(m: ptr, k: string) {
    if map.has(m, k) == 0 { return "" }
    v, _ = map.get(m, k)
    return v
}

main() {
    fw = spec.init()

    // === Pure command-builder tests ====================================

    spec.describe(fw, "pure command builders") {
        spec.it("fetch_curl_cmd basic") callback {
            spec.assert_str_eq(
                fetch_curl_cmd("https://example.com/foo.cddl", "/proj/specs/foo.cddl"),
                "curl -fsSL 'https://example.com/foo.cddl' -o '/proj/specs/foo.cddl'", "fetch_curl_cmd basic")
        }

        spec.it("fetch_curl_cmd with query string") callback {
            spec.assert_str_eq(
                fetch_curl_cmd("https://api.example.com/files?id=42&v=2", "/tmp/o"),
                "curl -fsSL 'https://api.example.com/files?id=42&v=2' -o '/tmp/o'", "fetch_curl_cmd with query string")
        }

        // The expected string contains literal `\n` (2 chars: backslash
        // + n). Built via string.concat so the test source itself
        // doesn't fall into the interpolation-eats-backslash trap.
        spec.it("sha256_verify_cmd basic") callback {
            bs_n_expect = string.concat("\\", "n")
            expected_sha = string.concat("printf '%s  %s", bs_n_expect)
            expected_sha = string.concat(expected_sha, "' 'abc123def456' '/proj/file.bin' | sha256sum -c - >/dev/null")
            spec.assert_str_eq(
                sha256_verify_cmd("/proj/file.bin", "abc123def456"),
                expected_sha, "sha256_verify_cmd basic")
        }

        // --- tar_extract_cmd: no strip.
        spec.it("tar_extract_cmd no strip") callback {
            spec.assert_str_eq(
                tar_extract_cmd("/tmp/arc.tar.gz", "/proj/vendor", "xzf", 0),
                "tar -C '/proj/vendor' -xzf '/tmp/arc.tar.gz'", "tar_extract_cmd no strip")
        }

        // --- tar_extract_cmd: strip 1 (the canonical GH-release shape).
        spec.it("tar_extract_cmd strip=1") callback {
            spec.assert_str_eq(
                tar_extract_cmd("/tmp/arc.tar.gz", "/proj/vendor", "xzf", 1),
                "tar -C '/proj/vendor' -xzf '/tmp/arc.tar.gz' --strip-components=1", "tar_extract_cmd strip=1")
        }

        // --- tar_extract_cmd: bz2 flags.
        spec.it("tar_extract_cmd bz2 flags") callback {
            spec.assert_str_eq(
                tar_extract_cmd("/tmp/arc.tar.bz2", "/dst", "xjf", 0),
                "tar -C '/dst' -xjf '/tmp/arc.tar.bz2'", "tar_extract_cmd bz2 flags")
        }

        // --- tar_extract_cmd: xz flags with deeper strip.
        spec.it("tar_extract_cmd xz flags strip=2") callback {
            spec.assert_str_eq(
                tar_extract_cmd("/tmp/arc.tar.xz", "/dst", "xJf", 2),
                "tar -C '/dst' -xJf '/tmp/arc.tar.xz' --strip-components=2", "tar_extract_cmd xz flags strip=2")
        }

        // --- tar_extract_cmd: plain tar (no compression) with strip=3.
        spec.it("tar_extract_cmd plain tar strip=3") callback {
            spec.assert_str_eq(
                tar_extract_cmd("/tmp/plain.tar", "/dst", "xf", 3),
                "tar -C '/dst' -xf '/tmp/plain.tar' --strip-components=3", "tar_extract_cmd plain tar strip=3")
        }

        // --- tar_extract_cmd: spaces in dest_dir survive single-quoting.
        spec.it("tar_extract_cmd spaces in dest") callback {
            spec.assert_str_eq(
                tar_extract_cmd("/tmp/a.tar.gz", "/dst with space/v", "xzf", 1),
                "tar -C '/dst with space/v' -xzf '/tmp/a.tar.gz' --strip-components=1", "tar_extract_cmd spaces in dest")
        }

        // --- zip_extract_cmd.
        spec.it("zip_extract_cmd basic") callback {
            spec.assert_str_eq(
                zip_extract_cmd("/tmp/arc.zip", "/proj/vendor"),
                "unzip -q -o '/tmp/arc.zip' -d '/proj/vendor'", "zip_extract_cmd basic")
        }

        // --- zip_extract_cmd: spaces in archive path.
        spec.it("zip_extract_cmd spaces in archive path") callback {
            spec.assert_str_eq(
                zip_extract_cmd("/path with space/a.zip", "/dst"),
                "unzip -q -o '/path with space/a.zip' -d '/dst'", "zip_extract_cmd spaces in archive path")
        }
    }

    // === Pure inference tests =========================================

    spec.describe(fw, "inference helpers") {
        spec.it("_ends_with_p") callback {
            spec.assert_true(_ends_with_p("foo.tar.gz", ".tar.gz") == 1, "_ends_with_p positive")
            spec.assert_true(_ends_with_p("foo.tar.gz", ".zip") == 0, "_ends_with_p negative")
            spec.assert_true(_ends_with_p("ab", "abc") == 0, "_ends_with_p suffix > s")
        }

        spec.it("_infer_archive_flags") callback {
            spec.assert_str_eq(_infer_archive_flags("https://x/foo.tar.gz"), "xzf", "_infer .tar.gz")
            spec.assert_str_eq(_infer_archive_flags("https://x/foo.tgz"), "xzf", "_infer .tgz")
            spec.assert_str_eq(_infer_archive_flags("https://x/foo.tar.bz2"), "xjf", "_infer .tar.bz2")
            spec.assert_str_eq(_infer_archive_flags("https://x/foo.tar.xz"), "xJf", "_infer .tar.xz")
            spec.assert_str_eq(_infer_archive_flags("https://x/foo.tar"), "xf", "_infer plain .tar")
            spec.assert_str_eq(_infer_archive_flags("https://x/foo.zip"), "", "_infer .zip → not tar")
            spec.assert_str_eq(_infer_archive_flags("https://x/foo.tar.gz?token=abc"), "xzf", "_infer with query string")
        }

        spec.it("_is_zip_url") callback {
            spec.assert_true(_is_zip_url("https://x/foo.zip") == 1, "_is_zip_url positive")
            spec.assert_true(_is_zip_url("https://x/foo.tar.gz") == 0, "_is_zip_url negative")
            spec.assert_true(_is_zip_url("https://x/foo.zip?t=1") == 1, "_is_zip_url with query")
        }
    }

    // === Format-override mapping tests ================================
    //
    // _format_to_flags + _format_is_zip are the explicit-`format(...)`
    // setter consumers. Separate from _infer_archive_flags so the
    // override path is independently exercisable when a URL is opaque
    // (CDN-hashed, redirected, etc.).

    spec.describe(fw, "format-override mapping") {
        spec.it("_format_to_flags") callback {
            spec.assert_str_eq(_format_to_flags("tar.gz"), "xzf", "_format_to_flags tar.gz")
            spec.assert_str_eq(_format_to_flags("tgz"), "xzf", "_format_to_flags tgz")
            spec.assert_str_eq(_format_to_flags("tar.bz2"), "xjf", "_format_to_flags tar.bz2")
            spec.assert_str_eq(_format_to_flags("tbz2"), "xjf", "_format_to_flags tbz2")
            spec.assert_str_eq(_format_to_flags("tar.xz"), "xJf", "_format_to_flags tar.xz")
            spec.assert_str_eq(_format_to_flags("txz"), "xJf", "_format_to_flags txz")
            spec.assert_str_eq(_format_to_flags("tar"), "xf", "_format_to_flags tar")
            spec.assert_str_eq(_format_to_flags("zip"), "", "_format_to_flags zip → empty (caller routes via _format_is_zip)")
            spec.assert_str_eq(_format_to_flags("7z"), "", "_format_to_flags unknown → empty")
        }

        spec.it("_format_is_zip") callback {
            spec.assert_true(_format_is_zip("zip") == 1, "_format_is_zip positive")
            spec.assert_true(_format_is_zip("tar.gz") == 0, "_format_is_zip tar.gz")
            spec.assert_true(_format_is_zip("") == 0, "_format_is_zip empty")
        }
    }

    // === Setter accumulation tests =====================================

    spec.describe(fw, "setters") {
        // --- All five required scalars set; format optional.
        spec.it("required scalars stored") callback {
            bm = map.new()
            url(bm, "https://w3c.github.io/webdriver-bidi/all.cddl")
            sha256(bm, "deadbeef00000000")
            output_to(bm, "specs/bidi.cddl")
            spec.assert_str_eq(_str_at(bm, "fetch_url"), "https://w3c.github.io/webdriver-bidi/all.cddl", "url stored")
            spec.assert_str_eq(_str_at(bm, "fetch_sha256"), "deadbeef00000000", "sha256 stored")
            spec.assert_str_eq(_str_at(bm, "fetch_output_to"), "specs/bidi.cddl", "output_to stored")
        }

        // --- Archive shape: extract_to + strip + format.
        spec.it("archive shape: extract_to + strip + format") callback {
            bm2 = map.new()
            url(bm2, "https://github.com/foo/bar/archive/v1.2.3.tar.gz")
            sha256(bm2, "cafebabe")
            extract_to(bm2, "vendor/bar")
            strip_components(bm2, 1)
            format(bm2, "tar.gz")
            spec.assert_str_eq(_str_at(bm2, "fetch_extract_to"), "vendor/bar", "extract_to stored")
            spec.assert_str_eq(_str_at(bm2, "fetch_strip"), "1", "strip_components stored as int-string")
            spec.assert_str_eq(_str_at(bm2, "fetch_format"), "tar.gz", "format stored")
        }

        // --- Last-call-wins on scalar overwrites.
        spec.it("url last-call-wins") callback {
            bm3 = map.new()
            url(bm3, "https://first/v1.zip")
            url(bm3, "https://second/v2.zip")
            spec.assert_str_eq(_str_at(bm3, "fetch_url"), "https://second/v2.zip", "url last-call-wins")
        }
    }

    return spec.run_summary(fw)
}
