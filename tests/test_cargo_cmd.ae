import std.string
import std.io
import std.os
import std.file
import std.fs
import std.list
import std.map
import std.path
import std.dir

import build
// Tests for cargo_build_cmd()

import rust
import rust (cargo_build_cmd, cargo_test_cmd, binary_name)

_assert_eq(label: string, actual: string, expected: string) {
    if actual == expected {
        println("PASS: ${label}")
    } else {
        println("FAIL: ${label}")
        println("  expected: ${expected}")
        println("  actual:   ${actual}")
    }
}

main() {
    _assert_eq("no-config defaults to --release",
        cargo_build_cmd("/src/mymod", "/target/mymod", null),
        "cd /src/mymod && cargo build --release --target-dir=/target/mymod/lib")

    opts2 = map_new()
    map_put(opts2, "profile", "dev")
    _assert_eq("custom profile",
        cargo_build_cmd("/src", "/target", opts2),
        "cd /src && cargo build --profile dev --target-dir=/target/lib")

    opts3 = map_new()
    map_put(opts3, "features", "jni,serde")
    map_put(opts3, "jobs", "4")
    _assert_eq("features + jobs",
        cargo_build_cmd("/src", "/target", opts3),
        "cd /src && cargo build --release --features jni,serde --jobs 4 --target-dir=/target/lib")

    opts4 = map_new()
    map_put(opts4, "profile", "release")
    map_put(opts4, "features", "jni")
    map_put(opts4, "jobs", "8")
    map_put(opts4, "extra", "--locked")
    _assert_eq("all combined",
        cargo_build_cmd("/src", "/target", opts4),
        "cd /src && cargo build --profile release --features jni --jobs 8 --locked --target-dir=/target/lib")

    // --- binary_name setter (consumed by cargo_project_existing).
    bm = map_new()
    binary_name(bm, "selenium-manager")
    bn, _ = map_get(bm, "binary_name")
    _assert_eq("binary_name setter stores the name",
        bn, "selenium-manager")

    // Scalar last-call-wins.
    binary_name(bm, "renamed")
    bn2, _ = map_get(bm, "binary_name")
    _assert_eq("binary_name last-call-wins",
        bn2, "renamed")

    // --- cargo_test_cmd (consumed by rust.cargo_test_existing).
    _assert_eq("cargo_test_cmd bare",
        cargo_test_cmd("/proj/rust", null),
        "cd '/proj/rust' && cargo test")

    test_opts = map_new()
    map_put(test_opts, "features", "experimental")
    _assert_eq("cargo_test_cmd with features",
        cargo_test_cmd("/proj/rust", test_opts),
        "cd '/proj/rust' && cargo test --features experimental")

    test_opts2 = map_new()
    map_put(test_opts2, "jobs", "4")
    map_put(test_opts2, "extra", "--release")
    _assert_eq("cargo_test_cmd jobs + extra",
        cargo_test_cmd("/proj/rust", test_opts2),
        "cd '/proj/rust' && cargo test --jobs 4 --release")

    // --- cargo_test_cmd: all four opts combined, order is canonical
    // (features → jobs → extra). Selenium's rust/.tests.ae would land
    // close to this shape.
    test_opts3 = map_new()
    map_put(test_opts3, "features", "experimental,bidi")
    map_put(test_opts3, "jobs", "2")
    map_put(test_opts3, "extra", "--locked -- --nocapture")
    _assert_eq("cargo_test_cmd features+jobs+extra ordering",
        cargo_test_cmd("/proj/rust", test_opts3),
        "cd '/proj/rust' && cargo test --features experimental,bidi --jobs 2 --locked -- --nocapture")

    // --- cargo_test_cmd: source_dir with spaces (single-quoted).
    _assert_eq("cargo_test_cmd source_dir with spaces",
        cargo_test_cmd("/path with space/rust", null),
        "cd '/path with space/rust' && cargo test")

    println("cargo_build_cmd tests done")
}
