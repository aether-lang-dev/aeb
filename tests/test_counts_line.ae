// Tests for counts_line() — the end-of-build display summary that
// counts DAG nodes per DISTINCT verbatim type (infer_type), first-seen
// order, no fixed compile/dist/test buckets.
//
// This imports the SAME `aeblabel` module tools/aeb-link.ae imports
// (tests/run.sh builds with `--lib lib --lib tools`), so the test
// exercises the exact code the build path runs. The pre-d6340b4
// hardcoded-spellings bug class ("tests" plural silently dropped from
// the count; .install.ae / .essais.ae / .構築.ae invisible) is what
// the verbatim grammar retires — the cases below pin that behaviour.
import std.spec
import std.list
import aeblabel (counts_line)

main() {
    fw = spec.init()

    spec.describe(fw, "counts_line") {
        // --- canonical repo: build/dist/tests, verbatim words, no relabel ---
        spec.it("canonical: verbatim words, .tests stays plural") callback {
            l1 = list.new()
            _a = list.add(l1, "a/.build.ae")
            _a = list.add(l1, "b/.build.ae")
            _a = list.add(l1, "a/.dist.ae")
            _a = list.add(l1, "a/.tests.ae")
            _a = list.add(l1, "b/.tests.ae")
            spec.assert_str_eq(counts_line(l1), "aeb: 2 build + 1 dist + 2 tests",
                "canonical: verbatim words, .tests stays plural")
        }

        // --- first-seen order, not canonical order ---
        spec.it("order: first-seen, dist before build") callback {
            l2 = list.new()
            _a = list.add(l2, "x/.dist.ae")
            _a = list.add(l2, "x/.build.ae")
            spec.assert_str_eq(counts_line(l2), "aeb: 1 dist + 1 build",
                "order: first-seen, dist before build")
        }

        // --- singular and plural are DISTINCT literal types ---
        spec.it("literal: .test.ae and .tests.ae are separate clauses") callback {
            l3 = list.new()
            _a = list.add(l3, "x/.test.ae")
            _a = list.add(l3, "y/.tests.ae")
            spec.assert_str_eq(counts_line(l3), "aeb: 1 test + 1 tests",
                "literal: .test.ae and .tests.ae are separate clauses")
        }

        // --- non-canonical types are counted, not dropped ---
        spec.it("custom: .install.ae + .essais.ae visible") callback {
            l4 = list.new()
            _a = list.add(l4, "tools/remote-agent/.install.ae")
            _a = list.add(l4, "foo/.essais.ae")
            _a = list.add(l4, "foo/.build.ae")
            spec.assert_str_eq(counts_line(l4), "aeb: 1 install + 1 essais + 1 build",
                "custom: .install.ae + .essais.ae visible")
        }

        // --- non-ASCII type names pass through verbatim (byte-clean) ---
        spec.it("kanji: counted per verbatim stem") callback {
            l5 = list.new()
            _a = list.add(l5, "src/.構築.ae")
            _a = list.add(l5, "src/.試験.ae")
            _a = list.add(l5, "src2/.構築.ae")
            spec.assert_str_eq(counts_line(l5), "aeb: 2 構築 + 1 試験",
                "kanji: counted per verbatim stem")
        }

        // --- bare dir / non-".<name>.ae" path counts as build (infer_type default) ---
        spec.it("default: bare dir + plain file fold into build") callback {
            l6 = list.new()
            _a = list.add(l6, "ae/x")
            _a = list.add(l6, "ae/x/main.ae")
            spec.assert_str_eq(counts_line(l6), "aeb: 2 build",
                "default: bare dir + plain file fold into build")
        }

        // --- single node ---
        spec.it("single: one clause, no separator") callback {
            l7 = list.new()
            _a = list.add(l7, ".build.ae")
            spec.assert_str_eq(counts_line(l7), "aeb: 1 build",
                "single: one clause, no separator")
        }

        // --- empty input ---
        spec.it("empty: 0 targets") callback {
            l8 = list.new()
            spec.assert_str_eq(counts_line(l8), "aeb: 0 targets",
                "empty: 0 targets")
        }
    }

    return spec.run_summary(fw)
}
