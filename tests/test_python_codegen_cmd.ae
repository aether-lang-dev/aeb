// Tests for python.codegen's pure command-string builder AND the
// closure-DSL setters that feed it.
//
// Two surfaces are covered:
//
//   1. `python_codegen_cmd(py, cwd, driver_form, driver_name, args)`
//      — the pure exec-string assembler. Asserts on the literal
//      `cd '<cwd>' && '<py>' [-m mod | script] <args>` shape.
//
//   2. The grammar setters (`codegen_driver`, `codegen_script`,
//      `codegen_input`, `codegen_input_dir`, `codegen_arg`,
//      `codegen_output`, `codegen_cwd`, `codegen_python`) — each
//      call accumulates into the builder map; this test drives the
//      setters on a fresh map and reads back the keys to confirm.
//
// itests/pytorch/aten/src/ATen/.codegen.ae exercises the same
// surface end-to-end against the real torchgen.gen tool, but that
// requires fetching ~1 GB of upstream pytorch source via
// itests/fetch-upstream.sh, so it's a *fringe* test — the canonical
// grammar test of record is this file.

import std.spec
import python (python_codegen_cmd, codegen_driver, codegen_script,
               codegen_input, codegen_input_dir, codegen_arg,
               codegen_output, codegen_cwd, codegen_python)
import std.list
import std.map

_list_size_at(m: ptr, k: string) {
    if map.has(m, k) == 0 { return 0 }
    l, _ = map.get(m, k)
    return list.size(l)
}

_list_get_at(m: ptr, k: string, i: int) {
    l, _ = map.get(m, k)
    v, _ = list.get(l, i)
    return v
}

_str_at(m: ptr, k: string) {
    if map.has(m, k) == 0 { return "" }
    v, _ = map.get(m, k)
    return v
}

main() {
    fw = spec.init()

    spec.describe(fw, "python_codegen_cmd") {
        // --- Module-form driver, no args.
        spec.it("module form has -m flag") callback {
            args0 = list.new()
            cmd0 = python_codegen_cmd("python3", "/proj", "module", "torchgen.gen", args0)
            spec.assert_str_eq(cmd0, "cd '/proj' && 'python3' -m torchgen.gen", "module form has -m flag")
        }

        // --- Script-form driver, no args.
        spec.it("script form omits -m and uses script path") callback {
            args1 = list.new()
            cmd1 = python_codegen_cmd("python3", "/proj", "script", "tools/gen.py", args1)
            spec.assert_str_eq(cmd1, "cd '/proj' && 'python3' tools/gen.py",
                "script form omits -m and uses script path")
        }

        // --- Args appended in order with single-space separation.
        spec.it("three args appear in order") callback {
            args2 = list.new()
            list.add(args2, "--source-path=aten/src/ATen")
            list.add(args2, "--install_dir=target/aten")
            list.add(args2, "--per-operator-headers")
            cmd2 = python_codegen_cmd("python3", "/proj", "module", "torchgen.gen", args2)
            spec.assert_str_eq(cmd2,
                "cd '/proj' && 'python3' -m torchgen.gen --source-path=aten/src/ATen --install_dir=target/aten --per-operator-headers",
                "three args appear in order")
        }

        // --- Custom python interpreter (e.g. venv path) is quoted in
        // single quotes so spaces in venv paths survive.
        spec.it("venv python is quoted") callback {
            args3 = list.new()
            cmd3 = python_codegen_cmd("/proj/.aeb/venv/bin/python", "/proj", "module", "torchgen.gen", args3)
            spec.assert_str_eq(cmd3, "cd '/proj' && '/proj/.aeb/venv/bin/python' -m torchgen.gen",
                "venv python is quoted")
        }

        // --- Unknown driver_form yields no -m / script segment (defensive
        // — the builder validates upstream, but the pure helper degrades
        // to a bare interpreter invocation).
        spec.it("missing driver_form → bare python invocation") callback {
            args4 = list.new()
            cmd4 = python_codegen_cmd("python3", "/proj", "", "", args4)
            spec.assert_str_eq(cmd4, "cd '/proj' && 'python3'", "missing driver_form → bare python invocation")
        }

        // --- Working directory is single-quoted; absolute path passes through.
        spec.it("cwd with spaces is quoted") callback {
            args5 = list.new()
            list.add(args5, "--dry-run")
            cmd5 = python_codegen_cmd("python3", "/path with spaces/repo", "script", "tools/gen.py", args5)
            spec.assert_str_eq(cmd5, "cd '/path with spaces/repo' && 'python3' tools/gen.py --dry-run",
                "cwd with spaces is quoted")
        }
    }

    // === Setter accumulation tests ====================================
    //
    // Each grammar setter writes into a builder map keyed by an
    // accumulator name (codegen_inputs / codegen_input_dirs /
    // codegen_args / codegen_outputs for the list-valued setters;
    // codegen_driver / codegen_script / codegen_cwd / codegen_python
    // for the scalar setters). Drive each one against a fresh map and
    // assert the read-back is what a downstream builder would see.
    spec.describe(fw, "grammar setters") {
        // --- codegen_input: list accumulator, order preserved.
        spec.it("codegen_input accumulates, order preserved") callback {
            bm1 = map.new()
            codegen_input(bm1, "a.yaml")
            codegen_input(bm1, "b.yaml")
            codegen_input(bm1, "c.yaml")
            spec.assert_eq(_list_size_at(bm1, "codegen_inputs"), 3, "codegen_input accumulates 3 entries")
            spec.assert_str_eq(_list_get_at(bm1, "codegen_inputs", 0), "a.yaml",
                "codegen_input order: first is a.yaml")
            spec.assert_str_eq(_list_get_at(bm1, "codegen_inputs", 2), "c.yaml",
                "codegen_input order: third is c.yaml")
        }

        // --- codegen_input_dir: separate list from codegen_input.
        spec.it("codegen_input_dir stores in its own key, order preserved") callback {
            bm2 = map.new()
            codegen_input(bm2, "native_functions.yaml")
            codegen_input_dir(bm2, "torchgen")
            codegen_input_dir(bm2, "aten/src/ATen/templates")
            spec.assert_eq(_list_size_at(bm2, "codegen_input_dirs"), 2, "codegen_input_dir stores in its own key")
            spec.assert_eq(_list_size_at(bm2, "codegen_inputs"), 1,
                "codegen_input and codegen_input_dir don't cross-contaminate")
            spec.assert_str_eq(_list_get_at(bm2, "codegen_input_dirs", 0), "torchgen",
                "codegen_input_dir entry 0 is torchgen")
            spec.assert_str_eq(_list_get_at(bm2, "codegen_input_dirs", 1), "aten/src/ATen/templates",
                "codegen_input_dir entry 1 preserves order")
        }

        // --- codegen_input_dir mixed-input-mode: matches the Selenium
        // api-listing leaf's shape (single dir, no individual inputs).
        spec.it("input_dir-only declaration has no codegen_inputs key") callback {
            bm2b = map.new()
            codegen_input_dir(bm2b, "selenium")
            spec.assert_eq(_list_size_at(bm2b, "codegen_inputs"), 0,
                "input_dir-only declarations have no codegen_inputs key")
            spec.assert_eq(_list_size_at(bm2b, "codegen_input_dirs"), 1,
                "input_dir-only declarations have 1 input_dirs entry")
        }

        // --- codegen_input_dir + codegen_input interleaved: order is
        // preserved *within* each list independently.
        spec.it("interleaved input/input_dir preserve their own order") callback {
            bm2c = map.new()
            codegen_input(bm2c, "a.yaml")
            codegen_input_dir(bm2c, "templates")
            codegen_input(bm2c, "b.yaml")
            codegen_input_dir(bm2c, "schemas")
            codegen_input(bm2c, "c.yaml")
            spec.assert_str_eq(_list_get_at(bm2c, "codegen_inputs", 1), "b.yaml",
                "interleaved: inputs preserve their own order")
            spec.assert_str_eq(_list_get_at(bm2c, "codegen_input_dirs", 1), "schemas",
                "interleaved: input_dirs preserve their own order")
        }

        // --- codegen_arg: list accumulator, used to build the CLI tail.
        // Drive the setters, then run python_codegen_cmd against the
        // accumulated list — same shape as a real builder body.
        spec.it("setter-accumulated args produce expected cmd") callback {
            bm3 = map.new()
            codegen_arg(bm3, "--source-path")
            codegen_arg(bm3, "aten/src/ATen")
            codegen_arg(bm3, "--install_dir")
            codegen_arg(bm3, "target/aten")
            args_acc, _ = map.get(bm3, "codegen_args")
            cmd_acc = python_codegen_cmd("python3", "/proj", "module", "torchgen.gen", args_acc)
            spec.assert_str_eq(cmd_acc,
                "cd '/proj' && 'python3' -m torchgen.gen --source-path aten/src/ATen --install_dir target/aten",
                "setter-accumulated args produce expected cmd")
        }

        // --- codegen_output: list accumulator.
        spec.it("codegen_output accumulates 2 entries") callback {
            bm4 = map.new()
            codegen_output(bm4, "Functions.cpp")
            codegen_output(bm4, "Functions.h")
            spec.assert_eq(_list_size_at(bm4, "codegen_outputs"), 2, "codegen_output accumulates 2 entries")
        }

        // --- Scalar setters (codegen_cwd, codegen_driver, codegen_script,
        // codegen_python) — each writes a single string key. Later calls
        // overwrite earlier (map.put semantics; not list.add). The builder
        // uses the last value seen.
        spec.it("scalar setters store single keys") callback {
            bm5 = map.new()
            codegen_cwd(bm5, "../../..")
            codegen_driver(bm5, "torchgen.gen")
            codegen_python(bm5, "/venv/bin/python")
            spec.assert_str_eq(_str_at(bm5, "codegen_cwd"), "../../..", "codegen_cwd stored as scalar")
            spec.assert_str_eq(_str_at(bm5, "codegen_driver"), "torchgen.gen", "codegen_driver stored as scalar")
            spec.assert_str_eq(_str_at(bm5, "codegen_python"), "/venv/bin/python", "codegen_python stored as scalar")
        }

        // codegen_script is the alternative to codegen_driver. Calling
        // both leaves both keys populated; the builder's resolution rule
        // is "driver wins if both", but the storage is independent.
        spec.it("codegen_driver and codegen_script coexist in the map") callback {
            bm6 = map.new()
            codegen_driver(bm6, "torchgen.gen")
            codegen_script(bm6, "tools/gen.py")
            spec.assert_str_eq(_str_at(bm6, "codegen_driver"), "torchgen.gen",
                "codegen_driver and codegen_script coexist in the map")
            spec.assert_str_eq(_str_at(bm6, "codegen_script"), "tools/gen.py", "codegen_script also stored")
        }

        // --- Empty-list accumulation: a builder body that never calls
        // a setter shouldn't see a zero-length list — the key is absent
        // entirely (downstream uses `map.has` to gate).
        spec.it("untouched map has no accumulators") callback {
            bm7 = map.new()
            spec.assert_eq(_list_size_at(bm7, "codegen_inputs"), 0, "untouched map has no codegen_inputs key")
            spec.assert_str_eq(_str_at(bm7, "codegen_cwd"), "", "untouched map has empty scalar codegen_cwd")
        }
    }

    return spec.run_summary(fw)
}
