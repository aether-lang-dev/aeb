// Tests for the groovyc cache-key derivation in lib/groovy/module.ae.
//
// _cache_key_for_groovyc(ctx, argfile_path, cmd, groovy_jars_nl, groovyc_bin)
// reads .groovy sources via cache.hash_file and dep artifacts via
// bldr._read_dep_artifact, so tests stage real fixtures under a tmpdir
// per case. Same shape as test_scala_cache.ae. Does NOT assert the
// toolchain probe is non-empty (tolerates an absent groovyc).
import std.spec
import std.string
import std.io
import std.os
import std.file
import std.fs
import std.list
import std.map
import std.path
import std.dir

import bldr
import groovy (_cache_key_for_groovyc)

_mktempdir() {
    // Native form on Windows. `mktemp -d` answers in the SHELL's vocabulary
    // ("/tmp/tmp.XXXX" under MSYS), but std.fs/std.dir/std.file are native
    // Win32 calls that cannot see MSYS paths — dir.exists("/tmp/tmp.X") is 0
    // while dir.exists("C:/msys64/tmp/tmp.X") is 1. Without this the suite
    // fails on Windows for an environment reason, not a real defect.
    // No-op off Windows: cygpath is absent, so the value passes through.
    raw, _err = os.exec("mktemp -d")
    d = string.trim(raw)
    // NO quotes, NO redirect: os.exec routes through cmd.exe on Windows,
    // which does not honour POSIX single quotes or `2>/dev/null` — with them
    // the call returns EMPTY and the path silently stays POSIX. Bare works.
    nat, _nerr = os.exec("cygpath -m ${d}")
    n = string.trim(nat)
    if string.length(n) > 0 { return n }
    return d
}

_write(p: string, content: string) {
    fs.write_atomic(p, content, string.length(content))
}

_minimal_ctx(root: string) {
    ctx = map.new()
    map.put(ctx, "deps", list.new())
    map.put(ctx, "root", root)
    return ctx
}

main() {
    fw = spec.init()

    spec.describe(fw, "_cache_key_for_groovyc") {
        spec.it("key derivation, invalidation, and content-addressing") callback {
            tdir = _mktempdir()

            src = path.join(tdir, "Hello.groovy")
            _write(src, "class Hello {}\n")

            argfile = path.join(tdir, "argfile.txt")
            _write(argfile, string.concat(src, "\n"))

            ctx = _minimal_ctx(tdir)
            jars = "/opt/groovy/lib/groovy-4.0.21.jar"
            cmd = "groovyc -d /target/classes -cp /target/classes ${src}"

            // --- determinism ---
            k1, e1 = _cache_key_for_groovyc(ctx, argfile, cmd, jars, "groovyc")
            spec.assert_str_eq(e1, "", "key: no error on fresh inputs")
            spec.assert_true(string.length(k1) > 0, "key: non-empty hash")
            k2, _e2 = _cache_key_for_groovyc(ctx, argfile, cmd, jars, "groovyc")
            spec.assert_str_eq(k1, k2, "determinism: same inputs → same key")

            // --- src content change → different key ---
            _write(src, "class Hello { def f() { 1 } }\n")
            k3, _e3 = _cache_key_for_groovyc(ctx, argfile, cmd, jars, "groovyc")
            spec.assert_false(string.equals(k1, k3), "invalidation: src content change → different key")
            _write(src, "class Hello {}\n")
            k4, _e4 = _cache_key_for_groovyc(ctx, argfile, cmd, jars, "groovyc")
            spec.assert_str_eq(k1, k4, "content-addressed: same content → same key")

            // --- cmd string change (e.g. -cp / flag) → different key ---
            k_cmd, _e5 = _cache_key_for_groovyc(ctx, argfile, "groovyc -d /target/classes -cp /other ${src}", jars, "groovyc")
            spec.assert_false(string.equals(k1, k_cmd), "invalidation: cmd string change → different key")

            // --- groovy runtime jar bump (toolchain) → different key ---
            jars2 = "/opt/groovy/lib/groovy-4.0.22.jar"
            k_jar, _e6 = _cache_key_for_groovyc(ctx, argfile, cmd, jars2, "groovyc")
            spec.assert_false(string.equals(k1, k_jar), "invalidation: groovy jar version change → different key")

            // --- second source → different key, order-independent ---
            src2 = path.join(tdir, "Other.groovy")
            _write(src2, "class Other {}\n")
            argfile2 = path.join(tdir, "argfile2.txt")
            _write(argfile2, string.concat(string.concat(src, "\n"), string.concat(src2, "\n")))
            k_two, _e7 = _cache_key_for_groovyc(ctx, argfile2, cmd, jars, "groovyc")
            spec.assert_false(string.equals(k1, k_two), "invalidation: extra .groovy added → different key")
            argfile_rev = path.join(tdir, "argfile_rev.txt")
            _write(argfile_rev, string.concat(string.concat(src2, "\n"), string.concat(src, "\n")))
            k_two_rev, _e8 = _cache_key_for_groovyc(ctx, argfile_rev, cmd, jars, "groovyc")
            spec.assert_str_eq(k_two, k_two_rev, "ordering: argfile listing order doesn't change key")

            // --- missing src → error, empty key ---
            bad_argfile = path.join(tdir, "bad.txt")
            _write(bad_argfile, string.concat(path.join(tdir, "Nope.groovy"), "\n"))
            k_bad, e_bad = _cache_key_for_groovyc(ctx, bad_argfile, cmd, jars, "groovyc")
            spec.assert_str_eq(k_bad, "", "error path: missing src returns empty key")
            spec.assert_true(string.length(e_bad) > 0, "error path: missing src reports error")

            os.system("rm -rf '${tdir}'")
        }
    }

    return spec.run_summary(fw)
}
