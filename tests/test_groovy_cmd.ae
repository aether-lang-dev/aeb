// Tests for lib/groovy's pure command pieces: the groovyc invocation string
// and the JAVA_OPTS bytecode-target prefix.
import std.spec
import std.io
import std.map
import groovy (groovyc_cmd, _java_opts, target_bytecode, run_script, _write_argfile)

main() {
    fw = spec.init()

    spec.describe(fw, "groovyc_cmd") {
        // groovyc_cmd(bin, classes_dir, classpath, file_list)
        spec.it("resolved bin + multi-entry cp") callback {
            spec.assert_str_eq(
                groovyc_cmd("/opt/groovy/bin/groovyc", "/t/classes", "/cp/a.jar:/cp/b.jar", "Foo.groovy Bar.groovy"),
                "/opt/groovy/bin/groovyc -d /t/classes -cp /cp/a.jar:/cp/b.jar Foo.groovy Bar.groovy", "groovyc resolved bin + multi-entry cp")
        }
        spec.it("bare bin (PATH fallback)") callback {
            spec.assert_str_eq(
                groovyc_cmd("groovyc", "/t", "cp", "F.groovy"),
                "groovyc -d /t -cp cp F.groovy", "groovyc bare bin (PATH fallback)")
        }
    }

    spec.describe(fw, "_java_opts") {
        // _java_opts(builder_map): target_bytecode → JAVA_OPTS prefix
        spec.it("null bmap → empty") callback {
            spec.assert_str_eq(_java_opts(null), "", "java_opts: null bmap → empty")
        }
        spec.it("target_bytecode unset → empty") callback {
            bm0 = map.new()
            spec.assert_str_eq(_java_opts(bm0), "", "java_opts: target_bytecode unset → empty")
        }
        spec.it("target_bytecode(22)") callback {
            bm = map.new()
            target_bytecode(bm, "22")
            spec.assert_str_eq(_java_opts(bm), "JAVA_OPTS=\"-Dgroovy.target.bytecode=22\" ", "java_opts: target_bytecode(22)")
        }
        spec.it("target_bytecode(17)") callback {
            bm2 = map.new()
            target_bytecode(bm2, "17")
            spec.assert_str_eq(_java_opts(bm2), "JAVA_OPTS=\"-Dgroovy.target.bytecode=17\" ", "java_opts: target_bytecode(17)")
        }
    }

    spec.describe(fw, "run_script") {
        // run_script(script): scalar setter, run a Groovy script directly
        // (no test compile). Stored under "run_script"; last call wins.
        spec.it("stored as scalar") callback {
            bmr = map.new()
            run_script(bmr, "scripts/smoke.groovy")
            sv, _ = map.get(bmr, "run_script")
            spec.assert_str_eq(sv, "scripts/smoke.groovy", "run_script stored as scalar")
        }
        spec.it("last-call-wins") callback {
            bmr = map.new()
            run_script(bmr, "scripts/smoke.groovy")
            run_script(bmr, "scripts/other.groovy")
            sv2, _ = map.get(bmr, "run_script")
            spec.assert_str_eq(sv2, "scripts/other.groovy", "run_script last-call-wins")
        }
    }

    spec.describe(fw, "_write_argfile") {
        // Regression: this wrote an EMPTY file because it reached into
        // string.split's result with list.size/list.get instead of
        // string.array_size/string.array_get. _cache_key_for_groovyc hashes
        // each source NAMED IN THIS FILE, so an empty argfile meant the
        // groovyc cache key ignored source content entirely — edit a .groovy
        // file and the stale cached class tree was replayed forever. A
        // deliberately broken Groovy test kept reporting PASS because of it.
        spec.it("lists every source, one per line") callback {
            out = _write_argfile("/tmp", "aeb_test_argfile.txt",
                "a/One.groovy b/Two.groovy c/Three.groovy")
            content, _e = io.read_file(out)
            spec.assert_str_eq(content, "a/One.groovy\nb/Two.groovy\nc/Three.groovy",
                "all three sources present, newline separated")
        }
        spec.it("is not empty for a single source") callback {
            out = _write_argfile("/tmp", "aeb_test_argfile1.txt", "only/One.groovy")
            content, _e = io.read_file(out)
            spec.assert_str_eq(content, "only/One.groovy", "single source written")
        }
        spec.it("skips padding without emitting blank lines") callback {
            out = _write_argfile("/tmp", "aeb_test_argfile2.txt", "  a.groovy   b.groovy  ")
            content, _e = io.read_file(out)
            spec.assert_str_eq(content, "a.groovy\nb.groovy", "extra spaces collapse")
        }
    }

    return spec.run_summary(fw)
}
