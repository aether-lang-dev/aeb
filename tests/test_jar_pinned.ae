// Tests for lib/java's pinned-dependency path derivation — the pure piece of
// java.jar_pinned / java.mvn_repo that maps a "g:a:v" coordinate to its jar
// location under any repo root (~/.m2/repository or a remote base URL).
import std.spec
import java (_pinned_relpath, _dots_to_slashes)

main() {
    fw = spec.init()

    spec.describe(fw, "_dots_to_slashes") {
        // Maven group → path segment
        spec.it("multi-segment") callback {
            spec.assert_str_eq(_dots_to_slashes("org.junit.jupiter"), "org/junit/jupiter", "multi-segment")
        }
        spec.it("single segment") callback {
            spec.assert_str_eq(_dots_to_slashes("clojure"), "clojure", "single segment")
        }
        spec.it("empty") callback {
            spec.assert_str_eq(_dots_to_slashes(""), "", "empty")
        }
    }

    spec.describe(fw, "_pinned_relpath") {
        // "g:a:v" → "<g/path>/<a>/<v>/<a>-<v>.jar"
        spec.it("junit-jupiter") callback {
            spec.assert_str_eq(
                _pinned_relpath("org.junit.jupiter:junit-jupiter:6.0.3"),
                "org/junit/jupiter/junit-jupiter/6.0.3/junit-jupiter-6.0.3.jar", "junit-jupiter")
        }
        spec.it("selenium-java") callback {
            spec.assert_str_eq(
                _pinned_relpath("org.seleniumhq.selenium:selenium-java:4.39.0"),
                "org/seleniumhq/selenium/selenium-java/4.39.0/selenium-java-4.39.0.jar", "selenium-java")
        }
        spec.it("single-segment group (clojure)") callback {
            spec.assert_str_eq(
                _pinned_relpath("org.clojure:clojure:1.12.0"),
                "org/clojure/clojure/1.12.0/clojure-1.12.0.jar", "single-segment group (clojure)")
        }
        // a real coordinate whose version is long and dash-laden — must NOT be
        // mangled (the version is taken whole, not re-parsed).
        spec.it("gnarly version (listenablefuture)") callback {
            spec.assert_str_eq(
                _pinned_relpath("com.google.guava:listenablefuture:9999.0-empty-to-avoid-conflict-with-guava"),
                "com/google/guava/listenablefuture/9999.0-empty-to-avoid-conflict-with-guava/listenablefuture-9999.0-empty-to-avoid-conflict-with-guava.jar", "gnarly version (listenablefuture)")
        }
        // hyphenated artifact id stays intact
        spec.it("hyphenated artifact") callback {
            spec.assert_str_eq(
                _pinned_relpath("org.junit.platform:junit-platform-console-standalone:6.0.3"),
                "org/junit/platform/junit-platform-console-standalone/6.0.3/junit-platform-console-standalone-6.0.3.jar", "hyphenated artifact")
        }
        spec.it("not a g:a:v coord → empty") callback {
            spec.assert_str_eq(_pinned_relpath("not-a-coord"), "", "not a g:a:v coord → empty")
        }
        spec.it("only g:a → empty") callback {
            spec.assert_str_eq(_pinned_relpath("org.foo:bar"), "", "only g:a → empty")
        }
    }

    spec.run_summary(fw)
}
