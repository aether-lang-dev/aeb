// Tests for the scalac cache-key derivation in lib/scala/module.ae.
//
// _cache_key_for_scalac(ctx, argfile_path, cmd, compiler_cp) reads
// .scala sources via cache.hash_file and dep artifacts via
// build._read_dep_artifact, so tests stage real fixtures under a
// tmpdir per case. Same shape as test_java_cache.ae. Does NOT assert
// the java probe is non-empty (tolerates an absent JVM).
import std.string
import std.io
import std.os
import std.file
import std.fs
import std.list
import std.map
import std.path
import std.dir

import build
import scala (_cache_key_for_scalac)

_assert_eq(label: string, actual: string, expected: string) {
    if actual == expected {
        println("PASS: ${label}")
    } else {
        println("FAIL: ${label}")
        println("  expected: '${expected}'")
        println("  actual:   '${actual}'")
    }
}

_assert_neq(label: string, a: string, b: string) {
    if a == b {
        println("FAIL: ${label}")
        println("  unexpected match: '${a}'")
    } else {
        println("PASS: ${label}")
    }
}

_assert_nonempty(label: string, s: string) {
    if string.length(s) > 0 {
        println("PASS: ${label}")
    } else {
        println("FAIL: ${label} (empty)")
    }
}

_mktempdir() {
    raw, _err = os.exec("mktemp -d")
    return string.trim(raw)
}

_write(p: string, content: string) {
    fs.write_atomic(p, content, string.length(content))
}

_minimal_ctx(root: string) {
    ctx = map.new()
    map.put(ctx, "deps", list.new())
    map.put(ctx, "root", root)
    return ctx
}

main() {
    tdir = _mktempdir()

    src = path.join(tdir, "Hello.scala")
    _write(src, "object Hello\n")

    argfile = path.join(tdir, "argfile.txt")
    _write(argfile, string.concat(src, "\n"))

    ctx = _minimal_ctx(tdir)
    ccp = "/m/scala3-compiler_3-3.8.2.jar:/m/scala3-library_3-3.8.2.jar"

    // --- determinism ---
    k1, e1 = _cache_key_for_scalac(ctx, argfile, "java -cp ${ccp} dotty.tools.dotc.Main -d /target -cp /target @${argfile}", ccp)
    _assert_eq("key: no error on fresh inputs", e1, "")
    _assert_nonempty("key: non-empty hash", k1)
    k2, _e2 = _cache_key_for_scalac(ctx, argfile, "java -cp ${ccp} dotty.tools.dotc.Main -d /target -cp /target @${argfile}", ccp)
    _assert_eq("determinism: same inputs → same key", k1, k2)

    // --- src content change → different key ---
    _write(src, "object Hello { def f() = 1 }\n")
    k3, _e3 = _cache_key_for_scalac(ctx, argfile, "java -cp ${ccp} dotty.tools.dotc.Main -d /target -cp /target @${argfile}", ccp)
    _assert_neq("invalidation: src content change → different key", k1, k3)

    // --- restore content → original key ---
    _write(src, "object Hello\n")
    k4, _e4 = _cache_key_for_scalac(ctx, argfile, "java -cp ${ccp} dotty.tools.dotc.Main -d /target -cp /target @${argfile}", ccp)
    _assert_eq("content-addressed: same content → same key", k1, k4)

    // --- compiler classpath change (scala_version bump) → different key ---
    ccp2 = "/m/scala3-compiler_3-3.9.0.jar:/m/scala3-library_3-3.9.0.jar"
    k_ver, _e5 = _cache_key_for_scalac(ctx, argfile, "java -cp ${ccp2} dotty.tools.dotc.Main -d /target -cp /target @${argfile}", ccp2)
    _assert_neq("invalidation: scala compiler-cp change → different key", k1, k_ver)

    // --- second source → different key ---
    src2 = path.join(tdir, "Other.scala")
    _write(src2, "object Other\n")
    argfile2 = path.join(tdir, "argfile2.txt")
    _write(argfile2, string.concat(string.concat(src, "\n"), string.concat(src2, "\n")))
    k_two, _e6 = _cache_key_for_scalac(ctx, argfile2, "java -cp ${ccp} dotty.tools.dotc.Main -d /target -cp /target @${argfile2}", ccp)
    _assert_neq("invalidation: extra .scala added → different key", k1, k_two)

    // --- argfile order independence ---
    argfile_rev = path.join(tdir, "argfile_rev.txt")
    _write(argfile_rev, string.concat(string.concat(src2, "\n"), string.concat(src, "\n")))
    k_two_rev, _e7 = _cache_key_for_scalac(ctx, argfile_rev, "java -cp ${ccp} dotty.tools.dotc.Main -d /target -cp /target @${argfile2}", ccp)
    _assert_eq("ordering: argfile listing order doesn't change key", k_two, k_two_rev)

    // --- missing src → error, empty key ---
    bad_argfile = path.join(tdir, "bad.txt")
    _write(bad_argfile, string.concat(path.join(tdir, "nope.scala"), "\n"))
    k_bad, e_bad = _cache_key_for_scalac(ctx, bad_argfile, "java", ccp)
    _assert_eq("error path: missing src returns empty key", k_bad, "")
    _assert_nonempty("error path: missing src reports error", e_bad)

    os.system("rm -rf '${tdir}'")
    println("scala cache-key tests done")
}
