// Tests for the pure helpers in lib/aether/module.ae:
//   _paired_generated_c   — .ae path → _generated.c sibling
//   _detect_caps_from_content — `import std.X` → --with cap mapping
import std.spec
import aether (_paired_generated_c, _detect_caps_from_content, _regen_action)

main() {
    fw = spec.init()

    spec.describe(fw, "_paired_generated_c") {
        spec.it("simple") callback {
            spec.assert_str_eq(_paired_generated_c("foo.ae"), "foo_generated.c", "simple")
        }
        spec.it("with dir") callback {
            spec.assert_str_eq(_paired_generated_c("ae/svnserver/auth.ae"),
                "ae/svnserver/auth_generated.c", "with dir")
        }
        spec.it("relative-up path") callback {
            spec.assert_str_eq(_paired_generated_c("../../ae/client/handlers.ae"),
                "../../ae/client/handlers_generated.c", "relative-up")
        }
        spec.it("not .ae returns empty") callback {
            spec.assert_str_eq(_paired_generated_c("foo.txt"), "", "not .ae")
        }
        spec.it("no extension returns empty") callback {
            spec.assert_str_eq(_paired_generated_c("foo"), "", "no extension")
        }
        spec.it("too short returns empty") callback {
            spec.assert_str_eq(_paired_generated_c("ae"), "", "too short")
        }
        spec.it("empty input") callback {
            spec.assert_str_eq(_paired_generated_c(""), "", "empty")
        }
    }

    spec.describe(fw, "_detect_caps_from_content: empty / no caps") {
        spec.it("empty content") callback {
            spec.assert_str_eq(_detect_caps_from_content(""), "", "empty")
        }
        spec.it("only std.io") callback {
            spec.assert_str_eq(_detect_caps_from_content("import std.io\nmain() {}"), "", "std.io")
        }
        spec.it("only std.string") callback {
            spec.assert_str_eq(_detect_caps_from_content("import std.string"), "", "std.string")
        }
    }

    spec.describe(fw, "_detect_caps_from_content: single caps") {
        spec.it("std.http → net") callback {
            spec.assert_str_eq(_detect_caps_from_content("import std.http"), "net", "http")
        }
        spec.it("std.tcp → net") callback {
            spec.assert_str_eq(_detect_caps_from_content("import std.tcp"), "net", "tcp")
        }
        spec.it("std.net → net") callback {
            spec.assert_str_eq(_detect_caps_from_content("import std.net"), "net", "net")
        }
        spec.it("std.fs → fs") callback {
            spec.assert_str_eq(_detect_caps_from_content("import std.fs"), "fs", "fs")
        }
        spec.it("std.os → os") callback {
            spec.assert_str_eq(_detect_caps_from_content("import std.os"), "os", "os")
        }
    }

    spec.describe(fw, "_detect_caps_from_content: combinations (order fixed net,fs,os)") {
        spec.it("net+fs") callback {
            spec.assert_str_eq(_detect_caps_from_content("import std.http\nimport std.fs"), "net,fs", "net+fs")
        }
        spec.it("net+os") callback {
            spec.assert_str_eq(_detect_caps_from_content("import std.http\nimport std.os"), "net,os", "net+os")
        }
        spec.it("fs+os") callback {
            spec.assert_str_eq(_detect_caps_from_content("import std.fs\nimport std.os"), "fs,os", "fs+os")
        }
        spec.it("all three") callback {
            spec.assert_str_eq(_detect_caps_from_content("import std.http\nimport std.fs\nimport std.os"),
                "net,fs,os", "all three")
        }
        spec.it("order of imports doesn't change output order") callback {
            spec.assert_str_eq(_detect_caps_from_content("import std.os\nimport std.http\nimport std.fs"),
                "net,fs,os", "import order")
        }
    }

    spec.describe(fw, "_detect_caps_from_content: net dedup + realistic") {
        // net dedup: multiple net-grant imports collapse to one "net"
        spec.it("http+tcp+net dedup") callback {
            spec.assert_str_eq(_detect_caps_from_content("import std.http\nimport std.tcp\nimport std.net"),
                "net", "dedup")
        }
        spec.it("realistic mix") callback {
            src = "import std.io\nimport std.http\nimport std.fs\nextern println(s: string)\n"
            spec.assert_str_eq(_detect_caps_from_content(src), "net,fs", "realistic")
        }
    }

    spec.describe(fw, "_regen_action: mtime-driven dispatch") {
        spec.it("missing (c_mtime=0)") callback {
            spec.assert_str_eq(_regen_action(1000, 0), "missing", "missing")
        }
        spec.it("stale (c older than ae)") callback {
            spec.assert_str_eq(_regen_action(2000, 1500), "stale", "stale")
        }
        spec.it("stale by 1 second") callback {
            spec.assert_str_eq(_regen_action(2000, 1999), "stale", "stale 1s")
        }
        spec.it("fresh (c newer)") callback {
            spec.assert_str_eq(_regen_action(1000, 2000), "skip", "fresh")
        }
        spec.it("equal mtimes → skip (no work needed)") callback {
            spec.assert_str_eq(_regen_action(1500, 1500), "skip", "equal")
        }
        spec.it("very fresh c_mtime") callback {
            spec.assert_str_eq(_regen_action(1, 9999999), "skip", "very fresh")
        }
    }

    return spec.run_summary(fw)
}
