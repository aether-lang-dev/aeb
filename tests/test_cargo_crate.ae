// Tests for cargo_crate_toml_content() — workspace member crate Cargo.toml generation
import std.spec
import std.map
import rust (cargo_crate_toml_content)

_add_dep(opts: ptr, name: string, ver: string) {
    if map_has(opts, "_crate_deps") == 0 {
        map_put(opts, "_crate_deps", list_new())
    }
    deps, _ = map.get(opts, "_crate_deps")
    entry = string_concat(name, "~")
    entry = string_concat(entry, ver)
    list_add(deps, entry)
}

_add_dep_features(opts: ptr, name: string, ver: string, feats: string) {
    if map_has(opts, "_crate_deps_features") == 0 {
        map_put(opts, "_crate_deps_features", list_new())
    }
    deps, _ = map.get(opts, "_crate_deps_features")
    entry = string_concat(name, "~")
    entry = string_concat(entry, ver)
    entry = string_concat(entry, "~")
    entry = string_concat(entry, feats)
    list_add(deps, entry)
}

_add_path_dep(opts: ptr, name: string, p: string) {
    if map_has(opts, "_path_deps") == 0 {
        map_put(opts, "_path_deps", list_new())
    }
    deps, _ = map.get(opts, "_path_deps")
    entry = string_concat(name, "~")
    entry = string_concat(entry, p)
    list_add(deps, entry)
}

_add_ws_ref(opts: ptr, name: string) {
    if map_has(opts, "_ws_refs") == 0 {
        map_put(opts, "_ws_refs", list_new())
    }
    refs, _ = map.get(opts, "_ws_refs")
    list_add(refs, name)
}

_add_dev_ws_ref(opts: ptr, name: string) {
    if map_has(opts, "_dev_ws_refs") == 0 {
        map_put(opts, "_dev_ws_refs", list_new())
    }
    refs, _ = map.get(opts, "_dev_ws_refs")
    list_add(refs, name)
}

_add_bin(opts: ptr, name: string, p: string) {
    if map_has(opts, "_bins") == 0 {
        map_put(opts, "_bins", list_new())
    }
    bins, _ = map.get(opts, "_bins")
    entry = string_concat(name, "~")
    entry = string_concat(entry, p)
    list_add(bins, entry)
}

_add_feature(opts: ptr, name: string, deps_csv: string) {
    if map_has(opts, "_features") == 0 {
        map_put(opts, "_features", list_new())
    }
    feats, _ = map.get(opts, "_features")
    entry = string_concat(name, "~")
    entry = string_concat(entry, deps_csv)
    list_add(feats, entry)
}

main() {
    fw = spec.init()

    spec.describe(fw, "cargo_crate_toml_content") {
        spec.it("minimal — name only") callback {
            opts1 = map_new()
            map_put(opts1, "crate_name", "core")
            toml1 = cargo_crate_toml_content(opts1)
            spec.assert_contains(toml1, "[package]", "minimal has [package]")
            spec.assert_contains(toml1, "name = \"core\"", "minimal has name")
            spec.assert_false(string_contains(toml1, "[lib]") == 1, "minimal no [lib]")
            spec.assert_false(string_contains(toml1, "[dependencies]") == 1, "minimal no [dependencies]")
        }

        spec.it("edition.workspace = true") callback {
            opts2 = map_new()
            map_put(opts2, "crate_name", "lib")
            map_put(opts2, "edition", "2021")
            toml2 = cargo_crate_toml_content(opts2)
            spec.assert_contains(toml2, "edition.workspace = true", "edition workspace inherit")
        }

        spec.it("explicit version") callback {
            opts3 = map_new()
            map_put(opts3, "crate_name", "app")
            map_put(opts3, "version", "1.0.0")
            toml3 = cargo_crate_toml_content(opts3)
            spec.assert_contains(toml3, "version = \"1.0.0\"", "explicit version")
        }

        spec.it("[[bin]] section") callback {
            opts4 = map_new()
            map_put(opts4, "crate_name", "myapp")
            _add_bin(opts4, "myapp", "src/main.rs")
            toml4 = cargo_crate_toml_content(opts4)
            spec.assert_contains(toml4, "[[bin]]", "[[bin]] header")
            spec.assert_contains(toml4, "name = \"myapp\"", "bin name")
            spec.assert_contains(toml4, "path = \"src/main.rs\"", "bin path")
        }

        spec.it("[lib] from crate_type") callback {
            opts5 = map_new()
            map_put(opts5, "crate_name", "shared")
            map_put(opts5, "crate_type", "cdylib")
            map_put(opts5, "lib_path", "src/lib.rs")
            toml5 = cargo_crate_toml_content(opts5)
            spec.assert_contains(toml5, "[lib]", "[lib] header")
            spec.assert_contains(toml5, "path = \"src/lib.rs\"", "lib path")
            spec.assert_contains(toml5, "crate-type = [\"cdylib\"]", "lib crate-type")
        }

        spec.it("workspace ref dependency") callback {
            opts6 = map_new()
            map_put(opts6, "crate_name", "service")
            _add_ws_ref(opts6, "tokio")
            _add_ws_ref(opts6, "serde")
            toml6 = cargo_crate_toml_content(opts6)
            spec.assert_contains(toml6, "[dependencies]", "[dependencies] header")
            spec.assert_contains(toml6, "tokio.workspace = true", "ws ref tokio")
            spec.assert_contains(toml6, "serde.workspace = true", "ws ref serde")
        }

        spec.it("direct version dep") callback {
            opts7 = map_new()
            map_put(opts7, "crate_name", "tool")
            _add_dep(opts7, "log", "0.4")
            toml7 = cargo_crate_toml_content(opts7)
            spec.assert_contains(toml7, "log = \"0.4\"", "direct version")
        }

        spec.it("dep with features") callback {
            opts8 = map_new()
            map_put(opts8, "crate_name", "server")
            _add_dep_features(opts8, "tokio", "1.0", "full,macros")
            toml8 = cargo_crate_toml_content(opts8)
            spec.assert_contains(toml8, "tokio = { version = \"1.0\", features = [\"full\", \"macros\"] }", "features dep")
        }

        spec.it("path dep") callback {
            opts9 = map_new()
            map_put(opts9, "crate_name", "app")
            _add_path_dep(opts9, "shared", "../shared")
            toml9 = cargo_crate_toml_content(opts9)
            spec.assert_contains(toml9, "shared = { path = \"../shared\" }", "path dep")
        }

        spec.it("dev-dependencies") callback {
            opts10 = map_new()
            map_put(opts10, "crate_name", "lib")
            _add_dev_ws_ref(opts10, "proptest")
            toml10 = cargo_crate_toml_content(opts10)
            spec.assert_contains(toml10, "[dev-dependencies]", "dev-dependencies header")
            spec.assert_contains(toml10, "proptest.workspace = true", "dev ws ref")
        }

        spec.it("features section") callback {
            opts11 = map_new()
            map_put(opts11, "crate_name", "lib")
            map_put(opts11, "_default_features", "std,tls")
            _add_feature(opts11, "std", "")
            _add_feature(opts11, "tls", "openssl")
            toml11 = cargo_crate_toml_content(opts11)
            spec.assert_contains(toml11, "[features]", "features header")
            spec.assert_contains(toml11, "default = [\"std\", \"tls\"]", "default features")
            spec.assert_contains(toml11, "std = []", "empty feature")
            spec.assert_contains(toml11, "tls = [\"openssl\"]", "feature with deps")
        }

        // full combo (workspace member with mixed dep types)
        spec.it("full combo (mixed dep types)") callback {
            opts12 = map_new()
            map_put(opts12, "crate_name", "server-core")
            map_put(opts12, "edition", "2021")
            _add_ws_ref(opts12, "tokio")
            _add_dep(opts12, "log", "0.4")
            _add_dep_features(opts12, "serde", "1.0", "derive")
            _add_path_dep(opts12, "shared", "../shared")
            _add_dev_ws_ref(opts12, "proptest")
            toml12 = cargo_crate_toml_content(opts12)
            spec.assert_contains(toml12, "name = \"server-core\"", "combo: name")
            spec.assert_contains(toml12, "edition.workspace = true", "combo: ws inherit")
            spec.assert_contains(toml12, "tokio.workspace = true", "combo: ws ref")
            spec.assert_contains(toml12, "log = \"0.4\"", "combo: direct dep")
            spec.assert_contains(toml12, "serde = { version = \"1.0\", features = [\"derive\"] }", "combo: features dep")
            spec.assert_contains(toml12, "shared = { path = \"../shared\" }", "combo: path dep")
            spec.assert_contains(toml12, "[dev-dependencies]", "combo: dev-deps")
            spec.assert_contains(toml12, "proptest.workspace = true", "combo: dev ws ref")
        }
    }

    spec.run_summary(fw)
}
