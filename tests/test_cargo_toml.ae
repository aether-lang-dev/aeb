// Tests for cargo_toml_content() — Cargo.toml generation from DSL
import std.spec
import std.map
import rust (cargo_toml_content)

// Helper to add a crate dep (name=version) to opts
_add_dep(opts: ptr, name: string, ver: string) {
    if map_has(opts, "_crate_deps") == 0 {
        map_put(opts, "_crate_deps", list_new())
    }
    deps, _ = map.get(opts, "_crate_deps")
    entry = string_concat(name, "~")
    entry = string_concat(entry, ver)
    list_add(deps, entry)
}

// Helper to add a dep with features (name=version=feat1,feat2)
_add_dep_features(opts: ptr, name: string, ver: string, feats: string) {
    if map_has(opts, "_crate_deps_features") == 0 {
        map_put(opts, "_crate_deps_features", list_new())
    }
    deps, _ = map.get(opts, "_crate_deps_features")
    entry = string_concat(name, "~")
    entry = string_concat(entry, ver)
    entry = string_concat(entry, "~")
    entry = string_concat(entry, feats)
    list_add(deps, entry)
}

// Helper to add a path dep (name=path)
_add_path_dep(opts: ptr, name: string, path: string) {
    if map_has(opts, "_path_deps") == 0 {
        map_put(opts, "_path_deps", list_new())
    }
    deps, _ = map.get(opts, "_path_deps")
    entry = string_concat(name, "~")
    entry = string_concat(entry, path)
    list_add(deps, entry)
}

main() {
    fw = spec.init()

    spec.describe(fw, "cargo_toml_content") {
        spec.it("minimal defaults") callback {
            toml1 = cargo_toml_content(null)
            spec.assert_contains(toml1, "[package]", "minimal has [package]")
            spec.assert_contains(toml1, "version = \"0.1.0\"", "minimal has version 0.1.0")
            spec.assert_contains(toml1, "edition = \"2021\"", "minimal has edition 2021")
        }

        spec.it("custom name, version, edition") callback {
            opts2 = map_new()
            map_put(opts2, "crate_name", "mylib")
            map_put(opts2, "version", "1.2.3")
            map_put(opts2, "edition", "2024")
            toml2 = cargo_toml_content(opts2)
            spec.assert_contains(toml2, "name = \"mylib\"", "custom name")
            spec.assert_contains(toml2, "version = \"1.2.3\"", "custom version")
            spec.assert_contains(toml2, "edition = \"2024\"", "custom edition")
        }

        spec.it("crate_type generates [lib]") callback {
            opts3 = map_new()
            map_put(opts3, "crate_name", "vowelbase")
            map_put(opts3, "crate_type", "cdylib")
            toml3 = cargo_toml_content(opts3)
            spec.assert_contains(toml3, "[lib]", "has [lib]")
            spec.assert_contains(toml3, "crate-type = [\"cdylib\"]", "crate-type cdylib")
        }

        spec.it("simple crate deps") callback {
            opts4 = map_new()
            map_put(opts4, "crate_name", "myapp")
            _add_dep(opts4, "serde", "1.0")
            _add_dep(opts4, "log", "0.4")
            toml4 = cargo_toml_content(opts4)
            spec.assert_contains(toml4, "[dependencies]", "has [dependencies]")
            spec.assert_contains(toml4, "serde = \"1.0\"", "serde dep")
            spec.assert_contains(toml4, "log = \"0.4\"", "log dep")
        }

        spec.it("deps with features") callback {
            opts5 = map_new()
            map_put(opts5, "crate_name", "server")
            _add_dep_features(opts5, "tokio", "1.0", "full,macros")
            toml5 = cargo_toml_content(opts5)
            spec.assert_contains(toml5, "tokio = { version = \"1.0\", features = [\"full\", \"macros\"] }", "tokio with features")
        }

        spec.it("path deps") callback {
            opts6 = map_new()
            map_put(opts6, "crate_name", "myapp")
            _add_path_dep(opts6, "mylib", "../lib")
            toml6 = cargo_toml_content(opts6)
            spec.assert_contains(toml6, "mylib = { path = \"../lib\" }", "path dep")
        }

        // full combo (like vowelbase)
        spec.it("full combo (vowelbase-like)") callback {
            opts7 = map_new()
            map_put(opts7, "crate_name", "vowelbase")
            map_put(opts7, "version", "0.1.0")
            map_put(opts7, "edition", "2021")
            map_put(opts7, "crate_type", "cdylib")
            map_put(opts7, "lib_path", "lib.rs")
            _add_path_dep(opts7, "jni", "../../../libs/rust/registry/vendor/jni")
            toml7 = cargo_toml_content(opts7)
            spec.assert_contains(toml7, "name = \"vowelbase\"", "combo name")
            spec.assert_contains(toml7, "edition = \"2021\"", "combo edition")
            spec.assert_contains(toml7, "path = \"lib.rs\"", "combo lib path")
            spec.assert_contains(toml7, "crate-type = [\"cdylib\"]", "combo crate-type")
            spec.assert_contains(toml7, "jni = { path = \"../../../libs/rust/registry/vendor/jni\" }", "combo jni path dep")
        }

        spec.it("mixed dep types") callback {
            opts8 = map_new()
            map_put(opts8, "crate_name", "oxen")
            _add_dep(opts8, "log", "0.4")
            _add_dep_features(opts8, "serde", "1.0", "derive")
            _add_path_dep(opts8, "liboxen", "../crates/lib")
            toml8 = cargo_toml_content(opts8)
            spec.assert_contains(toml8, "log = \"0.4\"", "mixed: log")
            spec.assert_contains(toml8, "serde = { version = \"1.0\", features = [\"derive\"] }", "mixed: serde features")
            spec.assert_contains(toml8, "liboxen = { path = \"../crates/lib\" }", "mixed: path dep")
        }
    }

    return spec.run_summary(fw)
}
