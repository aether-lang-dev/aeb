// Tests for junit_cmd()
import std.spec
import std.map
import bldr
import java (junit_cmd)

main() {
    fw = spec.init()

    // Host-specific dynamic-library env var (DYLD_LIBRARY_PATH on macOS,
    // LD_LIBRARY_PATH on Linux) — junit_cmd emits bldr._dyld_env_var();
    // mirror it so the expectation holds on both platforms.
    dyld = bldr._dyld_env_var()

    spec.describe(fw, "junit_cmd") {
        spec.it("no-config no-ldpath") callback {
            spec.assert_str_eq(
                junit_cmd("classes:deps.jar", "com.example.FooTests", "", null),
                "java -cp classes:deps.jar org.junit.runner.JUnitCore com.example.FooTests", "no-config no-ldpath")
        }

        spec.it("with ld_path") callback {
            spec.assert_str_eq(
                junit_cmd("classes", "com.example.FooTests", "/lib/native", null),
                "${dyld}=/lib/native java -Djava.library.path=/lib/native -cp classes org.junit.runner.JUnitCore com.example.FooTests", "with ld_path")
        }

        spec.it("jvm_args") callback {
            opts3 = map_new()
            map_put(opts3, "jvm_args", "-Xmx2g -ea")
            spec.assert_str_eq(
                junit_cmd("classes", "com.example.FooTests", "", opts3),
                "java -Xmx2g -ea -cp classes org.junit.runner.JUnitCore com.example.FooTests", "jvm_args")
        }

        spec.it("ld_path+jvm_args+extra") callback {
            opts4 = map_new()
            map_put(opts4, "jvm_args", "-Xmx4g")
            map_put(opts4, "extra", "-Dtest.env=ci")
            spec.assert_str_eq(
                junit_cmd("cp", "Tests", "/lib", opts4),
                "${dyld}=/lib java -Djava.library.path=/lib -Xmx4g -Dtest.env=ci -cp cp org.junit.runner.JUnitCore Tests", "ld_path+jvm_args+extra")
        }
    }

    return spec.run_summary(fw)
}
