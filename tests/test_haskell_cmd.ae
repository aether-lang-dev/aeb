// Tests for lib/haskell's pure surface. haskell had no test file; these
// cover the two pure helpers behind the link_dir()/target() setters added
// so a cabal package can link against a C lib (the selenium engine .so):
//   _hs_lib_flags   — per link_dir(): --extra-lib-dirs + -rpath ghc-option
//   _hs_target_suffix — target(): " <t>" or ""
import std.spec
import std.map
import haskell (link_dir, target, _hs_lib_flags, _hs_target_suffix)

main() {
    fw = spec.init()

    spec.describe(fw, "_hs_lib_flags") {
        // --- null / no link_dir() → empty.
        spec.it("null bmap → empty") callback {
            spec.assert_str_eq(_hs_lib_flags(null), "", "_hs_lib_flags null bmap → empty")
        }
        spec.it("no link_dir → empty") callback {
            b0 = map.new()
            spec.assert_str_eq(_hs_lib_flags(b0), "", "_hs_lib_flags no link_dir → empty")
        }

        // --- one link_dir → --extra-lib-dirs + rpath ghc-option.
        spec.it("one dir") callback {
            b1 = map.new()
            link_dir(b1, "/proj/target/build/engine/lib")
            spec.assert_str_eq(
                _hs_lib_flags(b1),
                " --extra-lib-dirs='/proj/target/build/engine/lib' --ghc-options=-optl-Wl,-rpath,'/proj/target/build/engine/lib'", "_hs_lib_flags one dir")
        }

        // --- link_dir accumulates; flags emitted per dir in order.
        spec.it("two dirs, order preserved") callback {
            b2 = map.new()
            link_dir(b2, "/a")
            link_dir(b2, "/b")
            spec.assert_str_eq(
                _hs_lib_flags(b2),
                " --extra-lib-dirs='/a' --ghc-options=-optl-Wl,-rpath,'/a' --extra-lib-dirs='/b' --ghc-options=-optl-Wl,-rpath,'/b'", "_hs_lib_flags two dirs, order preserved")
        }
    }

    spec.describe(fw, "_hs_target_suffix") {
        // --- unset → empty; set → " <t>".
        spec.it("null bmap → empty") callback {
            spec.assert_str_eq(_hs_target_suffix(null), "", "_hs_target_suffix null bmap → empty")
        }
        spec.it("unset → empty") callback {
            bt0 = map.new()
            spec.assert_str_eq(_hs_target_suffix(bt0), "", "_hs_target_suffix unset → empty")
        }
        spec.it("set → ' <target>'") callback {
            bt = map.new()
            target(bt, "test:live")
            spec.assert_str_eq(_hs_target_suffix(bt), " test:live", "_hs_target_suffix set → ' <target>'")
        }
    }

    spec.describe(fw, "setter storage") {
        // --- setter storage sanity: link_dir list + target scalar keys.
        spec.it("link_dir stored under hs_link_dirs") callback {
            b1 = map.new()
            link_dir(b1, "/proj/target/build/engine/lib")
            spec.assert_true(map.has(b1, "hs_link_dirs"), "link_dir stored under hs_link_dirs")
        }
        spec.it("target stored under hs_target") callback {
            bt = map.new()
            target(bt, "test:live")
            spec.assert_true(map.has(bt, "hs_target"), "target stored under hs_target")
        }
    }

    return spec.run_summary(fw)
}
