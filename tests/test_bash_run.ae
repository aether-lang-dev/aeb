// Regression test: the bash SDK builders actually DISPATCH and run
// their bodies.
//
// `bash.script` (the builder) silently never ran for a long time —
// its name collided with the `script(...)` setter in the same
// module, and Aether's builder name-resolution miscompiled the
// dispatch (see lib/bash/module.ae and asks/ for the Aether bug).
// It went unnoticed because every other test here only exercises
// pure `*_cmd` string-builders — nothing invoked a real builder
// through the closure-DSL form. This test closes that gap.
//
// It drives `bash.run(b) { ... }` and `bash.test(b) { ... }` the
// way the orchestrator does (bldr.session → bldr.begin → builder)
// and asserts a side effect: the declared script actually executed.
// If a builder stops dispatching — a renamed-into-a-collision
// builder, a codegen regression — the marker file is absent and
// this fails loudly.

import bldr
import bldr (_sh, _sh_capture)
import bash
import bash (script)
import std.string
import std.os
import std.file

extern println(s: string)

_assert(label: string, cond: int) {
    if cond == 1 {
        println("PASS: ${label}")
    } else {
        println("FAIL: ${label}")
    }
}

// Native-form tmpdir via the _sh chokepoint. On Windows the raw
// os.system("mkdir -p ...") routes through cmd.exe (which cannot run POSIX
// mkdir/printf), so the fixture would never be created and file.exists would
// see nothing. Route setup through _sh, which writes a temp .sh and runs it
// under a real shell. cygpath -m gives the native form std.file needs.
_mktempdir() {
    raw, _err = _sh_capture("mktemp -d")
    d = string.trim(raw)
    nat, _nerr = _sh_capture("cygpath -m ${d}")
    n = string.trim(nat)
    if string.length(n) > 0 { return n }
    return d
}

main() {
    base = _mktempdir()
    _sh("rm -rf '${base}'; mkdir -p '${base}'")

    marker = "${base}/marker"
    scr = "${base}/probe.sh"
    // probe.sh just touches the marker — an absolute path, so
    // bash's _resolve_script_path uses it verbatim.
    _sh("printf 'touch ${marker}\\n' > '${scr}'")

    // --- bash.run dispatches (Shape A: bldr.build(s,label){ bash.run(){…} }) ---
    _sh("rm -f '${marker}'")
    s1 = bldr.session(".")
    bldr.build(s1, "m_run") {
        bash.run() {
            script("${scr}")
        }
    }
    _assert("bash.run dispatched and ran its script", file.exists(marker))

    // --- bash.test dispatches ---
    _sh("rm -f '${marker}'")
    s2 = bldr.session(".")
    bldr.build(s2, "m_test") {
        bash.test() {
            script("${scr}")
        }
    }
    _assert("bash.test dispatched and ran its script", file.exists(marker))

    _sh("rm -rf '${base}'")
    println("bash builder dispatch tests done")
}
