// Tests for lib/cpp's pure command-string builders.

import std.spec
import cpp (cxx_compile_cmd, cxx_compile_cmd_objs, _std_flag, _join_flagged, _join_raw)
import std.list

main() {
    fw = spec.init()

    spec.describe(fw, "_std_flag") {
        spec.it("std flag empty") callback {
            spec.assert_str_eq(_std_flag(""), "", "std flag empty")
        }
        spec.it("std flag c++20") callback {
            spec.assert_str_eq(_std_flag("c++20"), " -std=c++20", "std flag c++20")
        }
    }

    spec.describe(fw, "_join_flagged: -I over include dirs") {
        spec.it("two dirs") callback {
            incs = list.new()
            list.add(incs, "include")
            list.add(incs, "src")
            spec.assert_str_eq(_join_flagged("-I", incs), " -I'include' -I'src'", "join_flagged -I two dirs")
        }
        spec.it("null → ''") callback {
            spec.assert_str_eq(_join_flagged("-I", null), "", "join_flagged null → ''")
        }
    }

    spec.describe(fw, "_join_raw: quoted source/flag segments") {
        spec.it("two sources") callback {
            srcs = list.new()
            list.add(srcs, "src/main.cpp")
            list.add(srcs, "src/util.cpp")
            spec.assert_str_eq(_join_raw(srcs), " 'src/main.cpp' 'src/util.cpp'", "join_raw two sources")
        }
        spec.it("null → ''") callback {
            spec.assert_str_eq(_join_raw(null), "", "join_raw null → ''")
        }
    }

    spec.describe(fw, "cxx_compile_cmd") {
        // --- the whole line, minimal.
        spec.it("compile minimal") callback {
            s1 = list.new()
            list.add(s1, "main.cpp")
            spec.assert_str_eq(
                cxx_compile_cmd("c++", "/proj", "", s1, null, null, null, "/proj/target/cpp/app"),
                "cd '/proj' && 'c++' 'main.cpp' -o '/proj/target/cpp/app'", "compile minimal")
        }

        // --- full — std, includes, cxxflags, link flags.
        spec.it("compile full") callback {
            s2 = list.new()
            list.add(s2, "src/a.cpp")
            list.add(s2, "src/b.cpp")
            inc2 = list.new()
            list.add(inc2, "include")
            fl2 = list.new()
            list.add(fl2, "-O2")
            list.add(fl2, "-Wall")
            lk2 = list.new()
            list.add(lk2, "-lpthread")
            spec.assert_str_eq(
                cxx_compile_cmd("clang++", "/proj", " -std=c++20", s2, inc2, fl2, lk2, "/out/app"),
                "cd '/proj' && 'clang++' -std=c++20 -I'include' '-O2' '-Wall' 'src/a.cpp' 'src/b.cpp' '-lpthread' -o '/out/app'",
                "compile full")
        }

        // --- custom compiler + spaces in output path are quoted.
        spec.it("output path with spaces quoted") callback {
            s3 = list.new()
            list.add(s3, "m.cpp")
            spec.assert_str_eq(
                cxx_compile_cmd("g++", "/proj", "", s3, null, null, null, "/out dir/app"),
                "cd '/proj' && 'g++' 'm.cpp' -o '/out dir/app'", "output path with spaces quoted")
        }

        // --- dep C objects spliced in (a C++ target linking a C dependency's
        //     pre-compiled objects, e.g. cpp/ wrapping the C client's selenium.c
        //     compiled AS C so its extern "C" symbols aren't C++-mangled).
        spec.it("dep objects spliced before link flags") callback {
            s4 = list.new()
            list.add(s4, "test/t.cpp")
            lk4 = list.new()
            list.add(lk4, "/abs/libselenium_core.so")
            spec.assert_str_eq(
                cxx_compile_cmd_objs("g++", "/proj", " -std=c++17", s4, null, null, lk4,
                    " /proj/target/obj/selenium.o", "/out/app"),
                "cd '/proj' && 'g++' -std=c++17 'test/t.cpp' /proj/target/obj/selenium.o '/abs/libselenium_core.so' -o '/out/app'",
                "dep objects appear after sources, before link flags")
        }

        // --- empty dep_objs reduces to the plain form.
        spec.it("empty dep objects == plain compile") callback {
            s5 = list.new()
            list.add(s5, "m.cpp")
            spec.assert_str_eq(
                cxx_compile_cmd_objs("c++", "/proj", "", s5, null, null, null, "", "/out/app"),
                cxx_compile_cmd("c++", "/proj", "", s5, null, null, null, "/out/app"),
                "empty dep_objs equals plain cxx_compile_cmd")
        }

        // --- multiple dep objects: the pre-joined fragment (leading space +
        //     space-separated) splices verbatim between sources and link flags.
        //     Same call the program AND tests builders make via _collect_dep_objects.
        spec.it("multiple dep objects splice verbatim") callback {
            s6 = list.new()
            list.add(s6, "app.cpp")
            spec.assert_str_eq(
                cxx_compile_cmd_objs("g++", "/proj", "", s6, null, null, null,
                    " /proj/target/obj/a.o /proj/target/obj/b.o", "/out/app"),
                "cd '/proj' && 'g++' 'app.cpp' /proj/target/obj/a.o /proj/target/obj/b.o -o '/out/app'",
                "two dep objects appear in order after sources")
        }
    }

    return spec.run_summary(fw)
}
