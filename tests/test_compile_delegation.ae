// Tests for the compile-delegation pure builders (docs/design/two-aeb-duality.md):
// _rewrite_under_root (host path → container /work) and
// _ae_build_cmd_delegated (wrap `ae build …` in a podman run against the
// toolchain image). Pure string assembly — no I/O, no container needed.
import std.spec
import aether (_rewrite_under_root, _ae_build_cmd_delegated)

main() {
    fw = spec.init()

    // _rewrite_under_root: map a host-absolute path under root to /work.
    spec.describe(fw, "_rewrite_under_root") {
        spec.it("source under root") callback {
            spec.assert_str_eq(
                _rewrite_under_root("/home/u/repo/greeter/greeter_main.ae", "/home/u/repo", "/work"),
                "/work/greeter/greeter_main.ae", "rewrite source under root")
        }
        spec.it("target/ artifact under root") callback {
            spec.assert_str_eq(
                _rewrite_under_root("/home/u/repo/target/build/greeter/bin/program", "/home/u/repo", "/work"),
                "/work/target/build/greeter/bin/program", "rewrite target/ artifact under root")
        }
        spec.it("root itself") callback {
            spec.assert_str_eq(
                _rewrite_under_root("/home/u/repo", "/home/u/repo", "/work"),
                "/work", "rewrite root itself")
        }
        spec.it("path NOT under root passes through unchanged") callback {
            spec.assert_str_eq(
                _rewrite_under_root("/etc/passwd", "/home/u/repo", "/work"),
                "/etc/passwd", "path NOT under root passes through unchanged")
        }
    }

    // _ae_build_cmd_delegated: the podman run wrapper (default engine/selabel).
    spec.describe(fw, "_ae_build_cmd_delegated") {
        // Empty workdir → -w /work (repo root), the default.
        spec.it("default workdir") callback {
            spec.assert_str_eq(
                _ae_build_cmd_delegated("build /work/g/g.ae -o /work/target/build/g/bin/program",
                                        "/home/u/repo", "aeb-toolchain:slim", ""),
                "podman run --rm -v /home/u/repo:/work:Z -w /work --entrypoint ae aeb-toolchain:slim build /work/g/g.ae -o /work/target/build/g/bin/program",
                "delegated podman command (default workdir)")
        }
        // explicit module workdir → -w that dir (so ae finds the module's aether.toml).
        spec.it("module workdir") callback {
            spec.assert_str_eq(
                _ae_build_cmd_delegated("build /work/g/g.ae -o /work/target/build/g/bin/program",
                                        "/home/u/repo", "aeb-toolchain:slim", "/work/g"),
                "podman run --rm -v /home/u/repo:/work:Z -w /work/g --entrypoint ae aeb-toolchain:slim build /work/g/g.ae -o /work/target/build/g/bin/program",
                "delegated podman command (module workdir)")
        }
    }

    return spec.run_summary(fw)
}
