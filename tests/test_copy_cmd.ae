// Tests for lib/copy's pure command builders AND closure-DSL
// setters. Same shape as the other SDK test files.
//
// Three surfaces:
//
//   1. Pure `*_cmd` helpers (cp_file_cmd, cp_tree_cmd) —
//      string-equality assertions on the cp invocation aeb constructs.
//
//   2. Pure path-resolution (_resolve_path) — relative joins
//      source_dir; absolute pass-through; empty pass-through.
//
//   3. Grammar setters (from, to) — scalar last-call-wins,
//      stored under canonical keys.

import std.spec
import copy (cp_file_cmd, cp_tree_cmd, _resolve_path,
             from, to)
import std.map

_str_at(m: ptr, k: string) {
    if map.has(m, k) == 0 { return "" }
    v, _ = map.get(m, k)
    return v
}

main() {
    fw = spec.init()

    // === Pure command-builder tests ====================================

    spec.describe(fw, "cp_file_cmd / cp_tree_cmd") {
        spec.it("cp_file_cmd basic") callback {
            spec.assert_str_eq(
                cp_file_cmd("/proj/LICENSE", "/proj/rb/LICENSE"),
                "cp -f '/proj/LICENSE' '/proj/rb/LICENSE'", "cp_file_cmd basic")
        }
        spec.it("cp_file_cmd spaces in src") callback {
            spec.assert_str_eq(
                cp_file_cmd("/path with space/LICENSE", "/dst/LICENSE"),
                "cp -f '/path with space/LICENSE' '/dst/LICENSE'", "cp_file_cmd spaces in src")
        }
        spec.it("cp_file_cmd spaces in dst") callback {
            spec.assert_str_eq(
                cp_file_cmd("/proj/LICENSE", "/dst with space/LICENSE"),
                "cp -f '/proj/LICENSE' '/dst with space/LICENSE'", "cp_file_cmd spaces in dst")
        }
        spec.it("cp_tree_cmd basic") callback {
            spec.assert_str_eq(
                cp_tree_cmd("/proj/common/manager", "/proj/rb/bin"),
                "cp -rf '/proj/common/manager' '/proj/rb/bin'", "cp_tree_cmd basic")
        }
        spec.it("cp_tree_cmd spaces in src") callback {
            spec.assert_str_eq(
                cp_tree_cmd("/path with space/src", "/dst"),
                "cp -rf '/path with space/src' '/dst'", "cp_tree_cmd spaces in src")
        }
        spec.it("cp_tree_cmd spaces in dst") callback {
            spec.assert_str_eq(
                cp_tree_cmd("/proj/src", "/dst with space/out"),
                "cp -rf '/proj/src' '/dst with space/out'", "cp_tree_cmd spaces in dst")
        }
    }

    // === Pure path-resolution tests ====================================

    spec.describe(fw, "_resolve_path") {
        spec.it("empty passes through") callback {
            spec.assert_str_eq(_resolve_path("/proj/rb", ""), "", "_resolve_path empty passes through")
        }
        spec.it("absolute passes through") callback {
            spec.assert_str_eq(_resolve_path("/proj/rb", "/abs/LICENSE"), "/abs/LICENSE", "_resolve_path absolute passes through")
        }
        spec.it("bare-relative joins source_dir") callback {
            spec.assert_str_eq(_resolve_path("/proj/rb", "LICENSE"), "/proj/rb/LICENSE", "_resolve_path bare-relative joins source_dir")
        }
        spec.it("with ../ joins source_dir") callback {
            spec.assert_str_eq(_resolve_path("/proj/rb", "../LICENSE"), "/proj/rb/../LICENSE", "_resolve_path with ../ joins source_dir")
        }
        spec.it("nested-relative") callback {
            spec.assert_str_eq(_resolve_path("/proj/rb", "bin/linux/selenium-manager"),
                "/proj/rb/bin/linux/selenium-manager", "_resolve_path nested-relative")
        }
    }

    // === Setter accumulation tests =====================================

    spec.describe(fw, "from / to setters") {
        // --- Both setters required for copy.file / copy.tree.
        spec.it("from + to stored as scalars") callback {
            bm = map.new()
            from(bm, "../LICENSE")
            to(bm, "LICENSE")
            spec.assert_str_eq(_str_at(bm, "copy_from"), "../LICENSE", "from stored as scalar")
            spec.assert_str_eq(_str_at(bm, "copy_to"), "LICENSE", "to stored as scalar")
        }

        // --- Scalar last-call-wins (one src per builder block).
        spec.it("last-call-wins") callback {
            bm2 = map.new()
            from(bm2, "first.txt")
            from(bm2, "second.txt")
            to(bm2, "out_a.txt")
            to(bm2, "out_b.txt")
            spec.assert_str_eq(_str_at(bm2, "copy_from"), "second.txt", "from last-call-wins")
            spec.assert_str_eq(_str_at(bm2, "copy_to"), "out_b.txt", "to last-call-wins")
        }

        // --- Untouched map: both keys absent.
        spec.it("untouched map has empty keys") callback {
            bm3 = map.new()
            spec.assert_str_eq(_str_at(bm3, "copy_from"), "", "untouched map has empty copy_from")
            spec.assert_str_eq(_str_at(bm3, "copy_to"), "", "untouched map has empty copy_to")
        }
    }

    spec.run_summary(fw)
}
