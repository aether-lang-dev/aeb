import std.string
import std.io
import std.os
import std.file
import std.fs
import std.list
import std.map
import std.path
import std.dir

import aeblabel (encode_name)

// Tests for encode_name — converts file paths to C-safe function names
// Mirrors the bash: / → _    _ → __   - → _H_   . → _D_

// string_concat/length/contains/trim are now supplied by std.string; os_exec
// became a Go-style (output, err) wrapper, so the single-string extern is
// os_exec_raw. No local extern redeclarations needed.

// TESTS THE REAL IMPLEMENTATION (aeblabel.encode_name), imported below.
//
// It used to define its OWN sed-based encode_name right here and assert
// against that — a fourth copy testing itself. It would have passed with
// the shipped implementation deleted, and it could not have caught drift
// between the (then three) inlined copies, which is exactly what it looked
// like it was for.
//
// The sed version is also not portable: `printf | sed` returns empty under
// cmd.exe, which is why the shipped code is pure string ops.

_assert_eq(label: string, actual: string, expected: string) {
    if actual == expected {
        println("PASS: ${label}")
    } else {
        println("FAIL: ${label}")
        println("  expected: ${expected}")
        println("  actual:   ${actual}")
    }
}

main() {
    _assert_eq("simple dir",
        encode_name("java/components/nasal"),
        "java_components_nasal")

    _assert_eq("hyphen",
        encode_name("libs/cart/cart-page"),
        "libs_cart_cart_H_page")

    _assert_eq("build.ae",
        encode_name("common/.build.ae"),
        "common__D_build_D_ae")

    _assert_eq("tests.ae",
        encode_name("javatests/apps/monorepos_rule/.tests.ae"),
        "javatests_apps_monorepos_rule__D_tests_D_ae")

    _assert_eq("dist.ae",
        encode_name("java/apps/monorepos_rule/.dist.ae"),
        "java_apps_monorepos_rule__D_dist_D_ae")

    _assert_eq("multi hyphen",
        encode_name("libs/shared/product-detail-page/.build.ae"),
        "libs_shared_product_H_detail_H_page__D_build_D_ae")

    _assert_eq("underscore preserved",
        encode_name("my_module/.build.ae"),
        "my_module__D_build_D_ae")

    _assert_eq("simple name",
        encode_name("common"),
        "common")

    // Root-level target: ".build.ae" (label ".") would encode to a
    // LEADING-underscore "_D_build_D_ae", which aetherc escapes to
    // "ae_D_build_D_ae" (0.516 reserved-namespace fix) — desyncing the
    // orchestrator extern from the definition and breaking the link with an
    // `undefined reference`. encode_name now mirrors that escape so the two
    // stay in sync. A subdir target ("foo/.build.ae") is letter-leading and is
    // untouched. Regression guard for the root-label link bug.
    _assert_eq("root-level .build.ae escapes leading underscore",
        encode_name(".build.ae"),
        "ae_D_build_D_ae")
    _assert_eq("root-level .tests.ae likewise",
        encode_name(".tests.ae"),
        "ae_D_tests_D_ae")
    _assert_eq("subdir target unaffected (letter-leading)",
        encode_name("foo/.build.ae"),
        "foo__D_build_D_ae")

    println("encode_name tests done")
}
