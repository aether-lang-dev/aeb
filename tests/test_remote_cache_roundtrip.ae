// End-to-end test for the shared (filesystem) remote cache: prove that
// an artifact PUT on one machine is restored by GET on a DIFFERENT
// machine (a fresh local store) via the shared remote — the whole point
// of a remote cache. Also covers the read/write mode gating.
//
// "Two machines" = two distinct $AEB_CACHE_DIR values pointing at one
// shared $AEB_REMOTE_CACHE_URL (a file:// root). os.setenv lets us flip
// the local store between calls in-process.
//
// Skips when cache.available() == 0.
import std.spec
import std.string
import std.os
import std.file
import std.fs
import std.list
import std.map
import std.path

import cache
import bldr (_sh, _sh_capture)

_eq0(v: int) { if v == 0 { return 1 } return 0 }
_eq_str(a: string, b: string) { if a == b { return 1 } return 0 }

_mktempdir() {
    // Native form on Windows. `mktemp -d` answers in the SHELL's vocabulary
    // ("/tmp/tmp.XXXX" under MSYS), but std.fs/std.dir/std.file are native
    // Win32 calls that cannot see MSYS paths — dir.exists("/tmp/tmp.X") is 0
    // while dir.exists("C:/msys64/tmp/tmp.X") is 1. Without this the suite
    // fails on Windows for an environment reason, not a real defect.
    // No-op off Windows: cygpath is absent, so the value passes through.
    raw, _err = _sh_capture("mktemp -d")
    d = string.trim(raw)
    // _sh_capture routes through a real POSIX shell on Windows (temp .sh +
    // `sh <file>`), so mktemp/cygpath run correctly instead of via cmd.exe.
    nat, _nerr = _sh_capture("cygpath -m ${d}")
    n = string.trim(nat)
    if string.length(n) > 0 { return n }
    return d
}

// Sharded blob path the cache uses under a root (mirrors cache.path /
// _remote_fs_path) so the test can assert presence in the remote store.
_sharded(root: string, key: string) {
    return path.join(path.join(root, string.substring(key, 0, 2)), string.substring(key, 2, string.length(key)))
}

_use_local(d: string)  { _e = os.setenv("AEB_CACHE_DIR", d) }
_remote_on(url: string, mode: string) {
    _e1 = os.setenv("AEB_REMOTE_CACHE_URL", url)
    _e2 = os.setenv("AEB_REMOTE_CACHE_MODE", mode)
}
_remote_off() {
    _e = os.unsetenv("AEB_REMOTE_CACHE_URL")
    _e2 = os.unsetenv("AEB_REMOTE_CACHE_MODE")
}

main() {
    fw = spec.init()

    spec.describe(fw, "shared remote cache round-trip") {
        spec.it("PUT on machine A restored by GET on machine B; mode gating") callback {
            if cache.available() == 0 {
                println("SKIP: cache.available() == 0 (no OpenSSL or zlib)")
                return 0
            }

            tmp = _mktempdir()
            remote = path.join(tmp, "remote"); fs.mkdir_p(remote)
            localA = path.join(tmp, "localA"); fs.mkdir_p(localA)
            localB = path.join(tmp, "localB"); fs.mkdir_p(localB)
            localC = path.join(tmp, "localC"); fs.mkdir_p(localC)
            remote_url = string.concat("file://", remote)

            // A binary artifact (NULs + high bytes) so we also prove binary-safe
            // transfer through the remote store.
            artifact = path.join(tmp, "artifact.bin")
            _sh("head -c 96 /dev/urandom > '${artifact}'")
            parts = list.new()
            list.add(parts, "remote-roundtrip")
            list.add(parts, artifact)
            key, _ke = cache.hash_inputs(parts)

            // === Machine A (CI runner): write-through to the shared remote. ===
            _use_local(localA)
            _remote_on(remote_url, "readwrite")
            perr = cache.put(key, artifact)
            spec.assert_true(_eq_str(perr, ""), "A: put ok")
            spec.assert_true(file.exists(_sharded(remote, key)), "A: blob present in shared remote")

            // === Machine B (developer): FRESH local store, read-only. The blob
            // was never built here — it must come from the shared remote. ===
            _use_local(localB)
            _remote_on(remote_url, "read")
            spec.assert_true(cache.has(key), "B: has() sees remote on local miss")
            dest = path.join(tmp, "restored.bin")
            gerr = cache.get(key, dest)
            spec.assert_true(_eq_str(gerr, ""), "B: get ok (served via remote)")
            spec.assert_true(_eq0(_sh("cmp -s '${artifact}' '${dest}'")),
                "B: restored artifact byte-identical to original")
            spec.assert_true(file.exists(_sharded(localB, key)),
                "B: remote pull populated the LOCAL store")

            // === Machine C: remote OFF -> a local miss stays a miss. ===
            _use_local(localC)
            _remote_off()
            gmiss = cache.get(key, path.join(tmp, "nope.bin"))
            spec.assert_true(_eq_str(gmiss, "miss"), "C: remote off -> local miss is a real miss")

            // === Write gating: read-only mode must NOT upload a new key. ===
            _use_local(localC)
            _remote_on(remote_url, "read")
            art2 = path.join(tmp, "artifact2.bin")
            _sh("head -c 32 /dev/urandom > '${art2}'")
            p2 = list.new(); list.add(p2, "remote-roundtrip-2"); list.add(p2, art2)
            key2, _k2 = cache.hash_inputs(p2)
            _p2err = cache.put(key2, art2)
            spec.assert_true(_eq0(file.exists(_sharded(remote, key2))),
                "write-gating: read mode did NOT push key2 to remote")

            _remote_off()
            _sh("rm -rf '${tmp}'")
        }
    }

    return spec.run_summary(fw)
}
