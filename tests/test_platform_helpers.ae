// Tests for lib/build's host-OS detection helpers — the portable foundation
// every per-OS feature-gate reads (macOS link flags, the Windows cut-down
// runner, the JVM classpath separator). Asserts cross-platform INVARIANTS
// rather than hardcoding "linux", so the suite stays valid on whatever host
// runs it (Linux dev box, macOS, a future Windows CI) while still catching a
// broken predicate. See TODO.md § "Windows support (cut-down runner)".
//
// NB: the _is_* predicates are compared with the `== 1` idiom throughout (not
// arithmetic) — their cross-module return type isn't inferred as int, so `+`
// is rejected but `== 1` typechecks (the same idiom every SDK uses on them).

import std.spec
import bldr (_host_os, _is_linux, _is_windows, _is_macos, _is_freebsd, _path_sep, _cp_append, _exe_suffix, _default_cc, _has_windows_drive_prefix, _is_abs_path)
import std.string

main() {
    fw = spec.init()

    spec.describe(fw, "_host_os + _is_* predicates") {
        // --- The normalised token is one of the known values ---
        spec.it("_host_os() returns a known token") callback {
            os = _host_os()
            known = 0
            if string.equals(os, "linux") == 1 { known = 1 }
            if string.equals(os, "macos") == 1 { known = 1 }
            if string.equals(os, "windows") == 1 { known = 1 }
            if string.equals(os, "freebsd") == 1 { known = 1 }
            spec.assert_true(known, "_host_os() returns a known token")
        }

        // --- Exactly one _is_* predicate fires, and it matches the token ---
        spec.it("exactly one _is_* predicate is true, agreeing with the token") callback {
            os = _host_os()
            n = 0
            if _is_linux()   == 1 { n = n + 1 }
            if _is_macos()   == 1 { n = n + 1 }
            if _is_windows() == 1 { n = n + 1 }
            if _is_freebsd() == 1 { n = n + 1 }
            spec.assert_true(_is_one(n), "exactly one _is_* predicate is true")
            spec.assert_true(_agree(_is_linux(),   os, "linux"),   "_is_linux() agrees with token")
            spec.assert_true(_agree(_is_macos(),   os, "macos"),   "_is_macos() agrees with token")
            spec.assert_true(_agree(_is_windows(), os, "windows"), "_is_windows() agrees with token")
            spec.assert_true(_agree(_is_freebsd(), os, "freebsd"), "_is_freebsd() agrees with token")
        }
    }

    spec.describe(fw, "per-OS scalars") {
        // --- _path_sep(): ';' iff Windows, ':' otherwise ---
        spec.it("_path_sep(): ';' on Windows, ':' otherwise") callback {
            if _is_windows() == 1 { spec.assert_str_eq(_path_sep(), ";", "_path_sep() is ';' on Windows") }
            else { spec.assert_str_eq(_path_sep(), ":", "_path_sep() is ':' off Windows") }
        }
        // --- _exe_suffix(): '.exe' iff Windows, '' otherwise ---
        spec.it("_exe_suffix(): '.exe' on Windows, '' otherwise") callback {
            if _is_windows() == 1 { spec.assert_str_eq(_exe_suffix(), ".exe", "_exe_suffix() is '.exe' on Windows") }
            else { spec.assert_str_eq(_exe_suffix(), "", "_exe_suffix() is '' off Windows") }
        }
        // --- _default_cc(): clang-as-cc on macOS/FreeBSD, gcc elsewhere ---
        spec.it("_default_cc(): 'cc' on macOS/FreeBSD, 'gcc' on Linux") callback {
            cc = _default_cc()
            if _is_macos() == 1 { spec.assert_str_eq(cc, "cc", "_default_cc() is 'cc' on macOS") }
            if _is_freebsd() == 1 { spec.assert_str_eq(cc, "cc", "_default_cc() is 'cc' on FreeBSD") }
            if _is_linux() == 1 { spec.assert_str_eq(cc, "gcc", "_default_cc() is 'gcc' on Linux") }
        }
    }

    // --- _has_windows_drive_prefix(): the Prefix::Disk rule (host-independent,
    //     it's pure string analysis — runs the same on every platform) ---
    spec.describe(fw, "_has_windows_drive_prefix") {
        spec.it("the Prefix::Disk rule (pure string analysis)") callback {
            spec.assert_true(_has_windows_drive_prefix("C:"),         "'C:' (bare cwd-relative drive)")
            spec.assert_true(_has_windows_drive_prefix("C:\\src"),    "'C:\\src' (backslash)")
            spec.assert_true(_has_windows_drive_prefix("d:/tmp"),     "'d:/tmp' (lower-case, fwd slash)")
            spec.assert_false(_has_windows_drive_prefix("java/foo:bar"), "'java/foo:bar' (target synonym)")
            spec.assert_false(_has_windows_drive_prefix(":name"),       "':name' (bare synonym, no path)")
            spec.assert_false(_has_windows_drive_prefix("C:name"),      "'C:name' (letter+colon+non-sep)")
            spec.assert_false(_has_windows_drive_prefix("/abs/posix"),  "'/abs/posix' (posix absolute)")
            spec.assert_false(_has_windows_drive_prefix("12:34"),       "'12:34' (digit, not a letter)")
            spec.assert_false(_has_windows_drive_prefix(""),            "'' (empty)")
        }
    }

    // --- _is_abs_path(): the canonical host-aware "is this absolute?" the SDKs
    //     use to decide resolve-against-source_dir vs pass-through. Pure string
    //     analysis — same on every host. Both POSIX '/' AND Windows drive/UNC
    //     must read as absolute; a Windows abs path is 'C:/..', never '/..', so
    //     a bare leading-slash test (what these sites used before) would mangle
    //     it into '<dir>/C:/..'. This is the regression guard for that class. ---
    spec.describe(fw, "_is_abs_path") {
        spec.it("POSIX '/' and Windows drive/UNC both read as absolute") callback {
            spec.assert_true(_is_abs_path("/abs/posix"),         "'/abs/posix' is absolute")
            spec.assert_true(_is_abs_path("C:/Users/x"),         "'C:/Users/x' (drive, fwd slash)")
            spec.assert_true(_is_abs_path("C:\\Users\\x"),       "'C:\\Users\\x' (drive, backslash)")
            spec.assert_true(_is_abs_path("d:/tmp"),             "'d:/tmp' (lower-case drive)")
            spec.assert_true(_is_abs_path("C:"),                 "'C:' (bare cwd-relative drive)")
            spec.assert_true(_is_abs_path("\\\\host\\share"),    "'\\\\host\\share' (UNC)")
            spec.assert_false(_is_abs_path("rel/path"),          "'rel/path' (bare relative)")
            spec.assert_false(_is_abs_path("a.cp"),              "'a.cp' (bare filename)")
            spec.assert_false(_is_abs_path("./rel"),             "'./rel' (dot-relative)")
            spec.assert_false(_is_abs_path(""),                  "'' (empty)")
        }
    }

    // --- _cp_append(): conditional classpath join with the host separator.
    //     Expectations built from _path_sep() so the test holds on every host.
    spec.describe(fw, "_cp_append") {
        spec.it("conditional classpath join with the host separator") callback {
            sep = _path_sep()
            spec.assert_str_eq(_cp_append("", "a.jar"), "a.jar", "_cp_append into empty cp = part")
            spec.assert_str_eq(_cp_append("out", ""), "out", "_cp_append empty part = cp")
            spec.assert_str_eq(_cp_append("", ""), "", "_cp_append empty + empty = empty")
            spec.assert_str_eq(_cp_append("out", "a.jar"),
                string.concat("out", string.concat(sep, "a.jar")),
                "_cp_append joins with host sep")
            spec.assert_str_eq(_cp_append(_cp_append("out", "a.jar"), "b.jar"),
                string.concat("out", string.concat(sep, string.concat("a.jar", string.concat(sep, "b.jar")))),
                "_cp_append chains (sep between each)")
        }
    }

    spec.run_summary(fw)
}

_is_one(n: int) {
    if n == 1 { return 1 }
    return 0
}

// 1 if predicate-fired (`pred == 1`) matches "token equals want", else 0.
// Both sides reduced to 0/1 so the agreement is a plain equality.
_agree(pred: int, os: string, want: string) {
    fired = 0
    if pred == 1 { fired = 1 }
    expect = 0
    if string.equals(os, want) == 1 { expect = 1 }
    if fired == expect { return 1 }
    return 0
}
