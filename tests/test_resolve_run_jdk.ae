// Unit tests for build._resolve_run_jdk — the require-vs-skip JDK gate shared by
// the JVM run builders (java_main / kotlin_test / scalac_test / clojure.run_main).
//
// Two author intents, two outcomes:
//   min_jdk(N)         HARD REQUIREMENT — unmet is a misconfiguration -> "fail"
//   skip_below_jdk(N)  PORTABLE FLEET floor — unmet is half-expected  -> "skip"
// min_jdk wins if both are set; neither set -> ambient "java", "ok".
//
// The status is what the caller branches on (fail -> build.fail; skip -> the
// helper already recorded the skip; ok -> use the returned java path). We can't
// unit-test the JDK-present path deterministically (depends on the box), but the
// UNMET paths use an impossibly-high floor (999), which is "" on any box, so the
// require->fail / skip->skip decision is fully testable. Precedence and the
// no-floor case likewise.

import build (_resolve_run_jdk, _int_key)
import std.string
import std.map

extern println(s: string)

_assert(label: string, cond: int) {
    if cond == 1 { println("PASS: ${label}") }
    else { println("FAIL: ${label}") }
}

main() {
    // Fake ctx (a map is enough — _resolve_run_jdk only writes a skip marker via
    // _record_skip on the skip path, which tolerates a bare map).
    ctx = map.new()

    // --- no floor -> ambient java, ok ---
    j0, s0 = _resolve_run_jdk(ctx, "mod", 0, 0, "x")
    _assert("no floor -> status ok", string.equals(s0, "ok"))
    _assert("no floor -> ambient java", string.equals(j0, "java"))

    // --- unmet hard requirement (min 999) -> FAIL, no path ---
    j1, s1 = _resolve_run_jdk(ctx, "mod", 999, 0, "x")
    _assert("min 999 unmet -> status fail", string.equals(s1, "fail"))
    _assert("min 999 unmet -> empty path", string.length(j1) == 0)

    // --- unmet portable floor (skip 999) -> SKIP, no path ---
    j2, s2 = _resolve_run_jdk(ctx, "mod", 0, 999, "x")
    _assert("skip 999 unmet -> status skip", string.equals(s2, "skip"))
    _assert("skip 999 unmet -> empty path", string.length(j2) == 0)

    // --- precedence: min wins over skip when both unmet -> FAIL, not skip ---
    j3, s3 = _resolve_run_jdk(ctx, "mod", 999, 999, "x")
    _assert("both unmet -> min wins -> fail (not skip)", string.equals(s3, "fail"))

    // --- _int_key round-trips a stored min ---
    b = map.new()
    map.put(b, "k", "22")
    _assert("_int_key reads stored int", _int_key(b, "k") == 22)
    _assert("_int_key unset -> 0", _int_key(b, "nope") == 0)
    _assert("_int_key null bmap -> 0", _int_key(null, "k") == 0)

    println("resolve_run_jdk tests done")
}
