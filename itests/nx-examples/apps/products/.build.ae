import bldr
import bldr (dep, load_third_party_deps)
import angular
import angular (skip_lib_check, tsconfig)

main() {
    bldr.build() {
        load_third_party_deps("../../angular.deps.ae")
        dep("libs/products/home-page/.build.ae")
        dep("libs/products/product-detail-page/.build.ae")
        dep("libs/shared/header/.build.ae")
        dep("libs/shared/styles/.build.ae")
        angular.ngc() {
            tsconfig("tsconfig.app.json")
            skip_lib_check()
        }
    }
}
