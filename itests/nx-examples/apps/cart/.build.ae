import bldr
import bldr (dep, load_third_party_deps)
import ts
import ts (skip_lib_check, tsconfig)

main() {
    bldr.build() {
        load_third_party_deps("../../react.deps.ae")
        dep("libs/cart/cart-page/.build.ae")
        dep("libs/shared/header/.build.ae")
        dep("libs/shared/styles/.build.ae")
        ts.tsc() {
            tsconfig("tsconfig.app.json")
            skip_lib_check()
        }
    }
}
