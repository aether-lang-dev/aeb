import bldr
import bldr (dep, load_third_party_deps)
import ts
import ts (skip_lib_check)

main() {
    b = bldr.start()
    load_third_party_deps(b, "../../../react.deps.ae")
    dep(b, "libs/shared/cart/state/.build.ae")
    dep(b, "libs/shared/product/state/.build.ae")
    dep(b, "libs/shared/product/ui/.build.ae")
    ts.tsc(b) {
        skip_lib_check()
    }
}
