import bldr
import bldr (dep, load_third_party_deps)
import ts
import ts (skip_lib_check)

main() {
    bldr.build() {
        load_third_party_deps("../../../react.deps.ae")
        dep("libs/shared/cart/state/.build.ae")
        dep("libs/shared/product/state/.build.ae")
        dep("libs/shared/product/ui/.build.ae")
        ts.tsc() {
            skip_lib_check()
        }
    }
}
