import bldr
import bldr (dep, load_third_party_deps)
import angular
import angular (skip_lib_check)

main() {
    bldr.build() {
        load_third_party_deps("../../../angular.deps.ae")
        dep("libs/shared/product/state/.build.ae")
        dep("libs/shared/product/types/.build.ae")
        dep("libs/shared/product/ui/.build.ae")
        angular.ngc() {
            skip_lib_check()
        }
    }
}
