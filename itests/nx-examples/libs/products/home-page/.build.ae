import bldr
import bldr (dep, load_third_party_deps)
import angular
import angular (skip_lib_check)

main() {
    b = bldr.start()
    load_third_party_deps(b, "../../../angular.deps.ae")
    dep(b, "libs/shared/product/state/.build.ae")
    dep(b, "libs/shared/product/types/.build.ae")
    dep(b, "libs/shared/product/ui/.build.ae")
    angular.ngc(b) {
        skip_lib_check()
    }
}
