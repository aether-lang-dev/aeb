import bldr
import dotnet
import dotnet (root_namespace, assembly_name, nuget)

main() {
    bldr.build() {
        dotnet.build_project() {
            root_namespace("BlazorShared")
            assembly_name("BlazorShared")
            nuget("BlazorInputFile")
            nuget("FluentValidation")
        }
    }
}
