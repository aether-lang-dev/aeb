import bldr
import maven (load_bom_file)
import bldr (dep)
import clojure

main() {
    bldr.build() {
        load_bom_file("../clojars.bom.ae")
        load_bom_file("../clojure-dep-patches.bom.ae")
        dep("org.clojure:clojure:1.12.0")
        dep("ring:ring-core:1.12.2")
        dep("ring:ring-jetty-adapter:1.12.2")
        dep("ring-cors:ring-cors:0.1.13")
        dep("integrant:integrant:0.13.0")
        dep("aero:aero:1.1.6")
        dep("metosin:reitit-core:0.7.2")
        dep("metosin:reitit-ring:0.7.2")
        dep("metosin:reitit-middleware:0.7.2")
        dep("metosin:reitit-malli:0.7.2")
        dep("metosin:muuntaja:0.6.10")
        dep("metosin:muuntaja-form:0.6.10")
        dep("metosin:malli:0.16.4")
        dep("com.github.seancorfield:next.jdbc:1.3.939")
        dep("org.xerial:sqlite-jdbc:3.46.1.0")
        dep("com.zaxxer:HikariCP:6.0.0")
        dep("hiccup:hiccup:2.0.0-RC3")
        dep("buddy:buddy-auth:3.0.1")
        dep("clojure.java-time:clojure.java-time:1.4.2")
        dep("org.clojure:tools.logging:1.3.0")
        dep("org.slf4j:slf4j-simple:2.0.16")
        clojure.compile()
    }
}
