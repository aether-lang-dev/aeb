import bldr
import maven (load_bom_file)
import bldr (dep)
import clojure

main() {
    bldr.build() {
        load_bom_file("../../clojars.bom.ae")
        load_bom_file("../../clojure-dep-patches.bom.ae")
        dep("parts/.build.ae")
        dep("org.clojure:clojure:1.11.3")
        dep("ring:ring-jetty-adapter:1.12.1")
        dep("ring:ring:1.12.1")
        dep("ring:ring-defaults:0.5.0")
        dep("com.github.seancorfield:next.jdbc:1.3.939")
        dep("org.xerial:sqlite-jdbc:3.46.1.0")
        dep("hiccup:hiccup:2.0.0-RC3")
        clojure.compile()
    }
}
