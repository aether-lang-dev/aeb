import bldr
import maven (load_bom_file)
import bldr (dep)
import clojure

main() {
    bldr.build() {
        load_bom_file("../../clojars.bom.ae")
        load_bom_file("../../clojure-dep-patches.bom.ae")
        dep("projects/usermanager-first-principles/.build.ae")
        dep("org.clojure:clojure:1.11.3")
        dep("clj-http:clj-http:3.12.3")
        clojure.test()
    }
}
