import bldr
import maven (load_bom_file)
import bldr (dep)
import clojure

main() {
    bldr.build() {
        load_bom_file("../../../clojars.bom.ae")
        load_bom_file("../../../clojure-dep-patches.bom.ae")
        dep("projects/fnconf2025/smolwebapp/.build.ae")
        dep("org.clojure:clojure:1.12.0")
        dep("ring:ring-jetty-adapter:1.13.0")
        dep("clj-http:clj-http:3.12.3")
        clojure.test()
    }
}
