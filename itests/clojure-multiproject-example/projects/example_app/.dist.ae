// example_app — executable uberjar.
//
// `com.example.core` ships `(:gen-class)` + `(defn -main ...)`, so it
// AOT-compiles to a real entry-point class. The upstream deps.edn has
// no uberjar alias (this demo repo runs from source via clj), but the
// natural packaging step for a gen-class app is a `lein uberjar`-style
// standalone jar. aeb's no-leiningen analogue is `clojure.uberjar()`.
//
// Chain: bldr.dep on .build.ae compiles + writes the maven_classpath
// artifact (clojure.jar + any deps) into the shared target_dir;
// clojure.uberjar then AOT-compiles main_ns, stages src + every maven
// jar, and bundles a runnable standalone jar.
//
// Output: target/<mod>/bin/example_app-standalone.jar.
// Run: java -jar .../example_app-standalone.jar  (prints the greeting).

import bldr
import bldr (dep)
import maven (load_bom_file)
import clojure
import clojure (main_ns)

main() {
    bldr.build() {
        load_bom_file("../../clojars.bom.ae")
        load_bom_file("../../clojure-dep-patches.bom.ae")
        dep("org.clojure:clojure:1.12.0")
        dep(".build.ae")
        clojure.uberjar() {
            main_ns("com.example.core")
        }
    }
}
