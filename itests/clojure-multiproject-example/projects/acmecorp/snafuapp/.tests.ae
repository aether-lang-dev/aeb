import bldr
import maven (load_bom_file)
import bldr (dep)
import clojure

main() {
    bldr.build() {
        load_bom_file("../../../clojars.bom.ae")
        load_bom_file("../../../clojure-dep-patches.bom.ae")
        dep("projects/acmecorp/snafuapp/.build.ae")
        dep("org.clojure:clojure:1.11.3")
        clojure.test()
    }
}
