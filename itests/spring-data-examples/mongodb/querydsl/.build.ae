import bldr
import bldr (dep)
import maven (load_bom_file)
import java
import java (release, source_layout, enable_preview, generated_sources)

main() {
    bldr.build() {
        load_bom_file("../../spring-boot.bom.ae")
        dep("org.springframework.boot:spring-boot-starter-data-mongodb")
        dep("com.querydsl:querydsl-mongodb:5.1.0")
        dep("com.querydsl:querydsl-apt")
        dep("org.projectlombok:lombok")
        java.javac() {
            release("25")
            source_layout("maven idiomatic")
            enable_preview()
            parameters()
            generated_sources("target/mongodb/querydsl/generated-sources")
        }
    }
}
