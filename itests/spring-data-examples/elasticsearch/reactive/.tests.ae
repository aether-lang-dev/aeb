import bldr
import bldr (dep)
import maven (load_bom_file)
import java
import java (release, source_layout, enable_preview, test_timeout, parameters)

main() {
    bldr.build() {
        dep("elasticsearch/reactive/.build.ae")
        load_bom_file("../../spring-boot.bom.ae")
        dep("org.springframework.boot:spring-boot-starter-test")
        dep("org.junit.platform:junit-platform-console")
        dep("org.testcontainers:testcontainers-elasticsearch")
        dep("org.testcontainers:testcontainers-junit-jupiter")
        dep("org.apache.commons:commons-lang3")
        dep("commons-io:commons-io:2.18.0")
        dep("io.projectreactor:reactor-test")
        java.javac_test() {
            release("25")
            source_layout("maven idiomatic")
            enable_preview()
            parameters()
        }
        java.junit5() {
            test_timeout("120")
            enable_preview()
        }
    }
}
