import bldr
import bldr (dep)
import maven (load_bom_file)
import java
import java (release, source_layout, enable_preview, parameters)

main() {
    b = bldr.start()
    load_bom_file(b, "../../spring-boot.bom.ae")
    dep(b, "org.mybatis.spring.boot:mybatis-spring-boot-starter:3.0.4")
    dep(b, "org.springframework.boot:spring-boot-starter-data-jdbc")
    dep(b, "org.hsqldb:hsqldb")
    dep(b, "org.projectlombok:lombok")
    java.javac(b) {
        release("25")
        source_layout("maven idiomatic")
        enable_preview()
        parameters()
    }
}
