import bldr
import bldr (dep)
import maven (load_bom_file)
import java
import java (release, source_layout, enable_preview, parameters)

main() {
    bldr.build() {
        load_bom_file("../../spring-boot.bom.ae")
        load_bom_file("jmolecules.bom.ae")
        dep("org.springframework.boot:spring-boot-starter-data-jdbc")
        dep("com.h2database:h2")
        dep("org.jmolecules:jmolecules-spring:2023.0.0")
        dep("org.jmolecules:jmolecules-events:2023.0.0")
        dep("org.projectlombok:lombok")
        java.javac() {
            release("25")
            source_layout("maven idiomatic")
            enable_preview()
            parameters()
        }
    }
}
