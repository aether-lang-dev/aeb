// Spring Boot BOM — parsed as text by aeb-resolve.jar
// Lines with maven_bom("g:a:v") and maven_repo("url") are extracted by the resolver.
maven_bom("org.springframework.boot:spring-boot-dependencies:4.0.4")

// Where a BOM here manages a version and a pom asks for another. Written by aeb
// as builds meet them; change the pick on a line to decide differently.
dep_arbitration("org.apache.commons:commons-lang3", "3.19.0", and_not("3.5"))
dep_arbitration("net.bytebuddy:byte-buddy", "1.17.8", and_not("1.18.3, 1.17.7"))
dep_arbitration("org.hamcrest:hamcrest", "3.0", and_not("2.1"))
dep_arbitration("net.bytebuddy:byte-buddy-agent", "1.17.8", and_not("1.17.7"))
dep_arbitration("org.junit.jupiter:junit-jupiter-api", "6.0.3", and_not("5.13.4"))
dep_arbitration("commons-logging:commons-logging", "1.3.6", and_not("1.3.5"))
dep_arbitration("jakarta.annotation:jakarta.annotation-api", "3.0.0", and_not("2.0.0"))
dep_arbitration("org.aspectj:aspectjweaver", "1.9.25.1", and_not("1.9.25"))
dep_arbitration("org.jboss.logging:jboss-logging", "3.6.3.Final", and_not("3.6.1.Final, 3.5.0.Final"))
dep_arbitration("com.fasterxml:classmate", "1.7.3", and_not("1.7.1"))
