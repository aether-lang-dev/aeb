import bldr
import bldr (dep, maven_nodes)
import maven (load_bom_file)
import java
import java (release, source_layout, parameters)

main() {
    bldr.build() {
        // Maven artifacts kept as build files, one per artifact with its sha256
        // (docs/design/maven-nodes-and-arbitration.md). Other modules here still
        // resolve at build time.
        maven_nodes("third_party/java")
        load_bom_file("../../spring-boot.bom.ae")
        dep("org.springframework.boot:spring-boot-starter-data-jpa")
        dep("org.hsqldb:hsqldb")
        dep("org.projectlombok:lombok")
        java.javac() {
            release("25")
            source_layout("maven idiomatic")
            parameters()
        }
    }
}
