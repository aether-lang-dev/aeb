import bldr
import bldr (dep)
import maven (load_bom_file)
import java
import java (release, source_layout, enable_preview, parameters)

main() {
    bldr.build() {
        load_bom_file("../../spring-boot.bom.ae")
        dep("org.springframework.boot:spring-boot-starter-data-rest")
        dep("org.springframework.boot:spring-boot-starter-data-jpa")
        dep("com.h2database:h2")
        dep("org.springframework.boot:spring-boot-starter-data-mongodb")
        dep("org.projectlombok:lombok")
        java.javac() {
            release("25")
            source_layout("maven idiomatic")
            enable_preview()
            parameters()
        }
    }
}
