import bldr
import bldr (dep)
import maven (load_bom_file)
import kotlin
import kotlin (source_layout, jvm_target, compiler_plugin)

main() {
    bldr.build() {
        load_bom_file("../../spring-boot.bom.ae")
        dep("org.springframework.boot:spring-boot-starter-data-cassandra")
        dep("org.jetbrains.kotlin:kotlin-stdlib")
        dep("org.jetbrains.kotlin:kotlin-reflect")
        kotlin.kotlinc() {
            jvm_target("25")
            source_layout("maven idiomatic")
        }
    }
}
