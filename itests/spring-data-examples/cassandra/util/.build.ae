import bldr
import bldr (dep)
import maven (load_bom_file)
import java
import java (release, source_layout, enable_preview, parameters)

main() {
    bldr.build() {
        load_bom_file("../../spring-boot.bom.ae")
        dep("org.junit.jupiter:junit-jupiter")
        dep("org.junit.platform:junit-platform-commons")
        dep("org.testcontainers:testcontainers-cassandra")
        dep("org.apache.cassandra:java-driver-core:4.19.2")
        dep("org.awaitility:awaitility")
        dep("org.springframework.boot:spring-boot-starter-data-cassandra")
        dep("org.projectlombok:lombok")
        java.javac() {
            release("25")
            source_layout("maven idiomatic")
            enable_preview()
            parameters()
        }
    }
}
