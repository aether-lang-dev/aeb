import bldr
import bldr (dep)
import maven (load_bom_file)
import java
import java (release, source_layout, enable_preview, parameters)

main() {
    b = bldr.start()
    load_bom_file(b, "../../spring-boot.bom.ae")
    dep(b, "org.springframework.boot:spring-boot-starter-web")
    dep(b, "org.springframework.boot:spring-boot-restclient")
    dep(b, "org.springframework.data:spring-data-commons")
    dep(b, "com.jayway.jsonpath:json-path")
    dep(b, "org.xmlbeam:xmlprojector:1.4.26")
    dep(b, "org.projectlombok:lombok")
    java.javac(b) {
        release("25")
        source_layout("maven idiomatic")
        enable_preview()
        parameters()
    }
}
