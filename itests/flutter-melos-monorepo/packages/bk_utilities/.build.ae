import bldr
import dart
import dart (dart_bin)

// bk_utilities: resolve deps (`flutter pub get`) and static-analyse
// (`flutter analyze`). dart_bin("flutter") routes the dart SDK through
// the Flutter-bundled Dart 2.18 the melos packages pin (sdk <3.0.0).
aeb(cap) {
    bldr.build() {
        dart.pub_get() { dart_bin("flutter") }
        dart.analyze() { dart_bin("flutter") }
    }
}
