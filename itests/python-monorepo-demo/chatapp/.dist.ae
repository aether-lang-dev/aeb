import bldr
import python
import python (package_name, version, requires_python, packages_where, packages_include)

main() {
    bldr.build() {
        dep("chatapp/contentbuilder/.build.ae")
        dep("libs/python/setuptools/.setuptools.whl.ae")
        python.package() {
            package_name("chatapp")
            version("0.1.0")
            requires_python(">=3.10")
            packages_where("..")
            packages_include("chatapp*")
        }
    }
}
