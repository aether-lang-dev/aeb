import bldr
import bldr (dep)
import maven (load_bom_file)
import java
import java (release, source_layout)

aeb(cap) {
    bldr.build() {
        dep("jooby/.build.ae")
        load_bom_file("../../jooby.bom.ae")
        dep("com.fasterxml.jackson.core:jackson-databind")
        dep("com.fasterxml.jackson.datatype:jackson-datatype-jdk8")
        dep("com.fasterxml.jackson.datatype:jackson-datatype-jsr310")
        dep("com.fasterxml.jackson.module:jackson-module-parameter-names")
        dep("jakarta.json.bind:jakarta.json.bind-api:3.0.2")
        java.javac() { release("21")  source_layout("maven idiomatic") }
    }
}
