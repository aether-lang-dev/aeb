import bldr
import bldr (dep)
import maven (load_bom_file)
import java
import java (release, source_layout, no_module_info)

aeb(cap) {
    bldr.build() {
        load_bom_file("../../jooby.bom.ae")
        dep("org.apache.commons:commons-lang3:3.20.0")
        dep("org.apache.commons:commons-text:1.15.0")
        dep("com.puppycrawl.tools:checkstyle:13.7.0")
        java.javac() { release("21")  source_layout("maven idiomatic") }
    }
}
