import build
import build (dep)
import maven (load_bom_file)
import java
import java (release, source_layout, no_module_info)

aeb(cap) {
    b = build.start()
    load_bom_file(b, "../../jooby.bom.ae")
    dep(b, "org.apache.commons:commons-lang3:3.20.0")
    dep(b, "org.apache.commons:commons-text:1.15.0")
    dep(b, "com.puppycrawl.tools:checkstyle:13.7.0")
    java.javac(b) { release("21")  source_layout("maven idiomatic") }
}
