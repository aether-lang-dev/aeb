import bldr
import bldr (dep)
import maven (load_bom_file)
import java
import java (release, source_layout, no_module_info)

// jooby-hikari. HikariCP connection-pool module. Classpath-mode: no
// module-info.java, HikariCP is a plain (non-modular) jar.
aeb(cap) {
    bldr.build() {
        dep("jooby/.build.ae")
        load_bom_file("../../jooby.bom.ae")
        dep("com.zaxxer:HikariCP:7.1.0")
        java.javac() { release("21")  source_layout("maven idiomatic")  no_module_info() }
    }
}
