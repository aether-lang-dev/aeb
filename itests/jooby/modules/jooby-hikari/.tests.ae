import build
import build (dep)
import maven (load_bom_file)
import java
import java (release, source_layout)

// jooby-hikari tests. log4jdbc is a test-only JDBC spy driver.
aeb(cap) {
    b = build.start()
    build.dep(b, "modules/jooby-hikari/.build.ae")
    load_bom_file(b, "../../jooby.bom.ae")
    dep(b, "com.zaxxer:HikariCP:7.1.0")
    dep(b, "org.junit.jupiter:junit-jupiter-engine")
    dep(b, "org.junit.platform:junit-platform-console")
    dep(b, "com.googlecode.log4jdbc:log4jdbc:1.2")
    java.javac_test(b) { release("21")  source_layout("maven idiomatic") }
    java.junit5(b) {}
}
