import bldr
import bldr (dep)
import maven (load_bom_file)
import java
import java (release, source_layout)

// jooby-hikari tests. log4jdbc is a test-only JDBC spy driver.
aeb(cap) {
    bldr.build() {
        dep("modules/jooby-hikari/.build.ae")
        load_bom_file("../../jooby.bom.ae")
        dep("com.zaxxer:HikariCP:7.1.0")
        dep("org.junit.jupiter:junit-jupiter-engine")
        dep("org.junit.platform:junit-platform-console")
        dep("com.googlecode.log4jdbc:log4jdbc:1.2")
        java.javac_test() { release("21")  source_layout("maven idiomatic") }
        java.junit5() {}
    }
}
