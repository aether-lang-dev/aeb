import bldr
import bldr (dep)
import maven (load_bom_file)
import java
import java (release, source_layout, parameters, debug)
import kotlin

aeb(cap) {
    bldr.build() {
        dep("modules/jooby-openapi/.build.ae")
        dep("modules/jooby-kotlin/.build.ae")
        load_bom_file("../../jooby.bom.ae")
        dep("org.junit.jupiter:junit-jupiter-engine")
        dep("org.junit.platform:junit-platform-console")
        dep("org.apache.commons:commons-lang3:3.20.0")
        dep("io.avaje:avaje-inject:12.6")
        dep("org.slf4j:slf4j-simple:2.0.18")
        dep("org.jetbrains.kotlin:kotlin-stdlib:2.4.0")
        dep("org.jetbrains.kotlin:kotlin-reflect:2.4.0")
        dep("org.jetbrains.kotlinx:kotlinx-coroutines-core:1.11.0")
        dep("net.bytebuddy:byte-buddy:1.18.11")
        dep("org.mockito:mockito-core:5.23.0")
        dep("org.assertj:assertj-core:3.27.7")
        kotlin.kotlinc_test() { source_layout("maven idiomatic")  }
        java.javac_test() { release("21")  source_layout("maven idiomatic")  parameters()  debug("all") }
        java.junit5() {}
    }
}
