import bldr
import bldr (dep)
import maven (load_bom_file)
import java
import java (release, source_layout, no_module_info)

aeb(cap) {
    bldr.build() {
        dep("jooby/.build.ae")
        dep("modules/jooby-javadoc/.build.ae")
        load_bom_file("../../jooby.bom.ae")
        dep("jakarta.ws.rs:jakarta.ws.rs-api:4.0.0")
        dep("jakarta.validation:jakarta.validation-api:3.1.1")
        dep("javax.xml.bind:jaxb-api:2.3.1")
        dep("org.ow2.asm:asm:9.10.1")
        dep("org.ow2.asm:asm-util:9.10.1")
        dep("com.fasterxml.jackson.datatype:jackson-datatype-jdk8")
        dep("io.swagger.core.v3:swagger-models:2.2.52")
        dep("org.asciidoctor:asciidoctorj:3.0.1")
        dep("io.pebbletemplates:pebble:4.1.2")
        dep("net.datafaker:datafaker:2.7.0")
        dep("commons-codec:commons-codec:1.22.0")
        dep("org.mozilla:rhino:1.9.1")
        dep("io.swagger.parser.v3:swagger-parser:2.1.45")
        dep("com.google.guava:guava:33.6.0-jre")
        dep("jakarta.data:jakarta.data-api:1.0.1")
        java.javac() { release("21")  source_layout("maven idiomatic")  no_module_info() }
    }
}
