import bldr
import bldr (dep)
import maven (load_bom_file)
import java
import java (release, source_layout, no_module_info)

aeb(cap) {
    b = bldr.start()
    bldr.dep(b, "jooby/.build.ae")
    bldr.dep(b, "modules/jooby-javadoc/.build.ae")
    load_bom_file(b, "../../jooby.bom.ae")
    dep(b, "jakarta.ws.rs:jakarta.ws.rs-api:4.0.0")
    dep(b, "jakarta.validation:jakarta.validation-api:3.1.1")
    dep(b, "javax.xml.bind:jaxb-api:2.3.1")
    dep(b, "org.ow2.asm:asm:9.10.1")
    dep(b, "org.ow2.asm:asm-util:9.10.1")
    dep(b, "com.fasterxml.jackson.datatype:jackson-datatype-jdk8")
    dep(b, "io.swagger.core.v3:swagger-models:2.2.52")
    dep(b, "org.asciidoctor:asciidoctorj:3.0.1")
    dep(b, "io.pebbletemplates:pebble:4.1.2")
    dep(b, "net.datafaker:datafaker:2.7.0")
    dep(b, "commons-codec:commons-codec:1.22.0")
    dep(b, "org.mozilla:rhino:1.9.1")
    dep(b, "io.swagger.parser.v3:swagger-parser:2.1.45")
    dep(b, "com.google.guava:guava:33.6.0-jre")
    dep(b, "jakarta.data:jakarta.data-api:1.0.1")
    java.javac(b) { release("21")  source_layout("maven idiomatic")  no_module_info() }
}
