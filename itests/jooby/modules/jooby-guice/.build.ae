import bldr
import bldr (dep)
import maven (load_bom_file)
import java
import java (release, source_layout, no_module_info)

// jooby-guice. Google Guice DI module. Classpath-mode: guice 7 is a plain jar.
aeb(cap) {
    bldr.build() {
        dep("jooby/.build.ae")
        load_bom_file("../../jooby.bom.ae")
        dep("com.google.inject:guice:7.0.0")
        java.javac() { release("21")  source_layout("maven idiomatic")  no_module_info() }
    }
}
