import bldr
import bldr (dep, maven_nodes)
import maven (load_bom_file)
import java
import java (release, source_layout)

// jooby-guice tests.
aeb(cap) {
    bldr.build() {
        dep("modules/jooby-guice/.build.ae")
        // Maven artifacts kept as build files, one per artifact with its sha256
        // (docs/design/maven-nodes-and-arbitration.md). Other modules here still
        // resolve at build time.
        maven_nodes("third_party/java")
        load_bom_file("../../jooby.bom.ae")
        dep("com.google.inject:guice:7.0.0")
        dep("org.junit.jupiter:junit-jupiter-engine")
        dep("org.junit.platform:junit-platform-console")
        dep("org.mockito:mockito-core:5.23.0")
        java.javac_test() { release("21")  source_layout("maven idiomatic") }
        java.junit5() {}
    }
}
