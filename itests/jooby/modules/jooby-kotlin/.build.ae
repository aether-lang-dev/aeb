import bldr
import bldr (dep)
import maven (load_bom_file)
import kotlin
import kotlin (source_layout)

aeb(cap) {
    bldr.build() {
        dep("jooby/.build.ae")
        load_bom_file("../../jooby.bom.ae")
        dep("org.jetbrains.kotlin:kotlin-stdlib:2.4.0")
        dep("org.jetbrains.kotlinx:kotlinx-coroutines-core:1.11.0")
        kotlin.kotlinc() { source_layout("maven idiomatic") }
    }
}
