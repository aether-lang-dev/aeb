import bldr
import bldr (dep)
import maven (load_bom_file)
import java
import java (release, source_layout, no_module_info)

aeb(cap) {
    bldr.build() {
        dep("jooby/.build.ae")
        dep("modules/jooby-kotlin/.build.ae")
        load_bom_file("../../jooby.bom.ae")
        dep("org.junit.jupiter:junit-jupiter-api")
        dep("org.junit.jupiter:junit-jupiter-engine")
        java.javac() { release("21")  source_layout("maven idiomatic")  no_module_info() }
    }
}
