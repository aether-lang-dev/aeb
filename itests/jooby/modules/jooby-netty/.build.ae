import build
import build (dep)
import maven (load_bom_file)
import java
import java (release, source_layout, no_module_info)

// jooby-netty. Matches jooby-netty/pom.xml compile deps; the fixed resolver
// pulls the netty transitive tree (netty-common/buffer/transport/codec-base/
// resolver, netty-transport-classes-* from the native transports, etc.).
// no_module_info(): netty 4.2 ships multi-release jars whose module-info is
// only under META-INF/versions/11, so javac treats them as automatic modules
// on --module-path and jooby-netty's JPMS `requires io.netty.*` can't match —
// compile classpath-mode instead.
aeb(cap) {
    b = build.start()
    build.dep(b, "jooby/.build.ae")
    load_bom_file(b, "../../jooby.bom.ae")
    dep(b, "io.netty:netty-handler")
    dep(b, "io.netty:netty-codec-http")
    dep(b, "io.netty:netty-codec-http2")
    dep(b, "io.netty:netty-transport-native-epoll:4.2.15.Final")
    dep(b, "io.netty:netty-transport-native-kqueue:4.2.15.Final")
    dep(b, "io.netty:netty-transport-native-io_uring:4.2.15.Final")
    java.javac(b) { release("21")  source_layout("maven idiomatic")  no_module_info() }
}
