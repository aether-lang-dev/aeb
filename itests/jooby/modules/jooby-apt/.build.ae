import bldr
import bldr (dep)
import maven (load_bom_file)
import java
import java (release, source_layout, no_module_info)

// jooby-apt: jooby's MVC annotation processor (registers a
// javax.annotation.processing.Processor via META-INF/services). The processor
// itself is plain Java compiled against javax.lang.model — its only project
// dep is jooby-javadoc (JavaDoc AST for route descriptions); it reads the MVC
// annotations by NAME through the model API, so jooby core isn't a compile dep.
// Classpath-mode: no module-info.java.
aeb(cap) {
    bldr.build() {
        dep("modules/jooby-javadoc/.build.ae")
        load_bom_file("../../jooby.bom.ae")
        java.javac() { release("21")  source_layout("maven idiomatic")  no_module_info() }
    }
}
