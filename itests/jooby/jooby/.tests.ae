import bldr
import bldr (dep)
import maven (load_bom_file)
import java
import java (release, source_layout, parameters)

aeb(cap) {
    bldr.build() {
        dep("jooby/.build.ae")
        load_bom_file("../jooby.bom.ae")
        dep("org.junit.jupiter:junit-jupiter-engine")
        dep("org.junit.jupiter:junit-jupiter-params")
        dep("org.junit.platform:junit-platform-console")
        dep("org.assertj:assertj-core:3.27.7")
        dep("org.mockito:mockito-core:5.23.0")
        dep("org.mockito:mockito-junit-jupiter:5.23.0")
        dep("com.squareup.okhttp3:okhttp-jvm:5.4.0")
        dep("com.google.guava:guava:33.6.0-jre")
        dep("org.webjars.npm:vue:3.4.15")
        java.javac_test() { release("21")  source_layout("maven idiomatic")  parameters() }
        java.junit5() {}
    }
}
