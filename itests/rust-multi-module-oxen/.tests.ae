import bldr
import rust

main() {
    bldr.build() {
        // Depend on all member .build.ae files so they generate their Cargo.toml first
        dep("crates/lib/.build.ae")
        dep("crates/cli/.build.ae")
        dep("crates/server/.build.ae")
        // Then run cargo check across the whole workspace
        rust.check_workspace()
    }
}
