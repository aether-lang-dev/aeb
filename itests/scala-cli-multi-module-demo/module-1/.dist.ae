// scala-cli-multi-module-demo / module-1 — fat-jar assembly.
//
// Upstream shape (`module-1/package.sh`):
//
//     scala-cli --power package App.scala -f
//
// scala-cli's `package` mode builds a single executable jar with
// every dep inlined. That's `sbt-assembly`'s territory; for aeb the
// no-scala-cli equivalent is `scala.assembly(b)`.
//
// What this `.dist.ae` does:
//
//   1. `build.dep(b, ".build.ae")` — compile module-1's own classes
//      and the transitive `common/.build.ae` dep first.
//   2. `scala.assembly(b)` — stage classes + scala-library + maven
//      deps into one fat jar with the Main-Class manifest entry.
//
// Output: `target/module-1/bin/module-1-assembly.jar`. Run it with
// `java -jar target/module-1/bin/module-1-assembly.jar`.

import build
import build (dep)
import scala
import scala (main_class)

main() {
    b = build.start()
    dep(b, ".build.ae")
    scala.assembly(b) {
        main_class("App")
    }
}
