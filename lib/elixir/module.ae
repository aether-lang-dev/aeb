// elixir — Elixir SDK for aeb.
//
// Drives an existing Mix project as-is (the upstream owns mix.exs); aeb
// runs `mix` in the project dir and classifies the exit code. Env injection
// (a NIF path, an ERL_LIBS root, …) rides the shared `env(...)` setter.
//
//   import bldr
//   import elixir
//   import bldr (env)
//   import elixir (deps_get_first)
//   elixir.test(b) {
//       env("SERVIRTIUM_NIF_EBIN", ebin)
//       deps_get_first("1")   // `mix deps.get` before `mix test`
//   }
//
// Setters: env(K,V) [lib/build], deps_get_first("1"), mix_test_flag("…").
// A binding that declares its own step("…") still gets the generic
// _run_project path (back-compat); the DSL path is taken only when no
// step() was set.
import bldr
import std.string
import std.os
import std.list
import std.io
import std.path
import std.map

// --- DSL setters ---

// deps_get_first("1") — run `mix deps.get` before `mix test` (any non-empty
// value enables). Replaces a step("mix deps.get") + step("mix test") pair.
deps_get_first(_ctx: ptr, v: string) {
    _e = map.put(_ctx, "elixir_deps_get", v)
}

// mix_test_flag("--max-cases") — one verbatim flag for `mix test`
// (--max-cases, --seed, --trace, --only, …). Repeatable; greppable literal.
mix_test_flag(_ctx: ptr, flag: string) {
    if map.has(_ctx, "mix_test_flags") == 0 {
        _e1 = map.put(_ctx, "mix_test_flags", list.new())
    }
    l, _ = map.get(_ctx, "mix_test_flags")
    _a = list.add(l, flag)
}

// --- Consumer-manifest setters (for elixir.generate_manifest) ---
//
// elixir.generate_manifest() EMITS a mix.exs for a CONSUMER — the exporter-node
// pattern (python.package / gleam.generate_manifest). Setter names are distinct
// from any elixir_<name> function to avoid the setter-mangle collision
// (asks/setter-mangle-collides-with-function-name.md).

// manifest_name("selenium") — the emitted Mix app atom + module. Default "app".
manifest_name(_ctx: ptr, name: string) {
    _e = map.put(_ctx, "manifest_name", name)
}

// manifest_version("0.8.0") — the emitted project version. Default "0.1.0".
manifest_version(_ctx: ptr, ver: string) {
    _e = map.put(_ctx, "manifest_version", ver)
}

// hex_dep("jason", "~> 1.4") — one `defp deps` entry, `{:name, "ver"}`.
// Repeatable. Stored as "name~ver" (SDK-wide tilde-join).
hex_dep(_ctx: ptr, name: string, ver: string) {
    if map.has(_ctx, "manifest_hex_deps") == 0 {
        _e1 = map.put(_ctx, "manifest_hex_deps", list.new())
    }
    deps, _ = map.get(_ctx, "manifest_hex_deps")
    entry = string.concat(name, "~")
    entry = string.concat(entry, ver)
    _e2 = list.add(deps, entry)
}

// depends_native("selenium_nif") — a native (Erlang application) dep the
// consumer links from a prebuilt NIF via ERL_LIBS (engine_from). Repeatable.
// Emitted into extra_applications + a documented comment (Mix resolves the NIF
// app via ERL_LIBS, not the hex deps list).
depends_native(_ctx: ptr, app: string) {
    if map.has(_ctx, "manifest_native_deps") == 0 {
        _e1 = map.put(_ctx, "manifest_native_deps", list.new())
    }
    apps, _ = map.get(_ctx, "manifest_native_deps")
    _e2 = list.add(apps, app)
}

// engine_from(dep_artifact("erlang/.build.ae", "erl_libs")) — the ERL_LIBS path
// where the consumer's native deps live.
engine_from(_ctx: ptr, erl_libs_path: string) {
    _e = map.put(_ctx, "manifest_engine_from", erl_libs_path)
}

// --- Pure command builders (tested in tests/test_elixir_cmd.ae) ---

// mix_exs_content(opts) — PURE generator of a consumer mix.exs (a Mix.Project
// module) from the generate_manifest block-map. No I/O; unit-testable. hex_dep
// entries become `{:name, "ver"}` in `defp deps`; the native edge
// (depends_native + engine_from) goes to extra_applications + a comment.
mix_exs_content(opts: ptr) {
    name = "app"
    ver = "0.1.0"
    if opts != null {
        if map.has(opts, "manifest_name") == 1 { name, _ = map.get(opts, "manifest_name") }
        if map.has(opts, "manifest_version") == 1 { ver, _ = map.get(opts, "manifest_version") }
    }
    // Module name: capitalise nothing fancy — Mix accepts the atom app name.
    out = "# mix.exs — generated by aeb.elixir.generate_manifest\n"
    out = string.concat(out, "defmodule ${name}.MixProject do\n  use Mix.Project\n\n")
    out = string.concat(out, "  def project do\n    [\n      app: :${name},\n      version: \"${ver}\",\n      deps: deps()\n    ]\n  end\n\n")

    // extra_applications for native (NIF) apps, if any.
    has_native = 0
    native_apps = ""
    if opts != null {
        if map.has(opts, "manifest_native_deps") == 1 {
            nd, _ = map.get(opts, "manifest_native_deps")
            nn = list.size(nd)
            if nn > 0 {
                has_native = 1
                i = 0
                while i < nn {
                    app, _ = list.get(nd, i)
                    i = i + 1
                    sep = ", "
                    if i == nn { sep = "" }
                    native_apps = string.concat(native_apps, ":${app}${sep}")
                }
            }
        }
    }
    out = string.concat(out, "  def application do\n")
    if has_native == 1 {
        out = string.concat(out, "    # native (NIF) applications resolved via ERL_LIBS (see comment below)\n")
        out = string.concat(out, "    [extra_applications: [${native_apps}]]\n")
    } else {
        out = string.concat(out, "    [extra_applications: []]\n")
    }
    out = string.concat(out, "  end\n\n")

    // defp deps
    out = string.concat(out, "  defp deps do\n    [\n")
    if opts != null {
        if map.has(opts, "manifest_hex_deps") == 1 {
            deps, _ = map.get(opts, "manifest_hex_deps")
            n = list.size(deps)
            i = 0
            while i < n {
                entry, _ = list.get(deps, i)
                i = i + 1
                tilde = string.index_of(entry, "~")
                if tilde < 0 { continue }
                dn = string.substring(entry, 0, tilde)
                dv = string.substring(entry, tilde + 1, string.length(entry))
                sep = ","
                if i == n { sep = "" }
                out = string.concat(out, "      {:${dn}, \"${dv}\"}${sep}\n")
            }
        }
    }
    out = string.concat(out, "    ]\n  end\nend\n")

    // Native ERL_LIBS pointer, documented.
    if has_native == 1 {
        if opts != null {
            if map.has(opts, "manifest_engine_from") == 1 {
                ef, _ = map.get(opts, "manifest_engine_from")
                if string.length(ef) > 0 { out = string.concat(out, "\n# Native deps resolved via ERL_LIBS=${ef}\n") }
            }
        }
    }

    return out
}

// mix_deps_get_cmd(source_dir) — `cd '<dir>' && mix deps.get`.
mix_deps_get_cmd(source_dir: string) {
    return "cd '${source_dir}' && mix deps.get"
}

// mix_test_cmd(source_dir, flags_part) — `cd '<dir>' && mix test<flags_part>`.
// flags_part is " --trace --seed 0" (leading space) or "".
mix_test_cmd(source_dir: string, flags_part: string) {
    return "cd '${source_dir}' && mix test${flags_part}"
}

// _flag_part(l) — render a list of flags as " a b c" (leading space), "" when
// empty/null. Pure.
_flag_part(l: ptr) {
    if l == null { return "" }
    out = ""
    n = list.size(l)
    i = 0
    while i < n {
        f, _ = list.get(l, i)
        out = string.concat(out, string.concat(" ", f))
        i = i + 1
    }
    return out
}

// --- Builders ---

// elixir.compile(b) — `mix compile`. Build-phase verb.
builder compile(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    mod_dir = bldr._get(ctx, "module_dir")
    println("${mod_dir}: compiling (mix compile)")
    return bldr._run_project(ctx, _builder, "mix compile", 0)
}

// elixir.test(b) — `mix test` (optionally `mix deps.get` first), pass/fail
// telemetry. Honors explicit step()s for back-compat; otherwise DSL-driven.
builder test(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    mod_dir = bldr._get(ctx, "module_dir")

    // Back-compat: a binding that wrote step("…") keeps the generic path.
    if _builder != null {
        if map.has(_builder, "proc_steps") == 1 {
            println("${mod_dir}: running tests (mix test)")
            return bldr._run_project(ctx, _builder, "mix test", 1)
        }
    }

    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    bldr._mkdirs(target_dir)
    env_prefix = bldr._env_export_prefix(_builder)

    // Optional `mix deps.get` first.
    if _builder != null {
        if map.has(_builder, "elixir_deps_get") == 1 {
            dv, _ = map.get(_builder, "elixir_deps_get")
            if string.length(dv) > 0 {
                println("${mod_dir}: resolving deps (mix deps.get)")
                dg_rc = bldr._sh(string.concat(env_prefix, mix_deps_get_cmd(source_dir)))
                if dg_rc != 0 {
                    println("${mod_dir}: deps.get FAILED")
                    bldr.fail(ctx, "deps.get FAILED")
                    return dg_rc
                }
            }
        }
    }

    flags = null
    if _builder != null {
        if map.has(_builder, "mix_test_flags") == 1 { flags, _ = map.get(_builder, "mix_test_flags") }
    }
    println("${mod_dir}: running tests (mix test)")
    rc = bldr._sh(string.concat(env_prefix, mix_test_cmd(source_dir, _flag_part(flags))))
    if rc != 0 {
        bldr._record_test_result(ctx, 0, 1)
        println("${mod_dir}: tests FAILED")
        bldr.fail(ctx, "tests FAILED")
        return rc
    }
    bldr._record_test_result(ctx, 1, 0)
    println("${mod_dir}: tests PASSED")
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// elixir.generate_manifest(b) — emit a consumer mix.exs into source_dir and
// publish its path on the "mix_exs" artifact edge. Exporter-node counterpart of
// python.package() / gleam.generate_manifest(); route via an elixir/.package.ae.
builder generate_manifest(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")

    bldr._mkdirs(target_dir)

    mix = mix_exs_content(_builder)
    manifest_path = path.join(source_dir, "mix.exs")
    _ew = io.write_file(manifest_path, mix)

    bldr._write_artifact(ctx, "mix_exs", manifest_path)
    println("${mod_dir}: generated ${manifest_path}")
    _et = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}
