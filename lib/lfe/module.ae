// lfe — LFE (Lisp Flavoured Erlang) SDK for aeb.
//
// LFE compiles to BEAM, so an LFE binding to a native lib rides an existing
// Erlang NIF (no second FFI) exactly as Elixir/Gleam do. This SDK's run_main
// builder mirrors erlang.eunit's run_main: lfec-compile the declared src +
// test .lfe files into target_dir, then run `lfe -noshell -pa <ebins> -eval
// '<mod>:main([]), halt(0)'` with ERL_LIBS(env) + -pa code paths. For a
// compile-then-run-main conformance suite (no rebar3/lfetool needed).
//
//   import bldr
//   import lfe
//   import lfe (src, test_src, run_main, pa)
//   lfe.run_main() {
//       env("ERL_LIBS", libs)
//       src("src/selenium.lfe")
//       test_src("test/ffi_test.lfe")
//       pa(ebin)
//       run_main("ffi_test")
//   }
import bldr
import std.string
import std.list
import std.map
import std.path
import std.io
import std.os

// src("src/foo.lfe") — an LFE source module to lfec-compile (repeatable).
src(_ctx: ptr, path: string) {
    if map.has(_ctx, "lfe_src") == 0 { _e1 = map.put(_ctx, "lfe_src", list.new()) }
    l, _ = map.get(_ctx, "lfe_src")
    _e2 = list.add(l, path)
}

// test_src("test/foo_test.lfe") — an LFE test module to lfec-compile (repeatable).
test_src(_ctx: ptr, path: string) {
    if map.has(_ctx, "lfe_test_src") == 0 { _e1 = map.put(_ctx, "lfe_test_src", list.new()) }
    l, _ = map.get(_ctx, "lfe_test_src")
    _e2 = list.add(l, path)
}

// run_main("mod") — after compiling, run `lfe -noshell -pa … -eval
// '<mod>:main([]), halt(0)'`. Scalar.
run_main(_ctx: ptr, mod: string) {
    _e = map.put(_ctx, "lfe_run_main", mod)
}

// pa("<dir>") — an extra code-path directory (-pa <dir>) for the run, e.g. a
// dep NIF app's ebin. Repeatable.
pa(_ctx: ptr, dir: string) {
    if map.has(_ctx, "lfe_pa") == 0 { _e1 = map.put(_ctx, "lfe_pa", list.new()) }
    l, _ = map.get(_ctx, "lfe_pa")
    _e2 = list.add(l, dir)
}

// --- Consumer-manifest setters (for lfe.generate_manifest) ---
//
// lfe.generate_manifest() EMITS a rebar.config for a CONSUMER (LFE uses rebar3,
// so the same Erlang-terms format as erlang). Exporter-node pattern
// (python.package / gleam.generate_manifest). Setter names distinct from any
// lfe_<name> function (asks/setter-mangle-collides-with-function-name.md).

// manifest_name("selenium") — the emitted app name (comment header). Default "app".
manifest_name(_ctx: ptr, name: string) {
    _e = map.put(_ctx, "manifest_name", name)
}

// manifest_version("0.8.0") — the emitted app version. Default "0.1.0".
manifest_version(_ctx: ptr, ver: string) {
    _e = map.put(_ctx, "manifest_version", ver)
}

// hex_dep("lfe", "2.1.1") — one rebar {deps, [...]} entry. Repeatable. Stored
// "name~ver".
hex_dep(_ctx: ptr, name: string, ver: string) {
    if map.has(_ctx, "manifest_hex_deps") == 0 {
        _e1 = map.put(_ctx, "manifest_hex_deps", list.new())
    }
    deps, _ = map.get(_ctx, "manifest_hex_deps")
    entry = string.concat(name, "~")
    entry = string.concat(entry, ver)
    _e2 = list.add(deps, entry)
}

// depends_native("selenium_nif") — a native (Erlang application) dep resolved
// via ERL_LIBS (engine_from). Repeatable. Emitted as a documented comment.
depends_native(_ctx: ptr, app: string) {
    if map.has(_ctx, "manifest_native_deps") == 0 {
        _e1 = map.put(_ctx, "manifest_native_deps", list.new())
    }
    apps, _ = map.get(_ctx, "manifest_native_deps")
    _e2 = list.add(apps, app)
}

// engine_from(dep_artifact("erlang/.build.ae", "erl_libs")) — the ERL_LIBS path.
engine_from(_ctx: ptr, erl_libs_path: string) {
    _e = map.put(_ctx, "manifest_engine_from", erl_libs_path)
}

// _files_str(bmap, key, source_dir) — space-joined 'quoted' absolute paths.
_files_str(bmap: ptr, key: string, source_dir: string) {
    out = ""
    if bmap != null {
        if map.has(bmap, key) == 1 {
            l, _ = map.get(bmap, key)
            n = list.size(l)
            i = 0
            while i < n {
                f, _ = list.get(l, i)
                out = string.concat(out, string.concat(" '", string.concat(path.join(source_dir, f), "'")))
                i = i + 1
            }
        }
    }
    return out
}

// lfe_run_cmd(source_dir, pa_flags, rmod) — `cd '<dir>' && lfe -noshell <pa_flags>
// -eval '(<mod>:main (list))' -eval '(halt 0)'`. The pure command test() runs (env
// prefix rides separately via _env_export_prefix). Pure; tested in
// tests/test_lfe_cmd.ae.
lfe_run_cmd(source_dir: string, pa_flags: string, rmod: string) {
    return "cd '${source_dir}' && lfe -noshell ${pa_flags} -eval '(${rmod}:main (list))' -eval '(halt 0)'"
}

// lfe.run_main() — compile src + test_src with lfec, then run mod:main([]).
builder test(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")
    bldr._mkdirs(target_dir)

    // toolchain gate: lfec + lfe, else SKIP.
    if string.length(os.which("lfec")) == 0 {
        reason = "lfec not on PATH (install LFE)"
        println("${mod_dir}: SKIPPED — ${reason}")
        bldr._record_skip(ctx, reason)
        return 0
    }
    if string.length(os.which("lfe")) == 0 {
        reason = "lfe not on PATH (install LFE)"
        println("${mod_dir}: SKIPPED — ${reason}")
        bldr._record_skip(ctx, reason)
        return 0
    }

    rmod = ""
    if _builder != null {
        if map.has(_builder, "lfe_run_main") == 1 { rmod, _ = map.get(_builder, "lfe_run_main") }
    }
    if string.length(rmod) == 0 {
        bldr.fail(ctx, "lfe.run_main: run_main(\"...\") is required")
        return 1
    }

    // 1. lfec-compile src then test into target_dir.
    srcs = _files_str(_builder, "lfe_src", source_dir)
    tsrcs = _files_str(_builder, "lfe_test_src", source_dir)
    all = string.concat(srcs, tsrcs)
    if string.length(string.trim(all)) > 0 {
        if bldr._sh("lfec -o '${target_dir}'${all}") != 0 {
            bldr._record_test_result(ctx, 0, 1)
            println("${mod_dir}: lfec failed")
            bldr.fail(ctx, "lfec failed")
            return 1
        }
    }

    // 2. -pa: target_dir (compiled beams) + declared pa()s.
    pa_flags = "-pa '${target_dir}'"
    if _builder != null {
        if map.has(_builder, "lfe_pa") == 1 {
            pl, _ = map.get(_builder, "lfe_pa")
            pn = list.size(pl)
            pi = 0
            while pi < pn {
                pd, _ = list.get(pl, pi)
                pa_flags = string.concat(pa_flags, " -pa '${pd}'")
                pi = pi + 1
            }
        }
    }

    // 3. run mod:main([]).
    run = lfe_run_cmd(source_dir, pa_flags, rmod)
    run = string.concat(bldr._env_export_prefix(_builder), run)
    println("${mod_dir}: running ${rmod}:main (lfe)")
    rc = bldr._sh(run)
    if rc != 0 {
        bldr._record_test_result(ctx, 0, 1)
        println("${mod_dir}: tests FAILED")
        bldr.fail(ctx, "tests FAILED")
        return rc
    }
    bldr._record_test_result(ctx, 1, 0)
    println("${mod_dir}: tests PASSED")
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// lfe_rebar_config_content(opts) — PURE generator of a consumer rebar.config
// (Erlang terms; LFE uses rebar3) from the generate_manifest block-map. No I/O.
// Emits `{deps, [{name, "ver"}, ...]}.` from hex_dep; native edge as comments.
// Named lfe_rebar_config_content (not rebar_config_content) so it stays distinct
// per-module.
lfe_rebar_config_content(opts: ptr) {
    name = "app"
    ver = "0.1.0"
    if opts != null {
        if map.has(opts, "manifest_name") == 1 { name, _ = map.get(opts, "manifest_name") }
        if map.has(opts, "manifest_version") == 1 { ver, _ = map.get(opts, "manifest_version") }
    }
    out = "%% rebar.config for ${name} ${ver} — generated by aeb.lfe.generate_manifest\n{plugins, [rebar3_lfe]}.\n"

    if opts != null {
        if map.has(opts, "manifest_hex_deps") == 1 {
            deps, _ = map.get(opts, "manifest_hex_deps")
            n = list.size(deps)
            if n > 0 {
                out = string.concat(out, "{deps, [\n")
                i = 0
                while i < n {
                    entry, _ = list.get(deps, i)
                    i = i + 1
                    tilde = string.index_of(entry, "~")
                    if tilde < 0 { continue }
                    dn = string.substring(entry, 0, tilde)
                    dv = string.substring(entry, tilde + 1, string.length(entry))
                    sep = ","
                    if i == n { sep = "" }
                    out = string.concat(out, "    {${dn}, \"${dv}\"}${sep}\n")
                }
                out = string.concat(out, "]}.\n")
            }
        }
    }

    has_native = 0
    if opts != null {
        if map.has(opts, "manifest_native_deps") == 1 {
            nd, _ = map.get(opts, "manifest_native_deps")
            if list.size(nd) > 0 { has_native = 1 }
        }
    }
    if has_native == 1 {
        out = string.concat(out, "\n%% Native (Erlang application) dependencies — resolved via ERL_LIBS below.\n")
        nd, _ = map.get(opts, "manifest_native_deps")
        n = list.size(nd)
        i = 0
        while i < n {
            app, _ = list.get(nd, i)
            i = i + 1
            out = string.concat(out, "%%   native application: ${app}\n")
        }
        if opts != null {
            if map.has(opts, "manifest_engine_from") == 1 {
                ef, _ = map.get(opts, "manifest_engine_from")
                if string.length(ef) > 0 { out = string.concat(out, "%%   ERL_LIBS=${ef}\n") }
            }
        }
    }

    return out
}

// lfe.generate_manifest(b) — emit a consumer rebar.config into source_dir and
// publish its path on the "rebar_config" artifact edge. Route via lfe/.package.ae.
builder generate_manifest(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")

    bldr._mkdirs(target_dir)

    cfg = lfe_rebar_config_content(_builder)
    manifest_path = path.join(source_dir, "rebar.config")
    _ew = io.write_file(manifest_path, cfg)

    bldr._write_artifact(ctx, "rebar_config", manifest_path)
    println("${mod_dir}: generated ${manifest_path}")
    _et = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}
