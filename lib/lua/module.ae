// lua — Lua SDK for aeb.
//
// Drives an existing Lua project as-is. `lua.test` defaults to the
// `busted` runner; projects with a custom harness (or a C-extension
// build step) override/extend with step(...). Env injection (e.g.
// LUA_CPATH, a shared `.so` path) rides the shared env(...) setter.
//
//   import bldr
//   import lua
//   import bldr (env, step)
//   lua.test(b) {
//       env("SERVIRTIUM_VCR_LIB", lib)
//       env("LUA_CPATH", "./?.so;;")
//       step("./build.sh \"${core}\"")
//       step("lua5.4 tests/run_all.lua")
//   }
//
// Setters (all from lib/build): env(K,V), step("…"), workdir("dir").
import bldr
import std.string
import std.os
import std.file
import std.map
import std.list
import std.path
import std.io

// --- DSL setters (for c_extension / conformance) ---

// c_source("src/htmlsanitizer.c") — the C extension source (repeatable). The
// extension `dlopen`s the engine at runtime, so it needs the engine .so only to
// RUN, not to build.
c_source(_ctx: ptr, src: string) {
    if map.has(_ctx, "lua_c_sources") == 0 { _e1 = map.put(_ctx, "lua_c_sources", list.new()) }
    l, _ = map.get(_ctx, "lua_c_sources")
    _e2 = list.add(l, src)
}

// ext_output("htmlsanitizer_native.so") — the built extension name (default
// "htmlsanitizer_native.so"), placed in the source dir so LUA_CPATH ./?.so finds it.
ext_output(_ctx: ptr, name: string) {
    _e = map.put(_ctx, "lua_ext_output", name)
}

// test_file("test/conformance.lua") — the Lua test file the conformance()
// builder runs. (Named test_file, not conformance, so it doesn't collide with
// the builder of that name.)
test_file(_ctx: ptr, file: string) {
    _e = map.put(_ctx, "lua_conformance", file)
}

// host_source("host/lua54.c") — a minimal Lua 5.4 host to build ONLY when no
// lua5.4 interpreter is on PATH (Debian 12 ships liblua5.4 without the binary).
host_source(_ctx: ptr, src: string) {
    _e = map.put(_ctx, "lua_host_source", src)
}

// --- Lua 5.4 toolchain discovery ---

// _lua54_pkg() — the pkg-config module name for Lua 5.4 (lua5.4 or lua-5.4), or
// "" when neither is known to pkg-config. Distros disagree on the name.
_lua54_pkg() {
    for_names = list.new()
    list.add(for_names, "lua5.4")
    list.add(for_names, "lua-5.4")
    n = list.size(for_names)
    i = 0
    while i < n {
        nm, _ = list.get(for_names, i)
        i = i + 1
        rc = bldr._sh("pkg-config --exists ${nm}")
        if rc == 0 { return nm }
    }
    return ""
}

// _lua54_cflags() / _lua54_libs() — resolved via pkg-config when available,
// else the usual Debian/Homebrew fallbacks. Returns ("", "") when Lua 5.4
// headers can't be found at all (caller SKIPs). Mirrors bldr.sh's cascade.
_lua54_flags() {
    pkg = _lua54_pkg()
    if string.length(pkg) > 0 {
        cf_raw, _e1 = bldr._sh_capture("pkg-config --cflags ${pkg}")
        lb_raw, _e2 = bldr._sh_capture("pkg-config --libs ${pkg}")
        return string.trim(cf_raw), string.trim(lb_raw)
    }
    if file.exists("/usr/include/lua5.4/lua.h") == 1 {
        return "-I/usr/include/lua5.4", "-llua5.4"
    }
    if file.exists("/usr/local/include/lua.h") == 1 {
        return "-I/usr/local/include", "-llua"
    }
    return "", ""
}

// _lua54_interp() — a `lua5.4` / `lua`(5.4) interpreter on PATH, else "".
// (A built ./lua54 host is checked by the caller after building it.)
_lua54_interp() {
    rc = bldr._sh("command -v lua5.4 >/dev/null 2>&1")
    if rc == 0 { return "lua5.4" }
    rc2 = bldr._sh("command -v lua >/dev/null 2>&1 && lua -v 2>&1 | grep -q 'Lua 5.4'")
    if rc2 == 0 { return "lua" }
    return ""
}

// lua.c_extension(b) — build a Lua 5.4 C extension (.so the host `require`s),
// and, when no lua5.4 binary is on PATH, a minimal host from host_source. The
// SDK-native form of html-sanitizer's lua/build.sh. SKIPs (green) when Lua 5.4
// headers are absent.
//
// Key nuance encoded: a Lua C extension MUST NOT link liblua — the host
// interpreter already provides those symbols; linking a second copy causes
// "multiple Lua VMs" crashes. So LUA_CFLAGS (headers) but not LUA_LIBS on the
// extension. macOS extensions are -bundle with -undefined dynamic_lookup.
// _build_lua_ext(ctx, bmap) — the extension (+ optional host) build, taking the
// builder map EXPLICITLY. Both c_extension (passing _builder) and conformance
// (passing _builder) call this: a builder that calls another builder as a
// nested `f(ctx)` does NOT propagate the closure's _builder, so the shared work
// must take the map as a parameter. Returns: 0 built, 1 failed, 2 SKIPPED (no
// headers) — the caller maps 2 to bldr._record_skip.
_build_lua_ext(ctx: ptr, bmap: ptr, source_dir: string, target_dir: string, mod_dir: string) {
    cf, lb = _lua54_flags()
    if string.length(cf) == 0 { return 2 }

    cc = bldr._default_cc()
    ccflags = "-O2 -fPIC -Wall -Wextra"
    shared = "-shared"
    if bldr._is_macos() == 1 { shared = "-bundle -undefined dynamic_lookup" }

    srcs = ""
    if bmap != null {
        if map.has(bmap, "lua_c_sources") == 1 {
            l, _ = map.get(bmap, "lua_c_sources")
            n = list.size(l)
            i = 0
            while i < n {
                s, _ = list.get(l, i)
                i = i + 1
                srcs = string.concat(srcs, string.concat(" ", path.join(source_dir, s)))
            }
        }
    }
    if string.length(string.trim(srcs)) == 0 {
        bldr.fail(ctx, "lua: at least one c_source(\"...\") is required")
        return 1
    }

    ext_out = "htmlsanitizer_native.so"
    if bmap != null {
        if map.has(bmap, "lua_ext_output") == 1 { ext_out, _ = map.get(bmap, "lua_ext_output") }
    }
    // Placed in source_dir so LUA_CPATH ./?.so resolves it next to the tests.
    ext_path = path.join(source_dir, ext_out)

    // NO liblua on the extension: the host provides those symbols; a second copy
    // causes "multiple Lua VMs" crashes. cflags (headers) + -ldl only.
    println("${mod_dir}: building Lua C extension (${cc})")
    build_cmd = "${cc} ${ccflags} ${shared} ${cf} ${srcs} -o '${ext_path}' -ldl"
    rc = bldr._sh(build_cmd)
    if rc != 0 {
        println("${mod_dir}: Lua extension build failed")
        bldr.fail(ctx, "lua extension build failed")
        return 1
    }
    bldr._write_artifact(ctx, "lua_extension", ext_path)

    // Optional host, only when no lua5.4 interpreter is on PATH.
    if bmap != null {
        if map.has(bmap, "lua_host_source") == 1 {
            if string.length(_lua54_interp()) == 0 {
                hsrc, _ = map.get(bmap, "lua_host_source")
                host_path = path.join(source_dir, "lua54")
                println("${mod_dir}: no lua5.4 on PATH — building bundled host")
                // The host DOES link liblua (it's the interpreter).
                host_cmd = "${cc} ${ccflags} ${cf} '${path.join(source_dir, hsrc)}' -o '${host_path}' ${lb} -lm -ldl"
                hrc = bldr._sh(host_cmd)
                if hrc != 0 {
                    println("${mod_dir}: bundled host build failed")
                    bldr.fail(ctx, "lua host build failed")
                    return 1
                }
                bldr._write_artifact(ctx, "lua_host", host_path)
            }
        }
    }
    return 0
}

builder c_extension(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")
    bldr._mkdirs(target_dir)

    rc = _build_lua_ext(ctx, _builder, source_dir, target_dir, mod_dir)
    if rc == 2 {
        reason = "Lua 5.4 headers not found (install liblua5.4-dev)"
        println("${mod_dir}: SKIPPED — ${reason}")
        bldr._record_skip(ctx, reason)
        return 0
    }
    if rc != 0 { return rc }
    _et = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// lua.conformance(b) — build the extension (via c_extension) then run the
// conformance .lua with LUA_CPATH/LUA_PATH set so `require` finds the built .so
// and the src .lua. SKIPs when no Lua 5.4 headers OR no interpreter (distro or
// the bundled ./lua54 host). Replaces lua/run_tests.sh.
builder conformance(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")
    bldr._mkdirs(target_dir)

    // Build the extension (+ optional host) via the shared helper — NOT the
    // c_extension builder, since a nested builder call wouldn't see _builder.
    brc = _build_lua_ext(ctx, _builder, source_dir, target_dir, mod_dir)
    if brc == 2 {
        reason = "Lua 5.4 headers not found (install liblua5.4-dev)"
        println("${mod_dir}: SKIPPED — ${reason}")
        bldr._record_skip(ctx, reason)
        return 0
    }
    if brc != 0 { return brc }

    // Interpreter: distro lua5.4, else the bundled ./lua54 host c_extension built.
    interp = _lua54_interp()
    if string.length(interp) == 0 {
        host_path = path.join(source_dir, "lua54")
        if file.exists(host_path) == 1 {
            interp = "'${host_path}'"
            println("${mod_dir}: using bundled ./lua54 host")
        } else {
            reason = "no Lua 5.4 interpreter (no lua5.4 on PATH, no bundled host)"
            println("${mod_dir}: SKIPPED — ${reason}")
            bldr._record_skip(ctx, reason)
            return 0
        }
    }

    conf = "test/conformance.lua"
    if _builder != null {
        if map.has(_builder, "lua_conformance") == 1 { conf, _ = map.get(_builder, "lua_conformance") }
    }

    println("${mod_dir}: running ${conf} (lua)")
    // ./?.so finds the extension; ./src/?.lua finds the pure-lua module.
    run_cmd = "cd '${source_dir}' && LUA_CPATH='./?.so;;' LUA_PATH='./src/?.lua;;' ${interp} '${conf}'"
    run_cmd = string.concat(bldr._env_export_prefix(_builder), run_cmd)
    rc = bldr._sh(run_cmd)
    if rc != 0 {
        bldr._record_test_result_exitcode(ctx, 0, 1)
        println("${mod_dir}: conformance FAILED")
        bldr.fail(ctx, "lua conformance failed")
        return 1
    }
    bldr._record_test_result_exitcode(ctx, 1, 0)
    println("${mod_dir}: conformance PASSED")
    return 0
}

// lua.test(b) — `busted` by default. Reports pass/fail telemetry.
builder test(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    mod_dir = bldr._get(ctx, "module_dir")
    println("${mod_dir}: running tests (lua)")
    return bldr._run_project(ctx, _builder, "busted", 1)
}

// --- consumer_example: stage a bundled package + consumer, run from clean ---

// stage("src/lib.rs", "pkg/src/lib.rs") — copy one file (src relative to the
// module source_dir, dest relative to the staging root under target_dir) into
// the clean staging tree. Repeatable; this is the package+consumer manifest as
// declarative data. Value is "src<TAB>dest".
stage(_ctx: ptr, src: string, dest: string) {
    if map.has(_ctx, "stage_pairs") == 0 { _e1 = map.put(_ctx, "stage_pairs", list.new()) }
    l, _ = map.get(_ctx, "stage_pairs")
    _e2 = list.add(l, string.concat(src, string.concat("\t", dest)))
}
// stage_dir("../go", "go-pkg", "example") — copy a whole dir (src relative to
// module source_dir) into staging as dest, optionally deleting a sub-path after
// (e.g. drop example/ from the packaged copy). Value is "src<TAB>dest<TAB>prune".
stage_dir(_ctx: ptr, src: string, dest: string, prune: string) {
    if map.has(_ctx, "stage_dirs") == 0 { _e1 = map.put(_ctx, "stage_dirs", list.new()) }
    l, _ = map.get(_ctx, "stage_dirs")
    _e2 = list.add(l, string.concat(src, string.concat("\t", string.concat(dest, string.concat("\t", prune)))))
}
// run_in("consumer") — the staging-relative dir to run from. Scalar.
run_in(_ctx: ptr, dir: string) {
    _e = map.put(_ctx, "run_in", dir)
}
// run_cmd("cargo run --offline --") — the base run command (an env-prefix + argv
// follows per run_arg). Default is the cargo form. Scalar.
run_cmd(_ctx: ptr, cmd: string) {
    _e = map.put(_ctx, "run_cmd", cmd)
}
// pre_cmd("nim c -r ... consumer.nim") — a build step run once in run_in before
// the per-arg runs (for compile-then-run languages). Scalar; optional.
pre_cmd(_ctx: ptr, cmd: string) {
    _e = map.put(_ctx, "pre_cmd", cmd)
}
// run_arg("ffi") — an argv for `cargo run --offline -- <arg>`. Repeatable.
run_arg(_ctx: ptr, arg: string) {
    if map.has(_ctx, "run_args") == 0 { _e1 = map.put(_ctx, "run_args", list.new()) }
    l, _ = map.get(_ctx, "run_args")
    _e2 = list.add(l, arg)
}
// assert_file("pkg/native/libselenium_core.so") — a staging-relative path that
// MUST exist after staging (the bundled asset). Repeatable.
assert_file(_ctx: ptr, path: string) {
    if map.has(_ctx, "assert_files") == 0 { _e1 = map.put(_ctx, "assert_files", list.new()) }
    l, _ = map.get(_ctx, "assert_files")
    _e2 = list.add(l, path)
}

// rust.consumer_example() — stage a clean bundled crate + a consumer crate (via
// stage() pairs), assert the bundled asset, then `cargo run --offline -- <arg>`
// in run_in with SELENIUM_CORE_LIB unset — so the consumer drives the engine via
// ONLY the crate's own bundled .so (no in-tree sibling). Deps the .package.ae.
builder consumer_example(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")
    bldr._mkdirs(target_dir)

    stageroot = path.join(target_dir, "stage")
    bldr._sh("rm -rf '${stageroot}' && mkdir -p '${stageroot}'")

    // stage the declared file pairs.
    if _builder != null {
        if map.has(_builder, "stage_pairs") == 1 {
            l, _ = map.get(_builder, "stage_pairs")
            n = list.size(l)
            i = 0
            while i < n {
                pair, _ = list.get(l, i)
                tab = string.index_of(pair, "\t")
                src = string.substring(pair, 0, tab)
                dest = string.substring(pair, tab + 1, string.length(pair))
                src_abs = path.join(source_dir, src)
                dest_abs = path.join(stageroot, dest)
                dest_parent = path.dirname(dest_abs)
                bldr._sh("mkdir -p '${dest_parent}' && cp -r '${src_abs}' '${dest_abs}'")
                i = i + 1
            }
        }
    }

    // stage whole dirs (cp -r), with an optional prune sub-path.
    if _builder != null {
        if map.has(_builder, "stage_dirs") == 1 {
            l, _ = map.get(_builder, "stage_dirs")
            n = list.size(l)
            i = 0
            while i < n {
                spec, _ = list.get(l, i)
                t1 = string.index_of(spec, "\t")
                sd_src = string.substring(spec, 0, t1)
                r1 = string.substring(spec, t1 + 1, string.length(spec))
                t2 = string.index_of(r1, "\t")
                sd_dest = string.substring(r1, 0, t2)
                sd_prune = string.substring(r1, t2 + 1, string.length(r1))
                src_abs = path.join(source_dir, sd_src)
                dest_abs = path.join(stageroot, sd_dest)
                bldr._sh("cp -r '${src_abs}' '${dest_abs}'")
                if string.length(sd_prune) > 0 {
                    bldr._sh("rm -rf '${dest_abs}/${sd_prune}'")
                }
                i = i + 1
            }
        }
    }

    // assert bundled files.
    if _builder != null {
        if map.has(_builder, "assert_files") == 1 {
            l, _ = map.get(_builder, "assert_files")
            n = list.size(l)
            i = 0
            while i < n {
                af, _ = list.get(l, i)
                if bldr._sh("ls '${stageroot}/${af}' >/dev/null 2>&1") != 0 {
                    println("${mod_dir}: staged package missing ${af}")
                    bldr.fail(ctx, "bundled asset missing after staging")
                    return 1
                }
                i = i + 1
            }
        }
    }

    run_dir = "consumer"
    if _builder != null {
        if map.has(_builder, "run_in") == 1 { run_dir, _ = map.get(_builder, "run_in") }
    }
    run_abs = path.join(stageroot, run_dir)
    run_command = "cargo run --offline --"
    if _builder != null {
        if map.has(_builder, "run_cmd") == 1 { run_command, _ = map.get(_builder, "run_cmd") }
    }
    // optional build step before the per-arg runs.
    if _builder != null {
        if map.has(_builder, "pre_cmd") == 1 {
            pc, _ = map.get(_builder, "pre_cmd")
            if string.length(pc) > 0 {
                if bldr._sh("cd '${run_abs}' && env -u SELENIUM_CORE_LIB ${pc}") != 0 {
                    println("${mod_dir}: consumer pre-build failed")
                    bldr.fail(ctx, "consumer pre-build failed")
                    return 1
                }
            }
        }
    }
    args = null
    if _builder != null {
        if map.has(_builder, "run_args") == 1 { args, _ = map.get(_builder, "run_args") }
    }
    if args == null {
        base = "cd '${run_abs}' && env -u SELENIUM_CORE_LIB ${run_command}"
        if bldr._sh(base) != 0 { bldr.fail(ctx, "consumer run failed"); return 1 }
    } else {
        na = list.size(args)
        ai = 0
        while ai < na {
            a, _ = list.get(args, ai)
            println("${mod_dir}: consumer run (${a})")
            one = "cd '${run_abs}' && env -u SELENIUM_CORE_LIB ${run_command} ${a}"
            if bldr._sh(one) != 0 {
                println("${mod_dir}: consumer run (${a}) failed")
                bldr.fail(ctx, "consumer run (${a}) failed")
                return 1
            }
            ai = ai + 1
        }
    }
    println("${mod_dir}: PASS — consumer drove the engine via the crate's bundled .so from clean")
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}
