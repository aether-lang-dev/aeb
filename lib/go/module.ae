// go — Go SDK for aether.build
import bldr
import cache
import std.string
import std.io
import std.os
import std.file
import std.fs
import std.list
import std.map
import std.path
import std.dir

// --- Go DSL setters ---

build_mode(_ctx: ptr, m: string) {
    _e = map.put(_ctx, "mode", m)
}

output_file(_ctx: ptr, f: string) {
    _e = map.put(_ctx, "output", f)
}

tags(_ctx: ptr, t: string) {
    _e = map.put(_ctx, "tags", t)
}

ldflags(_ctx: ptr, f: string) {
    _e = map.put(_ctx, "ldflags", f)
}

race(_ctx: ptr) {
    _e = map.put(_ctx, "race", "true")
}

// Set the Go package pattern (e.g. "./app/..." for subtree, "./..." for all)
pkg(_ctx: ptr, pattern: string) {
    _e = map.put(_ctx, "pkg_pattern", pattern)
}

env_var(_ctx: ptr, kv: string) {
    if map.has(_ctx, "env") == 1 {
        prev, _ = map.get(_ctx, "env")
        combined = string.concat(prev, " ")
        combined = string.concat(combined, kv)
        _e1 = map.put(_ctx, "env", combined)
    } else {
        _e2 = map.put(_ctx, "env", kv)
    }
}

run_filter(_ctx: ptr, pat: string) {
    _e = map.put(_ctx, "run", pat)
}

timeout(_ctx: ptr, dur: string) {
    _e = map.put(_ctx, "timeout", dur)
}

// --- Command builders ---

go_build_cmd(source_dir: string, out_path: string, opts: ptr) {
    env_prefix = ""
    if opts != null {
        if map.has(opts, "env") == 1 {
            env_prefix, _ = map.get(opts, "env")
            env_prefix = string.concat(env_prefix, " ")
        }
    }

    cmd = "cd ${source_dir} && ${env_prefix}go build"

    if opts != null {
        if map.has(opts, "mode") == 1 {
            val, _ = map.get(opts, "mode")
            cmd = string.concat(cmd, " -buildmode=${val}")
        }
        if map.has(opts, "tags") == 1 {
            val, _ = map.get(opts, "tags")
            cmd = string.concat(cmd, " -tags ${val}")
        }
        if map.has(opts, "ldflags") == 1 {
            val, _ = map.get(opts, "ldflags")
            cmd = string.concat(cmd, " -ldflags \"${val}\"")
        }
        if map.has(opts, "race") == 1 {
            cmd = string.concat(cmd, " -race")
        }
        if map.has(opts, "extra") == 1 {
            val, _ = map.get(opts, "extra")
            cmd = string.concat(cmd, " ${val}")
        }
    }

    cmd = string.concat(cmd, " -o ${out_path}")
    return cmd
}

// Turn a colon-joined dir list (as in LD_LIBRARY_PATH) into a CGO_LDFLAGS
// value: `-L<dir> -Wl,-rpath,<dir>` per dir. Used so a cgo binding links and
// runtime-locates a dep-provided .so without a hardcoded path.
_cgo_ldflags_from_ldpath(ld_path: string) {
    out = ""
    rest = ld_path
    guard = 0
    while string.length(rest) > 0 {
        if guard > 64 { break }
        guard = guard + 1
        idx = string.index_of(rest, ":")
        // Declare `d` before the if/else: a variable first-assigned inside
        // both arms is not in scope after the block in Aether, so reading it
        // below would be an undefined-variable error.
        d = ""
        if idx < 0 {
            d = rest
            rest = ""
        } else {
            d = string.substring(rest, 0, idx)
            rest = string.substring(rest, idx + 1, string.length(rest))
        }
        if string.length(d) > 0 {
            frag = "-L${d} -Wl,-rpath,${d}"
            if string.length(out) > 0 { out = string.concat(out, " ") }
            out = string.concat(out, frag)
        }
    }
    return out
}

go_test_cmd(source_dir: string, ld_path: string, opts: ptr) {
    env_prefix = ""
    if string.length(ld_path) > 0 {
        dyld_var = bldr._dyld_env_var()
        env_prefix = "${dyld_var}=${ld_path} "
        // Thread the dep shared-lib dirs into CGO_LDFLAGS so a cgo binding LINKS
        // against an aeb-built .so (e.g. an engine node's shared_lib) without
        // hardcoding its path in `#cgo LDFLAGS`. Each colon-separated dir in
        // ld_path becomes `-L<dir>` (build-time link) + `-Wl,-rpath,<dir>`
        // (so the test binary self-locates the .so at runtime too). `ld_path`
        // already carries every dep's shared-lib dir (see the go_test builder).
        cgo = _cgo_ldflags_from_ldpath(ld_path)
        env_prefix = string.concat(env_prefix, "CGO_LDFLAGS='${cgo}' ")
    }
    if opts != null {
        if map.has(opts, "env") == 1 {
            val, _ = map.get(opts, "env")
            env_prefix = string.concat(env_prefix, val)
            env_prefix = string.concat(env_prefix, " ")
        }
    }

    cmd = "cd ${source_dir} && ${env_prefix}go test"

    if opts != null {
        if map.has(opts, "verbose") == 1 {
            cmd = string.concat(cmd, " -v")
        }
        if map.has(opts, "race") == 1 {
            cmd = string.concat(cmd, " -race")
        }
        if map.has(opts, "run") == 1 {
            val, _ = map.get(opts, "run")
            cmd = string.concat(cmd, " -run ${val}")
        }
        if map.has(opts, "timeout") == 1 {
            val, _ = map.get(opts, "timeout")
            cmd = string.concat(cmd, " -timeout ${val}")
        }
        if map.has(opts, "extra") == 1 {
            val, _ = map.get(opts, "extra")
            cmd = string.concat(cmd, " ${val}")
        }
    } else {
        cmd = string.concat(cmd, " -v")
    }

    // Package pattern: default "." (current dir only)
    pkg_pat = "."
    if opts != null {
        if map.has(opts, "pkg_pattern") == 1 {
            pkg_pat, _ = map.get(opts, "pkg_pattern")
        }
    }
    cmd = string.concat(cmd, " ${pkg_pat}")
    return cmd
}

// _go_version() — `go version`, memoised per build via an env-var
// cache. Returns "" when go is absent.
_go_version() {
    cached = os.getenv("_AEB_GO_VERSION_CACHE")
    if string.length(cached) > 0 { return cached }
    raw, _err = bldr._sh_capture("go version 2>&1 | head -1")
    return string.trim(raw)
}

// _cache_key_for_go — cache key for a go_build action. The output is a
// single binary/.so, cached as one file (not a tar). Inputs
// (length-prefixed, sorted via cache.hash_inputs):
//   - go version — toolchain-bump invalidator
//   - canonical go build command string — buildmode, tags, ldflags,
//     race, env prefix, -o
//   - each .go source's path + content hash, sorted by path
//   - go.mod + go.sum content — the cheap correct proxy for the module
//     graph without parsing it (a dep version bump shows up here)
//   - each dep's shared_library_deps_including_transitive content
//
// NOTE: lower marginal value than the JVM SDKs — go has its own build
// cache ($GOCACHE), so this mainly buys telemetry [hit] parity and
// cross-machine warm starts (skipping the `go build` fork entirely).
//
// Returns ("", err) on any source read failure.
_cache_key_for_go(ctx: ptr, argfile_path: string, go_build_cmd_str: string, source_dir: string) {
    parts = list.new()

    list.add(parts, string.concat("go:", _go_version()))
    list.add(parts, string.concat("cmd:", go_build_cmd_str))

    sources = bldr._read_argfile_lines(argfile_path)
    nsrc = list.size(sources)
    si = 0
    while si < nsrc {
        src, _ = list.get(sources, si)
        sh, serr = cache.hash_file(src)
        if string.length(serr) > 0 {
            return "", serr
        }
        list.add(parts, string.concat("src:", src))
        list.add(parts, string.concat("src-hash:", sh))
        si = si + 1
    }

    gomod = path.join(source_dir, "go.mod")
    if file.exists(gomod) == 1 {
        mh, mherr = cache.hash_file(gomod)
        if string.length(mherr) == 0 {
            list.add(parts, string.concat("go.mod:", mh))
        }
    }
    gosum = path.join(source_dir, "go.sum")
    if file.exists(gosum) == 1 {
        sumh, sumherr = cache.hash_file(gosum)
        if string.length(sumherr) == 0 {
            list.add(parts, string.concat("go.sum:", sumh))
        }
    }

    deps, _ = map.get(ctx, "deps")
    dn = list.size(deps)
    di = 0
    while di < dn {
        dp, _ = list.get(deps, di)
        dm = bldr._strip_lang(dp)
        dep_sh = bldr._read_dep_artifact(ctx, dm, "shared_library_deps_including_transitive")
        if string.length(dep_sh) > 0 {
            list.add(parts, string.concat("dep:", dm))
            list.add(parts, string.concat("dep-sh:", dep_sh))
        }
        di = di + 1
    }

    digest, derr = cache.hash_inputs(parts)
    return digest, derr
}

// --- SDK functions ---

// Compile-check Go packages without producing a binary.
// Useful for library packages and large single-module repos.
builder check(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")
    root = bldr._get(ctx, "root")

    bldr._mkdirs(target_dir)

    ts_file = path.join(target_dir, ".timestamp")
    if bldr._needs_rebuild(source_dir, ts_file) == 0 {
        println("${mod_dir}: skipping Go compile check (not changed)")
        return 0
    }

    println("${mod_dir}: compiling (go)")

    // Determine package pattern
    pkg_pat = "./..."
    if _builder != null {
        if map.has(_builder, "pkg_pattern") == 1 {
            pkg_pat, _ = map.get(_builder, "pkg_pattern")
        }
    }

    cmd = "cd '${root}' && go build ${pkg_pat}"
    exit_code = bldr._sh(cmd)
    if exit_code != 0 {
        println("${mod_dir}: go build failed")
        return exit_code
    }

    _e = io.write_file(ts_file, "")
    return 0
}

builder go_build(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")

    lib_dir = path.join(target_dir, "lib")
    bldr._mkdirs(lib_dir)
    ts_file = path.join(lib_dir, ".timestamp")

    println("${mod_dir}: compiling Go prod & test code")

    out_name = ""
    if _builder != null {
        if map.has(_builder, "output") == 1 {
            out_name, _ = map.get(_builder, "output")
        }
    }
    if string.length(out_name) == 0 {
        println("${mod_dir}: output_file() is required for go_build")
        return 1
    }
    // A bare executable name (no extension) gets the host exe suffix on
    // Windows so the recorded path matches what `go build` produces; a
    // shared-lib output (libfoo.so / .dll) already carries its extension and
    // is left untouched (the .so↔.dll cross-platform story is separate).
    if string.index_of(out_name, ".") < 0 {
        out_name = string.concat(out_name, bldr._exe_suffix())
    }
    out_path = path.join(lib_dir, out_name)
    bld_cmd = go_build_cmd(source_dir, out_path, _builder)

    // Source set for the cache key (every .go under source_dir).
    argfile = path.join(target_dir, "go_sources.txt")
    bldr._sh("find '${source_dir}' -name '*.go' > '${argfile}' 2>/dev/null || true")

    // Cache check: the output is a single file, restored directly on a
    // hit (no tar). exit_code sentinel: 0 = hit, -1 = build below.
    cache_key = ""
    exit_code = -1
    if cache.available() == 1 {
        ck, kerr = _cache_key_for_go(ctx, argfile, bld_cmd, source_dir)
        if string.length(kerr) == 0 {
            cache_key = ck
            grc = cache.get(cache_key, out_path)
            if string.length(grc) == 0 {
                bldr._sh("chmod +x '${out_path}' 2>/dev/null || true")
                println("${mod_dir}: go build cache hit ${cache_key}")
                bldr._record_cache(ctx, "hit")
                exit_code = 0
            }
        }
    }

    if exit_code == -1 {
        if cache.available() == 0 {
            bldr._record_cache(ctx, "unavailable")
        } else {
            bldr._record_cache(ctx, "miss")
        }
        bldr._sh("cd ${source_dir} && go mod tidy")
        exit_code = bldr._sh(bld_cmd)
        if exit_code != 0 {
            println("${mod_dir}: go build failed")
            bldr.fail(ctx, "go build failed")
            return exit_code
        }
        if string.length(cache_key) > 0 {
            perr = cache.put(cache_key, out_path)
            if string.length(perr) > 0 {
                println("${mod_dir}: go build cache write failed: ${perr}")
            }
        }
    }

    bldr._write_artifact(ctx, "ldlibdeps", out_path)

    deps, _ = map.get(ctx, "deps")
    shared_libs = string.concat(out_path, "")
    dep_count = list.size(deps)
    n = 0
    while n < dep_count {
        dp4, _ = list.get(deps, n)
        dm4 = bldr._strip_lang(dp4)
        dep_sh = bldr._read_dep_artifact(ctx, dm4, "shared_library_deps_including_transitive")
        if string.length(dep_sh) > 0 {
            shared_libs = string.concat(string.concat(shared_libs, "\n"), dep_sh)
        }
        n = n + 1
    }
    bldr._write_artifact(ctx, "shared_library_deps_including_transitive", shared_libs)

    _ets = io.write_file(ts_file, "")
    return 0
}

builder go_test(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    mod_dir = bldr._get(ctx, "module_dir")
    deps, _ = map.get(ctx, "deps")

    ld_path = ""
    dep_count = list.size(deps)
    g = 0
    while g < dep_count {
        dp5, _ = list.get(deps, g)
        dm5 = bldr._strip_lang(dp5)
        dep_sh = bldr._read_dep_artifact(ctx, dm5, "shared_library_deps_including_transitive")
        if string.length(dep_sh) > 0 {
            sh_raw, _esh = bldr._sh_capture("dirname ${dep_sh} | head -1")
            sh_dir = string.trim(sh_raw)
            if string.length(ld_path) > 0 {
                ld_path = string.concat(string.concat(ld_path, ":"), sh_dir)
            } else {
                ld_path = sh_dir
            }
        }
        g = g + 1
    }

    println("${mod_dir}: running Go tests")
    // For mono-module repos with pkg(), run tests from root so go.mod is found
    test_cmd = go_test_cmd(source_dir, ld_path, _builder)
    if _builder != null {
        if map.has(_builder, "pkg_pattern") == 1 {
            root = bldr._get(ctx, "root")
            test_cmd = go_test_cmd(root, ld_path, _builder)
        }
    }
    exit_code = bldr._sh(test_cmd)
    if exit_code != 0 {
        // Default `go test` output doesn't include sub-test counts
        // (only -v does). Record coarse pass/fail. Future: parse
        // `--- PASS:` / `--- FAIL:` lines when -v is set.
        bldr._record_test_result(ctx, 0, 1)
        println("${mod_dir}: Go tests FAILED")
        return exit_code
    }
    bldr._record_test_result(ctx, 1, 0)
    println("${mod_dir}: Go tests PASSED")
    return 0
}

// --- consumer_example: stage a bundled package + consumer, run from clean ---

// stage("src/lib.rs", "pkg/src/lib.rs") — copy one file (src relative to the
// module source_dir, dest relative to the staging root under target_dir) into
// the clean staging tree. Repeatable; this is the package+consumer manifest as
// declarative data. Value is "src<TAB>dest".
stage(_ctx: ptr, src: string, dest: string) {
    if map.has(_ctx, "stage_pairs") == 0 { _e1 = map.put(_ctx, "stage_pairs", list.new()) }
    l, _ = map.get(_ctx, "stage_pairs")
    _e2 = list.add(l, string.concat(src, string.concat("\t", dest)))
}
// stage_dir("../go", "go-pkg", "example") — copy a whole dir (src relative to
// module source_dir) into staging as dest, optionally deleting a sub-path after
// (e.g. drop example/ from the packaged copy). Value is "src<TAB>dest<TAB>prune".
stage_dir(_ctx: ptr, src: string, dest: string, prune: string) {
    if map.has(_ctx, "stage_dirs") == 0 { _e1 = map.put(_ctx, "stage_dirs", list.new()) }
    l, _ = map.get(_ctx, "stage_dirs")
    _e2 = list.add(l, string.concat(src, string.concat("\t", string.concat(dest, string.concat("\t", prune)))))
}
// run_in("consumer") — the staging-relative dir to run from. Scalar.
run_in(_ctx: ptr, dir: string) {
    _e = map.put(_ctx, "run_in", dir)
}
// run_cmd("cargo run --offline --") — the base run command (an env-prefix + argv
// follows per run_arg). Default is the cargo form. Scalar.
run_cmd(_ctx: ptr, cmd: string) {
    _e = map.put(_ctx, "run_cmd", cmd)
}
// pre_cmd("nim c -r ... consumer.nim") — a build step run once in run_in before
// the per-arg runs (for compile-then-run languages). Scalar; optional.
pre_cmd(_ctx: ptr, cmd: string) {
    _e = map.put(_ctx, "pre_cmd", cmd)
}
// run_arg("ffi") — an argv for `cargo run --offline -- <arg>`. Repeatable.
run_arg(_ctx: ptr, arg: string) {
    if map.has(_ctx, "run_args") == 0 { _e1 = map.put(_ctx, "run_args", list.new()) }
    l, _ = map.get(_ctx, "run_args")
    _e2 = list.add(l, arg)
}
// assert_file("pkg/native/libselenium_core.so") — a staging-relative path that
// MUST exist after staging (the bundled asset). Repeatable.
assert_file(_ctx: ptr, path: string) {
    if map.has(_ctx, "assert_files") == 0 { _e1 = map.put(_ctx, "assert_files", list.new()) }
    l, _ = map.get(_ctx, "assert_files")
    _e2 = list.add(l, path)
}

// rust.consumer_example() — stage a clean bundled crate + a consumer crate (via
// stage() pairs), assert the bundled asset, then `cargo run --offline -- <arg>`
// in run_in with SELENIUM_CORE_LIB unset — so the consumer drives the engine via
// ONLY the crate's own bundled .so (no in-tree sibling). Deps the .package.ae.
builder consumer_example(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")
    bldr._mkdirs(target_dir)

    stageroot = path.join(target_dir, "stage")
    bldr._sh("rm -rf '${stageroot}' && mkdir -p '${stageroot}'")

    // stage the declared file pairs.
    if _builder != null {
        if map.has(_builder, "stage_pairs") == 1 {
            l, _ = map.get(_builder, "stage_pairs")
            n = list.size(l)
            i = 0
            while i < n {
                pair, _ = list.get(l, i)
                tab = string.index_of(pair, "\t")
                src = string.substring(pair, 0, tab)
                dest = string.substring(pair, tab + 1, string.length(pair))
                src_abs = path.join(source_dir, src)
                dest_abs = path.join(stageroot, dest)
                dest_parent = path.dirname(dest_abs)
                bldr._sh("mkdir -p '${dest_parent}' && cp -r '${src_abs}' '${dest_abs}'")
                i = i + 1
            }
        }
    }

    // stage whole dirs (cp -r), with an optional prune sub-path.
    if _builder != null {
        if map.has(_builder, "stage_dirs") == 1 {
            l, _ = map.get(_builder, "stage_dirs")
            n = list.size(l)
            i = 0
            while i < n {
                spec, _ = list.get(l, i)
                t1 = string.index_of(spec, "\t")
                sd_src = string.substring(spec, 0, t1)
                r1 = string.substring(spec, t1 + 1, string.length(spec))
                t2 = string.index_of(r1, "\t")
                sd_dest = string.substring(r1, 0, t2)
                sd_prune = string.substring(r1, t2 + 1, string.length(r1))
                src_abs = path.join(source_dir, sd_src)
                dest_abs = path.join(stageroot, sd_dest)
                bldr._sh("cp -r '${src_abs}' '${dest_abs}'")
                if string.length(sd_prune) > 0 {
                    bldr._sh("rm -rf '${dest_abs}/${sd_prune}'")
                }
                i = i + 1
            }
        }
    }

    // assert bundled files.
    if _builder != null {
        if map.has(_builder, "assert_files") == 1 {
            l, _ = map.get(_builder, "assert_files")
            n = list.size(l)
            i = 0
            while i < n {
                af, _ = list.get(l, i)
                if bldr._sh("ls '${stageroot}/${af}' >/dev/null 2>&1") != 0 {
                    println("${mod_dir}: staged package missing ${af}")
                    bldr.fail(ctx, "bundled asset missing after staging")
                    return 1
                }
                i = i + 1
            }
        }
    }

    run_dir = "consumer"
    if _builder != null {
        if map.has(_builder, "run_in") == 1 { run_dir, _ = map.get(_builder, "run_in") }
    }
    run_abs = path.join(stageroot, run_dir)
    run_command = "cargo run --offline --"
    if _builder != null {
        if map.has(_builder, "run_cmd") == 1 { run_command, _ = map.get(_builder, "run_cmd") }
    }
    // optional build step before the per-arg runs.
    if _builder != null {
        if map.has(_builder, "pre_cmd") == 1 {
            pc, _ = map.get(_builder, "pre_cmd")
            if string.length(pc) > 0 {
                if bldr._sh("cd '${run_abs}' && env -u SELENIUM_CORE_LIB ${pc}") != 0 {
                    println("${mod_dir}: consumer pre-build failed")
                    bldr.fail(ctx, "consumer pre-build failed")
                    return 1
                }
            }
        }
    }
    base = "cd '${run_abs}' && env -u SELENIUM_CORE_LIB ${run_command}"
    args = null
    if _builder != null {
        if map.has(_builder, "run_args") == 1 { args, _ = map.get(_builder, "run_args") }
    }
    if args == null {
        if bldr._sh(base) != 0 { bldr.fail(ctx, "consumer run failed"); return 1 }
    } else {
        na = list.size(args)
        ai = 0
        while ai < na {
            a, _ = list.get(args, ai)
            println("${mod_dir}: consumer run (${a})")
            if bldr._sh("${base} ${a}") != 0 {
                println("${mod_dir}: consumer run (${a}) failed")
                bldr.fail(ctx, "consumer run (${a}) failed")
                return 1
            }
            ai = ai + 1
        }
    }
    println("${mod_dir}: PASS — consumer drove the engine via the crate's bundled .so from clean")
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}
