// cache — Content-addressable build artifact cache.
//
//   - sha256-keyed hashing of inputs (file contents, dep manifests, flags)
//   - zlib-compressed storage under $AEB_CACHE_DIR (or ~/.aeb/cache)
//   - put / get / has lookups against the local store
//
// REMOTE CACHE (shared, cross-machine). When $AEB_REMOTE_CACHE_URL names
// a shared store, get/put transparently consult it BEHIND the local
// store — no SDK changes, since every SDK already calls cache.get/put.
//   - read path:  local hit → return; else pull the blob from the remote
//     into the local store, then serve locally; else miss.
//   - write path: write local; then push the blob to the remote.
// The remote stores the SAME zlib-compressed blobs as local under the
// same sha256 sharding, so the two stores are interchangeable CAS.
//
// Backend (v1): a shared FILESYSTEM root — $AEB_REMOTE_CACHE_URL is
// `file:///abs/path` or a plain `/abs/path` (an NFS mount, a shared CI
// volume, a container bind-mount). This is the equivalent of Bazel's
// `--disk_cache` / Buck2's disk cache, and the substrate the HTTP/S3
// backend (TODO) plugs into behind the same _remote_pull/_remote_push
// seam. `http(s)://` URLs are recognised but not yet wired — they no-op
// (filesystem-only for now), so an http URL safely disables the remote.
//
// $AEB_REMOTE_CACHE_MODE = off | read | write | readwrite (default
// readwrite when a URL is set, off otherwise). CI runners typically
// `write`; developer machines `read`. Every remote op is BEST-EFFORT:
// a remote failure degrades to a local miss / a missed upload and NEVER
// fails the build.
//
// Returns ("", "cache unavailable") when the toolchain was built
// without OpenSSL or zlib — callers should fall back to the existing
// timestamp cache rather than failing the build.

import std.string
import std.io
import std.os
import std.file
import std.fs
import std.list
import std.path
import std.cryptography
import std.zlib

// available() — 1 if both sha256 (OpenSSL) and zlib are linked into
// the toolchain, 0 otherwise. Cheap to call; caller should check once
// at startup and disable cache lookups for the duration of the build
// rather than retrying every entry.
available() {
    if zlib.available() == 0 { return 0 }
    // Probe sha256 by hashing the empty buffer — returns "" + err when
    // OpenSSL is unavailable, a 64-char digest otherwise.
    digest, err = cryptography.sha256_hex("", 0)
    if string.length(err) > 0 { return 0 }
    return 1
}

// dir() — local cache root. $AEB_CACHE_DIR if set, else $HOME/.aeb/cache.
// Falls back to ./.aeb/cache when $HOME is unset (CI sandboxes).
dir() {
    env_dir = os.getenv("AEB_CACHE_DIR")
    if string.length(env_dir) > 0 {
        return env_dir
    }
    home = os.getenv("HOME")
    if string.length(home) == 0 {
        return ".aeb/cache"
    }
    return path.join(path.join(home, ".aeb"), "cache")
}

// path(hash) — shard the cache into 256 directories by the digest's
// first two hex chars. Keeps any single directory under typical
// inode limits even at millions of entries — same trick git, the
// CAS, and apt object stores use.
path(hash: string) {
    n = string.length(hash)
    if n < 2 { return path.join(dir(), hash) }
    prefix = string.substring(hash, 0, 2)
    rest = string.substring(hash, 2, n)
    return path.join(path.join(dir(), prefix), rest)
}

// --- Remote cache (shared filesystem backend) -----------------------
//
// The config helpers come in two layers: a PURE `_of(...)` core (takes
// the url/mode as arguments, unit-testable) and a thin env wrapper. The
// pull/push helpers operate on the local blob file at path(hash) and the
// remote blob at _remote_fs_path(hash), so they move exactly the bytes
// the local store already holds (compressed) — binary-safe, no string
// round-trip.

// _remote_fs_root_of(url) — the filesystem root for a remote URL, or ""
// when the URL is empty or a (not-yet-wired) http(s) backend. `file://`
// is stripped; a plain path passes through. PURE.
_remote_fs_root_of(url: string) {
    if string.length(url) == 0 { return "" }
    if string.starts_with(url, "file://") == 1 {
        return string.substring(url, 7, string.length(url))
    }
    if string.starts_with(url, "http://") == 1 { return "" }
    if string.starts_with(url, "https://") == 1 { return "" }
    return url
}

// _remote_read_enabled_of(mode, url) / _remote_write_enabled_of(mode, url)
// — resolve the effective mode. Empty mode defaults to readwrite when a
// URL is present, else off. PURE.
_remote_effective_mode_of(mode: string, url: string) {
    if string.length(mode) > 0 { return mode }
    if string.length(url) > 0 { return "readwrite" }
    return "off"
}
_remote_read_enabled_of(mode: string, url: string) {
    m = _remote_effective_mode_of(mode, url)
    if string.equals(m, "read") == 1 { return 1 }
    if string.equals(m, "readwrite") == 1 { return 1 }
    return 0
}
_remote_write_enabled_of(mode: string, url: string) {
    m = _remote_effective_mode_of(mode, url)
    if string.equals(m, "write") == 1 { return 1 }
    if string.equals(m, "readwrite") == 1 { return 1 }
    return 0
}

// Env wrappers.
_remote_url() { return os.getenv("AEB_REMOTE_CACHE_URL") }
_remote_read_enabled() { return _remote_read_enabled_of(os.getenv("AEB_REMOTE_CACHE_MODE"), _remote_url()) }
_remote_write_enabled() { return _remote_write_enabled_of(os.getenv("AEB_REMOTE_CACHE_MODE"), _remote_url()) }

// _remote_fs_path(hash) — sharded blob path under the remote root, or
// "" when no filesystem remote is configured. Mirrors path().
_remote_fs_path(hash: string) {
    root = _remote_fs_root_of(_remote_url())
    if string.length(root) == 0 { return "" }
    n = string.length(hash)
    if n < 2 { return path.join(root, hash) }
    prefix = string.substring(hash, 0, 2)
    rest = string.substring(hash, 2, n)
    return path.join(path.join(root, prefix), rest)
}

// _remote_has(hash) — 1 if read is enabled and the remote holds the blob.
_remote_has(hash: string) {
    if _remote_read_enabled() == 0 { return 0 }
    rp = _remote_fs_path(hash)
    if string.length(rp) == 0 { return 0 }
    return file.exists(rp)
}

// _copy_atomic(src, dest) — copy src to dest atomically (temp + rename) so a
// concurrent reader never sees a torn file. Returns 1 on success. Best-effort:
// any failure returns 0 (caller degrades gracefully).
//
// PURE fs (was a mktemp/cp/mv shell pipeline). fs.write_atomic already does the
// sibling-temp-then-rename dance internally, so read the bytes and write them
// atomically — no shell, binary-safe (read_binary preserves embedded NULs),
// and Windows-correct (the shell version's `mktemp '$parent/.aebrc.XXXXXX'`
// and `cp`/`mv` all break under cmd.exe). lib/cache does NOT import build, so
// it uses fs directly rather than the build._sh chokepoint — and this is the
// better fix anyway (no subprocess at all for a file copy).
_copy_atomic(src: string, dest: string) {
    parent = path.dirname(dest)
    merr = fs.mkdir_p(parent)
    if string.length(merr) > 0 { return 0 }
    bytes, length, rerr = fs.read_binary(src)
    if rerr != "" { return 0 }
    werr = fs.write_atomic(dest, bytes, length)
    if werr != "" { return 0 }
    return 1
}

// _remote_pull(hash) — populate the local store from the remote. 1 if
// the local store now holds the blob. Best-effort.
_remote_pull(hash: string) {
    if _remote_read_enabled() == 0 { return 0 }
    rp = _remote_fs_path(hash)
    if string.length(rp) == 0 { return 0 }
    if file.exists(rp) == 0 { return 0 }
    return _copy_atomic(rp, path(hash))
}

// _remote_push(hash) — upload the local blob to the remote. Idempotent
// (no-op when the remote already has it). Best-effort.
_remote_push(hash: string) {
    if _remote_write_enabled() == 0 { return 0 }
    rp = _remote_fs_path(hash)
    if string.length(rp) == 0 { return 0 }
    src = path(hash)
    if file.exists(src) == 0 { return 0 }
    if file.exists(rp) == 1 { return 1 }
    return _copy_atomic(src, rp)
}

// has(hash) — does the cache contain an entry for this hash? Consults
// the remote (read-enabled) when the local store misses.
has(hash: string) {
    if file.exists(path(hash)) == 1 { return 1 }
    return _remote_has(hash)
}

// hash_file(path) — sha256 hex digest of a file's bytes. Binary-safe
// (uses fs.read_binary so embedded NULs survive). Returns
// ("", err_msg) on read or hash failure — callers should treat any
// non-empty err as cache-miss and fall through to a fresh build.
hash_file(p: string) {
    bytes, length, rerr = fs.read_binary(p)
    if string.length(rerr) > 0 {
        return "", rerr
    }
    return cryptography.sha256_hex(bytes, length)
}

// hash_inputs(parts) — sha256 of length-prefixed concatenation of
// `parts`, a list of strings. The length prefix matters: without it,
// inputs ["ab", "c"] and ["a", "bc"] would collide. Format per part:
//   <decimal-byte-length> ":" <bytes>
// e.g. ["foo", "bar"] -> "3:foo3:bar"
//
// Caller decides what's a part. Typical recipe:
//   - For each source file: filename + "\0" + sha256(content)
//   - For each transitive dep: the dep's *_deps_including_transitive
//     file content (already hashed by the dep's own cache.put)
//   - For each compiler flag: the flag string verbatim
//   - Sort the parts before passing in so hash is order-independent
hash_inputs(parts: ptr) {
    n = list.size(parts)
    buf = ""
    i = 0
    while i < n {
        part, _ = list.get(parts, i)
        len_str = string.from_int(string.length(part))
        buf = string.concat(buf, len_str)
        buf = string.concat(buf, ":")
        buf = string.concat(buf, part)
        i = i + 1
    }
    return cryptography.sha256_hex(buf, string.length(buf))
}

// put(hash, src_path) — read src_path, deflate, write to path(hash).
// Idempotent: if path(hash) already exists this is a no-op.
// Returns "" on success or hit, error string on read/deflate/write
// failure. Uses fs.write_atomic for the put so a Ctrl-C between
// downloaders mid-write can't leave a torn cache file that subsequent
// builds would zlib.inflate-then-fail on.
put(hash: string, src_path: string) {
    dest = path(hash)
    if file.exists(dest) == 1 {
        // Already local — still push so a write-enabled remote (e.g. a
        // CI runner) shares it even when this build didn't recompute it.
        _remote_push(hash)
        return ""
    }

    bytes, length, rerr = fs.read_binary(src_path)
    if string.length(rerr) > 0 {
        return rerr
    }

    // -1 picks zlib's default level (typically 6). The corpus most
    // likely to land here is a mix of already-compressed jars and
    // plain-text classpath manifests — default tuned for both.
    compressed, clen, cerr = zlib.deflate(bytes, length, -1)
    if string.length(cerr) > 0 {
        return cerr
    }

    // Make sure the shard directory exists before writing.
    parent = path.dirname(dest)
    merr = fs.mkdir_p(parent)
    if string.length(merr) > 0 {
        return merr
    }

    werr = fs.write_atomic(dest, compressed, clen)
    if string.length(werr) == 0 {
        // Write-through to the shared remote. Best-effort.
        _remote_push(hash)
    }
    return werr
}

// get(hash, dest_path) — fetch from the cache, decompress, write to
// dest_path. Returns "miss" if the cache doesn't have the entry, ""
// on success, or some other error string on transport / decompress
// failure. dest_path is overwritten via fs.write_atomic so a partial
// decompress can't leave dest_path in a torn state.
get(hash: string, dest_path: string) {
    src = path(hash)
    if file.exists(src) == 0 {
        // Local miss — try the shared remote, populating the local store.
        _remote_pull(hash)
    }
    if file.exists(src) == 0 {
        return "miss"
    }

    bytes, length, rerr = fs.read_binary(src)
    if string.length(rerr) > 0 {
        return rerr
    }

    decompressed, dlen, derr = zlib.inflate(bytes, length)
    if string.length(derr) > 0 {
        return derr
    }

    return fs.write_atomic(dest_path, decompressed, dlen)
}

// put_string(hash, value) — string-shaped put, skipping the
// filesystem round-trip needed when the artifact is just a string
// (e.g. a Maven classpath). Idempotent: a hit short-circuits.
put_string(hash: string, value: string) {
    dest = path(hash)
    if file.exists(dest) == 1 {
        _remote_push(hash)
        return ""
    }

    compressed, clen, cerr = zlib.deflate(value, string.length(value), -1)
    if string.length(cerr) > 0 {
        return cerr
    }

    parent = path.dirname(dest)
    merr = fs.mkdir_p(parent)
    if string.length(merr) > 0 {
        return merr
    }

    werr = fs.write_atomic(dest, compressed, clen)
    if string.length(werr) == 0 {
        _remote_push(hash)
    }
    return werr
}

// get_string(hash) -> (value, err) — string-shaped get. Returns
// ("", "miss") when not cached, ("", err_msg) on transport /
// decompress failure, or (value, "") on hit.
//
// CONSTRAINT: text-only payloads. The returned value is normalised
// to a plain C string via string.concat (the standard
// "snapshot a borrowed TLS buffer" idiom, strlen-based) so callers
// can pass it through `==` and printf without seeing AetherString
// header bytes. Embedded NULs in the cached payload would be
// truncated at the first NUL — for binary artifacts (jars, .so,
// .class trees) use the file-shaped get/put pair instead.
get_string(hash: string) {
    src = path(hash)
    if file.exists(src) == 0 {
        _remote_pull(hash)
    }
    if file.exists(src) == 0 {
        return "", "miss"
    }

    bytes, length, rerr = fs.read_binary(src)
    if string.length(rerr) > 0 {
        return "", rerr
    }

    decompressed, dlen, derr = zlib.inflate(bytes, length)
    if string.length(derr) > 0 {
        return "", derr
    }

    // Normalise the AetherString pointer to a plain char* for
    // strlen-based consumers (printf, strcmp, the `==` operator).
    return string.concat(decompressed, ""), ""
}
