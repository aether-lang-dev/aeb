// dart — Dart SDK for aether.build
//
// Resolves package deps via `dart pub get`, static-analyses via
// `dart analyze`, runs tests via `dart test`, compiles native/exe/JS
// artifacts via `dart compile`, and runs code generators (typically
// `build_runner`) with explicit input/output tracking.
//
// Style mirror: lib/python/module.ae. The codegen surface
// (codegen_* setters + the staleness check) is the same contract as
// python.codegen — "this generator reads exactly these files and
// writes exactly these outputs" — because the failure mode it guards
// (silent staleness from a GLOB-based input list) is identical in
// Dart's build_runner world.
//
// No venv equivalent: Dart uses the system `dart` SDK on PATH plus a
// per-project `.dart_tool/package_config.json` materialised by
// `dart pub get`. So where python._ensure_venv creates an isolated
// interpreter, dart just runs `dart pub get` in source_dir and lets
// the SDK manage `.dart_tool/`.
import bldr
import std.string
import std.io
import std.os
import std.file
import std.fs
import std.list
import std.map
import std.path
import std.dir

// --- DSL setters ---

// dart_bin("dart") — override the dart SDK executable. Default "dart"
// (resolved on PATH). Use to pin a specific SDK (e.g. a Flutter-
// bundled dart, or an absolute path to a versioned SDK).
dart_bin(_ctx: ptr, bin: string) {
    _e = map.put(_ctx, "dart_bin", bin)
}

// offline() — pass `--offline` to `dart pub get` so resolution uses
// only the local pub cache (no network). Any non-empty value enables.
offline(_ctx: ptr, v: string) {
    _e = map.put(_ctx, "offline", v)
}

// --- DSL setters: analyze ---

// analyze_flag("--no-fatal-infos") — one verbatim flag passed to
// `dart analyze` / `flutter analyze`. Repeatable. The escape hatch for
// analyzer knobs without a named setter — chiefly `--no-fatal-infos`
// (dart analyze already treats infos as non-fatal, but `flutter analyze`
// makes them fatal by default, so a lone `sort_pub_dependencies` info
// fails an otherwise-clean flutter package). Also `--fatal-warnings`,
// `--fatal-infos`. Greppable literal; no shell, no flag-string smuggling.
analyze_flag(_ctx: ptr, flag: string) {
    if map.has(_ctx, "analyze_flags") == 0 {
        _e1 = map.put(_ctx, "analyze_flags", list.new())
    }
    l, _ = map.get(_ctx, "analyze_flags")
    _a = list.add(l, flag)
}

// --- DSL setters: test ---

// test_path("test") — restrict `dart test` to a path (file or dir),
// relative to source_dir. Default: dart test's own discovery (the
// whole `test/` dir). Repeatable callers should prefer one path; the
// last call wins (scalar).
test_path(_ctx: ptr, path: string) {
    _e = map.put(_ctx, "test_path", path)
}

// concurrency(N) — `dart test -j N`: cap the number of concurrently-running
// test suites. concurrency(1) serialises (the right call when tests share
// process-global state — e.g. a native VCR server bound to one port). Scalar;
// last wins. Default: dart's own concurrency (≈ #cores).
concurrency(_ctx: ptr, n: int) {
    _e = map.put(_ctx, "test_concurrency", string.from_int(n))
}

// test_name("substring") — `--name <substring>`: run only tests whose
// description matches. Repeatable; each adds another `--name` (dart ANDs
// them). The value is single-quoted, so spaces / regex are safe.
test_name(_ctx: ptr, name: string) {
    if map.has(_ctx, "test_names") == 0 {
        _e1 = map.put(_ctx, "test_names", list.new())
    }
    l, _ = map.get(_ctx, "test_names")
    _a = list.add(l, name)
}

// test_flag("--reporter=expanded") — one verbatim flag passed to `dart test`
// (`--reporter`, `--platform`, `--tags`, `--exclude-tags`, `--timeout`, …).
// Repeatable. The escape for the permutations not given a named setter —
// still a greppable literal in the build file, no shell, no flag-string
// smuggling. Pass `--flag value` as one token ("--timeout 30s") or two calls.
test_flag(_ctx: ptr, flag: string) {
    if map.has(_ctx, "test_flags") == 0 {
        _e1 = map.put(_ctx, "test_flags", list.new())
    }
    l, _ = map.get(_ctx, "test_flags")
    _a = list.add(l, flag)
}

// pub_get_first("1") — run `dart pub get` before `dart test`, so a binding
// whose tests need deps resolved doesn't have to dep a separate pub_get node.
// Any non-empty value enables (mirrors offline()'s value-enables shape);
// honours offline() too. Replaces the step("dart pub get") + step("dart test")
// shell pair.
pub_get_first(_ctx: ptr, v: string) {
    _e = map.put(_ctx, "pub_get_first", v)
}

// --- DSL setters: compile ---
//
// `dart compile <format> <entrypoint> -o <output>`. format is one of
// exe / aot-snapshot / jit-snapshot / kernel / js. The builder
// publishes the `program_binary` artifact for exe so a downstream
// test runner can drive it regardless of source language (same
// contract as c.program / aether.program).

// compile_format("exe") — output format for dart.compile. Default
// "exe" (a self-contained native executable). Scalar; last wins.
compile_format(_ctx: ptr, fmt: string) {
    _e = map.put(_ctx, "compile_format", fmt)
}

// compile_entrypoint("bin/main.dart") — the .dart entrypoint to
// compile, relative to source_dir. Scalar; last wins. Default
// "bin/main.dart" (Dart's convention).
compile_entrypoint(_ctx: ptr, path: string) {
    _e = map.put(_ctx, "compile_entrypoint", path)
}

// compile_output("myapp") — output artifact name, relative to the
// module's target dir. Scalar; last wins. Default: the entrypoint
// basename with the format's natural extension.
compile_output(_ctx: ptr, name: string) {
    _e = map.put(_ctx, "compile_output", name)
}

// --- DSL setters: codegen ---
//
// dart.codegen runs a Dart code generator that produces source files
// for downstream compilation. The canonical case is
// `dart run build_runner build` (json_serializable, freezed, mockito,
// drift, …), but any `dart run <pkg>` or `dart <script.dart>` driver
// works. Inputs are declared *explicitly* — no glob fallback. The
// contract is "this generator reads exactly these files and writes
// exactly these outputs"; missing-input bugs surface at staleness-
// check time and missing-output bugs at run time.
//
// Mirror of python.codegen — the builder reads the map keys
// "codegen_driver" / "codegen_script" / "codegen_inputs" /
// "codegen_input_dirs" / "codegen_args" / "codegen_outputs" /
// "codegen_cwd" / "codegen_dart".

// codegen_driver("build_runner") — run as `dart run build_runner`.
// Mutually exclusive with codegen_script(); driver wins if both set.
codegen_driver(_ctx: ptr, package_name: string) {
    _e = map.put(_ctx, "codegen_driver", package_name)
}

// codegen_script("tool/gen.dart") — run as `dart <path>`. Path is
// resolved against codegen_cwd (or source_dir if unset).
codegen_script(_ctx: ptr, script_path: string) {
    _e = map.put(_ctx, "codegen_script", script_path)
}

// codegen_input("lib/models.dart") — declare one file the generator
// reads. Repeatable. Paths resolved against codegen_cwd. The content
// mtime of every declared input feeds the staleness check.
codegen_input(_ctx: ptr, path: string) {
    if map.has(_ctx, "codegen_inputs") == 0 {
        _e1 = map.put(_ctx, "codegen_inputs", list.new())
    }
    inputs, _ = map.get(_ctx, "codegen_inputs")
    _e2 = list.add(inputs, path)
}

// codegen_input_dir("lib") — declare a directory whose contents are
// inputs. Every regular file under it (recursive) feeds the staleness
// check. Use sparingly: the explicit input(...) form is preferred,
// but a generator scanning a whole source tree is usually too many to
// enumerate.
codegen_input_dir(_ctx: ptr, path: string) {
    if map.has(_ctx, "codegen_input_dirs") == 0 {
        _e1 = map.put(_ctx, "codegen_input_dirs", list.new())
    }
    dirs, _ = map.get(_ctx, "codegen_input_dirs")
    _e2 = list.add(dirs, path)
}

// codegen_arg("--delete-conflicting-outputs") — one CLI arg, appended
// in declared order to the dart command line. Repeatable. No shell-
// splitting; pass `--flag value` as two separate calls.
codegen_arg(_ctx: ptr, arg: string) {
    if map.has(_ctx, "codegen_args") == 0 {
        _e1 = map.put(_ctx, "codegen_args", list.new())
    }
    args, _ = map.get(_ctx, "codegen_args")
    _e2 = list.add(args, arg)
}

// codegen_output("lib/models.g.dart") — declare one expected output.
// Repeatable. The builder fails if any declared output doesn't exist
// after the generator runs (catches partial generation / silent
// skips). Paths resolved against codegen_cwd.
codegen_output(_ctx: ptr, path: string) {
    if map.has(_ctx, "codegen_outputs") == 0 {
        _e1 = map.put(_ctx, "codegen_outputs", list.new())
    }
    outs, _ = map.get(_ctx, "codegen_outputs")
    _e2 = list.add(outs, path)
}

// codegen_cwd("..") — working dir for the dart command (relative to
// source_dir, or absolute). Defaults to source_dir. Use when the
// generator expects to run from the package root but the .codegen.ae
// file lives in a subdirectory.
codegen_cwd(_ctx: ptr, dir: string) {
    _e = map.put(_ctx, "codegen_cwd", dir)
}

// codegen_dart("dart") — override the dart executable for codegen. By
// default the builder uses dart_bin (or PATH "dart"). Use to pin a
// specific SDK the generator depends on.
codegen_dart(_ctx: ptr, d: string) {
    _e = map.put(_ctx, "codegen_dart", d)
}

// --- Command builders (pure) ---

// pub_get_cmd — `dart pub get` invocation. Pure. offline_flag is
// " --offline" or "".
pub_get_cmd(dart: string, source_dir: string, offline_flag: string) {
    return "cd '${source_dir}' && '${dart}' pub get${offline_flag}"
}

// analyze_args_part(flags) — render the suffix after `analyze` from the
// analyze_flags list (or "" when null/empty). Pure (I/O-free); mirrors
// the flags portion of test_args_part.
analyze_args_part(flags: ptr) {
    out = ""
    if flags != null {
        n = list.size(flags)
        i = 0
        while i < n {
            fl, _ = list.get(flags, i)
            out = string.concat(out, string.concat(" ", fl))
            i = i + 1
        }
    }
    return out
}

// analyze_cmd — `dart analyze` invocation. Pure. Runs from source_dir
// so package resolution (`.dart_tool/`) is found. args_part carries any
// analyze_flag() tokens (e.g. " --no-fatal-infos"), "" for none.
analyze_cmd(dart: string, source_dir: string, args_part: string) {
    return "cd '${source_dir}' && '${dart}' analyze${args_part}"
}

// test_cmd — `dart test` invocation. Pure. args_part is the suffix after
// `test` (" -j 1 --name 'x' test/unit", as rendered by test_args_part) or
// "" for dart's own discovery with default concurrency.
test_cmd(dart: string, source_dir: string, args_part: string) {
    return "cd '${source_dir}' && '${dart}' test${args_part}"
}

// test_args_part(concurrency, names, flags, path) — render the suffix after
// `dart test`, in dart's expected order: ` -j N`, then each ` --name '<x>'`,
// then each verbatim flag, then the positional path last. Every piece is
// omitted when empty/null. Pure (I/O-free); tested in tests/test_dart_cmd.ae.
// `names`/`flags` are string lists (or null); `concurrency`/`path` are the
// raw values (no leading space — this adds it).
test_args_part(concurrency: string, names: ptr, flags: ptr, path: string) {
    out = ""
    if string.length(concurrency) > 0 {
        out = string.concat(out, string.concat(" -j ", concurrency))
    }
    if names != null {
        n = list.size(names)
        i = 0
        while i < n {
            nm, _ = list.get(names, i)
            out = string.concat(out, string.concat(" --name '", string.concat(nm, "'")))
            i = i + 1
        }
    }
    if flags != null {
        m = list.size(flags)
        j = 0
        while j < m {
            fl, _ = list.get(flags, j)
            out = string.concat(out, string.concat(" ", fl))
            j = j + 1
        }
    }
    if string.length(path) > 0 {
        out = string.concat(out, string.concat(" ", path))
    }
    return out
}

// compile_cmd — `dart compile <format> <entry> -o <out>` invocation.
// Pure. All paths pre-resolved by the caller (entry relative to
// source_dir; out absolute under target dir).
compile_cmd(dart: string, source_dir: string, fmt: string, entry: string, out: string) {
    return "cd '${source_dir}' && '${dart}' compile ${fmt} '${entry}' -o '${out}'"
}

// dart_codegen_cmd — assemble the shell command for dart.codegen.
// Pure: builds `cd '<cwd>' && '<dart>' <driver_part> <args>`.
// driver_form is "package" (→ `run <name>`) or "script" (→ `<path>`);
// driver_name is the package name or script path. args is a list of
// pre-quoted CLI args, joined with single spaces.
// Tested in tests/test_dart_codegen_cmd.ae.
dart_codegen_cmd(dart: string, cwd: string, driver_form: string, driver_name: string, args: ptr) {
    driver_part = ""
    if string.equals(driver_form, "package") == 1 {
        driver_part = string.concat(" run ", driver_name)
    }
    if string.equals(driver_form, "script") == 1 {
        driver_part = string.concat(" ", driver_name)
    }
    args_part = ""
    if args != null {
        n = list.size(args)
        i = 0
        while i < n {
            a, _ = list.get(args, i)
            args_part = string.concat(args_part, " ")
            args_part = string.concat(args_part, a)
            i = i + 1
        }
    }
    return "cd '${cwd}' && '${dart}'${driver_part}${args_part}"
}

// --- Internal: resolve the dart executable ---

_dart_of(builder_map: ptr) {
    if builder_map != null {
        if map.has(builder_map, "dart_bin") == 1 {
            d, _ = map.get(builder_map, "dart_bin")
            if string.length(d) > 0 { return d }
        }
    }
    return "dart"
}

// --- SDK functions ---

// Resolve package dependencies via `dart pub get`. The "install"
// builder — runs in source_dir, materialises `.dart_tool/`. Mirror of
// python.install.
builder pub_get(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")

    bldr._mkdirs(target_dir)
    println("${mod_dir}: resolving deps (dart pub get)")

    dart = _dart_of(_builder)
    offline_flag = ""
    if _builder != null {
        if map.has(_builder, "offline") == 1 {
            ov, _ = map.get(_builder, "offline")
            if string.length(ov) > 0 { offline_flag = " --offline" }
        }
    }

    cmd = pub_get_cmd(dart, source_dir, offline_flag)
    exit_code = bldr._sh(cmd)
    if exit_code != 0 {
        println("${mod_dir}: pub get FAILED")
        bldr.fail(ctx, "pub get FAILED")
        return exit_code
    }
    println("${mod_dir}: pub get done")
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// Static-analyse Dart source with `dart analyze`. Mirror of
// python.lint / typecheck (Dart folds lint + type-check into one
// command).
builder analyze(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")

    bldr._mkdirs(target_dir)
    println("${mod_dir}: analysing (dart analyze)")

    dart = _dart_of(_builder)
    analyze_flags = null
    if _builder != null {
        if map.has(_builder, "analyze_flags") == 1 {
            analyze_flags, _ = map.get(_builder, "analyze_flags")
        }
    }
    cmd = analyze_cmd(dart, source_dir, analyze_args_part(analyze_flags))
    exit_code = bldr._sh(cmd)
    if exit_code != 0 {
        println("${mod_dir}: analyze FAILED")
        bldr.fail(ctx, "analyze FAILED")
        return exit_code
    }
    println("${mod_dir}: analyze PASSED")
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// Run tests via `dart test`. Mirror of python.pytest: tee output to
// target/<module>/test_output.log, parse the summary line for pass/
// fail counts, feed bldr._record_test_result.
builder test(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")

    bldr._mkdirs(target_dir)

    dart = _dart_of(_builder)

    // Optional `dart pub get` first (deps resolved before the run), so a
    // binding can drop the step("dart pub get") + step("dart test") shell pair.
    if _builder != null {
        if map.has(_builder, "pub_get_first") == 1 {
            pv, _ = map.get(_builder, "pub_get_first")
            if string.length(pv) > 0 {
                pg_offline = ""
                if map.has(_builder, "offline") == 1 {
                    ov, _ = map.get(_builder, "offline")
                    if string.length(ov) > 0 { pg_offline = " --offline" }
                }
                println("${mod_dir}: resolving deps (dart pub get)")
                pg_rc = bldr._sh(pub_get_cmd(dart, source_dir, pg_offline))
                if pg_rc != 0 {
                    println("${mod_dir}: pub get FAILED")
                    bldr.fail(ctx, "pub get FAILED")
                    return pg_rc
                }
            }
        }
    }

    println("${mod_dir}: running tests (dart test)")

    // Assemble the `dart test` arg suffix from the DSL: -j N, --name, verbatim
    // flags, then the positional path.
    conc = ""
    names = null
    flags = null
    tpath = ""
    if _builder != null {
        if map.has(_builder, "test_concurrency") == 1 { conc, _ = map.get(_builder, "test_concurrency") }
        if map.has(_builder, "test_names") == 1 { names, _ = map.get(_builder, "test_names") }
        if map.has(_builder, "test_flags") == 1 { flags, _ = map.get(_builder, "test_flags") }
        if map.has(_builder, "test_path") == 1 { tpath, _ = map.get(_builder, "test_path") }
    }
    args_part = test_args_part(conc, names, flags, tpath)

    cmd = string.concat(bldr._env_export_prefix(_builder), test_cmd(dart, source_dir, args_part))
    out_path = path.join(target_dir, "test_output.log")
    full_cmd = string.concat(string.concat(cmd, " 2>&1 | tee "), out_path)
    exit_code = bldr._sh(full_cmd)
    out_text, _orerr = fs.read(out_path)
    tp_cnt, tf_cnt = _parse_dart_test_counts(out_text)
    bldr._record_test_result(ctx, tp_cnt, tf_cnt)
    if exit_code != 0 {
        println("${mod_dir}: tests FAILED")
        bldr.fail(ctx, "tests FAILED")
        return exit_code
    }
    println("${mod_dir}: tests PASSED")
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// _parse_dart_test_counts(output) — extract (passed, failed) from
// `dart test`'s summary line. Pure: just string parsing.
//
// dart test's final line varies:
//   "00:01 +14: All tests passed!"               (all-pass)
//   "00:02 +13 -1: Some tests failed."           (mixed)
//   "00:00 +0 -1: Some tests failed."            (one failure)
//
// The "+N" token is the passed count, "-N" is the failed count. We
// read the LAST occurrence of each marker so intermediate progress
// lines (which also carry +N/-N) don't win over the final summary.
_parse_dart_test_counts(output: string) {
    passed = _parse_count_after_marker_dart(output, "+")
    failed = _parse_count_after_marker_dart(output, "-")
    return passed, failed
}

// _parse_count_after_marker_dart(output, marker) — find the LAST
// occurrence of `marker` immediately followed by digits, and return
// that number. Returns 0 if no `marker<digit>` run exists. Scanning
// for the last occurrence keeps the final summary line authoritative
// over the progress lines dart prints during the run.
_parse_count_after_marker_dart(output: string, marker: string) {
    n = string.length(output)
    result = 0
    i = 0
    while i < n {
        c = string.substring(output, i, i + 1)
        if string.equals(c, marker) == 1 {
            // Marker found; read the digit run immediately after it.
            j = i + 1
            digits = ""
            scanning = 1
            while scanning == 1 {
                if j >= n {
                    scanning = 0
                } else {
                    d = string.substring(output, j, j + 1)
                    if _is_digit_dart(d) == 1 {
                        digits = string.concat(digits, d)
                        j = j + 1
                    } else {
                        scanning = 0
                    }
                }
            }
            if string.length(digits) > 0 {
                v, _err = string.to_int(digits)
                result = v
            }
        }
        i = i + 1
    }
    return result
}

_is_digit_dart(c: string) {
    if string.equals(c, "0") == 1 { return 1 }
    if string.equals(c, "1") == 1 { return 1 }
    if string.equals(c, "2") == 1 { return 1 }
    if string.equals(c, "3") == 1 { return 1 }
    if string.equals(c, "4") == 1 { return 1 }
    if string.equals(c, "5") == 1 { return 1 }
    if string.equals(c, "6") == 1 { return 1 }
    if string.equals(c, "7") == 1 { return 1 }
    if string.equals(c, "8") == 1 { return 1 }
    if string.equals(c, "9") == 1 { return 1 }
    return 0
}

// Compile a Dart entrypoint to a native/exe/JS artifact via
// `dart compile`. Publishes the `program_binary` artifact (for the
// exe format) so a downstream test runner can drive it, same
// contract as c.program / aether.program.
builder compile(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")

    bldr._mkdirs(target_dir)

    dart = _dart_of(_builder)

    fmt = "exe"
    if _builder != null {
        if map.has(_builder, "compile_format") == 1 {
            f, _ = map.get(_builder, "compile_format")
            if string.length(f) > 0 { fmt = f }
        }
    }

    entry = "bin/main.dart"
    if _builder != null {
        if map.has(_builder, "compile_entrypoint") == 1 {
            e, _ = map.get(_builder, "compile_entrypoint")
            if string.length(e) > 0 { entry = e }
        }
    }

    // Output name: explicit setter, else entrypoint basename.
    out_name = ""
    if _builder != null {
        if map.has(_builder, "compile_output") == 1 {
            o, _ = map.get(_builder, "compile_output")
            if string.length(o) > 0 { out_name = o }
        }
    }
    if string.length(out_name) == 0 {
        out_name = _strip_dart_ext(path.basename(entry))
    }
    out_abs = path.join(target_dir, out_name)

    println("${mod_dir}: compiling (dart compile ${fmt})")
    cmd = compile_cmd(dart, source_dir, fmt, entry, out_abs)
    exit_code = bldr._sh(cmd)
    if exit_code != 0 {
        println("${mod_dir}: compile FAILED")
        bldr.fail(ctx, "compile FAILED")
        return exit_code
    }

    // Publish the runnable-binary artifact for exe-format outputs, so
    // a language-agnostic test runner (bldr.program_binary_of) finds
    // it. Other formats (js/kernel/snapshot) aren't directly runnable
    // as a host binary, so they don't claim program_binary.
    if string.equals(fmt, "exe") == 1 {
        bldr._write_artifact(ctx, "program_binary", out_abs)
    }
    bldr._write_artifact(ctx, "dart_compile_output", out_abs)

    println("${mod_dir}: compile done → ${out_abs}")
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// _strip_dart_ext(name) — drop a trailing ".dart" so "main.dart"
// becomes "main". Leaves names without the extension untouched.
_strip_dart_ext(name: string) {
    n = string.length(name)
    if n < 5 { return name }
    tail = string.substring(name, n - 5, n)
    if string.equals(tail, ".dart") == 1 {
        return string.substring(name, 0, n - 5)
    }
    return name
}

// --- dart.codegen builder ---
//
// Runs a Dart code generator with explicitly declared inputs and
// outputs. Contract: the generator reads exactly the files listed via
// codegen_input(...) / codegen_input_dir(...) and writes exactly the
// files listed via codegen_output(...). When all declared outputs
// exist and are newer than every declared input, the run is skipped
// (mtime-driven, same shape as python.codegen / aether.regen).
//
// Why this exists: Dart's build_runner reads source files annotated
// for json_serializable / freezed / drift / mockito and emits sibling
// `*.g.dart` / `*.freezed.dart` files. build_runner's own dependency
// tracking lives in `.dart_tool/build/` and is opaque to the outer
// build graph; declaring inputs/outputs explicitly lets aeb reason
// about staleness and verify the generator actually produced what was
// promised (build_runner silently skips a file whose annotations it
// can't resolve).
//
// Cache integration is deferred — same rationale as python.codegen
// (declared outputs are multi-file sets; lib/cache for multi-file
// artifacts is a follow-up). Today's behaviour is "run if any declared
// input is newer than the oldest declared output."
builder codegen(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")
    bldr._mkdirs(target_dir)

    // Resolve working directory. codegen_cwd is relative to source_dir
    // unless absolute. Default to source_dir.
    cwd = source_dir
    if _builder != null {
        if map.has(_builder, "codegen_cwd") == 1 {
            rel, _ = map.get(_builder, "codegen_cwd")
            if string.length(rel) > 0 {
                if bldr._is_abs_path(rel) == 1 {
                    cwd = rel
                } else {
                    cwd = path.join(source_dir, rel)
                }
            }
        }
    }

    // Resolve dart executable. Priority:
    //   1. codegen_dart(...) override
    //   2. dart_bin(...) setter
    //   3. PATH "dart"
    dart = "dart"
    if _builder != null {
        if map.has(_builder, "codegen_dart") == 1 {
            dart, _ = map.get(_builder, "codegen_dart")
        } else {
            if map.has(_builder, "dart_bin") == 1 {
                db, _ = map.get(_builder, "dart_bin")
                if string.length(db) > 0 { dart = db }
            }
        }
    }

    // Resolve driver form. codegen_driver wins over codegen_script if
    // both are set.
    driver_form = ""
    driver_name = ""
    if _builder != null {
        if map.has(_builder, "codegen_driver") == 1 {
            driver_form = "package"
            driver_name, _ = map.get(_builder, "codegen_driver")
        } else {
            if map.has(_builder, "codegen_script") == 1 {
                driver_form = "script"
                driver_name, _ = map.get(_builder, "codegen_script")
            }
        }
    }
    if string.length(driver_form) == 0 {
        println("${mod_dir}: codegen: declare codegen_driver(\"build_runner\") or codegen_script(\"tool/gen.dart\")")
        bldr.fail(ctx, "codegen: no codegen_driver() or codegen_script() declared")
        return 1
    }

    args = null
    if _builder != null && map.has(_builder, "codegen_args") == 1 {
        args, _ = map.get(_builder, "codegen_args")
    }

    // Staleness check: skip if every declared output exists AND is
    // newer than every declared input file AND every file recursively
    // under every declared input_dir. Empty inputs+input_dirs → cannot
    // reason → force run.
    inputs = null
    input_dirs = null
    outputs = null
    if _builder != null {
        if map.has(_builder, "codegen_inputs") == 1 {
            inputs, _ = map.get(_builder, "codegen_inputs")
        }
        if map.has(_builder, "codegen_input_dirs") == 1 {
            input_dirs, _ = map.get(_builder, "codegen_input_dirs")
        }
        if map.has(_builder, "codegen_outputs") == 1 {
            outputs, _ = map.get(_builder, "codegen_outputs")
        }
    }
    skip = _codegen_can_skip(cwd, inputs, input_dirs, outputs)

    if skip == 0 {
        cmd = dart_codegen_cmd(dart, cwd, driver_form, driver_name, args)
        println("${mod_dir}: codegen running")
        rc = bldr._sh(cmd)
        if rc != 0 {
            println("${mod_dir}: codegen FAILED")
            bldr.fail(ctx, "codegen FAILED")
            return rc
        }
    } else {
        println("${mod_dir}: codegen up-to-date")
    }

    // Verify every declared output exists, regardless of skip.
    missing = _codegen_check_outputs(cwd, outputs, mod_dir)
    if missing > 0 {
        println("${mod_dir}: codegen: ${missing} declared output(s) missing — check codegen_output() vs the generator's actual output set")
        bldr.fail(ctx, "codegen: ${missing} declared output(s) missing")
        return 1
    }

    // Record artifact: newline-separated absolute output paths.
    out_listing = _codegen_format_output_list(cwd, outputs)
    bldr._write_artifact(ctx, "dart_codegen_outputs", out_listing)
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// _codegen_can_skip(cwd, inputs, input_dirs, outputs) — return 1 when
// every declared output exists AND its mtime is >= every declared
// input's mtime (individual files AND every file recursively under
// each input_dir). Returns 0 when codegen must run (missing output,
// or any input is newer). Empty inputs+input_dirs+outputs → never skip
// (force run, can't reason about freshness).
_codegen_can_skip(cwd: string, inputs: ptr, input_dirs: ptr, outputs: ptr) {
    if outputs == null { return 0 }
    if list.size(outputs) == 0 { return 0 }
    newest_in = 0
    if inputs != null {
        n = list.size(inputs)
        i = 0
        while i < n {
            p, _ = list.get(inputs, i)
            abs_p = _codegen_resolve(cwd, p)
            t = file.mtime(abs_p)
            if t > newest_in { newest_in = t }
            i = i + 1
        }
    }
    if input_dirs != null {
        nd = list.size(input_dirs)
        di = 0
        while di < nd {
            dp, _ = list.get(input_dirs, di)
            abs_d = _codegen_resolve(cwd, dp)
            dir_newest = _dir_newest_mtime(abs_d)
            if dir_newest > newest_in { newest_in = dir_newest }
            di = di + 1
        }
    }
    no = list.size(outputs)
    j = 0
    oldest_out = 0
    while j < no {
        op, _ = list.get(outputs, j)
        abs_o = _codegen_resolve(cwd, op)
        ot = file.mtime(abs_o)
        if ot == 0 { return 0 }
        if oldest_out == 0 { oldest_out = ot }
        if ot < oldest_out { oldest_out = ot }
        j = j + 1
    }
    if oldest_out >= newest_in { return 1 }
    return 0
}

// _dir_newest_mtime(dir_abs) — recursively walk a directory and return
// the newest file mtime found. Returns 0 if the dir doesn't exist or
// has no regular files. std.dir flat-list + per-entry recurse; no
// shell-out (portable across linux/macos, unlike `find -printf`).
_dir_newest_mtime(dir_abs: string) {
    if dir.exists(dir_abs) == 0 { return 0 }
    entries, _ = dir.list(dir_abs)
    if entries == null { return 0 }
    n = dir_list_count(entries)
    newest = 0
    i = 0
    while i < n {
        name = dir_list_get(entries, i)
        if string.equals(name, ".") == 0 {
            if string.equals(name, "..") == 0 {
                full = path.join(dir_abs, name)
                if dir.exists(full) == 1 {
                    sub = _dir_newest_mtime(full)
                    if sub > newest { newest = sub }
                } else {
                    t = file.mtime(full)
                    if t > newest { newest = t }
                }
            }
        }
        i = i + 1
    }
    dir_list_free(entries)
    return newest
}

// _codegen_check_outputs(cwd, outputs, mod_dir) — return the number of
// declared outputs that don't exist on disk. Prints one line per
// missing file. 0 when all present (or none declared).
_codegen_check_outputs(cwd: string, outputs: ptr, mod_dir: string) {
    if outputs == null { return 0 }
    n = list.size(outputs)
    if n == 0 { return 0 }
    missing = 0
    i = 0
    while i < n {
        p, _ = list.get(outputs, i)
        abs_p = _codegen_resolve(cwd, p)
        if file.exists(abs_p) == 0 {
            println("${mod_dir}: codegen output missing: ${abs_p}")
            missing = missing + 1
        }
        i = i + 1
    }
    return missing
}

// _codegen_format_output_list(cwd, outputs) — newline-joined absolute
// paths for the dart_codegen_outputs artifact. Empty when none.
_codegen_format_output_list(cwd: string, outputs: ptr) {
    if outputs == null { return "" }
    n = list.size(outputs)
    out = ""
    i = 0
    while i < n {
        p, _ = list.get(outputs, i)
        abs_p = _codegen_resolve(cwd, p)
        if i > 0 { out = string.concat(out, "\n") }
        out = string.concat(out, abs_p)
        i = i + 1
    }
    return out
}

// _codegen_resolve(cwd, p) — return absolute path. Bare-relative is
// joined against cwd; absolute passes through.
_codegen_resolve(cwd: string, p: string) {
    if string.length(p) == 0 { return p }
    if bldr._is_abs_path(p) == 1 { return p }
    return path.join(cwd, p)
}

// dart.test_existing(b) — run an existing Dart project's tests as-is with
// full step/env control (e.g. `dart pub get` then `dart test -j 1`).
// Foundation-backed counterpart to the metadata-owning `test` builder.
builder test_existing(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    mod_dir = bldr._get(ctx, "module_dir")
    println("${mod_dir}: running tests (dart test)")
    return bldr._run_project(ctx, _builder, "dart test", 1)
}

// --- consumer_example: stage a bundled package + consumer, run from clean ---

// stage("src/lib.rs", "pkg/src/lib.rs") — copy one file (src relative to the
// module source_dir, dest relative to the staging root under target_dir) into
// the clean staging tree. Repeatable; this is the package+consumer manifest as
// declarative data. Value is "src<TAB>dest".
stage(_ctx: ptr, src: string, dest: string) {
    if map.has(_ctx, "stage_pairs") == 0 { _e1 = map.put(_ctx, "stage_pairs", list.new()) }
    l, _ = map.get(_ctx, "stage_pairs")
    _e2 = list.add(l, string.concat(src, string.concat("\t", dest)))
}
// stage_dir("../go", "go-pkg", "example") — copy a whole dir (src relative to
// module source_dir) into staging as dest, optionally deleting a sub-path after
// (e.g. drop example/ from the packaged copy). Value is "src<TAB>dest<TAB>prune".
stage_dir(_ctx: ptr, src: string, dest: string, prune: string) {
    if map.has(_ctx, "stage_dirs") == 0 { _e1 = map.put(_ctx, "stage_dirs", list.new()) }
    l, _ = map.get(_ctx, "stage_dirs")
    _e2 = list.add(l, string.concat(src, string.concat("\t", string.concat(dest, string.concat("\t", prune)))))
}
// run_in("consumer") — the staging-relative dir to run from. Scalar.
run_in(_ctx: ptr, dir: string) {
    _e = map.put(_ctx, "run_in", dir)
}
// run_cmd("cargo run --offline --") — the base run command (an env-prefix + argv
// follows per run_arg). Default is the cargo form. Scalar.
run_cmd(_ctx: ptr, cmd: string) {
    _e = map.put(_ctx, "run_cmd", cmd)
}
// pre_cmd("nim c -r ... consumer.nim") — a build step run once in run_in before
// the per-arg runs (for compile-then-run languages). Scalar; optional.
pre_cmd(_ctx: ptr, cmd: string) {
    _e = map.put(_ctx, "pre_cmd", cmd)
}
// run_arg("ffi") — an argv for `cargo run --offline -- <arg>`. Repeatable.
run_arg(_ctx: ptr, arg: string) {
    if map.has(_ctx, "run_args") == 0 { _e1 = map.put(_ctx, "run_args", list.new()) }
    l, _ = map.get(_ctx, "run_args")
    _e2 = list.add(l, arg)
}
// assert_file("pkg/native/libselenium_core.so") — a staging-relative path that
// MUST exist after staging (the bundled asset). Repeatable.
assert_file(_ctx: ptr, path: string) {
    if map.has(_ctx, "assert_files") == 0 { _e1 = map.put(_ctx, "assert_files", list.new()) }
    l, _ = map.get(_ctx, "assert_files")
    _e2 = list.add(l, path)
}

// rust.consumer_example() — stage a clean bundled crate + a consumer crate (via
// stage() pairs), assert the bundled asset, then `cargo run --offline -- <arg>`
// in run_in with SELENIUM_CORE_LIB unset — so the consumer drives the engine via
// ONLY the crate's own bundled .so (no in-tree sibling). Deps the .package.ae.
builder consumer_example(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")
    bldr._mkdirs(target_dir)

    stageroot = path.join(target_dir, "stage")
    bldr._sh("rm -rf '${stageroot}' && mkdir -p '${stageroot}'")

    // stage the declared file pairs.
    if _builder != null {
        if map.has(_builder, "stage_pairs") == 1 {
            l, _ = map.get(_builder, "stage_pairs")
            n = list.size(l)
            i = 0
            while i < n {
                pair, _ = list.get(l, i)
                tab = string.index_of(pair, "\t")
                src = string.substring(pair, 0, tab)
                dest = string.substring(pair, tab + 1, string.length(pair))
                src_abs = path.join(source_dir, src)
                dest_abs = path.join(stageroot, dest)
                dest_parent = path.dirname(dest_abs)
                bldr._sh("mkdir -p '${dest_parent}' && cp -r '${src_abs}' '${dest_abs}'")
                i = i + 1
            }
        }
    }

    // stage whole dirs (cp -r), with an optional prune sub-path.
    if _builder != null {
        if map.has(_builder, "stage_dirs") == 1 {
            l, _ = map.get(_builder, "stage_dirs")
            n = list.size(l)
            i = 0
            while i < n {
                spec, _ = list.get(l, i)
                t1 = string.index_of(spec, "\t")
                sd_src = string.substring(spec, 0, t1)
                r1 = string.substring(spec, t1 + 1, string.length(spec))
                t2 = string.index_of(r1, "\t")
                sd_dest = string.substring(r1, 0, t2)
                sd_prune = string.substring(r1, t2 + 1, string.length(r1))
                src_abs = path.join(source_dir, sd_src)
                dest_abs = path.join(stageroot, sd_dest)
                bldr._sh("cp -r '${src_abs}' '${dest_abs}'")
                if string.length(sd_prune) > 0 {
                    bldr._sh("rm -rf '${dest_abs}/${sd_prune}'")
                }
                i = i + 1
            }
        }
    }

    // assert bundled files.
    if _builder != null {
        if map.has(_builder, "assert_files") == 1 {
            l, _ = map.get(_builder, "assert_files")
            n = list.size(l)
            i = 0
            while i < n {
                af, _ = list.get(l, i)
                if bldr._sh("ls '${stageroot}/${af}' >/dev/null 2>&1") != 0 {
                    println("${mod_dir}: staged package missing ${af}")
                    bldr.fail(ctx, "bundled asset missing after staging")
                    return 1
                }
                i = i + 1
            }
        }
    }

    run_dir = "consumer"
    if _builder != null {
        if map.has(_builder, "run_in") == 1 { run_dir, _ = map.get(_builder, "run_in") }
    }
    run_abs = path.join(stageroot, run_dir)
    run_command = "cargo run --offline --"
    if _builder != null {
        if map.has(_builder, "run_cmd") == 1 { run_command, _ = map.get(_builder, "run_cmd") }
    }
    // optional build step before the per-arg runs.
    if _builder != null {
        if map.has(_builder, "pre_cmd") == 1 {
            pc, _ = map.get(_builder, "pre_cmd")
            if string.length(pc) > 0 {
                if bldr._sh("cd '${run_abs}' && env -u SELENIUM_CORE_LIB ${pc}") != 0 {
                    println("${mod_dir}: consumer pre-build failed")
                    bldr.fail(ctx, "consumer pre-build failed")
                    return 1
                }
            }
        }
    }
    base = "cd '${run_abs}' && env -u SELENIUM_CORE_LIB ${run_command}"
    args = null
    if _builder != null {
        if map.has(_builder, "run_args") == 1 { args, _ = map.get(_builder, "run_args") }
    }
    if args == null {
        if bldr._sh(base) != 0 { bldr.fail(ctx, "consumer run failed"); return 1 }
    } else {
        na = list.size(args)
        ai = 0
        while ai < na {
            a, _ = list.get(args, ai)
            println("${mod_dir}: consumer run (${a})")
            if bldr._sh("${base} ${a}") != 0 {
                println("${mod_dir}: consumer run (${a}) failed")
                bldr.fail(ctx, "consumer run (${a}) failed")
                return 1
            }
            ai = ai + 1
        }
    }
    println("${mod_dir}: PASS — consumer drove the engine via the crate's bundled .so from clean")
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}
