// agent — remote-aeb dispatch SDK (walking skeleton).
//
// Two sides, one module:
//   - ORIGINATOR: `agent.dispatch(b) { endpoint(...) target(...) }` in a
//     fan-out .ae target. Fires a request to a remote aeb-agent, awaits a
//     terse verdict, folds pass/fail into build.fail/any_failed.
//   - AGENT-side decision helpers (pure): does an incoming request's
//     purpose match a scope's accept rule? is a job slot free? These are
//     consumed by tools/aeb-agent (the listener exe) and tested offline.
//
// Design: docs/run-policy-class-and-cloud-leverage.md.
// Walking skeleton — deliberately NOT yet: token auth, cache
// partitioning, the details_url sync-pull, the duration-scoped callback
// socket (the skeleton does a synchronous request/response). Those
// thicken this spine later.
//
// The agent's capabilities are a COMPOSABLE SCOPE TREE
// (dsl-with-scope): one host can offer several scopes (bare host now;
// podman / vm scopes slot in later as new run_on kinds without reshaping
// the model). The first scope is trivial; the data model is a tree from
// day one.
//
//   agent {
//       scope("preint") {
//           run_on("host")            // later: "podman" | "vm"
//           max_jobs(2)
//           accept_scope("preint/*")  // glob over the request purpose
//       }
//   }

import build
import std.http
import std.http.client
import std.string
import std.io
import std.os
import std.list
import std.map
import std.path
import std.file
import std.dir
import std.cryptography

// --- Originator-side DSL setters (live on _builder) ---

// endpoint(url) — the remote aeb-agent base URL (host:port). Typically
// sourced from an env var in the .build.ae: endpoint(env "AEB_AGENT_MAC").
endpoint(_ctx: ptr, url: string) {
    _e = map.put(_ctx, "endpoint", url)
}

// target(path) — the .ae target the remote agent should build/run.
target(_ctx: ptr, path: string) {
    _e = map.put(_ctx, "target", path)
}

// purpose(scope) — the policy/purpose string this request claims
// (e.g. "preint/phammant/feature-x"). The agent matches it against its
// scopes' accept rules. Optional in the skeleton; defaults to "preint".
purpose(_ctx: ptr, scope: string) {
    _e = map.put(_ctx, "purpose", scope)
}

// token(t) — the naive bearer token presented to the agent (must appear
// in the agent's --tokens file). Source it from the run context in the
// .ae: token(env "AEB_AGENT_TOKEN"). Sent as the X-AEB-Token header.
// Interim shared-secret auth — see the token-auth note below.
token(_ctx: ptr, t: string) {
    _e = map.put(_ctx, "token", t)
}

// ref(r) / hash(h) — fetch-base for the remote build: the agent does
// `git fetch origin <ref> && git checkout <hash>` in its --repo before
// building. Source from the run context, e.g. ref(env "GIT_REF") /
// hash("$(git rev-parse HEAD)") expanded in the .ae. Both empty => the
// agent builds its workdir as-is (no checkout). The agent owns WHERE it
// fetches from (its configured origin); the originator only names what.
ref(_ctx: ptr, r: string) {
    _e = map.put(_ctx, "ref", r)
}

hash(_ctx: ptr, h: string) {
    _e = map.put(_ctx, "hash", h)
}

// patch_file(path) — a unified-diff file applied (git apply) onto the
// checked-out base on the agent, AFTER fetch+checkout. The pre-integration
// delta: "build origin@<hash> PLUS my working-tree diff on your node."
// The originator base64-encodes the file's bytes into the wire (so the
// diff's newlines/quotes survive the flat-JSON payload); the agent
// decodes + git-applies. Path is module-relative.
patch_file(_ctx: ptr, path: string) {
    _e = map.put(_ctx, "patch_file", path)
}

// on_platform(p) — require the leased node to self-report this platform
// (the /ping `platform` field, from the agent's os.platform(): "linux",
// "darwin", "windows", ...). When set, the lease skips pool nodes whose
// authenticated platform doesn't match — so an intention that needs macOS
// (`on_platform("darwin")`) discovers WHICH pool node is the Mac from its
// /ping, rather than the operator hardcoding it. Empty/unset = any
// platform. Only meaningful with the --agents pool (lease) path; with an
// explicit endpoint(...) the node is already chosen.
on_platform(_ctx: ptr, p: string) {
    _e = map.put(_ctx, "on_platform", p)
}

// --- Agent-side scope DSL setters (live on a scope map) ---

run_on(_ctx: ptr, kind: string) {
    _e = map.put(_ctx, "run_on", kind)
}

max_jobs(_ctx: ptr, n: int) {
    _e = map.put(_ctx, "max_jobs", string.from_int(n))
}

accept_scope(_ctx: ptr, glob: string) {
    if map.has(_ctx, "accept_scope") == 0 {
        _e1 = map.put(_ctx, "accept_scope", list.new())
    }
    globs, _ = map.get(_ctx, "accept_scope")
    _e2 = list.add(globs, glob)
}

// --- Pure decision helpers (I/O-free; tested in tests/) ---

// _scope_glob_match(glob, purpose) — does a request `purpose` satisfy an
// accept_scope `glob`? Skeleton grammar: a trailing "/*" matches any
// purpose with that prefix; "*" matches anything; otherwise exact match.
// (Intentionally small — the full hierarchical token grammar from the
// design doc is a later thickening.)
_scope_glob_match(glob: string, purpose: string) {
    if string.equals(glob, "*") == 1 { return 1 }
    n = string.length(glob)
    if n >= 2 {
        tail = string.substring(glob, n - 2, n)
        if string.equals(tail, "/*") == 1 {
            prefix = string.substring(glob, 0, n - 2)
            // "preint/*" matches "preint" and "preint/anything".
            if string.equals(purpose, prefix) == 1 { return 1 }
            pf = string.concat(prefix, "/")
            pfn = string.length(pf)
            if string.length(purpose) >= pfn {
                if string.equals(string.substring(purpose, 0, pfn), pf) == 1 {
                    return 1
                }
            }
            return 0
        }
    }
    if string.equals(glob, purpose) == 1 { return 1 }
    return 0
}

// _image_match(glob, image) — does a per-dispatch container `image` satisfy an
// agent's --allow-image `glob`? For run_on=podman, one agent can serve
// fine-grained jobs that each name the toolchain image they need (a Rust job
// asks for aeb-tc:rust, a JDK job for aeb-tc:jdk21); this glob is the lease gate
// on WHICH images that agent will run. Grammar (image-ref oriented, distinct
// from _scope_glob_match's "/*"): "*" allows anything; a trailing "*" is a
// PREFIX match ("aeb-tc:*" allows "aeb-tc:rust", "aeb-tc:jdk21", …); otherwise
// exact. Pure — the env-reading lease policy (_image_allowed) lives in the tool.
_image_match(glob: string, image: string) {
    if string.equals(glob, "*") == 1 { return 1 }
    n = string.length(glob)
    if n >= 1 {
        last = string.substring(glob, n - 1, n)
        if string.equals(last, "*") == 1 {
            prefix = string.substring(glob, 0, n - 1)
            pn = string.length(prefix)
            if string.length(image) >= pn {
                if string.equals(string.substring(image, 0, pn), prefix) == 1 { return 1 }
            }
            return 0
        }
    }
    if string.equals(glob, image) == 1 { return 1 }
    return 0
}

// prereq_to_image(token) — map a prereq toolchain token to its toolchain
// image, the requester-side half of the per-job-image protocol (ladder Rung 3).
// Convention (docs/agent-container-ladder.md): "<lang>:<ver>" -> "aeb-tc:<lang>-<ver>"
//   "rust:1.75" -> "aeb-tc:rust-1.75"   "jdk:21" -> "aeb-tc:jdk-21"
//   "go:1.22"   -> "aeb-tc:go-1.22"     "python:3.12" -> "aeb-tc:python-3.12"
// A token without ':' (no version) -> "aeb-tc:<token>". Pure. The agent gates
// the result via --allow-image; an operator override (AEB_IMAGE_MAP) is applied
// by the requesting tool BEFORE falling back to this default derivation.
prereq_to_image(token: string) {
    colon = string.index_of(token, ":")
    if colon < 0 {
        return string.concat("aeb-tc:", token)
    }
    lang = string.substring(token, 0, colon)
    ver = string.substring(token, colon + 1, string.length(token))
    return string.concat("aeb-tc:", string.concat(lang, string.concat("-", ver)))
}

// dominant_prereq(tokens_ws) — pick ONE prereq token from a whitespace-
// separated set (the whole-target Rung-3 cut: one image for the target). The
// FIRST token wins — extract-deps emits prereqs in first-seen dep order, so the
// target's own declared toolchain leads. "" set -> "". Pure.
dominant_prereq(tokens_ws: string) {
    t = string.trim(tokens_ws)
    if string.length(t) == 0 { return string.concat("", "") }
    // first whitespace-delimited token
    sp = string.index_of(t, " ")
    nl = string.index_of(t, "\n")
    cut = sp
    if nl >= 0 {
        if cut < 0 { cut = nl }
        else { if nl < cut { cut = nl } }
    }
    if cut < 0 { return string.concat(t, "") }
    return string.substring(t, 0, cut)
}

// _scope_accepts(scope_map, purpose) — 1 if any of the scope's
// accept_scope globs match the purpose. A scope with NO accept_scope
// declared accepts everything (open by default in the skeleton).
_scope_accepts(scope_map: ptr, purpose: string) {
    if map.has(scope_map, "accept_scope") == 0 { return 1 }
    globs, _ = map.get(scope_map, "accept_scope")
    n = list.size(globs)
    if n == 0 { return 1 }
    i = 0
    while i < n {
        g, _ = list.get(globs, i)
        if _scope_glob_match(g, purpose) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

// --- Provisioning modes (per-slot tree lifecycle; launch-constrained) ------
// See docs/agent-provisioning-modes.md. The agent OFFERS a set of modes at
// launch; a dispatch REQUESTS one; the agent serves / busies / rejects. Pure
// membership + allow-list helpers here; the tool wires them to the slot/tree.

// _csv_split(csv) — list of trimmed, non-empty comma-separated items. Pure.
_csv_split(csv: string) {
    out = list.new()
    rest = csv
    item = ""
    while string.length(rest) > 0 {
        c = string.index_of(rest, ",")
        if c < 0 { item = rest; rest = "" }
        else { item = string.substring(rest, 0, c); rest = string.substring(rest, c + 1, string.length(rest)) }
        item = string.trim(item)
        if string.length(item) > 0 { _a = list.add(out, item) }
    }
    return out
}

// _csv_contains(csv, want) — 1 if `want` is an exact (trimmed) member. Pure.
_csv_contains(csv: string, want: string) {
    items = _csv_split(csv)
    i = 0
    n = list.size(items)
    while i < n {
        it, _ = list.get(items, i)
        if string.equals(it, want) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

// _mode_offered(offered_csv, mode) — 1 if `mode` is in the agent's offered set.
// Empty offered set defaults to "patch" only (the safe default).
_mode_offered(offered_csv: string, mode: string) {
    off = offered_csv
    if string.length(off) == 0 { off = "patch" }
    return _csv_contains(off, mode)
}

// _branch_allowed(allow_csv, branch) — 1 if `branch` matches any glob in the
// allow-list (reuses the scope glob: "release/*" covers "release/1.2"). Empty
// allow-list => 0 (fail-closed: advance offered but no branch permitted).
_branch_allowed(allow_csv: string, branch: string) {
    if string.length(branch) == 0 { return 0 }
    globs = _csv_split(allow_csv)
    i = 0
    n = list.size(globs)
    while i < n {
        g, _ = list.get(globs, i)
        if _scope_glob_match(g, branch) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

// _autoclone_allowed(allow_csv, repo, branch) — 1 if (repo, branch) is permitted
// by the autoclone allow-list. Each entry is "<repo>" (any branch) or
// "<repo>#<branchglob>" (branch must glob-match). Empty allow-list => 0
// (fail-closed). Pure.
_autoclone_allowed(allow_csv: string, repo: string, branch: string) {
    if string.length(repo) == 0 { return 0 }
    entries = _csv_split(allow_csv)
    i = 0
    n = list.size(entries)
    while i < n {
        e, _ = list.get(entries, i)
        hash = string.index_of(e, "#")
        if hash < 0 {
            // repo-only entry: any branch allowed for this repo.
            if string.equals(e, repo) == 1 { return 1 }
        } else {
            e_repo = string.substring(e, 0, hash)
            e_brnch = string.substring(e, hash + 1, string.length(e))
            if string.equals(e_repo, repo) == 1 {
                if _scope_glob_match(e_brnch, branch) == 1 { return 1 }
            }
        }
        i = i + 1
    }
    return 0
}

// _has_free_slot(active, max_jobs_str) — capacity check. `active` is the
// count of in-flight jobs in this scope; max_jobs_str is the scope's
// declared cap ("" or "0" = unbounded). Returns 1 if a slot is free.
_has_free_slot(active: int, max_jobs_str: string) {
    if string.length(max_jobs_str) == 0 { return 1 }
    cap = _to_int(max_jobs_str)
    if cap <= 0 { return 1 }
    if active < cap { return 1 }
    return 0
}

_to_int(s: string) {
    n = string.length(s)
    if n == 0 { return 0 }
    i = 0
    v = 0
    digits = "0123456789"
    while i < n {
        c = string.substring(s, i, i + 1)
        d = string.index_of(digits, c)
        if d < 0 { return v }
        v = v * 10 + d
        i = i + 1
    }
    return v
}

// _decision(scope_map, purpose, active) -> "accept" | "busy" | "reject"
// The agent's per-request verdict, decided purely:
//   - reject : purpose not in any accept_scope of the scope
//   - busy   : accepted by scope but no free job slot
//   - accept : in-scope and a slot is free
// (Token authentication, when added, gates BEFORE this — an unauthenticated
// request never reaches the scope decision.)
_decision(scope_map: ptr, purpose: string, active: int) {
    if _scope_accepts(scope_map, purpose) == 0 { return "reject" }
    mj = ""
    if map.has(scope_map, "max_jobs") == 1 {
        mj, _ = map.get(scope_map, "max_jobs")
    }
    if _has_free_slot(active, mj) == 0 { return "busy" }
    return "accept"
}

// --- Naive token auth (pure helpers; tested) ---
//
// INTERIM, NAIVE: a flat file of bearer tokens, one per line (# comments
// and blank lines ignored). A presented token is authorized iff it
// appears in the file. This authenticates only "you hold a shared
// secret" — NO signing, NO expiry, NO embedded/verified scope, NO
// per-principal issuance. It is the stand-in for the real
// claim→verify→veto / purpose-in-the-token model
// (docs/run-policy-class-and-cloud-leverage.md), so a sysop has a real
// on/off today. Scope stays the agent's --accept; a token only gates
// "may dispatch at all." Do NOT mistake this for the designed model.

// _parse_tokens(content) — a generic line-set parser: one entry per non-blank,
// non-"#"-comment line, surrounding whitespace trimmed, returned as a set-map
// (line -> "1"). Used by the agent to COUNT the secrets in a --lease-secrets
// file (dedup + ignore comments/blanks); the line-set shape is incidental.
_parse_tokens(content: string) {
    toks = map.new()
    rest = content
    line = ""
    while string.length(rest) > 0 {
        nl = string.index_of(rest, "\n")
        if nl < 0 {
            line = rest
            rest = ""
        } else {
            line = string.substring(rest, 0, nl)
            rest = string.substring(rest, nl + 1, string.length(rest))
        }
        line = string.trim(line)
        if string.length(line) > 0 {
            first = string.substring(line, 0, 1)
            if string.equals(first, "#") == 0 {
                _p = map.put(toks, line, "1")
            }
        }
    }
    return toks
}

// --- Agent pool (originator-side; --agents file) -------------------
//
// A pool file lists candidate agent nodes, one per line:
//   <url> - <token>     e.g.  http://192.168.0.57:9440 - ping-secret-123
//   <url>               (token then comes from token()/env)
// `#` comments and blank lines ignored. The originator leases the FIRST
// node that is reachable + accepts the purpose + not busy (probed via
// /ping), falling through to the next on busy/unreachable/reject.

// _pool_url_of(line) / _pool_token_of(line) — split a pool line into URL +
// token. Accepts EITHER separator: a TAB ("\t") or " - " (space-dash-space).
// Tab is the natural choice when scripting a pool file (printf '%s\t%s'); the
// " - " form is the human-written documented one. URL is the part before the
// FIRST separator found, token the part after (trimmed), or "" if neither is
// present. Pure.
//
// _pool_sep_index returns the separator's start index (-1 if none).
// _pool_sep_len returns how many chars that separator occupies (1 for tab,
// 3 for " - "), so the token slice skips the right amount — the historic bug
// was a hardcoded +3 that only matched " - ".
_pool_sep_index(line: string) {
    tab = string.index_of(line, "\t")
    dash = string.index_of(line, " - ")
    if tab < 0 { return dash }
    if dash < 0 { return tab }
    // both present — the earlier one wins
    if tab < dash { return tab }
    return dash
}

_pool_sep_len(line: string) {
    idx = _pool_sep_index(line)
    if idx < 0 { return 0 }
    // tab is 1 char, " - " is 3. Disambiguate by the char AT idx.
    if string.equals(string.substring(line, idx, idx + 1), "\t") == 1 { return 1 }
    return 3
}

_pool_url_of(line: string) {
    t = string.trim(line)
    idx = _pool_sep_index(t)
    if idx < 0 { return t }
    return string.trim(string.substring(t, 0, idx))
}

_pool_token_of(line: string) {
    t = string.trim(line)
    idx = _pool_sep_index(t)
    if idx < 0 { return "" }
    seplen = _pool_sep_len(t)
    return string.trim(string.substring(t, idx + seplen, string.length(t)))
}

// _parse_pool(content) — newline-split a pool file into a list of
// non-blank, non-comment lines (each still in `<url> - <token>` form;
// use _pool_url_of / _pool_token_of to split). Preserves order (lease
// tries them in file order). Pure.
_parse_pool(content: string) {
    out = list.new()
    rest = content
    line = ""
    while string.length(rest) > 0 {
        nl = string.index_of(rest, "\n")
        if nl < 0 {
            line = rest
            rest = ""
        } else {
            line = string.substring(rest, 0, nl)
            rest = string.substring(rest, nl + 1, string.length(rest))
        }
        line = string.trim(line)
        if string.length(line) > 0 {
            first = string.substring(line, 0, 1)
            if string.equals(first, "#") == 0 {
                _a = list.add(out, line)
            }
        }
    }
    return out
}

// _bearer_strip(header_value) — pull the token out of an
// "Authorization: Bearer <tok>" value, or return the value verbatim if
// it has no "Bearer " prefix (so an X-AEB-Token raw value also works).
_bearer_strip(header_value: string) {
    v = string.trim(header_value)
    pfx = "Bearer "
    if string.length(v) >= string.length(pfx) {
        if string.equals(string.substring(v, 0, string.length(pfx)), pfx) == 1 {
            return string.trim(string.substring(v, string.length(pfx), string.length(v)))
        }
    }
    return v
}

// --- Lease tokens: HMAC-signed, purpose-bound, expiring (pure; tested) ----
//
// The real-auth thickening of the flat --tokens bearer set. A LEASE token is
// self-describing and unforgeable without the shared signing secret, per
// "A Purpose in a Token" (docs/run-policy-class-and-cloud-leverage.md §trust):
//
//   ae1.<purpose>.<expiry_unix_ms>.<hmac_sha256_hex>
//        \_______________________/  \____________/
//         the SIGNED PREFIX           proves the prefix wasn't forged
//
// - purpose: legibly in the middle (e.g. "preint/phammant/rust"). The agent
//   verifies the DISPATCH's purpose is covered by the token's purpose (glob),
//   so a token minted for one purpose can't be replayed for another.
// - expiry_unix_ms: the lease's hard deadline; the agent rejects past it.
// - hmac: HMAC-SHA256(secret, "ae1.<purpose>.<expiry>") in hex. Only a holder
//   of the secret can mint; the agent only VERIFIES (never self-issues —
//   issuance lives with the lessor/issuer, the doc's hard rule). Rotating the
//   secret revokes every outstanding lease.
//
// Why "." separated, not JSON/JWT: keeps the verifier a few pure string ops
// (no parser, no clock skew tolerance to misconfigure) — a small, auditable
// spine. The purpose itself must not contain "." (canonical purposes use "/").
//
// The version tag is the literal "ae1" (Aether has no module-level constants —
// see the no-pre-entry-execution rule — so it's inlined / via _lease_tag()).

// _lease_tag() — the lease-token version tag. A fn (not a const) because
// Aether forbids top-level executable statements.
_lease_tag() { return "ae1" }

// _looks_like_token(s) — 1 if `s` looks like a minted lease TOKEN
// ("ae1.<purpose>.<expiry>.<sig>"), not a signing SECRET. A signing secret is
// opaque high-entropy bytes; a value starting with the "ae1." tag is almost
// certainly a token pasted into the secret slot by mistake (the footgun:
// `aeb-lease … > lease.secret` overwrites the key with a token). Both the minter
// and the agent reject it loudly. Pure.
_looks_like_token(s: string) {
    pfx = string.concat(_lease_tag(), ".")   // "ae1."
    t = string.trim(s)
    if string.length(t) < string.length(pfx) { return 0 }
    if string.equals(string.substring(t, 0, string.length(pfx)), pfx) == 1 { return 1 }
    return 0
}

// _secret_marker() — the required prefix on every aeb signing-secret file/line.
// A secret is stored as "aeb-secret-v1:<hex>". The marker makes secrets
// GREPPABLE for a security sweep (`grep -rl 'aeb-secret-v1:' /`) and lets aeb
// REFUSE a bare blob that isn't a recognized aeb secret. It is METADATA ONLY —
// the HMAC keys on the <hex> after it, so the marker adds nothing to (and takes
// nothing from) the cryptography; it's an operational/discoverability envelope.
_secret_marker() { return "aeb-secret-v1:" }

// _secret_key_material(line) — the HMAC key bytes from a secret envelope:
// the part AFTER the "aeb-secret-v1:" marker. Returns "" if the line lacks the
// marker (→ not a usable aeb secret; callers refuse). Trimmed. Pure.
_secret_key_material(line: string) {
    m = _secret_marker()
    t = string.trim(line)
    if string.length(t) < string.length(m) { return "" }
    if string.equals(string.substring(t, 0, string.length(m)), m) == 0 { return "" }
    return string.trim(string.substring(t, string.length(m), string.length(t)))
}

// _secret_strength_ok(s) — does a signing secret look high-entropy enough to
// HMAC with? BEST-EFFORT, deliberately swappable for something better later.
// Today: a LENGTH FLOOR (>= 32 chars). Rationale (measured): `openssl rand -hex
// 32` is 64 chars and `rand -base64 24` is 32 — both pass; lazy hand-typed
// secrets ('St4ndrdT1ngTh3yC4nRmbr'=22, 'password123'=11) fall short. (A
// distinct-char-ratio test is WRONG here: hex secrets have only 16 distinct
// chars, lower-ratio than a weak mixed-case string — length is the honest
// signal.) Both the GENERATOR (issue-time) and the verifier run this SAME test,
// so a false-positive is harmless — the generator just re-rolls — which is what
// lets the verifier HARD-refuse a weak secret with confidence. Returns 1 ok / 0 weak.
_secret_strength_ok(s: string) {
    t = string.trim(s)
    if string.length(t) < 32 { return 0 }
    return 1
}

// _secrets_no_marker_line(text) — the first non-blank, non-"#" line that lacks
// the "aeb-secret-v1:" envelope marker, or "" if all lines are enveloped. The
// agent refuses to start if any secret isn't a recognized aeb secret. Pure.
_secrets_no_marker_line(text: string) {
    rest = text
    line = ""
    while string.length(rest) > 0 {
        nl = string.index_of(rest, "\n")
        if nl < 0 { line = rest; rest = "" }
        else { line = string.substring(rest, 0, nl); rest = string.substring(rest, nl + 1, string.length(rest)) }
        line = string.trim(line)
        if string.length(line) > 0 {
            first = string.substring(line, 0, 1)
            if string.equals(first, "#") == 0 {
                if string.length(_secret_key_material(line)) == 0 { return line }
            }
        }
    }
    return ""
}

// _secrets_weak_line(text) — the first non-blank, non-"#" secret line whose KEY
// MATERIAL (after the marker) FAILS the entropy floor, or "" if all are strong.
// Pure; mirrors the line walk. Run after _secrets_no_marker_line (so material is
// present).
_secrets_weak_line(text: string) {
    rest = text
    line = ""
    while string.length(rest) > 0 {
        nl = string.index_of(rest, "\n")
        if nl < 0 { line = rest; rest = "" }
        else { line = string.substring(rest, 0, nl); rest = string.substring(rest, nl + 1, string.length(rest)) }
        line = string.trim(line)
        if string.length(line) > 0 {
            first = string.substring(line, 0, 1)
            if string.equals(first, "#") == 0 {
                if _secret_strength_ok(_secret_key_material(line)) == 0 { return line }
            }
        }
    }
    return ""
}

// _secrets_have_token(text) — 1 if ANY non-blank, non-"#" line of a
// --lease-secrets file looks like a minted token ("ae1.…") rather than an opaque
// signing secret. Catches the footgun of pasting a token into the secret file.
// Pure; mirrors _parse_tokens' line walk.
_secrets_have_token(text: string) {
    rest = text
    line = ""
    while string.length(rest) > 0 {
        nl = string.index_of(rest, "\n")
        if nl < 0 { line = rest; rest = "" }
        else { line = string.substring(rest, 0, nl); rest = string.substring(rest, nl + 1, string.length(rest)) }
        line = string.trim(line)
        if string.length(line) > 0 {
            first = string.substring(line, 0, 1)
            if string.equals(first, "#") == 0 {
                if _looks_like_token(line) == 1 { return 1 }
            }
        }
    }
    return 0
}

// _lease_field(token, i) — the i-th "."-separated field of a lease token
// (0=tag,1=purpose,2=expiry,3=sig). "" if absent. Pure.
_lease_field(token: string, idx: int) {
    rest = token
    i = 0
    while i < idx {
        dot = string.index_of(rest, ".")
        if dot < 0 { return "" }
        rest = string.substring(rest, dot + 1, string.length(rest))
        i = i + 1
    }
    dot = string.index_of(rest, ".")
    if dot < 0 { return rest }
    return string.substring(rest, 0, dot)
}

// _lease_purpose_valid(purpose) — enforce the CANONICAL purpose grammar at
// MINT time ("constrained at issuance", per "A Purpose in a Token", 2021). A
// purpose lives legibly in the middle of the token AND is inside the signed
// bytes — so it must be unambiguous across every system that reads it back. The
// grammar is the slash-path the codebase already uses (preint/phammant/rust,
// ci/aether/main): one or more "/"-separated segments, each [a-z0-9_-]+, with
// an optional trailing "/*" minting scope (covers preint/phammant/anything).
//   NO uppercase, NO spaces, NO ".", NO unicode/control chars, no empty segments.
// Returns "" if valid, else a human-readable reason naming the problem. Pure;
// the agent never mints, so this gates the LESSOR (aeb-lease). The flip side of
// "agents resolve the unbounded stuff": the token vocabulary must be canonical.
_lease_purpose_valid(purpose: string) {
    n = string.length(purpose)
    if n == 0 { return "empty purpose" }
    // Strip an optional trailing "/*" scope, then validate the body as a path.
    body = purpose
    if n >= 2 {
        if string.equals(string.substring(purpose, n - 2, n), "/*") == 1 {
            body = string.substring(purpose, 0, n - 2)
            if string.length(body) == 0 { return "purpose '*' alone is not a scope (use 'preint/*')" }
        }
    }
    // A bare "*" (match-anything) is intentionally NOT mintable — too broad for
    // a lease; the operator's --accept can be "*", but a TOKEN must name a scope.
    if string.equals(purpose, "*") == 1 { return "purpose '*' is too broad to mint; name a scope (e.g. preint/*)" }
    // Walk the body: segments split on "/", each [a-z0-9_-]+ and non-empty.
    seg_len = 0
    i = 0
    bn = string.length(body)
    allowed = "abcdefghijklmnopqrstuvwxyz0123456789-_"
    while i < bn {
        c = string.substring(body, i, i + 1)
        if string.equals(c, "/") == 1 {
            if seg_len == 0 { return "purpose has an empty path segment (got '${purpose}')" }
            seg_len = 0
        } else {
            if string.index_of(allowed, c) < 0 {
                return "purpose char '${c}' not allowed (canonical: lowercase a-z, 0-9, '-', '_', '/', optional trailing '/*'; got '${purpose}')"
            }
            seg_len = seg_len + 1
        }
        i = i + 1
    }
    if seg_len == 0 { return "purpose ends with an empty segment (trailing '/'? got '${purpose}')" }
    return ""
}

// _lease_signed_prefix(purpose, expiry) — the exact bytes the HMAC covers.
_lease_signed_prefix(purpose: string, expiry: string) {
    return string.concat(_lease_tag(), string.concat(".", string.concat(purpose, string.concat(".", expiry))))
}

// _lease_sign(secret, purpose, expiry) — HMAC-SHA256 hex over the signed
// prefix. Returns "" if openssl is unavailable (caller treats as fail-closed).
_lease_sign(secret: string, purpose: string, expiry: string) {
    pre = _lease_signed_prefix(purpose, expiry)
    sig, err = cryptography.hmac_sha256_hex(secret, string.length(secret), pre, string.length(pre))
    if string.length(err) > 0 { return "" }
    return sig
}

// _lease_mint(secret, purpose, expiry) — build a full lease token. Issuer-side
// helper (and the tests' fixture); the AGENT never calls this. Pure.
_lease_mint(secret: string, purpose: string, expiry: string) {
    sig = _lease_sign(secret, purpose, expiry)
    if string.length(sig) == 0 { return "" }
    return string.concat(_lease_signed_prefix(purpose, expiry), string.concat(".", sig))
}

// _lease_verify(secret, token, now_ms, req_purpose) — the agent-side gate.
// Returns "" if the lease is valid for this dispatch, else a non-empty REASON
// (the verdict logs it). Fail-closed: any malformedness / bad sig / expiry /
// purpose-mismatch is a refusal. now_ms is the current unix-ms clock (passed in
// so the function stays pure + testable). _atoi_ms parses the expiry.
_lease_verify(secret: string, token: string, now_ms: long, req_purpose: string) {
    if string.length(secret) == 0 { return "lease: no signing secret (fail-closed)" }
    if string.length(token) == 0 { return "lease: empty token" }
    // Unwrap the secret envelope: HMAC keys on the material AFTER the
    // "aeb-secret-v1:" marker. A secret without the marker is not a recognized
    // aeb secret — refuse (a bare blob copied into place won't work in situ).
    keymat = _secret_key_material(secret)
    if string.length(keymat) == 0 { return "lease: secret lacks the aeb-secret-v1: marker (not an aeb secret)" }
    secret = keymat
    tag = _lease_field(token, 0)
    if string.equals(tag, _lease_tag()) == 0 { return "lease: not an ae1 token" }
    purpose = _lease_field(token, 1)
    expiry = _lease_field(token, 2)
    sig = _lease_field(token, 3)
    if string.length(purpose) == 0 { return "lease: missing purpose" }
    if string.length(expiry) == 0 { return "lease: missing expiry" }
    if string.length(sig) == 0 { return "lease: missing signature" }
    // 1. Signature: recompute over the prefix; constant-string compare.
    want = _lease_sign(secret, purpose, expiry)
    if string.length(want) == 0 { return "lease: cannot verify (openssl unavailable)" }
    if string.equals(sig, want) == 0 { return "lease: bad signature (forged or wrong secret)" }
    // 1b. Canonical purpose — defense-in-depth: the verifier re-applies the
    //     mint-time grammar so a patched/rogue minter (holding the secret) can't
    //     smuggle a non-canonical purpose (uppercase/spaces/dots/unicode) past
    //     the trust boundary. "Constrained at issuance" AND at verification.
    pgrm = _lease_purpose_valid(purpose)
    if string.length(pgrm) > 0 { return "lease: non-canonical purpose (${pgrm})" }
    // 2. Expiry: reject at/after the deadline. string.to_long is overflow-safe
    //    (unix-ms ~1.7e12 exceeds int32); a non-numeric expiry => fail-closed.
    exp_ms, exp_err = string.to_long(expiry)
    if string.length(exp_err) > 0 { return "lease: malformed expiry" }
    if exp_ms <= now_ms { return "lease: expired" }
    // 3. Purpose binding: the token's purpose must COVER the requested purpose
    //    (same glob grammar as scopes — "preint/*" token covers "preint/rust").
    if _scope_glob_match(purpose, req_purpose) == 0 {
        return "lease: purpose '${req_purpose}' not covered by token purpose '${purpose}'"
    }
    return ""
}

// _lease_verify_any(secrets_text, token, now_ms, req_purpose) — verify against a
// SET of signing secrets (one per non-blank, non-"#" line of secrets_text).
// Accepts iff the token verifies under ANY secret; this is the zero-downtime
// ROTATION primitive (accept old+new during the overlap, then drop old). A list
// is NOT a roles mechanism — a secret is a key, not a role; any accepted secret
// can mint any purpose. Keep the list small (rotation overlap), since an unknown
// token costs one HMAC per secret.
//
// Reason selection on total failure: a "bad signature" just means "not THIS
// key", so when a token's signature DOES match some secret but it still fails
// (expired / wrong-purpose / malformed), surface THAT reason — it's the real
// verdict — in preference to the bad-signature noise from the other keys. If it
// fails signature under every secret, report bad-signature (genuinely forged or
// an unknown/retired key).
_lease_verify_any(secrets_text: string, token: string, now_ms: long, req_purpose: string) {
    // Pre-token-shape checks don't depend on the secret — do them once.
    if string.length(token) == 0 { return "lease: empty token" }
    sig_fail = ""           // a bad-signature reason seen (fallback)
    nonsig_fail = ""        // a signature-matched-but-other-failure reason (preferred)
    any_secret = 0
    rest = secrets_text
    line = ""
    while string.length(rest) > 0 {
        nl = string.index_of(rest, "\n")
        if nl < 0 { line = rest; rest = "" }
        else { line = string.substring(rest, 0, nl); rest = string.substring(rest, nl + 1, string.length(rest)) }
        line = string.trim(line)
        if string.length(line) > 0 {
            first = string.substring(line, 0, 1)
            if string.equals(first, "#") == 0 {
                any_secret = 1
                r = _lease_verify(line, token, now_ms, req_purpose)
                if string.length(r) == 0 { return "" }   // verified under this secret
                // Classify the failure: signature mismatch is "wrong key";
                // anything else means this key DID sign it but it's otherwise bad.
                if string.index_of(r, "bad signature") >= 0 { sig_fail = r }
                else { nonsig_fail = r }
            }
        }
    }
    if any_secret == 0 { return "lease: no signing secret (fail-closed)" }
    if string.length(nonsig_fail) > 0 { return nonsig_fail }
    if string.length(sig_fail) > 0 { return sig_fail }
    return "lease: bad signature (forged or wrong secret)"
}

// --- Wire payloads (pure builders; tested) ---

// dispatch_request_json — the fire payload the originator POSTs to the
// agent's /dispatch. Carries (all string fields, flat JSON):
//   guid, target, purpose            — always
//   ref, hash                        — fetch-base: agent does
//                                      `git fetch origin <ref> && git
//                                      checkout <hash>` in its --repo
//                                      before building ("" = skip, build
//                                      the workdir as-is)
//   patch_b64                        — base64 of a unified diff applied
//                                      (git apply) onto the checked-out
//                                      base ("" = no patch). Base64 so the
//                                      diff's newlines/quotes don't break
//                                      the flat-JSON wire; the agent
//                                      decodes via shell `base64 -d` to a
//                                      temp file (no Aether string handling
//                                      of the binary-ish diff).
// (Pre-integration model: trusted base from origin + the requester's
// untrusted patch delta — which maybe_veto_build then scrutinizes.)
// The common 6-field form. For the optional run_on=podman "image" and
// run_on=vm "command" fields, use dispatch_request_json_ex (this delegates).
dispatch_request_json(guid: string, target: string, purpose: string,
                      ref: string, hash: string, patch_b64: string) {
    return dispatch_request_json_ex(guid, target, purpose, ref, hash, patch_b64, "", "")
}

// dispatch_request_json_ex — adds the optional per-dispatch routing fields:
//   image    — run_on=podman toolchain image override (agent gates via
//              --allow-image). "" omits it.
//   command  — run_on=vm RAW build command (build.sh / make / cmake) run in
//              the tree root instead of `aeb <target>`; the agent honours it
//              only with --allow-vm-command. "" omits it (default aeb <target>).
// Both are emitted only when non-empty, so the wire stays minimal and the
// agent's _json_field("image"/"command") sees "" when absent.
dispatch_request_json_ex(guid: string, target: string, purpose: string,
                         ref: string, hash: string, patch_b64: string,
                         image: string, command: string) {
    out = "{"
    out = string.concat(out, "\"guid\":\"")
    out = string.concat(out, guid)
    out = string.concat(out, "\",\"target\":\"")
    out = string.concat(out, target)
    out = string.concat(out, "\",\"purpose\":\"")
    out = string.concat(out, purpose)
    out = string.concat(out, "\",\"ref\":\"")
    out = string.concat(out, ref)
    out = string.concat(out, "\",\"hash\":\"")
    out = string.concat(out, hash)
    out = string.concat(out, "\",\"patch_b64\":\"")
    out = string.concat(out, patch_b64)
    if string.length(image) > 0 {
        out = string.concat(out, "\",\"image\":\"")
        out = string.concat(out, image)
    }
    if string.length(command) > 0 {
        out = string.concat(out, "\",\"command\":\"")
        out = string.concat(out, command)
    }
    out = string.concat(out, "\"}")
    return out
}

// ping_json(platform, accept, busy, max_jobs, auth) — the agent's
// identity + capability descriptor, returned by an (auth-gated) GET
// /ping. Lets an authorized originator confirm it's really an aeb-agent
// and learn the platform / accept-scope / busy / auth posture BEFORE
// committing a dispatch. `busy` and `auth` are pre-rendered strings
// ("true"/"false", "required"/"open"). Pure.
ping_json(platform: string, accept: string, busy: string, max_jobs: string, auth: string) {
    return ping_json_ex(platform, accept, busy, max_jobs, auth, "", "")
}

// ping_json_ex — adds the toolchain version fields an originator wants BEFORE
// dispatching: `aeb_version` (first line of `aeb --version`) and
// `aether_version` (first line of `aetherc --version` — the LIVE compiler the
// agent would build with). Both emitted only when non-empty, so a probe failure
// just omits the field (the originator sees "" via _json_field). Lets a caller
// confirm an agent's toolchain is new enough for a build's feature needs across
// a mixed-version fleet.
ping_json_ex(platform: string, accept: string, busy: string, max_jobs: string, auth: string,
             aeb_version: string, aether_version: string) {
    out = "{\"agent\":\"aeb-agent\""
    out = string.concat(out, ",\"platform\":\"")
    out = string.concat(out, platform)
    out = string.concat(out, "\",\"accept\":\"")
    out = string.concat(out, accept)
    out = string.concat(out, "\",\"busy\":")
    out = string.concat(out, busy)
    out = string.concat(out, ",\"max_jobs\":")
    mj = max_jobs
    if string.length(mj) == 0 { mj = "0" }
    out = string.concat(out, mj)
    out = string.concat(out, ",\"auth\":\"")
    out = string.concat(out, auth)
    out = string.concat(out, "\"")
    if string.length(aeb_version) > 0 {
        out = string.concat(out, ",\"aeb_version\":\"")
        out = string.concat(out, aeb_version)
        out = string.concat(out, "\"")
    }
    if string.length(aether_version) > 0 {
        out = string.concat(out, ",\"aether_version\":\"")
        out = string.concat(out, aether_version)
        out = string.concat(out, "\"")
    }
    out = string.concat(out, "}")
    return out
}

// dispatch_reply_json(guid, status, result) — the skinny terse verdict the
// agent returns. status ∈ accepted|busy|rejected|done; result ∈ pass|fail
// (only meaningful when status=done). The details_url field is a later
// thickening; omitted in the skeleton.
dispatch_reply_json(guid: string, status: string, result: string) {
    out = "{"
    out = string.concat(out, "\"guid\":\"")
    out = string.concat(out, guid)
    out = string.concat(out, "\",\"status\":\"")
    out = string.concat(out, status)
    out = string.concat(out, "\",\"result\":\"")
    out = string.concat(out, result)
    out = string.concat(out, "\"}")
    return out
}

// _json_field(body, key) — minimal flat-JSON string-field extractor for
// the skeleton's own payloads (no nested objects). Returns "" if absent.
// (Skeleton-grade; a real JSON parse replaces this when payloads grow.)
_json_field(body: string, key: string) {
    needle = string.concat(string.concat("\"", key), "\":\"")
    idx = string.index_of(body, needle)
    if idx < 0 { return "" }
    rest = string.substring(body, idx + string.length(needle), string.length(body))
    end = string.index_of(rest, "\"")
    if end < 0 { return "" }
    return string.substring(rest, 0, end)
}

// _gen_guid() — a unique-enough request id for correlation (pid +
// monotonic ns). Not a cryptographic UUID; the skeleton only needs it to
// tie a fire to its reply.
_gen_guid() {
    pid = os.getpid()
    ns = os.now_monotonic_ns()
    return string.concat(string.concat("aeb-", string.from_int(pid)), string.concat("-", string.from_long(ns)))
}

// _ping_node(url, token, purpose) -> 1 if this node is usable for the
// purpose: reachable, authenticated, accepts the purpose, not busy.
// Probes GET /ping (auth-gated) and inspects the capability JSON.
// Returns 0 on any miss (unreachable / 401 / wrong scope / busy) so the
// lease loop falls through to the next node. Best-effort + side-effect-
// free beyond the network probe.
_ping_node(url: string, token: string, purp: string, want_platform: string) {
    ping_url = string.concat(url, "/ping")
    creq = client.request("GET", ping_url)
    _h = client.set_header(creq, "X-AEB-Token", token)
    cresp, err = client.send_request(creq)
    if string.length(err) > 0 {
        client.request_free(creq)
        return 0
    }
    code = client.response_status(cresp)
    body = client.response_body(cresp)
    accept = _json_field(body, "accept")
    busy = _json_field(body, "busy")
    platform = _json_field(body, "platform")
    client.response_free(cresp)
    client.request_free(creq)
    if code != 200 { return 0 }
    // accept scope must admit the purpose (reuse the agent-side matcher).
    if _scope_glob_match(accept, purp) == 0 { return 0 }
    // busy is "true"/"false" in the capability JSON.
    if string.equals(busy, "true") == 1 { return 0 }
    // platform requirement (on_platform): the node's SELF-REPORTED,
    // authenticated platform must match. "" means no requirement (any).
    // This is how a darwin-needing intention discovers which pool node
    // is the Mac — the env-var/file order is just candidate order; the
    // authenticated /ping platform is the fact that decides.
    if string.length(want_platform) > 0 {
        if string.equals(platform, want_platform) == 0 { return 0 }
    }
    return 1
}

// _lease_node(pool_content, purp, token_hint) -> "url\ttoken" of the
// FIRST node in the pool that _ping_node accepts, or "" if none. The
// per-line token wins; token_hint (from token()/env) is the fallback for
// url-only lines. Pure-ish (network probes via _ping_node, no other I/O).
_lease_node(pool_content: string, purp: string, token_hint: string, want_platform: string) {
    nodes = _parse_pool(pool_content)
    n = list.size(nodes)
    i = 0
    while i < n {
        line, _ = list.get(nodes, i)
        url = _pool_url_of(line)
        tok = _pool_token_of(line)
        if string.length(tok) == 0 { tok = token_hint }
        if string.length(url) > 0 {
            if _ping_node(url, tok, purp, want_platform) == 1 {
                return string.concat(string.concat(url, "\t"), tok)
            }
        }
        i = i + 1
    }
    return ""
}

// --- Originator builder: agent.dispatch(b) { endpoint(...) target(...) }
//
// Fires one dispatch at a remote aeb-agent and folds the verdict into the
// build. Endpoint resolution, in order:
//   1. explicit endpoint(...) on the builder, OR
//   2. LEASE from the --agents pool ($AEB_AGENTS, set by the trampoline):
//      /ping each node in file order, dispatch to the FIRST reachable +
//      authenticated + purpose-accepting + non-busy node.
// Walking skeleton: synchronous http (the agent replies with the final
// verdict in-band); fire-async + webhook-back is a later thickening.
// v1 backpressure: busy / rejected / unreachable / no-leasable-node all
// FAIL BACK to the user (build.fail), no retry.
builder dispatch(ctx: ptr) {
    mod_dir = build._get(ctx, "module_dir")

    // NB: locals must NOT be named target/purpose — those are setter
    // function names in this module, and string interpolation of a bare
    // `${target}` binds to the FUNCTION (a pointer → garbage), not the
    // local. (Same reason endpoint is read into `ep`.) Use tgt/purp.
    ep = ""
    tgt = ""
    purp = "preint"
    tok = ""
    want_platform = ""
    if _builder != null {
        if map.has(_builder, "endpoint") == 1 {
            ep, _ = map.get(_builder, "endpoint")
        }
        if map.has(_builder, "target") == 1 {
            tgt, _ = map.get(_builder, "target")
        }
        if map.has(_builder, "purpose") == 1 {
            purp, _ = map.get(_builder, "purpose")
        }
        if map.has(_builder, "token") == 1 {
            tok, _ = map.get(_builder, "token")
        }
        if map.has(_builder, "on_platform") == 1 {
            want_platform, _ = map.get(_builder, "on_platform")
        }
    }
    if string.length(tgt) == 0 {
        println("${mod_dir}: agent.dispatch requires target(...)")
        build.fail(ctx, "agent.dispatch: no target")
        return 1
    }

    // Endpoint: explicit endpoint(...) wins; else LEASE from the
    // --agents pool ($AEB_AGENTS). The lease /pings each node and picks
    // the first reachable + authenticated + purpose-accepting + non-busy
    // node that ALSO matches on_platform(...) if set.
    if string.length(ep) == 0 {
        pool_file = os.getenv("AEB_AGENTS")
        if string.length(pool_file) == 0 {
            println("${mod_dir}: agent.dispatch needs endpoint(...) or a pool via --agents/$AEB_AGENTS")
            build.fail(ctx, "agent.dispatch: no endpoint and no --agents pool")
            return 1
        }
        pool_content, _pe = io.read_file(pool_file)
        leased = _lease_node(pool_content, purp, tok, want_platform)
        if string.length(leased) == 0 {
            disp = want_platform
            if string.length(disp) == 0 { disp = "any platform" }
            println("${mod_dir}: no leasable agent in pool for purpose='${purp}' platform='${disp}' (all busy/unreachable/incompatible)")
            build.fail(ctx, "agent.dispatch: no leasable node in pool")
            return 1
        }
        // leased = "url\ttoken"
        tabi = string.index_of(leased, "\t")
        ep = string.substring(leased, 0, tabi)
        tok = string.substring(leased, tabi + 1, string.length(leased))
        println("${mod_dir}: leased agent ${ep} for purpose='${purp}'")
    }

    // Fetch-base + patch fields. ref/hash tell the agent to
    // `git fetch origin <ref> && git checkout <hash>` before building;
    // patch_file is a unified diff applied on top. The diff is base64'd
    // into the wire (via shell `base64`, no Aether handling of the binary-
    // ish diff) so its newlines/quotes don't break the flat-JSON payload.
    gref = ""
    ghash = ""
    patch_b64 = ""
    if _builder != null {
        if map.has(_builder, "ref") == 1 { gref, _ = map.get(_builder, "ref") }
        if map.has(_builder, "hash") == 1 { ghash, _ = map.get(_builder, "hash") }
        if map.has(_builder, "patch_file") == 1 {
            pf, _ = map.get(_builder, "patch_file")
            pf_abs = pf
            if string.length(pf) > 0 {
                first = string.substring(pf, 0, 1)
                if string.equals(first, "/") == 0 {
                    pf_abs = path.join(build._get(ctx, "source_dir"), pf)
                }
                if file.exists(pf_abs) == 0 {
                    println("${mod_dir}: agent.dispatch patch_file not found: ${pf_abs}")
                    build.fail(ctx, "agent.dispatch: patch_file not found")
                    return 1
                }
                // base64 (single line, -w0) so it's one clean JSON value.
                enc_raw, _ee = build._sh_capture("base64 -w0 '${pf_abs}' 2>/dev/null || base64 '${pf_abs}' | tr -d '\n'")
                patch_b64 = string.trim(enc_raw)
            }
        }
    }

    guid = _gen_guid()
    url = string.concat(ep, "/dispatch")
    req_body = dispatch_request_json(guid, tgt, purp, gref, ghash, patch_b64)
    pdisp = "no-patch"
    if string.length(patch_b64) > 0 { pdisp = "+patch" }
    cdisp = "workdir"
    if string.length(ghash) > 0 { cdisp = ghash }
    println("${mod_dir}: dispatch ${guid} → ${url} target=${tgt} purpose=${purp} base=${cdisp} ${pdisp}")

    // v2 client: lets us send the X-AEB-Token header AND read the status
    // code (v1 http.post collapses any 4xx/5xx into a generic error, so we
    // couldn't tell reject(403) from busy(503) from a real outage).
    creq = client.request("POST", url)
    _sh = client.set_header(creq, "X-AEB-Token", tok)
    _sb = client.set_body(creq, req_body, string.length(req_body), "application/json")
    cresp, err = client.send_request(creq)
    if string.length(err) > 0 {
        // Transport failure — agent unreachable. v1: fail back to user.
        client.request_free(creq)
        println("${mod_dir}: dispatch ${guid} FAILED — ${err} (agent unreachable)")
        build.fail(ctx, "agent unreachable: ${err}")
        return 1
    }
    // Parse BEFORE freeing: response_body returns a borrowed buffer owned
    // by cresp; response_free invalidates it (LLM.md borrowed-string rule).
    // Reading status/result first keeps the parse off freed memory.
    code = client.response_status(cresp)
    body = client.response_body(cresp)
    status = _json_field(body, "status")
    result = _json_field(body, "result")
    client.response_free(cresp)
    client.request_free(creq)

    // 401 = token rejected; 403 = out of scope; 503 = busy. All fail back
    // to the user in v1 (no retry). 200 = done → check the build result.
    if code != 200 {
        reason = status
        if string.length(reason) == 0 { reason = "http ${code}" }
        println("${mod_dir}: dispatch ${guid} REFUSED — ${reason} (HTTP ${code})")
        build.fail(ctx, "agent refused: ${reason}")
        return 1
    }
    if string.equals(status, "done") == 0 {
        println("${mod_dir}: dispatch ${guid} unexpected status '${status}'")
        build.fail(ctx, "agent dispatch status ${status}")
        return 1
    }
    if string.equals(result, "pass") == 0 {
        println("${mod_dir}: dispatch ${guid} → remote build FAILED")
        build.fail(ctx, "remote build failed on agent")
        return 1
    }
    println("${mod_dir}: dispatch ${guid} → remote build PASSED")
    return 0
}

// ============================================================================
// Tier-A veto: pluggable tree/patch scan (docs/build-veto-and-sandbox.md).
//
// The agent's OWN gate, run on the PREPARED tree (post-checkout, post-patch)
// BEFORE the build. Generalizes the original single hardcoded grep into a small
// data-driven rule list. Each rule is (id, scope, pattern, reason):
//   scope "tree"  → grep the whole worktree   (broad)
//   scope "patch" → grep only the applied patch (highest signal: the untrusted
//                   pre-integration delta INTRODUCED the hit)
// A hit on ANY rule vetoes, returning that rule's reason. Logic here is pure
// and unit-tested; only _veto_run_rule touches the filesystem (the grep).
//
// SCOPE (critical, see the doc): these guard BUILD-GRAMMAR / tree hygiene — a
// committed secret, a banned path, an oversize tree — NOT the application being
// built. A clean veto is not a clean program. Rules are the AGENT OPERATOR's
// policy, not the requester's.
// ============================================================================

// _veto_default_rules() — the built-in Tier-A rule list, as a list of
// tab-joined "id\tscope\tpattern\treason" rows. Pure (no I/O). Operators extend
// via AEB_AGENT_VETO_PATTERNS (see _veto_rules_from_env).
_veto_default_rules() {
    rules = list.new()
    // --- committed-secret markers (tree-wide) ---
    list.add(rules, "secret-rsa\ttree\tBEGIN RSA PRIVATE KEY\ttree contains an RSA private-key marker")
    list.add(rules, "secret-openssh\ttree\tBEGIN OPENSSH PRIVATE KEY\ttree contains an OpenSSH private-key marker")
    list.add(rules, "secret-pgp\ttree\tBEGIN PGP PRIVATE KEY BLOCK\ttree contains a PGP private-key marker")
    list.add(rules, "aws-akid\tpatch\tAKIA[0-9A-Z]\\{16\\}\tpatch introduces an AWS access-key id")
    // --- June-2026 supply-chain install-script class (the npm/postinstall
    // attack family the veto effort targets; see docs/build-veto-and-sandbox.md) ---
    // A binding.gyp ANYWHERE = a node-gyp native-addon build that runs at npm
    // install time — a primary install-exec vector. File-existence, not content.
    list.add(rules, "npm-binding-gyp\tfile\tbinding.gyp\ttree contains a binding.gyp (native-addon install-time build script)")
    // pre/postinstall lifecycle hooks in a manifest — the script npm runs on
    // install, the literal mechanism of the 2024-2026 npm worm waves.
    list.add(rules, "npm-install-hook\ttree\t\"\\(pre\\|post\\)install\"[[:space:]]*:\tmanifest declares a pre/post-install lifecycle script")
    // a curl|sh / wget|sh one-liner — fetch-and-exec, anywhere in the tree.
    list.add(rules, "curl-pipe-sh\ttree\t\\(curl\\|wget\\)[^|]*|[[:space:]]*\\(sudo[[:space:]]*\\)\\?\\(ba\\)\\?sh\tfetch-and-exec one-liner (curl/wget piped to a shell)")
    // an `extern` declaration INTRODUCED BY THE PATCH in a .ae build file — a
    // raw C/syscall escape the untrusted delta is adding. Patch-scoped so the
    // SDKs' own legit externs (every .ae has `extern println`) don't trip it;
    // only a NEW extern in the pre-integration delta vetoes. (2b/AST does the
    // origin-scoped version; this is the cheap pre-compile signal.)
    list.add(rules, "patch-extern\tpatch\t^\\+[[:space:]]*extern[[:space:]]\tpatch introduces an extern (raw C/syscall escape) in build code")
    return rules
}

// _veto_rule_field(row, idx) — pull field idx (0..3) from a tab-joined rule
// row. Pure. idx: 0=id 1=scope 2=pattern 3=reason. NB: string.split returns a
// *StringArray (ptr) read via string.array_size/array_get, NOT a list — list.get
// on it segfaults (the std contract; the pool parser hand-rolls its scan for the
// same reason). array_get returns a pointer INTO the array's storage, so we copy
// (concat with "") BEFORE freeing — otherwise the returned string dangles into
// freed memory (observed: garbage bytes).
_veto_rule_field(row: string, idx: int) {
    parts = string.split(row, "\t")
    n = string.array_size(parts)
    if idx >= n {
        string.array_free(parts)
        return ""
    }
    v = string.concat(string.array_get(parts, idx), "")
    string.array_free(parts)
    return v
}

// _veto_rules_from_env() — default rules plus any operator-supplied extras from
// AEB_AGENT_VETO_PATTERNS. Format: newline-separated rows, each the same
// "id\tscope\tpattern\treason" shape (literal \t between fields, ; between
// rows since env vars are single-line — we accept ';' as the row separator).
// Pure-ish (reads one env var; no filesystem). Malformed rows (missing fields)
// are skipped so a typo can't silently disable scanning.
_veto_rules_from_env() {
    rules = _veto_default_rules()
    extra = os.getenv("AEB_AGENT_VETO_PATTERNS")
    if string.length(extra) == 0 { return rules }
    rows = string.split(extra, ";")
    i = 0
    n = string.array_size(rows)
    while i < n {
        // copy out of the array's storage before it's freed (array_get returns
        // a pointer into it); the copy is what we keep in the rules list.
        row = string.concat(string.array_get(rows, i), "")
        // require all 4 fields present + non-empty pattern
        if string.length(_veto_rule_field(row, 2)) > 0 {
            if string.length(_veto_rule_field(row, 3)) > 0 {
                list.add(rules, row)
            }
        }
        i = i + 1
    }
    string.array_free(rows)
    return rules
}

// _veto_scan_cmd(scope, pattern, repo, patch_path) — build the grep command for
// one rule. Pure (string assembly only; unit-tested). "patch"-scope rules grep
// the single patch file; "tree"-scope rules grep -r the worktree. Returns ""
// when a patch-scope rule has no patch to scan (→ caller skips it). Patterns
// are basic-regex (grep) and operator-trusted; single-quoted to neutralize
// shell metachars in the path, with the pattern passed via -e.
_veto_scan_cmd(scope: string, pattern: string, repo: string, patch_path: string) {
    if string.equals(scope, "patch") == 1 {
        if string.length(patch_path) == 0 { return "" }
        return string.concat(string.concat("grep -qI -e '", pattern), string.concat("' '", string.concat(patch_path, "' 2>/dev/null")))
    }
    // "file" scope: veto if a file matching the glob `pattern` EXISTS anywhere
    // in the tree (e.g. binding.gyp — a native-addon build script that runs at
    // npm install time; the classic install-exec vector). exit 0 = found.
    if string.equals(scope, "file") == 1 {
        return string.concat(string.concat("find '", repo), string.concat("' -name '", string.concat(pattern, "' 2>/dev/null | grep -q .")))
    }
    // "patchpath" scope: veto if the PATCH touches a disallowed path — grep the
    // diff's file headers (`+++ ` / `diff --git ` lines) for the pattern. Only
    // meaningful with a patch; "" → caller skips. Highest signal: the untrusted
    // delta is trying to modify something off-limits (CI config, a lockfile).
    if string.equals(scope, "patchpath") == 1 {
        if string.length(patch_path) == 0 { return "" }
        return string.concat(string.concat("grep -qE '^(\\+\\+\\+ |diff --git ).*", pattern), string.concat("' '", string.concat(patch_path, "' 2>/dev/null")))
    }
    // default: tree scan (recursive, skip binary)
    return string.concat(string.concat("grep -rqI -e '", pattern), string.concat("' '", string.concat(repo, "' 2>/dev/null")))
}

// _veto_tree_size_cap(repo) — veto if the prepared tree exceeds a size cap.
// A pre-integration tree far larger than expected is a red flag: a vendored
// binary blob, a zip-bomb-style payload, an exfil staging dir. Cap is operator-
// set via AEB_AGENT_MAX_TREE_MB (megabytes); 0/unset → disabled (no cap, since
// legitimate monorepos vary wildly — the operator opts in to a number they
// know fits their tree). Returns a veto reason, or "" to allow.
_veto_tree_size_cap(repo: string) {
    capstr = os.getenv("AEB_AGENT_MAX_TREE_MB")
    if string.length(capstr) == 0 { return "" }
    cap_mb, _cerr = string.to_int(string.trim(capstr))
    if cap_mb <= 0 { return "" }
    // `du -sm` → size in MB (first whitespace-delimited field).
    out, _e = build._sh_capture("du -sm '${repo}' 2>/dev/null | awk '{print $1}'")
    sz_mb, _serr = string.to_int(string.trim(out))
    if sz_mb > cap_mb {
        return "tree is ${sz_mb} MB, exceeds AEB_AGENT_MAX_TREE_MB=${cap_mb} (veto:tree-size)"
    }
    return ""
}

// _veto_scan_root(repo, target) — the directory tree/file-scope rules scan.
//
// PRAGMATIC dep-closure scoping (2026-06-16): instead of the WHOLE worktree,
// scan only the target's CONTAINING DIRECTORY subtree (e.g. a target
// `rust/components/vowelbase/.build.ae` → scan `repo/rust/components/vowelbase`).
// This kills the documented false positive where a stray `binding.gyp` in an
// UNRELATED sibling subtree (`libs/javascript/npm_vendored/`) vetoed a rust
// build that never touches it. aeb deps are overwhelmingly co-located by
// subtree, so the target's dir is a good approximation of its dep closure.
//
// TODO(perfectionist): this is a SUBTREE heuristic, not the exact dep closure.
// A dep that lives OUTSIDE the target's directory (e.g. the target deps
// `../shared/lib/.build.ae`) is NOT scanned, so a build-grammar escape there is
// missed. The correct fix is to compute the target's transitive `.ae` closure
// (extract-deps BFS) and scan exactly the dirs of those files — catches deps
// anywhere while still excluding unrelated subtrees. That needs the agent to
// run a closure pass before the veto; deferred to keep this change small. See
// docs/build-veto-and-sandbox.md + docs/agent-container-ladder.md (the
// "Veto is whole-workdir-scoped, not dep-closure-scoped" note).
//
// Falls back to `repo` (whole tree) when: target is empty, isn't an .ae path,
// or its derived dir doesn't exist — i.e. the heuristic NEVER narrows away from
// a real path it can't resolve (fail-safe toward the broader scan). Pure except
// the dir.exists probe.
_veto_scan_root(repo: string, target: string) {
    if string.length(target) == 0 { return repo }
    if string.ends_with(target, ".ae") == 0 { return repo }
    tdir = path.dirname(target)
    // bare ".build.ae" (no dir) → target dir IS the repo root; no narrowing.
    if string.length(tdir) == 0 { return repo }
    if string.equals(tdir, ".") == 1 { return repo }
    root = path.join(repo, tdir)
    // dir.exists (NOT file.exists — the scan root is a DIRECTORY; file.exists
    // returns 0 for a dir, which would always fail-safe back to repo).
    if dir.exists(root) == 0 { return repo }
    return root
}

// _veto_run_rules(repo, target, patch_path) — run every rule; first hit vetoes
// and returns its reason. "" = allow. The ONE I/O function here (os.system per
// rule). Rules + reasons come from _veto_rules_from_env (pure). tree/file-scope
// rules scan the target's dep-closure SUBTREE (_veto_scan_root), not the whole
// worktree; patch-scope rules are unaffected (they scan the patch, which is
// already the highest-signal slice).
_veto_run_rules(repo: string, target: string, patch_path: string) {
    // Tree-size cap first (cheapest decisive check; opt-in via env). Sized over
    // the WHOLE repo (an oversize tree is a tree-hygiene signal regardless of
    // which target builds), not the narrowed scan root.
    szveto = _veto_tree_size_cap(repo)
    if string.length(szveto) > 0 { return szveto }
    scan_root = _veto_scan_root(repo, target)
    rules = _veto_rules_from_env()
    i = 0
    n = list.size(rules)
    while i < n {
        row, _ = list.get(rules, i)
        rid = _veto_rule_field(row, 0)
        scope = _veto_rule_field(row, 1)
        pattern = _veto_rule_field(row, 2)
        reason = _veto_rule_field(row, 3)
        cmd = _veto_scan_cmd(scope, pattern, scan_root, patch_path)
        if string.length(cmd) > 0 {
            if build._sh(cmd) == 0 {
                // reason + the rule id, so the operator log is actionable.
                return string.concat(reason, string.concat(" (veto:", string.concat(rid, ")")))
            }
        }
        i = i + 1
    }
    return ""
}
