// php — PHP SDK for aeb.
//
// Drives an existing PHP project as-is. `php.test` defaults to `phpunit`;
// declare phpunit_phar(...) to run via `php <phar>` and phpunit_phar_url(...)
// to download that phar, with phpunit_phar_sha256(...) pinning its digest: the
// download and the sha256 check run in Aether (lib/fetch), a mismatch fails the
// node, and a URL with no digest is refused. config("…") adds --configuration. Env injection
// (a shared `.so` path read by an FFI binding) rides the shared env(...).
//
//   import bldr
//   import php
//   import bldr (env)
//   import php (phpunit_phar, phpunit_phar_url, phpunit_phar_sha256, config)
//   php.test(b) {
//       env("SERVIRTIUM_VCR_LIB", lib)
//       phpunit_phar("phpunit.phar")
//       phpunit_phar_url("https://phar.phpunit.de/phpunit-11.5.3.phar")
//       phpunit_phar_sha256("00674310d7d48db7fe105e02b17b43e6be8b65fd37195a39724bc71cc5aaa866")
//       config("phpunit.xml")
//   }
//
// Setters: env(K,V) [lib/build], phpunit_phar("…"), phpunit_phar_url("…"),
// phpunit_phar_sha256("…"),
// config("…"), ini(K,V) [-d php.ini directive, e.g. ini("ffi.enable","1") for
// an ext-ffi binding; requires the phar runner]. A binding that declares its
// own step("…") still gets the generic _run_project path (back-compat).
import bldr
import fetch
import std.string
import std.os
import std.io
import std.file
import std.path
import std.map
import std.list

// --- DSL setters ---

// phpunit_phar("vendor/phpunit.phar") — OPTIONAL override of the local phar
// filename (relative to source_dir). You rarely need it: declaring
// phpunit_phar_url(...) alone already runs via a phar and defaults the local
// name to "phpunit.phar" (the conventional `curl -o phpunit.phar` target).
// Use this only for a vendored phar with no URL, or a non-default name.
// Scalar; last wins.
phpunit_phar(_ctx: ptr, phar: string) {
    _e = map.put(_ctx, "phpunit_phar", phar)
}

// phpunit_phar_url("https://…/phpunit-11.5.3.phar") — run the suite via a phar
// (rather than a bare `phpunit` on PATH) and download it to the local phar
// path (default "phpunit.phar") unless a copy with the pinned sha256 is already
// there. Pin a versioned URL and declare phpunit_phar_sha256 with it. Scalar;
// last wins.
phpunit_phar_url(_ctx: ptr, url: string) {
    _e = map.put(_ctx, "phpunit_phar_url", url)
}

// phpunit_phar_sha256("<64 hex>") — the sha256 the phar at phpunit_phar_url
// must have. Required with phpunit_phar_url. The phar is verified on every run
// (a present copy that does not match is replaced, and a fresh download that
// does not match fails the node and is deleted). Scalar; last wins.
phpunit_phar_sha256(_ctx: ptr, hex: string) {
    _e = map.put(_ctx, "phpunit_phar_sha256", hex)
}

// config("phpunit.xml") — `--configuration <file>`. Scalar; last wins.
config(_ctx: ptr, cfg: string) {
    _e = map.put(_ctx, "phpunit_config", cfg)
}

// ini("ffi.enable", "1") — a php.ini directive passed as `-d <key>=<value>` on
// the php command line (both the phpunit-phar runner and a bare `phpunit`
// wrapper honor it). Repeatable; accumulates in order. The motivating case: an
// FFI binding needs `-d ffi.enable=1` (ext-ffi ships but is off by default) so
// its `FFI::cdef` load works under the test runner. List (append); enables the
// `-d` prefix on the php invocation.
ini(_ctx: ptr, key: string, value: string) {
    if map.has(_ctx, "php_ini") == 0 {
        _e1 = map.put(_ctx, "php_ini", list.new())
    }
    lst, _ = map.get(_ctx, "php_ini")
    _e2 = list.add(lst, "${key}=${value}")
}

// --- Pure command builders (tested in tests/test_php_cmd.ae) ---

// phpunit_cmd(source_dir, runner, config_part) — `cd '<dir>' && <runner>
// <config_part>`. runner is "phpunit" or "php 'phpunit.phar'"; config_part is
// " --configuration 'phpunit.xml'" or "".
phpunit_cmd(source_dir: string, runner: string, config_part: string) {
    return "cd '${source_dir}' && ${runner}${config_part}"
}

// php_ini_part(ini_list) — " -d k1=v1 -d k2=v2" for the php command line, or ""
// when no ini() directives were declared. Pure.
php_ini_part(ini_list: ptr) {
    out = ""
    if ini_list != null {
        n = list.size(ini_list)
        i = 0
        while i < n {
            kv, _ = list.get_string(ini_list, i)
            out = string.concat(out, " -d ${kv}")
            i = i + 1
        }
    }
    return out
}

// phar_runner(phar, ini_part) — "php<ini_part> '<phar>'", the runner string for
// a phar. ini_part is the " -d k=v …" prefix from php_ini_part (or "").
phar_runner(phar: string, ini_part: string) {
    return "php${ini_part} '${phar}'";
}

// config_part(cfg) — " --configuration '<cfg>'" or "" when empty.
config_part(cfg: string) {
    if string.length(cfg) > 0 {
        return " --configuration '${cfg}'"
    }
    return ""
}

// phar_fetch_problem(url, sha256) — why a phar download must not proceed, or ""
// when it may. A phar is code that runs on the build host, so a URL without a
// pinned sha256 is refused rather than fetched unverified. Pure.
phar_fetch_problem(url: string, sha256: string) {
    if string.length(url) == 0 { return "" }
    if string.length(sha256) == 0 {
        return "phpunit_phar_url needs phpunit_phar_sha256(\"<64 hex>\"): a downloaded phar is only run when its sha256 matches"
    }
    if string.length(sha256) != 64 {
        return "phpunit_phar_sha256 must be 64 lowercase hex characters"
    }
    return ""
}

// --- Builders ---

// php.test(b) — `phpunit` by default; `php <phar> --configuration <cfg>` when
// a phar/config is declared, fetching the phar once if absent. Pass/fail
// telemetry. Honors explicit step()s for back-compat.
builder test(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    mod_dir = bldr._get(ctx, "module_dir")

    // Back-compat: a binding that wrote step("…") keeps the generic path.
    if _builder != null {
        if map.has(_builder, "proc_steps") == 1 {
            println("${mod_dir}: running tests (php)")
            return bldr._run_project(ctx, _builder, "phpunit", 1)
        }
    }

    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    bldr._mkdirs(target_dir)
    env_prefix = bldr._env_export_prefix(_builder)

    // Resolve the runner: a phar (fetched if missing) or bare phpunit. Phar
    // mode is enabled by EITHER an explicit phpunit_phar(...) path OR a
    // phpunit_phar_url(...) — the local filename defaults to "phpunit.phar".
    // php.ini directives (-d k=v), e.g. an FFI binding's `-d ffi.enable=1`.
    ini_list = null
    if _builder != null {
        if map.has(_builder, "php_ini") == 1 { ini_list, _ = map.get(_builder, "php_ini") }
    }
    ini_part = php_ini_part(ini_list)

    // Bare `phpunit` is not the php interpreter, so -d flags can't ride it;
    // ini() therefore requires the phar runner (`php -d… phpunit.phar`). This
    // is the normal FFI case anyway (declares phpunit_phar_url).
    runner = "phpunit"
    phar = ""
    url = ""
    sha256 = ""
    if _builder != null {
        if map.has(_builder, "phpunit_phar") == 1 { phar, _ = map.get_string(_builder, "phpunit_phar") }
        if map.has(_builder, "phpunit_phar_url") == 1 { url, _ = map.get_string(_builder, "phpunit_phar_url") }
        if map.has(_builder, "phpunit_phar_sha256") == 1 { sha256, _ = map.get_string(_builder, "phpunit_phar_sha256") }
    }
    if string.length(phar) == 0 {
        if string.length(url) > 0 { phar = "phpunit.phar" }
    }
    if string.length(phar) > 0 {
        // Download + verify (lib/fetch): a present copy whose sha256 matches is
        // used as is; otherwise it is fetched, and a mismatch fails the node.
        if string.length(url) > 0 {
            problem = phar_fetch_problem(url, sha256)
            if string.length(problem) > 0 {
                println("${mod_dir}: ${problem}")
                bldr.fail(ctx, problem)
                return 1
            }
            phar_abs = path.join(source_dir, phar)
            println("${mod_dir}: fetching ${phar} (sha256 ${sha256})")
            _fd, ferr = fetch._fetch_verified(url, sha256, phar_abs)
            if string.length(ferr) > 0 {
                println("${mod_dir}: phar download FAILED: ${ferr}")
                bldr.fail(ctx, "phar download FAILED: ${ferr}")
                return 1
            }
        }
        runner = phar_runner(phar, ini_part)
    }

    cfg = ""
    if _builder != null {
        if map.has(_builder, "phpunit_config") == 1 { cfg, _ = map.get_string(_builder, "phpunit_config") }
    }

    println("${mod_dir}: running tests (php)")
    cmd = phpunit_cmd(source_dir, runner, config_part(cfg))
    rc = bldr._sh(string.concat(env_prefix, cmd))
    if rc != 0 {
        bldr._record_test_result(ctx, 0, 1)
        println("${mod_dir}: tests FAILED")
        bldr.fail(ctx, "tests FAILED")
        return rc
    }
    bldr._record_test_result(ctx, 1, 0)
    println("${mod_dir}: tests PASSED")
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}
