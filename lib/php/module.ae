// php — PHP SDK for aeb.
//
// Drives an existing PHP project as-is. `php.test` defaults to `phpunit`;
// declare phpunit_phar(...) to run via `php <phar>` and phpunit_phar_url(...)
// to download that phar once (if absent) — the SDK does the "fetch if
// missing" check in Aether, so a binding never writes the shell conditional
// `[ -f phar ] || curl …`. config("…") adds --configuration. Env injection
// (a shared `.so` path read by an FFI binding) rides the shared env(...).
//
//   import bldr
//   import php
//   import bldr (env)
//   import php (phpunit_phar, phpunit_phar_url, config)
//   php.test(b) {
//       env("SERVIRTIUM_VCR_LIB", lib)
//       phpunit_phar("phpunit.phar")
//       phpunit_phar_url("https://phar.phpunit.de/phpunit-11.phar")
//       config("phpunit.xml")
//   }
//
// Setters: env(K,V) [lib/build], phpunit_phar("…"), phpunit_phar_url("…"),
// config("…"). A binding that declares its own step("…") still gets the
// generic _run_project path (back-compat).
import bldr
import std.string
import std.os
import std.io
import std.file
import std.path
import std.map

// --- DSL setters ---

// phpunit_phar("vendor/phpunit.phar") — OPTIONAL override of the local phar
// filename (relative to source_dir). You rarely need it: declaring
// phpunit_phar_url(...) alone already runs via a phar and defaults the local
// name to "phpunit.phar" (the conventional `curl -o phpunit.phar` target).
// Use this only for a vendored phar with no URL, or a non-default name.
// Scalar; last wins.
phpunit_phar(_ctx: ptr, phar: string) {
    _e = map.put(_ctx, "phpunit_phar", phar)
}

// phpunit_phar_url("https://…/phpunit-11.phar") — run the suite via a phar
// (rather than a bare `phpunit` on PATH) and download it to the local phar
// path (default "phpunit.phar") if absent. The "fetch only when missing"
// check runs in Aether (file.exists), so no shell `[ -f ] ||`. No-op when the
// phar is already present. Scalar; last wins.
phpunit_phar_url(_ctx: ptr, url: string) {
    _e = map.put(_ctx, "phpunit_phar_url", url)
}

// config("phpunit.xml") — `--configuration <file>`. Scalar; last wins.
config(_ctx: ptr, cfg: string) {
    _e = map.put(_ctx, "phpunit_config", cfg)
}

// --- Pure command builders (tested in tests/test_php_cmd.ae) ---

// phpunit_cmd(source_dir, runner, config_part) — `cd '<dir>' && <runner>
// <config_part>`. runner is "phpunit" or "php 'phpunit.phar'"; config_part is
// " --configuration 'phpunit.xml'" or "".
phpunit_cmd(source_dir: string, runner: string, config_part: string) {
    return "cd '${source_dir}' && ${runner}${config_part}"
}

// phar_runner(phar) — "php '<phar>'", the runner string for a phar.
phar_runner(phar: string) {
    return "php '${phar}'";
}

// config_part(cfg) — " --configuration '<cfg>'" or "" when empty.
config_part(cfg: string) {
    if string.length(cfg) > 0 {
        return " --configuration '${cfg}'"
    }
    return ""
}

// phar_fetch_cmd(source_dir, url, phar) — `cd '<dir>' && curl -fsSL '<url>'
// -o '<phar>'`. Pure. (curl is still a shell-out, but the *conditional* —
// fetch only when missing — is decided in Aether, not by a shell `||`.)
phar_fetch_cmd(source_dir: string, url: string, phar: string) {
    return "cd '${source_dir}' && curl -fsSL '${url}' -o '${phar}'"
}

// --- Builders ---

// php.test(b) — `phpunit` by default; `php <phar> --configuration <cfg>` when
// a phar/config is declared, fetching the phar once if absent. Pass/fail
// telemetry. Honors explicit step()s for back-compat.
builder test(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    mod_dir = bldr._get(ctx, "module_dir")

    // Back-compat: a binding that wrote step("…") keeps the generic path.
    if _builder != null {
        if map.has(_builder, "proc_steps") == 1 {
            println("${mod_dir}: running tests (php)")
            return bldr._run_project(ctx, _builder, "phpunit", 1)
        }
    }

    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    bldr._mkdirs(target_dir)
    env_prefix = bldr._env_export_prefix(_builder)

    // Resolve the runner: a phar (fetched if missing) or bare phpunit. Phar
    // mode is enabled by EITHER an explicit phpunit_phar(...) path OR a
    // phpunit_phar_url(...) — the local filename defaults to "phpunit.phar".
    runner = "phpunit"
    phar = ""
    url = ""
    if _builder != null {
        if map.has(_builder, "phpunit_phar") == 1 { phar, _ = map.get(_builder, "phpunit_phar") }
        if map.has(_builder, "phpunit_phar_url") == 1 { url, _ = map.get(_builder, "phpunit_phar_url") }
    }
    if string.length(phar) == 0 {
        if string.length(url) > 0 { phar = "phpunit.phar" }
    }
    if string.length(phar) > 0 {
        // Fetch-if-missing — the conditional is HERE, in Aether, not a shell ||.
        if string.length(url) > 0 {
            phar_abs = path.join(source_dir, phar)
            if file.exists(phar_abs) == 0 {
                println("${mod_dir}: fetching ${phar}")
                fr = bldr._sh(phar_fetch_cmd(source_dir, url, phar))
                if fr != 0 {
                    println("${mod_dir}: phar download FAILED")
                    bldr.fail(ctx, "phar download FAILED")
                    return fr
                }
            }
        }
        runner = phar_runner(phar)
    }

    cfg = ""
    if _builder != null {
        if map.has(_builder, "phpunit_config") == 1 { cfg, _ = map.get(_builder, "phpunit_config") }
    }

    println("${mod_dir}: running tests (php)")
    cmd = phpunit_cmd(source_dir, runner, config_part(cfg))
    rc = bldr._sh(string.concat(env_prefix, cmd))
    if rc != 0 {
        bldr._record_test_result(ctx, 0, 1)
        println("${mod_dir}: tests FAILED")
        bldr.fail(ctx, "tests FAILED")
        return rc
    }
    bldr._record_test_result(ctx, 1, 0)
    println("${mod_dir}: tests PASSED")
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}
