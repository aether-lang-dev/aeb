// kotlin — Kotlin SDK for aether.build
import build
import cache
import maven
import std.string
import std.io
import std.os
import std.file
import std.fs
import std.list
import std.map
import std.path
import std.dir

// --- Kotlin DSL setters ---

jvm_target(_ctx: ptr, ver: string) {
    _e = map.put(_ctx, "jvm_target", ver)
}

api_version(_ctx: ptr, ver: string) {
    _e = map.put(_ctx, "api_version", ver)
}

language_version(_ctx: ptr, ver: string) {
    _e = map.put(_ctx, "language_version", ver)
}

source_layout(_ctx: ptr, layout: string) {
    _e = map.put(_ctx, "source_layout", layout)
}

compiler_plugin(_ctx: ptr, path: string) {
    if map.has(_ctx, "compiler_plugin") == 1 {
        prev, _ = map.get(_ctx, "compiler_plugin")
        combined = string.concat(prev, ",")
        combined = string.concat(combined, path)
        _e1 = map.put(_ctx, "compiler_plugin", combined)
    } else {
        _e2 = map.put(_ctx, "compiler_plugin", path)
    }
}

// --- Command builder ---

// kotlinc_cmd — assemble a kotlinc invocation. `kotlinc_bin` is the
// resolved compiler path (NOT bare "kotlinc"): the compiler binary
// and the kotlin-stdlib.jar on the classpath must come from the same
// install, or kotlinc rejects the build with a metadata-version
// mismatch ("compiled with an incompatible version of Kotlin"). See
// `_kotlinc_bin`. Pure.
kotlinc_cmd(kotlinc_bin: string, classes_dir: string, classpath: string, file_list: string, opts: ptr) {
    cmd = "${kotlinc_bin} -d ${classes_dir}"

    if opts != null {
        if map.has(opts, "jvm_target") == 1 {
            val, _ = map.get(opts, "jvm_target")
            cmd = string.concat(cmd, " -jvm-target ${val}")
        }
        if map.has(opts, "api_version") == 1 {
            val, _ = map.get(opts, "api_version")
            cmd = string.concat(cmd, " -api-version ${val}")
        }
        if map.has(opts, "language_version") == 1 {
            val, _ = map.get(opts, "language_version")
            cmd = string.concat(cmd, " -language-version ${val}")
        }
        if map.has(opts, "werror") == 1 {
            cmd = string.concat(cmd, " -Werror")
        }
        if map.has(opts, "nowarn") == 1 {
            cmd = string.concat(cmd, " -nowarn")
        }
        if map.has(opts, "verbose") == 1 {
            cmd = string.concat(cmd, " -verbose")
        }
        if map.has(opts, "compiler_plugin") == 1 {
            val, _ = map.get(opts, "compiler_plugin")
            cmd = string.concat(cmd, " -Xplugin=${val}")
        }
        if map.has(opts, "extra") == 1 {
            val, _ = map.get(opts, "extra")
            cmd = string.concat(cmd, " ${val}")
        }
    }

    cmd = string.concat(cmd, " -cp ${classpath} ${file_list}")
    return cmd
}

// _kotlin_home() — resolve the kotlin install root. KOTLIN_HOME wins;
// otherwise probe the common install locations in order and return
// the first whose `lib/kotlin-stdlib.jar` exists. The snap package
// (/snap/kotlin/current) is preferred because it ships a current
// compiler (2.x); the apt/sdkman layout (/usr/share/kotlin/kotlinc)
// is the fallback. Returns "" if none found (caller degrades to bare
// `kotlinc` on PATH + no explicit stdlib, the historic behaviour).
_kotlin_home() {
    env_home = os.getenv("KOTLIN_HOME")
    if env_home != 0 {
        return env_home
    }
    snap = "/snap/kotlin/current"
    if file.exists(path.join(snap, "lib/kotlin-stdlib.jar")) == 1 {
        return snap
    }
    apt = "/usr/share/kotlin/kotlinc"
    if file.exists(path.join(apt, "lib/kotlin-stdlib.jar")) == 1 {
        return apt
    }
    return ""
}

// _kotlinc_bin(kotlin_home) — the compiler binary that matches the
// stdlib under `kotlin_home`. Returns `<home>/bin/kotlinc` when that
// exists, else bare "kotlinc" (PATH). Invoking the home-local binary
// (rather than whatever `kotlinc` resolves to on PATH) keeps the
// compiler and stdlib versions in lockstep — the box may have an old
// /usr/bin/kotlinc (1.3) on PATH while the stdlib is snap's 2.x.
_kotlinc_bin(kotlin_home: string) {
    if string.length(kotlin_home) > 0 {
        cand = path.join(kotlin_home, "bin/kotlinc")
        if file.exists(cand) == 1 {
            return cand
        }
    }
    return "kotlinc"
}

// _kotlinc_version(kotlinc_bin) — `kotlinc -version` first line, the
// toolchain-bump invalidator for the cache key. Memoised per build via
// an env-var cache (the probe forks a JVM — not free). Returns "" when
// kotlinc is absent; the key is still deterministic within a run.
_kotlinc_version(kotlinc_bin: string) {
    cached = os.getenv("_AEB_KOTLINC_VERSION_CACHE")
    if string.length(cached) > 0 { return cached }
    raw, _err = build._sh_capture("'${kotlinc_bin}' -version 2>&1 | head -1")
    return string.trim(raw)
}

// _cache_key_for_kotlinc — cache key for a kotlinc compile action.
// Mirrors java's _cache_key_for_javac. Inputs (length-prefixed, sorted
// via cache.hash_inputs):
//   - kotlinc version (`kotlinc -version`) — toolchain-bump invalidator
//   - kotlin-stdlib.jar CONTENT hash — the FALSE-HIT HAZARD here is the
//     snap-vs-apt stdlib: same version string, different bytes. Hashing
//     the jar content (like aether hashes libaether.a) distinguishes
//     them so a stdlib swap busts the key.
//   - canonical kotlinc command string — captures flags + classpath
//   - each .kt source's path + content hash, sorted by path
//   - each dep target's jvm_classpath_deps_including_transitive content
//     — captures upstream rebuilds
//   - any -Xplugin jar's content hash — a plugin upgrade at the same
//     path changes output bytes but not the version string
//
// FALSE-HIT HAZARD (same as javac): a sibling dep's local classes/ tree
// can change content while its classpath string stays the same; the dep
// artifact content hash catches most real changes because aeb rewrites
// that artifact every rebuild. Full correctness would walk each
// upstream classes tree; punted for v1 (Nx-class hermeticity, livable).
//
// Returns ("", err) on any source read failure — caller falls through
// to the live kotlinc build.
_cache_key_for_kotlinc(ctx: ptr, builder_map: ptr, argfile_path: string, kotlinc_cmd_str: string, stdlib_jar: string) {
    parts = list.new()

    kc_bin = "kotlinc"
    if builder_map != null {
        if map.has(builder_map, "_kotlinc_bin") == 1 {
            kb, _ = map.get(builder_map, "_kotlinc_bin")
            if string.length(kb) > 0 { kc_bin = kb }
        }
    }
    list.add(parts, string.concat("kotlinc:", _kotlinc_version(kc_bin)))

    if string.length(stdlib_jar) > 0 {
        if file.exists(stdlib_jar) == 1 {
            sjh, sjerr = cache.hash_file(stdlib_jar)
            if string.length(sjerr) == 0 {
                list.add(parts, string.concat("stdlib:", sjh))
            }
        }
    }

    list.add(parts, string.concat("cmd:", kotlinc_cmd_str))

    sources = build._read_argfile_lines(argfile_path)
    nsrc = list.size(sources)
    si = 0
    while si < nsrc {
        src, _ = list.get(sources, si)
        sh, serr = cache.hash_file(src)
        if string.length(serr) > 0 {
            return "", serr
        }
        list.add(parts, string.concat("src:", src))
        list.add(parts, string.concat("src-hash:", sh))
        si = si + 1
    }

    deps, _ = map.get(ctx, "deps")
    dn = list.size(deps)
    di = 0
    while di < dn {
        dp, _ = list.get(deps, di)
        dm = build._strip_lang(dp)
        dep_cp = build._read_dep_artifact(ctx, dm, "jvm_classpath_deps_including_transitive")
        if string.length(dep_cp) > 0 {
            list.add(parts, string.concat("dep:", dm))
            list.add(parts, string.concat("dep-cp:", dep_cp))
        }
        di = di + 1
    }

    if builder_map != null {
        if map.has(builder_map, "compiler_plugin") == 1 {
            plugins, _ = map.get(builder_map, "compiler_plugin")
            // comma-separated list of plugin jar paths; hash each present file
            rest = plugins
            while string.length(rest) > 0 {
                comma = string.index_of(rest, ",")
                pp = ""
                if comma < 0 {
                    pp = rest
                    rest = ""
                } else {
                    pp = string.substring(rest, 0, comma)
                    rest = string.substring(rest, comma + 1, string.length(rest))
                }
                pp = string.trim(pp)
                if string.length(pp) > 0 {
                    if file.exists(pp) == 1 {
                        ph, pherr = cache.hash_file(pp)
                        if string.length(pherr) == 0 {
                            list.add(parts, string.concat("plugin:", pp))
                            list.add(parts, string.concat("plugin-hash:", ph))
                        }
                    }
                }
            }
        }
    }

    digest, derr = cache.hash_inputs(parts)
    return digest, derr
}

// --- SDK functions ---

builder kotlinc(ctx: ptr) {
    source_dir = build._get(ctx, "source_dir")
    target_dir = build._get(ctx, "target_dir")
    mod_name = build._get(ctx, "module")
    mod_dir = build._get(ctx, "module_dir")
    deps, _ = map.get(ctx, "deps")

    classes_dir = path.join(target_dir, "classes")
    build._mkdirs(classes_dir)
    ts_dir = path.join(classes_dir, mod_name)
    build._mkdirs(ts_dir)
    ts_file = path.join(ts_dir, ".timestamp")

    println("${mod_dir}: compiling prod code")

    kotlin_home = _kotlin_home()
    stdlib_jar = path.join(kotlin_home, "lib/kotlin-stdlib.jar")
    kotlinc_bin = _kotlinc_bin(kotlin_home)
    // Stash the resolved compiler binary so the cache key probes THAT
    // kotlinc's version (not bare PATH kotlinc).
    _ekb = map.put(_builder, "_kotlinc_bin", kotlinc_bin)

    dep_cp = build._build_dep_classpath(ctx)
    maven_cp = maven.classpath(ctx)
    classpath = build._cp_append(classes_dir, stdlib_jar)
    classpath = build._cp_append(classpath, dep_cp)
    classpath = build._cp_append(classpath, maven_cp)

    // Write source file list to argfile
    argfile = path.join(target_dir, "kotlinc_sources.txt")
    if map.has(_builder, "source_layout") == 1 {
        layout, _ = map.get(_builder, "source_layout")
        if layout == "maven idiomatic" {
            src_root = path.join(source_dir, "src/main/kotlin")
            build._sh("find '${src_root}' -name '*.kt' > '${argfile}' 2>/dev/null || true")
        }
    } else {
        build._sh("find '${source_dir}' -maxdepth 1 -name '*.kt' > '${argfile}' 2>/dev/null || true")
    }

    af_raw, _eaf = io.read_file(argfile)
    argfile_content = string.trim(af_raw)
    if string.length(argfile_content) == 0 {
        println("${mod_dir}: no Kotlin source files found")
        return 0
    }
    file_ref = string.concat("@", argfile)

    kc_cmd = kotlinc_cmd(kotlinc_bin, classes_dir, classpath, file_ref, _builder)

    // Cache check: hash sources + stdlib + classpath + flags + kotlinc
    // version, restore the classes/ tarball on hit and skip kotlinc.
    // Best-effort — any key-computation error falls through to live
    // kotlinc. exit_code is the "what next" sentinel: 0 = cache supplied
    // the tree, -1 = run kotlinc below.
    cache_key = ""
    exit_code = -1
    if cache.available() == 1 {
        ck, kerr = _cache_key_for_kotlinc(ctx, _builder, argfile, kc_cmd, stdlib_jar)
        if string.length(kerr) == 0 {
            cache_key = ck
            tmp_raw, _terr = build._sh_capture("mktemp")
            tmp_tar = string.trim(tmp_raw)
            if string.length(tmp_tar) > 0 {
                grc = cache.get(cache_key, tmp_tar)
                if string.length(grc) == 0 {
                    uerr = build._untar_into(tmp_tar, classes_dir)
                    build._sh("rm -f '${tmp_tar}'")
                    if string.length(uerr) == 0 {
                        println("${mod_dir}: kotlinc cache hit ${cache_key}")
                        build._record_cache(ctx, "hit")
                        exit_code = 0
                    } else {
                        build._sh("rm -rf '${classes_dir}'")
                        build._mkdirs(classes_dir)
                        build._mkdirs(ts_dir)
                    }
                } else {
                    build._sh("rm -f '${tmp_tar}'")
                }
            }
        }
    }

    if exit_code == -1 {
        if cache.available() == 0 {
            build._record_cache(ctx, "unavailable")
        } else {
            build._record_cache(ctx, "miss")
        }
        exit_code = build._sh(kc_cmd)
        if exit_code != 0 {
            println("${mod_dir}: kotlinc failed")
            build.fail(ctx, "kotlinc failed")
            return exit_code
        }
        if string.length(cache_key) > 0 {
            tar_path, terr = build._tar_dir(classes_dir)
            if string.length(terr) == 0 {
                perr = cache.put(cache_key, tar_path)
                build._sh("rm -f '${tar_path}'")
                if string.length(perr) > 0 {
                    println("${mod_dir}: kotlinc cache write failed: ${perr}")
                }
            }
        }
    }

    cp_out = string.concat(classes_dir, "\n")
    cp_out = string.concat(cp_out, stdlib_jar)
    if string.length(dep_cp) > 0 {
        cp_out = string.concat(string.concat(cp_out, "\n"), dep_cp)
    }
    if string.length(maven_cp) > 0 {
        cp_out = string.concat(string.concat(cp_out, "\n"), maven_cp)
    }
    build._write_artifact(ctx, "jvm_classpath_deps_including_transitive", cp_out)

    dep_count = list.size(deps)
    ld_out = ""
    k = 0
    while k < dep_count {
        dp2, _ = list.get(deps, k)
        dm2 = build._strip_lang(dp2)
        dep_ld = build._read_dep_artifact(ctx, dm2, "ldlibdeps")
        if string.length(dep_ld) > 0 {
            if string.length(ld_out) > 0 {
                ld_out = string.concat(string.concat(ld_out, "\n"), dep_ld)
            } else {
                ld_out = dep_ld
            }
        }
        k = k + 1
    }
    build._write_artifact(ctx, "ldlibdeps", ld_out)
    _ew = io.write_file(ts_file, "")
    return 0
}

builder kotlinc_test(ctx: ptr) {
    source_dir = build._get(ctx, "source_dir")
    target_dir = build._get(ctx, "target_dir")
    mod_name = build._get(ctx, "module")
    mod_dir = build._get(ctx, "module_dir")

    test_classes = path.join(target_dir, "test-classes")
    build._mkdirs(test_classes)
    ts_dir = path.join(test_classes, mod_name)
    build._mkdirs(ts_dir)
    ts_file = path.join(ts_dir, ".timestamp")

    println("${mod_dir}: compiling test code")

    kotlin_home = _kotlin_home()
    stdlib_jar = path.join(kotlin_home, "lib/kotlin-stdlib.jar")
    kotlinc_bin = _kotlinc_bin(kotlin_home)
    _ekb = map.put(_builder, "_kotlinc_bin", kotlinc_bin)

    dep_cp = build._build_dep_classpath(ctx)
    lib_cp = build._build_lib_classpath(ctx)
    classpath = build._cp_append(test_classes, stdlib_jar)
    classpath = build._cp_append(classpath, dep_cp)
    classpath = build._cp_append(classpath, lib_cp)

    // Honor source_layout("maven idiomatic") like kotlinc does: tests live
    // under src/test/kotlin (recursively), not flat in source_dir.
    file_list = ""
    use_maven = 0
    if map.has(_builder, "source_layout") == 1 {
        layout_t, _ = map.get(_builder, "source_layout")
        if layout_t == "maven idiomatic" { use_maven = 1 }
    }
    if use_maven == 1 {
        tsrc = path.join(source_dir, "src/test/kotlin")
        fl_raw, _efl = build._sh_capture("find '${tsrc}' -name '*.kt' 2>/dev/null | tr '\n' ' '")
        file_list = string.trim(fl_raw)
    } else {
        kt_pat = path.join(source_dir, "*.kt")
        file_list = build._collect_file_list(kt_pat)
    }
    if string.length(file_list) == 0 {
        println("${mod_dir}: no Kotlin test source files found")
        return 0
    }

    kc_cmd = kotlinc_cmd(kotlinc_bin, test_classes, classpath, file_list, _builder)

    // Write the space-separated source list as a newline argfile so the
    // cache-key helper can hash each source (shared with the prod path).
    test_argfile = path.join(target_dir, "kotlinc_test_sources.txt")
    _paths = string.split(file_list, " ")
    _af = ""
    _ai = 0
    _an = list.size(_paths)
    while _ai < _an {
        _p, _ = list.get(_paths, _ai)
        _p = string.trim(_p)
        if string.length(_p) > 0 {
            if string.length(_af) > 0 { _af = string.concat(_af, "\n") }
            _af = string.concat(_af, _p)
        }
        _ai = _ai + 1
    }
    _ewa = io.write_file(test_argfile, _af)

    // Cache check: same shape as the prod path; caches the test-classes/
    // tree. exit_code sentinel: 0 = cache hit, -1 = run kotlinc.
    cache_key = ""
    exit_code = -1
    if cache.available() == 1 {
        ck, kerr = _cache_key_for_kotlinc(ctx, _builder, test_argfile, kc_cmd, stdlib_jar)
        if string.length(kerr) == 0 {
            cache_key = ck
            tmp_raw, _terr = build._sh_capture("mktemp")
            tmp_tar = string.trim(tmp_raw)
            if string.length(tmp_tar) > 0 {
                grc = cache.get(cache_key, tmp_tar)
                if string.length(grc) == 0 {
                    uerr = build._untar_into(tmp_tar, test_classes)
                    build._sh("rm -f '${tmp_tar}'")
                    if string.length(uerr) == 0 {
                        println("${mod_dir}: kotlinc (test) cache hit ${cache_key}")
                        build._record_cache(ctx, "hit")
                        exit_code = 0
                    } else {
                        build._sh("rm -rf '${test_classes}'")
                        build._mkdirs(test_classes)
                        build._mkdirs(ts_dir)
                    }
                } else {
                    build._sh("rm -f '${tmp_tar}'")
                }
            }
        }
    }

    if exit_code == -1 {
        if cache.available() == 0 {
            build._record_cache(ctx, "unavailable")
        } else {
            build._record_cache(ctx, "miss")
        }
        exit_code = build._sh(kc_cmd)
        if exit_code != 0 {
            println("${mod_dir}: kotlinc (test) failed")
            build.fail(ctx, "kotlinc (test) failed")
            return exit_code
        }
        if string.length(cache_key) > 0 {
            tar_path, terr = build._tar_dir(test_classes)
            if string.length(terr) == 0 {
                perr = cache.put(cache_key, tar_path)
                build._sh("rm -f '${tar_path}'")
                if string.length(perr) > 0 {
                    println("${mod_dir}: kotlinc (test) cache write failed: ${perr}")
                }
            }
        }
    }

    _ew = io.write_file(ts_file, "")
    return 0
}

builder kotlin_test(ctx: ptr, test_class: string) {
    target_dir = build._get(ctx, "target_dir")
    mod_dir = build._get(ctx, "module_dir")

    test_classes = path.join(target_dir, "test-classes")
    dep_cp = build._build_dep_classpath(ctx)
    lib_cp = build._build_lib_classpath(ctx)

    // Runtime stdlib must match what kotlinc_test compiled against —
    // use the same resolved home (not the historic /usr/share default).
    kotlin_home = _kotlin_home()
    stdlib_jar = path.join(kotlin_home, "lib/kotlin-stdlib.jar")

    classpath = build._cp_append(test_classes, stdlib_jar)
    classpath = build._cp_append(classpath, dep_cp)
    classpath = build._cp_append(classpath, lib_cp)

    println("${mod_dir}: running tests")
    run_cmd = "java -ea"
    if _builder != null {
        if map.has(_builder, "jvm_args") == 1 {
            val, _ = map.get(_builder, "jvm_args")
            run_cmd = string.concat(run_cmd, " ${val}")
        }
        if map.has(_builder, "extra") == 1 {
            val, _ = map.get(_builder, "extra")
            run_cmd = string.concat(run_cmd, " ${val}")
        }
    }
    run_cmd = string.concat(run_cmd, " -cp ${classpath} ${test_class}")
    exit_code = build._sh(run_cmd)
    if exit_code != 0 {
        build._record_test_result(ctx, 0, 1)
        println("${mod_dir}: tests FAILED")
        build.fail(ctx, "tests FAILED")
        return exit_code
    }
    build._record_test_result(ctx, 1, 0)
    println("${mod_dir}: tests PASSED")
    return 0
}
