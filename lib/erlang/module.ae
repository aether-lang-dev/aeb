// erlang — Erlang/OTP SDK for aeb.
//
// Drives an existing Erlang build as-is. NIF/OTP builds are bespoke
// (compile a C NIF, erlc the modules, stage an .app) — `erlang.compile`
// has no single default command, so declare those build steps explicitly
// with step(...) (a genuine native-build script, the legitimate step()
// case). Tests run via `rebar3 eunit`, or an escript with escript("…").
// Env injection rides the shared env(...) setter. (Named `compile`, not
// `build`, so it does not shadow the imported `build` module here.)
//
//   import bldr
//   import erlang
//   import bldr (env)
//   import erlang (escript)
//   erlang.eunit(b) {
//       env("ERL_LIBS", libs)
//       escript("test/playback.escript")   // run this escript, not rebar3
//   }
//
// Setters: env(K,V) [lib/build], step("…") [bespoke compile], escript("…").
import bldr
import std.string
import std.os
import std.io
import std.path
import std.map
import std.list
import std.file

// --- DSL setters ---

// escript("test/playback.escript") — run the suite as `escript <path>`
// instead of the default `rebar3 eunit`. Scalar; last wins. Path is relative
// to source_dir (escript runs from there).
escript(_ctx: ptr, path: string) {
    _e = map.put(_ctx, "escript_path", path)
}

// --- NIF build setters (for erlang.nif) ---

// nif_source("c_src/htmlsanitizer_nif.c") — the C NIF source. Scalar.
nif_source(_ctx: ptr, src: string) {
    _e = map.put(_ctx, "erl_nif_source", src)
}

// erl_source("src/foo.erl") — an Erlang module to erlc (repeatable).
erl_source(_ctx: ptr, src: string) {
    if map.has(_ctx, "erl_sources") == 0 { _e1 = map.put(_ctx, "erl_sources", list.new()) }
    l, _ = map.get(_ctx, "erl_sources")
    _e2 = list.add(l, src)
}

// app_src("src/htmlsanitizer_nif.app.src") — the .app.src copied verbatim to
// ebin/<app>.app (no rebar substitutions). Scalar.
app_src(_ctx: ptr, src: string) {
    _e = map.put(_ctx, "erl_app_src", src)
}

// app_name("htmlsanitizer_nif") — the OTP app dir name under _build/ (default
// "app"). The artifact is _build/<name>/{ebin,priv}. Scalar.
app_name(_ctx: ptr, name: string) {
    _e = map.put(_ctx, "erl_app_name", name)
}

// test_source("test/live_test.erl") — an .erl test module to erlc-compile
// before running (repeatable). Module-relative to source_dir. Used by the
// eunit() run_main path for a compile-a-test-then-run-its-main suite (no
// rebar3/escript). Scalar-list.
test_source(_ctx: ptr, src: string) {
    if map.has(_ctx, "erl_test_sources") == 0 { _e1 = map.put(_ctx, "erl_test_sources", list.new()) }
    l, _ = map.get(_ctx, "erl_test_sources")
    _e2 = list.add(l, src)
}

// run_main("live_test") — after compiling test_source()s, run
// `erl -noshell -pa <ebins> -eval '<mod>:main([]), halt(0)'`. The SDK-native
// form of `erlc + erl -eval main` for a conformance suite that is neither
// rebar3-eunit nor an escript. Scalar. Pairs with pa(...) + env().
run_main(_ctx: ptr, mod: string) {
    _e = map.put(_ctx, "erl_run_main", mod)
}

// pa("<dir>") — an extra code-path directory (`-pa <dir>`) for the run_main
// launch, e.g. a dep NIF app's ebin. Repeatable.
pa(_ctx: ptr, dir: string) {
    if map.has(_ctx, "erl_pa") == 0 { _e1 = map.put(_ctx, "erl_pa", list.new()) }
    l, _ = map.get(_ctx, "erl_pa")
    _e2 = list.add(l, dir)
}

// engine_lib(path) — an engine .so to stage into priv/. If link_engine(...) is
// also set, its DIRECTORY becomes the NIF's -L / -Wl,-rpath so a link-time NIF
// resolves the engine symbols; otherwise it's just staged for a dlopen-style
// NIF. Scalar.
engine_lib(_ctx: ptr, lib: string) {
    _e = map.put(_ctx, "erl_engine_lib", lib)
}

// link_engine(name) — LINK the NIF against the engine at build time:
// `-L<engine_lib dir> -l<name> -Wl,-rpath,<engine_lib dir>`. For a NIF that
// declares the engine's exports `extern` and resolves them at link time (with
// an rpath so it loads at run time) rather than dlopen'ing. Requires
// engine_lib(...) for the directory. `name` is the library stem (e.g.
// "selenium_core" for libselenium_core.so). Scalar.
link_engine(_ctx: ptr, name: string) {
    _e = map.put(_ctx, "erl_link_engine", name)
}

// --- Pure command builders (tested in tests/test_erlang_cmd.ae) ---

// escript_cmd(source_dir, script) — `cd '<dir>' && escript '<script>'`.
escript_cmd(source_dir: string, script: string) {
    return "cd '${source_dir}' && escript '${script}'"
}

// _erts_include() — the erts include dir holding erl_nif.h, asked of the
// running erl (correct for kerl/asdf/Homebrew/relocated installs, unlike a
// hardcoded /usr/lib/erlang), with a /usr/include fallback (Debian erlang-dev).
// Returns "" when erl_nif.h can't be found. Mirrors bldr.sh.
_erts_include() {
    q = "erl -noshell -eval 'io:format(\"~s\", [filename:join([code:root_dir(), \"erts-\" ++ erlang:system_info(version), \"include\"])]), halt(0).'"
    raw, _e = bldr._sh_capture(q)
    inc = string.trim(raw)
    if string.length(inc) > 0 {
        if file.exists(path.join(inc, "erl_nif.h")) == 1 { return inc }
    }
    if file.exists("/usr/include/erl_nif.h") == 1 { return "/usr/include" }
    return ""
}

// erlang.nif(b) — build the canonical BEAM binding: the C NIF + its OTP app
// layout (ebin/*.beam, ebin/<app>.app, priv/<app>.so). The SDK-native form of
// html-sanitizer's erlang/build.sh. SKIPs (green) when the erlang toolchain or
// erl_nif.h is missing.
//
// Nuances encoded: (1) the NIF must NOT link the engine (-lhtmlsanitizer would
// put a DT_NEEDED on it and the BEAM dies in the dynamic linker rather than
// reporting a clean load error) — it dlopens it, so -ldl (not on macOS);
// (2) erl_nif.h is found by asking erl, not guessing.
builder nif(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")
    bldr._mkdirs(target_dir)

    // toolchain: erlc + erl + a C compiler, else SKIP.
    if bldr._sh("command -v erlc >/dev/null 2>&1") != 0 {
        reason = "erlc not on PATH (install erlang)"
        println("${mod_dir}: SKIPPED — ${reason}")
        bldr._record_skip(ctx, reason)
        return 0
    }
    if bldr._sh("command -v erl >/dev/null 2>&1") != 0 {
        reason = "erl not on PATH (install erlang)"
        println("${mod_dir}: SKIPPED — ${reason}")
        bldr._record_skip(ctx, reason)
        return 0
    }
    erts_inc = _erts_include()
    if string.length(erts_inc) == 0 {
        reason = "erl_nif.h not found (install erlang-dev / erlang-devel)"
        println("${mod_dir}: SKIPPED — ${reason}")
        bldr._record_skip(ctx, reason)
        return 0
    }

    // resolve setters
    nif_src = ""
    app_src_v = ""
    app_nm = "app"
    engine = ""
    link_engine_name = ""
    if _builder != null {
        if map.has(_builder, "erl_nif_source") == 1 { nif_src, _ = map.get(_builder, "erl_nif_source") }
        if map.has(_builder, "erl_app_src") == 1 { app_src_v, _ = map.get(_builder, "erl_app_src") }
        if map.has(_builder, "erl_app_name") == 1 { app_nm, _ = map.get(_builder, "erl_app_name") }
        if map.has(_builder, "erl_engine_lib") == 1 { engine, _ = map.get(_builder, "erl_engine_lib") }
        if map.has(_builder, "erl_link_engine") == 1 { link_engine_name, _ = map.get(_builder, "erl_link_engine") }
    }
    if string.length(nif_src) == 0 {
        bldr.fail(ctx, "erlang.nif: nif_source(\"...\") is required")
        return 1
    }

    app_dir = path.join(path.join(source_dir, "_build"), app_nm)
    ebin = path.join(app_dir, "ebin")
    priv = path.join(app_dir, "priv")
    bldr._mkdirs(ebin)
    bldr._mkdirs(priv)

    cc = bldr._default_cc()
    ldl = "-ldl"
    if bldr._is_macos() == 1 { ldl = "" }

    // 1. the NIF .so. By default NO engine lib on the link line (dlopen'd). When
    //    link_engine(name) is set, add `-L<engine dir> -l<name> -Wl,-rpath,<dir>`
    //    so a link-time NIF (extern engine symbols) resolves them at build time
    //    and self-locates the .so at run time via rpath.
    engine_link_flags = ""
    if string.length(link_engine_name) > 0 {
        if string.length(engine) == 0 {
            bldr.fail(ctx, "erlang.nif: link_engine(\"${link_engine_name}\") requires engine_lib(\"...\") for the -L/-rpath directory")
            return 1
        }
        engine_dir = path.dirname(engine)
        engine_link_flags = " -L'${engine_dir}' -l${link_engine_name} -Wl,-rpath,'${engine_dir}'"
    }
    println("${mod_dir}: building NIF (${cc})")
    nif_out = path.join(priv, "${app_nm}.so")
    nif_cmd = "${cc} -O2 -fPIC -Wall -Wextra -shared -I'${erts_inc}' '${path.join(source_dir, nif_src)}' -o '${nif_out}'${engine_link_flags} ${ldl}"
    if bldr._sh(nif_cmd) != 0 {
        println("${mod_dir}: NIF build failed")
        bldr.fail(ctx, "erlang NIF build failed")
        return 1
    }

    // 2. erlc the Erlang modules into ebin.
    esrcs = ""
    if _builder != null {
        if map.has(_builder, "erl_sources") == 1 {
            l, _ = map.get(_builder, "erl_sources")
            n = list.size(l)
            i = 0
            while i < n {
                s, _ = list.get(l, i)
                i = i + 1
                esrcs = string.concat(esrcs, string.concat(" '", string.concat(path.join(source_dir, s), "'")))
            }
        }
    }
    if string.length(string.trim(esrcs)) > 0 {
        if bldr._sh("erlc -o '${ebin}'${esrcs}") != 0 {
            println("${mod_dir}: erlc failed")
            bldr.fail(ctx, "erlc failed")
            return 1
        }
    }

    // 3. the .app file — straight copy of app.src (no rebar substitutions).
    if string.length(app_src_v) > 0 {
        appdst = path.join(ebin, "${app_nm}.app")
        bldr._sh("cp -f '${path.join(source_dir, app_src_v)}' '${appdst}'")
    }

    // 4. stage the engine .so beside the NIF (its real basename) so priv/ is
    //    self-contained for a dlopen-style NIF. A link_engine NIF resolves via
    //    rpath and doesn't need this, but staging is harmless.
    if string.length(engine) > 0 {
        if file.exists(engine) == 1 {
            eng_base = path.basename(engine)
            bldr._sh("cp -f '${engine}' '${path.join(priv, eng_base)}'")
        }
    }

    bldr._write_artifact(ctx, "erlang_app", app_dir)
    // Also publish the OTP-standard consumption edges so BEAM consumers
    // (elixir/gleam, and this app's own test node) resolve the NIF the
    // ERL_LIBS way: erl_libs = the _build root (an ERL_LIBS entry), nif_ebin =
    // this app's ebin (for -pa).
    erl_libs_dir = path.join(source_dir, "_build")
    bldr._write_artifact(ctx, "erl_libs", erl_libs_dir)
    bldr._write_artifact(ctx, "nif_ebin", ebin)
    println("${mod_dir}: built ${app_dir}")
    _et = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// --- Builders ---

// erlang.compile(b) — run the declared build steps (bespoke NIF/erlc/stage);
// success/fail telemetry. Default `rebar3 compile` when no step()s declared.
builder compile(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    mod_dir = bldr._get(ctx, "module_dir")
    println("${mod_dir}: building (erlang)")
    return bldr._run_project(ctx, _builder, "rebar3 compile", 0)
}

// erlang.eunit(b) — `rebar3 eunit` by default, or `escript <path>` when
// escript("…") is declared. Pass/fail telemetry. Honors explicit step()s.
builder eunit(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    mod_dir = bldr._get(ctx, "module_dir")

    // Back-compat: a binding that wrote step("…") keeps the generic path.
    if _builder != null {
        if map.has(_builder, "proc_steps") == 1 {
            println("${mod_dir}: running tests (eunit)")
            return bldr._run_project(ctx, _builder, "rebar3 eunit", 1)
        }
    }

    // run_main("mod") path → erlc the test_source()s, then run mod:main([]) with
    // ERL_LIBS (env) + -pa code paths. For a compile-then-run-main conformance
    // suite (neither rebar3 nor escript).
    if _builder != null {
        if map.has(_builder, "erl_run_main") == 1 {
            rmod, _ = map.get(_builder, "erl_run_main")
            if string.length(rmod) > 0 {
                source_dir = bldr._get(ctx, "source_dir")
                target_dir = bldr._get(ctx, "target_dir")
                bldr._mkdirs(target_dir)

                // 1. erlc the declared test sources into target_dir.
                tsrcs = ""
                if map.has(_builder, "erl_test_sources") == 1 {
                    tl, _ = map.get(_builder, "erl_test_sources")
                    tn = list.size(tl)
                    ti = 0
                    while ti < tn {
                        ts, _ = list.get(tl, ti)
                        tsrcs = string.concat(tsrcs, string.concat(" '", string.concat(path.join(source_dir, ts), "'")))
                        ti = ti + 1
                    }
                }
                if string.length(string.trim(tsrcs)) > 0 {
                    if bldr._sh("erlc -o '${target_dir}'${tsrcs}") != 0 {
                        bldr._record_test_result(ctx, 0, 1)
                        println("${mod_dir}: erlc (test) failed")
                        bldr.fail(ctx, "erlc (test) failed")
                        return 1
                    }
                }

                // 2. assemble -pa: target_dir (the compiled test) + declared pa()s.
                pa_flags = "-pa '${target_dir}'"
                if map.has(_builder, "erl_pa") == 1 {
                    pl, _ = map.get(_builder, "erl_pa")
                    pn = list.size(pl)
                    pi = 0
                    while pi < pn {
                        pd, _ = list.get(pl, pi)
                        pa_flags = string.concat(pa_flags, " -pa '${pd}'")
                        pi = pi + 1
                    }
                }

                // 3. run mod:main([]) and halt on its result.
                run = "cd '${source_dir}' && erl -noshell ${pa_flags} -eval '${rmod}:main([]), halt(0)'"
                run = string.concat(bldr._env_export_prefix(_builder), run)
                println("${mod_dir}: running ${rmod}:main (erl)")
                rc = bldr._sh(run)
                if rc != 0 {
                    bldr._record_test_result(ctx, 0, 1)
                    println("${mod_dir}: tests FAILED")
                    bldr.fail(ctx, "tests FAILED")
                    return rc
                }
                bldr._record_test_result(ctx, 1, 0)
                println("${mod_dir}: tests PASSED")
                _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
                return 0
            }
        }
    }

    // escript("…") path → run the escript directly with env + telemetry.
    if _builder != null {
        if map.has(_builder, "escript_path") == 1 {
            sp, _ = map.get(_builder, "escript_path")
            if string.length(sp) > 0 {
                source_dir = bldr._get(ctx, "source_dir")
                target_dir = bldr._get(ctx, "target_dir")
                bldr._mkdirs(target_dir)
                println("${mod_dir}: running tests (escript ${sp})")
                rc = bldr._sh(string.concat(bldr._env_export_prefix(_builder), escript_cmd(source_dir, sp)))
                if rc != 0 {
                    bldr._record_test_result(ctx, 0, 1)
                    println("${mod_dir}: tests FAILED")
                    bldr.fail(ctx, "tests FAILED")
                    return rc
                }
                bldr._record_test_result(ctx, 1, 0)
                println("${mod_dir}: tests PASSED")
                _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
                return 0
            }
        }
    }

    // Default: rebar3 eunit through the generic path.
    println("${mod_dir}: running tests (eunit)")
    return bldr._run_project(ctx, _builder, "rebar3 eunit", 1)
}
