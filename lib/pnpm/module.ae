// pnpm — npm dependency resolution SDK for aether.build
//
// Uses pnpm to download packages to its content-addressed store and
// creates a node_modules layout in .aeb/node_modules/.
// Separate from the TypeScript language SDK — a TS project might use
// yarn or npm instead of pnpm.
import bldr
import std.string
import std.io
import std.os
import std.file
import std.fs
import std.list
import std.map
import std.path
import std.dir

// --- Command builders (pure) ---

// pnpm_spec_from_dep — translate a "name:version" dep entry into the
// "name@version" spec pnpm add expects. Handles scoped packages
// (e.g. "@angular/core:11.2.4" → "@angular/core@11.2.4") by splitting
// on the LAST colon. Pure.
pnpm_spec_from_dep(pkg: string) {
    pkg_len = string.length(pkg)
    last_colon = -1
    ci = 0
    while ci < pkg_len {
        ch = string.substring(pkg, ci, ci + 1)
        if ch == ":" {
            last_colon = ci
        }
        ci = ci + 1
    }
    if last_colon < 0 {
        return pkg
    }
    pkg_name = string.substring(pkg, 0, last_colon)
    pkg_ver = string.substring(pkg, last_colon + 1, pkg_len)
    out = string.concat(pkg_name, "@")
    return string.concat(out, pkg_ver)
}

// pnpm_add_cmd — assemble the pnpm add command. Pure: caller passes
// a pre-built list of dep entries (each "name:version") and the
// install prefix dir. Each entry is run through pnpm_spec_from_dep
// before quoting.
pnpm_add_cmd(prefix_dir: string, deps: ptr) {
    cmd = "COREPACK_ENABLE_STRICT=0 pnpm add --prefix '${prefix_dir}'"
    if deps == null {
        return cmd
    }
    n = list.size(deps)
    i = 0
    while i < n {
        pkg, _ = list.get(deps, i)
        spec = pnpm_spec_from_dep(pkg)
        cmd = string.concat(cmd, " '${spec}'")
        i = i + 1
    }
    return cmd
}

// _line_present(haystack, needle) — is `needle` one of the newline-separated
// lines of `haystack`? Whole-line match, so "react" does not match
// "react-dom" and "vite@5" does not match "vite@5.1".
_line_present(haystack: string, needle: string) -> int {
    rest = haystack
    while string.length(rest) > 0 {
        nl = string.index_of(rest, "\n")
        line = ""
        if nl < 0 {
            line = rest
            rest = ""
        } else {
            line = string.substring(rest, 0, nl)
            rest = string.substring(rest, nl + 1, string.length(rest))
        }
        if string.equals(string.trim(line), needle) == 1 { return 1 }
    }
    return 0
}

// pnpm_locked_cmd(lock_dir, inner) — run `inner` while holding an advisory
// lock at `lock_dir`. Pure (returns the shell string).
//
// WHY. Every node installs into ONE shared prefix, `<root>/.aeb`, and nodes
// run as parallel make subprocesses. `pnpm add` is not a concurrent-safe
// operation on a prefix: it rewrites `package.json` and then prunes
// node_modules to match, so two adds racing means one silently reverts the
// other. Observed on nx-examples, where `libs/cart/cart-page` failed with
//   error TS2307: Cannot find module 'react'
// while `react` sat in `.aeb/package.json` the whole time — a sibling node's
// add had re-pruned the tree out from under the running tsc.
//
// `mkdir` (POSIX, WITHOUT -p) is the lock: it is atomic and fails if the
// directory exists. Bounded spin, then proceed anyway — a stale lock from a
// killed process must not wedge every later build, and the worst case of
// proceeding is the race we already had.
//
// `$?` is captured before the rmdir so the caller still sees pnpm's real
// exit status, not the unlock's. `sh` here is dash on Debian/Ubuntu, so this
// stays POSIX: no `flock`, no bashisms.
pnpm_locked_cmd(lock_dir: string, inner: string) {
    c = "__i=0; while [ $__i -lt 900 ]; do mkdir '${lock_dir}' 2>/dev/null && break; "
    c = string.concat(c, "__i=$((__i+1)); sleep 0.2; done; ")
    c = string.concat(c, inner)
    c = string.concat(c, "; __rc=$?; rmdir '${lock_dir}' 2>/dev/null; exit $__rc")
    return c
}

// pnpm_wait_unlocked_cmd(lock_dir) — block while somebody else is adding.
// Pure (returns the shell string).
//
// The lock above stops two adds from corrupting each other. This stops a
// node from COMPILING against a node_modules that an add is halfway through
// relinking — which is the shape that actually failed: cart-page's tsc ran
// while a sibling's `pnpm add` was mid-prune and reported `Cannot find
// module 'react'` for a package that was present before and after.
//
// RESIDUAL, and it is honest to state it: this closes the window only for an
// add already in flight when the node checks. An add that STARTS during a
// long compile can still disturb it. Closing that needs a real shared/
// exclusive lock held for the whole compile, which is a bigger change than
// lib/pnpm should carry — the real answer is resolving the union of every
// node's npm deps once, before any node compiles. Until then, note that the
// marker file makes each spec install exactly once per build, so adds all
// cluster at the start and the exposure shrinks as the build proceeds.
pnpm_wait_unlocked_cmd(lock_dir: string) {
    c = "__i=0; while [ -d '${lock_dir}' ] && [ $__i -lt 900 ]; do "
    c = string.concat(c, "__i=$((__i+1)); sleep 0.2; done; exit 0")
    return c
}

// _link_root_node_modules(root, nm_dir) — make <root>/node_modules point at
// aeb's .aeb/node_modules, unless something is already there.
//
// aeb installs into .aeb/node_modules and hands the TOOL path to the
// builders (`.aeb/node_modules/.bin/tsc`). That runs the tool, but it does
// nothing for the tool's OWN module resolution: TypeScript, jest and every
// other Node tool resolve a bare `import "react"` by walking UP the
// directory chain from the importing file looking for `node_modules/`, and
// `.aeb/node_modules` is not on that chain. So a library that imports a real
// npm package failed with
//   error TS2307: Cannot find module 'react'
// while react sat installed and correct in .aeb/node_modules. Only libraries
// importing nothing but path aliases worked, which is why it stayed hidden.
//
// A root symlink is what `pnpm install` itself would create, and
// `node_modules` is gitignored everywhere, so this puts nothing new in front
// of the developer. Guarded on fs.exists: a project with a REAL root
// node_modules (its own pnpm/npm install) keeps it untouched — aeb adds a
// convenience, it does not take the directory over. A failure is silent:
// Windows needs a privilege for symlinks, and the builders still work there
// for path-alias-only projects exactly as they did before.
_link_root_node_modules(root: string, nm_dir: string) {
    link_path = path.join(root, "node_modules")
    if fs.exists(link_path) == 1 { return 0 }
    if dir.exists(nm_dir) == 0 { return 0 }
    _serr = fs.symlink(nm_dir, link_path)
    return 0
}

// --- npm dependency resolution ---
//
// All npm deps (npm:pkg:version) are collected via dep() in build
// and resolved in one pnpm add call.

resolve(ctx: ptr) {
    if map.has(ctx, "_npm_resolved") == 1 {
        v, _ = map.get(ctx, "_npm_resolved")
        return v
    }

    npm_deps, _ = map.get(ctx, "npm_deps")
    dep_count = list.size(npm_deps)
    if dep_count == 0 {
        _e1 = map.put(ctx, "_npm_resolved", "")
        return ""
    }

    root = bldr._get(ctx, "root")
    aeb_dir = path.join(root, ".aeb")
    nm_dir = path.join(aeb_dir, "node_modules")
    mod_dir = bldr._get(ctx, "module_dir")

    // Skip only what has ALREADY BEEN ADDED — not "does node_modules exist".
    //
    // Every node declares its own npm deps, and they all install into one
    // shared .aeb/node_modules. The old guard was `if file.exists(nm_dir)`,
    // which asks a regular-file-only predicate about a DIRECTORY and so
    // always answered 0 (one of the three-way exists() traps AGENTS.md
    // calls out). Two bugs cancelled: the guard never fired, so every node
    // ran `pnpm add` with its own package list and between them the tree
    // ended up complete — at the cost of one pnpm invocation per node.
    //
    // Correcting the predicate alone breaks that: the FIRST node's install
    // creates node_modules, and every later node then skips, so react,
    // @emotion/styled and jest are never installed and their consumers fail
    // with "Cannot find module 'react'" and "jest: No such file or
    // directory". The directory existing says nothing about whether THIS
    // node's packages are in it.
    //
    // So track the specs added so far in .aeb/.aeb_npm_added and add only
    // what is missing. Correct like the accidental behaviour was, and
    // cheaper — a node whose deps are all present shells out to nothing.
    added_marker = path.join(aeb_dir, ".aeb_npm_added")
    added_txt = ""
    if file.exists(added_marker) == 1 {
        raw_added, _rerr = io.read_file(added_marker)
        added_txt = raw_added
    }
    missing = list.new()
    di = 0
    while di < dep_count {
        d_pkg, _ = list.get(npm_deps, di)
        d_spec = pnpm_spec_from_dep(d_pkg)
        if _line_present(added_txt, d_spec) == 0 {
            _lm = list.add(missing, d_pkg)
        }
        di = di + 1
    }
    if list.size(missing) == 0 {
        // Nothing to add — but do not hand node_modules to a compiler while
        // somebody else is relinking it.
        _wl = bldr._sh(pnpm_wait_unlocked_cmd(path.join(aeb_dir, ".aeb_npm_lock")))
        _lr1 = _link_root_node_modules(root, nm_dir)
        _e2 = map.put(ctx, "_npm_resolved", nm_dir)
        bldr._write_artifact(ctx, "npm_node_modules", nm_dir)
        return nm_dir
    }

    println("${mod_dir}: resolving npm dependencies via pnpm")

    // .aeb is aeb's per-project dir; `aeb --init` creates it, but --init is
    // optional (SDK resolution falls back to $AEB_HOME/lib), so a project
    // that never ran it has no .aeb at all. Without this the two writes
    // below silently failed — their io.write_file returns went into discard
    // variables — and `pnpm add --dir <root>/.aeb` then died with
    //   [ERROR] ENOENT: no such file or directory, lstat '<root>/.aeb'
    // which was downgraded to a warning, so the real error surfaced later
    // and elsewhere as `.aeb/node_modules/.bin/tsc: No such file`.
    bldr._mkdirs(aeb_dir)

    // Ensure .aeb has a package.json and hoisted layout config
    aeb_pkg = path.join(aeb_dir, "package.json")
    if file.exists(aeb_pkg) == 0 {
        _e3 = io.write_file(aeb_pkg, "{}")
    }
    aeb_npmrc = path.join(aeb_dir, ".npmrc")
    if file.exists(aeb_npmrc) == 0 {
        _e4 = io.write_file(aeb_npmrc, "node-linker=hoisted")
    }

    // COREPACK_ENABLE_STRICT=0 allows pnpm to work even when
    // a parent package.json declares a different package manager
    cmd = pnpm_locked_cmd(path.join(aeb_dir, ".aeb_npm_lock"),
                          pnpm_add_cmd(aeb_dir, missing))
    exit_code = bldr._sh(cmd)
    if exit_code == 0 {
        // Record what landed, so a later node asking for the same specs
        // shells out to nothing. Only on success: a failed add must be
        // retried, not remembered.
        mi = 0
        mn = list.size(missing)
        while mi < mn {
            m_pkg, _ = list.get(missing, mi)
            added_txt = string.concat(added_txt, pnpm_spec_from_dep(m_pkg))
            added_txt = string.concat(added_txt, "\n")
            mi = mi + 1
        }
        _ewm = io.write_file(added_marker, added_txt)
    }
    if exit_code != 0 {
        // Deliberately a warning, not a bldr.fail: the consumer that
        // actually needs the packages (tsc, jest, ng) fails loudly on its
        // own and attributes to the right node. Carry the exit code so the
        // root cause is greppable in the node log rather than inferred from
        // a missing binary three lines later.
        println("${mod_dir}: warning: pnpm add failed (exit ${exit_code})")
    }

    _lr2 = _link_root_node_modules(root, nm_dir)
    _e5 = map.put(ctx, "_npm_resolved", nm_dir)
    bldr._write_artifact(ctx, "npm_node_modules", nm_dir)
    return nm_dir
}

// --- Builders: install + run ---
//
// `pnpm.resolve(ctx)` (above) handles the .npm.ae dep-coordinate
// flow — aeb declares packages, pnpm fetches them into .aeb/.
// What's missing for a real project that ships its own package.json
// + pnpm-workspace.yaml + pnpm-lock.yaml is:
//
//   pnpm.install(b)        — `pnpm install` from source_dir, honouring
//                            the in-tree package.json + lockfile. The
//                            shape every Bazel-rules-js conversion
//                            needs as step zero.
//
//   pnpm.run(b, "script")  — `pnpm run <script>`. The way modern JS
//                            projects expose build/test/lint
//                            commands (`pnpm run lint`, `pnpm run
//                            build`, …). Closure-DSL friendly: pass
//                            a list of script args via the
//                            `script_arg(...)` setter.

// --- DSL setters (consumed by pnpm.run) ---

// script_arg("--silent") — extra arg appended after the script
// name. Repeatable. The script name itself is passed as the
// builder-call positional arg.
script_arg(_ctx: ptr, arg: string) {
    if map.has(_ctx, "pnpm_script_args") == 0 {
        _e1 = map.put(_ctx, "pnpm_script_args", list.new())
    }
    args, _ = map.get(_ctx, "pnpm_script_args")
    _e2 = list.add(args, arg)
}

// frozen_lockfile() — pass `--frozen-lockfile` to `pnpm install`.
// Bunches an exact-lockfile install (CI mode). When the lockfile
// is out of sync with package.json, the install fails fast instead
// of silently regenerating the lockfile.
frozen_lockfile(_ctx: ptr) {
    _e = map.put(_ctx, "pnpm_frozen_lockfile", "1")
}

// --- Pure command builders ---

// pnpm_install_cmd — `cd <src> && pnpm install [--frozen-lockfile]`.
// Pure.
pnpm_install_cmd(source_dir: string, frozen: int) {
    if frozen == 1 {
        return "cd '${source_dir}' && COREPACK_ENABLE_STRICT=0 pnpm install --frozen-lockfile"
    }
    return "cd '${source_dir}' && COREPACK_ENABLE_STRICT=0 pnpm install"
}

// pnpm_run_cmd — `cd <src> && pnpm run <script> [args]`. args is a
// pre-joined space-separated string (caller built it from the
// script_arg list). Empty args → bare `pnpm run <script>`. Pure.
pnpm_run_cmd(source_dir: string, script: string, args: string) {
    if string.length(args) == 0 {
        return "cd '${source_dir}' && COREPACK_ENABLE_STRICT=0 pnpm run ${script}"
    }
    return "cd '${source_dir}' && COREPACK_ENABLE_STRICT=0 pnpm run ${script} -- ${args}"
}

// Helper: assemble the script args list into a single space-
// separated string. Pure (loops a list).
_script_args_str(builder_map: ptr) {
    if builder_map == null { return "" }
    if map.has(builder_map, "pnpm_script_args") == 0 { return "" }
    args, _ = map.get(builder_map, "pnpm_script_args")
    n = list.size(args)
    if n == 0 { return "" }
    out = ""
    i = 0
    while i < n {
        a, _ = list.get(args, i)
        if i > 0 { out = string.concat(out, " ") }
        out = string.concat(out, a)
        i = i + 1
    }
    return out
}

// pnpm.install(b) — run `pnpm install` from source_dir. Honours the
// project's own package.json + pnpm-lock.yaml + pnpm-workspace.yaml
// without aeb introducing parallel state. The right choice for a
// Bazel-rules-js project that already manages its npm dep closure.
//
// Distinct from `pnpm.resolve(ctx)` (above), which is the
// aeb-declared dep flow for .npm.ae files.
builder install(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")
    source_dir = bldr._get(ctx, "source_dir")
    bldr._mkdirs(target_dir)

    frozen = 0
    if _builder != null {
        if map.has(_builder, "pnpm_frozen_lockfile") == 1 {
            frozen = 1
        }
    }

    println("${mod_dir}: pnpm install")
    cmd = pnpm_install_cmd(source_dir, frozen)
    rc = bldr._sh(cmd)
    if rc != 0 {
        println("${mod_dir}: pnpm install FAILED")
        bldr.fail(ctx, "pnpm install FAILED")
        return rc
    }
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// pnpm.run(b, "script-name") — run a `scripts:` entry from
// source_dir's package.json. Repeatable `script_arg(...)` setters
// append args after the script name (separated by `--` so they reach
// the script, not pnpm itself).
builder run(script: string): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")
    source_dir = bldr._get(ctx, "source_dir")
    bldr._mkdirs(target_dir)

    args_str = _script_args_str(_builder)
    println("${mod_dir}: pnpm run ${script}")
    cmd = pnpm_run_cmd(source_dir, script, args_str)
    rc = bldr._sh(cmd)
    if rc != 0 {
        println("${mod_dir}: pnpm run ${script} FAILED")
        bldr.fail(ctx, "pnpm run ${script} FAILED")
        return rc
    }
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}
