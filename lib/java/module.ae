// java — Java SDK for aether.build
import build
import cache
import maven
import std.string
import std.io
import std.os
import std.file
import std.fs
import std.list
import std.map
import std.path
import std.dir

// --- Java DSL setters ---

release(_ctx: ptr, ver: string) {
    _e = map.put(_ctx, "release", ver)
}

// select_jdk(version) — select among ALREADY-INSTALLED JDKs by major
// version (exact "21", or floor "21+"). Discover-select-or-fail: aeb
// probes /usr/lib/jvm (and $JAVA_HOME) for a matching JDK and runs javac
// from THAT home instead of PATH's. Never downloads — install the JDK
// yourself (sdkman/apt/setup-java) and this picks it.
//
// Orthogonal to release(): release() sets the bytecode/API LEVEL
// (--release 21 works on any JDK >= 21); select_jdk() picks WHICH javac
// compiles. On a single-JDK box this is a no-op-or-fail check; on a
// multi-JDK box it disambiguates. Java's classpath is JDK-independent,
// so this does NOT participate in dependency resolution — it only changes
// the compiler binary (and the cache key, via the selected javac version).
// Design: docs/toolchain-selection-and-locks.md
select_jdk(_ctx: ptr, version: string) {
    _e = map.put(_ctx, "select_jdk", version)
}

source_ver(_ctx: ptr, ver: string) {
    _e = map.put(_ctx, "source", ver)
}

target_ver(_ctx: ptr, ver: string) {
    _e = map.put(_ctx, "target", ver)
}

lint(_ctx: ptr, level: string) {
    _e = map.put(_ctx, "lint", level)
}

encoding(_ctx: ptr, enc: string) {
    _e = map.put(_ctx, "encoding", enc)
}

deprecation(_ctx: ptr) {
    _e = map.put(_ctx, "deprecation", "true")
}

parameters(_ctx: ptr) {
    _e = map.put(_ctx, "parameters", "true")
}

debug(_ctx: ptr, level: string) {
    _e = map.put(_ctx, "debug", level)
}

enable_preview(_ctx: ptr) {
    _e = map.put(_ctx, "enable_preview", "true")
}

processor(_ctx: ptr, fqcn: string) {
    _e = map.put(_ctx, "processor", fqcn)
}

module_path(_ctx: ptr, path: string) {
    _e = map.put(_ctx, "module_path", path)
}

// no_module_info() — when the source set contains a module-info.java, the
// javac builder auto-switches to a modular compile (resolved deps go on
// --module-path so `requires` resolves). Call this to opt OUT: module-info.java
// is dropped from the compile and deps stay on -classpath (the automatic-module
// / plain-jar build). Use when a JPMS descriptor is present but you want a
// classpath-mode jar. Any non-empty value enables.
no_module_info(_ctx: ptr) {
    _e = map.put(_ctx, "no_module_info", "1")
}

source_layout(_ctx: ptr, layout: string) {
    _e = map.put(_ctx, "source_layout", layout)
}

// classpath_file(path) — contribute a PRE-RESOLVED classpath, read from a
// file (a single line of `:`-separated jar paths, e.g. the output of
// `mvn dependency:build-classpath -Dmdep.outputFile=...`). Appended to the
// javac/shade classpath WITHOUT invoking the Maven resolver. The escape
// hatch for a pre-resolved or vendored classpath — and specifically the
// bootstrap path for building aeb's OWN resolver (tools/resolver), which
// can't resolve its own Maven deps via aeb-resolve.jar (the artifact being
// built). Path is module-relative; resolved at build time. Repeatable.
classpath_file(_ctx: ptr, path: string) {
    if map.has(_ctx, "classpath_file") == 0 {
        _e1 = map.put(_ctx, "classpath_file", list.new())
    }
    cfs, _ = map.get(_ctx, "classpath_file")
    _e2 = list.add(cfs, path)
}

processor_path(_ctx: ptr, path: string) {
    _e = map.put(_ctx, "processor_path", path)
}

test_timeout(_ctx: ptr, seconds: string) {
    _e = map.put(_ctx, "test_timeout", seconds)
}

generated_sources(_ctx: ptr, dir: string) {
    _e = map.put(_ctx, "generated_sources", dir)
}

jvm_args(_ctx: ptr, arg: string) {
    if map.has(_ctx, "jvm_args") == 1 {
        prev, _ = map.get(_ctx, "jvm_args")
        combined = string.concat(prev, " ")
        combined = string.concat(combined, arg)
        _e1 = map.put(_ctx, "jvm_args", combined)
    } else {
        _e2 = map.put(_ctx, "jvm_args", arg)
    }
}

// --- Command builders ---

javac_cmd(classes_dir: string, classpath: string, file_list: string, opts: ptr) {
    // javac binary: PATH "javac" by default, or an absolute
    // "<selected-jdk-home>/bin/javac" when select_jdk(...) resolved one
    // (stashed on the opts map as "_javac_bin" by the builder). Keeping
    // it on the opts map preserves javac_cmd's existing 4-arg signature
    // and keeps the helper pure / testable.
    javac_bin = "javac"
    if opts != null {
        if map.has(opts, "_javac_bin") == 1 {
            jb, _ = map.get(opts, "_javac_bin")
            if string.length(jb) > 0 { javac_bin = jb }
        }
    }
    cmd = "${javac_bin} -d ${classes_dir}"

    if opts != null {
        if map.has(opts, "release") == 1 {
            val, _ = map.get(opts, "release")
            cmd = string.concat(cmd, " --release ${val}")
        } else {
            if map.has(opts, "source") == 1 {
                val, _ = map.get(opts, "source")
                cmd = string.concat(cmd, " -source ${val}")
            }
            if map.has(opts, "target") == 1 {
                val, _ = map.get(opts, "target")
                cmd = string.concat(cmd, " -target ${val}")
            }
        }

        if map.has(opts, "encoding") == 1 {
            val, _ = map.get(opts, "encoding")
            cmd = string.concat(cmd, " -encoding ${val}")
        }

        if map.has(opts, "debug") == 1 {
            val, _ = map.get(opts, "debug")
            if val == "none" {
                cmd = string.concat(cmd, " -g:none")
            } else {
                if val == "all" {
                    cmd = string.concat(cmd, " -g")
                } else {
                    cmd = string.concat(cmd, " -g:${val}")
                }
            }
        }

        if map.has(opts, "lint") == 1 {
            val, _ = map.get(opts, "lint")
            cmd = string.concat(cmd, " -Xlint:${val}")
        }

        if map.has(opts, "werror") == 1 {
            cmd = string.concat(cmd, " -Werror")
        }

        if map.has(opts, "deprecation") == 1 {
            cmd = string.concat(cmd, " -deprecation")
        }

        if map.has(opts, "parameters") == 1 {
            cmd = string.concat(cmd, " -parameters")
        }

        if map.has(opts, "nowarn") == 1 {
            cmd = string.concat(cmd, " -nowarn")
        }

        if map.has(opts, "verbose") == 1 {
            cmd = string.concat(cmd, " -verbose")
        }

        if map.has(opts, "enable_preview") == 1 {
            cmd = string.concat(cmd, " --enable-preview")
        }

        if map.has(opts, "module_path") == 1 {
            val, _ = map.get(opts, "module_path")
            cmd = string.concat(cmd, " --module-path ${val}")
        }

        if map.has(opts, "processor") == 1 {
            val, _ = map.get(opts, "processor")
            cmd = string.concat(cmd, " -processor ${val}")
        }

        if map.has(opts, "processor_path") == 1 {
            val, _ = map.get(opts, "processor_path")
            cmd = string.concat(cmd, " -processorpath ${val}")
        }

        if map.has(opts, "generated_sources") == 1 {
            val, _ = map.get(opts, "generated_sources")
            cmd = string.concat(cmd, " -s ${val}")
        }

        if map.has(opts, "extra") == 1 {
            val, _ = map.get(opts, "extra")
            cmd = string.concat(cmd, " ${val}")
        }
    }

    // Modular compile: a module-info.java in the source set means the
    // resolved deps must sit on --module-path (not -cp) or `requires`
    // won't resolve. The builder sets "modular" when it detects one (and
    // no_module_info() wasn't given). A manual module_path(...) above adds
    // its own --module-path; javac takes the last, so don't set both.
    modular = 0
    if opts != null {
        if map.has(opts, "modular") == 1 {
            mv, _ = map.get(opts, "modular")
            if string.equals(mv, "1") == 1 { modular = 1 }
        }
    }
    if modular == 1 {
        cmd = string.concat(cmd, " --module-path ${classpath} ${file_list}")
    } else {
        cmd = string.concat(cmd, " -cp ${classpath} ${file_list}")
    }
    return cmd
}

junit_cmd(classpath: string, class_names: string, ld_path: string, opts: ptr) {
    cmd = ""
    if string.length(ld_path) > 0 {
        dyld_var = build._dyld_env_var()
        cmd = "${dyld_var}=${ld_path} java"
        cmd = string.concat(cmd, " -Djava.library.path=${ld_path}")
    } else {
        cmd = "java"
    }

    if opts != null {
        if map.has(opts, "jvm_args") == 1 {
            val, _ = map.get(opts, "jvm_args")
            cmd = string.concat(cmd, " ${val}")
        }
        if map.has(opts, "extra") == 1 {
            val, _ = map.get(opts, "extra")
            cmd = string.concat(cmd, " ${val}")
        }
    }

    cmd = string.concat(cmd, " -cp ${classpath} org.junit.runner.JUnitCore ${class_names}")
    return cmd
}

// --- SDK functions ---

// jar_vendored — declare a vendored jar as a classpath contribution.
// Use this in a .jar.ae file so downstream consumers that dep on this
// file pick up the jar in their classpath artifact.
builder jar_vendored(ctx: ptr, jar_path: string) {
    target_dir = build._get(ctx, "target_dir")
    mod_dir = build._get(ctx, "module_dir")
    build._mkdirs(target_dir)
    // Resolve repo-root-relative jar paths to absolute so the classpath works
    // regardless of the consumer's cwd. The .jar.ae stays portable (relative).
    abs_jar = jar_path
    if string.equals(string.substring(jar_path, 0, 1), "/") == 0 {
        abs_jar = path.join(build._get(ctx, "root"), jar_path)
    }
    _accumulate_classpath_jar(ctx, abs_jar)
    println("${mod_dir}: vendored jar ${jar_path}")
    return 0
}

// _accumulate_classpath_jar(ctx, abs_jar) — append one absolute jar path to
// the per-build classpath list and rewrite the whole newline-separated
// jvm_classpath_deps_including_transitive artifact. Shared by jar_vendored
// (committed jar) and jar_pinned (coord + sha256). The map is per-build, so
// a fresh build resets the list (no stale cross-run accumulation).
_accumulate_classpath_jar(ctx: ptr, abs_jar: string) {
    if map.has(ctx, "_vendored_jars") == 0 {
        _e0 = map.put(ctx, "_vendored_jars", list.new())
    }
    vj, _ = map.get(ctx, "_vendored_jars")
    _a = list.add(vj, abs_jar)
    content = ""
    n = list.size(vj)
    k = 0
    while k < n {
        jp, _ = list.get(vj, k)
        if k == 0 { content = jp } else { content = string.concat(string.concat(content, "\n"), jp) }
        k = k + 1
    }
    build._write_artifact(ctx, "jvm_classpath_deps_including_transitive", content)
}

// jar_pinned(b, "g:a:v", "<sha256>") — declare a Maven coordinate pinned to
// its sha256, WITHOUT committing the jar bytes. The jar is resolved from a
// content-addressed cache (~/.cache/aeb/jars/<sha256>.jar); on a miss it is
// sourced from ~/.m2 or fetched from Maven Central, verified against the
// pinned sha256 (FAIL-CLOSED on mismatch), and cached. Same accumulate-into-
// the-classpath-artifact contract as jar_vendored — so a .jar.ae becomes a
// committed lockfile (coord + hash) and the repo holds no binaries. The hash
// doubles as a supply-chain pin (cf. aeb --vet / --sbom-json).
builder jar_pinned(ctx: ptr, coord: string, sha256: string) {
    target_dir = build._get(ctx, "target_dir")
    mod_dir = build._get(ctx, "module_dir")
    build._mkdirs(target_dir)
    jar = _resolve_pinned_jar(coord, sha256, "")
    if string.length(jar) == 0 {
        println("${mod_dir}: jar_pinned: ${coord} unresolved (sha256 mismatch, or not in ~/.m2 and fetch failed)")
        build.fail(ctx, "jar_pinned: ${coord} unresolved")
        return 1
    }
    _accumulate_classpath_jar(ctx, jar)
    println("${mod_dir}: pinned ${coord}")
    return 0
}

// --- mvn_repo: a pinned dependency closure scoped by resolution repos ---
//
//   java.mvn_repo(b) {
//       central()                          // Maven Central (shorthand)
//       repo("https://nexus.corp/maven")   // 0+ more, tried in order
//       pinned("g:a:v", "<sha256>")        // the locked closure
//       pinned(...)
//   }
//
// Each pinned coordinate resolves from the content-addressed cache, then
// ~/.m2, then each declared repo in order — verified against its sha256
// (fail-closed). Because the hash is the trust boundary, the repo list is a
// pure reachability concern: list any mirror/proxy. Setters central/repo/
// pinned are bare-imported: `import java (central, repo, pinned)`.

central(_ctx: ptr) {
    _append_repo(_ctx, "https://repo1.maven.org/maven2")
}
repo(_ctx: ptr, url: string) {
    _append_repo(_ctx, url)
}
_append_repo(ctx: ptr, url: string) {
    if map.has(ctx, "mvn_repos") == 0 { _e = map.put(ctx, "mvn_repos", list.new()) }
    rl, _ = map.get(ctx, "mvn_repos")
    _a = list.add(rl, string.concat(url, ""))
}
pinned(_ctx: ptr, coord: string, sha: string) {
    if map.has(_ctx, "mvn_pinned") == 0 { _e = map.put(_ctx, "mvn_pinned", list.new()) }
    pl, _ = map.get(_ctx, "mvn_pinned")
    entry = string.concat(string.concat(coord, "|"), sha)
    _a = list.add(pl, entry)
}

builder mvn_repo(ctx: ptr) {
    target_dir = build._get(ctx, "target_dir")
    mod_dir = build._get(ctx, "module_dir")
    build._mkdirs(target_dir)
    if _builder == null {
        println("${mod_dir}: mvn_repo: empty block — declare pinned(...) deps")
        return 0
    }

    // Join declared repos (newline-separated); _resolve defaults to Central.
    repos_nl = ""
    if map.has(_builder, "mvn_repos") == 1 {
        rl, _ = map.get(_builder, "mvn_repos")
        nr = list.size(rl)
        j = 0
        while j < nr {
            u, _ = list.get(rl, j)
            if j == 0 { repos_nl = u } else { repos_nl = string.concat(string.concat(repos_nl, "\n"), u) }
            j = j + 1
        }
    }

    if map.has(_builder, "mvn_pinned") == 0 {
        println("${mod_dir}: mvn_repo: no pinned(...) deps")
        return 0
    }
    deps, _ = map.get(_builder, "mvn_pinned")
    nd = list.size(deps)
    i = 0
    while i < nd {
        entry, _ = list.get(deps, i)
        kv = string.split(entry, "|")
        if string.array_size(kv) == 2 {
            coord = string.concat(string.array_get(kv, 0), "")
            sha = string.concat(string.array_get(kv, 1), "")
            string.array_free(kv)
            jar = _resolve_pinned_jar(coord, sha, repos_nl)
            if string.length(jar) == 0 {
                println("${mod_dir}: mvn_repo: ${coord} unresolved (sha256 mismatch, or unreachable in all repos)")
                build.fail(ctx, "mvn_repo: ${coord} unresolved")
                return 1
            }
            _accumulate_classpath_jar(ctx, jar)
            println("${mod_dir}: pinned ${coord}")
        } else {
            string.array_free(kv)
        }
        i = i + 1
    }
    return 0
}

// _resolve_pinned_jar(coord, sha256) — return an absolute path to the jar for
// `g:a:v` whose content sha256 == the pin, or "" on failure. Content-addressed
// cache first (the filename IS the verification), then ~/.m2, then a Maven
// Central fetch — each candidate hashed and checked before it's trusted.
// _dots_to_slashes(s) — pure: "a.b.c" -> "a/b/c" (Maven group → path). No shell.
_dots_to_slashes(s: string) {
    out = ""
    n = string.length(s)
    i = 0
    while i < n {
        ch = string.substring(s, i, i + 1)
        if string.equals(ch, ".") == 1 { out = string.concat(out, "/") } else { out = string.concat(out, ch) }
        i = i + 1
    }
    return out
}

// _pinned_relpath("g:a:v") — pure: the Maven-layout relative path
// "<group/with/slashes>/<a>/<v>/<a>-<v>.jar", valid under any repo root
// (~/.m2/repository or a remote base URL). "" if not a g:a:v coordinate.
// Tested in tests/test_jar_pinned.ae.
_pinned_relpath(coord: string) {
    parts = string.split(coord, ":")
    if string.array_size(parts) < 3 { string.array_free(parts); return "" }
    g = string.concat(string.array_get(parts, 0), "")
    a = string.concat(string.array_get(parts, 1), "")
    v = string.concat(string.array_get(parts, 2), "")
    string.array_free(parts)
    gp = _dots_to_slashes(g)
    return "${gp}/${a}/${v}/${a}-${v}.jar"
}

_resolve_pinned_jar(coord: string, sha256: string, repos_nl: string) {
    home = os.getenv("HOME")
    cache_dir = "${home}/.cache/aeb/jars"
    cached = "${cache_dir}/${sha256}.jar"
    if file.exists(cached) == 1 { return cached }
    _mk = build._sh("mkdir -p '${cache_dir}'")

    relpath = _pinned_relpath(coord)
    if string.length(relpath) == 0 { return "" }

    tmp = "${cache_dir}/.tmp-${sha256}.jar"
    _rm = build._sh("rm -f '${tmp}'")

    m2 = "${home}/.m2/repository/${relpath}"
    got = 0
    if file.exists(m2) == 1 {
        _cp = build._sh("cp '${m2}' '${tmp}'")
        got = 1
    }
    if got == 0 {
        // Try each declared repo in order (Maven Central by default). The
        // sha256 below verifies whatever any repo serves, so the repo list is
        // a pure reachability concern — list mirrors/proxies freely.
        repos = repos_nl
        if string.length(repos) == 0 { repos = "https://repo1.maven.org/maven2" }
        rparts = string.split(repos, "\n")
        nr = string.array_size(rparts)
        ri = 0
        while ri < nr {
            base = string.array_get(rparts, ri)
            if string.length(base) > 0 {
                url = "${base}/${relpath}"
                rc = build._sh("curl -fsSL '${url}' -o '${tmp}' 2>/dev/null")
                if rc == 0 { got = 1  ri = nr }
            }
            ri = ri + 1
        }
        string.array_free(rparts)
    }
    if got == 0 { return "" }

    actual_raw, _es = build._sh_capture("sha256sum '${tmp}' | cut -d' ' -f1")
    actual = string.trim(actual_raw)
    if string.equals(actual, sha256) == 0 {
        _rm2 = build._sh("rm -f '${tmp}'")
        return ""
    }
    _mv = build._sh("mv '${tmp}' '${cached}'")
    return cached
}

// jar_registry — declare a jar to fetch from Maven Central. Adds the coord
// to maven_deps for later resolution. Use jar_registry_finalize(b) as the final builder
// in a .jar.ae file to actually resolve and write the classpath artifact.
jar_registry(ctx: ptr, coord: string) {
    maven_deps, _ = map.get(ctx, "maven_deps")
    _e = list.add(maven_deps, coord)
}

// jar_registry_finalize — resolve all previously-declared jar_registry coords and write
// the jvm_classpath_deps_including_transitive artifact so downstream
// consumers pick up these jars on their classpath.
builder jar_registry_finalize(ctx: ptr) {
    target_dir = build._get(ctx, "target_dir")
    mod_dir = build._get(ctx, "module_dir")
    build._mkdirs(target_dir)

    cp = maven.resolve(ctx)
    if string.length(cp) == 0 {
        println("${mod_dir}: no maven deps resolved")
        build.fail(ctx, "no maven deps resolved")
        return 1
    }

    // Convert colon-separated to newline-separated for the classpath artifact
    cp_raw, _ecp = build._sh_capture("echo '${cp}' | tr ':' '\\n'")
    cp_nl = string.trim(cp_raw)
    build._write_artifact(ctx, "jvm_classpath_deps_including_transitive", cp_nl)
    println("${mod_dir}: fetched maven deps")
    return 0
}

// _jdk_version() — first line of `javac -version` (writes to stderr).
// Used as a cache-key input so a JDK upgrade invalidates every
// cached classes tree. Memoised for the build's duration via env
// var so we don't fork javac for every cache key.
_jdk_version() {
    cached = os.getenv("_AEB_JAVAC_VERSION_CACHE")
    if string.length(cached) > 0 { return cached }
    raw, _err = build._sh_capture("javac -version 2>&1 | head -1")
    return string.trim(raw)
}

// _read_classpath_files(builder_map, source_dir) — read every
// classpath_file(...) entry and join their contents into one
// `:`-separated classpath string. Each file holds a single line of
// `:`-separated jar paths (the `mvn dependency:build-classpath` shape).
// Trailing newline trimmed. Missing/unreadable file contributes nothing.
// Relative paths resolve against source_dir.
_read_classpath_files(builder_map: ptr, source_dir: string) {
    if builder_map == null { return "" }
    if map.has(builder_map, "classpath_file") == 0 { return "" }
    cfs, _ = map.get(builder_map, "classpath_file")
    n = list.size(cfs)
    out = ""
    i = 0
    while i < n {
        rel, _ = list.get(cfs, i)
        p = rel
        if string.length(rel) > 0 {
            first = string.substring(rel, 0, 1)
            if string.equals(first, "/") == 0 {
                p = path.join(source_dir, rel)
            }
        }
        if file.exists(p) == 1 {
            raw, _e = io.read_file(p)
            piece = string.trim(raw)
            out = build._cp_append(out, piece)
        }
        i = i + 1
    }
    return out
}

// _discover_jvm_root() — the directory holding side-by-side JDKs. Linux:
// /usr/lib/jvm. macOS: /Library/Java/JavaVirtualMachines (homes nested
// under <entry>/Contents/Home). Returns the root, or "" if none exists.
_discover_jvm_root() {
    if dir.exists("/usr/lib/jvm") == 1 { return "/usr/lib/jvm" }
    if dir.exists("/Library/Java/JavaVirtualMachines") == 1 {
        return "/Library/Java/JavaVirtualMachines"
    }
    return ""
}

// _installed_jvm_majors(jvm_root) — newline-separated major versions of
// the JDKs under jvm_root, for the not-found diagnostic. Best-effort.
_installed_jvm_majors(jvm_root: string) {
    if string.length(jvm_root) == 0 { return "" }
    out, _e = build._sh_capture("ls -1 '${jvm_root}' 2>/dev/null")
    majors = ""
    rest = string.trim(out)
    name = ""
    while string.length(rest) > 0 {
        nl = string.index_of(rest, "\n")
        if nl < 0 {
            name = rest
            rest = ""
        } else {
            name = string.substring(rest, 0, nl)
            rest = string.substring(rest, nl + 1, string.length(rest))
        }
        m = build._jvm_dir_major(string.trim(name))
        if string.length(m) > 0 {
            if string.length(majors) > 0 { majors = string.concat(majors, "\n") }
            majors = string.concat(majors, m)
        }
    }
    return majors
}

// _resolve_jdk_home(want) — discover-select-or-fail. Returns the selected
// JDK home (a directory containing bin/javac), or "" if none matches —
// the caller hard-fails with build._toolchain_not_found_msg. Honours a
// macOS Contents/Home nesting. An empty `want` means "no selection" → "".
_resolve_jdk_home(want: string) {
    if string.length(want) == 0 { return "" }
    root = _discover_jvm_root()
    if string.length(root) == 0 { return "" }
    listing_raw, _e = build._sh_capture("ls -1 '${root}' 2>/dev/null")
    home = build._select_jvm_home(root, string.trim(listing_raw), want)
    if string.length(home) == 0 { return "" }
    // macOS: the real home is <entry>/Contents/Home.
    mac_home = path.join(home, "Contents/Home")
    if dir.exists(mac_home) == 1 { return mac_home }
    return home
}

// _javac_bin_for(want, builder_map) — resolve the javac path to run.
// Returns the absolute "<home>/bin/javac" when select_jdk is set and a
// match is found; "javac" (PATH) when no selection; and "" (with a hint
// already printed) when a selection was requested but unsatisfiable.
// Memoises the resolved home onto the builder map under "_selected_jdk_home"
// so the cache key and any sibling java invocation reuse it.
_javac_bin_for(want: string, builder_map: ptr) {
    if string.length(want) == 0 { return "javac" }
    home = _resolve_jdk_home(want)
    if string.length(home) == 0 {
        root = _discover_jvm_root()
        found = _installed_jvm_majors(root)
        println(build._toolchain_not_found_msg("jdk", want, found))
        return ""
    }
    if builder_map != null {
        _e = map.put(builder_map, "_selected_jdk_home", home)
    }
    return path.join(home, "bin/javac")
}

// Compute the cache key for a javac compile action. Inputs in
// canonical order; each part length-prefixed via cache.hash_inputs
// so distinct concatenations can't collide.
//
// Inputs that go into the hash (the contract):
//   - JDK version (`javac -version`) — toolchain-bump invalidator
//   - canonical javac command string — captures flags, classpath
//     paths, processor paths, encoding, lint level, etc.
//   - each .java source's path + content hash, sorted by path
//   - hashes of every dep target's jvm_classpath_deps_including_transitive
//     artifact file content — captures upstream rebuilds
//
// What's NOT in the hash:
//   - The maven jar file contents themselves (paths are stable per
//     version coordinate; a real version change shows up in the
//     classpath string)
//   - generated_sources directory (annotation processors mutate it
//     as a side effect; not a primary input)
//   - target_dir / mod_dir (cosmetic / destination)
//
// FALSE-HIT HAZARD: if a sibling dep target's local classes/ tree
// changes content but its classpath string stays the same (e.g.
// rebuilt with same source-set), this key won't reflect the
// change and we'd hit a stale cache. Mitigation today is the dep
// artifact content hash above, which catches most real changes
// because aeb writes that artifact every rebuild. Full correctness
// would require walking each upstream target's classes tree;
// punted for v1 (matches Nx-class hermeticity, livable).
//
// Returns ("", err) on read failure of any source — caller falls
// through to live build.
_cache_key_for_javac(ctx: ptr, builder_map: ptr, argfile_path: string, javac_cmd_str: string) {
    parts = list.new()

    // Toolchain version. When select_jdk(...) resolved a specific JDK
    // home, probe THAT javac's version (and key on the home path) so the
    // cache correctly distinguishes a selected JDK from PATH's javac —
    // otherwise the key would claim PATH's version while compiling with a
    // different one.
    jdk_ver = _jdk_version()
    if builder_map != null {
        if map.has(builder_map, "_selected_jdk_home") == 1 {
            sel_home, _ = map.get(builder_map, "_selected_jdk_home")
            sel_javac = path.join(sel_home, "bin/javac")
            jv_raw, _jverr = build._sh_capture("'${sel_javac}' -version 2>&1 | head -1")
            jdk_ver = string.concat(string.concat(sel_home, "|"), string.trim(jv_raw))
        }
    }
    list.add(parts, string.concat("javac:", jdk_ver))

    // The canonical command string captures every flag and
    // classpath path. This is the action discriminator.
    list.add(parts, string.concat("cmd:", javac_cmd_str))

    // Each .java source's path + content hash, in sorted order.
    sources = build._read_argfile_lines(argfile_path)
    nsrc = list.size(sources)
    si = 0
    while si < nsrc {
        src, _ = list.get(sources, si)
        sh, serr = cache.hash_file(src)
        if string.length(serr) > 0 {
            return "", serr
        }
        list.add(parts, string.concat("src:", src))
        list.add(parts, string.concat("src-hash:", sh))
        si = si + 1
    }

    // Each dep's classpath artifact content (captures upstream
    // rebuilds via the artifact's content, not just its path).
    deps, _ = map.get(ctx, "deps")
    dn = list.size(deps)
    di = 0
    while di < dn {
        dp, _ = list.get(deps, di)
        dm = build._strip_lang(dp)
        dep_cp = build._read_dep_artifact(ctx, dm, "jvm_classpath_deps_including_transitive")
        if string.length(dep_cp) > 0 {
            list.add(parts, string.concat("dep:", dm))
            list.add(parts, string.concat("dep-cp:", dep_cp))
        }
        di = di + 1
    }

    digest, derr = cache.hash_inputs(parts)
    return digest, derr
}

builder javac(ctx: ptr) {
    source_dir = build._get(ctx, "source_dir")
    target_dir = build._get(ctx, "target_dir")
    mod_name = build._get(ctx, "module")
    mod_dir = build._get(ctx, "module_dir")

    classes_dir = path.join(target_dir, "classes")
    build._mkdirs(classes_dir)
    ts_dir = path.join(classes_dir, mod_name)
    build._mkdirs(ts_dir)
    ts_file = path.join(ts_dir, ".timestamp")

    println("${mod_dir}: compiling prod code")

    // Build classpath: dep modules + maven deps + pre-resolved file(s)
    dep_cp = build._build_dep_classpath(ctx)
    maven_cp = maven.classpath(ctx)
    file_cp = _read_classpath_files(_builder, source_dir)
    classpath = classes_dir
    classpath = build._cp_append(classpath, dep_cp)
    classpath = build._cp_append(classpath, maven_cp)
    classpath = build._cp_append(classpath, file_cp)

    // Create generated sources dir if requested (for annotation processors like QueryDSL)
    if map.has(_builder, "generated_sources") == 1 {
        gen_dir, _ = map.get(_builder, "generated_sources")
        build._mkdirs(gen_dir)
    }

    // Write source file list to an argfile (avoids command-line length limits)
    argfile = path.join(target_dir, "javac_sources.txt")
    if map.has(_builder, "source_layout") == 1 {
        layout, _ = map.get(_builder, "source_layout")
        if layout == "maven idiomatic" {
            src_root = path.join(source_dir, "src/main/java")
            build._sh("find '${src_root}' -name '*.java' > '${argfile}' 2>/dev/null || true")
        }
    } else {
        build._sh("find '${source_dir}' -maxdepth 1 -name '*.java' > '${argfile}' 2>/dev/null || true")
    }

    af_raw, _eaf = io.read_file(argfile)
    argfile_content = string.trim(af_raw)
    if string.length(argfile_content) == 0 {
        println("${mod_dir}: no Java source files found")
        return 0
    }

    // JPMS: if the source set carries a module-info.java, this is a modular
    // compile — resolved deps must go on --module-path (not -cp) or the
    // module's `requires` won't resolve. Auto-detect so build files needn't
    // opt in. no_module_info() opts out: drop module-info.java and compile
    // classpath-mode. (Modifies argfile before the cache key hashes it.)
    mi_cnt_raw, _emi = build._sh_capture("grep -c 'module-info\\.java' '${argfile}' 2>/dev/null || echo 0")
    if string.equals(string.trim(mi_cnt_raw), "0") == 0 {
        if map.has(_builder, "no_module_info") == 1 {
            println("${mod_dir}: no_module_info — compiling module-info-less (classpath mode)")
            build._sh("grep -v 'module-info\\.java' '${argfile}' > '${argfile}.tmp' && mv '${argfile}.tmp' '${argfile}'")
        } else {
            println("${mod_dir}: module-info.java present — modular compile (deps on --module-path)")
            _emm = map.put(_builder, "modular", "1")
        }
    }

    file_ref = string.concat("@", argfile)

    // Auto-set processorpath to maven classpath for annotation processor discovery
    if string.length(maven_cp) > 0 {
        if map.has(_builder, "processor_path") == 0 {
            _e = map.put(_builder, "processor_path", maven_cp)
        }
    }

    // Resolve the javac binary: select_jdk(...) picks among installed JDKs
    // (discover-select-or-fail); absent it, PATH's javac. "" means a
    // selection was requested but no installed JDK matched — hard-fail
    // (the helper already printed the actionable not-found message).
    want_jdk = ""
    if map.has(_builder, "select_jdk") == 1 {
        want_jdk, _ = map.get(_builder, "select_jdk")
    }
    javac_bin = _javac_bin_for(want_jdk, _builder)
    if string.length(javac_bin) == 0 {
        build.fail(ctx, "no matching JDK found")
        return 1
    }
    _e = map.put(_builder, "_javac_bin", javac_bin)

    cmd = javac_cmd(classes_dir, classpath, file_ref, _builder)

    // Cache check: hash sources + classpath + flags + JDK version,
    // restore the classes/ tarball on hit and skip javac entirely.
    // Best-effort: any error computing the key (unreadable source,
    // hashing failure) falls through to the live javac path.
    //
    // exit_code is the "what happens next" sentinel:
    //   0  → cache supplied the artifact, skip the live javac
    //   -1 → cache didn't apply (unavailable, miss, untar failure),
    //        live javac will run below
    cache_key = ""
    exit_code = -1
    if cache.available() == 1 {
        ck, kerr = _cache_key_for_javac(ctx, _builder, argfile, cmd)
        if string.length(kerr) == 0 {
            cache_key = ck
            tmp_raw, _terr = build._sh_capture("mktemp")
            tmp_tar = build._to_native_path(string.trim(tmp_raw))
            if string.length(tmp_tar) > 0 {
                grc = cache.get(cache_key, tmp_tar)
                if string.length(grc) == 0 {
                    uerr = build._untar_into(tmp_tar, classes_dir)
                    build._sh("rm -f '${tmp_tar}'")
                    if string.length(uerr) == 0 {
                        println("${mod_dir}: javac cache hit ${cache_key}")
                        build._record_cache(ctx, "hit")
                        exit_code = 0
                    } else {
                        // Untar failed — clean up and fall through.
                        build._sh("rm -rf '${classes_dir}'")
                        build._mkdirs(classes_dir)
                        build._mkdirs(ts_dir)
                    }
                } else {
                    build._sh("rm -f '${tmp_tar}'")
                }
            }
        }
    }

    if exit_code == -1 {
        if cache.available() == 0 {
            build._record_cache(ctx, "unavailable")
        } else {
            build._record_cache(ctx, "miss")
        }
        exit_code = build._sh(cmd)
        if exit_code != 0 {
            println("${mod_dir}: javac failed")
            build.fail(ctx, "javac failed")
            return exit_code
        }
        // Populate the cache with the freshly-compiled tree. Best-effort.
        if string.length(cache_key) > 0 {
            tar_path, terr = build._tar_dir(classes_dir)
            if string.length(terr) == 0 {
                perr = cache.put(cache_key, tar_path)
                build._sh("rm -f '${tar_path}'")
                if string.length(perr) > 0 {
                    println("${mod_dir}: javac cache write failed: ${perr}")
                }
            }
        }
    }

    // Copy src/main/resources onto the classpath (into classes_dir) so
    // classloader lookups (getResource/getResourceAsStream) resolve — the
    // Maven resources-plugin equivalent. Maven-idiomatic layout only; runs
    // every build (cheap, outside the class cache) so resource edits are
    // always reflected.
    if map.has(_builder, "source_layout") == 1 {
        _rlayout, _ = map.get(_builder, "source_layout")
        if string.equals(_rlayout, "maven idiomatic") == 1 {
            main_res = path.join(source_dir, "src/main/resources")
            build._sh("[ -d '${main_res}' ] && cp -R '${main_res}/.' '${classes_dir}/' 2>/dev/null || true")
        }
    }

    // Write classpath artifact (classes dir + dep classpath + maven classpath)
    cp_out = classes_dir
    if string.length(dep_cp) > 0 {
        tmp2 = string.concat(cp_out, "\n")
        cp_out = string.concat(tmp2, dep_cp)
    }
    if string.length(maven_cp) > 0 {
        tmp3 = string.concat(cp_out, "\n")
        cp_out = string.concat(tmp3, maven_cp)
    }
    if string.length(file_cp) > 0 {
        tmp4 = string.concat(cp_out, "\n")
        cp_out = string.concat(tmp4, file_cp)
    }
    build._write_artifact(ctx, "jvm_classpath_deps_including_transitive", cp_out)

    // Collect ldlibdeps and shared_library_deps from all deps
    deps, _ = map.get(ctx, "deps")
    dep_count = list.size(deps)
    ld_out = ""
    shared_out = ""
    k = 0
    while k < dep_count {
        dp2, _ = list.get(deps, k)
        dm2 = build._strip_lang(dp2)
        dep_ld = build._read_dep_artifact(ctx, dm2, "ldlibdeps")
        if string.length(dep_ld) > 0 {
            if string.length(ld_out) > 0 {
                ld_out = string.concat(string.concat(ld_out, "\n"), dep_ld)
            } else {
                ld_out = dep_ld
            }
        }
        dep_sh = build._read_dep_artifact(ctx, dm2, "shared_library_deps_including_transitive")
        if string.length(dep_sh) > 0 {
            if string.length(shared_out) > 0 {
                shared_out = string.concat(string.concat(shared_out, "\n"), dep_sh)
            } else {
                shared_out = dep_sh
            }
        }
        k = k + 1
    }
    build._write_artifact(ctx, "ldlibdeps", ld_out)
    build._write_artifact(ctx, "shared_library_deps_including_transitive", shared_out)
    _ew = io.write_file(ts_file, "")

    return 0
}

builder javac_test(ctx: ptr) {
    source_dir = build._get(ctx, "source_dir")
    target_dir = build._get(ctx, "target_dir")
    mod_name = build._get(ctx, "module")
    mod_dir = build._get(ctx, "module_dir")

    test_classes = path.join(target_dir, "test-classes")
    build._mkdirs(test_classes)
    ts_dir = path.join(test_classes, mod_name)
    build._mkdirs(ts_dir)
    ts_file = path.join(ts_dir, ".timestamp")

    println("${mod_dir}: compiling test code")

    dep_cp = build._build_dep_classpath(ctx)
    lib_cp = build._build_lib_classpath(ctx)
    maven_cp = maven.classpath(ctx)
    classpath = test_classes
    classpath = build._cp_append(classpath, dep_cp)
    classpath = build._cp_append(classpath, lib_cp)
    classpath = build._cp_append(classpath, maven_cp)

    // Write source file list to an argfile (avoids command-line length limits)
    argfile = path.join(target_dir, "javac_test_sources.txt")
    if map.has(_builder, "source_layout") == 1 {
        layout, _ = map.get(_builder, "source_layout")
        if layout == "maven idiomatic" {
            src_root = path.join(source_dir, "src/test/java")
            build._sh("find '${src_root}' -name '*.java' > '${argfile}' 2>/dev/null || true")
        }
    } else {
        build._sh("find '${source_dir}' -maxdepth 1 -name '*.java' > '${argfile}' 2>/dev/null || true")
    }

    af_raw, _eaf = io.read_file(argfile)
    argfile_content = string.trim(af_raw)
    if string.length(argfile_content) == 0 {
        println("${mod_dir}: no test source files found")
        return 0
    }

    file_ref = string.concat("@", argfile)

    // Auto-set processorpath for annotation processor discovery
    if string.length(maven_cp) > 0 {
        if map.has(_builder, "processor_path") == 0 {
            _e = map.put(_builder, "processor_path", maven_cp)
        }
    }

    cmd = javac_cmd(test_classes, classpath, file_ref, _builder)

    // Cache check: same pattern as builder javac. Tarballs the
    // test-classes/ tree on miss + put; restores on hit + skip.
    cache_key = ""
    exit_code = -1
    if cache.available() == 1 {
        ck, kerr = _cache_key_for_javac(ctx, _builder, argfile, cmd)
        if string.length(kerr) == 0 {
            cache_key = ck
            tmp_raw, _terr = build._sh_capture("mktemp")
            tmp_tar = build._to_native_path(string.trim(tmp_raw))
            if string.length(tmp_tar) > 0 {
                grc = cache.get(cache_key, tmp_tar)
                if string.length(grc) == 0 {
                    uerr = build._untar_into(tmp_tar, test_classes)
                    build._sh("rm -f '${tmp_tar}'")
                    if string.length(uerr) == 0 {
                        println("${mod_dir}: javac-test cache hit ${cache_key}")
                        build._record_cache(ctx, "hit")
                        exit_code = 0
                    } else {
                        build._sh("rm -rf '${test_classes}'")
                        build._mkdirs(test_classes)
                        build._mkdirs(ts_dir)
                    }
                } else {
                    build._sh("rm -f '${tmp_tar}'")
                }
            }
        }
    }

    if exit_code == -1 {
        if cache.available() == 0 {
            build._record_cache(ctx, "unavailable")
        } else {
            build._record_cache(ctx, "miss")
        }
        exit_code = build._sh(cmd)
        if exit_code != 0 {
            println("${mod_dir}: javac (test) failed")
            build.fail(ctx, "javac (test) failed")
            return exit_code
        }
        if string.length(cache_key) > 0 {
            tar_path, terr = build._tar_dir(test_classes)
            if string.length(terr) == 0 {
                perr = cache.put(cache_key, tar_path)
                build._sh("rm -f '${tar_path}'")
                if string.length(perr) > 0 {
                    println("${mod_dir}: javac-test cache write failed: ${perr}")
                }
            }
        }
    }

    // Copy src/test/resources onto the test classpath (into test-classes) so
    // classloader lookups in tests resolve — SSL certs, config, fixtures.
    // Maven test-resources equivalent; maven-idiomatic layout only; every
    // build (outside the class cache).
    if map.has(_builder, "source_layout") == 1 {
        _trlayout, _ = map.get(_builder, "source_layout")
        if string.equals(_trlayout, "maven idiomatic") == 1 {
            test_res = path.join(source_dir, "src/test/resources")
            build._sh("[ -d '${test_res}' ] && cp -R '${test_res}/.' '${test_classes}/' 2>/dev/null || true")
        }
    }

    _ew = io.write_file(ts_file, "")
    return 0
}

builder junit(ctx: ptr) {
    target_dir = build._get(ctx, "target_dir")
    mod_dir = build._get(ctx, "module_dir")

    test_classes = path.join(target_dir, "test-classes")

    dep_cp = build._build_dep_classpath(ctx)
    lib_cp = build._build_lib_classpath(ctx)
    classpath = test_classes
    classpath = build._cp_append(classpath, dep_cp)
    classpath = build._cp_append(classpath, lib_cp)

    tc_pat = path.join(test_classes, "**/*Test.class")
    test_files, _egl1 = fs.glob(tc_pat)
    // Also match *Tests.class (plural)
    tc_pat2 = path.join(test_classes, "**/*Tests.class")
    test_files2, _egl2 = fs.glob(tc_pat2)
    // If the first glob found nothing, use the second
    if dir_list_count(test_files) == 0 {
        dir_list_free(test_files)
        test_files = test_files2
    } else {
        dir_list_free(test_files2)
    }
    tcount = dir_list_count(test_files)
    if tcount == 0 {
        println("${mod_dir}: no test classes found")
        dir_list_free(test_files)
        return 0
    }

    prefix_len = string.length(test_classes) + 1
    class_names = ""
    j = 0
    while j < tcount {
        tf = dir_list_get(test_files, j)
        tflen = string.length(tf)
        class_path = string.substring(tf, prefix_len, tflen - 6)
        raw, _er = build._sh_capture("echo ${class_path} | sed s,/,.,g")
        class_name = string.trim(raw)
        if j == 0 {
            class_names = class_name
        } else {
            sp = string.concat(class_names, " ")
            class_names = string.concat(sp, class_name)
        }
        j = j + 1
    }
    dir_list_free(test_files)

    // Build LD_LIBRARY_PATH from deps' ldlibdeps
    deps, _ = map.get(ctx, "deps")
    ndeps = list.size(deps)
    ld_path = ""
    m = 0
    while m < ndeps {
        dp3, _ = list.get(deps, m)
        dm3 = build._strip_lang(dp3)
        dep_ld = build._read_dep_artifact(ctx, dm3, "ldlibdeps")
        if string.length(dep_ld) > 0 {
            ld_raw, _eld = build._sh_capture("echo '${dep_ld}' | while read -r line; do [ -n \"$line\" ] && dirname \"$line\"; done | sort -u | tr '\n' ':' | sed 's/:$//'")
            ld_dirs = string.trim(ld_raw)
            if string.length(ld_dirs) > 0 {
                if string.length(ld_path) > 0 {
                    ld_path = string.concat(string.concat(ld_path, ":"), ld_dirs)
                } else {
                    ld_path = ld_dirs
                }
            }
        }
        m = m + 1
    }

    println("${mod_dir}: running tests")
    cmd = junit_cmd(classpath, class_names, ld_path, _builder)
    // Tee to target/<module>/test_output.log — durable record for
    // failure diagnosis post-build, also feeds the summary parser.
    // JUnit 4's JUnitCore prints "OK (N tests)" on success or
    // "Tests run: N,  Failures: F" on failure.
    build._mkdirs(target_dir)
    out_path = path.join(target_dir, "test_output.log")
    full_cmd = string.concat(string.concat(cmd, " 2>&1 | tee "), out_path)
    exit_code = build._sh(full_cmd)
    out_text, _orerr = fs.read(out_path)
    p4, f4 = _parse_junit4_counts(out_text)
    build._record_test_result(ctx, p4, f4)
    if exit_code != 0 {
        println("${mod_dir}: tests FAILED")
        build.fail(ctx, "tests FAILED")
        return exit_code
    }
    println("${mod_dir}: tests PASSED")
    return 0
}

// _parse_junit4_counts(output) — extract (passed, failed) from
// JUnitCore's stdout. Two formats:
//   "OK (15 tests)"               → (15, 0)
//   "Tests run: 15,  Failures: 1" → (14, 1)
// Pure: just string parsing.
_parse_junit4_counts(output: string) {
    ok_idx = string.index_of(output, "OK (")
    if ok_idx >= 0 {
        n_start = ok_idx + 4
        n = string.length(output)
        n_end = n_start
        done = 0
        while done == 0 {
            if n_end >= n {
                done = 1
            } else {
                c = string.substring(output, n_end, n_end + 1)
                if string.equals(c, " ") == 1 {
                    done = 1
                } else {
                    n_end = n_end + 1
                }
            }
        }
        ns = string.substring(output, n_start, n_end)
        v, _e = string.to_int(string.trim(ns))
        return v, 0
    }
    run_idx = string.index_of(output, "Tests run: ")
    if run_idx < 0 { return 0, 0 }
    run_start = run_idx + 11
    n = string.length(output)
    run_end = run_start
    done2 = 0
    while done2 == 0 {
        if run_end >= n {
            done2 = 1
        } else {
            c = string.substring(output, run_end, run_end + 1)
            if string.equals(c, ",") == 1 {
                done2 = 1
            } else {
                run_end = run_end + 1
            }
        }
    }
    total_str = string.substring(output, run_start, run_end)
    total, _e1 = string.to_int(string.trim(total_str))
    fail_idx = string.index_of(output, "Failures: ")
    failures = 0
    if fail_idx >= 0 {
        f_start = fail_idx + 10
        f_end = f_start
        done3 = 0
        while done3 == 0 {
            if f_end >= n {
                done3 = 1
            } else {
                c = string.substring(output, f_end, f_end + 1)
                if string.equals(c, " ") == 1 {
                    done3 = 1
                } else {
                    if string.equals(c, "\n") == 1 {
                        done3 = 1
                    } else {
                        f_end = f_end + 1
                    }
                }
            }
        }
        fs_str = string.substring(output, f_start, f_end)
        failures, _e2 = string.to_int(string.trim(fs_str))
    }
    passed = total - failures
    if passed < 0 { passed = 0 }
    return passed, failures
}

// --- JUnit 5 (Jupiter) ---

junit5_cmd(classpath: string, test_classes_dir: string, ld_path: string, opts: ptr) {
    // Wrap with timeout to prevent hanging on missing external services
    timeout_secs = "60"
    if opts != null {
        if map.has(opts, "test_timeout") == 1 {
            timeout_secs, _ = map.get(opts, "test_timeout")
        }
    }
    cmd = "timeout ${timeout_secs}"

    // Detect podman socket for TestContainers support
    if string.length(ld_path) > 0 {
        dyld_var = build._dyld_env_var()
        cmd = string.concat(cmd, " env ${dyld_var}=${ld_path} java")
        cmd = string.concat(cmd, " -Djava.library.path=${ld_path}")
    } else {
        cmd = string.concat(cmd, " java")
    }
    cmd = string.concat(cmd, " -Dtestcontainers.ryuk.disabled=true")

    if opts != null {
        if map.has(opts, "jvm_args") == 1 {
            val, _ = map.get(opts, "jvm_args")
            cmd = string.concat(cmd, " ${val}")
        }
        if map.has(opts, "extra") == 1 {
            val, _ = map.get(opts, "extra")
            cmd = string.concat(cmd, " ${val}")
        }
    }

    if opts != null {
        if map.has(opts, "enable_preview") == 1 {
            cmd = string.concat(cmd, " --enable-preview")
        }
    }

    cmd = string.concat(cmd, " -cp ${classpath}")
    cmd = string.concat(cmd, " org.junit.platform.console.ConsoleLauncher")
    cmd = string.concat(cmd, " execute")
    cmd = string.concat(cmd, " --scan-classpath=${test_classes_dir}")
    cmd = string.concat(cmd, " --fail-if-no-tests")
    return cmd
}

builder junit5(ctx: ptr) {
    target_dir = build._get(ctx, "target_dir")
    mod_dir = build._get(ctx, "module_dir")

    test_classes = path.join(target_dir, "test-classes")

    dep_cp = build._build_dep_classpath(ctx)
    lib_cp = build._build_lib_classpath(ctx)
    maven_cp = maven.classpath(ctx)
    classpath = test_classes
    classpath = build._cp_append(classpath, dep_cp)
    classpath = build._cp_append(classpath, lib_cp)
    classpath = build._cp_append(classpath, maven_cp)

    // Build LD_LIBRARY_PATH from deps' ldlibdeps
    deps, _ = map.get(ctx, "deps")
    ndeps = list.size(deps)
    ld_path = ""
    m = 0
    while m < ndeps {
        dp3, _ = list.get(deps, m)
        dm3 = build._strip_lang(dp3)
        dep_ld = build._read_dep_artifact(ctx, dm3, "ldlibdeps")
        if string.length(dep_ld) > 0 {
            ld_raw, _eld = build._sh_capture("echo '${dep_ld}' | while read -r line; do [ -n \"$line\" ] && dirname \"$line\"; done | sort -u | tr '\n' ':' | sed 's/:$//'")
            ld_dirs = string.trim(ld_raw)
            if string.length(ld_dirs) > 0 {
                if string.length(ld_path) > 0 {
                    ld_path = string.concat(string.concat(ld_path, ":"), ld_dirs)
                } else {
                    ld_path = ld_dirs
                }
            }
        }
        m = m + 1
    }

    println("${mod_dir}: running tests (JUnit 5)")
    cmd = junit5_cmd(classpath, test_classes, ld_path, _builder)
    // Run from the module's source dir (like surefire) so tests that resolve
    // relative resource/file paths (e.g. src/test/resources/...) find them.
    // Tee to target/<module>/test_output.log for the summary parser + a
    // durable post-build record. Capture the runner's REAL exit via an rc
    // file — a bare `cmd | tee` reports tee's exit (always 0), masking
    // failures. Honors env(K,V) via the export prefix.
    build._mkdirs(target_dir)
    source_dir = build._get(ctx, "source_dir")
    out_path = path.join(target_dir, "test_output.log")
    rc_file = path.join(target_dir, "test_exit.rc")
    inner = "cd \"${source_dir}\" && ( ${cmd} 2>&1; echo $? > \"${rc_file}\" ) | tee \"${out_path}\""
    full_cmd = string.concat(build._env_export_prefix(_builder), inner)
    _ig = build._sh(full_cmd)
    rc_txt, _rcerr = io.read_file(rc_file)
    exit_code, _ec = string.to_int(string.trim(rc_txt))
    out_text, _orerr = fs.read(out_path)
    if exit_code == 124 {
        build._record_test_result(ctx, 0, 1)
        println("${mod_dir}: tests TIMEOUT (killed after timeout)")
        build.fail(ctx, "tests TIMEOUT")
        return exit_code
    }
    // Parse the summary table. Lines look like:
    //   [        14 tests successful      ]
    //   [         1 tests failed          ]
    passed_n = _parse_junit5_count(out_text, "tests successful")
    failed_n = _parse_junit5_count(out_text, "tests failed")
    build._record_test_result(ctx, passed_n, failed_n)
    if exit_code != 0 {
        println("${mod_dir}: tests FAILED")
        build.fail(ctx, "tests FAILED")
        return exit_code
    }
    println("${mod_dir}: tests PASSED")
    return 0
}

// _parse_junit5_count(output, marker) — find the first line of
// `output` containing `marker` (e.g. "tests successful"), extract
// the leading integer between `[` and the marker. Returns 0 if
// the marker isn't found or no integer parses cleanly.
//
// junit-platform-console-standalone formats counts as:
//     [        14 tests successful      ]
// We find the marker, find the most recent '[' before it, scan
// forward past whitespace to find the integer. Pure: just string
// parsing. Tested in tests/test_junit5_parse.ae.
_parse_junit5_count(output: string, marker: string) {
    idx = string.index_of(output, marker)
    if idx < 0 { return 0 }
    // Walk left from idx to the most recent '[' that opens this line.
    bracket = -1
    i = idx
    found_bracket = 0
    while found_bracket == 0 {
        if i <= 0 {
            found_bracket = 1
        } else {
            if string.equals(string.substring(output, i - 1, i), "[") == 1 {
                bracket = i
                found_bracket = 1
            } else {
                i = i - 1
            }
        }
    }
    if bracket < 0 { return 0 }
    // Skip whitespace after '[' to find the leading integer.
    digit_start = -1
    p = bracket
    found_start = 0
    while found_start == 0 {
        if p >= idx {
            found_start = 1
        } else {
            c = string.substring(output, p, p + 1)
            if string.equals(c, " ") == 0 {
                digit_start = p
                found_start = 1
            } else {
                p = p + 1
            }
        }
    }
    if digit_start < 0 { return 0 }
    // Walk forward to the end of the digit run.
    digit_end = digit_start
    found_end = 0
    while found_end == 0 {
        if digit_end >= idx {
            found_end = 1
        } else {
            c = string.substring(output, digit_end, digit_end + 1)
            if string.equals(c, " ") == 1 {
                found_end = 1
            } else {
                digit_end = digit_end + 1
            }
        }
    }
    num_str = string.substring(output, digit_start, digit_end)
    val, _err = string.to_int(string.trim(num_str))
    return val
}

// Build a fat jar from this module's classes + all transitive deps + native libs.
//
// Staging-dir approach (same shape as scala.assembly / clojure.uberjar):
// extract every dep .jar and copy every class dir into a staging tree,
// drop native .so files at the tree root (so `-Djava.library.path=.`
// finds them), write the manifest, then `jar cfM` the staging tree.
//
// Why not the older `jar -C <entry> .` per classpath entry: the
// classpath artifact is a mix of newline- and colon-separated entries
// and contains both class directories AND .jar files. `jar -C` only
// works on directories (you can't -C into a .jar), and the per-entry
// echo emitted embedded newlines that split the jar command into
// separate shell lines (`sh: -C: not found`). Staging sidesteps both.
shade(ctx: ptr, main_class: string, jar_name: string) {
    target_dir = build._get(ctx, "target_dir")
    mod_dir = build._get(ctx, "module_dir")

    bin_dir = path.join(target_dir, "bin")
    build._mkdirs(bin_dir)
    jar_path = path.join(bin_dir, jar_name)

    // A .dist.ae node's own target_dir is target/dist/<mod> — the compiled
    // classes and the classpath/ldlib artifact files live under the compile
    // node's target/build/<mod> instead. Read them across the dep() edge via
    // the artifact contract (same idiom as javac's ldlibdeps collection), NOT
    // from this node's own target_dir. The build node's
    // jvm_classpath_deps_including_transitive lists its own classes dir first
    // plus every transitive dep classes dir/jar, so staging from it captures
    // the module's own classes too — no separate classes_dir copy needed.
    deps, _ = map.get(ctx, "deps")
    dep_count = list.size(deps)
    cp_content = ""
    ld_content = ""
    di = 0
    while di < dep_count {
        dpx, _ = list.get(deps, di)
        dmx = build._strip_lang(dpx)
        dep_cp = build._read_dep_artifact(ctx, dmx, "jvm_classpath_deps_including_transitive")
        if string.length(dep_cp) > 0 {
            if string.length(cp_content) > 0 {
                cp_content = string.concat(string.concat(cp_content, "\n"), dep_cp)
            } else {
                cp_content = dep_cp
            }
        }
        dep_ld = build._read_dep_artifact(ctx, dmx, "ldlibdeps")
        if string.length(dep_ld) > 0 {
            if string.length(ld_content) > 0 {
                ld_content = string.concat(string.concat(ld_content, "\n"), dep_ld)
            } else {
                ld_content = dep_ld
            }
        }
        di = di + 1
    }

    println("${mod_dir}: packaging ${jar_name}")

    stage_dir = path.join(target_dir, "_shade")

    // Build a single shell script. Shell loop vars use bare `$e` /
    // `$st` (no braces) so Aether's ${...} interpolation leaves them
    // alone; Aether vars are spliced via interpolation. cp_content and
    // ld_content are newline+colon-separated path lists; `tr ':' '\n'`
    // normalises to one entry per line.
    sh = "set -e; st='${stage_dir}'; rm -rf \"$st\"; mkdir -p \"$st\"; "
    // Classpath deps (includes this module's OWN classes dir as the first
    // entry of its build node's classpath artifact): extract .jar entries,
    // copy class dirs.
    if string.length(cp_content) > 0 {
        sh = string.concat(sh, "printf '%s\\n' '")
        sh = string.concat(sh, cp_content)
        sh = string.concat(sh, "' | tr ':' '")
        sh = string.concat(sh, "\\n")
        sh = string.concat(sh, "' | while IFS= read -r e; do [ -z \"$e\" ] && continue; case \"$e\" in *.jar) [ -f \"$e\" ] && unzip -qq -o \"$e\" -d \"$st\" >/dev/null 2>&1 ;; *) [ -d \"$e\" ] && cp -a \"$e/.\" \"$st\"/ 2>/dev/null ;; esac; done; ")
    }
    // Native libs at the jar root.
    if string.length(ld_content) > 0 {
        sh = string.concat(sh, "printf '%s\\n' '")
        sh = string.concat(sh, ld_content)
        sh = string.concat(sh, "' | while IFS= read -r e; do [ -z \"$e\" ] && continue; [ -f \"$e\" ] && cp -f \"$e\" \"$st\"/; done; ")
    }
    // Manifest (stage wins over any META-INF copied from classes).
    sh = string.concat(sh, "mkdir -p \"$st/META-INF\"; printf 'Manifest-Version: 1.0")
    sh = string.concat(sh, "\\n")
    sh = string.concat(sh, "Main-Class: ${main_class}")
    sh = string.concat(sh, "\\n")
    sh = string.concat(sh, "' > \"$st/META-INF/MANIFEST.MF\"; ")
    // Package.
    sh = string.concat(sh, "jar cfM '${jar_path}' -C \"$st\" .")

    exit_code = build._sh(sh)
    if exit_code != 0 {
        println("${mod_dir}: jar packaging failed")
        return exit_code
    }

    println("${mod_dir}: built ${jar_path}")
    println("  run: java -Djava.library.path=. -jar ${jar_path}")
    return 0
}
