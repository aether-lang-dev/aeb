// python — Python SDK for aether.build
//
// Creates a venv in .aeb/venv/, installs pip deps, runs tests via pytest,
// lints via ruff, type-checks via mypy, and packages via build+twine.
//
// CONTENT-ADDRESSED CACHE — deliberately NOT wired (unlike java, kotlin,
// scala, ts, dotnet, go, rust, clojure). Python has no compile step that
// produces a durable, content-addressable artifact worth caching:
//   - `install` produces a venv: thousands of files with absolute-path
//     shebangs and machine-specific compiled .pyc — not portable, huge to
//     tar, and pip already skips already-satisfied installs. Caching it
//     cross-machine would be a correctness hazard, not a speedup.
//   - `pytest` / `lint` / `typecheck` are run actions, not artifact
//     builds — nothing to restore.
//   - `package`/`codegen` emit multi-file output sets; codegen already
//     documents its own deferral below.
// The one defensibly cacheable surface is the wheel produced by
// `python.package` (`dist/*.whl` — a single content-addressable artifact);
// that is the natural place to extend caching here if a real consumer
// asks. Until then these builders simply leave the cache marker absent,
// which the orchestrator renders as `[n/a]` in telemetry.
import build
import std.string
import std.io
import std.os
import std.file
import std.fs
import std.list
import std.map
import std.path
import std.dir

// --- DSL setters ---

pip(_ctx: ptr, pkg: string) {
    if map.has(_ctx, "pip_deps") == 0 {
        _e1 = map.put(_ctx, "pip_deps", list.new())
    }
    pkgs, _ = map.get(_ctx, "pip_deps")
    _e2 = list.add(pkgs, pkg)
}

requirements_file(_ctx: ptr, path: string) {
    _e = map.put(_ctx, "requirements_file", path)
}

// Set the package name for packaging
package_name(_ctx: ptr, name: string) {
    _e = map.put(_ctx, "package_name", name)
}

// Set the package version
version(_ctx: ptr, ver: string) {
    _e = map.put(_ctx, "version", ver)
}

// Set the minimum Python version
requires_python(_ctx: ptr, spec: string) {
    _e = map.put(_ctx, "requires_python", spec)
}

// Set the packages find location (relative to pyproject.toml)
packages_where(_ctx: ptr, where: string) {
    _e = map.put(_ctx, "packages_where", where)
}

// Set the packages include pattern
packages_include(_ctx: ptr, pattern: string) {
    _e = map.put(_ctx, "packages_include", pattern)
}

// pyproject_path("pyproject.toml") — explicit path to the project's
// pyproject.toml, consumed by `python.package_existing(b)`. Resolved
// against source_dir. Default: `<source_dir>/pyproject.toml`. Use
// when the file lives at a non-standard location or under a non-
// standard name. Ignored by `python.package(b)` (the regenerating
// builder) — that one always writes to `<source_dir>/pyproject.toml`.
pyproject_path(_ctx: ptr, path: string) {
    _e = map.put(_ctx, "pyproject_path", path)
}

// --- DSL setters: codegen ---
//
// python.codegen runs a Python module or script that produces source
// files for downstream compilation (PyTorch's torchgen.gen / autograd
// generators, gRPC's protoc-gen-py, sqlalchemy migrations, …). Inputs
// are declared *explicitly* — no GLOB_RECURSE fallback. The contract
// is "this script reads exactly these files and writes exactly these
// outputs"; missing-input bugs surface at staleness-check time and
// missing-output bugs surface at run time. The motivating case is
// PyTorch's `file(GLOB_RECURSE all_python "torchgen/*.py")` +
// `add_custom_command(... DEPENDS hand-maintained-list)` trap (see
// `itests/pytorch/cmake/Codegen.cmake` line 77).
//
// Repeated calls accumulate. The builder reads the map keys
// "codegen_driver" / "codegen_script" / "codegen_inputs" /
// "codegen_input_dirs" / "codegen_args" / "codegen_outputs" /
// "codegen_cwd" / "codegen_python".

// codegen_driver("foo.bar") — run as `python -m foo.bar`. Mutually
// exclusive with codegen_script(); the last call wins.
codegen_driver(_ctx: ptr, module_name: string) {
    _e = map.put(_ctx, "codegen_driver", module_name)
}

// codegen_script("tools/gen.py") — run as `python tools/gen.py`.
// Path is resolved against codegen_cwd (or source_dir if unset).
codegen_script(_ctx: ptr, script_path: string) {
    _e = map.put(_ctx, "codegen_script", script_path)
}

// codegen_input("path/to/file.yaml") — declare one file the script
// reads. Repeatable. Paths are resolved against codegen_cwd. The
// content hash of every declared input feeds the staleness check.
codegen_input(_ctx: ptr, path: string) {
    if map.has(_ctx, "codegen_inputs") == 0 {
        _e1 = map.put(_ctx, "codegen_inputs", list.new())
    }
    inputs, _ = map.get(_ctx, "codegen_inputs")
    _e2 = list.add(inputs, path)
}

// codegen_input_dir("torchgen") — declare a directory whose contents
// are inputs. Every regular file under the directory feeds the
// staleness check (recursive find, content-hashed). Use sparingly:
// the explicit input(...) form is preferred, but template trees and
// the codegen tool's own .py files are usually too many to enumerate.
codegen_input_dir(_ctx: ptr, path: string) {
    if map.has(_ctx, "codegen_input_dirs") == 0 {
        _e1 = map.put(_ctx, "codegen_input_dirs", list.new())
    }
    dirs, _ = map.get(_ctx, "codegen_input_dirs")
    _e2 = list.add(dirs, path)
}

// codegen_arg("--source-path=aten/src/ATen") — one CLI arg, appended
// in declared order to the python command line. Repeatable. No
// shell-splitting; pass `--flag value` as two separate calls.
codegen_arg(_ctx: ptr, arg: string) {
    if map.has(_ctx, "codegen_args") == 0 {
        _e1 = map.put(_ctx, "codegen_args", list.new())
    }
    args, _ = map.get(_ctx, "codegen_args")
    _e2 = list.add(args, arg)
}

// codegen_output("path/to/Functions.cpp") — declare one expected
// output. Repeatable. The builder fails if any declared output
// doesn't exist after the script runs (catches partial generation /
// silent skips). Paths are resolved against codegen_cwd.
codegen_output(_ctx: ptr, path: string) {
    if map.has(_ctx, "codegen_outputs") == 0 {
        _e1 = map.put(_ctx, "codegen_outputs", list.new())
    }
    outs, _ = map.get(_ctx, "codegen_outputs")
    _e2 = list.add(outs, path)
}

// codegen_cwd("..") — working directory for the python command
// (relative to source_dir, or absolute). Defaults to source_dir.
// Use when the codegen tool expects to run from the repo root but
// the .codegen.ae file lives in a subdirectory.
codegen_cwd(_ctx: ptr, dir: string) {
    _e = map.put(_ctx, "codegen_cwd", dir)
}

// codegen_python("python3") — override the python interpreter. By
// default the builder probes `${root}/.aeb/venv/bin/python` and falls
// back to PATH `python3`. Use to pin a specific runtime when the
// codegen tool depends on a venv-installed library (e.g. PyYAML for
// torchgen).
codegen_python(_ctx: ptr, py: string) {
    _e = map.put(_ctx, "codegen_python", py)
}

// --- Command builders (pure) ---

// pytest_cmd — pytest invocation. Pure.
pytest_cmd(py_bin: string, source_dir: string, root: string) {
    return "cd '${root}' && '${py_bin}' -m pytest '${source_dir}' -v"
}

// ruff_lint_cmd — ruff lint invocation. Pure.
ruff_lint_cmd(ruff_bin: string, source_dir: string) {
    return "'${ruff_bin}' check '${source_dir}'"
}

// mypy_cmd — mypy type-check invocation. Pure.
mypy_cmd(py_bin: string, source_dir: string, root: string) {
    return "cd '${root}' && '${py_bin}' -m mypy '${source_dir}' --ignore-missing-imports"
}

// build_package_cmd — `python -m build` invocation. Pure.
build_package_cmd(py_bin: string, source_dir: string, dist_dir: string) {
    return "cd '${source_dir}' && '${py_bin}' -m build --outdir '${dist_dir}'"
}

// pip_install_cmd — install a single pip dep. Pure.
pip_install_cmd(pip_bin: string, spec: string) {
    return "'${pip_bin}' install -q '${spec}'"
}

// pip_install_requirements_cmd — install from requirements file. Pure.
pip_install_requirements_cmd(pip_bin: string, req_path: string) {
    return "'${pip_bin}' install -q -r '${req_path}'"
}

// python_codegen_cmd — assemble the shell command for python.codegen.
// Pure: builds `cd '<cwd>' && '<py>' <driver_part> <args>` from the
// resolved inputs. driver_form is either "module" (→ `-m <name>`) or
// "script" (→ `<path>`); driver_name is the module name or script path.
// args is a list of pre-quoted CLI args (caller responsible for
// shell-quoting if needed); they're joined with single spaces.
// Tested in tests/test_python_codegen_cmd.ae.
python_codegen_cmd(py: string, cwd: string, driver_form: string, driver_name: string, args: ptr) {
    driver_part = ""
    if string.equals(driver_form, "module") == 1 {
        driver_part = string.concat(" -m ", driver_name)
    }
    if string.equals(driver_form, "script") == 1 {
        driver_part = string.concat(" ", driver_name)
    }
    args_part = ""
    if args != null {
        n = list.size(args)
        i = 0
        while i < n {
            a, _ = list.get(args, i)
            args_part = string.concat(args_part, " ")
            args_part = string.concat(args_part, a)
            i = i + 1
        }
    }
    return "cd '${cwd}' && '${py}'${driver_part}${args_part}"
}

// pyproject_toml_content — generate the [project] pyproject.toml from
// builder opts and a pre-resolved list of dependency specs. Pure.
//
// dep_specs is a list of strings shaped like "requests>=2.31.0" or
// "django==4.2"; the caller pre-translates "name~version" tilde
// shorthands. An empty/null list omits the dependencies = [] block.
pyproject_toml_content(opts: ptr, dep_specs: ptr) {
    toml = "[build-system]\nrequires = [\"setuptools\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[project]\n"

    pkg_name = "package"
    if opts != null {
        if map.has(opts, "package_name") == 1 {
            pkg_name, _ = map.get(opts, "package_name")
        }
    }
    toml = string.concat(toml, "name = \"${pkg_name}\"\n")

    pkg_ver = "0.1.0"
    if opts != null {
        if map.has(opts, "version") == 1 {
            pkg_ver, _ = map.get(opts, "version")
        }
    }
    toml = string.concat(toml, "version = \"${pkg_ver}\"\n")

    if opts != null {
        if map.has(opts, "requires_python") == 1 {
            rp, _ = map.get(opts, "requires_python")
            toml = string.concat(toml, "requires-python = \"${rp}\"\n")
        }
    }

    has_any_dep = 0
    if dep_specs != null {
        if list.size(dep_specs) > 0 {
            has_any_dep = 1
        }
    }
    if has_any_dep == 1 {
        toml = string.concat(toml, "dependencies = [\n")
        n = list.size(dep_specs)
        i = 0
        while i < n {
            spec, _ = list.get(dep_specs, i)
            toml = string.concat(toml, "    \"${spec}\",\n")
            i = i + 1
        }
        toml = string.concat(toml, "]\n")
    }

    toml = string.concat(toml, "\n[tool.setuptools.packages.find]\n")
    pkg_where = "."
    if opts != null {
        if map.has(opts, "packages_where") == 1 {
            pkg_where, _ = map.get(opts, "packages_where")
        }
    }
    toml = string.concat(toml, "where = [\"${pkg_where}\"]\n")

    pkg_include = "${pkg_name}*"
    if opts != null {
        if map.has(opts, "packages_include") == 1 {
            pkg_include, _ = map.get(opts, "packages_include")
        }
    }
    toml = string.concat(toml, "include = [\"${pkg_include}\"]\n")

    return toml
}

// --- Internal: ensure venv exists ---

_ensure_venv(root: string) {
    venv = path.join(root, ".aeb/venv")
    if file.exists(venv) == 0 {
        os.system("python3 -m venv '${venv}'")
    }
    return venv
}

// --- SDK functions ---

// Install pip dependencies into .aeb/venv/
// wheel_registry — declare a PyPI package to fetch at venv install time.
// Use in a .whl.ae file so downstream consumers that dep on this file
// pick up the package in their venv via pip install.
//
// Arg format: "name~version" (e.g. "requests~2.31.0")
// Multiple calls append to the same artifact so one .whl.ae can bundle
// several related coords.
builder wheel_registry(ctx: ptr, name_and_ver: string) {
    target_dir = build._get(ctx, "target_dir")
    mod_dir = build._get(ctx, "module_dir")
    build._mkdirs(target_dir)
    artifact_path = path.join(target_dir, "python_pypi_deps_including_transitive")
    existing = ""
    if file.exists(artifact_path) == 1 {
        existing, _er = io.read_file(artifact_path)
    }
    new_content = name_and_ver
    if string.length(existing) > 0 {
        new_content = string.concat(existing, "\n")
        new_content = string.concat(new_content, name_and_ver)
    }
    _ew = fs.write_atomic(artifact_path, new_content, string.length(new_content))
    println("${mod_dir}: registry pypi ${name_and_ver}")
    return 0
}

// wheel_vendored — declare a vendored .whl file to install at venv setup.
// Use in a .whl.ae file so consumers do `pip install <wheel-path>`.
//
// Arg format: local path to the .whl file (relative to project root)
// Multiple calls append to the same artifact.
builder wheel_vendored(ctx: ptr, wheel_path: string) {
    target_dir = build._get(ctx, "target_dir")
    mod_dir = build._get(ctx, "module_dir")
    build._mkdirs(target_dir)
    artifact_path = path.join(target_dir, "python_vendored_wheels_including_transitive")
    existing = ""
    if file.exists(artifact_path) == 1 {
        existing, _er = io.read_file(artifact_path)
    }
    new_content = wheel_path
    if string.length(existing) > 0 {
        new_content = string.concat(existing, "\n")
        new_content = string.concat(new_content, wheel_path)
    }
    _ew = fs.write_atomic(artifact_path, new_content, string.length(new_content))
    println("${mod_dir}: vendored wheel ${wheel_path}")
    return 0
}

builder install(ctx: ptr) {
    target_dir = build._get(ctx, "target_dir")
    mod_dir = build._get(ctx, "module_dir")
    root = build._get(ctx, "root")

    build._mkdirs(target_dir)
    println("${mod_dir}: installing deps (pip)")

    venv = _ensure_venv(root)
    pip_bin = path.join(venv, "bin/pip")

    // Install from requirements file
    if _builder != null {
        if map.has(_builder, "requirements_file") == 1 {
            req, _ = map.get(_builder, "requirements_file")
            req_path = path.join(root, req)
            if file.exists(req_path) == 1 {
                os.system(pip_install_requirements_cmd(pip_bin, req_path))
            }
        }
    }

    // Install individual pip deps
    if _builder != null {
        if map.has(_builder, "pip_deps") == 1 {
            pkgs, _ = map.get(_builder, "pip_deps")
            count = list.size(pkgs)
            i = 0
            while i < count {
                pkg, _ = list.get(pkgs, i)
                os.system(pip_install_cmd(pip_bin, pkg))
                i = i + 1
            }
        }
    }

    // Install PyPI coords from .whl.ae dep artifacts
    dep_list, _ = map.get(ctx, "deps")
    dl_count = list.size(dep_list)
    dli = 0
    while dli < dl_count {
        dp_w, _ = list.get(dep_list, dli)
        dm_w = build._strip_lang(dp_w)
        raw_pypi = build._read_dep_artifact(ctx, dm_w, "python_pypi_deps_including_transitive")
        if string.length(raw_pypi) > 0 {
            pi = 1
            while pi <= 200 {
                pr_raw, _epr = os.exec("printf '%s\\n' '${raw_pypi}' | sed -n '${pi}p'")
                pline = string.trim(pr_raw)
                if string.length(pline) == 0 {
                    pi = 999
                } else {
                    // Translate "name~spec" to a pip-install arg:
                    //   "requests~2.31.0"      → "requests==2.31.0"
                    //   "setuptools~>=70,<81" → "setuptools>=70,<81" (no == prefix)
                    //   "django~"              → "django" (no version)
                    // Rule: if spec starts with a comparator char (<>=~!), use as-is;
                    //       otherwise default to == for exact version pinning.
                    ps_raw, _eps = os.exec("printf '%s' '${pline}' | awk -F'~' '{n=$1; v=$2; if(v==\"\") print n; else if(v ~ /^[<>=!~]/) print n v; else print n \"==\" v}'")
                    pip_spec = string.trim(ps_raw)
                    os.system(pip_install_cmd(pip_bin, pip_spec))
                    pi = pi + 1
                }
            }
        }
        raw_whl = build._read_dep_artifact(ctx, dm_w, "python_vendored_wheels_including_transitive")
        if string.length(raw_whl) > 0 {
            wi = 1
            while wi <= 200 {
                wr_raw, _ewr = os.exec("printf '%s\\n' '${raw_whl}' | sed -n '${wi}p'")
                wline = string.trim(wr_raw)
                if string.length(wline) == 0 {
                    wi = 999
                } else {
                    // wline is a path relative to project root
                    wheel_full = path.join(root, wline)
                    os.system(pip_install_cmd(pip_bin, wheel_full))
                    wi = wi + 1
                }
            }
        }
        dli = dli + 1
    }

    _ewt = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// Run pytest using the .aeb/venv/ python.
builder pytest(ctx: ptr) {
    source_dir = build._get(ctx, "source_dir")
    target_dir = build._get(ctx, "target_dir")
    mod_dir = build._get(ctx, "module_dir")
    root = build._get(ctx, "root")

    build._mkdirs(target_dir)
    println("${mod_dir}: running tests (pytest)")

    venv = _ensure_venv(root)
    py = path.join(venv, "bin/python")

    cmd = pytest_cmd(py, source_dir, root)
    // Tee to target/<module>/test_output.log — durable record for
    // failure diagnosis, also feeds the summary parser. Pytest
    // prints "===== 14 passed, 1 failed in 0.34s =====" at the end.
    build._mkdirs(target_dir)
    out_path = path.join(target_dir, "test_output.log")
    full_cmd = string.concat(string.concat(cmd, " 2>&1 | tee "), out_path)
    exit_code = os.system(full_cmd)
    out_text, _orerr = fs.read(out_path)
    pp, pf = _parse_pytest_counts(out_text)
    build._record_test_result(ctx, pp, pf)
    if exit_code != 0 {
        println("${mod_dir}: tests FAILED")
        build.fail(ctx, "tests FAILED")
        return exit_code
    }
    println("${mod_dir}: tests PASSED")
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// _parse_pytest_counts(output) — extract (passed, failed) from
// pytest's summary line. Pure: just string parsing.
//
// Pytest summary varies:
//   "===== 14 passed in 0.34s ====="            (all-pass)
//   "===== 1 failed, 14 passed in 0.34s ====="  (mixed)
//   "===== 1 error in 0.05s ====="               (errors before tests)
//
// "errors" count as failures for our purposes (lowest common
// denominator: anything not-passed → failed).
_parse_pytest_counts(output: string) {
    passed = _parse_count_before_word_py(output, " passed")
    failed = _parse_count_before_word_py(output, " failed")
    errors = _parse_count_before_word_py(output, " error")
    return passed, failed + errors
}

_parse_count_before_word_py(output: string, word: string) {
    idx = string.index_of(output, word)
    if idx < 0 { return 0 }
    end = idx
    start = end
    found = 0
    while found == 0 {
        if start <= 0 {
            found = 1
        } else {
            c = string.substring(output, start - 1, start)
            if _is_digit_py(c) == 1 {
                start = start - 1
            } else {
                found = 1
            }
        }
    }
    if start >= end { return 0 }
    num_str = string.substring(output, start, end)
    v, _err = string.to_int(num_str)
    return v
}

_is_digit_py(c: string) {
    if string.equals(c, "0") == 1 { return 1 }
    if string.equals(c, "1") == 1 { return 1 }
    if string.equals(c, "2") == 1 { return 1 }
    if string.equals(c, "3") == 1 { return 1 }
    if string.equals(c, "4") == 1 { return 1 }
    if string.equals(c, "5") == 1 { return 1 }
    if string.equals(c, "6") == 1 { return 1 }
    if string.equals(c, "7") == 1 { return 1 }
    if string.equals(c, "8") == 1 { return 1 }
    if string.equals(c, "9") == 1 { return 1 }
    return 0
}

// Lint Python source with ruff.
builder lint(ctx: ptr) {
    source_dir = build._get(ctx, "source_dir")
    target_dir = build._get(ctx, "target_dir")
    mod_dir = build._get(ctx, "module_dir")
    root = build._get(ctx, "root")

    build._mkdirs(target_dir)
    println("${mod_dir}: linting (ruff)")

    venv = _ensure_venv(root)
    pip_bin = path.join(venv, "bin/pip")
    ruff = path.join(venv, "bin/ruff")

    // Ensure ruff is installed
    if file.exists(ruff) == 0 {
        os.system("'${pip_bin}' install -q ruff")
    }

    cmd = ruff_lint_cmd(ruff, source_dir)
    exit_code = os.system(cmd)
    if exit_code != 0 {
        println("${mod_dir}: lint FAILED")
        build.fail(ctx, "lint FAILED")
        return exit_code
    }
    println("${mod_dir}: lint PASSED")
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// Type-check Python source with mypy.
builder typecheck(ctx: ptr) {
    source_dir = build._get(ctx, "source_dir")
    target_dir = build._get(ctx, "target_dir")
    mod_dir = build._get(ctx, "module_dir")
    root = build._get(ctx, "root")

    build._mkdirs(target_dir)
    println("${mod_dir}: type-checking (mypy)")

    venv = _ensure_venv(root)
    pip_bin = path.join(venv, "bin/pip")
    mypy = path.join(venv, "bin/mypy")

    // Ensure mypy is installed
    if file.exists(mypy) == 0 {
        os.system("'${pip_bin}' install -q mypy")
    }

    py = path.join(venv, "bin/python")
    cmd = mypy_cmd(py, source_dir, root)
    exit_code = os.system(cmd)
    if exit_code != 0 {
        println("${mod_dir}: typecheck FAILED")
        build.fail(ctx, "typecheck FAILED")
        return exit_code
    }
    println("${mod_dir}: typecheck PASSED")
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// Build a Python package (wheel + sdist).
// Generates pyproject.toml from DSL setters, then runs python -m build.
builder package(ctx: ptr) {
    source_dir = build._get(ctx, "source_dir")
    target_dir = build._get(ctx, "target_dir")
    mod_dir = build._get(ctx, "module_dir")
    root = build._get(ctx, "root")

    dist_dir = path.join(target_dir, "dist")
    build._mkdirs(dist_dir)

    venv = _ensure_venv(root)
    pip_bin = path.join(venv, "bin/pip")
    py = path.join(venv, "bin/python")

    // Collect all dep specs (inline pip() calls + .whl.ae registry deps)
    dep_specs = list.new()
    if _builder != null {
        if map.has(_builder, "pip_deps") == 1 {
            pkgs, _ = map.get(_builder, "pip_deps")
            count = list.size(pkgs)
            i = 0
            while i < count {
                pkg, _ = list.get(pkgs, i)
                _e_a = list.add(dep_specs, pkg)
                i = i + 1
            }
        }
    }

    pkg_deps, _ = map.get(ctx, "deps")
    pkg_dep_count = list.size(pkg_deps)
    pdi = 0
    while pdi < pkg_dep_count {
        pdp, _ = list.get(pkg_deps, pdi)
        pdm = build._strip_lang(pdp)
        raw_p = build._read_dep_artifact(ctx, pdm, "python_pypi_deps_including_transitive")
        if string.length(raw_p) > 0 {
            ppi = 1
            while ppi <= 200 {
                pl_raw, _epl = os.exec("printf '%s\\n' '${raw_p}' | sed -n '${ppi}p'")
                plline = string.trim(pl_raw)
                if string.length(plline) == 0 {
                    ppi = 999
                } else {
                    ps_raw, _eps = os.exec("printf '%s' '${plline}' | awk -F'~' '{n=$1; v=$2; if(v==\"\") print n; else if(v ~ /^[<>=!~]/) print n v; else print n \"==\" v}'")
                    pip_spec = string.trim(ps_raw)
                    _e_b = list.add(dep_specs, pip_spec)
                    ppi = ppi + 1
                }
            }
        }
        pdi = pdi + 1
    }

    toml = pyproject_toml_content(_builder, dep_specs)
    pyproject = path.join(source_dir, ".pyproject.generated.toml")
    _ew1 = io.write_file(pyproject, toml)

    println("${mod_dir}: packaging (python -m build)")

    // Ensure build tool is installed
    os.system("'${pip_bin}' install -q build")

    // python -m build doesn't support --config for pyproject path.
    // Instead, write pyproject.toml directly (overwrite if exists).
    real_pyproject = path.join(source_dir, "pyproject.toml")
    _ew2 = io.write_file(real_pyproject, toml)

    cmd = build_package_cmd(py, source_dir, dist_dir)
    exit_code = os.system(cmd)
    if exit_code != 0 {
        println("${mod_dir}: packaging failed")
        build.fail(ctx, "packaging failed")
        return exit_code
    }
    println("${mod_dir}: packaging done → ${dist_dir}")
    _ew3 = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// --- python.package_existing builder ---
//
// Non-destructive packaging. Runs `python -m build` against the
// pyproject.toml already present in source_dir; never overwrites it.
//
// `python.package(b)` (above) is the right choice when aeb owns the
// metadata: `package_name`, `version`, `requires_python`,
// `packages_where`, `packages_include` setters drive a generated
// pyproject.toml every build. That's destructive when the project
// already ships a hand-tuned pyproject.toml with classifiers,
// license-files, setuptools-rust hooks, dynamic version metadata, or
// any other shape lib/python's generator doesn't model.
//
// `python.package_existing(b)` is the right choice when the upstream
// pyproject.toml is the source of truth and aeb should drive
// `python -m build` against it unchanged. Common case: an open-
// source project where the python packaging layout is owned by the
// project authors (e.g., selenium's py/pyproject.toml uses
// setuptools-rust to build the Selenium Manager Rust binary as part
// of the wheel — losing that to aeb-side regeneration would silently
// produce a broken wheel).
//
// Setters consumed (all optional):
//
//   pyproject_path("pyproject.toml")
//                — override the default `<source_dir>/pyproject.toml`.
//                  Resolved against source_dir.
//
// Outputs land in `target/<module>/dist/` per the existing
// `build_package_cmd` shape, so this builder is a drop-in for any
// downstream that consumes the dist artifact.
builder package_existing(ctx: ptr) {
    source_dir = build._get(ctx, "source_dir")
    target_dir = build._get(ctx, "target_dir")
    mod_dir = build._get(ctx, "module_dir")
    root = build._get(ctx, "root")

    dist_dir = path.join(target_dir, "dist")
    build._mkdirs(dist_dir)

    // Resolve pyproject.toml: explicit override > source_dir default.
    pyproject_rel = "pyproject.toml"
    if _builder != null {
        if map.has(_builder, "pyproject_path") == 1 {
            pyproject_rel, _ = map.get(_builder, "pyproject_path")
        }
    }
    pyproject_abs = pyproject_rel
    if string.length(pyproject_rel) > 0 {
        first = string.substring(pyproject_rel, 0, 1)
        if string.equals(first, "/") == 0 {
            pyproject_abs = path.join(source_dir, pyproject_rel)
        }
    }
    if file.exists(pyproject_abs) == 0 {
        println("${mod_dir}: python.package_existing: pyproject.toml not found at ${pyproject_abs}")
        println("${mod_dir}: did you mean python.package(b) (which generates one) or set pyproject_path(\"...\")?")
        build.fail(ctx, "pyproject.toml not found at ${pyproject_abs}")
        return 1
    }

    venv = _ensure_venv(root)
    pip_bin = path.join(venv, "bin/pip")
    py = path.join(venv, "bin/python")

    // Ensure the `build` package is installed in the venv. Same
    // shape as `python.package`; idempotent on re-run.
    os.system("'${pip_bin}' install -q build")

    // `python -m build` runs from the dir containing pyproject.toml.
    // If the override pointed somewhere else, cd to that dir.
    build_dir = source_dir
    if string.equals(pyproject_rel, "pyproject.toml") == 0 {
        build_dir = path.dirname(pyproject_abs)
    }

    println("${mod_dir}: packaging via existing pyproject.toml (${pyproject_abs})")
    cmd = build_package_cmd(py, build_dir, dist_dir)
    exit_code = os.system(cmd)
    if exit_code != 0 {
        println("${mod_dir}: packaging failed")
        build.fail(ctx, "packaging failed")
        return exit_code
    }
    println("${mod_dir}: packaging done → ${dist_dir}")
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// --- python.codegen builder ---
//
// Runs a Python codegen tool with explicitly declared inputs and
// outputs. The contract: the script reads exactly the files listed
// via codegen_input(...) / codegen_input_dir(...) and writes exactly
// the files listed via codegen_output(...). When all declared
// outputs exist and are newer than every declared input, the run is
// skipped (mtime-driven, same shape as `aether.regen`).
//
// Why this exists: PyTorch's torchgen.gen reads native_functions.yaml
// (+ tags + templates) and emits ~hundreds of .cpp/.h files in
// `aten/src/ATen/`. CMake handles this via GLOB_RECURSE
// CONFIGURE_DEPENDS over torchgen/*.py and a hand-maintained DEPENDS
// list inside `add_custom_command` — silent staleness when the
// DEPENDS list misses a file, full configure-time rebuild when any
// .py source changes. Aeb's explicit form catches both.
//
// Cache integration is deferred — codegen runs are expensive but
// declared outputs are large multi-file sets; wiring lib/cache for
// multi-file artifacts is a follow-up. Today's behaviour is "run if
// any declared input is newer than the oldest declared output."
builder codegen(ctx: ptr) {
    source_dir = build._get(ctx, "source_dir")
    target_dir = build._get(ctx, "target_dir")
    mod_dir = build._get(ctx, "module_dir")
    root = build._get(ctx, "root")
    build._mkdirs(target_dir)

    // Resolve working directory. codegen_cwd is relative to source_dir
    // unless absolute. Default to source_dir.
    cwd = source_dir
    if _builder != null {
        if map.has(_builder, "codegen_cwd") == 1 {
            rel, _ = map.get(_builder, "codegen_cwd")
            if string.length(rel) > 0 {
                first = string.substring(rel, 0, 1)
                if string.equals(first, "/") == 1 {
                    cwd = rel
                } else {
                    cwd = path.join(source_dir, rel)
                }
            }
        }
    }

    // Resolve python interpreter. Priority:
    //   1. codegen_python(...) override
    //   2. ${root}/.aeb/venv/bin/python (if venv installed)
    //   3. system "python3"
    py = "python3"
    if _builder != null {
        if map.has(_builder, "codegen_python") == 1 {
            py, _ = map.get(_builder, "codegen_python")
        } else {
            venv_py = path.join(root, ".aeb/venv/bin/python")
            if file.exists(venv_py) == 1 {
                py = venv_py
            }
        }
    }

    // Resolve driver form. codegen_driver wins over codegen_script if
    // both are set (last-call-wins is a per-key map.put, but we accept
    // either by checking which key is present).
    driver_form = ""
    driver_name = ""
    if _builder != null {
        if map.has(_builder, "codegen_driver") == 1 {
            driver_form = "module"
            driver_name, _ = map.get(_builder, "codegen_driver")
        } else {
            if map.has(_builder, "codegen_script") == 1 {
                driver_form = "script"
                driver_name, _ = map.get(_builder, "codegen_script")
            }
        }
    }
    if string.length(driver_form) == 0 {
        println("${mod_dir}: codegen: declare codegen_driver(\"module\") or codegen_script(\"path.py\")")
        build.fail(ctx, "codegen: no codegen_driver() or codegen_script() declared")
        return 1
    }

    // Inputs / outputs / args.
    args = null
    if _builder != null && map.has(_builder, "codegen_args") == 1 {
        args, _ = map.get(_builder, "codegen_args")
    }

    // Staleness check: skip if every declared output exists AND is
    // newer than every declared input file AND every file recursively
    // under every declared input_dir. Empty inputs+input_dirs → cannot
    // reason → force run. `_dir_newest_mtime` walks via std.dir,
    // portable across linux/macos.
    inputs = null
    input_dirs = null
    outputs = null
    if _builder != null {
        if map.has(_builder, "codegen_inputs") == 1 {
            inputs, _ = map.get(_builder, "codegen_inputs")
        }
        if map.has(_builder, "codegen_input_dirs") == 1 {
            input_dirs, _ = map.get(_builder, "codegen_input_dirs")
        }
        if map.has(_builder, "codegen_outputs") == 1 {
            outputs, _ = map.get(_builder, "codegen_outputs")
        }
    }
    skip = _codegen_can_skip(cwd, inputs, input_dirs, outputs)

    if skip == 0 {
        cmd = python_codegen_cmd(py, cwd, driver_form, driver_name, args)
        println("${mod_dir}: codegen running")
        rc = os.system(cmd)
        if rc != 0 {
            println("${mod_dir}: codegen FAILED")
            build.fail(ctx, "codegen FAILED")
            return rc
        }
    } else {
        println("${mod_dir}: codegen up-to-date")
    }

    // Verify every declared output exists, regardless of skip.
    missing = _codegen_check_outputs(cwd, outputs, mod_dir)
    if missing > 0 {
        println("${mod_dir}: codegen: ${missing} declared output(s) missing — check codegen_output() vs the tool's actual output set")
        build.fail(ctx, "codegen: ${missing} declared output(s) missing")
        return 1
    }

    // Record artifact: a newline-separated list of the codegen output
    // paths (absolute). Downstream consumers can read this as a
    // build artifact and feed it into their compile step.
    out_listing = _codegen_format_output_list(cwd, outputs)
    build._write_artifact(ctx, "python_codegen_outputs", out_listing)
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// _codegen_can_skip(cwd, inputs, input_dirs, outputs) — return 1 when
// every declared output exists AND its mtime is >= every declared
// input's mtime (both individual files via codegen_input(...) AND every
// file recursively under codegen_input_dir(...) trees). Returns 0 when
// codegen must run (missing output, or any input is newer). Empty
// inputs+input_dirs+outputs → never skip (force run, since we can't
// reason about freshness).
_codegen_can_skip(cwd: string, inputs: ptr, input_dirs: ptr, outputs: ptr) {
    if outputs == null { return 0 }
    if list.size(outputs) == 0 { return 0 }
    // Find newest input mtime across individual files.
    newest_in = 0
    if inputs != null {
        n = list.size(inputs)
        i = 0
        while i < n {
            p, _ = list.get(inputs, i)
            abs_p = _codegen_resolve(cwd, p)
            t = file.mtime(abs_p)
            if t > newest_in { newest_in = t }
            i = i + 1
        }
    }
    // Fold in newest mtime across each declared input directory's
    // recursive contents. Directory entries themselves are skipped
    // (mtime check is per regular-file). Symlinks aren't followed
    // (dir.list returns the symlink itself; file.mtime on a symlink
    // is the symlink's mtime, not the target's — which is the safer
    // default for staleness).
    if input_dirs != null {
        nd = list.size(input_dirs)
        di = 0
        while di < nd {
            dp, _ = list.get(input_dirs, di)
            abs_d = _codegen_resolve(cwd, dp)
            dir_newest = _dir_newest_mtime(abs_d)
            if dir_newest > newest_in { newest_in = dir_newest }
            di = di + 1
        }
    }
    // Find oldest output mtime; any-missing → 0.
    no = list.size(outputs)
    j = 0
    oldest_out = 0
    while j < no {
        op, _ = list.get(outputs, j)
        abs_o = _codegen_resolve(cwd, op)
        ot = file.mtime(abs_o)
        if ot == 0 { return 0 }
        if oldest_out == 0 { oldest_out = ot }
        if ot < oldest_out { oldest_out = ot }
        j = j + 1
    }
    if oldest_out >= newest_in { return 1 }
    return 0
}

// _dir_newest_mtime(dir_abs) — recursively walk a directory and return
// the newest file mtime found. Returns 0 if the directory doesn't
// exist or contains no regular files. Uses std.dir's flat list + per-
// entry stat to recurse; no shell-out so the staleness path stays
// fork-free (one os.system per build is the python-codegen run itself,
// not per-input-file).
//
// Why not shell out to `find -printf '%T@'`: GNU-only, breaks on
// macOS / BSD. The Aether-native recursion is portable as long as
// std.dir.list is implemented for the host.
_dir_newest_mtime(dir_abs: string) {
    if dir.exists(dir_abs) == 0 { return 0 }
    entries, _ = dir.list(dir_abs)
    if entries == null { return 0 }
    n = dir_list_count(entries)
    newest = 0
    i = 0
    while i < n {
        name = dir_list_get(entries, i)
        // dir.list returns bare names without "." / ".."; defensive
        // skip for any harness that returns them.
        if string.equals(name, ".") == 0 {
            if string.equals(name, "..") == 0 {
                full = path.join(dir_abs, name)
                if dir.exists(full) == 1 {
                    sub = _dir_newest_mtime(full)
                    if sub > newest { newest = sub }
                } else {
                    t = file.mtime(full)
                    if t > newest { newest = t }
                }
            }
        }
        i = i + 1
    }
    dir_list_free(entries)
    return newest
}

// _codegen_check_outputs(cwd, outputs, mod_dir) — return the number
// of declared outputs that don't exist on disk. Prints one line per
// missing file. Returns 0 when all outputs are present (or none are
// declared).
_codegen_check_outputs(cwd: string, outputs: ptr, mod_dir: string) {
    if outputs == null { return 0 }
    n = list.size(outputs)
    if n == 0 { return 0 }
    missing = 0
    i = 0
    while i < n {
        p, _ = list.get(outputs, i)
        abs_p = _codegen_resolve(cwd, p)
        if file.exists(abs_p) == 0 {
            println("${mod_dir}: codegen output missing: ${abs_p}")
            missing = missing + 1
        }
        i = i + 1
    }
    return missing
}

// _codegen_format_output_list(cwd, outputs) — newline-joined absolute
// paths suitable for the `python_codegen_outputs` artifact. Empty
// when no outputs declared.
_codegen_format_output_list(cwd: string, outputs: ptr) {
    if outputs == null { return "" }
    n = list.size(outputs)
    out = ""
    i = 0
    while i < n {
        p, _ = list.get(outputs, i)
        abs_p = _codegen_resolve(cwd, p)
        if i > 0 { out = string.concat(out, "\n") }
        out = string.concat(out, abs_p)
        i = i + 1
    }
    return out
}

// _codegen_resolve(cwd, p) — return absolute path. Bare-relative is
// joined against cwd; absolute passes through.
_codegen_resolve(cwd: string, p: string) {
    if string.length(p) == 0 { return p }
    first = string.substring(p, 0, 1)
    if string.equals(first, "/") == 1 { return p }
    return path.join(cwd, p)
}
