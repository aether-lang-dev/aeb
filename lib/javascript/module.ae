// javascript — JavaScript/Node SDK for aeb.
//
// Drives an existing Node project as-is. `javascript.test` defaults to
// `npm test`; declare npm_install(...) to resolve deps first and/or
// jest(...) to run via `npx jest` instead of `npm test`. Env injection
// (a shared `.so` path read by an FFI binding) rides the shared env(...).
//
//   import bldr
//   import javascript
//   import bldr (env)
//   import javascript (npm_install, jest)
//   javascript.test(b) {
//       env("SERVIRTIUM_VCR_LIB", lib)
//       npm_install("--silent --no-audit --no-fund")
//       jest("--runInBand")
//   }
//
// Setters: env(K,V) [lib/build], npm_install("flags"), jest("flags"),
// npm_test_flag("…"). A binding that declares its own step("…") still gets
// the generic _run_project path (back-compat).
import bldr
import std.string
import std.os
import std.list
import std.io
import std.path
import std.map

// --- DSL setters ---

// npm_install("--silent --no-audit --no-fund") — run `npm install <flags>`
// before the test. Scalar (the flag bundle); presence enables. Empty string
// runs a bare `npm install`.
npm_install(_ctx: ptr, flags: string) {
    _e = map.put(_ctx, "npm_install_flags", flags)
    _e2 = map.put(_ctx, "npm_install_on", "1")
}

// jest("--runInBand") — run the suite via `npx jest <flags>` instead of the
// default `npm test`. Scalar. Empty string runs a bare `npx jest`.
jest(_ctx: ptr, flags: string) {
    _e = map.put(_ctx, "jest_flags", flags)
    _e2 = map.put(_ctx, "jest_on", "1")
}

// --- Pure command builders (tested in tests/test_javascript_cmd.ae) ---

// npm_install_cmd(source_dir, flags) — `cd '<dir>' && npm install <flags>`.
// flags appended (with a separating space) only when non-empty.
npm_install_cmd(source_dir: string, flags: string) {
    if string.length(flags) > 0 {
        return "cd '${source_dir}' && npm install ${flags}"
    }
    return "cd '${source_dir}' && npm install"
}

// npx_jest_cmd(source_dir, flags) — `cd '<dir>' && npx jest <flags>`.
npx_jest_cmd(source_dir: string, flags: string) {
    if string.length(flags) > 0 {
        return "cd '${source_dir}' && npx jest ${flags}"
    }
    return "cd '${source_dir}' && npx jest"
}

// npm_test_cmd(source_dir) — `cd '<dir>' && npm test` (the default runner).
npm_test_cmd(source_dir: string) {
    return "cd '${source_dir}' && npm test"
}

// --- Builders ---

// javascript.build(b) — `npm install`.
builder build(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    mod_dir = bldr._get(ctx, "module_dir")
    println("${mod_dir}: installing (npm install)")
    return bldr._run_project(ctx, _builder, "npm install", 0)
}

// javascript.test(b) — `npm test` by default; `npx jest` when jest(...) is
// declared, optionally `npm install` first. Pass/fail telemetry. Honors
// explicit step()s for back-compat.
builder test(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    mod_dir = bldr._get(ctx, "module_dir")

    // Back-compat: a binding that wrote step("…") keeps the generic path.
    if _builder != null {
        if map.has(_builder, "proc_steps") == 1 {
            println("${mod_dir}: running tests (npm test)")
            return bldr._run_project(ctx, _builder, "npm test", 1)
        }
    }

    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    bldr._mkdirs(target_dir)
    env_prefix = bldr._env_export_prefix(_builder)

    // Optional `npm install` first.
    if _builder != null {
        if map.has(_builder, "npm_install_on") == 1 {
            iflags = ""
            if map.has(_builder, "npm_install_flags") == 1 { iflags, _ = map.get(_builder, "npm_install_flags") }
            println("${mod_dir}: installing deps (npm install)")
            in_rc = bldr._sh(string.concat(env_prefix, npm_install_cmd(source_dir, iflags)))
            if in_rc != 0 {
                println("${mod_dir}: npm install FAILED")
                bldr.fail(ctx, "npm install FAILED")
                return in_rc
            }
        }
    }

    // Pick the runner: npx jest (if declared) else npm test.
    test_command = npm_test_cmd(source_dir)
    if _builder != null {
        if map.has(_builder, "jest_on") == 1 {
            jflags = ""
            if map.has(_builder, "jest_flags") == 1 { jflags, _ = map.get(_builder, "jest_flags") }
            test_command = npx_jest_cmd(source_dir, jflags)
        }
    }

    println("${mod_dir}: running tests (node)")
    rc = bldr._sh(string.concat(env_prefix, test_command))
    if rc != 0 {
        bldr._record_test_result(ctx, 0, 1)
        println("${mod_dir}: tests FAILED")
        bldr.fail(ctx, "tests FAILED")
        return rc
    }
    bldr._record_test_result(ctx, 1, 0)
    println("${mod_dir}: tests PASSED")
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// javascript.pack() — `npm pack` the package into a tarball and publish the
// tarball dir on the "tarball_dir" artifact edge (for a consumer-install proof).
// npm_install() first (offline if cached) when declared. The engine .so, if the
// package bundles one, must already be staged in the package tree (via a
// copy.file in the node) — npm pack ships whatever `files`/.npmignore includes.
builder pack(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")
    bldr._mkdirs(target_dir)
    env_prefix = bldr._env_export_prefix(_builder)

    // optional npm install first (same as test()).
    if _builder != null {
        if map.has(_builder, "npm_install_on") == 1 {
            iflags = ""
            if map.has(_builder, "npm_install_flags") == 1 { iflags, _ = map.get(_builder, "npm_install_flags") }
            println("${mod_dir}: installing deps (npm install)")
            in_rc = bldr._sh(string.concat(env_prefix, npm_install_cmd(source_dir, iflags)))
            if in_rc != 0 {
                println("${mod_dir}: npm install FAILED")
                bldr.fail(ctx, "npm install FAILED")
                return in_rc
            }
        }
    }

    dest = path.join(target_dir, "pkgout")
    bldr._sh("rm -rf '${dest}' && mkdir -p '${dest}'")
    println("${mod_dir}: packaging (npm pack)")
    cmd = "cd '${source_dir}' && npm pack --silent --pack-destination '${dest}'"
    rc = bldr._sh(string.concat(env_prefix, cmd))
    if rc != 0 {
        println("${mod_dir}: npm pack FAILED")
        bldr.fail(ctx, "npm pack FAILED")
        return rc
    }
    if bldr._sh("ls '${dest}'/*.tgz >/dev/null 2>&1") != 0 {
        bldr.fail(ctx, "npm pack: no tarball produced")
        return 1
    }
    println("${mod_dir}: packed → ${dest}")
    bldr._write_artifact(ctx, "tarball_dir", dest)
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// --- javascript.consumer_example: prove the npm tarball installs + runs ---

consumer_script(_ctx: ptr, path: string) {
    _e = map.put(_ctx, "consumer_script", path)
}
consumer_arg(_ctx: ptr, arg: string) {
    if map.has(_ctx, "consumer_args") == 0 { _e1 = map.put(_ctx, "consumer_args", list.new()) }
    l, _ = map.get(_ctx, "consumer_args")
    _e2 = list.add(l, arg)
}
asset_glob(_ctx: ptr, glob: string) {
    _e = map.put(_ctx, "asset_glob", glob)
}

// javascript.consumer_example() — make a CLEAN consumer project (a bare
// package.json), `npm install <tarball>` (unpacks our package + its runtime
// deps into node_modules, with the bundled .so), assert the asset, then run the
// consumer with the dev env var unset. Reads the "tarball_dir" artifact.
builder consumer_example(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")
    bldr._mkdirs(target_dir)

    deps, _ = map.get(ctx, "deps")
    tarball_dir = ""
    nd = list.size(deps)
    di = 0
    while di < nd {
        dp, _ = list.get(deps, di)
        dm = bldr._strip_lang(dp)
        td = bldr._read_dep_artifact(ctx, dm, "tarball_dir")
        if string.length(td) > 0 { tarball_dir = td }
        di = di + 1
    }
    if string.length(tarball_dir) == 0 {
        bldr.fail(ctx, "javascript.consumer_example: no tarball_dir artifact on the dep")
        return 1
    }

    script = ""
    asset = ""
    if _builder != null {
        if map.has(_builder, "consumer_script") == 1 { script, _ = map.get(_builder, "consumer_script") }
        if map.has(_builder, "asset_glob") == 1 { asset, _ = map.get(_builder, "asset_glob") }
    }
    if string.length(script) == 0 {
        bldr.fail(ctx, "javascript.consumer_example: consumer_script(\"...\") is required")
        return 1
    }

    consumer = path.join(target_dir, "consumer")
    script_abs = path.join(source_dir, script)
    script_base = bldr._basename(script)
    bldr._sh("rm -rf '${consumer}' && mkdir -p '${consumer}' && cp '${script_abs}' '${consumer}/' && printf '{\"name\":\"consumer\",\"private\":true,\"version\":\"0.0.0\"}' > '${consumer}/package.json'")
    ni = bldr._sh("cd '${consumer}' && npm install --silent --no-audit --no-fund '${tarball_dir}'/*.tgz")
    if ni != 0 {
        println("${mod_dir}: npm install of the tarball failed")
        bldr.fail(ctx, "npm install failed")
        return 1
    }
    if string.length(asset) > 0 {
        if bldr._sh("ls '${consumer}'/${asset} >/dev/null 2>&1") != 0 {
            println("${mod_dir}: installed package is missing ${asset}")
            bldr.fail(ctx, "bundled asset missing after install")
            return 1
        }
    }

    base = "cd '${consumer}' && env -u SELENIUM_CORE_LIB node '${script_base}'"
    args = null
    if _builder != null {
        if map.has(_builder, "consumer_args") == 1 { args, _ = map.get(_builder, "consumer_args") }
    }
    if args == null {
        if bldr._sh(base) != 0 { bldr.fail(ctx, "consumer run failed"); return 1 }
    } else {
        na = list.size(args)
        ai = 0
        while ai < na {
            a, _ = list.get(args, ai)
            println("${mod_dir}: consumer run (${a})")
            if bldr._sh("${base} ${a}") != 0 {
                println("${mod_dir}: consumer run (${a}) failed")
                bldr.fail(ctx, "consumer run (${a}) failed")
                return 1
            }
            ai = ai + 1
        }
    }
    println("${mod_dir}: PASS — installed npm package loaded its bundled .so from clean")
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}
