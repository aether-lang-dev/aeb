// gleam — Gleam SDK for aether.build
//
// Downloads deps via `gleam deps download`, type-checks via
// `gleam check`, runs tests via `gleam test`, builds via `gleam build`,
// and runs code generators with explicit input/output tracking.
//
// Gleam (https://gleam.run/) compiles to Erlang (default) or
// JavaScript; the `gleam` tool drives a project rooted at `gleam.toml`,
// with build artifacts under `build/`. Tests conventionally run via
// gleeunit (EUnit on Erlang, a custom runner on JS).
//
// Style mirror: lib/moonbit/module.ae (itself modelled on lib/dart /
// lib/python). The codegen surface (codegen_* setters + the mtime
// staleness check) is the same "this generator reads exactly these
// files and writes exactly these outputs" contract used by the other
// SDKs.
//
// No venv equivalent: Gleam uses the system `gleam` on PATH plus a
// per-project resolved dep set under `build/packages/`, materialised by
// `gleam deps download`.
import bldr
import std.string
import std.io
import std.os
import std.file
import std.fs
import std.list
import std.map
import std.path
import std.dir

// --- DSL setters ---

// gleam_bin("gleam") — override the gleam executable. Default "gleam"
// (resolved on PATH). Use to pin a specific toolchain install.
gleam_bin(_ctx: ptr, bin: string) {
    _e = map.put(_ctx, "gleam_bin", bin)
}

// target("erlang") — compile target for check/test/build. One of
// erlang / javascript. Scalar; last wins. Default: gleam's own default
// (erlang) — the flag is omitted unless set.
target(_ctx: ptr, t: string) {
    _e = map.put(_ctx, "target", t)
}

// warnings_as_errors() — pass `--warnings-as-errors` to gleam.build.
// Any non-empty value enables.
warnings_as_errors(_ctx: ptr, v: string) {
    _e = map.put(_ctx, "warnings_as_errors", v)
}

// --- DSL setters: codegen ---
//
// gleam.codegen runs a generator that produces source files for
// downstream compilation. Inputs are declared *explicitly* — no glob
// fallback. The contract is "this generator reads exactly these files
// and writes exactly these outputs"; missing-input bugs surface at
// staleness-check time and missing-output bugs at run time.
//
// Mirror of moonbit.codegen / dart.codegen — the builder reads the map
// keys "codegen_cmd_prog" / "codegen_script" / "codegen_inputs" /
// "codegen_input_dirs" / "codegen_args" / "codegen_outputs" /
// "codegen_cwd". Gleam codegen is typically an external tool or a
// `gleam run -m <module>` of a generator; both are expressed as
// codegen_program("...") (the program) or codegen_script("module")
// (a `gleam run -m` target).

// codegen_program("protoc-gen-gleam") — the generator program to
// invoke directly (run as `<prog> <args>`). Mutually exclusive with
// codegen_script(); the program form wins if both set.
//
// (Named codegen_program, not codegen_cmd: a setter must not share its
// mangled symbol with a function in the same module, and the pure
// command-builder is `gleam_codegen_cmd` — `codegen_cmd` would mangle
// to the same `gleam_codegen_cmd` and collide. See AGENTS.md
// "builder-vs-function name collision".)
codegen_program(_ctx: ptr, prog: string) {
    _e = map.put(_ctx, "codegen_cmd_prog", prog)
}

// codegen_script("gen") — a `gleam run -m` module (run as
// `<gleam> run -m <name> -- <args>`). Use for a generator written as a
// Gleam module in the same project.
codegen_script(_ctx: ptr, name: string) {
    _e = map.put(_ctx, "codegen_script", name)
}

// codegen_input("schema/api.proto") — declare one file the generator
// reads. Repeatable. Paths resolved against codegen_cwd. The mtime of
// every declared input feeds the staleness check.
codegen_input(_ctx: ptr, path: string) {
    if map.has(_ctx, "codegen_inputs") == 0 {
        _e1 = map.put(_ctx, "codegen_inputs", list.new())
    }
    inputs, _ = map.get(_ctx, "codegen_inputs")
    _e2 = list.add(inputs, path)
}

// codegen_input_dir("schema") — declare a directory whose contents are
// inputs (recursive). Use sparingly: explicit input(...) is preferred,
// but a generator scanning a whole tree is usually too many to
// enumerate.
codegen_input_dir(_ctx: ptr, path: string) {
    if map.has(_ctx, "codegen_input_dirs") == 0 {
        _e1 = map.put(_ctx, "codegen_input_dirs", list.new())
    }
    dirs, _ = map.get(_ctx, "codegen_input_dirs")
    _e2 = list.add(dirs, path)
}

// codegen_arg("--out=src/gen") — one CLI arg, appended in declared
// order to the generator command line. Repeatable. No shell-splitting;
// pass `--flag value` as two separate calls.
codegen_arg(_ctx: ptr, arg: string) {
    if map.has(_ctx, "codegen_args") == 0 {
        _e1 = map.put(_ctx, "codegen_args", list.new())
    }
    args, _ = map.get(_ctx, "codegen_args")
    _e2 = list.add(args, arg)
}

// codegen_output("src/gen/api.gleam") — declare one expected output.
// Repeatable. The builder fails if any declared output doesn't exist
// after the generator runs (catches partial generation / silent
// skips). Paths resolved against codegen_cwd.
codegen_output(_ctx: ptr, path: string) {
    if map.has(_ctx, "codegen_outputs") == 0 {
        _e1 = map.put(_ctx, "codegen_outputs", list.new())
    }
    outs, _ = map.get(_ctx, "codegen_outputs")
    _e2 = list.add(outs, path)
}

// codegen_cwd("..") — working dir for the generator (relative to
// source_dir, or absolute). Defaults to source_dir.
codegen_cwd(_ctx: ptr, dir: string) {
    _e = map.put(_ctx, "codegen_cwd", dir)
}

// --- Consumer-manifest setters (for gleam.generate_manifest) ---
//
// gleam.generate_manifest() EMITS a complete gleam.toml for a CONSUMER — the
// same exporter-node pattern as python.package() / rust.cargo_crate(): pure
// content generator + declarative setters + a builder that io.write_file's it.
// The point over a hand-written gleam.toml is the NATIVE edge: a Gleam app that
// calls a shared NIF (selenium_core, …) needs the erlang application + its
// ERL_LIBS path, which aeb knows from the erlang.nif() node's published edges
// but a static gleam.toml cannot state. See asks/consumer-install-example-
// builder.md + REPLY-generate-consumer-manifest-and-override-dep.md.
//
// Setter names are deliberately distinct from any gleam_<name> function to
// avoid the setter-mangle collision (asks/setter-mangle-collides-with-function-
// name.md; the same reason codegen_program is not codegen_cmd).

// manifest_name("selenium") — the emitted gleam.toml [name]. Default "app".
manifest_name(_ctx: ptr, name: string) {
    _e = map.put(_ctx, "manifest_name", name)
}

// manifest_version("0.8.0") — the emitted [version]. Default "0.1.0".
manifest_version(_ctx: ptr, ver: string) {
    _e = map.put(_ctx, "manifest_version", ver)
}

// gleam_target("erlang") — the emitted [target] (erlang | javascript). Omitted
// when unset (gleam defaults to erlang). Named gleam_target, not target: target
// is already a setter on gleam.build/test (line 43) and would double-book the
// block-map key; the manifest carries its own.
manifest_target(_ctx: ptr, t: string) {
    _e = map.put(_ctx, "manifest_target", t)
}

// hex_dep("gleam_stdlib", ">= 0.34.0") — one hex.pm dependency line for the
// emitted [dependencies] table. Repeatable (mirror rust.crate_dep). Stored as
// "name~ver" (the SDK-wide tilde-join convention).
hex_dep(_ctx: ptr, name: string, ver: string) {
    if map.has(_ctx, "manifest_hex_deps") == 0 {
        _e1 = map.put(_ctx, "manifest_hex_deps", list.new())
    }
    deps, _ = map.get(_ctx, "manifest_hex_deps")
    entry = string.concat(name, "~")
    entry = string.concat(entry, ver)
    _e2 = list.add(deps, entry)
}

// depends_native("selenium_nif") — record that the consumer links a native
// (Erlang application) dependency of this name. Repeatable. Emitted as a
// dependency the BEAM resolver finds via ERL_LIBS (engine_from), not a hex dep.
depends_native(_ctx: ptr, app: string) {
    if map.has(_ctx, "manifest_native_deps") == 0 {
        _e1 = map.put(_ctx, "manifest_native_deps", list.new())
    }
    apps, _ = map.get(_ctx, "manifest_native_deps")
    _e2 = list.add(apps, app)
}

// engine_from(dep_artifact("erlang/.build.ae", "erl_libs")) — the ERL_LIBS path
// where the consumer's native deps (depends_native) live. Typically the
// erl_libs edge erlang.nif() publishes. Recorded in the emitted manifest as a
// resolvable pointer to the prebuilt engine/NIF.
engine_from(_ctx: ptr, erl_libs_path: string) {
    _e = map.put(_ctx, "manifest_engine_from", erl_libs_path)
}

// --- Command builders (pure) ---

// gleam_toml_content(opts) — PURE generator of a consumer gleam.toml from the
// generate_manifest block-map. No I/O; unit-tested like tests/test_cargo_toml.
// The [dependencies] table carries the hex_dep lines; the native edge
// (depends_native + engine_from) is emitted as a documented
// [erlang.native_deps]-style section a hand-written manifest can't produce.
gleam_toml_content(opts: ptr) {
    name = "app"
    ver = "0.1.0"
    if opts != null {
        if map.has(opts, "manifest_name") == 1 { name, _ = map.get(opts, "manifest_name") }
        if map.has(opts, "manifest_version") == 1 { ver, _ = map.get(opts, "manifest_version") }
    }
    toml = "name = \"${name}\"\nversion = \"${ver}\"\n"

    if opts != null {
        if map.has(opts, "manifest_target") == 1 {
            tgt, _ = map.get(opts, "manifest_target")
            if string.length(tgt) > 0 { toml = string.concat(toml, "target = \"${tgt}\"\n") }
        }
    }

    // [dependencies] — the hex deps ("name~ver" entries).
    if opts != null {
        if map.has(opts, "manifest_hex_deps") == 1 {
            deps, _ = map.get(opts, "manifest_hex_deps")
            n = list.size(deps)
            if n > 0 {
                toml = string.concat(toml, "\n[dependencies]\n")
                i = 0
                while i < n {
                    entry, _ = list.get(deps, i)
                    i = i + 1
                    tilde = string.index_of(entry, "~")
                    if tilde < 0 { continue }
                    dn = string.substring(entry, 0, tilde)
                    dv = string.substring(entry, tilde + 1, string.length(entry))
                    toml = string.concat(toml, "${dn} = \"${dv}\"\n")
                }
            }
        }
    }

    // The native edge a static gleam.toml cannot state: which Erlang
    // applications this consumer links, and the ERL_LIBS path they live under.
    has_native = 0
    if opts != null {
        if map.has(opts, "manifest_native_deps") == 1 {
            nd, _ = map.get(opts, "manifest_native_deps")
            if list.size(nd) > 0 { has_native = 1 }
        }
    }
    if has_native == 1 {
        toml = string.concat(toml, "\n# Native (Erlang application) dependencies — resolved via ERL_LIBS below,\n# not hex.pm. Emitted by aeb.gleam.generate_manifest from the NIF node's edges.\n[erlang.native_deps]\n")
        nd, _ = map.get(opts, "manifest_native_deps")
        n = list.size(nd)
        i = 0
        while i < n {
            app, _ = list.get(nd, i)
            i = i + 1
            toml = string.concat(toml, "${app} = { application = \"${app}\" }\n")
        }
        if opts != null {
            if map.has(opts, "manifest_engine_from") == 1 {
                ef, _ = map.get(opts, "manifest_engine_from")
                if string.length(ef) > 0 { toml = string.concat(toml, "erl_libs = \"${ef}\"\n") }
            }
        }
    }

    return toml
}

// _target_flag(t) — " --target <t>" or "" when empty.
_target_flag(t: string) {
    if string.length(t) == 0 { return "" }
    return string.concat(" --target ", t)
}

// deps_download_cmd — `gleam deps download` invocation. Pure. Runs from
// source_dir so gleam.toml resolves.
deps_download_cmd(gleam: string, source_dir: string) {
    return "cd '${source_dir}' && '${gleam}' deps download"
}

// check_cmd — `gleam check` invocation. Pure. target_flag is
// " --target <t>" or "".
check_cmd(gleam: string, source_dir: string, target_flag: string) {
    return "cd '${source_dir}' && '${gleam}' check${target_flag}"
}

// test_cmd — `gleam test` invocation. Pure. target_flag is
// " --target <t>" or "".
test_cmd(gleam: string, source_dir: string, target_flag: string) {
    return "cd '${source_dir}' && '${gleam}' test${target_flag}"
}

// build_cmd — `gleam build` invocation. Pure. target_flag is
// " --target <t>" or ""; werror_flag is " --warnings-as-errors" or "".
build_cmd(gleam: string, source_dir: string, target_flag: string, werror_flag: string) {
    return "cd '${source_dir}' && '${gleam}' build${target_flag}${werror_flag}"
}

// gleam_codegen_cmd — assemble the shell command for gleam.codegen.
// Pure: builds `cd '<cwd>' && <driver_part> <args>`. driver_form is
// "prog" (→ `'<name>'`) or "script" (→ `'<gleam>' run -m <name> --`);
// driver_name is the program or gleam-run module. args is a list of
// pre-quoted CLI args joined with single spaces.
// Tested in tests/test_gleam_codegen_cmd.ae.
gleam_codegen_cmd(gleam: string, cwd: string, driver_form: string, driver_name: string, args: ptr) {
    driver_part = ""
    if string.equals(driver_form, "prog") == 1 {
        driver_part = string.concat(string.concat(" '", driver_name), "'")
    }
    if string.equals(driver_form, "script") == 1 {
        driver_part = string.concat(string.concat(string.concat(" '", gleam), "' run -m "), driver_name)
        driver_part = string.concat(driver_part, " --")
    }
    args_part = ""
    if args != null {
        n = list.size(args)
        i = 0
        while i < n {
            a, _ = list.get(args, i)
            args_part = string.concat(args_part, " ")
            args_part = string.concat(args_part, a)
            i = i + 1
        }
    }
    return "cd '${cwd}' &&${driver_part}${args_part}"
}

// --- Internal: resolve the gleam executable + target ---

_gleam_of(builder_map: ptr) {
    if builder_map != null {
        if map.has(builder_map, "gleam_bin") == 1 {
            g, _ = map.get(builder_map, "gleam_bin")
            if string.length(g) > 0 { return g }
        }
    }
    return "gleam"
}

_target_of(builder_map: ptr) {
    if builder_map != null {
        if map.has(builder_map, "target") == 1 {
            t, _ = map.get(builder_map, "target")
            return t
        }
    }
    return ""
}

// --- SDK functions ---

// Download dependencies via `gleam deps download`. The install-
// equivalent; runs in source_dir. Mirror of moonbit.install.
builder deps(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")

    bldr._mkdirs(target_dir)
    println("${mod_dir}: downloading deps (gleam deps download)")

    gleam = _gleam_of(_builder)
    cmd = deps_download_cmd(gleam, source_dir)
    exit_code = bldr._sh(cmd)
    if exit_code != 0 {
        println("${mod_dir}: deps download FAILED")
        bldr.fail(ctx, "deps download FAILED")
        return exit_code
    }
    println("${mod_dir}: deps download done")
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// Type-check via `gleam check`. Mirror of moonbit.check / dart.analyze.
builder check(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")

    bldr._mkdirs(target_dir)
    println("${mod_dir}: checking (gleam check)")

    gleam = _gleam_of(_builder)
    cmd = check_cmd(gleam, source_dir, _target_flag(_target_of(_builder)))
    exit_code = bldr._sh(cmd)
    if exit_code != 0 {
        println("${mod_dir}: check FAILED")
        bldr.fail(ctx, "check FAILED")
        return exit_code
    }
    println("${mod_dir}: check PASSED")
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// Run tests via `gleam test`. Mirror of moonbit.test: tee output to
// target/<module>/test_output.log, parse gleeunit's summary line for
// pass/fail counts, feed bldr._record_test_result.
builder test(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")

    bldr._mkdirs(target_dir)
    println("${mod_dir}: running tests (gleam test)")

    gleam = _gleam_of(_builder)
    cmd = string.concat(bldr._env_export_prefix(_builder), test_cmd(gleam, source_dir, _target_flag(_target_of(_builder))))
    out_path = path.join(target_dir, "test_output.log")
    // Real exit code, not tee's — see bldr._sh_tee. A bare `cmd | tee log`
    // reports tee's 0 and turns a failing suite green.
    rc_file = path.join(target_dir, "test_exit.rc")
    exit_code = bldr._sh_tee(cmd, out_path, rc_file)
    out_text, _orerr = fs.read(out_path)
    tp_cnt, tf_cnt = _parse_gleeunit_counts(out_text)
    bldr._record_test_result(ctx, tp_cnt, tf_cnt)
    if exit_code != 0 {
        println("${mod_dir}: tests FAILED")
        bldr.fail(ctx, "tests FAILED")
        return exit_code
    }
    println("${mod_dir}: tests PASSED")
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// _parse_gleeunit_counts(output) — extract (passed, failed) from
// gleeunit's test summary. Pure: just string parsing.
//
// gleeunit runs EUnit on Erlang and a custom runner on JS. The two
// surfaces print differently:
//   Erlang/EUnit:  "  All 7 tests passed."   (all-pass)
//                  "Failed: 2.  Skipped: 0.  Passed: 5."  (mixed)
//   JS runner:     "7 tests, 0 failures"      (the N tests, M failures form)
//
// Strategy, in priority order:
//   1. If "N tests, M failures" is present, use those two numbers.
//   2. Else if "Passed: N" / "Failed: N" labels are present, use them.
//   3. Else if "All N tests passed" is present, passed=N, failed=0.
// Falls back to (0, 0) when nothing matches — never crashes.
_parse_gleeunit_counts(output: string) {
    // Form 1: "N tests, M failures"
    if string.index_of(output, " failures") >= 0 {
        if string.index_of(output, " tests, ") >= 0 {
            passed = _num_before_word_gleam(output, " tests,")
            failed = _num_before_word_gleam(output, " failures")
            return passed, failed
        }
    }
    // Form 2: "Passed: N" / "Failed: N" labels (EUnit verbose).
    if string.index_of(output, "Passed: ") >= 0 {
        p2 = _num_after_label_gleam(output, "Passed: ")
        f2 = _num_after_label_gleam(output, "Failed: ")
        return p2, f2
    }
    // Form 3: "All N tests passed."
    if string.index_of(output, "All ") >= 0 {
        if string.index_of(output, " tests passed") >= 0 {
            p3 = _num_after_label_gleam(output, "All ")
            return p3, 0
        }
    }
    return 0, 0
}

// _num_before_word_gleam(output, word) — the integer immediately
// preceding `word` (digits read leftward from the start of `word`).
// 0 when absent. Reads the FIRST occurrence of `word`.
_num_before_word_gleam(output: string, word: string) {
    idx = string.index_of(output, word)
    if idx < 0 { return 0 }
    end = idx
    start = end
    found = 0
    while found == 0 {
        if start <= 0 {
            found = 1
        } else {
            c = string.substring(output, start - 1, start)
            if _is_digit_gleam(c) == 1 {
                start = start - 1
            } else {
                found = 1
            }
        }
    }
    if start >= end { return 0 }
    num_str = string.substring(output, start, end)
    v, _err = string.to_int(num_str)
    return v
}

// _num_after_label_gleam(output, label) — the integer immediately
// following `label`. 0 when absent or not digit-followed. FIRST match.
_num_after_label_gleam(output: string, label: string) {
    idx = string.index_of(output, label)
    if idx < 0 { return 0 }
    start = idx + string.length(label)
    n = string.length(output)
    j = start
    digits = ""
    scanning = 1
    while scanning == 1 {
        if j >= n {
            scanning = 0
        } else {
            d = string.substring(output, j, j + 1)
            if _is_digit_gleam(d) == 1 {
                digits = string.concat(digits, d)
                j = j + 1
            } else {
                scanning = 0
            }
        }
    }
    if string.length(digits) == 0 { return 0 }
    v, _err = string.to_int(digits)
    return v
}

_is_digit_gleam(c: string) {
    if string.equals(c, "0") == 1 { return 1 }
    if string.equals(c, "1") == 1 { return 1 }
    if string.equals(c, "2") == 1 { return 1 }
    if string.equals(c, "3") == 1 { return 1 }
    if string.equals(c, "4") == 1 { return 1 }
    if string.equals(c, "5") == 1 { return 1 }
    if string.equals(c, "6") == 1 { return 1 }
    if string.equals(c, "7") == 1 { return 1 }
    if string.equals(c, "8") == 1 { return 1 }
    if string.equals(c, "9") == 1 { return 1 }
    return 0
}

// Build the project via `gleam build`. Gleam build produces compiled
// Erlang/JS under `build/` (a package, not a standalone host binary),
// so unlike dart.compile / moonbit.build there's no program_binary to
// publish — the runnable surface is `gleam run`, which needs the
// toolchain present. We record the build/ dir as the output artifact.
builder build(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")

    bldr._mkdirs(target_dir)

    gleam = _gleam_of(_builder)
    werror_flag = ""
    if _builder != null {
        if map.has(_builder, "warnings_as_errors") == 1 {
            wv, _ = map.get(_builder, "warnings_as_errors")
            if string.length(wv) > 0 { werror_flag = " --warnings-as-errors" }
        }
    }

    println("${mod_dir}: building (gleam build)")
    cmd = build_cmd(gleam, source_dir, _target_flag(_target_of(_builder)), werror_flag)
    exit_code = bldr._sh(cmd)
    if exit_code != 0 {
        println("${mod_dir}: build FAILED")
        bldr.fail(ctx, "build FAILED")
        return exit_code
    }

    // Record the gleam build output directory as the artifact. Gleam
    // emits compiled BEAM/JS under <source_dir>/build/, keyed by
    // profile + target; the dir itself is the consumable handoff.
    build_out = path.join(source_dir, "build")
    bldr._write_artifact(ctx, "gleam_build_output", build_out)
    println("${mod_dir}: build done → ${build_out}")
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// --- gleam.codegen builder ---
//
// Runs a Gleam code generator with explicitly declared inputs and
// outputs. Contract: the generator reads exactly the files listed via
// codegen_input(...) / codegen_input_dir(...) and writes exactly the
// files listed via codegen_output(...). When all declared outputs
// exist and are newer than every declared input, the run is skipped
// (mtime-driven, same shape as moonbit.codegen / dart.codegen /
// aether.regen).
//
// Why this exists: Gleam has no native pre-build / generated-source
// hook (no bldr.rs equivalent); generated `.gleam` sources (protobuf
// bindings, FFI stubs, schema-derived modules) are produced by external
// tools whose freshness Gleam's own build can't reason about. aeb's
// explicit form makes the generated-source edge a first-class graph
// dependency with staleness + output verification.
//
// Cache integration is deferred — same rationale as the sibling SDKs.
// Today: "run if any declared input is newer than the oldest declared
// output."
builder codegen(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")
    bldr._mkdirs(target_dir)

    // Resolve working directory. codegen_cwd relative to source_dir
    // unless absolute. Default source_dir.
    cwd = source_dir
    if _builder != null {
        if map.has(_builder, "codegen_cwd") == 1 {
            rel, _ = map.get(_builder, "codegen_cwd")
            if string.length(rel) > 0 {
                if bldr._is_abs_path(rel) == 1 {
                    cwd = rel
                } else {
                    cwd = path.join(source_dir, rel)
                }
            }
        }
    }

    gleam = _gleam_of(_builder)

    // Resolve driver form. codegen_program (prog) wins over script.
    driver_form = ""
    driver_name = ""
    if _builder != null {
        if map.has(_builder, "codegen_cmd_prog") == 1 {
            driver_form = "prog"
            driver_name, _ = map.get(_builder, "codegen_cmd_prog")
        } else {
            if map.has(_builder, "codegen_script") == 1 {
                driver_form = "script"
                driver_name, _ = map.get(_builder, "codegen_script")
            }
        }
    }
    if string.length(driver_form) == 0 {
        println("${mod_dir}: codegen: declare codegen_program(\"prog\") or codegen_script(\"gleam-run-module\")")
        bldr.fail(ctx, "codegen: no codegen_program() or codegen_script() declared")
        return 1
    }

    args = null
    if _builder != null && map.has(_builder, "codegen_args") == 1 {
        args, _ = map.get(_builder, "codegen_args")
    }

    inputs = null
    input_dirs = null
    outputs = null
    if _builder != null {
        if map.has(_builder, "codegen_inputs") == 1 {
            inputs, _ = map.get(_builder, "codegen_inputs")
        }
        if map.has(_builder, "codegen_input_dirs") == 1 {
            input_dirs, _ = map.get(_builder, "codegen_input_dirs")
        }
        if map.has(_builder, "codegen_outputs") == 1 {
            outputs, _ = map.get(_builder, "codegen_outputs")
        }
    }
    skip = _codegen_can_skip(cwd, inputs, input_dirs, outputs)

    if skip == 0 {
        cmd = gleam_codegen_cmd(gleam, cwd, driver_form, driver_name, args)
        println("${mod_dir}: codegen running")
        rc = bldr._sh(cmd)
        if rc != 0 {
            println("${mod_dir}: codegen FAILED")
            bldr.fail(ctx, "codegen FAILED")
            return rc
        }
    } else {
        println("${mod_dir}: codegen up-to-date")
    }

    missing = _codegen_check_outputs(cwd, outputs, mod_dir)
    if missing > 0 {
        println("${mod_dir}: codegen: ${missing} declared output(s) missing — check codegen_output() vs the generator's actual output set")
        bldr.fail(ctx, "codegen: ${missing} declared output(s) missing")
        return 1
    }

    out_listing = _codegen_format_output_list(cwd, outputs)
    bldr._write_artifact(ctx, "gleam_codegen_outputs", out_listing)
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// _codegen_can_skip(cwd, inputs, input_dirs, outputs) — 1 when every
// declared output exists AND its mtime is >= every declared input's
// mtime (individual files AND every file recursively under each
// input_dir). 0 when codegen must run. Empty inputs+input_dirs+outputs
// → never skip (force run, can't reason about freshness).
_codegen_can_skip(cwd: string, inputs: ptr, input_dirs: ptr, outputs: ptr) {
    if outputs == null { return 0 }
    if list.size(outputs) == 0 { return 0 }
    long newest_in = 0
    if inputs != null {
        n = list.size(inputs)
        i = 0
        while i < n {
            p, _ = list.get(inputs, i)
            abs_p = _codegen_resolve(cwd, p)
            t = fs.file_mtime(abs_p)
            if t > newest_in { newest_in = t }
            i = i + 1
        }
    }
    if input_dirs != null {
        nd = list.size(input_dirs)
        di = 0
        while di < nd {
            dp, _ = list.get(input_dirs, di)
            abs_d = _codegen_resolve(cwd, dp)
            dir_newest = _dir_newest_mtime(abs_d)
            if dir_newest > newest_in { newest_in = dir_newest }
            di = di + 1
        }
    }
    no = list.size(outputs)
    j = 0
    long oldest_out = 0
    while j < no {
        op, _ = list.get(outputs, j)
        abs_o = _codegen_resolve(cwd, op)
        ot = fs.file_mtime(abs_o)
        if ot == 0 { return 0 }
        if oldest_out == 0 { oldest_out = ot }
        if ot < oldest_out { oldest_out = ot }
        j = j + 1
    }
    if oldest_out >= newest_in { return 1 }
    return 0
}

// _dir_newest_mtime(dir_abs) — recursively walk a directory and return
// the newest file mtime found. 0 if absent / no regular files. std.dir
// flat-list + per-entry recurse; no shell-out (portable, unlike
// `find -printf`).
_dir_newest_mtime(dir_abs: string) -> long {
    if dir.exists(dir_abs) == 0 { return 0 }
    entries, _ = dir.list(dir_abs)
    if entries == null { return 0 }
    n = dir_list_count(entries)
    long newest = 0
    i = 0
    while i < n {
        name = dir_list_get(entries, i)
        if string.equals(name, ".") == 0 {
            if string.equals(name, "..") == 0 {
                full = path.join(dir_abs, name)
                if dir.exists(full) == 1 {
                    sub = _dir_newest_mtime(full)
                    if sub > newest { newest = sub }
                } else {
                    t = fs.file_mtime(full)
                    if t > newest { newest = t }
                }
            }
        }
        i = i + 1
    }
    dir_list_free(entries)
    return newest
}

// _codegen_check_outputs(cwd, outputs, mod_dir) — number of declared
// outputs that don't exist on disk. Prints one line per missing file.
// 0 when all present (or none declared).
_codegen_check_outputs(cwd: string, outputs: ptr, mod_dir: string) {
    if outputs == null { return 0 }
    n = list.size(outputs)
    if n == 0 { return 0 }
    missing = 0
    i = 0
    while i < n {
        p, _ = list.get(outputs, i)
        abs_p = _codegen_resolve(cwd, p)
        if file.exists(abs_p) == 0 {
            println("${mod_dir}: codegen output missing: ${abs_p}")
            missing = missing + 1
        }
        i = i + 1
    }
    return missing
}

// _codegen_format_output_list(cwd, outputs) — newline-joined absolute
// paths for the gleam_codegen_outputs artifact. Empty when none.
_codegen_format_output_list(cwd: string, outputs: ptr) {
    if outputs == null { return "" }
    n = list.size(outputs)
    out = ""
    i = 0
    while i < n {
        p, _ = list.get(outputs, i)
        abs_p = _codegen_resolve(cwd, p)
        if i > 0 { out = string.concat(out, "\n") }
        out = string.concat(out, abs_p)
        i = i + 1
    }
    return out
}

// _codegen_resolve(cwd, p) — absolute path. Bare-relative joined
// against cwd; absolute passes through.
_codegen_resolve(cwd: string, p: string) {
    if string.length(p) == 0 { return p }
    if bldr._is_abs_path(p) == 1 { return p }
    return path.join(cwd, p)
}

// gleam.test_existing(b) — run an existing Gleam project's tests as-is with
// full step/env control (e.g. ERL_LIBS for a shared NIF, a PATH-prefixed
// `gleam test`). Foundation-backed counterpart to the `test` builder.
builder test_existing(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    mod_dir = bldr._get(ctx, "module_dir")
    println("${mod_dir}: running tests (gleam test)")
    return bldr._run_project(ctx, _builder, "gleam test", 1)
}

// gleam.generate_manifest(b) — emit a complete consumer gleam.toml (name,
// version, [dependencies], and the native/NIF edge) into source_dir, and
// publish its path on the "gleam_toml" artifact edge. The exporter-node
// counterpart of python.package() / rust.cargo_crate(): declare the manifest
// with the setters above (manifest_name/version, hex_dep, depends_native,
// engine_from), route via a gleam/.package.ae (filename-is-the-route →
// target/package/…), and this writes the file a downstream consumer_example
// packages + installs. The native edge is the reason it's generated rather
// than hand-written: engine_from typically reads erlang.nif()'s erl_libs edge
// via dep_artifact(), which only aeb knows.
builder generate_manifest(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")

    bldr._mkdirs(target_dir)

    toml = gleam_toml_content(_builder)
    manifest_path = path.join(source_dir, "gleam.toml")
    _ew = io.write_file(manifest_path, toml)

    bldr._write_artifact(ctx, "gleam_toml", manifest_path)
    println("${mod_dir}: generated ${manifest_path}")
    _et = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}
