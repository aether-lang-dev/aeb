// dotnet — .NET SDK for aether.build
//
// Generates .{name}.generated.csproj from .build.ae declarations,
// then compiles via dotnet build and tests via dotnet test.
// NuGet versions come from Directory.Packages.props (central management).
import build
import cache
import std.string
import std.io
import std.os
import std.file
import std.fs
import std.list
import std.map
import std.path
import std.dir

// --- DSL setters ---

sdk(_ctx: ptr, s: string) {
    _e = map.put(_ctx, "sdk", s)
}

// Set the target framework (e.g. "net8.0", "net10.0").
// Overrides the central default from Directory.Packages.props.
target_framework(_ctx: ptr, tfm: string) {
    _e = map.put(_ctx, "target_framework", tfm)
}

root_namespace(_ctx: ptr, ns: string) {
    _e = map.put(_ctx, "root_namespace", ns)
}

assembly_name(_ctx: ptr, name: string) {
    _e = map.put(_ctx, "assembly_name", name)
}

configuration(_ctx: ptr, config: string) {
    _e = map.put(_ctx, "configuration", config)
}

nuget(_ctx: ptr, pkg: string) {
    if map.has(_ctx, "nuget_deps") == 0 {
        _e1 = map.put(_ctx, "nuget_deps", list.new())
    }
    pkgs, _ = map.get(_ctx, "nuget_deps")
    _e2 = list.add(pkgs, pkg)
}

test_project(_ctx: ptr) {
    _e = map.put(_ctx, "is_test_project", "true")
}

nullable(_ctx: ptr) {
    _e = map.put(_ctx, "nullable", "true")
}

output_type(_ctx: ptr, t: string) {
    _e = map.put(_ctx, "output_type", t)
}

implicit_usings(_ctx: ptr) {
    _e = map.put(_ctx, "implicit_usings", "true")
}

// --- Command builders (pure) ---

// dotnet_build_cmd — `dotnet build` invocation. Pure.
dotnet_build_cmd(csproj: string, config: string) {
    return "dotnet build '${csproj}' --configuration ${config}"
}

// csproj_path("Selenium.WebDriver.csproj") — explicit path to an
// upstream .csproj file, consumed by `dotnet.build_project_existing(b)`.
// Resolved against source_dir. When omitted, the builder looks for a
// single `*.csproj` in source_dir and uses that. Use this setter when
// multiple .csproj files coexist or the project lives in a subdir.
csproj_path(_ctx: ptr, p: string) {
    _e = map.put(_ctx, "csproj_path", p)
}

// dotnet_test_cmd — `dotnet test` invocation. Pure. --no-build because
// the test orchestrator runs after build_project has already compiled.
dotnet_test_cmd(csproj: string, config: string) {
    return "dotnet test '${csproj}' --configuration ${config} --no-build"
}

// _resolve_csproj_path — pure path-resolution helper for the
// `csproj_path(...)` setter. Returns an absolute path. Empty
// `csproj_rel` is returned as-is (caller falls back to globbing
// `source_dir` for a single .csproj). Absolute paths pass through;
// bare-relative paths join `source_dir`. Tested in
// tests/test_dotnet_cmd.ae.
_resolve_csproj_path(source_dir: string, csproj_rel: string) {
    if string.length(csproj_rel) == 0 { return "" }
    first = string.substring(csproj_rel, 0, 1)
    if string.equals(first, "/") == 1 { return csproj_rel }
    return path.join(source_dir, csproj_rel)
}

// csproj_content — generate the .csproj XML from builder opts and
// pre-resolved dep lists. Pure: caller pre-walks dep artifacts and
// passes plain lists, this just assembles XML.
//
// pkgrefs: list of "name~version" strings (use "~name" / no version
//   for an unversioned PackageReference). Inline nuget() entries with
//   colon separators are normalised to tilde by the caller.
// vendored_refs: list of "name~hint_path" strings.
// project_refs: list of relative .csproj paths for ProjectReference.
csproj_content(opts: ptr, pkgrefs: ptr, vendored_refs: ptr, project_refs: ptr) {
    proj_sdk = "Microsoft.NET.Sdk"
    if opts != null {
        if map.has(opts, "sdk") == 1 {
            proj_sdk, _ = map.get(opts, "sdk")
        }
    }

    xml = "<Project Sdk=\"${proj_sdk}\">\n\n  <PropertyGroup>\n"

    if opts != null {
        if map.has(opts, "target_framework") == 1 {
            tfm, _ = map.get(opts, "target_framework")
            xml = string.concat(xml, "    <TargetFramework>${tfm}</TargetFramework>\n")
        }
        if map.has(opts, "root_namespace") == 1 {
            ns, _ = map.get(opts, "root_namespace")
            xml = string.concat(xml, "    <RootNamespace>${ns}</RootNamespace>\n")
        }
        if map.has(opts, "assembly_name") == 1 {
            an, _ = map.get(opts, "assembly_name")
            xml = string.concat(xml, "    <AssemblyName>${an}</AssemblyName>\n")
        }
        if map.has(opts, "output_type") == 1 {
            ot, _ = map.get(opts, "output_type")
            xml = string.concat(xml, "    <OutputType>${ot}</OutputType>\n")
        }
        if map.has(opts, "nullable") == 1 {
            xml = string.concat(xml, "    <Nullable>enable</Nullable>\n")
        }
        if map.has(opts, "implicit_usings") == 1 {
            xml = string.concat(xml, "    <ImplicitUsings>enable</ImplicitUsings>\n")
        }
        if map.has(opts, "is_test_project") == 1 {
            xml = string.concat(xml, "    <IsPackable>false</IsPackable>\n")
        }
    }

    xml = string.concat(xml, "  </PropertyGroup>\n")

    has_pkgrefs = 0
    if pkgrefs != null {
        if list.size(pkgrefs) > 0 { has_pkgrefs = 1 }
    }
    if has_pkgrefs == 1 {
        xml = string.concat(xml, "\n  <ItemGroup>\n")
        n = list.size(pkgrefs)
        i = 0
        while i < n {
            entry, _ = list.get(pkgrefs, i)
            if string.contains(entry, "~") == 1 {
                idx = string.index_of(entry, "~")
                pkg_name = string.substring(entry, 0, idx)
                pkg_ver = string.substring(entry, idx + 1, string.length(entry))
                if string.length(pkg_ver) > 0 {
                    xml = string.concat(xml, "    <PackageReference Include=\"${pkg_name}\" Version=\"${pkg_ver}\" />\n")
                } else {
                    xml = string.concat(xml, "    <PackageReference Include=\"${pkg_name}\" />\n")
                }
            } else {
                xml = string.concat(xml, "    <PackageReference Include=\"${entry}\" />\n")
            }
            i = i + 1
        }
        xml = string.concat(xml, "  </ItemGroup>\n")
    }

    has_vrefs = 0
    if vendored_refs != null {
        if list.size(vendored_refs) > 0 { has_vrefs = 1 }
    }
    if has_vrefs == 1 {
        xml = string.concat(xml, "\n  <ItemGroup>\n")
        n = list.size(vendored_refs)
        i = 0
        while i < n {
            entry, _ = list.get(vendored_refs, i)
            idx = string.index_of(entry, "~")
            r_name = string.substring(entry, 0, idx)
            r_path = string.substring(entry, idx + 1, string.length(entry))
            xml = string.concat(xml, "    <Reference Include=\"${r_name}\"><HintPath>${r_path}</HintPath></Reference>\n")
            i = i + 1
        }
        xml = string.concat(xml, "  </ItemGroup>\n")
    }

    has_prefs = 0
    if project_refs != null {
        if list.size(project_refs) > 0 { has_prefs = 1 }
    }
    if has_prefs == 1 {
        xml = string.concat(xml, "\n  <ItemGroup>\n")
        n = list.size(project_refs)
        i = 0
        while i < n {
            ref, _ = list.get(project_refs, i)
            xml = string.concat(xml, "    <ProjectReference Include=\"${ref}\" />\n")
            i = i + 1
        }
        xml = string.concat(xml, "  </ItemGroup>\n")
    }

    xml = string.concat(xml, "\n</Project>\n")
    return xml
}

// _dotnet_version() — `dotnet --version`, memoised per build via an
// env-var cache. An SDK bump changes Roslyn output, so it's a real
// invalidator. Returns "" when dotnet is absent.
_dotnet_version() {
    cached = os.getenv("_AEB_DOTNET_VERSION_CACHE")
    if string.length(cached) > 0 { return cached }
    raw, _err = os.exec("dotnet --version 2>&1 | head -1")
    return string.trim(raw)
}

// _hash_if_present(parts, label, p) — append label + content hash of
// file `p` to `parts` when it exists. Used for the optional central
// package-management props files.
_hash_if_present(parts: ptr, label: string, p: string) {
    if file.exists(p) == 1 {
        h, herr = cache.hash_file(p)
        if string.length(herr) == 0 {
            list.add(parts, string.concat(label, h))
        }
    }
}

// _cache_key_for_dotnet — cache key for a dotnet build action. Inputs
// (length-prefixed, sorted via cache.hash_inputs):
//   - dotnet SDK version — Roslyn-output invalidator
//   - csproj fingerprint: the generated XML (build_project) or the
//     upstream .csproj content (build_project_existing) — captures TFM,
//     nuget refs, project refs, nullable, etc.
//   - configuration (Release/Debug)
//   - each .cs source's path + content hash, sorted by path
//   - Directory.Packages.props / Directory.Build.props content (central
//     package management) at source_dir and root — a version bump there
//     must bust the key. Best-effort to those two locations; a props
//     file at an intermediate ancestor is not walked (documented).
//   - each dep's dotnet_nuget_deps / dotnet_vendored_refs artifact
//     content — captures upstream dep changes
//
// FALSE-HIT HAZARD: a ProjectReference dep rebuilt to the same csproj
// but different source isn't fully reflected; the dep artifact content
// hash catches nuget/vendored changes. Full correctness would hash each
// dep's built bin/ — punted for v1. The cache.put non-empty guard in
// the builders means a wrong output-dir guess never populates the cache.
//
// Returns ("", err) on any source read failure.
_cache_key_for_dotnet(ctx: ptr, argfile_path: string, csproj_fingerprint: string, config: string, source_dir: string, root: string) {
    parts = list.new()

    list.add(parts, string.concat("dotnet:", _dotnet_version()))
    list.add(parts, string.concat("csproj:", csproj_fingerprint))
    list.add(parts, string.concat("config:", config))

    sources = build._read_argfile_lines(argfile_path)
    nsrc = list.size(sources)
    si = 0
    while si < nsrc {
        src, _ = list.get(sources, si)
        sh, serr = cache.hash_file(src)
        if string.length(serr) > 0 {
            return "", serr
        }
        list.add(parts, string.concat("src:", src))
        list.add(parts, string.concat("src-hash:", sh))
        si = si + 1
    }

    _hash_if_present(parts, "pkgprops-src:", path.join(source_dir, "Directory.Packages.props"))
    _hash_if_present(parts, "buildprops-src:", path.join(source_dir, "Directory.Build.props"))
    _hash_if_present(parts, "pkgprops-root:", path.join(root, "Directory.Packages.props"))
    _hash_if_present(parts, "buildprops-root:", path.join(root, "Directory.Build.props"))

    deps, _ = map.get(ctx, "deps")
    dn = list.size(deps)
    di = 0
    while di < dn {
        dp, _ = list.get(deps, di)
        dm = build._strip_lang(dp)
        dep_n = build._read_dep_artifact(ctx, dm, "dotnet_nuget_deps_including_transitive")
        if string.length(dep_n) > 0 {
            list.add(parts, string.concat("dep-nuget:", dm))
            list.add(parts, string.concat("dep-nuget-deps:", dep_n))
        }
        dep_v = build._read_dep_artifact(ctx, dm, "dotnet_vendored_refs_including_transitive")
        if string.length(dep_v) > 0 {
            list.add(parts, string.concat("dep-vendored:", dm))
            list.add(parts, string.concat("dep-vendored-refs:", dep_v))
        }
        di = di + 1
    }

    digest, derr = cache.hash_inputs(parts)
    return digest, derr
}

// _dotnet_cache_restore — shared cache get/restore for the dotnet build
// builders. Caches `bin/<config>` under source_dir (NOT obj/, which
// holds non-portable absolute-path assets). Returns 1 on a cache hit
// (caller skips the build), 0 on miss/unavailable (caller builds, then
// calls _dotnet_cache_store). Records the telemetry outcome. Writes the
// resolved key into ctx under "_dotnet_cache_key" for the store step.
_dotnet_cache_restore(ctx: ptr, argfile: string, fingerprint: string, config: string, source_dir: string, root: string) {
    map.put(ctx, "_dotnet_cache_key", "")
    if cache.available() == 0 {
        build._record_cache(ctx, "unavailable")
        return 0
    }
    ck, kerr = _cache_key_for_dotnet(ctx, argfile, fingerprint, config, source_dir, root)
    if string.length(kerr) > 0 {
        build._record_cache(ctx, "miss")
        return 0
    }
    map.put(ctx, "_dotnet_cache_key", ck)
    bin_dir = path.join(path.join(source_dir, "bin"), config)
    tmp_raw, _terr = os.exec("mktemp")
    tmp_tar = string.trim(tmp_raw)
    if string.length(tmp_tar) > 0 {
        grc = cache.get(ck, tmp_tar)
        if string.length(grc) == 0 {
            uerr = build._untar_into(tmp_tar, bin_dir)
            os.system("rm -f '${tmp_tar}'")
            if string.length(uerr) == 0 {
                build._record_cache(ctx, "hit")
                return 1
            }
            os.system("rm -rf '${bin_dir}'")
        } else {
            os.system("rm -f '${tmp_tar}'")
        }
    }
    build._record_cache(ctx, "miss")
    return 0
}

// _dotnet_cache_store — tar bin/<config> and cache.put under the key
// stashed by _dotnet_cache_restore. No-op when the key is empty or the
// bin dir is empty (a custom OutputPath redirected output elsewhere —
// guard against caching an empty tree → never a false hit).
_dotnet_cache_store(ctx: ptr, config: string, source_dir: string) {
    ck, _ = map.get(ctx, "_dotnet_cache_key")
    if string.length(ck) == 0 { return 0 }
    bin_dir = path.join(path.join(source_dir, "bin"), config)
    if build._dir_nonempty(bin_dir) == 0 { return 0 }
    tar_path, terr = build._tar_dir(bin_dir)
    if string.length(terr) == 0 {
        perr = cache.put(ck, tar_path)
        os.system("rm -f '${tar_path}'")
    }
    return 0
}

// --- SDK functions ---

// Generate .csproj and build a .NET project.
// nuget_registry — declare a NuGet package as a PackageReference contribution.
// Use in a .nupkg.ae file so downstream consumers that dep on this file
// pick up the package in their generated .csproj. Multiple calls append
// to the artifact so one .nupkg.ae can bundle several related coords
// (e.g. xunit + xunit.runner.visualstudio + Microsoft.NET.Test.Sdk).
//
// Arg format: "name~version" (e.g. "Shouldly~4.3.0")
builder nuget_registry(ctx: ptr, name_and_ver: string) {
    target_dir = build._get(ctx, "target_dir")
    mod_dir = build._get(ctx, "module_dir")
    build._mkdirs(target_dir)
    artifact_path = path.join(target_dir, "dotnet_nuget_deps_including_transitive")
    existing = ""
    if file.exists(artifact_path) == 1 {
        existing, _rerr = io.read_file(artifact_path)
    }
    new_content = name_and_ver
    if string.length(existing) > 0 {
        new_content = string.concat(existing, "\n")
        new_content = string.concat(new_content, name_and_ver)
    }
    _e = fs.write_atomic(artifact_path, new_content, string.length(new_content))
    println("${mod_dir}: registry nuget ${name_and_ver}")
    return 0
}

// nuget_vendored — declare a vendored DLL as a <Reference> contribution.
// Use in a .nupkg.ae (or .dll.ae) file so consumers pick up the DLL via
// an msbuild <Reference Include="..." HintPath="..."/> element. Appends
// to the artifact across multiple calls.
//
// Arg format: "name~path" (path relative to project root)
builder nuget_vendored(ctx: ptr, name_and_path: string) {
    target_dir = build._get(ctx, "target_dir")
    mod_dir = build._get(ctx, "module_dir")
    build._mkdirs(target_dir)
    artifact_path = path.join(target_dir, "dotnet_vendored_refs_including_transitive")
    existing = ""
    if file.exists(artifact_path) == 1 {
        existing, _rerr = io.read_file(artifact_path)
    }
    new_content = name_and_path
    if string.length(existing) > 0 {
        new_content = string.concat(existing, "\n")
        new_content = string.concat(new_content, name_and_path)
    }
    _e = fs.write_atomic(artifact_path, new_content, string.length(new_content))
    println("${mod_dir}: vendored dll ${name_and_path}")
    return 0
}

builder build_project(ctx: ptr) {
    source_dir = build._get(ctx, "source_dir")
    target_dir = build._get(ctx, "target_dir")
    mod_dir = build._get(ctx, "module_dir")
    root = build._get(ctx, "root")

    build._mkdirs(target_dir)

    pn_raw, _ep = os.exec("basename '${source_dir}'")
    project_name = string.trim(pn_raw)

    // Collect package refs: inline nuget() + .nupkg.ae registry deps.
    // Inline entries arrive colon-separated ("name:version"); registry
    // artifact lines are tilde-separated. Normalise everything to tilde
    // so csproj_content sees a single shape.
    pkgrefs = list.new()
    if _builder != null {
        if map.has(_builder, "nuget_deps") == 1 {
            pkgs, _ = map.get(_builder, "nuget_deps")
            count = list.size(pkgs)
            i = 0
            while i < count {
                pkg, _ = list.get(pkgs, i)
                if string.contains(pkg, ":") == 1 {
                    idx = string.index_of(pkg, ":")
                    pkg_name = string.substring(pkg, 0, idx)
                    pkg_ver = string.substring(pkg, idx + 1, string.length(pkg))
                    entry = string.concat(pkg_name, "~")
                    entry = string.concat(entry, pkg_ver)
                    _e_pi = list.add(pkgrefs, entry)
                } else {
                    entry = string.concat(pkg, "~")
                    _e_pi2 = list.add(pkgrefs, entry)
                }
                i = i + 1
            }
        }
    }

    dep_list, _ = map.get(ctx, "deps")
    dl_count = list.size(dep_list)
    dli = 0
    while dli < dl_count {
        dp_n, _ = list.get(dep_list, dli)
        dm_n = build._strip_lang(dp_n)
        raw_n = build._read_dep_artifact(ctx, dm_n, "dotnet_nuget_deps_including_transitive")
        if string.length(raw_n) > 0 {
            ni = 1
            while ni <= 200 {
                ln_raw, _eln = os.exec("printf '%s\\n' '${raw_n}' | sed -n '${ni}p'")
                line_n = string.trim(ln_raw)
                if string.length(line_n) == 0 {
                    ni = 999
                } else {
                    _e_pn = list.add(pkgrefs, line_n)
                    ni = ni + 1
                }
            }
        }
        dli = dli + 1
    }

    // Collect vendored DLL refs from .nupkg.ae dep artifacts. HintPath
    // is computed here (impure: needs python3 + filesystem) and the
    // result is passed as a tilde-joined "name~hint_rel" entry.
    vendored_refs = list.new()
    dli2 = 0
    while dli2 < dl_count {
        dp_r, _ = list.get(dep_list, dli2)
        dm_r = build._strip_lang(dp_r)
        raw_r = build._read_dep_artifact(ctx, dm_r, "dotnet_vendored_refs_including_transitive")
        if string.length(raw_r) > 0 {
            ri = 1
            while ri <= 200 {
                lr_raw, _elr = os.exec("printf '%s\\n' '${raw_r}' | sed -n '${ri}p'")
                line_r = string.trim(lr_raw)
                if string.length(line_r) == 0 {
                    ri = 999
                } else {
                    if string.contains(line_r, "~") == 1 {
                        idx = string.index_of(line_r, "~")
                        r_name = string.substring(line_r, 0, idx)
                        r_path = string.substring(line_r, idx + 1, string.length(line_r))
                        hr_raw, _ehr = os.exec("python3 -c \"import os; print(os.path.relpath('${root}/${r_path}', '${source_dir}'))\"")
                        hint_rel = string.trim(hr_raw)
                        entry = string.concat(r_name, "~")
                        entry = string.concat(entry, hint_rel)
                        _e_vr = list.add(vendored_refs, entry)
                    }
                    ri = ri + 1
                }
            }
        }
        dli2 = dli2 + 1
    }

    // ProjectReferences from build.dep() module deps. The Include path
    // (relative to source_dir) is computed here and passed as a plain
    // string list to csproj_content.
    project_refs = list.new()
    deps, _ = map.get(ctx, "deps")
    dep_count = list.size(deps)
    i = 0
    while i < dep_count {
        dp, _ = list.get(deps, i)
        dep_dir = path.join(root, dp)
        rel_raw, _erel = os.exec("python3 -c \"import os; print(os.path.relpath('${dep_dir}', '${source_dir}'))\"")
        rel = string.trim(rel_raw)
        dc_raw, _edc = os.exec("ls '${dep_dir}'/.*.generated.csproj 2>/dev/null | head -1")
        dep_csproj = string.trim(dc_raw)
        if string.length(dep_csproj) == 0 {
            dc2_raw, _edc2 = os.exec("ls '${dep_dir}'/*.csproj 2>/dev/null | head -1")
            dep_csproj = string.trim(dc2_raw)
        }
        if string.length(dep_csproj) > 0 {
            cn_raw, _ecn = os.exec("basename '${dep_csproj}'")
            csproj_name = string.trim(cn_raw)
            ref_path = string.concat(rel, "/")
            ref_path = string.concat(ref_path, csproj_name)
            _e_pr = list.add(project_refs, ref_path)
        }
        i = i + 1
    }

    xml = csproj_content(_builder, pkgrefs, vendored_refs, project_refs)

    csproj = path.join(source_dir, ".${project_name}.generated.csproj")
    _ew = io.write_file(csproj, xml)

    // --- Build ---
    println("${mod_dir}: compiling (dotnet)")

    config = "Release"
    if _builder != null {
        if map.has(_builder, "configuration") == 1 {
            config, _ = map.get(_builder, "configuration")
        }
    }

    // Test projects are NOT cached: the `test` builder runs
    // `dotnet test --no-build`, which needs obj/ (project.assets.json,
    // build props) present — and obj/ is intentionally not cached
    // (non-portable absolute paths). Caching only bin/ would leave a
    // restored test project unable to run. Record n/a and always build.
    is_test = 0
    if _builder != null {
        if map.has(_builder, "is_test_project") == 1 { is_test = 1 }
    }

    cached = 0
    if is_test == 0 {
        argfile = path.join(target_dir, "dotnet_sources.txt")
        os.system("find '${source_dir}' -name '*.cs' ! -path '*/bin/*' ! -path '*/obj/*' > '${argfile}' 2>/dev/null || true")
        cached = _dotnet_cache_restore(ctx, argfile, xml, config, source_dir, root)
        if cached == 1 {
            println("${mod_dir}: dotnet cache hit")
        }
    } else {
        build._record_cache(ctx, "n/a")
    }

    if cached == 0 {
        cmd = dotnet_build_cmd(csproj, config)
        exit_code = os.system(cmd)
        if exit_code != 0 {
            println("${mod_dir}: dotnet build failed")
            return exit_code
        }
        if is_test == 0 {
            _dotnet_cache_store(ctx, config, source_dir)
        }
    }

    _ets = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// dotnet.build_project_existing(b) — non-destructive variant of
// `dotnet.build_project`. Runs `dotnet build` against the upstream
// `.csproj` already in source_dir; never generates or overwrites it.
//
// `dotnet.build_project(b)` (above) is the right choice when aeb
// owns the project metadata: `target_framework` / `nuget` /
// `root_namespace` / `assembly_name` setters drive a regenerated
// `.{name}.generated.csproj`. That's destructive when the project
// ships a hand-tuned upstream .csproj with custom MSBuild targets,
// signing config, multi-targeting, generated assembly info, etc.
//
// `dotnet.build_project_existing(b)` is the right choice when the
// upstream .csproj is the source of truth and aeb should just
// drive `dotnet build` against it. Common case: ports of real-world
// .NET projects (e.g., Selenium's Selenium.WebDriver.csproj which
// uses Microsoft.NET.Sdk + custom signing + AssemblyInfo
// templates).
//
// Setters consumed (all optional):
//
//   csproj_path("Selenium.WebDriver.csproj")
//                   — explicit .csproj path. Default: scan source_dir
//                     for a single .csproj and use that. Required
//                     when more than one .csproj coexists in source_dir.
//   configuration("Release")
//                   — `dotnet build --configuration <name>`. Default
//                     "Release". Same setter as `dotnet.build_project`.
builder build_project_existing(ctx: ptr) {
    source_dir = build._get(ctx, "source_dir")
    target_dir = build._get(ctx, "target_dir")
    mod_dir = build._get(ctx, "module_dir")
    root = build._get(ctx, "root")
    build._mkdirs(target_dir)

    // Resolve .csproj path: explicit setter override > single-file
    // glob > error.
    csproj_rel = ""
    if _builder != null {
        if map.has(_builder, "csproj_path") == 1 {
            csproj_rel, _ = map.get(_builder, "csproj_path")
        }
    }
    csproj = _resolve_csproj_path(source_dir, csproj_rel)
    if string.length(csproj) == 0 {
        // No explicit setter — scan source_dir for a single .csproj.
        cs_raw, _ecs = os.exec("ls '${source_dir}'/*.csproj 2>/dev/null")
        cs_list = string.trim(cs_raw)
        nl_pos = string.index_of(cs_list, "\n")
        if string.length(cs_list) == 0 {
            println("${mod_dir}: build_project_existing: no .csproj found in ${source_dir}")
            println("${mod_dir}: place this .build.ae next to the .csproj, or set csproj_path(\"...\")")
            return 1
        }
        if nl_pos >= 0 {
            println("${mod_dir}: build_project_existing: multiple .csproj files in ${source_dir}")
            println("${mod_dir}: set csproj_path(\"...\") to disambiguate")
            return 1
        }
        csproj = cs_list
    }
    if file.exists(csproj) == 0 {
        println("${mod_dir}: build_project_existing: csproj not found at ${csproj}")
        return 1
    }

    config = "Release"
    if _builder != null {
        if map.has(_builder, "configuration") == 1 {
            config, _ = map.get(_builder, "configuration")
        }
    }

    println("${mod_dir}: compiling existing project (${csproj})")

    // Same test-project carve-out as build_project (see there).
    is_test = 0
    if _builder != null {
        if map.has(_builder, "is_test_project") == 1 { is_test = 1 }
    }

    cached = 0
    if is_test == 0 {
        // Fingerprint = the upstream .csproj content.
        fp_raw, _efp = io.read_file(csproj)
        fingerprint = string.trim(fp_raw)
        argfile = path.join(target_dir, "dotnet_sources.txt")
        os.system("find '${source_dir}' -name '*.cs' ! -path '*/bin/*' ! -path '*/obj/*' > '${argfile}' 2>/dev/null || true")
        cached = _dotnet_cache_restore(ctx, argfile, fingerprint, config, source_dir, root)
        if cached == 1 {
            println("${mod_dir}: dotnet cache hit")
        }
    } else {
        build._record_cache(ctx, "n/a")
    }

    if cached == 0 {
        cmd = dotnet_build_cmd(csproj, config)
        exit_code = os.system(cmd)
        if exit_code != 0 {
            println("${mod_dir}: dotnet build failed")
            return exit_code
        }
        if is_test == 0 {
            _dotnet_cache_store(ctx, config, source_dir)
        }
    }

    _ets = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// Run dotnet test on a test project.
builder test(ctx: ptr) {
    source_dir = build._get(ctx, "source_dir")
    target_dir = build._get(ctx, "target_dir")
    mod_dir = build._get(ctx, "module_dir")

    build._mkdirs(target_dir)
    println("${mod_dir}: running tests (dotnet)")

    cs_raw, _ecs = os.exec("ls '${source_dir}'/.*.generated.csproj 2>/dev/null | head -1")
    csproj = string.trim(cs_raw)
    if string.length(csproj) == 0 {
        cs2_raw, _ecs2 = os.exec("ls '${source_dir}'/*.csproj 2>/dev/null | head -1")
        csproj = string.trim(cs2_raw)
    }

    config = "Release"
    if _builder != null {
        if map.has(_builder, "configuration") == 1 {
            config, _ = map.get(_builder, "configuration")
        }
    }

    cmd = dotnet_test_cmd(csproj, config)
    // Tee output to target/<module>/test_output.log so the same
    // bytes serve two roles: (1) summary parsing for telemetry,
    // (2) durable record for failure diagnosis after the build
    // finishes (terminal scrollback isn't reliable, especially in
    // CI). dotnet test prints
    //   "Passed!  - Failed: 0, Passed: 14, Skipped: 0, Total: 14"
    out_path = path.join(target_dir, "test_output.log")
    full_cmd = string.concat(string.concat(cmd, " 2>&1 | tee "), out_path)
    exit_code = os.system(full_cmd)
    out_text, _orerr = fs.read(out_path)
    pd, fd = _parse_dotnet_counts(out_text)
    build._record_test_result(ctx, pd, fd)
    if exit_code != 0 {
        println("${mod_dir}: tests FAILED")
        return exit_code
    }
    println("${mod_dir}: tests PASSED")
    _ets = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// _parse_dotnet_counts(output) — extract (passed, failed) from
// `dotnet test` summary. Format:
//     "Failed:     0, Passed:    14, Skipped:     0, Total:    14"
// Skipped counts toward neither. Pure: just string parsing.
_parse_dotnet_counts(output: string) {
    return _parse_dotnet_field(output, "Passed:"), _parse_dotnet_field(output, "Failed:")
}

_parse_dotnet_field(output: string, marker: string) {
    idx = string.index_of(output, marker)
    if idx < 0 { return 0 }
    n = string.length(output)
    p = idx + string.length(marker)
    digit_start = -1
    found = 0
    while found == 0 {
        if p >= n {
            found = 1
        } else {
            c = string.substring(output, p, p + 1)
            if string.equals(c, " ") == 1 {
                p = p + 1
            } else {
                digit_start = p
                found = 1
            }
        }
    }
    if digit_start < 0 { return 0 }
    digit_end = digit_start
    found2 = 0
    while found2 == 0 {
        if digit_end >= n {
            found2 = 1
        } else {
            c = string.substring(output, digit_end, digit_end + 1)
            if _is_digit_dn(c) == 1 {
                digit_end = digit_end + 1
            } else {
                found2 = 1
            }
        }
    }
    if digit_end == digit_start { return 0 }
    num_str = string.substring(output, digit_start, digit_end)
    v, _err = string.to_int(num_str)
    return v
}

_is_digit_dn(c: string) {
    if string.equals(c, "0") == 1 { return 1 }
    if string.equals(c, "1") == 1 { return 1 }
    if string.equals(c, "2") == 1 { return 1 }
    if string.equals(c, "3") == 1 { return 1 }
    if string.equals(c, "4") == 1 { return 1 }
    if string.equals(c, "5") == 1 { return 1 }
    if string.equals(c, "6") == 1 { return 1 }
    if string.equals(c, "7") == 1 { return 1 }
    if string.equals(c, "8") == 1 { return 1 }
    if string.equals(c, "9") == 1 { return 1 }
    return 0
}

// dotnet.test_existing(b) — `dotnet test` on an upstream project as-is
// (builds, unlike the `--no-build` `test` builder). Foundation-backed:
// honors env(K,V)/step/workdir.
builder test_existing(ctx: ptr) {
    mod_dir = build._get(ctx, "module_dir")
    println("${mod_dir}: running tests (dotnet test)")
    return build._run_project(ctx, _builder, "dotnet test --nologo", 1)
}
