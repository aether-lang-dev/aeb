// crystal — Crystal SDK for aeb.
//
// Crystal binds a C shared library directly via `@[Link]` + `lib`/`fun` blocks
// (no glue). This SDK's test() runs `crystal spec` with env() honored;
// CRYSTAL_LIBRARY_PATH points the linker at a dir holding the .so (`-lname`
// resolves there). Loud-skips (green) when crystal is absent.
//
//   import bldr
//   import crystal
//   crystal.test() {
//       env("CRYSTAL_LIBRARY_PATH", native_dir)
//   }
import bldr
import std.string
import std.map
import std.list
import std.path
import std.io
import std.os

// spec_path("spec") — the spec dir/file to run (default "spec"). Scalar.
spec_path(_ctx: ptr, path: string) {
    _e = map.put(_ctx, "crystal_spec", path)
}

// --- Consumer-manifest setters (for crystal.generate_manifest) ---
// Emit a consumer shard.yml — the exporter-node pattern (python.package /
// rust.cargo_crate). Setter names distinct from any crystal_<name> function
// (setter-mangle rule).

// manifest_name("selenium") — shard.yml name:. Default "app".
manifest_name(_ctx: ptr, name: string) {
    _e = map.put(_ctx, "manifest_name", name)
}

// manifest_version("0.8.0") — shard.yml version:. Default "0.1.0".
manifest_version(_ctx: ptr, ver: string) {
    _e = map.put(_ctx, "manifest_version", ver)
}

// shard_dep("webdriver", "~> 1.0") — one dependencies: entry. Repeatable.
// Stored "name~ver".
shard_dep(_ctx: ptr, name: string, ver: string) {
    if map.has(_ctx, "manifest_shard_deps") == 0 {
        _e1 = map.put(_ctx, "manifest_shard_deps", list.new())
    }
    deps, _ = map.get(_ctx, "manifest_shard_deps")
    entry = string.concat(name, "~")
    entry = string.concat(entry, ver)
    _e2 = list.add(deps, entry)
}

// shard_yml_content(opts) — PURE generator of a consumer shard.yml from the
// generate_manifest block-map. No I/O; unit-tested. Emits name/version and a
// dependencies: map (each dep as `name:\n    version: "ver"`, shard.yml's shape).
shard_yml_content(opts: ptr) {
    name = "app"
    ver = "0.1.0"
    if opts != null {
        if map.has(opts, "manifest_name") == 1 { name, _ = map.get(opts, "manifest_name") }
        if map.has(opts, "manifest_version") == 1 { ver, _ = map.get(opts, "manifest_version") }
    }
    yaml = "name: ${name}\nversion: ${ver}\n"

    has_deps = 0
    if opts != null {
        if map.has(opts, "manifest_shard_deps") == 1 {
            d, _ = map.get(opts, "manifest_shard_deps")
            if list.size(d) > 0 { has_deps = 1 }
        }
    }
    if has_deps == 1 {
        yaml = string.concat(yaml, "dependencies:\n")
        deps, _ = map.get(opts, "manifest_shard_deps")
        n = list.size(deps)
        i = 0
        while i < n {
            entry, _ = list.get(deps, i)
            i = i + 1
            tilde = string.index_of(entry, "~")
            if tilde < 0 { continue }
            dn = string.substring(entry, 0, tilde)
            dv = string.substring(entry, tilde + 1, string.length(entry))
            yaml = string.concat(yaml, "  ${dn}:\n    version: \"${dv}\"\n")
        }
    }
    return yaml
}

// crystal_bin("/path/to/crystal") — override the interpreter (default `crystal`).
crystal_bin(_ctx: ptr, bin: string) {
    _e = map.put(_ctx, "crystal_bin", bin)
}

_crystal_of(bmap: ptr) {
    if bmap != null {
        if map.has(bmap, "crystal_bin") == 1 {
            b, _ = map.get(bmap, "crystal_bin")
            if string.length(b) > 0 { return b }
        }
    }
    return "crystal"
}

// crystal_spec_cmd(source_dir, crystal, spec) — `cd '<dir>' && <crystal> spec
// '<spec>'`. The pure command the test() builder runs (env prefix rides
// separately via _env_export_prefix). Pure; tested in tests/test_crystal_cmd.ae.
crystal_spec_cmd(source_dir: string, crystal: string, spec: string) {
    return "cd '${source_dir}' && ${crystal} spec '${spec}'"
}

// crystal.test() — run `crystal spec <path>`. Loud-skips when crystal is absent.
// env() honored (e.g. CRYSTAL_LIBRARY_PATH so `@[Link]` finds the .so).
builder test(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")
    bldr._mkdirs(target_dir)

    crystal = _crystal_of(_builder)

    if string.length(os.which(crystal)) == 0 {
        reason = "crystal not on PATH (install Crystal)"
        println("${mod_dir}: SKIPPED — ${reason}")
        bldr._record_skip(ctx, reason)
        return 0
    }

    spec = "spec"
    if _builder != null {
        if map.has(_builder, "crystal_spec") == 1 { spec, _ = map.get(_builder, "crystal_spec") }
    }

    println("${mod_dir}: running tests (crystal spec)")
    run = crystal_spec_cmd(source_dir, crystal, spec)
    run = string.concat(bldr._env_export_prefix(_builder), run)
    rc = bldr._sh(run)
    if rc != 0 {
        bldr._record_test_result(ctx, 0, 1)
        println("${mod_dir}: tests FAILED")
        bldr.fail(ctx, "tests FAILED")
        return rc
    }
    bldr._record_test_result(ctx, 1, 0)
    println("${mod_dir}: tests PASSED")
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// crystal.generate_manifest(b) — emit a consumer shard.yml (name, version,
// dependencies) into source_dir and publish "shard_yml". Exporter-node
// counterpart of python.package(); declare with manifest_name/version +
// shard_dep, route via a crystal/.package.ae.
builder generate_manifest(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")

    bldr._mkdirs(target_dir)

    yaml = shard_yml_content(_builder)
    manifest_path = path.join(source_dir, "shard.yml")
    _ew = io.write_file(manifest_path, yaml)

    bldr._write_artifact(ctx, "shard_yml", manifest_path)
    println("${mod_dir}: generated ${manifest_path}")
    _et = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}
