// container — Container image SDK for aether.build
// Supports OCI images (podman/docker) and LXC containers.
import std.string
import std.io
import std.os
import std.file
import std.map
import std.path
// Narrow import of build.fail ONLY: the orchestrator ignores a builder's
// return value (tools/gen-orchestrator.ae explains why — a trailing-block
// builder's implicit return is garbage), so failures redden the build ONLY
// via the explicit build.fail() channel. A container build that returned
// non-zero but didn't call build.fail() reported a green build with no image
// (observed). Every other SDK calls build.fail; container must too. (The old
// "no import build — double-import conflicts" note predated the narrow-import
// support; `import build (fail)` resolves cleanly.)
import build (fail)

// --- OCI image DSL setters ---

base(_ctx: ptr, img: string) {
    _e = map.put(_ctx, "base", img)
}

port(_ctx: ptr, p: string) {
    if map.has(_ctx, "ports") == 1 {
        prev, _ = map.get(_ctx, "ports")
        combined = string.concat(prev, " ")
        combined = string.concat(combined, p)
        _e1 = map.put(_ctx, "ports", combined)
    } else {
        _e2 = map.put(_ctx, "ports", p)
    }
}

env(_ctx: ptr, key: string, val: string) {
    entry = string.concat(key, "=")
    entry = string.concat(entry, val)
    if map.has(_ctx, "env_vars") == 1 {
        prev, _ = map.get(_ctx, "env_vars")
        combined = string.concat(prev, "\n")
        combined = string.concat(combined, entry)
        _e1 = map.put(_ctx, "env_vars", combined)
    } else {
        _e2 = map.put(_ctx, "env_vars", entry)
    }
}

engine(_ctx: ptr, e: string) {
    _e = map.put(_ctx, "engine", e)
}

entrypoint(_ctx: ptr, cmd: string) {
    _e = map.put(_ctx, "entrypoint", cmd)
}

// workdir(dir) — dual-write: the "workdir" key (artifact-packaging path)
// AND an ordered WORKDIR step (full-recipe path), so a WORKDIR between two
// RUNs lands in the right place in the generated Dockerfile.
workdir(_ctx: ptr, dir: string) {
    _e = map.put(_ctx, "workdir", dir)
    _append_step(_ctx, "WORKDIR", dir)
}

tag(_ctx: ptr, t: string) {
    _e = map.put(_ctx, "tag", t)
}

// copy(src, dst) — dual-write: the "copies" key (artifact-packaging path)
// AND an ordered COPY step (full-recipe path).
copy(_ctx: ptr, src: string, dst: string) {
    entry = string.concat(src, ":")
    entry = string.concat(entry, dst)
    if map.has(_ctx, "copies") == 1 {
        prev, _ = map.get(_ctx, "copies")
        combined = string.concat(prev, "\n")
        combined = string.concat(combined, entry)
        _e1 = map.put(_ctx, "copies", combined)
    } else {
        _e2 = map.put(_ctx, "copies", entry)
    }
    cp_payload = string.concat(src, " ")
    cp_payload = string.concat(cp_payload, dst)
    _append_step(_ctx, "COPY", cp_payload)
}

dockerfile(_ctx: ptr, path: string) {
    _e = map.put(_ctx, "dockerfile", path)
}

// --- Full-recipe DSL setters (Containerfile lines inline) ---
// These let a .build.ae/.dist.ae express a whole Dockerfile as aeb grammar
// instead of pointing at a hand-written file: from() + repeatable run() +
// expose(), etc. When from()/run() is present, container.image generates a
// FULL recipe Dockerfile (dockerfile_full_content) in declared order rather
// than the artifact-packaging default. Single-arg-per-call (Aether is
// fixed-arity); repeated calls append.
//
// Ordering is load-bearing: run/workdir/copy interleave (a RUN must see the
// WORKDIR set before it), so they accumulate into ONE ordered "recipe_steps"
// string, each line "TYPE\tpayload", rendered in order.

// from(img) — the base image. Synonym for base() but named for the
// full-recipe idiom (and it flips image() into recipe mode).
from(_ctx: ptr, img: string) {
    _e = map.put(_ctx, "base", img)
    _e2 = map.put(_ctx, "recipe", "1")
}

// arg(name, default) — a build-time ARG with a default. Repeatable.
arg(_ctx: ptr, name: string, default_val: string) {
    entry = string.concat(name, "=")
    entry = string.concat(entry, default_val)
    if map.has(_ctx, "args") == 1 {
        prev, _ = map.get(_ctx, "args")
        combined = string.concat(prev, "\n")
        combined = string.concat(combined, entry)
        _e1 = map.put(_ctx, "args", combined)
    } else {
        _e2 = map.put(_ctx, "args", entry)
    }
}

// run_step(cmd) — a RUN step. Repeatable; emitted in call order. cmd is the
// literal shell line (chain with && as in a Containerfile). NOT named `run`:
// `container.run` is already a BUILDER, and a builder + a function sharing a
// name mangle to the same symbol (container_run) — a silent shadow pre-0.178,
// a hard error after. See LLM.md "builder-vs-function name collision".
run_step(_ctx: ptr, cmd: string) {
    _append_step(_ctx, "RUN", cmd)
    _e = map.put(_ctx, "recipe", "1")
}

// expose(port) — an EXPOSE step. Repeatable.
expose(_ctx: ptr, p: string) {
    if map.has(_ctx, "ports") == 1 {
        prev, _ = map.get(_ctx, "ports")
        combined = string.concat(prev, " ")
        combined = string.concat(combined, p)
        _e1 = map.put(_ctx, "ports", combined)
    } else {
        _e2 = map.put(_ctx, "ports", p)
    }
}

// _append_step(ctx, type_word, payload) — push one ordered recipe step.
// Steps are joined by RS (\x1e), NOT newline: a run_step() payload can be a
// multi-line heredoc (Dockerfile RUN with \-continuations), whose internal
// newlines would otherwise be mistaken for the step separator. RS can't
// occur in shell content, so it's a safe record delimiter.
_append_step(_ctx: ptr, type_word: string, payload: string) {
    entry = string.concat(type_word, "\t")
    entry = string.concat(entry, payload)
    if map.has(_ctx, "recipe_steps") == 1 {
        prev, _ = map.get(_ctx, "recipe_steps")
        combined = string.concat(prev, "\x1e")
        combined = string.concat(combined, entry)
        _e1 = map.put(_ctx, "recipe_steps", combined)
    } else {
        _e2 = map.put(_ctx, "recipe_steps", entry)
    }
}

// --- LXC DSL setters ---

template(_ctx: ptr, t: string) {
    _e = map.put(_ctx, "template", t)
}

lxc_name(_ctx: ptr, n: string) {
    _e = map.put(_ctx, "lxc_name", n)
}

// --- container.run DSL setters ---
// First slice of the container-as-step grammar: run a one-shot
// container and capture its pid-1 stdout back into aeb.

image_ref(_ctx: ptr, r: string) {
    _e = map.put(_ctx, "image_ref", r)
}

command(_ctx: ptr, c: string) {
    _e = map.put(_ctx, "command", c)
}

// --- Command builders (public, testable) ---

// Generate a Dockerfile string from options
dockerfile_content(artifact_path: string, opts: ptr) {
    base_img = "debian:bookworm-slim"
    if opts != null {
        if map.has(opts, "base") == 1 {
            base_img, _ = map.get(opts, "base")
        }
    }
    df = string.concat("FROM ", base_img)
    df = string.concat(df, "\n")

    // Workdir
    wd = "/app"
    if opts != null {
        if map.has(opts, "workdir") == 1 {
            wd, _ = map.get(opts, "workdir")
        }
    }
    df = string.concat(df, "WORKDIR ")
    df = string.concat(df, wd)
    df = string.concat(df, "\n")

    // Explicit copies
    if opts != null {
        if map.has(opts, "copies") == 1 {
            copies, _ = map.get(opts, "copies")
            cl_raw, _e1 = build._sh_capture("echo '${copies}' | while IFS=: read -r s d; do echo \"COPY $s $d\"; done")
            copy_lines = string.trim(cl_raw)
            df = string.concat(df, copy_lines)
            df = string.concat(df, "\n")
        }
    }

    // Default artifact copy (if no explicit copies)
    if opts == null {
        df = string.concat(df, "COPY ")
        df = string.concat(df, artifact_path)
        df = string.concat(df, " ")
        df = string.concat(df, wd)
        df = string.concat(df, "/\n")
    } else {
        if map.has(opts, "copies") == 0 {
            df = string.concat(df, "COPY ")
            df = string.concat(df, artifact_path)
            df = string.concat(df, " ")
            df = string.concat(df, wd)
            df = string.concat(df, "/\n")
        }
    }

    // Env vars
    if opts != null {
        if map.has(opts, "env_vars") == 1 {
            env_raw, _ = map.get(opts, "env_vars")
            el_raw, _e2 = build._sh_capture("echo '${env_raw}' | while IFS='=' read -r k v; do echo \"ENV $k=$v\"; done")
            env_lines = string.trim(el_raw)
            df = string.concat(df, env_lines)
            df = string.concat(df, "\n")
        }
    }

    // Ports
    if opts != null {
        if map.has(opts, "ports") == 1 {
            ports, _ = map.get(opts, "ports")
            pl_raw, _e3 = build._sh_capture("echo '${ports}' | tr ' ' '\n' | while read -r p; do echo \"EXPOSE $p\"; done")
            port_lines = string.trim(pl_raw)
            df = string.concat(df, port_lines)
            df = string.concat(df, "\n")
        }
    }

    // Entrypoint
    if opts != null {
        if map.has(opts, "entrypoint") == 1 {
            ep, _ = map.get(opts, "entrypoint")
            df = string.concat(df, "ENTRYPOINT ")
            df = string.concat(df, ep)
            df = string.concat(df, "\n")
        }
    }

    return df
}

// _next_field(s, from, sep) -> (field, next_from). Pull one `sep`-delimited
// field starting at byte `from`; next_from = index past the separator, or -1
// at end. Self-contained (no extern). `sep` is "\n" for the single-line maps
// (args/env) and "\x1e" (RS) for recipe_steps (whose payloads may themselves
// contain newlines — a multi-line heredoc RUN).
_next_field(s: string, from: int, sep: string) {
    n = string.length(s)
    if from >= n { return "", -1 }
    nl = string.index_of_from(s, sep, from)
    if nl < 0 {
        return string.substring(s, from, n), -1
    }
    return string.substring(s, from, nl), nl + string.length(sep)
}

// dockerfile_full_content(opts) — generate a COMPLETE recipe Dockerfile from
// the full-recipe setters (from/arg/run/env/expose/entrypoint), emitted in
// this order: FROM, ARG*, the ordered recipe_steps (RUN etc. in call order —
// ordering is load-bearing), ENV*, EXPOSE*, ENTRYPOINT. The "Containerfile
// lines inline" path; chosen by image() when opts has "recipe" set.
dockerfile_full_content(opts: ptr) {
    base_img = "debian:trixie-slim"
    if map.has(opts, "base") == 1 { base_img, _ = map.get(opts, "base") }
    df = string.concat("FROM ", base_img)
    df = string.concat(df, "\n")

    // ARG name=default (one per line, in call order)
    if map.has(opts, "args") == 1 {
        args_s, _ = map.get(opts, "args")
        pos = 0
        while pos >= 0 {
            line, nxt = _next_field(args_s, pos, "\n")
            if string.length(line) > 0 {
                df = string.concat(df, "ARG ")
                df = string.concat(df, line)
                df = string.concat(df, "\n")
            }
            pos = nxt
        }
    }

    // Ordered recipe steps: "TYPE\tpayload" per RS-delimited record (the
    // payload may itself be multi-line), rendered in call order.
    if map.has(opts, "recipe_steps") == 1 {
        steps_s, _ = map.get(opts, "recipe_steps")
        pos = 0
        while pos >= 0 {
            line, nxt = _next_field(steps_s, pos, "\x1e")
            if string.length(line) > 0 {
                tabi = string.index_of(line, "\t")
                if tabi > 0 {
                    type_word = string.substring(line, 0, tabi)
                    payload = string.substring(line, tabi + 1, string.length(line))
                    df = string.concat(df, type_word)
                    df = string.concat(df, " ")
                    df = string.concat(df, payload)
                    df = string.concat(df, "\n")
                }
            }
            pos = nxt
        }
    }

    // ENV k=v
    if map.has(opts, "env_vars") == 1 {
        env_s, _ = map.get(opts, "env_vars")
        pos = 0
        while pos >= 0 {
            line, nxt = _next_field(env_s, pos, "\n")
            if string.length(line) > 0 {
                df = string.concat(df, "ENV ")
                df = string.concat(df, line)
                df = string.concat(df, "\n")
            }
            pos = nxt
        }
    }

    // EXPOSE (space-separated ports → one EXPOSE per port)
    if map.has(opts, "ports") == 1 {
        ports_s, _ = map.get(opts, "ports")
        pos = 0
        while pos >= 0 {
            sp = string.index_of_from(ports_s, " ", pos)
            tok = ""
            nxt = -1
            if sp < 0 {
                tok = string.substring(ports_s, pos, string.length(ports_s))
            } else {
                tok = string.substring(ports_s, pos, sp)
                nxt = sp + 1
            }
            if string.length(tok) > 0 {
                df = string.concat(df, "EXPOSE ")
                df = string.concat(df, tok)
                df = string.concat(df, "\n")
            }
            pos = nxt
        }
    }

    // ENTRYPOINT (verbatim — JSON-array or shell form, caller's choice)
    if map.has(opts, "entrypoint") == 1 {
        ep, _ = map.get(opts, "entrypoint")
        df = string.concat(df, "ENTRYPOINT ")
        df = string.concat(df, ep)
        df = string.concat(df, "\n")
    }

    return df
}

// Build the podman/docker build command
image_build_cmd(image_tag: string, context_dir: string, dockerfile_path: string, opts: ptr) {
    eng = "podman"
    if opts != null {
        if map.has(opts, "engine") == 1 {
            eng, _ = map.get(opts, "engine")
        }
    }
    cmd = string.concat(eng, " build")
    cmd = string.concat(cmd, " -t ")
    cmd = string.concat(cmd, image_tag)
    cmd = string.concat(cmd, " -f ")
    cmd = string.concat(cmd, dockerfile_path)

    if opts != null {
        if map.has(opts, "extra") == 1 {
            val, _ = map.get(opts, "extra")
            cmd = string.concat(cmd, " ")
            cmd = string.concat(cmd, val)
        }
    }

    cmd = string.concat(cmd, " ")
    cmd = string.concat(cmd, context_dir)
    return cmd
}

// Build the lxc-create command
lxc_create_cmd(name: string, opts: ptr) {
    tmpl = "download"
    if opts != null {
        if map.has(opts, "template") == 1 {
            tmpl, _ = map.get(opts, "template")
        }
    }
    cmd = string.concat("lxc-create -n ", name)
    cmd = string.concat(cmd, " -t ")
    cmd = string.concat(cmd, tmpl)

    if opts != null {
        if map.has(opts, "extra") == 1 {
            val, _ = map.get(opts, "extra")
            cmd = string.concat(cmd, " -- ")
            cmd = string.concat(cmd, val)
        }
    }

    return cmd
}

// Build the one-shot `<engine> run` command. `--rm` makes the
// container ephemeral; a `command` from opts is appended as the
// container's argv, overriding the image's default CMD. Pure string
// assembly — unit-tested in tests/test_container_run_cmd.ae.
container_run_cmd(img: string, opts: ptr) {
    eng = "podman"
    if opts != null {
        if map.has(opts, "engine") == 1 {
            eng, _ = map.get(opts, "engine")
        }
    }
    cmd_str = ""
    if opts != null {
        if map.has(opts, "command") == 1 {
            cmd_str, _ = map.get(opts, "command")
        }
    }
    out = string.concat(eng, " run --rm ")
    out = string.concat(out, img)
    if string.length(cmd_str) > 0 {
        out = string.concat(out, " ")
        out = string.concat(out, cmd_str)
    }
    return out
}

// --- SDK functions ---

builder image(ctx: ptr): int {
    root, _ = map.get(ctx, "root")
    target_dir, _ = map.get(ctx, "target_dir")
    mod_dir, _ = map.get(ctx, "module_dir")
    mod_name, _ = map.get(ctx, "module")

    println("${mod_dir}: building container image")

    // Determine tag
    img_tag = mod_name
    if _builder != null {
        if map.has(_builder, "tag") == 1 {
            _t, _ = map.get(_builder, "tag")
            img_tag = _t
        }
    }

    // Detect artifact to package
    artifact = ""
    jar_pat = path.join(target_dir, "bin/*.jar")
    jl_raw, _e1 = build._sh_capture("ls ${jar_pat} 2>/dev/null | head -1")
    jar_list = string.trim(jl_raw)
    if string.length(jar_list) > 0 {
        artifact = jar_list
        // Auto-set base and entrypoint for Java if user provided a config block
        if _builder != null {
            if map.has(_builder, "base") == 0 {
                _e2 = map.put(_builder, "base", "eclipse-temurin:21-jre-alpine")
            }
            if map.has(_builder, "entrypoint") == 0 {
                jn_raw, _e3 = build._sh_capture("basename ${jar_list}")
                jar_name = string.trim(jn_raw)
                ep = string.concat("[\"java\", \"-jar\", \"/app/", jar_name)
                ep = string.concat(ep, "\"]")
                _e4 = map.put(_builder, "entrypoint", ep)
            }
        }
    }

    // Use custom Dockerfile if provided, otherwise generate one
    df_path = ""
    if _builder != null {
        if map.has(_builder, "dockerfile") == 1 {
            df_path, _ = map.get(_builder, "dockerfile")
        }
    }
    if string.length(df_path) == 0 {
        df_path = path.join(target_dir, "Dockerfile")
        // Full-recipe mode (from()/run() called) generates a complete
        // Containerfile from the inline DSL; otherwise the artifact-
        // packaging default (FROM + COPY + ENTRYPOINT).
        is_recipe = 0
        if _builder != null {
            if map.has(_builder, "recipe") == 1 { is_recipe = 1 }
        }
        df_content = ""
        if is_recipe == 1 {
            df_content = dockerfile_full_content(_builder)
        } else {
            df_content = dockerfile_content(artifact, _builder)
        }
        _e5 = io.write_file(df_path, df_content)
    }

    // Emit-only mode: write the Dockerfile and STOP — do not `podman build`.
    // This is the IMMUTABLE-HOST ADAPTER (docs/containment-and-the-control-
    // plane.md): on a host with no toolchain (Bazzite/Atomic), aeb can't be
    // the outermost container, so it runs where the toolchain IS — a dev box,
    // CI, a mutable peer — to GENERATE the Dockerfile from the inline DSL,
    // and a podman-only host builds it. aeb still owns the recipe end-to-end;
    // it just can't be co-resident with `podman build`. The grammar degrades
    // (image = generate-not-build) rather than failing. Gated by env (an
    // operator/CI choice, not a property of the recipe), so a plain local
    // `aeb <image>.ae` on a mutable host still builds as before.
    emit_only = os.getenv("AEB_CONTAINER_EMIT_ONLY")
    if string.length(emit_only) > 0 {
        // If the env value looks like a path (not just "1"/"true"), ALSO copy
        // the generated Dockerfile there — so a caller controls the output
        // location regardless of aeb's target-dir (which, under itests/,
        // currently mis-bins to target/tests/ — a separate lib/build bug).
        // The script-friendly contract: AEB_CONTAINER_EMIT_ONLY=/abs/path.
        out_path = df_path
        if string.index_of(emit_only, "/") >= 0 {
            out_dir = path.dirname(emit_only)
            if string.length(out_dir) > 0 { build._sh(string.concat("mkdir -p '", string.concat(out_dir, "'"))) }
            _cp = build._sh(string.concat(string.concat("cp '", df_path), string.concat("' '", string.concat(emit_only, "'"))))
            out_path = emit_only
        }
        println("${mod_dir}: emit-only — wrote Dockerfile to ${out_path} (skipping podman build)")
        return 0
    }

    // Build image
    build_cmd = image_build_cmd(img_tag, root, df_path, _builder)
    exit_code = build._sh(build_cmd)
    if exit_code != 0 {
        // build.fail is the channel the orchestrator actually reads — a bare
        // `return exit_code` is silently discarded (see gen-orchestrator),
        // which is why a failed `podman build` used to report a green build.
        fail(ctx, string.concat("container build failed (podman build exit ", string.concat(string.from_int(exit_code), ")")))
        println("${mod_dir}: container build failed")
        return exit_code
    }
    println("${mod_dir}: built image ${img_tag}")
    return 0
}

builder lxc(ctx: ptr): int {
    mod_dir, _ = map.get(ctx, "module_dir")
    mod_name, _ = map.get(ctx, "module")

    name = mod_name
    if _builder != null {
        if map.has(_builder, "lxc_name") == 1 {
            name, _ = map.get(_builder, "lxc_name")
        }
    }

    println("${mod_dir}: creating LXC container ${name}")
    cmd = lxc_create_cmd(name, _builder)
    exit_code = build._sh(cmd)
    if exit_code != 0 {
        println("${mod_dir}: lxc-create failed")
        return exit_code
    }
    println("${mod_dir}: created LXC container ${name}")
    return 0
}

// container.run — run a one-shot container and capture its pid-1
// stdout. `<engine> run` in the foreground attaches the container's
// pid-1 stdout to ours, so os.exec hands the bytes straight back.
//
// RETURNS the captured (trimmed) stdout as a string. A .build.ae
// looks declarative, but its body is ordinary imperative Aether — so
// an author can bind the result and branch on it:
//
//     out = container.run(b) { image_ref("alpine") command("uname") }
//     if string.index_of(out, "Linux") >= 0 { ... }
//
// The capture is also mirrored to a target-dir artifact
// (container-stdout.txt) and printed. On misconfiguration (no
// image_ref) it returns "" after printing the error.
//
// First slice of the container-as-step grammar; setters so far:
// image_ref(), command().
// NOTE: this builder is deliberately NOT `: int`. Unlike every other SDK
// builder (which returns an rc and can be a node's tail-call), container.run
// is an EXPRESSION builder: `out = container.run(b) { ... }` yields the
// container's captured stdout as a STRING. It is never a node's rc-bearing
// tail, so it stays out of the `: int` contract the node-return fix relies on
// (asks/node-nonzero-return-not-propagated-to-exit-code.md). Typing it `: int`
// coerces its string returns to int and segfaults consumers.
builder run(ctx: ptr) {
    mod_dir, _ = map.get(ctx, "module_dir")
    target_dir, _ = map.get(ctx, "target_dir")

    // When a builder-with-block is used as an expression
    // (out = container.run(b) { ... }), the closure-DSL invokes the
    // builder once with _builder still null, before the block has
    // populated it. Guard that pre-call: return "" with no side
    // effects so only the real, populated invocation runs anything.
    if _builder == null {
        return ""
    }
    img = ""
    if map.has(_builder, "image_ref") == 1 {
        img, _ = map.get(_builder, "image_ref")
    }
    if string.length(img) == 0 {
        println("${mod_dir}: container.run requires image_ref(\"<image>\")")
        return ""
    }

    run_cmd = container_run_cmd(img, _builder)
    println("${mod_dir}: container.run ${run_cmd}")

    out, _ = build._sh_capture(run_cmd)
    captured = string.trim(out)

    _mk = build._sh("mkdir -p ${target_dir}")
    outfile = path.join(target_dir, "container-stdout.txt")
    _w = io.write_file(outfile, captured)

    println("${mod_dir}: container stdout [${captured}] -> ${outfile}")
    return captured
}
