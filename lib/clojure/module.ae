// clojure — Clojure SDK for aether.build
//
// Compiles Clojure source via java+clojure.jar and runs tests
// via clojure.test (built into Clojure). Maven deps are resolved
// via the maven module (Clojure uses Maven coordinates).
import bldr
import cache
import maven
import std.string
import std.io
import std.os
import std.file
import std.fs
import std.list
import std.map
import std.path
import std.dir

// --- DSL setters ---

main_ns(_ctx: ptr, ns: string) {
    _e = map.put(_ctx, "main_ns", ns)
}

// min_jdk(22) — a HARD REQUIREMENT: run_main runs on a JDK >= this major and
// FAILS if none is installed (a requested-but-absent JDK is a misconfiguration,
// not a state to be green in). Clojure needs no compile step (clojure.main loads
// namespaces from source), so only the JVM floor matters, and the runtime is
// discovered (CLI or jars), not probe-compiled. Unset → ambient `java`. For a
// portable matrix that should SKIP on under-provisioned boxes, use
// skip_below_jdk.
min_jdk(_ctx: ptr, ver: string) {
    _e = map.put(_ctx, "clojure_min_jdk", ver)
}

// skip_below_jdk(22) — PORTABLE-FLEET floor: run on a JDK >= this major, but
// SKIP (green) rather than fail when the box has none. Soft counterpart to
// min_jdk; min_jdk wins if both are set.
skip_below_jdk(_ctx: ptr, ver: string) {
    _e = map.put(_ctx, "clojure_skip_below_jdk", ver)
}

// jvm_flag("--enable-native-access=ALL-UNNAMED") — one extra flag for the JVM
// that runs the namespace (repeatable). Threaded to both the raw-java and the
// CLI (via JAVA_OPTS) launch paths.
jvm_flag(_ctx: ptr, flag: string) {
    if map.has(_ctx, "jvm_flag") == 0 {
        _e1 = map.put(_ctx, "jvm_flag", list.new())
    }
    flags, _ = map.get(_ctx, "jvm_flag")
    _e2 = list.add(flags, flag)
}

test_timeout(_ctx: ptr, seconds: string) {
    _e = map.put(_ctx, "test_timeout", seconds)
}

// source_layout("maven idiomatic") — sources at src/main/clojure and
// src/test/clojure (Maven), instead of the default lein-style src/ + test/.
source_layout(_ctx: ptr, layout: string) {
    _e = map.put(_ctx, "source_layout", layout)
}

// output_jar("app.jar") — name of the uberjar produced by
// `clojure.uberjar(b)`. Resolved against `target/<mod>/bin/`.
// Default when unset: `<source_dir_basename>-standalone.jar`
// (mirrors leiningen's `-standalone.jar` convention). Scalar.
output_jar(_ctx: ptr, name: string) {
    _e = map.put(_ctx, "clojure_output_jar", name)
}

// --- Command builders (pure) ---

// clj_aot_compile_cmd — assemble a `clojure.main -e "(compile 'ns)"`
// invocation for AOT compilation. Pure: caller resolves the classpath
// and the namespace symbol.
clj_aot_compile_cmd(classes_dir: string, classpath: string, ns: string) {
    return "java -Dclojure.compile.path='${classes_dir}' -cp '${classpath}' clojure.main -e \"(compile '${ns})\""
}

// clj_load_check_cmd — assemble a clojure.main invocation that just
// verifies the sources load. Pure.
clj_load_check_cmd(classpath: string) {
    return "java -cp '${classpath}' clojure.main -e \"(println :ok)\""
}

// clj_test_cmd — assemble a clojure.test runner invocation. Pure:
// caller pre-builds the quoted-namespace list. test_timeout is
// the seconds string (or "" to skip the `timeout` prefix).
clj_test_cmd(classpath: string, quoted_namespaces: string, test_timeout: string) {
    expr = "(require ${quoted_namespaces}) (let [r (clojure.test/run-tests ${quoted_namespaces})] (System/exit (+ (:fail r) (:error r))))"
    cmd = "java -cp '${classpath}' clojure.main -e \"${expr}\""
    if string.length(test_timeout) > 0 {
        cmd = string.concat("timeout ${test_timeout} ", cmd)
    }
    return cmd
}

// uber_unzip_jar_cmd — unzip one classpath .jar into the staging
// dir. `unzip -qq -o` quiet + overwrite. Pure.
uber_unzip_jar_cmd(jar_src: string, stage_dir: string) {
    return "unzip -qq -o '${jar_src}' -d '${stage_dir}'"
}

// uber_copy_tree_cmd — mirror a directory's contents into the
// staging dir (`cp -a <dir>/. <stage>/`). Used for AOT classes and
// for source roots that ship inside the uberjar so non-AOT
// namespaces load at runtime. Pure.
uber_copy_tree_cmd(src_dir: string, stage_dir: string) {
    return "cp -a '${src_dir}/.' '${stage_dir}/'"
}

// uber_jar_cmd — `jar cfM <out> -C <stage> .`. `M` skips
// auto-manifest (the caller stages a hand-written MANIFEST.MF under
// stage/META-INF/). Pure.
uber_jar_cmd(jar_path: string, stage_dir: string) {
    return "jar cfM '${jar_path}' -C '${stage_dir}' ."
}

// _ns_to_main_class(ns) — Clojure munges a namespace's `-main`
// gen-class into a Java class whose name replaces `-` with `_` in
// each segment. `my-app.core` -> `my_app.core`. Dots stay dots
// (package separators); only dashes are munged. Pure char-walk
// (stdlib has no string.replace).
_ns_to_main_class(ns: string) {
    out = ""
    n = string.length(ns)
    i = 0
    while i < n {
        ch = string.substring(ns, i, i + 1)
        if string.equals(ch, "-") == 1 {
            out = string.concat(out, "_")
        } else {
            out = string.concat(out, ch)
        }
        i = i + 1
    }
    return out
}

// _ends_with_jar(s) — return 1 iff `s` ends in ".jar". Pure.
_ends_with_jar(s: string) {
    sl = string.length(s)
    if sl < 4 { return 0 }
    tail = string.substring(s, sl - 4, sl)
    if string.equals(tail, ".jar") == 1 { return 1 }
    return 0
}

// --- Internal helpers ---

// Collect source paths from dep modules (Clojure needs source dirs on classpath)
_dep_src_classpath(ctx: ptr) {
    deps, _ = map.get(ctx, "deps")
    cp = ""
    count = list.size(deps)
    i = 0
    while i < count {
        dp, _ = list.get(deps, i)
        dm = bldr._strip_lang(dp)
        dep_src = bldr._read_dep_artifact(ctx, dm, "clojure_src_path")
        cp = bldr._cp_append(cp, dep_src)
        i = i + 1
    }
    return cp
}

// --- SDK functions ---

// Compile Clojure sources.
// _clj_java_version() — `java -version` first line, memoised per build.
// AOT runs `java ... clojure.main`, so the JVM version is a real
// bytecode-target invalidator. Returns "" when java is absent.
_clj_java_version() {
    cached = os.getenv("_AEB_JAVA_VERSION_CACHE")
    if string.length(cached) > 0 { return cached }
    raw, _err = bldr._sh_capture("java -version 2>&1 | head -1")
    return string.trim(raw)
}

// _cache_key_for_clj — cache key for a Clojure AOT compile (only the
// main_ns branch produces a cacheable classes/ tree). Inputs
// (length-prefixed, sorted via cache.hash_inputs):
//   - java version — AOT bytecode-target invalidator
//   - the maven classpath string — embeds the pinned Clojure jar
//     version + every resolved dep, so a clojure or dep bump busts it
//   - the AOT namespace
//   - canonical AOT command string
//   - each .clj source's path + content hash, sorted by path
//   - each dep's clojure_src_path artifact content (upstream sources)
//
// Returns ("", err) on any source read failure.
_cache_key_for_clj(ctx: ptr, argfile_path: string, aot_cmd_str: string, maven_cp: string, ns: string) {
    parts = list.new()

    list.add(parts, string.concat("java:", _clj_java_version()))
    list.add(parts, string.concat("clj-mavencp:", maven_cp))
    list.add(parts, string.concat("ns:", ns))
    list.add(parts, string.concat("cmd:", aot_cmd_str))

    sources = bldr._read_argfile_lines(argfile_path)
    nsrc = list.size(sources)
    si = 0
    while si < nsrc {
        src, _ = list.get(sources, si)
        sh, serr = cache.hash_file(src)
        if string.length(serr) > 0 {
            return "", serr
        }
        list.add(parts, string.concat("src:", src))
        list.add(parts, string.concat("src-hash:", sh))
        si = si + 1
    }

    deps, _ = map.get(ctx, "deps")
    dn = list.size(deps)
    di = 0
    while di < dn {
        dp, _ = list.get(deps, di)
        dm = bldr._strip_lang(dp)
        dep_src = bldr._read_dep_artifact(ctx, dm, "clojure_src_path")
        if string.length(dep_src) > 0 {
            list.add(parts, string.concat("dep:", dm))
            list.add(parts, string.concat("dep-src:", dep_src))
        }
        di = di + 1
    }

    digest, derr = cache.hash_inputs(parts)
    return digest, derr
}

// If main_ns is set, AOT compiles to .class files.
// Otherwise validates sources are loadable.
builder compile(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")

    classes_dir = path.join(target_dir, "classes")
    bldr._mkdirs(classes_dir)

    println("${mod_dir}: compiling (clojure)")

    src_root = path.join(source_dir, "src")
    if _builder != null {
        if map.has(_builder, "source_layout") == 1 {
            lay, _ = map.get(_builder, "source_layout")
            if lay == "maven idiomatic" { src_root = path.join(source_dir, "src/main/clojure") }
        }
    }

    // Write source path artifact for downstream modules (include transitive dep sources)
    all_src = src_root
    dep_src = _dep_src_classpath(ctx)
    if string.length(dep_src) > 0 {
        tmp_a = string.concat(all_src, ":")
        all_src = string.concat(tmp_a, dep_src)
    }
    bldr._write_artifact(ctx, "clojure_src_path", all_src)

    // JVM jar deps from bldr.dep'd modules (clojure runtime + any cross-language
    // component like a Java binding the ns :imports). Republished below so a
    // dependent test node inherits them by depping THIS build node alone.
    jvm_dep_cp = bldr._build_dep_classpath(ctx)
    if string.length(jvm_dep_cp) > 0 {
        nl_raw, _enl = bldr._sh_capture("printf '%s' '${jvm_dep_cp}' | tr ':' '\n'")
        bldr._write_artifact(ctx, "jvm_classpath_deps_including_transitive", string.trim(nl_raw))
    }

    // Build classpath: own src + classes + dep src + jvm jars + maven deps
    cp = src_root
    cp = bldr._cp_append(cp, classes_dir)
    cp = bldr._cp_append(cp, dep_src)
    cp = bldr._cp_append(cp, jvm_dep_cp)
    maven_cp = maven.classpath(ctx)
    cp = bldr._cp_append(cp, maven_cp)

    // AOT compile if main_ns is set
    if _builder != null {
        if map.has(_builder, "main_ns") == 1 {
            ns, _ = map.get(_builder, "main_ns")
            cmd = clj_aot_compile_cmd(classes_dir, cp, ns)

            // Source set for the cache key (every .clj under src/).
            argfile = path.join(target_dir, "clj_sources.txt")
            bldr._sh("find '${src_root}' -name '*.clj' > '${argfile}' 2>/dev/null || true")

            // Cache check: restore the AOT classes/ tree on hit.
            cache_key = ""
            exit_code = -1
            if cache.available() == 1 {
                ck, kerr = _cache_key_for_clj(ctx, argfile, cmd, maven_cp, ns)
                if string.length(kerr) == 0 {
                    cache_key = ck
                    tmp_raw, _terr = bldr._sh_capture("mktemp")
                    tmp_tar = bldr._to_native_path(string.trim(tmp_raw))
                    if string.length(tmp_tar) > 0 {
                        grc = cache.get(cache_key, tmp_tar)
                        if string.length(grc) == 0 {
                            uerr = bldr._untar_into(tmp_tar, classes_dir)
                            bldr._sh("rm -f '${tmp_tar}'")
                            if string.length(uerr) == 0 {
                                println("${mod_dir}: clojure AOT cache hit ${cache_key}")
                                bldr._record_cache(ctx, "hit")
                                exit_code = 0
                            } else {
                                bldr._sh("rm -rf '${classes_dir}'")
                                bldr._mkdirs(classes_dir)
                            }
                        } else {
                            bldr._sh("rm -f '${tmp_tar}'")
                        }
                    }
                }
            }

            if exit_code == -1 {
                if cache.available() == 0 {
                    bldr._record_cache(ctx, "unavailable")
                } else {
                    bldr._record_cache(ctx, "miss")
                }
                exit_code = bldr._sh(cmd)
                if exit_code != 0 {
                    println("${mod_dir}: clojure AOT compilation failed")
                    bldr.fail(ctx, "clojure AOT compilation failed")
                    return exit_code
                }
                if string.length(cache_key) > 0 {
                    tar_path, terr = bldr._tar_dir(classes_dir)
                    if string.length(terr) == 0 {
                        perr = cache.put(cache_key, tar_path)
                        bldr._sh("rm -f '${tar_path}'")
                        if string.length(perr) > 0 {
                            println("${mod_dir}: clojure AOT cache write failed: ${perr}")
                        }
                    }
                }
            }

            _e1 = io.write_file(path.join(target_dir, ".timestamp"), "")
            return 0
        }
    }

    // No main_ns — load-check by REQUIRING every namespace under src_root, so a
    // compile error in the binding's own code fails the BUILD, not just tests.
    discover = "find '${src_root}' -name '*.clj' -type f"
    discover = string.concat(discover, " | sed 's|^${src_root}/||; s|/|.|g; s|_|-|g; s|\\.clj$||'")
    ns_raw, _ed = bldr._sh_capture(discover)
    ns_list = string.trim(ns_raw)
    if string.length(ns_list) == 0 {
        _e0 = io.write_file(path.join(target_dir, ".timestamp"), "")
        return 0
    }
    quoted_raw, _eq2 = bldr._sh_capture("echo '${ns_list}' | sed \"s/^/'/; s/$/ /\" | tr -d '\\n'")
    quoted = string.trim(quoted_raw)
    cmd = "java -cp '${cp}' clojure.main -e \"(require ${quoted})\""
    exit_code = bldr._sh(cmd)
    if exit_code != 0 {
        println("${mod_dir}: clojure load-check failed")
        bldr.fail(ctx, "clojure load-check failed")
        return exit_code
    }

    _e2 = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// Run Clojure tests via clojure.test.
// Discovers *_test.clj files, converts paths to namespace names,
// requires and runs them.
// _clojure_runtime_jars() — a classpath of clojure + spec.alpha +
// core.specs.alpha jars, newest first, from $CLOJURE_JARS then ~/.m2 / gradle
// caches. Returns "" when the three aren't found together (the runtime won't
// boot without spec.alpha). Mirrors run-tests.sh candidate #1/#3. The CLI
// (candidate #2) is handled separately since it supplies its own runtime.
_clojure_runtime_jars() {
    env_dir = os.getenv("CLOJURE_JARS")
    if string.length(env_dir) > 0 {
        raw, _e = bldr._sh_capture("ls '${env_dir}'/*.jar 2>/dev/null | tr '\n' ':'")
        c = string.trim(raw)
        if string.length(c) > 0 { return c }
    }
    // A self-contained system clojure jar (Debian's clojure-1.11.jar bundles
    // the runtime + spec) — the wrapper resolves to `java -cp <this> clojure.main`,
    // so pointing our OWN verified `java` at it is cleaner than the wrapper (it
    // hardcodes its own java and drops jvm flags). Checked before the m2 trio.
    sys_raw, _es = bldr._sh_capture("ls /usr/share/java/clojure-*.jar /usr/share/java/clojure.jar 2>/dev/null | grep -v sources | sort -Vr | head -1")
    sys = string.trim(sys_raw)
    if string.length(sys) > 0 { return sys }

    // clojure-<ver>.jar + its two spec deps, all three or nothing.
    cj_raw, _e1 = bldr._sh_capture("ls $HOME/.m2/repository/org/clojure/clojure/*/clojure-*.jar $HOME/.gradle/caches/modules-2/files-2.1/org.clojure/clojure/*/*/clojure-*.jar 2>/dev/null | grep -v sources | sort -Vr | head -1")
    cj = string.trim(cj_raw)
    if string.length(cj) == 0 { return "" }
    sa_raw, _e2 = bldr._sh_capture("ls $HOME/.m2/repository/org/clojure/spec.alpha/*/spec.alpha-*.jar $HOME/.gradle/caches/modules-2/files-2.1/org.clojure/spec.alpha/*/*/spec.alpha-*.jar 2>/dev/null | grep -v sources | sort -Vr | head -1")
    sa = string.trim(sa_raw)
    cs_raw, _e3 = bldr._sh_capture("ls $HOME/.m2/repository/org/clojure/core.specs.alpha/*/core.specs.alpha-*.jar $HOME/.gradle/caches/modules-2/files-2.1/org.clojure/core.specs.alpha/*/*/core.specs.alpha-*.jar 2>/dev/null | grep -v sources | sort -Vr | head -1")
    cs = string.trim(cs_raw)
    if string.length(sa) == 0 { return "" }
    if string.length(cs) == 0 { return "" }
    return string.concat(cj, string.concat(":", string.concat(sa, string.concat(":", cs))))
}

// _clojure_cli() — the `clojure` or `clj` CLI path, or "". It brings its own
// runtime, so it's the fallback when no jars are found.
_clojure_cli() {
    c, _e = bldr._sh_capture("command -v clojure 2>/dev/null || command -v clj 2>/dev/null")
    return string.trim(c)
}

// clojure.run_main(b) — run a Clojure `-main` namespace as a conformance suite,
// with no AOT (clojure.main loads from source). The SDK-native form of
// html-sanitizer's clojure/run-tests.sh: a JDK-floor gate + SKIP, Clojure
// runtime discovery (jars or CLI), and the -m launch with the dep classpath.
//
// Setters: main_ns("org.htmlsanitizer.conformance-test") (required),
// min_jdk(22), jvm_flag("--enable-native-access=ALL-UNNAMED"),
// source_layout(...) (src/test roots). deps supply the Java-binding classpath.
builder run_main(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")
    bldr._mkdirs(target_dir)

    mns = ""
    if _builder != null {
        if map.has(_builder, "main_ns") == 1 { mns, _ = map.get(_builder, "main_ns") }
    }
    if string.length(mns) == 0 {
        bldr.fail(ctx, "clojure.run_main: main_ns(\"...\") is required")
        return 1
    }

    // JDK gate: min_jdk(N) hard-requires (FAIL if unmet); skip_below_jdk(N) is a
    // portable-fleet floor (SKIP if unmet). run_java is "" (ambient) with no
    // floor; downstream prefixes it only when non-empty.
    min_jdk_v = bldr._str_key(_builder, "clojure_min_jdk")
    skip_jdk_v = bldr._str_key(_builder, "clojure_skip_below_jdk")
    sel_java, jdk_status = bldr._resolve_run_jdk(ctx, mod_dir, min_jdk_v, skip_jdk_v, "the FFM binding")
    if string.equals(jdk_status, "toolow") == 1 {
        bldr.fail(ctx, "run_main: min_jdk/skip_below_jdk below the supported floor (aeb supports JDK 6+)")
        return 1
    }
    if string.equals(jdk_status, "fail") == 1 {
        bldr.fail(ctx, "run_main: no JDK ${min_jdk_v}+ to run the FFM binding on (min_jdk is a hard requirement — use skip_below_jdk to skip instead)")
        return 1
    }
    if string.equals(jdk_status, "skip") == 1 { return 0 }
    run_java = ""
    if string.equals(sel_java, "java") == 0 { run_java = sel_java }

    // src + test roots (lein default or maven idiomatic).
    src_root = path.join(source_dir, "src")
    test_root = path.join(source_dir, "test")
    if _builder != null {
        if map.has(_builder, "source_layout") == 1 {
            lay, _ = map.get(_builder, "source_layout")
            if lay == "maven idiomatic" {
                src_root = path.join(source_dir, "src/main/clojure")
                test_root = path.join(source_dir, "src/test/clojure")
            }
        }
    }
    dep_cp = bldr._build_dep_classpath(ctx)
    lib_cp = bldr._build_lib_classpath(ctx)
    src_cp = bldr._cp_append(src_root, test_root)
    src_cp = bldr._cp_append(src_cp, dep_cp)
    src_cp = bldr._cp_append(src_cp, lib_cp)

    // jvm_flag run.
    jflags = ""
    if _builder != null {
        if map.has(_builder, "jvm_flag") == 1 {
            jf, _ = map.get(_builder, "jvm_flag")
            njf = list.size(jf)
            ji = 0
            while ji < njf {
                one, _ = list.get(jf, ji)
                jflags = string.concat(jflags, string.concat(" ", one))
                ji = ji + 1
            }
        }
    }

    // Prefer discovered runtime jars (a plain `java` launch, so jvm_flag lands
    // directly); else the CLI (jvm_flag via JAVA_OPTS). SKIP if neither.
    rjava = "java"
    if string.length(run_java) > 0 { rjava = run_java }
    clj_jars = _clojure_runtime_jars()
    run_cmd = ""
    if string.length(clj_jars) > 0 {
        full_cp = bldr._cp_append(clj_jars, src_cp)
        run_cmd = "'${rjava}'${jflags} -cp '${full_cp}' clojure.main -m ${mns}"
    } else {
        cli = _clojure_cli()
        if string.length(cli) == 0 {
            reason = "clojure not installed (no runtime jars, no clojure/clj CLI)"
            println("${mod_dir}: SKIPPED — ${reason}")
            bldr._record_skip(ctx, reason)
            return 0
        }
        // The CLI manages its own runtime; hand it our classpath via -Scp and
        // pass jvm flags through JAVA_OPTS. JAVA_HOME points it at the verified
        // JDK so it launches on 22+.
        jhome = ""
        if string.length(run_java) > 0 {
            jhraw, _jhe = bldr._sh_capture("dirname \"$(dirname '${run_java}')\"")
            jhome = string.trim(jhraw)
        }
        envp = ""
        if string.length(jhome) > 0 { envp = "JAVA_HOME='${jhome}' " }
        if string.length(jflags) > 0 { envp = string.concat(envp, "JAVA_OPTS='${jflags}' ") }
        run_cmd = "${envp}'${cli}' -Scp '${src_cp}' -M -m ${mns}"
    }

    println("${mod_dir}: running ${mns} (clojure)")
    run_cmd = string.concat(bldr._env_export_prefix(_builder), run_cmd)
    rrc = bldr._sh(run_cmd)
    if rrc != 0 {
        bldr._record_test_result_exitcode(ctx, 0, 1)
        println("${mod_dir}: ${mns} reported failures")
        bldr.fail(ctx, "clojure conformance run failed")
        return 1
    }
    bldr._record_test_result_exitcode(ctx, 1, 0)
    println("${mod_dir}: ${mns} PASSED")
    _et = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

builder test(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")

    bldr._mkdirs(target_dir)

    println("${mod_dir}: running tests (clojure)")

    src_root = path.join(source_dir, "src")
    test_root = path.join(source_dir, "test")
    if _builder != null {
        if map.has(_builder, "source_layout") == 1 {
            lay, _ = map.get(_builder, "source_layout")
            if lay == "maven idiomatic" {
                src_root = path.join(source_dir, "src/main/clojure")
                test_root = path.join(source_dir, "src/test/clojure")
            }
        }
    }

    // Build classpath: src + test + dep src + maven deps
    cp = src_root
    cp = bldr._cp_append(cp, test_root)

    dep_src = _dep_src_classpath(ctx)
    cp = bldr._cp_append(cp, dep_src)

    maven_cp = maven.classpath(ctx)
    cp = bldr._cp_append(cp, maven_cp)

    // JVM jar deps from bldr.dep'd modules — the clojure runtime jars and
    // any cross-language component (e.g. a Java binding the tests :import).
    jvm_dep_cp = bldr._build_dep_classpath(ctx)
    cp = bldr._cp_append(cp, jvm_dep_cp)

    // Discover test namespaces from *_test.clj files
    discover = "find '${test_root}' -name '*_test.clj' -type f"
    discover = string.concat(discover, " | sed 's|^${test_root}/||; s|/|.|g; s|_|-|g; s|\\.clj$||'")

    ns_list_raw, _e_disc = bldr._sh_capture(discover)
    ns_list = string.trim(ns_list_raw)
    if string.length(ns_list) == 0 {
        println("${mod_dir}: no test files found")
        _e3 = io.write_file(path.join(target_dir, ".timestamp"), "")
        return 0
    }

    // Convert newline-separated ns list to space-separated quoted symbols
    quoted_raw, _e_q = bldr._sh_capture("echo '${ns_list}' | sed \"s/^/'/; s/$/ /\" | tr -d '\\n'")
    quoted = string.trim(quoted_raw)

    timeout_secs = ""
    if _builder != null {
        if map.has(_builder, "test_timeout") == 1 {
            timeout_secs, _ = map.get(_builder, "test_timeout")
        }
    }
    cmd = clj_test_cmd(cp, quoted, timeout_secs)
    // Inject env (e.g. SERVIRTIUM_VCR_LIB) so the clojure.main JVM — and any
    // native lib a :import'd binding loads — sees it.
    cmd = string.concat(bldr._env_export_prefix(_builder), cmd)

    // clojure.test prints a summary of the form
    //   "Ran 14 tests containing 30 assertions. 0 failures, 0 errors."
    // Coarse record for now (1/1 success, 0/1 failure); full
    // test-count parsing is a follow-up if a Clojure consumer cares.
    exit_code = bldr._sh(cmd)
    if exit_code != 0 {
        bldr._record_test_result(ctx, 0, 1)
        println("${mod_dir}: tests FAILED")
        bldr.fail(ctx, "clojure tests FAILED")
        return exit_code
    }
    bldr._record_test_result(ctx, 1, 0)
    println("${mod_dir}: tests PASSED")
    _e4 = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// clojure.uberjar(b) — produce a single executable uberjar.
//
// Setters:
//   main_ns("com.example.core")  — the namespace with `(:gen-class)`
//                                  + `(defn -main ...)`. Required;
//                                  becomes the jar's Main-Class
//                                  (after dash->underscore munging).
//   output_jar("app.jar")        — output filename (optional; default
//                                  `<module>-standalone.jar`).
//
// Lifecycle:
//   1. AOT-compile main_ns into a staging dir (so the gen-class
//      `-main` entry point exists as a real .class).
//   2. Stage the project's `src/` tree (non-AOT namespaces load from
//      source at runtime — Clojure's normal mixed AOT/source model).
//   3. Unzip every maven jar (clojure.jar + deps) into the stage.
//   4. Write MANIFEST.MF with Main-Class = munged main_ns.
//   5. `jar cfM` the stage into target/<mod>/bin/<name>.
//
// The no-leiningen / no-tools.build analogue of `lein uberjar` /
// tools.build's `uber`. Mirrors scala.assembly + java.shade, with
// the Clojure twist that *source* must ride inside the jar (most
// namespaces aren't AOT'd), not just classes.
//
// Maven classpath is read from the `maven_classpath` artifact in
// target_dir (written by `clojure.compile`); declaring this builder
// in a `.dist.ae` alongside a `.build.ae` in the same directory means
// they share target_dir, so the artifact is present after compile.
builder uberjar(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")

    if _builder == null {
        println("${mod_dir}: clojure.uberjar: empty builder block — declare main_ns(...)")
        bldr.fail(ctx, "clojure.uberjar: empty builder block — declare main_ns(...)")
        return 1
    }
    if map.has(_builder, "main_ns") == 0 {
        println("${mod_dir}: clojure.uberjar: missing main_ns(\"...\")")
        bldr.fail(ctx, "clojure.uberjar: missing main_ns(\"...\")")
        return 1
    }
    ns, _ = map.get(_builder, "main_ns")

    jar_name = ""
    if map.has(_builder, "clojure_output_jar") == 1 {
        jar_name, _ = map.get(_builder, "clojure_output_jar")
    }
    if string.length(jar_name) == 0 {
        base = path.basename(source_dir)
        jar_name = string.concat(base, "-standalone.jar")
    }

    bin_dir = path.join(target_dir, "bin")
    bldr._mkdirs(bin_dir)
    jar_path = path.join(bin_dir, jar_name)

    // Fresh staging dir.
    stage_dir = path.join(target_dir, "_uber")
    _e0 = bldr._sh("rm -rf '${stage_dir}'")
    bldr._mkdirs(stage_dir)

    src_root = path.join(source_dir, "src")

    // Compose the classpath used for AOT: src + maven deps. Maven cp
    // comes from the artifact a sibling clojure.compile wrote.
    maven_cp = ""
    mvn_file = path.join(target_dir, "maven_classpath")
    if file.exists(mvn_file) == 1 {
        mvn_raw, _emv = io.read_file(mvn_file)
        maven_cp = string.trim(mvn_raw)
    }
    aot_cp = bldr._cp_append(src_root, maven_cp)

    // 1. AOT-compile main_ns into the staging dir.
    println("${mod_dir}: AOT-compiling ${ns}")
    aot_cmd = clj_aot_compile_cmd(stage_dir, aot_cp, ns)
    rc_aot = bldr._sh(aot_cmd)
    if rc_aot != 0 {
        println("${mod_dir}: clojure.uberjar: AOT compile failed")
        bldr.fail(ctx, "clojure.uberjar: AOT compile failed")
        return rc_aot
    }

    // 2. Stage the source tree so non-AOT namespaces load at runtime.
    if dir.exists(src_root) == 1 {
        rc_src = bldr._sh(uber_copy_tree_cmd(src_root, stage_dir))
        if rc_src != 0 {
            println("${mod_dir}: clojure.uberjar: staging sources failed")
            bldr.fail(ctx, "clojure.uberjar: staging sources failed")
            return rc_src
        }
    }

    // 3. Unzip every maven jar into the stage. Walk the colon-
    // separated maven classpath; each entry is a .jar.
    if string.length(maven_cp) > 0 {
        parts = string.split(maven_cp, ":")
        np = string.array_size(parts)
        pi = 0
        while pi < np {
            entry = string.array_get(parts, pi)
            if string.length(entry) > 0 {
                if _ends_with_jar(entry) == 1 {
                    rc_uz = bldr._sh(uber_unzip_jar_cmd(entry, stage_dir))
                    if rc_uz != 0 {
                        println("${mod_dir}: clojure.uberjar: unzipping ${entry} failed")
                        bldr.fail(ctx, "clojure.uberjar: unzipping ${entry} failed")
                        string.array_free(parts)
                        return rc_uz
                    }
                }
            }
            pi = pi + 1
        }
        string.array_free(parts)
    }

    // 4. Manifest. Main-Class is the dash-munged namespace.
    meta_dir = path.join(stage_dir, "META-INF")
    bldr._mkdirs(meta_dir)
    manifest_path = path.join(meta_dir, "MANIFEST.MF")
    main_class = _ns_to_main_class(ns)
    mf = string.concat("Manifest-Version: 1.0\nMain-Class: ", main_class)
    mf = string.concat(mf, "\n")
    _ew = io.write_file(manifest_path, mf)

    // 5. Jar it.
    println("${mod_dir}: building uberjar ${jar_name}")
    rc = bldr._sh(uber_jar_cmd(jar_path, stage_dir))
    if rc != 0 {
        println("${mod_dir}: clojure.uberjar: jar command failed")
        bldr.fail(ctx, "clojure.uberjar: jar command failed")
        return rc
    }

    println("${mod_dir}: built ${jar_path}")
    println("  run: java -jar ${jar_path}")
    bldr._write_artifact(ctx, "clojure_uberjar", jar_path)
    _ets = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}
