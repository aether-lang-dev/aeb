// zig — Zig SDK for aether.build
//
// Drives a Zig project (rooted at bldr.zig, deps in bldr.zig.zon):
// build via `zig build`, test via `zig build test`, run via
// `zig build run`. Optimize mode via `-Doptimize=<mode>`. Output lands
// under `zig-out/bin/`.
//
// Style mirror: lib/gleam / lib/moonbit. No venv: Zig uses the system
// `zig` on PATH; dependency fetch is part of `zig build` (bldr.zig.zon).
import bldr
import std.string
import std.io
import std.os
import std.file
import std.fs
import std.list
import std.map
import std.path
import std.dir

// --- DSL setters ---

// zig_bin("zig") — override the zig executable. Default "zig".
zig_bin(_ctx: ptr, bin: string) {
    _e = map.put(_ctx, "zig_bin", bin)
}

// optimize("ReleaseFast") — `-Doptimize=<mode>`: Debug / ReleaseSafe /
// ReleaseFast / ReleaseSmall. Scalar; last wins. Default: omit the flag
// (zig's own default, Debug).
optimize(_ctx: ptr, mode: string) {
    _e = map.put(_ctx, "zig_optimize", mode)
}

// output("myapp") — the produced binary's name under zig-out/bin, used
// to publish program_binary after a successful build. Scalar; last wins.
// Default: the module dir's basename.
output(_ctx: ptr, name: string) {
    _e = map.put(_ctx, "zig_output", name)
}

// --- Command builders (pure) ---

// _optimize_flag(mode) — " -Doptimize=<mode>" or "".
_optimize_flag(mode: string) {
    if string.length(mode) == 0 { return "" }
    return string.concat(" -Doptimize=", mode)
}

// build_cmd — `zig build`. Pure. opt_flag is " -Doptimize=..." or "".
build_cmd(zig: string, source_dir: string, opt_flag: string) {
    return "cd '${source_dir}' && '${zig}' build${opt_flag}"
}

// test_cmd — `zig build test`. Pure.
test_cmd(zig: string, source_dir: string, opt_flag: string) {
    return "cd '${source_dir}' && '${zig}' build test${opt_flag}"
}

// run_cmd — `zig build run`. Pure.
run_cmd(zig: string, source_dir: string, opt_flag: string) {
    return "cd '${source_dir}' && '${zig}' build run${opt_flag}"
}

// --- Internal ---

_zig_of(builder_map: ptr) {
    if builder_map != null {
        if map.has(builder_map, "zig_bin") == 1 {
            z, _ = map.get(builder_map, "zig_bin")
            if string.length(z) > 0 { return z }
        }
    }
    return "zig"
}

_optimize_of(builder_map: ptr) {
    if builder_map != null {
        if map.has(builder_map, "zig_optimize") == 1 {
            m, _ = map.get(builder_map, "zig_optimize")
            return m
        }
    }
    return ""
}

_out_name_of(builder_map: ptr, mod_dir: string) {
    if builder_map != null {
        if map.has(builder_map, "zig_output") == 1 {
            o, _ = map.get(builder_map, "zig_output")
            if string.length(o) > 0 { return o }
        }
    }
    return path.basename(mod_dir)
}

// --- SDK functions ---

// Build via `zig build`. Publishes program_binary from zig-out/bin/<out>
// when that binary exists after the build (so a language-agnostic runner
// can drive it). zig build also resolves bldr.zig.zon deps, so there's
// no separate "install" builder.
builder build_pkg(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")

    bldr._mkdirs(target_dir)

    zig = _zig_of(_builder)
    println("${mod_dir}: building (zig build)")
    cmd = build_cmd(zig, source_dir, _optimize_flag(_optimize_of(_builder)))
    exit_code = bldr._sh(cmd)
    if exit_code != 0 {
        println("${mod_dir}: build FAILED")
        bldr.fail(ctx, "build FAILED")
        return exit_code
    }

    // zig build installs to zig-out/bin/<name>. Publish it if present.
    out_name = _out_name_of(_builder, mod_dir)
    bin_abs = path.join(source_dir, path.join("zig-out/bin", out_name))
    if file.exists(bin_abs) == 1 {
        bldr._write_artifact(ctx, "program_binary", bin_abs)
        bldr._write_artifact(ctx, "zig_binary", bin_abs)
        println("${mod_dir}: build done → ${bin_abs}")
    } else {
        bldr._write_artifact(ctx, "zig_build_output", path.join(source_dir, "zig-out"))
        println("${mod_dir}: build done (no zig-out/bin/${out_name} — set output(\"name\") to publish program_binary)")
    }
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// Run tests via `zig build test`. Mirror of moonbit.test: tee output,
// parse zig's summary for pass/fail, feed bldr._record_test_result.
builder test(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")

    bldr._mkdirs(target_dir)
    println("${mod_dir}: running tests (zig build test)")

    zig = _zig_of(_builder)
    cmd = string.concat(bldr._env_export_prefix(_builder), test_cmd(zig, source_dir, _optimize_flag(_optimize_of(_builder))))
    out_path = path.join(target_dir, "test_output.log")
    full_cmd = string.concat(string.concat(cmd, " 2>&1 | tee "), out_path)
    exit_code = bldr._sh(full_cmd)
    out_text, _orerr = fs.read(out_path)
    tp_cnt, tf_cnt = _parse_zig_test_counts(out_text, exit_code)
    bldr._record_test_result(ctx, tp_cnt, tf_cnt)
    if exit_code != 0 {
        println("${mod_dir}: tests FAILED")
        bldr.fail(ctx, "tests FAILED")
        return exit_code
    }
    println("${mod_dir}: tests PASSED")
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// _parse_zig_test_counts(output, exit_code) — extract (passed, failed)
// from `zig build test`. Pure. The zig test runner prints, e.g.:
//   "All 7 tests passed."
//   "5 passed; 2 failed."          (some forms)
//   "1 of 3 tests passed"          (older/other forms)
// zig's test summary is less standardized than other runners, so:
//   1. "All N tests passed." → (N, 0)
//   2. "N passed; M failed"   → (N, M)
//   3. else, fall back to exit code: 0 → (1,0), non-zero → (0,1), so a
//      green/red verdict is always recorded even when no count parses.
_parse_zig_test_counts(output: string, exit_code: int) {
    if string.index_of(output, "All ") >= 0 {
        if string.index_of(output, " tests passed") >= 0 {
            p = _num_after_label_zig(output, "All ")
            return p, 0
        }
    }
    if string.index_of(output, " passed") >= 0 {
        if string.index_of(output, " failed") >= 0 {
            p = _num_before_word_zig(output, " passed")
            f = _num_before_word_zig(output, " failed")
            return p, f
        }
    }
    // Fallback: exit-code verdict (binary grain).
    if exit_code == 0 { return 1, 0 }
    return 0, 1
}

_num_after_label_zig(output: string, label: string) {
    idx = string.index_of(output, label)
    if idx < 0 { return 0 }
    start = idx + string.length(label)
    n = string.length(output)
    j = start
    digits = ""
    scanning = 1
    while scanning == 1 {
        if j >= n {
            scanning = 0
        } else {
            d = string.substring(output, j, j + 1)
            if _is_digit_zig(d) == 1 {
                digits = string.concat(digits, d)
                j = j + 1
            } else {
                scanning = 0
            }
        }
    }
    if string.length(digits) == 0 { return 0 }
    v, _err = string.to_int(digits)
    return v
}

_num_before_word_zig(output: string, word: string) {
    idx = string.index_of(output, word)
    if idx < 0 { return 0 }
    end = idx
    start = end
    found = 0
    while found == 0 {
        if start <= 0 {
            found = 1
        } else {
            c = string.substring(output, start - 1, start)
            if _is_digit_zig(c) == 1 {
                start = start - 1
            } else {
                found = 1
            }
        }
    }
    if start >= end { return 0 }
    num_str = string.substring(output, start, end)
    v, _err = string.to_int(num_str)
    return v
}

_is_digit_zig(c: string) {
    if string.equals(c, "0") == 1 { return 1 }
    if string.equals(c, "1") == 1 { return 1 }
    if string.equals(c, "2") == 1 { return 1 }
    if string.equals(c, "3") == 1 { return 1 }
    if string.equals(c, "4") == 1 { return 1 }
    if string.equals(c, "5") == 1 { return 1 }
    if string.equals(c, "6") == 1 { return 1 }
    if string.equals(c, "7") == 1 { return 1 }
    if string.equals(c, "8") == 1 { return 1 }
    if string.equals(c, "9") == 1 { return 1 }
    return 0
}

// zig.test_existing(b) — run an existing Zig project's tests as-is with
// honest exit-code propagation (no `| tee` pipeline that would mask the
// runner's exit). Foundation-backed counterpart to the `test` builder;
// honors env(K,V)/step/workdir.
builder test_existing(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    mod_dir = bldr._get(ctx, "module_dir")
    println("${mod_dir}: running tests (zig build test)")
    return bldr._run_project(ctx, _builder, "zig build test", 1)
}

// --- consumer_example: stage a bundled package + consumer, run from clean ---

// stage("src/lib.rs", "pkg/src/lib.rs") — copy one file (src relative to the
// module source_dir, dest relative to the staging root under target_dir) into
// the clean staging tree. Repeatable; this is the package+consumer manifest as
// declarative data. Value is "src<TAB>dest".
stage(_ctx: ptr, src: string, dest: string) {
    if map.has(_ctx, "stage_pairs") == 0 { _e1 = map.put(_ctx, "stage_pairs", list.new()) }
    l, _ = map.get(_ctx, "stage_pairs")
    _e2 = list.add(l, string.concat(src, string.concat("\t", dest)))
}
// stage_dir("../go", "go-pkg", "example") — copy a whole dir (src relative to
// module source_dir) into staging as dest, optionally deleting a sub-path after
// (e.g. drop example/ from the packaged copy). Value is "src<TAB>dest<TAB>prune".
stage_dir(_ctx: ptr, src: string, dest: string, prune: string) {
    if map.has(_ctx, "stage_dirs") == 0 { _e1 = map.put(_ctx, "stage_dirs", list.new()) }
    l, _ = map.get(_ctx, "stage_dirs")
    _e2 = list.add(l, string.concat(src, string.concat("\t", string.concat(dest, string.concat("\t", prune)))))
}
// run_in("consumer") — the staging-relative dir to run from. Scalar.
run_in(_ctx: ptr, dir: string) {
    _e = map.put(_ctx, "run_in", dir)
}
// run_cmd("cargo run --offline --") — the base run command (an env-prefix + argv
// follows per run_arg). Default is the cargo form. Scalar.
consumer_run_cmd(_ctx: ptr, cmd: string) {
    _e = map.put(_ctx, "run_cmd", cmd)
}
// mode_env("SEL_MODE") — pass each run_arg as an env var (VAR=arg) instead of
// an argv suffix. Scalar.
mode_env(_ctx: ptr, v: string) {
    _e = map.put(_ctx, "mode_env", v)
}
// pre_cmd("nim c -r ... consumer.nim") — a build step run once in run_in before
// the per-arg runs (for compile-then-run languages). Scalar; optional.
pre_cmd(_ctx: ptr, cmd: string) {
    _e = map.put(_ctx, "pre_cmd", cmd)
}
// run_arg("ffi") — an argv for `cargo run --offline -- <arg>`. Repeatable.
run_arg(_ctx: ptr, arg: string) {
    if map.has(_ctx, "run_args") == 0 { _e1 = map.put(_ctx, "run_args", list.new()) }
    l, _ = map.get(_ctx, "run_args")
    _e2 = list.add(l, arg)
}
// assert_file("pkg/native/libselenium_core.so") — a staging-relative path that
// MUST exist after staging (the bundled asset). Repeatable.
assert_file(_ctx: ptr, path: string) {
    if map.has(_ctx, "assert_files") == 0 { _e1 = map.put(_ctx, "assert_files", list.new()) }
    l, _ = map.get(_ctx, "assert_files")
    _e2 = list.add(l, path)
}

// rust.consumer_example() — stage a clean bundled crate + a consumer crate (via
// stage() pairs), assert the bundled asset, then `cargo run --offline -- <arg>`
// in run_in with SELENIUM_CORE_LIB unset — so the consumer drives the engine via
// ONLY the crate's own bundled .so (no in-tree sibling). Deps the .package.ae.
builder consumer_example(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")
    bldr._mkdirs(target_dir)

    stageroot = path.join(target_dir, "stage")
    bldr._sh("rm -rf '${stageroot}' && mkdir -p '${stageroot}'")

    // stage the declared file pairs.
    if _builder != null {
        if map.has(_builder, "stage_pairs") == 1 {
            l, _ = map.get(_builder, "stage_pairs")
            n = list.size(l)
            i = 0
            while i < n {
                pair, _ = list.get(l, i)
                tab = string.index_of(pair, "\t")
                src = string.substring(pair, 0, tab)
                dest = string.substring(pair, tab + 1, string.length(pair))
                src_abs = path.join(source_dir, src)
                dest_abs = path.join(stageroot, dest)
                dest_parent = path.dirname(dest_abs)
                bldr._sh("mkdir -p '${dest_parent}' && cp -r '${src_abs}' '${dest_abs}'")
                i = i + 1
            }
        }
    }

    // stage whole dirs (cp -r), with an optional prune sub-path.
    if _builder != null {
        if map.has(_builder, "stage_dirs") == 1 {
            l, _ = map.get(_builder, "stage_dirs")
            n = list.size(l)
            i = 0
            while i < n {
                spec, _ = list.get(l, i)
                t1 = string.index_of(spec, "\t")
                sd_src = string.substring(spec, 0, t1)
                r1 = string.substring(spec, t1 + 1, string.length(spec))
                t2 = string.index_of(r1, "\t")
                sd_dest = string.substring(r1, 0, t2)
                sd_prune = string.substring(r1, t2 + 1, string.length(r1))
                src_abs = path.join(source_dir, sd_src)
                dest_abs = path.join(stageroot, sd_dest)
                bldr._sh("cp -r '${src_abs}' '${dest_abs}'")
                if string.length(sd_prune) > 0 {
                    bldr._sh("rm -rf '${dest_abs}/${sd_prune}'")
                }
                i = i + 1
            }
        }
    }

    // assert bundled files.
    if _builder != null {
        if map.has(_builder, "assert_files") == 1 {
            l, _ = map.get(_builder, "assert_files")
            n = list.size(l)
            i = 0
            while i < n {
                af, _ = list.get(l, i)
                if bldr._sh("ls '${stageroot}/${af}' >/dev/null 2>&1") != 0 {
                    println("${mod_dir}: staged package missing ${af}")
                    bldr.fail(ctx, "bundled asset missing after staging")
                    return 1
                }
                i = i + 1
            }
        }
    }

    run_dir = "consumer"
    if _builder != null {
        if map.has(_builder, "run_in") == 1 { run_dir, _ = map.get(_builder, "run_in") }
    }
    run_abs = path.join(stageroot, run_dir)
    run_command = "cargo run --offline --"
    if _builder != null {
        if map.has(_builder, "run_cmd") == 1 { run_command, _ = map.get(_builder, "run_cmd") }
    }
    // optional build step before the per-arg runs.
    if _builder != null {
        if map.has(_builder, "pre_cmd") == 1 {
            pc, _ = map.get(_builder, "pre_cmd")
            if string.length(pc) > 0 {
                if bldr._sh("cd '${run_abs}' && env -u SELENIUM_CORE_LIB ${pc}") != 0 {
                    println("${mod_dir}: consumer pre-build failed")
                    bldr.fail(ctx, "consumer pre-build failed")
                    return 1
                }
            }
        }
    }
    // mode_env: when set, each run_arg is passed as `<VAR>=<arg>` (an env var)
    // instead of an argv suffix (for consumers that select a mode from the env).
    has_mode_env = 0
    mode_env = ""
    if _builder != null {
        if map.has(_builder, "mode_env") == 1 {
            mode_env, _ = map.get(_builder, "mode_env")
            has_mode_env = 1
        }
    }
    args = null
    if _builder != null {
        if map.has(_builder, "run_args") == 1 { args, _ = map.get(_builder, "run_args") }
    }
    if args == null {
        base = "cd '${run_abs}' && env -u SELENIUM_CORE_LIB ${run_command}"
        if bldr._sh(base) != 0 { bldr.fail(ctx, "consumer run failed"); return 1 }
    } else {
        na = list.size(args)
        ai = 0
        while ai < na {
            a, _ = list.get(args, ai)
            println("${mod_dir}: consumer run (${a})")
            one = ""
            if has_mode_env == 1 {
                one = "cd '${run_abs}' && env -u SELENIUM_CORE_LIB ${mode_env}=${a} ${run_command}"
            } else {
                one = "cd '${run_abs}' && env -u SELENIUM_CORE_LIB ${run_command} ${a}"
            }
            if bldr._sh(one) != 0 {
                println("${mod_dir}: consumer run (${a}) failed")
                bldr.fail(ctx, "consumer run (${a}) failed")
                return 1
            }
            ai = ai + 1
        }
    }
    println("${mod_dir}: PASS — consumer drove the engine via the crate's bundled .so from clean")
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}
