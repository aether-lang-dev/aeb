// haskell — Haskell SDK for aeb.
//
// Drives an existing Cabal project as-is. `haskell.test` defaults to
// `cabal test`, `haskell.build` to `cabal build`. Env injection (e.g.
// LD_LIBRARY_PATH for an FFI-linked shared engine) rides the shared
// env(...) setter; any bespoke pre-step (writing cabal.project.local)
// stays inline in the leaf.
//
//   import bldr
//   import haskell
//   import bldr (env)
//   haskell.test(b) { env("LD_LIBRARY_PATH", nat) }
//
// Setters (all from lib/build): env(K,V), step("…"), workdir("dir").
import bldr
import std.string

// haskell.build(b) — `cabal build`.
builder build(ctx: ptr): int {
    mod_dir = bldr._get(ctx, "module_dir")
    println("${mod_dir}: compiling (cabal build)")
    return bldr._run_project(ctx, _builder, "cabal build", 0)
}

// haskell.test(b) — `cabal test`. Reports pass/fail telemetry.
builder test(ctx: ptr): int {
    mod_dir = bldr._get(ctx, "module_dir")
    println("${mod_dir}: running tests (cabal test)")
    return bldr._run_project(ctx, _builder, "cabal test", 1)
}
