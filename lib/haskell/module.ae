// haskell — Haskell SDK for aeb.
//
// Drives an existing Cabal project as-is. `haskell.test` defaults to
// `cabal test`, `haskell.build` to `cabal build`. Env injection (e.g.
// LD_LIBRARY_PATH for an FFI-linked shared engine) rides the shared
// env(...) setter; any bespoke pre-step (writing cabal.project.local)
// stays inline in the leaf.
//
//   import bldr
//   import haskell
//   import bldr (env)
//   haskell.test(b) { env("LD_LIBRARY_PATH", nat) }
//
// Setters (all from lib/build): env(K,V), step("…"), workdir("dir").
// Plus (this module): link_dir("<abs dir>") and target("test:live").
import bldr
import std.string
import std.list
import std.map
import std.path
import std.io

// link_dir("<abs dir>") — a directory carrying a C library the cabal package
// links via `extra-libraries` (e.g. an aeb-built engine .so). Appended as
// `--extra-lib-dirs=<dir> --ghc-options=-optl-Wl,-rpath,<dir>` so the link
// resolves at build time and the binary self-locates the .so at run time.
// cabal 9.10 rejects a bare relative extra-lib-dirs and won't expand
// ${pkgroot}, so pass ABSOLUTE dirs here. Repeatable.
link_dir(_ctx: ptr, dir: string) {
    if map.has(_ctx, "hs_link_dirs") == 0 { _e1 = map.put(_ctx, "hs_link_dirs", list.new()) }
    l, _ = map.get(_ctx, "hs_link_dirs")
    _e2 = list.add(l, dir)
}

// target("test:live") — the cabal target for build/test (e.g. a named
// test-suite). Unset → all. Scalar.
target(_ctx: ptr, t: string) {
    _e = map.put(_ctx, "hs_target", t)
}

// --- Consumer-manifest setters (for haskell.generate_manifest) ---
//
// haskell.generate_manifest() EMITS a complete <name>.cabal for a CONSUMER,
// the same exporter-node pattern as python.package() / gleam.generate_manifest:
// pure content generator + declarative setters + a builder that io.write_file's
// it. Setter names are kept distinct from any haskell_<name>/hs_<name> function
// to avoid the setter-mangle collision (asks/setter-mangle-collides-with-
// function-name.md).

// manifest_name("selenium") — the emitted cabal `name:`. Default "app".
manifest_name(_ctx: ptr, name: string) {
    _e = map.put(_ctx, "manifest_name", name)
}

// manifest_version("0.8.0") — the emitted cabal `version:`. Default "0.1.0".
manifest_version(_ctx: ptr, ver: string) {
    _e = map.put(_ctx, "manifest_version", ver)
}

// build_dep("aeson", ">= 2.0") — one build-depends entry for the emitted
// library stanza. Repeatable. Stored "name~ver" (the SDK-wide tilde-join). ver
// "" emits a bare package constraint (no version bound).
build_dep(_ctx: ptr, name: string, ver: string) {
    if map.has(_ctx, "manifest_build_deps") == 0 {
        _e1 = map.put(_ctx, "manifest_build_deps", list.new())
    }
    deps, _ = map.get(_ctx, "manifest_build_deps")
    entry = string.concat(name, "~")
    entry = string.concat(entry, ver)
    _e2 = list.add(deps, entry)
}

// _hs_lib_flags(builder) — " --extra-lib-dirs=<d> --ghc-options=-optl-Wl,
// -rpath,<d>" per link_dir(), or "". Pure.
_hs_lib_flags(bmap: ptr) {
    out = ""
    if bmap != null {
        if map.has(bmap, "hs_link_dirs") == 1 {
            l, _ = map.get(bmap, "hs_link_dirs")
            n = list.size(l)
            i = 0
            while i < n {
                d, _ = list.get(l, i)
                out = string.concat(out, " --extra-lib-dirs='${d}' --ghc-options=-optl-Wl,-rpath,'${d}'")
                i = i + 1
            }
        }
    }
    return out
}

// _hs_target_suffix(builder) — " <target>" or "". Pure.
_hs_target_suffix(bmap: ptr) {
    if bmap != null {
        if map.has(bmap, "hs_target") == 1 {
            t, _ = map.get(bmap, "hs_target")
            if string.length(t) > 0 { return " ${t}" }
        }
    }
    return ""
}

// cabal_content(opts) — PURE generator of a consumer <name>.cabal from the
// generate_manifest block-map. No I/O; unit-tested directly. Emits a minimal
// library stanza with a build-depends line (base is always included).
cabal_content(opts: ptr) {
    name = "app"
    ver = "0.1.0"
    if opts != null {
        if map.has(opts, "manifest_name") == 1 { name, _ = map.get(opts, "manifest_name") }
        if map.has(opts, "manifest_version") == 1 { ver, _ = map.get(opts, "manifest_version") }
    }
    c = "cabal-version: 2.4\nname: ${name}\nversion: ${ver}\n\nlibrary\n"

    deplist = "base"
    if opts != null {
        if map.has(opts, "manifest_build_deps") == 1 {
            deps, _ = map.get(opts, "manifest_build_deps")
            n = list.size(deps)
            i = 0
            while i < n {
                entry, _ = list.get(deps, i)
                i = i + 1
                tilde = string.index_of(entry, "~")
                if tilde < 0 { continue }
                dn = string.substring(entry, 0, tilde)
                dv = string.substring(entry, tilde + 1, string.length(entry))
                if string.length(dv) > 0 {
                    deplist = string.concat(deplist, ", ${dn} ${dv}")
                } else {
                    deplist = string.concat(deplist, ", ${dn}")
                }
            }
        }
    }
    c = string.concat(c, "  build-depends: ${deplist}\n")
    c = string.concat(c, "  default-language: Haskell2010\n")
    return c
}

// haskell.generate_manifest(b) — emit a consumer <name>.cabal into source_dir
// and publish its path on the "cabal_manifest" artifact edge. The exporter-node
// counterpart of gleam.generate_manifest / python.package. Route via a
// haskell/.package.ae (filename-is-the-route).
builder generate_manifest(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")

    bldr._mkdirs(target_dir)

    name = "app"
    if _builder != null {
        if map.has(_builder, "manifest_name") == 1 { name, _ = map.get(_builder, "manifest_name") }
    }
    content = cabal_content(_builder)
    manifest_path = path.join(source_dir, "${name}.cabal")
    _ew = io.write_file(manifest_path, content)

    bldr._write_artifact(ctx, "cabal_manifest", manifest_path)
    println("${mod_dir}: generated ${manifest_path}")
    _et = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// haskell.build(b) — `cabal build [<target>]` + link_dir flags.
builder build(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    mod_dir = bldr._get(ctx, "module_dir")
    flags = _hs_lib_flags(_builder)
    tgt = _hs_target_suffix(_builder)
    if string.length(flags) == 0 {
        println("${mod_dir}: compiling (cabal build)")
        return bldr._run_project(ctx, _builder, string.concat("cabal build", tgt), 0)
    }
    source_dir = bldr._get(ctx, "source_dir")
    println("${mod_dir}: compiling (cabal build)")
    cmd = "cd '${source_dir}' && cabal build${tgt}${flags}"
    cmd = string.concat(bldr._env_export_prefix(_builder), cmd)
    rc = bldr._sh(cmd)
    if rc != 0 { bldr.fail(ctx, "cabal build failed"); return rc }
    return 0
}

// haskell.test(b) — `cabal test [<target>]` + link_dir flags + env. Pass/fail
// telemetry. When link_dir() is declared, assemble the command directly (the
// engine-link flags can't ride the generic _run_project path).
builder test(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    mod_dir = bldr._get(ctx, "module_dir")
    flags = _hs_lib_flags(_builder)
    tgt = _hs_target_suffix(_builder)
    if string.length(flags) == 0 {
        println("${mod_dir}: running tests (cabal test)")
        return bldr._run_project(ctx, _builder, string.concat("cabal test", tgt), 1)
    }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    bldr._mkdirs(target_dir)
    println("${mod_dir}: running tests (cabal test)")
    cmd = "cd '${source_dir}' && cabal test${tgt}${flags}"
    cmd = string.concat(bldr._env_export_prefix(_builder), cmd)
    rc = bldr._sh(cmd)
    if rc != 0 {
        bldr._record_test_result(ctx, 0, 1)
        println("${mod_dir}: tests FAILED")
        bldr.fail(ctx, "tests FAILED")
        return rc
    }
    bldr._record_test_result(ctx, 1, 0)
    println("${mod_dir}: tests PASSED")
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}
