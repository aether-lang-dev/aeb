// provision — build-prerequisite preflight (and, later, host/container install).
//
// Implements the PROBE + PREFLIGHT half of
// docs/build-prerequisites-and-provisioning.md. A build node declares system
// toolchain prerequisites with build.prereq(b, "<tc>:<ver>"); tools/extract-deps
// --prereqs collects them statically; the flattened set (transitive union over
// the dep DAG) is what preflight here consumes.
//
//   preflight (default, every agent, fail-closed):
//     flatten set -> probe each token vs the host -> any missing yields the
//     DISTINCT `unmet-prereqs: [tok ...]` verdict (NOT build-failed). Never
//     installs. Runs identically on Windows and Linux — pure probing through
//     the build._sh chokepoint, no podman.
//
// The token grammar is "<toolchain>:<version>" (exact version, v1). The probe
// for each toolchain is a small operator-owned map; aeb ships defaults for its
// SDK languages and the operator may override/extend (same dual-source pattern
// as the SDKs). An unknown/unmapped token's probe falls back to a bare
// `command -v <toolchain>` presence check — never arbitrary execution.
//
// Capability, not trust: a satisfied prerequisite means "the toolchain is
// present," nothing about whether the build is permitted to run (that is the
// veto/sandbox's job — orthogonal layers).

import build
import std.string
import std.list
import std.map
import std.os

extern println(s: string)

// Split "zig:0.13" -> ("zig", "0.13"). A token with no ':' is all toolchain,
// empty version (version-less probe — presence only).
_split_token(token: string) {
    colon = string.index_of(token, ":")
    if colon < 0 {
        return token, ""
    }
    tc = string.substring(token, 0, colon)
    ver = string.substring(token, colon + 1, string.length(token))
    return tc, ver
}

// The probe COMMAND for a toolchain — a shell snippet that exits 0 when the
// toolchain is present (version-matching is layered on top by _probe_token).
// Defaults are presence checks via `command -v`; a few toolchains whose binary
// name differs from the token name get an explicit mapping. Operator-extensible
// later via an external map; for v1 this is the shipped default vocabulary.
//
// Returns the binary name to probe for a given toolchain token name.
_probe_binary(tc: string) {
    if string.equals(tc, "jdk") == 1 { return "javac" }
    if string.equals(tc, "java") == 1 { return "java" }
    if string.equals(tc, "python") == 1 { return "python3" }
    if string.equals(tc, "node") == 1 { return "node" }
    if string.equals(tc, "nodejs") == 1 { return "node" }
    if string.equals(tc, "dotnet") == 1 { return "dotnet" }
    if string.equals(tc, "rust") == 1 { return "rustc" }
    if string.equals(tc, "cargo") == 1 { return "cargo" }
    if string.equals(tc, "go") == 1 { return "go" }
    if string.equals(tc, "gcc") == 1 { return "gcc" }
    if string.equals(tc, "clang") == 1 { return "clang" }
    // Default: the toolchain token name IS the binary name (zig, dart, swift,
    // kotlinc, scala, clojure, gleam, moonbit, nim, erlang, elixir, php, ...).
    return tc
}

// 1 if the binary is on PATH, else 0. Uses `command -v` (a POSIX shell builtin
// cmd.exe lacks) through the build chokepoint, so it's Windows-correct.
_binary_present(bin: string) {
    out, _e = build._sh_capture(string.concat("command -v ", string.concat(bin, " >/dev/null 2>&1 && echo Y || echo N")))
    if string.index_of(out, "Y") >= 0 { return 1 }
    return 0
}

// Probe a single token against the host. Returns 1 if satisfied, else 0.
//
// v1: presence-only. The binary for the toolchain must be on PATH. Version
// matching (the "<ver>" half of the token) is deliberately NOT enforced yet —
// probe fuzziness (system vs pyenv vs venv vs framework) is real and the design
// says an ambiguous probe should lean fail-closed; presence is the crisp,
// non-fuzzy floor we ship first. A later revision tightens this per-toolchain
// in the operator probe map (e.g. `python3 --version` matches `3.14`).
_probe_token(token: string) {
    tc, _ver = _split_token(token)
    if string.length(tc) == 0 { return 1 }
    bin = _probe_binary(tc)
    return _binary_present(bin)
}

// preflight_missing(tokens) — probe every token in the list; return a NEW list
// of the tokens that are NOT satisfied (the unmet set). Empty list => all met.
// Deduped on the way in (a flattened set may arrive with dupes if the caller
// didn't dedupe).
preflight_missing(tokens: ptr) {
    missing = list.new()
    seen = map.new()
    n = list.size(tokens)
    i = 0
    while i < n {
        tok, _ = list.get(tokens, i)
        i = i + 1
        if string.length(tok) == 0 { continue }
        if map.has(seen, tok) == 1 { continue }
        _s = map.put(seen, tok, "1")
        if _probe_token(tok) == 0 {
            _m = list.add(missing, tok)
        }
    }
    return missing
}

// Join a token list into "[a, b, c]" for the verdict line.
_fmt_set(tokens: ptr) {
    out = "["
    n = list.size(tokens)
    i = 0
    while i < n {
        t, _ = list.get(tokens, i)
        if i > 0 { out = string.concat(out, ", ") }
        out = string.concat(out, t)
        i = i + 1
    }
    return string.concat(out, "]")
}

// preflight(tokens) — the fail-closed verdict. Probes the set; prints and
// returns a verdict code:
//   0  -> all prerequisites met (or the set is empty)
//   3  -> unmet-prereqs (distinct from build-failed=1, like the veto's
//         vetoed-vs-failed split) — prints `unmet-prereqs: [tok ...]`
// NEVER installs. The caller (aeb-main --preflight) exits with this code.
preflight(tokens: ptr) {
    missing = preflight_missing(tokens)
    if list.size(missing) == 0 {
        nt = list.size(tokens)
        if nt == 0 {
            println("preflight: no prerequisites declared — ok")
        } else {
            println(string.concat("preflight: all prerequisites met ", _fmt_set(tokens)))
        }
        return 0
    }
    println(string.concat("unmet-prereqs: ", _fmt_set(missing)))
    return 3
}

// === install-prereqs: token -> host install recipe (dry-run first) =========
//
// install resolves each MISSING token to a concrete install command FOR THIS
// HOST and (in the first cut) PRINTS it without executing — a dry run. The
// design (docs/build-prerequisites-and-provisioning.md "Cross-distro package
// names") keeps the token distro/OS-agnostic; all distro/OS-awareness lives
// here in the recipe map, resolved three ways in order of preference:
//   1. distro-invariant tarball recipe (no package manager at all) — preferred;
//   2. per-package-manager branch (apt/dnf/apk/pacman) when a recipe needs one;
//   3. fail-closed — an unmapped token, or a mapped token with no branch for
//      this host's package manager, is UNPROVISIONABLE (never a guessed name).
//
// NO container: this targets the HOST directly (the user's chosen mode).

// _detect_pm() — the host's system package manager, or "" if none found.
// Probed once via `command -v` through the build chokepoint (Windows-correct).
// On the MINGW box this finds "pacman" (MSYS2); on Debian "apt", etc.
_detect_pm() {
    if _binary_present("apt-get") == 1 { return "apt" }
    if _binary_present("dnf") == 1 { return "dnf" }
    if _binary_present("apk") == 1 { return "apk" }
    if _binary_present("pacman") == 1 { return "pacman" }
    if _binary_present("brew") == 1 { return "brew" }
    return ""
}

// _pm_install(pm, pkg) — the install command line for a package on a given
// package manager. "" for an unknown pm (caller fails closed).
_pm_install(pm: string, pkg: string) {
    if string.equals(pm, "apt") == 1 { return string.concat("apt-get install -y ", pkg) }
    if string.equals(pm, "dnf") == 1 { return string.concat("dnf install -y ", pkg) }
    if string.equals(pm, "apk") == 1 { return string.concat("apk add ", pkg) }
    if string.equals(pm, "pacman") == 1 { return string.concat("pacman -S --noconfirm ", pkg) }
    if string.equals(pm, "brew") == 1 { return string.concat("brew install ", pkg) }
    return ""
}

// _pkg_name(tc, pm) — the package NAME for a toolchain on a given package
// manager. One token, different names per PM (the doc's jdk:21 example). "" if
// this PM has no known package for this toolchain → fail-closed upstream.
// Operator-extensible later; v1 ships a starter vocabulary.
_pkg_name(tc: string, pm: string) {
    if string.equals(tc, "jdk") == 1 {
        if string.equals(pm, "apt") == 1 { return "openjdk-21-jdk" }
        if string.equals(pm, "dnf") == 1 { return "java-21-openjdk-devel" }
        if string.equals(pm, "apk") == 1 { return "openjdk21" }
        if string.equals(pm, "pacman") == 1 { return "jdk-openjdk" }
        return ""
    }
    if string.equals(tc, "python") == 1 {
        if string.equals(pm, "apt") == 1 { return "python3" }
        if string.equals(pm, "dnf") == 1 { return "python3" }
        if string.equals(pm, "apk") == 1 { return "python3" }
        if string.equals(pm, "pacman") == 1 { return "python" }
        return ""
    }
    if string.equals(tc, "go") == 1 {
        if string.equals(pm, "apt") == 1 { return "golang" }
        if string.equals(pm, "dnf") == 1 { return "golang" }
        if string.equals(pm, "apk") == 1 { return "go" }
        if string.equals(pm, "pacman") == 1 { return "go" }
        return ""
    }
    if string.equals(tc, "gcc") == 1 {
        if string.equals(pm, "apt") == 1 { return "gcc" }
        if string.equals(pm, "dnf") == 1 { return "gcc" }
        if string.equals(pm, "apk") == 1 { return "gcc" }
        if string.equals(pm, "pacman") == 1 { return "gcc" }
        return ""
    }
    return ""
}

// _os_arch_tag() — the OS slug upstream projects use in their download artifact
// names ("linux", "windows", "macos"). The TOKEN is OS-agnostic, but the binary
// ARTIFACT a tarball recipe fetches is not — `zig-linux-x86_64` vs
// `zig-windows-x86_64` — so a tarball recipe must pick the right artifact for
// THIS host. (Dry-run on the MINGW box caught the Linux URL being printed on
// Windows; this is the fix.) Package-manager recipes don't need this — the PM
// is already host-specific.
_os_slug() {
    if build._is_windows() == 1 { return "windows" }
    if build._is_macos() == 1 { return "macos" }
    return "linux"
}

// _tarball_recipe(tc, ver) — a pinned upstream-tarball install command for THIS
// host, or "" if this toolchain has no tarball recipe (caller then tries the
// package-manager path). Preferred shape: no package manager, so the
// apt/dnf/apk/pacman question never arises — but the artifact + extractor ARE
// host-specific (zip+unzip on Windows, tar.xz elsewhere). Version-pinned for
// reproducibility. (Starter set; operator-extensible.)
_tarball_recipe(tc: string, ver: string) {
    if string.equals(tc, "zig") == 1 {
        os = _os_slug()
        base = string.concat("zig-", string.concat(os, string.concat("-x86_64-", ver)))
        if build._is_windows() == 1 {
            // Windows: .zip artifact, unzip into a prefix, place zig.exe on PATH.
            u = string.concat("https://ziglang.org/download/", string.concat(ver, string.concat("/", string.concat(base, ".zip"))))
            return string.concat("curl -fsSL -o /tmp/zig.zip ", string.concat(u, string.concat(" && unzip -q -o /tmp/zig.zip -d /usr/local && ln -sf /usr/local/", string.concat(base, "/zig.exe /usr/local/bin/zig"))))
        }
        // Linux/macOS: .tar.xz artifact.
        u = string.concat("https://ziglang.org/download/", string.concat(ver, string.concat("/", string.concat(base, ".tar.xz"))))
        return string.concat("curl -fsSL ", string.concat(u, string.concat(" | tar -xJ -C /usr/local && ln -sf /usr/local/", string.concat(base, "/zig /usr/local/bin/zig"))))
    }
    return ""
}

// _resolve_recipe(token, pm) — the install command for one token on this host,
// or "" if unprovisionable. Tarball (OS-invariant) first, then the package
// manager. See the three-way resolution above.
_resolve_recipe(token: string, pm: string) {
    tc, ver = _split_token(token)
    if string.length(tc) == 0 { return "" }
    // 1. distro-invariant tarball (preferred — no PM)
    tb = _tarball_recipe(tc, ver)
    if string.length(tb) > 0 { return tb }
    // 2. per-package-manager branch
    if string.length(pm) == 0 { return "" }
    pkg = _pkg_name(tc, pm)
    if string.length(pkg) == 0 { return "" }
    return _pm_install(pm, pkg)
}

// install_plan_dryrun(missing) — for each MISSING token, resolve its host
// install recipe and PRINT it (does NOT execute — the safe first cut). An
// unprovisionable token prints a `# unprovisionable:` line and makes the plan
// incomplete. Returns:
//   0 -> every missing token has a recipe (a complete, runnable plan printed)
//   3 -> at least one token is unprovisionable (plan incomplete — fail-closed)
//   0 -> nothing missing (no-op)
// The caller (aeb --install-prereqs) prints a header and exits with this code.
install_plan_dryrun(missing: ptr) {
    n = list.size(missing)
    if n == 0 {
        println("install-prereqs: nothing to install — all prerequisites already met")
        return 0
    }
    pm = _detect_pm()
    if string.length(pm) == 0 {
        println("# note: no system package manager detected (apt/dnf/apk/pacman/brew)")
        println("#       only distro-invariant tarball recipes can apply on this host")
    } else {
        println(string.concat("# host package manager: ", pm))
    }
    println("# DRY RUN — these commands are NOT executed. Review, then run with --execute.")
    incomplete = 0
    i = 0
    while i < n {
        tok, _ = list.get(missing, i)
        i = i + 1
        recipe = _resolve_recipe(tok, pm)
        if string.length(recipe) == 0 {
            println(string.concat("# unprovisionable: ", string.concat(tok, " — no recipe for this host (token unmapped, or no package-manager branch)")))
            incomplete = 1
        } else {
            println(string.concat("# ", tok))
            println(recipe)
        }
    }
    if incomplete == 1 {
        return 3
    }
    return 0
}
