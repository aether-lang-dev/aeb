// veto — supply-chain build-veto SDK for aether.build
//
// The 2b layer of docs/build-veto-and-sandbox.md, end to end: run
// `aetherc --emit=ast` on an untrusted .ae, walk the emitted JSON AST,
// and veto on operator deny-rules (extern / exec / net / import) — with
// the resolved callee symbol, so aliasing/concat can't dodge it.
//
// THE TRUSTED-HARNESS INVARIANT: this runs in the harness that invokes
// the build, never in the untrusted graph. A `.build.ae` cannot clear a
// verdict reached here.
//
// FAIL-CLOSED by construction:
//   - non-zero aetherc exit (no AST) → VETO (no clearance ⇒ no build)
//   - an indirect (function-pointer) call in untrusted code → VETO
//   - a deny-category node with NULL origin → VETO + surface
// Origin: a node whose `file` is under a trusted --lib root is exempt
// (the SDKs legitimately os.system/extern); only the untrusted tree trips.
//
// The built-in default policy (deny extern, deny exec) is `default_rules()`.
// An operator authors richer policy in an OUT-OF-TREE policy `.ae` (NOT a
// dot-prefixed in-tree target — see docs/build-veto-and-sandbox.md) via the
// closure-DSL below (`veto.policy`/`deny`/`banned`/`allow_exec`/…), which
// lowers onto the same "<kind>\t<arg>" rule list `decide()` consumes.
import build
import std.string
import std.io
import std.os
import std.file
import std.list
import std.map
import std.path
import std.json

// --- Rule model (pure) ---
//
// A rule is "<kind>\t<arg>" where kind ∈ {extern, exec, net, import} and
// arg is "" (whole category) or a specific symbol/module to deny. The
// built-in default is the two highest-value categories.

// default_rules() — the built-in deny set used when no policy .ae is
// supplied: deny every extern and every exec in the untrusted tree.
// (net/import are added by an operator policy; extern+exec is the 80%.)
default_rules() {
    r = list.new()
    list.add(r, "extern\t")
    list.add(r, "exec\t")
    return r
}

// _rule_kind(rule) / _rule_arg(rule) — split a "<kind>\t<arg>" rule.
_rule_kind(rule: string) {
    idx = string.index_of(rule, "\t")
    if idx < 0 { return rule }
    return string.substring(rule, 0, idx)
}
_rule_arg(rule: string) {
    idx = string.index_of(rule, "\t")
    if idx < 0 { return "" }
    return string.substring(rule, idx + 1, string.length(rule))
}

// --- Policy DSL (the out-of-tree policy.ae front end) ---
//
// An operator-trusted policy.ae (loaded by --vet, NEVER a dot-prefixed
// in-tree target) authors rules in Aether — so a malformed policy is a
// *compile error* (self-vetting), not a silent empty policy:
//
//   import veto (policy, deny, banned, allow_exec, allow_import, scope)
//   main() {
//       p = veto.policy()
//       veto.deny(p, "extern")              // whole category
//       veto.deny(p, "net")
//       veto.banned(p, "evil.com")          // substring in any literal arg
//       veto.allow_exec(p, "gcc")           // exempt gcc from a deny-exec
//       veto.allow_import(p, "std.string")
//       veto.scope(p, "untrusted")          // (recorded; default scope)
//   }
//
// aeb compiles+runs this, then reads the resolved rule list via
// `policy_rules(p)` (the doppelganger move — the closure populates a map
// exactly like a .build.ae). The setters are pure data accumulation.
//
// Lowering: every setter appends one "<kind>\t<arg>" string to the map's
// veto_rules list — the SAME format `decide()`/`_node_verdict` consume.
//   deny(p, "extern")        → "extern\t"
//   deny(p, "exec\tos_exec") → "exec\tos_exec"   (specific)  [pass the full arg]
//   banned(p, "evil.com")    → "banned\tevil.com"
//   allow_exec(p, "gcc")     → "allow\texec\tgcc"
//   allow_import(p,"std.os")  → "allow\timport\tstd.os"
//   scope(p, "untrusted")    → recorded as veto_scope (not a rule)

// policy() — a fresh policy object (a map carrying an empty rule list).
policy() {
    p = map.new()
    _e = map.put(p, "veto_rules", list.new())
    return p
}

_policy_add(p: ptr, rule: string) {
    if map.has(p, "veto_rules") == 0 { _e0 = map.put(p, "veto_rules", list.new()) }
    rs, _ = map.get(p, "veto_rules")
    _e = list.add(rs, rule)
}

// deny(p, "<kind>" | "<kind>\t<arg>") — a deny rule. Bare kind = whole
// category; "kind\targ" = a specific symbol/module/extern.
deny(p: ptr, spec: string) {
    // Accept either "extern" or "extern\tname" — store verbatim (already
    // the wire format when it carries a tab; otherwise it's the whole
    // category, which is "<kind>\t" with an empty arg).
    if string.index_of(spec, "\t") >= 0 {
        _policy_add(p, spec)
    } else {
        _policy_add(p, string.concat(spec, "\t"))
    }
}

// banned(p, "<substring>") — veto when the substring appears in any call's
// literal argument (coordinate/host/command fragment).
banned(p: ptr, substring: string) {
    _policy_add(p, string.concat("banned\t", substring))
}

// coord_verb(p, "<callee>") — declare a resolver verb whose literal
// coordinate is allowlist-gated by coord_allow() prefixes. A call to this
// verb with a coordinate not matching any allowed prefix is vetoed; a
// computed coordinate fail-closes. Pair with one or more coord_allow().
//   veto.coord_verb(p, "maven_dep")   // gate maven.dep coordinates…
//   veto.coord_allow(p, "org.corp:")  // …to the corp group only
coord_verb(p: ptr, callee: string) {
    _policy_add(p, string.concat("coord_verb\t", callee))
}

// coord_allow(p, "<prefix>") — an allowed leading literal prefix for any
// coord_verb's coordinate. The prefix is the attacker-immovable stem
// (group, or scheme+host+/). Anything not starting with an allowed prefix is
// vetoed for the gated verbs.
coord_allow(p: ptr, prefix: string) {
    _policy_add(p, string.concat("coord_allow\t", prefix))
}

// allow_exec(p, "<sym-or-path>") — exempt this exec target from a deny-exec.
allow_exec(p: ptr, sym: string) {
    _policy_add(p, string.concat("allow\texec\t", sym))
}

// allow_import(p, "<module>") — exempt this import from a deny-import.
allow_import(p: ptr, modpath: string) {
    _policy_add(p, string.concat("allow\timport\t", modpath))
}

// scope(p, "untrusted") — recorded for future per-scope policy; the default
// and only behaviour today is "rules fire on non-`--lib` (untrusted) nodes".
scope(p: ptr, s: string) {
    _e = map.put(p, "veto_scope", s)
}

// policy_rules(p) — the resolved rule list a policy.ae produced, for
// decide(). Returns the empty list (not null) when nothing was declared.
policy_rules(p: ptr) {
    if p == null { return list.new() }
    if map.has(p, "veto_rules") == 0 { return list.new() }
    rs, _ = map.get(p, "veto_rules")
    return rs
}

// policy_rule_count(p) — for the self-vetting lint: --vet with a policy that
// resolves to ZERO rules is itself an error (vet-requested-but-denies-nothing
// → refuse, never fall through). The caller treats 0 as fail-closed.
policy_rule_count(p: ptr) {
    return list.size(policy_rules(p))
}

// emit_policy(p) — print the resolved rule list, one "<kind>\t<arg>" per
// line, to stdout. The transport out of a compiled operator policy.ae: the
// policy's main() builds `p` with the DSL then calls veto.emit_policy(p);
// aeb-vet runs that binary, captures stdout, and reconstructs the rule list
// for decide(). Empty list → no output → aeb-vet's zero-rules lint fires.
emit_policy(p: ptr) {
    rs = policy_rules(p)
    n = list.size(rs)
    i = 0
    while i < n {
        r, _ = list.get(rs, i)
        println(r)
        i = i + 1
    }
    return 0
}

// rules_from_lines(text) — inverse of emit_policy: parse newline-separated
// "<kind>\t<arg>" rows back into a rule list (skip blanks). Used by aeb-vet
// to turn the policy binary's captured stdout into rules for decide().
rules_from_lines(text: string) {
    out = list.new()
    rest = text
    while string.length(rest) > 0 {
        nl = string.index_of(rest, "\n")
        line = ""
        if nl < 0 { line = rest  rest = "" }
        else { line = string.substring(rest, 0, nl)  rest = string.substring(rest, nl + 1, string.length(rest)) }
        line = string.trim(line)
        if string.length(line) > 0 { list.add(out, line) }
    }
    return out
}

// --- Command builder (pure) ---

// emit_ast_cmd(aetherc, lib_flags, file) — the `aetherc --emit=ast`
// invocation. Pure. lib_flags is a pre-assembled " --lib A --lib B"
// string (or ""). Output JSON goes to stdout; aeb captures it.
emit_ast_cmd(aetherc: string, lib_flags: string, file: string) {
    return "'${aetherc}' --emit=ast${lib_flags} '${file}'"
}

// _lib_flags(lib_roots) — " --lib 'r1' --lib 'r2'" from a list, or "".
_lib_flags(lib_roots: ptr) {
    if lib_roots == null { return "" }
    n = list.size(lib_roots)
    out = ""
    i = 0
    while i < n {
        r, _ = list.get(lib_roots, i)
        out = string.concat(out, string.concat(" --lib '", string.concat(r, "'")))
        i = i + 1
    }
    return out
}

// --- Origin classification (pure) ---

// _is_lib_origin(file, lib_roots) — 1 when `file` resolves under any
// trusted --lib root (so the node is a vendored SDK, exempt from deny
// rules), else 0. Prefix match on the resolved path string.
_is_lib_origin(file: string, lib_roots: ptr) {
    if string.length(file) == 0 { return 0 }
    if lib_roots == null { return 0 }
    n = list.size(lib_roots)
    i = 0
    while i < n {
        root, _ = list.get(lib_roots, i)
        if string.length(root) > 0 {
            if string.starts_with(file, root) == 1 { return 1 }
        }
        i = i + 1
    }
    return 0
}

// --- Per-node verdict (pure) ---
//
// _node_verdict(kind, callee, name, modpath, file, indirect,
//               arg_literal, arg_computed, lib_roots, rules)
// — given the already-extracted fields of ONE AST node, return "" (allowed)
// or a one-line veto reason. Fail-closed on indirect calls and on a
// deny-category match with NULL/empty origin.
//
// `kind` is the AST node kind ("extern_function"/"function_call"/
// "import_statement"); `callee`/`name`/`modpath` are the relevant symbol
// (empty when not that kind); `indirect` is 1 for a function-pointer call;
// `file` is the node origin ("" / NULL → untrusted-or-synthetic).
// args (function_call only, from the post-v0.227.0 emit):
//   `arg_literal`  — the FIRST literal arg's value, or "" if none/this isn't
//                    a call. The coordinate/command a resolver/exec/net verb
//                    was handed (maven.dep("org:foo:1.2.3") → "org:foo:1.2.3").
//   `arg_computed` — 1 if ANY arg of this call is `{"computed":true}`.
_node_verdict(kind: string, callee: string, name: string, modpath: string,
              file: string, indirect: int, arg_literal: string,
              arg_computed: int, lib_roots: ptr, rules: ptr) {
    // SDK-origin nodes are exempt — the trusted --lib roots legitimately
    // declare externs and shell out.
    if _is_lib_origin(file, lib_roots) == 1 { return "" }

    // Indirect call in non-lib code: no static target to inspect → the
    // opaque-computation case → fail-closed.
    if string.equals(kind, "function_call") == 1 {
        if indirect == 1 {
            return "indirect (function-pointer) call in untrusted code — no static target to vet (veto:indirect)"
        }
    }

    nr = list.size(rules)
    ri = 0
    while ri < nr {
        rule, _ = list.get(rules, ri)
        rk = _rule_kind(rule)
        ra = _rule_arg(rule)
        ri = ri + 1

        // extern: match the declaration (the choke point). A whole-category
        // extern rule (arg "") still exempts the known-safe runtime externs
        // every ordinary .ae declares (println, etc.) — denying those would
        // false-positive on legitimate code (found by the live smoke). A
        // specific extern rule (arg = name) overrides the allowlist: an
        // operator can still deny a named runtime extern if they choose.
        if string.equals(rk, "extern") == 1 {
            if string.equals(kind, "extern_function") == 1 {
                if string.length(ra) == 0 {
                    if _is_safe_runtime_extern(name) == 0 {
                        return _reason("extern", name, file)
                    }
                } else {
                    if string.equals(ra, name) == 1 {
                        return _reason("extern", name, file)
                    }
                }
            }
        }
        // exec: resolved callee in the os_system/os_exec/os_run_* family.
        // With args on the wire, a deny-exec rule ALSO fail-closes a shell
        // call handed a computed (non-literal) argument — a build that
        // computes what it shells out can't be vetted statically.
        //
        // allow_exec("<cmd>") exempts an exec whose LITERAL command names an
        // allowed program (the first token of the literal arg). A computed
        // arg can't be checked → never allowed → fail-close stands.
        if string.equals(rk, "exec") == 1 {
            if string.equals(kind, "function_call") == 1 {
                if _is_exec_callee(callee) == 1 {
                    if string.length(ra) == 0 || string.equals(ra, callee) == 1 {
                        if arg_computed == 1 {
                            return _reason_arg("exec", callee, file, "<computed-arg>")
                        }
                        if _exec_allowed(rules, arg_literal) == 0 {
                            return _reason_arg("exec", callee, file, arg_literal)
                        }
                    }
                }
            }
        }
        // net: resolved callee in the tcp_connect/http_* family. Same
        // computed-arg fail-close as exec.
        if string.equals(rk, "net") == 1 {
            if string.equals(kind, "function_call") == 1 {
                if _is_net_callee(callee) == 1 {
                    if string.length(ra) == 0 || string.equals(ra, callee) == 1 {
                        if arg_computed == 1 {
                            return _reason_arg("net", callee, file, "<computed-arg>")
                        }
                        return _reason_arg("net", callee, file, arg_literal)
                    }
                }
            }
        }
        // import: match the imported module path. allow_import("<mod>")
        // exempts that module from a deny-import.
        if string.equals(rk, "import") == 1 {
            if string.equals(kind, "import_statement") == 1 {
                if _import_allowed(rules, modpath) == 1 {
                    // exempt
                } else
                if string.length(ra) == 0 || string.equals(ra, modpath) == 1 {
                    return _reason("import", modpath, file)
                }
            }
        }
        // banned: a substring that must not appear in ANY literal argument of
        // any call (banned coordinate / host / command fragment). e.g.
        // "banned\tevil.com" vetoes maven.dep("…evil.com…") or
        // build._sh("curl http://evil.com"). Reads the LITERAL arg only — a
        // computed arg can't be string-matched, but a deny-exec/net rule will
        // have fail-closed it already; banned is the targeted-substring layer
        // on top of the category deny.
        if string.equals(rk, "banned") == 1 {
            if string.equals(kind, "function_call") == 1 {
                if string.length(ra) > 0 && string.length(arg_literal) > 0 {
                    if string.index_of(arg_literal, ra) >= 0 {
                        return _reason_arg("banned", callee, file, arg_literal)
                    }
                }
            }
        }
        // coord_verb: the POSITIVE counterpart to banned. `coord_verb\t<callee>`
        // declares a resolver verb whose coordinate is allowlist-gated; the
        // separate `coord_allow\t<prefix>` rules are the allowed literal
        // prefixes. For a call to a coord-verb, the literal coordinate MUST
        // start with some allowed prefix — else veto. A computed coordinate to
        // a coord-verb fail-closes (can't check the stem). Only coord-verbs are
        // gated; every other call is untouched (no false-positives). This is
        // the "allow only org.corp:* coordinates" convention, made safe: the
        // operator's prefix list, the leading literal stem an attacker can't
        // move, fail-closed on computed.
        if string.equals(rk, "coord_verb") == 1 {
            if string.equals(kind, "function_call") == 1 {
                if string.length(ra) > 0 && string.equals(ra, callee) == 1 {
                    if arg_computed == 1 {
                        return _reason_arg("coord", callee, file, "<computed-coordinate>")
                    }
                    if _coord_allowed(rules, arg_literal) == 0 {
                        return _reason_arg("coord", callee, file, arg_literal)
                    }
                }
            }
        }
    }
    return ""
}

// _reason(cat, sym, file) — the veto reason line. A matched node with
// NULL/empty origin is surfaced explicitly (fail-closed, not silently
// trusted): a deny-category hit we can't attribute to a file is suspicious.
_reason(cat: string, sym: string, file: string) {
    where = file
    if string.length(where) == 0 { where = "<unknown-origin>" }
    return string.concat("denied ", string.concat(cat, string.concat(": ", string.concat(sym, string.concat(" (", string.concat(where, string.concat(") (veto:", string.concat(cat, ")"))))))))
}

// _reason_arg(cat, sym, file, arg) — like _reason but names the argument
// (the literal coordinate/command, or "<computed-arg>"), so the operator sees
// WHAT was handed to the verb: `denied exec: os_system arg "curl …" (file)`.
_reason_arg(cat: string, sym: string, file: string, arg: string) {
    base = _reason(cat, sym, file)
    if string.length(arg) == 0 { return base }
    // splice ` arg "<arg>"` before the trailing " (file) (veto:…)" — simplest
    // is to append; the file+veto tag are already in `base`.
    return string.concat(base, string.concat(" arg=\"", string.concat(arg, "\"")))
}

// _is_exec_callee(c) — the os.system / os.exec / os.run_* family.
_is_exec_callee(c: string) {
    if string.equals(c, "os_system") == 1 { return 1 }
    if string.equals(c, "os_exec") == 1 { return 1 }
    if string.starts_with(c, "os_run") == 1 { return 1 }
    return 0
}

// _is_net_callee(c) — the tcp_connect / http_* family.
_is_net_callee(c: string) {
    if string.equals(c, "tcp_connect") == 1 { return 1 }
    if string.starts_with(c, "http_") == 1 { return 1 }
    return 0
}

// _first_token(s) — the first whitespace-delimited token of a command
// string (`"gcc -c foo.c"` → `"gcc"`). The program an exec invokes.
_first_token(s: string) {
    sp = string.index_of(s, " ")
    if sp < 0 { return s }
    return string.substring(s, 0, sp)
}

// _exec_allowed(rules, arg_literal) — 1 if an `allow\texec\t<cmd>` rule
// names the program this exec invokes (the first token of the literal
// command). "" literal → not allowed (can't identify the program).
_exec_allowed(rules: ptr, arg_literal: string) {
    if string.length(arg_literal) == 0 { return 0 }
    prog = _first_token(arg_literal)
    n = list.size(rules)
    i = 0
    while i < n {
        r, _ = list.get(rules, i)
        i = i + 1
        // allow rule: kind "allow", arg "exec\t<cmd>"
        if string.equals(_rule_kind(r), "allow") == 1 {
            ra = _rule_arg(r)               // "exec\t<cmd>"
            if string.equals(_rule_kind(ra), "exec") == 1 {
                allowed = _rule_arg(ra)     // "<cmd>"
                if string.equals(allowed, prog) == 1 { return 1 }
                // also allow the whole literal matching (e.g. allow an
                // exact command with args)
                if string.equals(allowed, arg_literal) == 1 { return 1 }
            }
        }
    }
    return 0
}

// _coord_allowed(rules, arg_literal) — 1 if the literal coordinate starts
// with some `coord_allow\t<prefix>` rule's prefix. "" literal → not allowed
// (a coord-verb with no literal coordinate can't be checked → caller
// fail-closes). The prefix is the attacker-immovable leading stem (e.g.
// "org.corp:" pins the group; "https://mirror.corp/" pins scheme+host+/).
_coord_allowed(rules: ptr, arg_literal: string) {
    if string.length(arg_literal) == 0 { return 0 }
    n = list.size(rules)
    i = 0
    while i < n {
        r, _ = list.get(rules, i)
        i = i + 1
        if string.equals(_rule_kind(r), "coord_allow") == 1 {
            prefix = _rule_arg(r)
            if string.length(prefix) > 0 {
                if string.starts_with(arg_literal, prefix) == 1 { return 1 }
            }
        }
    }
    return 0
}

// _import_allowed(rules, modpath) — 1 if an `allow\timport\t<mod>` rule
// names this module.
_import_allowed(rules: ptr, modpath: string) {
    if string.length(modpath) == 0 { return 0 }
    n = list.size(rules)
    i = 0
    while i < n {
        r, _ = list.get(rules, i)
        i = i + 1
        if string.equals(_rule_kind(r), "allow") == 1 {
            ra = _rule_arg(r)               // "import\t<mod>"
            if string.equals(_rule_kind(ra), "import") == 1 {
                if string.equals(_rule_arg(ra), modpath) == 1 { return 1 }
            }
        }
    }
    return 0
}

// _is_safe_runtime_extern(name) — 1 for the small set of runtime externs
// that ordinary .ae code legitimately declares and that are NOT a C-escape
// vector (they cross into the trusted Aether runtime, not arbitrary libc).
// A whole-category `deny extern` exempts these so it doesn't false-positive
// on every normal program; the DANGEROUS externs (syscall, fopen, dlopen,
// open, execve, system, mmap, …) are NOT on this list and still trip.
// An operator who wants to deny even these can write a specific
// `extern\t<name>` rule, which overrides the allowlist.
_is_safe_runtime_extern(name: string) {
    if string.equals(name, "println") == 1 { return 1 }
    if string.equals(name, "print") == 1 { return 1 }
    if string.equals(name, "exit") == 1 { return 1 }
    if string.equals(name, "panic") == 1 { return 1 }
    if string.equals(name, "assert") == 1 { return 1 }
    return 0
}

// --- Whole-AST decision (parses JSON; the one impure-ish helper, but
//     deterministic and unit-testable on a JSON string) ---

// decide(ast_json, emit_exit, lib_roots, rules) — the verdict for a whole
// `aetherc --emit=ast` run. Returns "" (CLEAR) or a one-line veto reason.
//
// FAIL-CLOSED: a non-zero `emit_exit` (compiler couldn't emit a clean AST)
// is an immediate veto — no AST ⇒ no clearance ⇒ no build. A malformed/
// unparseable AST is likewise a veto.
decide(ast_json: string, emit_exit: int, lib_roots: ptr, rules: ptr) {
    if emit_exit != 0 {
        return "aetherc --emit=ast exited ${string.from_int(emit_exit)} (no clean AST) — fail-closed (veto:no-ast)"
    }
    parsed, perr = json.parse(ast_json)
    if string.length(perr) > 0 {
        return "could not parse emitted AST (${perr}) — fail-closed (veto:bad-ast)"
    }
    nodes_v, _ne = json.object_get(parsed, "nodes")
    if nodes_v == null {
        return "emitted AST has no 'nodes' array — fail-closed (veto:bad-ast)"
    }
    n = json.array_size(nodes_v)
    i = 0
    while i < n {
        node, _ge = json.array_get(nodes_v, i)
        i = i + 1
        if node != null {
            kind = _json_str(node, "kind")
            callee = _json_str(node, "callee")
            name = _json_str(node, "name")
            modpath = _json_str(node, "module")
            file = _json_str(node, "file")
            indirect = _json_truthy(node, "indirect")
            arg_literal = _first_literal_arg(node)
            arg_computed = _has_computed_arg(node)
            v = _node_verdict(kind, callee, name, modpath, file, indirect,
                              arg_literal, arg_computed, lib_roots, rules)
            if string.length(v) > 0 { return v }
        }
    }
    return ""
}

// _json_str(node, key) — string field or "". Tolerates absent key.
_json_str(node: ptr, key: string) {
    v, _e = json.object_get(node, key)
    if v == null { return "" }
    s, _se = json.get_string(v)
    return s
}
// _json_truthy(node, key) — 1 when key is present and true-ish.
_json_truthy(node: ptr, key: string) {
    v, _e = json.object_get(node, key)
    if v == null { return 0 }
    b = json.get_bool(v)
    if b == 1 { return 1 }
    return 0
}

// _first_literal_arg(node) — the value of the FIRST `{"literal": "..."}`
// entry in the node's `args[]`, or "" if there's no args array or no literal
// arg. Reads the coordinate/command a resolver/exec/net verb was handed.
// (post-v0.227.0 emit; absent on older AST → "" → no arg-based rule fires.)
_first_literal_arg(node: ptr) {
    args_v, _e = json.object_get(node, "args")
    if args_v == null { return "" }
    n = json.array_size(args_v)
    i = 0
    while i < n {
        a, _ge = json.array_get(args_v, i)
        i = i + 1
        if a != null {
            lit_v, _le = json.object_get(a, "literal")
            if lit_v != null {
                s, _se = json.get_string(lit_v)
                return s
            }
        }
    }
    return ""
}

// _has_computed_arg(node) — 1 if ANY arg of this call is `{"computed":true}`.
// A computed arg to an exec/net verb is the fail-close trigger.
_has_computed_arg(node: ptr) {
    args_v, _e = json.object_get(node, "args")
    if args_v == null { return 0 }
    n = json.array_size(args_v)
    i = 0
    while i < n {
        a, _ge = json.array_get(args_v, i)
        i = i + 1
        if a != null {
            if _json_truthy(a, "computed") == 1 { return 1 }
        }
    }
    return 0
}

// --- The builder ---
//
// veto.check(b) { aetherc("…") lib_root("…") target("path/to/file.ae") }
// runs --emit=ast on the target and applies the built-in default rules.
// (Operator policy via a .veto.ae DSL lowers onto `rules` here — next
// increment.) A veto FAILS the node; a clear pass writes a marker.

aetherc(_ctx: ptr, bin: string) { _e = map.put(_ctx, "veto_aetherc", bin) }
lib_root(_ctx: ptr, root: string) {
    if map.has(_ctx, "veto_lib_roots") == 0 { _e1 = map.put(_ctx, "veto_lib_roots", list.new()) }
    l, _ = map.get(_ctx, "veto_lib_roots")
    _e2 = list.add(l, root)
}
target(_ctx: ptr, path: string) { _e = map.put(_ctx, "veto_target", path) }

_str_opt(builder_map: ptr, key: string, dflt: string) {
    if builder_map != null {
        if map.has(builder_map, key) == 1 {
            v, _ = map.get(builder_map, key)
            if string.length(v) > 0 { return v }
        }
    }
    return dflt
}

builder check(ctx: ptr) {
    source_dir = build._get(ctx, "source_dir")
    target_dir = build._get(ctx, "target_dir")
    mod_dir = build._get(ctx, "module_dir")
    build._mkdirs(target_dir)

    aetherc_bin = _str_opt(_builder, "veto_aetherc", "aetherc")
    tgt_rel = _str_opt(_builder, "veto_target", "")
    if string.length(tgt_rel) == 0 {
        println("${mod_dir}: veto.check: declare target(\"path/to/file.ae\")")
        build.fail(ctx, "veto.check: no target() declared")
        return 1
    }
    tgt = tgt_rel
    if build._is_abs_path(tgt_rel) == 0 { tgt = path.join(source_dir, tgt_rel) }

    lib_roots = list.new()
    if _builder != null {
        if map.has(_builder, "veto_lib_roots") == 1 { lib_roots, _ = map.get(_builder, "veto_lib_roots") }
    }
    rules = default_rules()

    println("${mod_dir}: vetting ${tgt_rel} (aetherc --emit=ast)")
    cmd = emit_ast_cmd(aetherc_bin, _lib_flags(lib_roots), tgt)
    ast_json, _err = build._sh_capture(cmd)
    // os.exec gives us stdout; capture the exit via a marker run.
    rc = build._sh(string.concat(cmd, " >/dev/null 2>&1"))

    reason = decide(ast_json, rc, lib_roots, rules)
    if string.length(reason) > 0 {
        println("${mod_dir}: VETOED — ${reason}")
        build.fail(ctx, "vetoed: ${reason}")
        return 1
    }
    println("${mod_dir}: veto CLEAR")
    build._write_artifact(ctx, "veto_verdict", "clear")
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}
