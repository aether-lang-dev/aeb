// groovy — Groovy SDK for aeb.
//
// Compiles Groovy with `groovyc` to JVM .class files; tests (typically
// JUnit 5) then run via the language-agnostic java.junit5. Mirrors
// lib/kotlin: the SDK resolves the Groovy install (GROOVY_HOME / /opt /
// apt) and puts its runtime jars on the classpath, so a .build.ae just
// says groovy.groovyc(b).
//
//   import build
//   import groovy
//   import groovy (source_layout)
//   aeb(cap) { b = build.start(); build.dep(b, "java/.build.ae")
//              groovy.groovyc(b) { source_layout("maven idiomatic") } }
import build
import cache
import maven
import std.string
import std.io
import std.os
import std.file
import std.fs
import std.list
import std.map
import std.path
import std.dir

// --- DSL setters ---

source_layout(_ctx: ptr, layout: string) {
    _e = map.put(_ctx, "source_layout", layout)
}

// target_bytecode("22") — emit class files at this JDK bytecode level
// (groovy reads it from -Dgroovy.target.bytecode). Needed when the running
// JDK is newer than groovy's ASM understands (e.g. groovyc on JDK 25 would
// emit major-69 it can't re-read at test-compile); also matches an existing
// project's pom release level so the classes interop with javac/kotlinc out.
target_bytecode(_ctx: ptr, ver: string) {
    _e = map.put(_ctx, "groovy_target_bytecode", ver)
}

// min_groovy("4") / min_jdk("22") — declare the MINIMUM capable toolchain this
// node needs, as a HARD REQUIREMENT. When either is set, groovyc_test resolves a
// groovyc + JVM by VERIFYING a candidate (compile+run a probe against the node's
// real dep classes) rather than grabbing the first groovyc on PATH — and if none
// qualifies it FAILS (a requested-but-absent capable toolchain is a
// misconfiguration). The Java FFM binding these suites test is JDK-22+ bytecode,
// so a Debian groovy 2.4 on JDK 17 can neither read nor run it. Version STRINGS
// (major[.minor[.patch]]), so "4" or "4.0" for Groovy 4. Unset → today's
// behaviour (first groovyc found). For a portable matrix that should SKIP on
// under-provisioned boxes, use skip_below_groovy / skip_below_jdk.
min_groovy(_ctx: ptr, ver: string) {
    _e = map.put(_ctx, "min_groovy", ver)
}
min_jdk(_ctx: ptr, ver: string) {
    _e = map.put(_ctx, "min_jdk", ver)
}

// skip_below_groovy("4") / skip_below_jdk("22") — PORTABLE-FLEET floors: same
// verify-by-probe, but SKIP (green) rather than fail when no capable toolchain
// qualifies. For a heterogeneous conformance matrix that must not go red on
// every box lacking a capable Groovy/JDK. Soft counterparts to min_groovy /
// min_jdk; a min_* requirement wins over a skip_below_* floor. Version STRINGS.
skip_below_groovy(_ctx: ptr, ver: string) {
    _e = map.put(_ctx, "skip_below_groovy", ver)
}
skip_below_jdk(_ctx: ptr, ver: string) {
    _e = map.put(_ctx, "skip_below_jdk", ver)
}

// main_class("pkg.Runner") — run this class as the test suite AFTER compiling,
// instead of leaving the classes for java.junit5. For a custom conformance
// runner (a plain `static void main`) rather than a JUnit5 suite. The class is
// run on the SAME verified JVM the probe selected, with the compiled
// test-classes + deps on the classpath. Unset → compile only (JUnit5 path).
main_class(_ctx: ptr, cls: string) {
    _e = map.put(_ctx, "main_class", cls)
}

// jvm_flag("--enable-native-access=ALL-UNNAMED") — one extra flag passed to the
// JVM that runs main_class (repeatable). Needed by FFM/native-access runners.
// Ignored unless main_class is set.
jvm_flag(_ctx: ptr, flag: string) {
    if map.has(_ctx, "jvm_flag") == 0 {
        _e1 = map.put(_ctx, "jvm_flag", list.new())
    }
    flags, _ = map.get(_ctx, "jvm_flag")
    _e2 = list.add(flags, flag)
}

// _java_opts(builder_map) — the `JAVA_OPTS="..." ` prefix that carries
// target_bytecode into the groovyc process, or "" when unset.
_java_opts(builder_map: ptr) {
    if builder_map != null {
        if map.has(builder_map, "groovy_target_bytecode") == 1 {
            v, _ = map.get(builder_map, "groovy_target_bytecode")
            return "JAVA_OPTS=\"-Dgroovy.target.bytecode=${v}\" "
        }
    }
    return ""
}

// --- Command builder (pure) ---

// groovyc_cmd — `groovyc -d <out> -cp <cp> <files>`. Pure.
groovyc_cmd(groovyc_bin: string, classes_dir: string, classpath: string, file_list: string) {
    return "${groovyc_bin} -d ${classes_dir} -cp ${classpath} ${file_list}"
}

// --- Install resolution ---

// _groovy_home() — GROOVY_HOME wins; else the first probed root whose
// bin/groovyc exists. /opt/groovy (a modern hand-installed 4.x) is
// preferred over /usr/share/groovy (apt, often an ancient 2.x that
// won't run on a current JDK). "" → bare `groovyc` on PATH.
_groovy_home() {
    env_home = os.getenv("GROOVY_HOME")
    if env_home != 0 { return env_home }
    opt = "/opt/groovy"
    if file.exists(path.join(opt, "bin/groovyc")) == 1 { return opt }
    apt = "/usr/share/groovy"
    if file.exists(path.join(apt, "bin/groovyc")) == 1 { return apt }
    return ""
}

_groovyc_bin(groovy_home: string) {
    if string.length(groovy_home) > 0 {
        cand = path.join(groovy_home, "bin/groovyc")
        if file.exists(cand) == 1 { return cand }
    }
    return "groovyc"
}

// _groovy_jars_nl(home) — newline-separated list of groovy's OWN runtime
// jars (groovy-*.jar: core + json/xml/etc. modules) under <home>/lib, for
// the compile classpath and the published-for-consumers artifact. Filters
// to `groovy-*.jar` deliberately: a groovy distro's lib/ also bundles its
// test-support deps (junit-platform-launcher, testng, ant, jackson…), and
// leaking those onto a consumer's classpath shadows the consumer's own
// junit with groovy's older one (forExecution() NoSuchMethodError).
_groovy_jars_nl(groovy_home: string) {
    if string.length(groovy_home) == 0 { return "" }
    libdir = path.join(groovy_home, "lib")
    raw, _e = build._sh_capture("ls '${libdir}'/groovy-*.jar 2>/dev/null")
    return string.trim(raw)
}

// _nl_to_colon(s) — newline-separated → colon-separated (classpath form).
_nl_to_colon(s: string) {
    if string.length(s) == 0 { return "" }
    out, _e = build._sh_capture("printf '%s' '${s}' | tr '\n' ':' | sed 's/:$//'")
    return string.trim(out)
}

// --- Content-addressed cache ---

// _groovyc_version(groovyc_bin) — `groovyc --version` first line, the
// toolchain-bump invalidator for the cache key. Memoised per build via an
// env-var cache (the probe forks a JVM). Returns "" when groovyc is absent;
// the key is still deterministic within a run.
_groovyc_version(groovyc_bin: string) {
    cached = os.getenv("_AEB_GROOVYC_VERSION_CACHE")
    if string.length(cached) > 0 { return cached }
    raw, _err = os.exec("'${groovyc_bin}' --version 2>&1 | head -1")
    return string.trim(raw)
}

// _cache_key_for_groovyc — cache key for a groovyc compile action.
// Mirrors java/scala/kotlin (the JVM class-tree shape). Inputs
// (length-prefixed, sorted via cache.hash_inputs):
//   - groovyc version — toolchain-bump invalidator
//   - the groovy runtime jar list (paths embed the version, e.g.
//     groovy-4.0.21.jar) — a groovy upgrade busts the key
//   - canonical groovyc command string — captures the classpath, the
//     -d output dir, and the JAVA_OPTS target-bytecode prefix
//   - each .groovy source's path + content hash, sorted by path
//   - each dep's jvm_classpath_deps_including_transitive content —
//     captures upstream rebuilds
//
// FALSE-HIT HAZARD (same as javac): a sibling dep's local classes/ tree
// can change while its classpath string stays the same; the dep artifact
// content hash catches most real changes. Punted to full correctness for
// v1. Returns ("", err) on any source read failure — caller falls through
// to the live groovyc build.
_cache_key_for_groovyc(ctx: ptr, argfile_path: string, groovyc_cmd_str: string, groovy_jars_nl: string, groovyc_bin: string) {
    parts = list.new()

    list.add(parts, string.concat("groovyc:", _groovyc_version(groovyc_bin)))
    list.add(parts, string.concat("groovy-jars:", groovy_jars_nl))
    list.add(parts, string.concat("cmd:", groovyc_cmd_str))

    sources = build._read_argfile_lines(argfile_path)
    nsrc = list.size(sources)
    si = 0
    while si < nsrc {
        src, _ = list.get(sources, si)
        sh, serr = cache.hash_file(src)
        if string.length(serr) > 0 {
            return "", serr
        }
        list.add(parts, string.concat("src:", src))
        list.add(parts, string.concat("src-hash:", sh))
        si = si + 1
    }

    deps, _ = map.get(ctx, "deps")
    dn = list.size(deps)
    di = 0
    while di < dn {
        dp, _ = list.get(deps, di)
        dm = build._strip_lang(dp)
        dep_cp = build._read_dep_artifact(ctx, dm, "jvm_classpath_deps_including_transitive")
        if string.length(dep_cp) > 0 {
            list.add(parts, string.concat("dep:", dm))
            list.add(parts, string.concat("dep-cp:", dep_cp))
        }
        di = di + 1
    }

    digest, derr = cache.hash_inputs(parts)
    return digest, derr
}

// _write_argfile(target_dir, name, file_list) — write a space-separated
// source list as a newline argfile so the cache-key helper can hash each
// source. Returns the argfile path.
_write_argfile(target_dir: string, name: string, file_list: string) {
    argfile = path.join(target_dir, name)
    paths = string.split(file_list, " ")
    af = ""
    i = 0
    n = list.size(paths)
    while i < n {
        p, _ = list.get(paths, i)
        p = string.trim(p)
        if string.length(p) > 0 {
            if string.length(af) > 0 { af = string.concat(af, "\n") }
            af = string.concat(af, p)
        }
        i = i + 1
    }
    _e = io.write_file(argfile, af)
    return argfile
}

// --- SDK functions ---

// groovy.groovyc(b) — compile src/main/groovy (or flat *.groovy).
builder groovyc(ctx: ptr): int {
    source_dir = build._get(ctx, "source_dir")
    target_dir = build._get(ctx, "target_dir")
    mod_dir = build._get(ctx, "module_dir")

    classes_dir = path.join(target_dir, "classes")
    build._mkdirs(classes_dir)
    println("${mod_dir}: compiling prod code (groovyc)")

    groovy_home = _groovy_home()
    groovyc_bin = _groovyc_bin(groovy_home)
    groovy_jars_nl = _groovy_jars_nl(groovy_home)
    groovy_cp = _nl_to_colon(groovy_jars_nl)

    dep_cp = build._build_dep_classpath(ctx)
    maven_cp = maven.classpath(ctx)
    classpath = build._cp_append(classes_dir, groovy_cp)
    classpath = build._cp_append(classpath, dep_cp)
    classpath = build._cp_append(classpath, maven_cp)

    file_list = _source_files(_builder, source_dir, "src/main/groovy")
    if string.length(file_list) == 0 {
        println("${mod_dir}: no Groovy source files found")
        return 0
    }

    cmd = string.concat(_java_opts(_builder), groovyc_cmd(groovyc_bin, classes_dir, classpath, file_list))

    // Cache check: hash sources + groovy jars + classpath + flags +
    // groovyc version, restore the classes/ tarball on hit and skip
    // groovyc. exit_code sentinel: 0 = cache hit, -1 = run groovyc below.
    argfile = _write_argfile(target_dir, "groovyc_sources.txt", file_list)
    cache_key = ""
    exit_code = -1
    if cache.available() == 1 {
        ck, kerr = _cache_key_for_groovyc(ctx, argfile, cmd, groovy_jars_nl, groovyc_bin)
        if string.length(kerr) == 0 {
            cache_key = ck
            tmp_raw, _terr = os.exec("mktemp")
            tmp_tar = build._to_native_path(string.trim(tmp_raw))
            if string.length(tmp_tar) > 0 {
                grc = cache.get(cache_key, tmp_tar)
                if string.length(grc) == 0 {
                    uerr = build._untar_into(tmp_tar, classes_dir)
                    os.system("rm -f '${tmp_tar}'")
                    if string.length(uerr) == 0 {
                        println("${mod_dir}: groovyc cache hit ${cache_key}")
                        build._record_cache(ctx, "hit")
                        exit_code = 0
                    } else {
                        os.system("rm -rf '${classes_dir}'")
                        build._mkdirs(classes_dir)
                    }
                } else {
                    os.system("rm -f '${tmp_tar}'")
                }
            }
        }
    }

    if exit_code == -1 {
        if cache.available() == 0 {
            build._record_cache(ctx, "unavailable")
        } else {
            build._record_cache(ctx, "miss")
        }
        rc = build._sh(cmd)
        if rc != 0 {
            println("${mod_dir}: groovyc failed")
            build.fail(ctx, "groovyc failed")
            return rc
        }
        // Only cache a non-empty output tree (an exit-0-but-empty compile would
        // otherwise be served as a hit with zero .class files).
        if string.length(cache_key) > 0 && build._dir_nonempty(classes_dir) == 1 {
            tar_path, terr = build._tar_dir(classes_dir)
            if string.length(terr) == 0 {
                perr = cache.put(cache_key, tar_path)
                os.system("rm -f '${tar_path}'")
                if string.length(perr) > 0 {
                    println("${mod_dir}: groovyc cache write failed: ${perr}")
                }
            }
        }
    }

    // Publish classes + groovy runtime jars so consumers (groovyc_test,
    // java.junit5) get them transitively on classpath.
    cp_out = string.concat(classes_dir, "\n")
    cp_out = string.concat(cp_out, groovy_jars_nl)
    if string.length(dep_cp) > 0 { cp_out = string.concat(string.concat(cp_out, "\n"), _colon_to_nl(dep_cp)) }
    build._write_artifact(ctx, "jvm_classpath_deps_including_transitive", cp_out)
    return 0
}

// --- Capable-toolchain resolution (min_groovy / min_jdk) ------------------
//
// The problem this solves, measured: the Java FFM binding html-sanitizer's
// Groovy layer compiles against is JDK-22+ bytecode, and groovyc LOADS those
// classes into its own JVM. So "groovy on PATH" (often Debian's 2.4 on JDK 17)
// is NOT the same question as "Groovy that can build this" — the wrong one
// yields UnsupportedClassVersionError, or worse a Groovy 3 that compiles and
// then dies at run time (no Object.withCloseable). We enumerate candidates and
// VERIFY the choice by compiling+running a probe against the real dep classes,
// exactly as groovy/run-tests.sh does — but in the SDK.

// _min_int(builder_map, key) — declared minimum as an int, or 0 if unset.
_min_int(builder_map: ptr, key: string) {
    if builder_map == null { return 0 }
    if map.has(builder_map, key) == 0 { return 0 }
    v, _ = map.get(builder_map, key)
    iv, _e = string.to_int(string.trim(v))
    return iv
}

// _java_ge(want) — a JDK satisfying the version floor `want` (string), or "".
// Thin wrapper over the shared build._java_ge; kept as a local name so the
// groovy resolver reads cleanly.
_java_ge(want: string) {
    return build._java_ge(want)
}

// _groovy_core_jars_desc() — newline list of groovy-<ver>.jar core jars from
// $GROOVY_JAR, $GROOVY_HOME/lib, the groovy on PATH's lib, ~/.m2 and gradle
// dists — newest first by EXTRACTED version (not path, so a gradle-bundled 3.x
// under a deep path can't outrank an m2 4.x). Mirrors run-tests.sh
// list_core_groovy_jars: version-anchored so groovy-xml/json sub-artifacts and
// -sources jars are excluded.
_groovy_core_jars_desc() {
    globs = "$GROOVY_JAR $GROOVY_HOME/lib/groovy-[0-9]*.jar $HOME/.m2/repository/org/apache/groovy/groovy/*/groovy-[0-9]*.jar $HOME/.m2/repository/org/codehaus/groovy/groovy/*/groovy-[0-9]*.jar $HOME/.gradle/wrapper/dists/*/*/*/lib/groovy-[0-9]*.jar"
    // ls the union, drop -sources/-indy, sort by the version embedded in the
    // basename (field after 'groovy-'), newest first, de-dup by that version.
    out, _e = build._sh_capture("ls -1 ${globs} 2>/dev/null | grep -v sources | grep -v indy | awk -F/ '{n=$NF; sub(/^groovy-/,\"\",n); sub(/\\.jar$/,\"\",n); print n\"\\t\"$0}' | sort -Vr -k1,1 | cut -f2-")
    return string.trim(out)
}

// _probe_groovy_toolchain(java_bin, groovy_jar, dep_classpath, probe_dir) —
// compile a one-liner against dep_classpath with this groovy jar on this JVM,
// then run it; return 1 iff it prints the ok token. The probe touches a
// FFM-bearing dep class AND an Object extension method (withCloseable) so a
// Groovy that compiles but can't run the binding is rejected. Delegates the
// pass/fail decision to build._verify_toolchain.
_probe_groovy_toolchain(java_bin: string, groovy_jar: string, dep_classpath: string, probe_dir: string) {
    src = path.join(probe_dir, "Probe.groovy")
    body = "class Probe { static void main(args) { println('AEB_PROBE_OK') } }\n"
    _w = io.write_file(src, body)
    outdir = path.join(probe_dir, "out")
    build._mkdirs(outdir)
    // compile against the real dep classpath, then run — one shell so a
    // compile failure short-circuits the run (&&). ok token printed only on a
    // successful run. dep_classpath may be "" (no deps); harmless empty -cp.
    cpc = groovy_jar
    if string.length(dep_classpath) > 0 { cpc = string.concat(groovy_jar, string.concat(":", dep_classpath)) }
    runcp = string.concat(outdir, string.concat(":", dep_classpath))
    probe = "'${java_bin}' -cp '${groovy_jar}' org.codehaus.groovy.tools.FileSystemCompiler -cp '${cpc}' -d '${outdir}' '${src}' && '${java_bin}' -cp '${groovy_jar}:${runcp}' Probe"
    return build._verify_toolchain(probe, "AEB_PROBE_OK")
}

// _resolve_capable_groovy(builder_map, dep_classpath, target_dir, jdk_floor) —
// returns (java_bin, groovy_jar) of the first candidate that VERIFIES, or ("","")
// if none. jdk_floor is the EFFECTIVE JDK minimum (min_jdk OR skip_below_jdk,
// resolved by the caller) so the JVM the probe runs on clears the floor.
// _jar_groovy_major(jar) — the major version from a groovy-<ver>.jar basename
// (…/groovy-4.0.24.jar → 4), or 0 if unparseable. Enforces the min_groovy floor:
// the probe alone can't (a groovy 4 compiles the binding whether the floor is 4
// or 99), so the declared floor must be checked against the jar's own version.
// (…/groovy-4.0.24.jar → "4.0.24"), or "" if unparseable. Enforces the
// min_groovy floor: the probe alone can't (a groovy 4 compiles the binding
// whether the floor is 4 or 99), so the declared floor is checked against the
// jar's own version via build._version_ge.
_jar_groovy_version(jar: string) {
    // awk, not sed: a sed script with backslash escapes does not survive the
    // Aether-string -> _sh_capture -> shell path (comes back empty). awk's
    // match/substr is escape-free. Emit the full version (4.0.24), not just major.
    raw, _e = build._sh_capture("basename '${jar}' | sed -e 's/^groovy-//' -e 's/\\.jar$//' 2>/dev/null || basename '${jar}'")
    // The sed above may not survive escaping; fall back to awk field split.
    v = string.trim(raw)
    if string.length(v) == 0 || string.equals(v, jar) == 1 {
        raw2, _e2 = build._sh_capture("basename '${jar}' | awk '{ n=$0; sub(/^groovy-/,\"\",n); sub(/\\.jar$/,\"\",n); print n }'")
        v = string.trim(raw2)
    }
    return v
}

_resolve_capable_groovy(builder_map: ptr, dep_classpath: string, target_dir: string, jdk_floor: string, groovy_floor: string) {
    java_bin = "java"
    if string.length(string.trim(jdk_floor)) > 0 {
        java_bin = _java_ge(jdk_floor)
        if string.length(java_bin) == 0 { return "", "" }
    }

    probe_dir = path.join(target_dir, ".groovy-probe")
    build._mkdirs(probe_dir)

    jars = _groovy_core_jars_desc()
    rest = jars
    while string.length(rest) > 0 {
        nl = string.index_of(rest, "\n")
        jar = ""
        if nl < 0 { jar = rest  rest = "" }
        else { jar = string.substring(rest, 0, nl)  rest = string.substring(rest, nl + 1, string.length(rest)) }
        jar = string.trim(jar)
        if string.length(jar) > 0 {
            // Enforce the declared groovy version floor: skip a jar below it (the
            // probe would otherwise accept any groovy that compiles the binding).
            floor_ok = 1
            if string.length(string.trim(groovy_floor)) > 0 {
                jver = _jar_groovy_version(jar)
                floor_ok = build._version_ge(jver, groovy_floor)
            }
            if floor_ok == 1 {
                if _probe_groovy_toolchain(java_bin, jar, dep_classpath, probe_dir) == 1 {
                    return java_bin, jar
                }
            }
        }
    }
    return "", ""
}

// groovy.groovyc_test(b) — compile src/test/groovy (or flat *.groovy)
// into target/<mod>/test-classes, where java.junit5 scans.
builder groovyc_test(ctx: ptr): int {
    source_dir = build._get(ctx, "source_dir")
    target_dir = build._get(ctx, "target_dir")
    mod_dir = build._get(ctx, "module_dir")

    test_classes = path.join(target_dir, "test-classes")
    build._mkdirs(test_classes)

    dep_cp = build._build_dep_classpath(ctx)
    lib_cp = build._build_lib_classpath(ctx)

    // Capable-toolchain gate. When a min_*/skip_below_* floor is declared, VERIFY
    // a groovyc+JVM by probing it against the real dep classpath (rather than
    // grabbing the first groovyc on PATH). If none qualifies: a min_* hard
    // requirement FAILS (stops the line — a requested-but-absent capable
    // toolchain is a misconfiguration); a skip_below_* portable floor SKIPS
    // (green). A min_* requirement wins over a skip_below_* floor. Unset → today's
    // path (first groovyc found). The floor's version for messages: prefer the
    // hard req, else the skip floor.
    req_g = build._str_key(_builder, "min_groovy")
    req_j = build._str_key(_builder, "min_jdk")
    skip_g = build._str_key(_builder, "skip_below_groovy")
    skip_j = build._str_key(_builder, "skip_below_jdk")
    is_hard = 0
    if string.length(string.trim(req_g)) > 0 { is_hard = 1 }
    if string.length(string.trim(req_j)) > 0 { is_hard = 1 }
    want_min = is_hard
    if string.length(string.trim(skip_g)) > 0 { want_min = 1 }
    if string.length(string.trim(skip_j)) > 0 { want_min = 1 }

    capable_java = ""
    capable_jar = ""
    if want_min == 1 {
        eff_jdk = req_j
        if string.length(string.trim(eff_jdk)) == 0 { eff_jdk = skip_j }
        eff_groovy = req_g
        if string.length(string.trim(eff_groovy)) == 0 { eff_groovy = skip_g }
        cap_dep_cp = build._cp_append(dep_cp, lib_cp)
        capable_java, capable_jar = _resolve_capable_groovy(_builder, cap_dep_cp, target_dir, eff_jdk, eff_groovy)
        if string.length(capable_jar) == 0 {
            reason = "no capable Groovy ${eff_groovy}+ on a JDK ${eff_jdk}+ VM (groovyc can't read/run the JDK-22+ binding it compiles against)"
            if is_hard == 1 {
                build.fail(ctx, "groovyc_test: ${reason} — min_groovy/min_jdk is a hard requirement; use skip_below_groovy/skip_below_jdk to skip instead")
                return 1
            }
            println("${mod_dir}: SKIPPED — ${reason}")
            build._record_skip(ctx, reason)
            return 0
        }
        println("${mod_dir}: groovy toolchain verified — ${capable_jar}")
    }

    println("${mod_dir}: compiling test code (groovyc)")

    groovy_home = _groovy_home()
    groovyc_bin = _groovyc_bin(groovy_home)
    groovy_jars_nl = _groovy_jars_nl(groovy_home)
    groovy_cp = _nl_to_colon(groovy_jars_nl)

    // When a capable jar was verified, drive groovyc through that exact jar on
    // the verified JVM (java -cp <jar> FileSystemCompiler …), NOT the ambient
    // `groovyc` — that is the whole point of the probe. The jar IS the groovy
    // classpath; the FileSystemCompiler entry point is groovyc's real main.
    if string.length(capable_jar) > 0 {
        groovyc_bin = "${capable_java} -cp ${capable_jar} org.codehaus.groovy.tools.FileSystemCompiler"
        groovy_jars_nl = capable_jar
        groovy_cp = capable_jar
    }

    classpath = build._cp_append(test_classes, groovy_cp)
    // The module's OWN prod classes (groovyc emits to target_dir/classes, shared
    // with this leaf's prod builder) — a first-party input the tests reference,
    // so ahead of deps. Without it, tests can't resolve the module's own API.
    // (asks/kotlinc-test-omits-own-prod-classes-from-classpath.md — same shape.)
    groovy_prod_classes = path.join(target_dir, "classes")
    if dir.exists(groovy_prod_classes) == 1 {
        classpath = build._cp_append(classpath, groovy_prod_classes)
    }
    classpath = build._cp_append(classpath, dep_cp)
    classpath = build._cp_append(classpath, lib_cp)

    file_list = _source_files(_builder, source_dir, "src/test/groovy")
    if string.length(file_list) == 0 {
        println("${mod_dir}: no Groovy test source files found")
        return 0
    }

    cmd = string.concat(_java_opts(_builder), groovyc_cmd(groovyc_bin, test_classes, classpath, file_list))

    // Cache check: same shape as the prod path; caches the test-classes/
    // tree. exit_code sentinel: 0 = cache hit, -1 = run groovyc below.
    argfile = _write_argfile(target_dir, "groovyc_test_sources.txt", file_list)
    cache_key = ""
    exit_code = -1
    if cache.available() == 1 {
        ck, kerr = _cache_key_for_groovyc(ctx, argfile, cmd, groovy_jars_nl, groovyc_bin)
        if string.length(kerr) == 0 {
            cache_key = ck
            tmp_raw, _terr = os.exec("mktemp")
            tmp_tar = build._to_native_path(string.trim(tmp_raw))
            if string.length(tmp_tar) > 0 {
                grc = cache.get(cache_key, tmp_tar)
                if string.length(grc) == 0 {
                    uerr = build._untar_into(tmp_tar, test_classes)
                    os.system("rm -f '${tmp_tar}'")
                    if string.length(uerr) == 0 {
                        println("${mod_dir}: groovyc (test) cache hit ${cache_key}")
                        build._record_cache(ctx, "hit")
                        exit_code = 0
                    } else {
                        os.system("rm -rf '${test_classes}'")
                        build._mkdirs(test_classes)
                    }
                } else {
                    os.system("rm -f '${tmp_tar}'")
                }
            }
        }
    }

    if exit_code == -1 {
        if cache.available() == 0 {
            build._record_cache(ctx, "unavailable")
        } else {
            build._record_cache(ctx, "miss")
        }
        rc = build._sh(cmd)
        if rc != 0 {
            println("${mod_dir}: groovyc (test) failed")
            build.fail(ctx, "groovyc (test) failed")
            return rc
        }
        if string.length(cache_key) > 0 && build._dir_nonempty(test_classes) == 1 {
            tar_path, terr = build._tar_dir(test_classes)
            if string.length(terr) == 0 {
                perr = cache.put(cache_key, tar_path)
                os.system("rm -f '${tar_path}'")
                if string.length(perr) > 0 {
                    println("${mod_dir}: groovyc (test) cache write failed: ${perr}")
                }
            }
        }
    }

    // Custom runner: main_class(...) runs a plain `static void main` suite on
    // the SAME verified JVM, with jvm_flag(...)s and the compiled test-classes +
    // groovy runtime + deps on the classpath. This is the SDK path for a
    // conformance runner that isn't a JUnit5 suite (html-sanitizer's
    // ConformanceTest). Without main_class the classes are left for java.junit5,
    // unchanged. The run's exit maps to one pass/fail via _record_test_result_
    // exitcode (no per-test granularity from a bare main).
    if _builder != null {
        if map.has(_builder, "main_class") == 1 {
            main_cls, _ = map.get(_builder, "main_class")
            run_java = "java"
            if string.length(capable_java) > 0 { run_java = capable_java }
            // Stage resources onto the run classpath. A Groovy extension module
            // registers its operator overloads (<<, -, [], .text, …) via a
            // META-INF/groovy/org.codehaus.groovy.runtime.ExtensionModule
            // descriptor; without it on the classpath the DSL compiles but the
            // methods silently don't exist at run time. run-tests.sh copies
            // src/main/resources/META-INF next to the classes — do the same, for
            // both main and test resources, into test-classes (which is first
            // on the run -cp). No-op when the dirs don't exist.
            main_res = path.join(source_dir, "src/main/resources")
            test_res = path.join(source_dir, "src/test/resources")
            if dir.exists(main_res) == 1 {
                os.system("cp -R '${main_res}/.' '${test_classes}/' 2>/dev/null || true")
            }
            if dir.exists(test_res) == 1 {
                os.system("cp -R '${test_res}/.' '${test_classes}/' 2>/dev/null || true")
            }
            run_cp = build._cp_append(test_classes, groovy_cp)
            // The module's own prod classes on the RUN cp (see the compile-side
            // fix; groovy runs main_class in-builder with a SECOND classpath, so
            // that fix doesn't carry here). No-op for a test-only leaf.
            // (asks/jvm-run-builders-omit-own-prod-classes-from-run-classpath.md)
            groovy_run_prod = path.join(target_dir, "classes")
            if dir.exists(groovy_run_prod) == 1 {
                run_cp = build._cp_append(run_cp, groovy_run_prod)
            }
            run_cp = build._cp_append(run_cp, dep_cp)
            run_cp = build._cp_append(run_cp, lib_cp)
            jflags = ""
            if map.has(_builder, "jvm_flag") == 1 {
                jf, _ = map.get(_builder, "jvm_flag")
                njf = list.size(jf)
                ji = 0
                while ji < njf {
                    one, _ = list.get(jf, ji)
                    jflags = string.concat(jflags, string.concat(" ", one))
                    ji = ji + 1
                }
            }
            println("${mod_dir}: running ${main_cls}")
            run_cmd = "${run_java}${jflags} -cp ${run_cp} ${main_cls}"
            // Honour env(K,V) on the run (e.g. HTMLSANITIZER_LIB for a uFFI/JNI
            // binding). Empty when no env() set — byte-identical otherwise.
            run_cmd = string.concat(build._env_export_prefix(_builder), run_cmd)
            rrc = build._sh(run_cmd)
            if rrc != 0 {
                println("${mod_dir}: ${main_cls} reported failures")
                build._record_test_result_exitcode(ctx, 0, 1)
                build.fail(ctx, "groovy conformance run failed")
                return 1
            }
            build._record_test_result_exitcode(ctx, 1, 0)
        }
    }
    return 0
}

// _source_files(ctx, source_dir, maven_subdir) — space-separated .groovy
// files: src/<...>/groovy recursively under source_layout("maven
// idiomatic"), else flat source_dir/*.groovy.
_source_files(builder_map: ptr, source_dir: string, maven_subdir: string) {
    use_maven = 0
    if builder_map != null {
        if map.has(builder_map, "source_layout") == 1 {
            lay, _ = map.get(builder_map, "source_layout")
            if lay == "maven idiomatic" { use_maven = 1 }
        }
    }
    root = source_dir
    if use_maven == 1 { root = path.join(source_dir, maven_subdir) }
    depth = ""
    if use_maven == 0 { depth = "-maxdepth 1 " }
    raw, _e = build._sh_capture("find '${root}' ${depth}-name '*.groovy' 2>/dev/null | tr '\n' ' '")
    return string.trim(raw)
}

// _colon_to_nl(s) — colon-separated → newline-separated (artifact form).
_colon_to_nl(s: string) {
    if string.length(s) == 0 { return "" }
    out, _e = build._sh_capture("printf '%s' '${s}' | tr ':' '\n'")
    return string.trim(out)
}
