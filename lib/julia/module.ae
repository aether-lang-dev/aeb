// julia — Julia SDK for aeb.
//
// Julia's built-in `ccall` loads a C shared library and calls its flat C ABI
// directly (no glue), so a Julia binding to a native lib needs only the .so on
// the load path (or an absolute path via env). This SDK's test() runs a Julia
// test script (Test stdlib) with env() honored; loud-skips (green) when julia
// is absent.
//
//   import bldr
//   import julia
//   import julia (script)
//   julia.test() {
//       env("SELENIUM_CORE_LIB", lib)
//       script("test/ffi_test.jl")
//   }
import bldr
import std.string
import std.list
import std.map
import std.path
import std.io
import std.os

// script("test/foo.jl") — the Julia test script to run (relative to source_dir).
// Scalar; required.
script(_ctx: ptr, path: string) {
    _e = map.put(_ctx, "julia_script", path)
}

// julia_bin("/path/to/julia") — override the interpreter (default `julia`).
julia_bin(_ctx: ptr, bin: string) {
    _e = map.put(_ctx, "julia_bin", bin)
}

// --- Consumer-manifest setters (for julia.generate_manifest) ---
//
// julia.generate_manifest() EMITS a complete Project.toml for a CONSUMER, the
// same exporter-node pattern as python.package() / gleam.generate_manifest.
// Julia keys deps by UUID (the [deps] table maps name → uuid), with optional
// [compat] version bounds. Setter names are distinct from any julia_<name>
// function to avoid the setter-mangle collision (asks/setter-mangle-collides-
// with-function-name.md).

// manifest_name("Selenium") — the emitted Project.toml `name`. Default "App".
manifest_name(_ctx: ptr, name: string) {
    _e = map.put(_ctx, "manifest_name", name)
}

// manifest_uuid("...") — the emitted `uuid`. Default a placeholder zero-UUID.
manifest_uuid(_ctx: ptr, uuid: string) {
    _e = map.put(_ctx, "manifest_uuid", uuid)
}

// manifest_version("0.8.0") — the emitted `version`. Default "0.1.0".
manifest_version(_ctx: ptr, ver: string) {
    _e = map.put(_ctx, "manifest_version", ver)
}

// julia_pkg_dep("JSON", "682c06a0-de6a-54ab-a142-c8b1cf79cde6", "0.21") — one
// Julia dependency: name, its registry UUID, and a compat bound (may be "").
// Repeatable. Stored "name~uuid~ver".
julia_pkg_dep(_ctx: ptr, name: string, uuid: string, ver: string) {
    if map.has(_ctx, "manifest_julia_deps") == 0 {
        _e1 = map.put(_ctx, "manifest_julia_deps", list.new())
    }
    deps, _ = map.get(_ctx, "manifest_julia_deps")
    entry = string.concat(name, "~")
    entry = string.concat(entry, uuid)
    entry = string.concat(entry, "~")
    entry = string.concat(entry, ver)
    _e2 = list.add(deps, entry)
}

// project_toml_content(opts) — PURE generator of a consumer Project.toml. No
// I/O; unit-tested directly. Emits name/uuid/version, a [deps] name→uuid table,
// and a [compat] table for deps carrying a version bound.
project_toml_content(opts: ptr) {
    name = "App"
    uuid = "00000000-0000-0000-0000-000000000000"
    ver = "0.1.0"
    if opts != null {
        if map.has(opts, "manifest_name") == 1 { name, _ = map.get(opts, "manifest_name") }
        if map.has(opts, "manifest_uuid") == 1 { uuid, _ = map.get(opts, "manifest_uuid") }
        if map.has(opts, "manifest_version") == 1 { ver, _ = map.get(opts, "manifest_version") }
    }
    t = "name = \"${name}\"\nuuid = \"${uuid}\"\nversion = \"${ver}\"\n"

    has_deps = 0
    if opts != null {
        if map.has(opts, "manifest_julia_deps") == 1 {
            deps, _ = map.get(opts, "manifest_julia_deps")
            if list.size(deps) > 0 { has_deps = 1 }
        }
    }
    if has_deps == 1 {
        deps, _ = map.get(opts, "manifest_julia_deps")
        n = list.size(deps)
        // [deps] name = "uuid"
        t = string.concat(t, "\n[deps]\n")
        i = 0
        while i < n {
            entry, _ = list.get(deps, i)
            i = i + 1
            p1 = string.index_of(entry, "~")
            if p1 < 0 { continue }
            dn = string.substring(entry, 0, p1)
            rest = string.substring(entry, p1 + 1, string.length(entry))
            p2 = string.index_of(rest, "~")
            du = rest
            if p2 >= 0 { du = string.substring(rest, 0, p2) }
            t = string.concat(t, "${dn} = \"${du}\"\n")
        }
        // [compat] name = "ver"  (only for deps with a non-empty bound)
        compat = ""
        j = 0
        while j < n {
            entry, _ = list.get(deps, j)
            j = j + 1
            p1 = string.index_of(entry, "~")
            if p1 < 0 { continue }
            dn = string.substring(entry, 0, p1)
            rest = string.substring(entry, p1 + 1, string.length(entry))
            p2 = string.index_of(rest, "~")
            if p2 < 0 { continue }
            dv = string.substring(rest, p2 + 1, string.length(rest))
            if string.length(dv) > 0 { compat = string.concat(compat, "${dn} = \"${dv}\"\n") }
        }
        if string.length(compat) > 0 {
            t = string.concat(t, "\n[compat]\n")
            t = string.concat(t, compat)
        }
    }
    return t
}

// julia.generate_manifest(b) — emit a consumer Project.toml into source_dir and
// publish its path on the "project_toml" artifact edge. Exporter-node
// counterpart of gleam.generate_manifest / python.package. Route via a
// julia/.package.ae (filename-is-the-route).
builder generate_manifest(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")

    bldr._mkdirs(target_dir)

    content = project_toml_content(_builder)
    manifest_path = path.join(source_dir, "Project.toml")
    _ew = io.write_file(manifest_path, content)

    bldr._write_artifact(ctx, "project_toml", manifest_path)
    println("${mod_dir}: generated ${manifest_path}")
    _et = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

_julia_of(bmap: ptr) {
    if bmap != null {
        if map.has(bmap, "julia_bin") == 1 {
            b, _ = map.get(bmap, "julia_bin")
            if string.length(b) > 0 { return b }
        }
    }
    return "julia"
}

// julia_script_cmd(source_dir, julia, scr) — `cd '<dir>' && <julia> --color=no
// '<scr>'`. The pure command test() runs (env prefix rides separately via
// _env_export_prefix). Pure; tested in tests/test_julia_cmd.ae.
julia_script_cmd(source_dir: string, julia: string, scr: string) {
    return "cd '${source_dir}' && ${julia} --color=no '${scr}'"
}

// julia.test() — run the declared Julia script (Test stdlib). Loud-skips when
// julia is absent. env() honored (e.g. SELENIUM_CORE_LIB for a ccall binding).
builder test(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")
    bldr._mkdirs(target_dir)

    julia = _julia_of(_builder)

    // toolchain gate: no julia -> SKIP (green).
    if string.length(os.which(julia)) == 0 {
        reason = "julia not on PATH (install Julia)"
        println("${mod_dir}: SKIPPED — ${reason}")
        bldr._record_skip(ctx, reason)
        return 0
    }

    scr = ""
    if _builder != null {
        if map.has(_builder, "julia_script") == 1 { scr, _ = map.get(_builder, "julia_script") }
    }
    if string.length(scr) == 0 {
        bldr.fail(ctx, "julia.test: script(\"...\") is required")
        return 1
    }

    println("${mod_dir}: running tests (julia)")
    run = julia_script_cmd(source_dir, julia, scr)
    run = string.concat(bldr._env_export_prefix(_builder), run)
    rc = bldr._sh(run)
    if rc != 0 {
        bldr._record_test_result(ctx, 0, 1)
        println("${mod_dir}: tests FAILED")
        bldr.fail(ctx, "tests FAILED")
        return rc
    }
    bldr._record_test_result(ctx, 1, 0)
    println("${mod_dir}: tests PASSED")
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}
