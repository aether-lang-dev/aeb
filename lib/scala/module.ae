// scala — Scala SDK for aether.build
//
// Compiles Scala source via scalac (invoked as java -cp dotty.tools.dotc.Main).
// No scala-cli, sbt, or Bloop required — just Java and Maven-resolved jars.
// Maven deps resolved via the maven module.
import build
import cache
import maven
import std.string
import std.io
import std.os
import std.file
import std.fs
import std.list
import std.map
import std.path
import std.dir

// --- DSL setters ---

// Set Scala version (default: 3.8.2)
scala_version(_ctx: ptr, ver: string) {
    _e = map.put(_ctx, "scala_version", ver)
}

// Set the main class for running
main_class(_ctx: ptr, cls: string) {
    _e = map.put(_ctx, "main_class", cls)
}

// min_jdk(22) — a HARD REQUIREMENT: scalac_test selects a JDK >= this major for
// compile+run and FAILS if none is installed (a requested-but-absent JDK is a
// misconfiguration, not a state to be green in). The SDK already resolves a
// capable Scala 3 compiler via aeb-resolve, so unlike scala/run-tests.sh we
// don't probe scalac — only the JVM matters. Unset → ambient `java`. For a
// portable matrix that should SKIP on under-provisioned boxes, use
// skip_below_jdk.
min_jdk(_ctx: ptr, ver: int) {
    _e = map.put(_ctx, "scala_min_jdk", string.from_int(ver))
}

// skip_below_jdk(22) — PORTABLE-FLEET floor: run on a JDK >= this major, but
// SKIP (green) rather than fail when the box has none. min_jdk (above) is the
// HARD requirement that FAILS when unmet; this is the soft counterpart for a
// heterogeneous conformance matrix. min_jdk wins if both are set.
skip_below_jdk(_ctx: ptr, ver: int) {
    _e = map.put(_ctx, "scala_skip_below_jdk", string.from_int(ver))
}

// jvm_flag("--enable-native-access=ALL-UNNAMED") — one extra flag for the JVM
// that runs main_class (repeatable). Needed by FFM/native-access runners.
jvm_flag(_ctx: ptr, flag: string) {
    if map.has(_ctx, "jvm_flag") == 0 {
        _e1 = map.put(_ctx, "jvm_flag", list.new())
    }
    flags, _ = map.get(_ctx, "jvm_flag")
    _e2 = list.add(flags, flag)
}

// output_jar("app-assembly.jar") — name of the fat jar produced by
// `scala.assembly(b)`. Resolved against `target/<mod>/bin/`. Default
// when unset: `<source_dir_basename>-assembly.jar`. Scalar.
output_jar(_ctx: ptr, name: string) {
    _e = map.put(_ctx, "scala_output_jar", name)
}

// --- Command builders (pure) ---

// scalac_cmd — assemble a Dotty (Scala 3) compile invocation. Pure:
// caller resolves the compiler classpath, output dir, the runtime
// classpath (library + deps + maven), and the @argfile path.
scalac_cmd(compiler_cp: string, classes_dir: string, classpath: string, argfile: string) {
    return "java -cp '${compiler_cp}' dotty.tools.dotc.Main -d '${classes_dir}' -cp '${classpath}' @'${argfile}'"
}

// munit_cmd — assemble a JUnitCore invocation for munit-style Scala
// tests. Pure: caller resolves the runtime classpath and produces a
// space-separated list of fully-qualified test class names.
munit_cmd(classpath: string, class_names: string) {
    return "java -cp '${classpath}' org.junit.runner.JUnitCore ${class_names}"
}

// assembly_unzip_jar_cmd — unzip a single classpath .jar into the
// staging directory so its `.class` files lay flat under stage_dir/.
// `unzip -qq -o` is quiet + overwrite-without-prompt. Pure.
assembly_unzip_jar_cmd(jar_src: string, stage_dir: string) {
    return "unzip -qq -o '${jar_src}' -d '${stage_dir}'"
}

// assembly_copy_classes_cmd — mirror a compiled-classes directory's
// contents into the staging dir. `cp -a` preserves attrs and is
// recursive. The trailing `/.` form copies the directory's contents,
// not the directory itself (so stage_dir gets the class files at top
// level, not nested under another `classes/` folder). Pure.
assembly_copy_classes_cmd(classes_dir: string, stage_dir: string) {
    return "cp -a '${classes_dir}/.' '${stage_dir}/'"
}

// assembly_jar_cmd — `jar cfM <out> -C <stage> .` — bundle the
// staged tree into a single fat jar. `M` skips auto-manifest because
// the caller staged a hand-written MANIFEST.MF under
// stage_dir/META-INF/. Pure.
assembly_jar_cmd(jar_path: string, stage_dir: string) {
    return "jar cfM '${jar_path}' -C '${stage_dir}' ."
}

// --- Internal helpers ---

// Resolve the Scala compiler classpath (compiler + library jars)
_compiler_classpath(ctx: ptr) {
    if map.has(ctx, "_scala_compiler_cp") == 1 {
        v, _ = map.get(ctx, "_scala_compiler_cp")
        return v
    }

    ver = "3.8.2"
    if map.has(ctx, "scala_version") == 1 {
        ver, _ = map.get(ctx, "scala_version")
    }

    aeb_home = os.getenv("AEB_HOME")
    resolver_jar = path.join(aeb_home, "tools/aeb-resolve.jar")
    cmd = "java -jar ${resolver_jar} --output classpath org.scala-lang:scala3-compiler_3:${ver}"
    r_raw, _er = build._sh_capture(cmd)
    result = string.trim(r_raw)
    _e = map.put(ctx, "_scala_compiler_cp", result)
    return result
}

// Resolve the Scala library classpath (needed at compile and runtime)
_library_classpath(ctx: ptr) {
    if map.has(ctx, "_scala_library_cp") == 1 {
        v, _ = map.get(ctx, "_scala_library_cp")
        return v
    }

    ver = "3.8.2"
    if map.has(ctx, "scala_version") == 1 {
        ver, _ = map.get(ctx, "scala_version")
    }

    aeb_home = os.getenv("AEB_HOME")
    resolver_jar = path.join(aeb_home, "tools/aeb-resolve.jar")
    cmd = "java -jar ${resolver_jar} --output classpath org.scala-lang:scala3-library_3:${ver}"
    r_raw, _er = build._sh_capture(cmd)
    result = string.trim(r_raw)
    _e = map.put(ctx, "_scala_library_cp", result)
    return result
}

// _java_version() — `java -version` first line, memoised per build via
// an env-var cache. The scalac action runs `java -cp ... dotc.Main`, so
// the JVM version is a real toolchain-bump invalidator (bytecode target).
// Returns "" when java is absent; key stays deterministic within a run.
_java_version() {
    cached = os.getenv("_AEB_JAVA_VERSION_CACHE")
    if string.length(cached) > 0 { return cached }
    raw, _err = build._sh_capture("java -version 2>&1 | head -1")
    return string.trim(raw)
}

// _cache_key_for_scalac — cache key for a scalac compile action.
// Same contract as java's _cache_key_for_javac, adapted for the
// `java -cp <compiler-cp> dotc.Main` invocation shape. Inputs
// (length-prefixed, sorted via cache.hash_inputs):
//   - java version — the JVM running dotc; bytecode-target invalidator
//   - the resolved Scala COMPILER classpath string — its jar paths
//     embed the pinned scala3-compiler version, so a scala_version
//     bump (or a different resolver result) busts the key
//   - canonical scalac command string — captures -d, the runtime -cp,
//     and the @argfile
//   - each .scala source's path + content hash, sorted by path
//   - each dep's jvm_classpath_deps_including_transitive content
//
// FALSE-HIT HAZARD (same as javac): a sibling dep's classes/ tree can
// change while its classpath string stays the same; the dep artifact
// content hash catches most real changes. Punted to full correctness
// for v1.
//
// Returns ("", err) on any source read failure — caller falls through
// to the live scalac build.
_cache_key_for_scalac(ctx: ptr, argfile_path: string, scalac_cmd_str: string, compiler_cp: string) {
    parts = list.new()

    list.add(parts, string.concat("java:", _java_version()))
    list.add(parts, string.concat("scala-compiler-cp:", compiler_cp))
    list.add(parts, string.concat("cmd:", scalac_cmd_str))

    sources = build._read_argfile_lines(argfile_path)
    nsrc = list.size(sources)
    si = 0
    while si < nsrc {
        src, _ = list.get(sources, si)
        sh, serr = cache.hash_file(src)
        if string.length(serr) > 0 {
            return "", serr
        }
        list.add(parts, string.concat("src:", src))
        list.add(parts, string.concat("src-hash:", sh))
        si = si + 1
    }

    deps, _ = map.get(ctx, "deps")
    dn = list.size(deps)
    di = 0
    while di < dn {
        dp, _ = list.get(deps, di)
        dm = build._strip_lang(dp)
        dep_cp = build._read_dep_artifact(ctx, dm, "jvm_classpath_deps_including_transitive")
        if string.length(dep_cp) > 0 {
            list.add(parts, string.concat("dep:", dm))
            list.add(parts, string.concat("dep-cp:", dep_cp))
        }
        di = di + 1
    }

    digest, derr = cache.hash_inputs(parts)
    return digest, derr
}

// --- SDK functions ---

// Compile Scala sources to .class files via scalac.
builder scalac(ctx: ptr) {
    source_dir = build._get(ctx, "source_dir")
    target_dir = build._get(ctx, "target_dir")
    mod_dir = build._get(ctx, "module_dir")

    classes_dir = path.join(target_dir, "classes")
    build._mkdirs(classes_dir)

    println("${mod_dir}: compiling (scalac)")

    // Find .scala source files (exclude test files)
    argfile = path.join(target_dir, "scalac_sources.txt")
    build._sh("find '${source_dir}' -name '*.scala' ! -name '*.test.scala' ! -name '*Test.scala' ! -name '*Tests.scala' > '${argfile}' 2>/dev/null || true")

    af_raw, _eaf = build._sh_capture("cat '${argfile}'")
    argfile_content = string.trim(af_raw)
    if string.length(argfile_content) == 0 {
        println("${mod_dir}: no .scala source files found")
        _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
        return 0
    }

    // Build compile classpath: classes + deps + maven + scala library
    compiler_cp = _compiler_classpath(ctx)
    library_cp = _library_classpath(ctx)
    dep_cp = build._build_dep_classpath(ctx)
    maven_cp = maven.classpath(ctx)

    cp = classes_dir
    cp = build._cp_append(cp, library_cp)
    cp = build._cp_append(cp, dep_cp)
    cp = build._cp_append(cp, maven_cp)

    cmd = scalac_cmd(compiler_cp, classes_dir, cp, argfile)

    // Cache check: hash sources + compiler-cp + classpath + java
    // version, restore the classes/ tarball on hit and skip scalac.
    // exit_code sentinel: 0 = cache hit, -1 = run scalac below.
    cache_key = ""
    exit_code = -1
    if cache.available() == 1 {
        ck, kerr = _cache_key_for_scalac(ctx, argfile, cmd, compiler_cp)
        if string.length(kerr) == 0 {
            cache_key = ck
            tmp_raw, _terr = build._sh_capture("mktemp")
            tmp_tar = build._to_native_path(string.trim(tmp_raw))
            if string.length(tmp_tar) > 0 {
                grc = cache.get(cache_key, tmp_tar)
                if string.length(grc) == 0 {
                    uerr = build._untar_into(tmp_tar, classes_dir)
                    build._sh("rm -f '${tmp_tar}'")
                    if string.length(uerr) == 0 {
                        println("${mod_dir}: scalac cache hit ${cache_key}")
                        build._record_cache(ctx, "hit")
                        exit_code = 0
                    } else {
                        build._sh("rm -rf '${classes_dir}'")
                        build._mkdirs(classes_dir)
                    }
                } else {
                    build._sh("rm -f '${tmp_tar}'")
                }
            }
        }
    }

    if exit_code == -1 {
        if cache.available() == 0 {
            build._record_cache(ctx, "unavailable")
        } else {
            build._record_cache(ctx, "miss")
        }
        exit_code = build._sh(cmd)
        if exit_code != 0 {
            println("${mod_dir}: scalac failed")
            build.fail(ctx, "scalac failed")
            return exit_code
        }
        if string.length(cache_key) > 0 && build._dir_nonempty(classes_dir) == 1 {
            tar_path, terr = build._tar_dir(classes_dir)
            if string.length(terr) == 0 {
                perr = cache.put(cache_key, tar_path)
                build._sh("rm -f '${tar_path}'")
                if string.length(perr) > 0 {
                    println("${mod_dir}: scalac cache write failed: ${perr}")
                }
            }
        }
    }

    // Write classpath artifact for downstream modules. Must include
    // the transitive build.dep classpath (dep_cp) — the artifact is
    // named "..._including_transitive" and downstream consumers
    // (scala.assembly, a sibling module's scalac) rely on it carrying
    // every dep this module saw at compile time. Omitting dep_cp meant
    // a fat jar lost cross-module classes (e.g. common/SharedCode).
    full_cp = classes_dir
    if string.length(library_cp) > 0 {
        tmp4 = string.concat(full_cp, ":")
        full_cp = string.concat(tmp4, library_cp)
    }
    if string.length(dep_cp) > 0 {
        tmp_dep = string.concat(full_cp, ":")
        full_cp = string.concat(tmp_dep, dep_cp)
    }
    if string.length(maven_cp) > 0 {
        tmp5 = string.concat(full_cp, ":")
        full_cp = string.concat(tmp5, maven_cp)
    }
    build._write_artifact(ctx, "jvm_classpath_deps_including_transitive", full_cp)
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// Compile and run Scala tests.
// Compiles test .scala files, then runs them via JUnit (munit integrates with JUnit).
builder scalac_test(ctx: ptr) {
    source_dir = build._get(ctx, "source_dir")
    target_dir = build._get(ctx, "target_dir")
    mod_dir = build._get(ctx, "module_dir")

    test_classes = path.join(target_dir, "test-classes")
    build._mkdirs(test_classes)

    // JDK gate: min_jdk(N) hard-requires (FAIL if unmet); skip_below_jdk(N) is a
    // portable-fleet floor (SKIP if unmet). Selects the JDK for compile+run.
    // run_java is "" (ambient java) when no floor is declared — downstream
    // commands prefix it only when non-empty, so map the helper's "java" back.
    min_jdk_v = build._int_key(_builder, "scala_min_jdk")
    skip_jdk_v = build._int_key(_builder, "scala_skip_below_jdk")
    sel_java, jdk_status = build._resolve_run_jdk(ctx, mod_dir, min_jdk_v, skip_jdk_v, "the FFM binding")
    if string.equals(jdk_status, "fail") == 1 {
        build.fail(ctx, "scalac_test: no JDK ${min_jdk_v}+ to run the FFM binding on (min_jdk is a hard requirement — use skip_below_jdk to skip instead)")
        return 1
    }
    if string.equals(jdk_status, "skip") == 1 { return 0 }
    run_java = ""
    if string.equals(sel_java, "java") == 0 { run_java = sel_java }

    println("${mod_dir}: compiling test code (scalac)")

    // Find test source files
    argfile = path.join(target_dir, "scalac_test_sources.txt")
    build._sh("find '${source_dir}' -name '*.test.scala' -o -name '*Test.scala' -o -name '*Tests.scala' > '${argfile}' 2>/dev/null || true")

    af_raw, _eaf = build._sh_capture("cat '${argfile}'")
    argfile_content = string.trim(af_raw)
    if string.length(argfile_content) == 0 {
        println("${mod_dir}: no test source files found")
        _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
        return 0
    }

    // Build classpath: test-classes + prod deps + library + maven
    compiler_cp = _compiler_classpath(ctx)
    library_cp = _library_classpath(ctx)
    dep_cp = build._build_dep_classpath(ctx)
    maven_cp = maven.classpath(ctx)

    cp = test_classes
    // The module's OWN prod classes (scalac emits to target_dir/classes, shared
    // with this leaf's prod builder) — a first-party input the tests reference,
    // so ahead of library/deps. Without it, tests can't resolve the module's own
    // Scala API. (asks/kotlinc-test-omits-own-prod-classes-from-classpath.md.)
    scala_prod_classes = path.join(target_dir, "classes")
    if dir.exists(scala_prod_classes) == 1 {
        cp = build._cp_append(cp, scala_prod_classes)
    }
    cp = build._cp_append(cp, library_cp)
    cp = build._cp_append(cp, dep_cp)
    cp = build._cp_append(cp, maven_cp)

    cmd = scalac_cmd(compiler_cp, test_classes, cp, argfile)
    // Run scalac (a plain `java -cp … dotc.Main`) on the selected JDK so it
    // reads the JDK-22+ dependency classes. Rewrite the leading `java ` only.
    if string.length(run_java) > 0 {
        cmd = string.concat("'${run_java}' ", string.substring(cmd, 5, string.length(cmd)))
    }

    // Cache check: same shape as the prod path; caches test-classes/.
    cache_key = ""
    exit_code = -1
    if cache.available() == 1 {
        ck, kerr = _cache_key_for_scalac(ctx, argfile, cmd, compiler_cp)
        if string.length(kerr) == 0 {
            cache_key = ck
            tmp_raw, _terr = build._sh_capture("mktemp")
            tmp_tar = build._to_native_path(string.trim(tmp_raw))
            if string.length(tmp_tar) > 0 {
                grc = cache.get(cache_key, tmp_tar)
                if string.length(grc) == 0 {
                    uerr = build._untar_into(tmp_tar, test_classes)
                    build._sh("rm -f '${tmp_tar}'")
                    if string.length(uerr) == 0 {
                        println("${mod_dir}: scalac (test) cache hit ${cache_key}")
                        build._record_cache(ctx, "hit")
                        exit_code = 0
                    } else {
                        build._sh("rm -rf '${test_classes}'")
                        build._mkdirs(test_classes)
                    }
                } else {
                    build._sh("rm -f '${tmp_tar}'")
                }
            }
        }
    }

    if exit_code == -1 {
        if cache.available() == 0 {
            build._record_cache(ctx, "unavailable")
        } else {
            build._record_cache(ctx, "miss")
        }
        exit_code = build._sh(cmd)
        if exit_code != 0 {
            println("${mod_dir}: scalac (test) failed")
            build.fail(ctx, "scalac (test) failed")
            return exit_code
        }
        if string.length(cache_key) > 0 && build._dir_nonempty(test_classes) == 1 {
            tar_path, terr = build._tar_dir(test_classes)
            if string.length(terr) == 0 {
                perr = cache.put(cache_key, tar_path)
                build._sh("rm -f '${tar_path}'")
                if string.length(perr) > 0 {
                    println("${mod_dir}: scalac (test) cache write failed: ${perr}")
                }
            }
        }
    }

    // Custom runner: main_class(...) runs a `object … { def main }` conformance
    // suite on the selected JVM (or ambient java), with jvm_flag(...)s and the
    // scala-library + deps + test-classes on the classpath. The SDK runs the
    // JVM directly (not the `scala` launcher) so the native-access flag can be
    // added — which means scala-library MUST be on the run -cp explicitly, or
    // the `object` won't load. Without main_class the classes are left for a
    // JUnit-style run, unchanged.
    if _builder != null {
        if map.has(_builder, "main_class") == 1 {
            main_cls, _ = map.get(_builder, "main_class")
            rjava = "java"
            if string.length(run_java) > 0 { rjava = run_java }
            run_cp = build._cp_append(test_classes, library_cp)
            // The module's own prod classes on the RUN cp (see the compile-side
            // fix; scala runs main_class in-builder with a SECOND classpath, so
            // that fix doesn't carry here). No-op for a test-only leaf.
            // (asks/jvm-run-builders-omit-own-prod-classes-from-run-classpath.md)
            scala_run_prod = path.join(target_dir, "classes")
            if dir.exists(scala_run_prod) == 1 {
                run_cp = build._cp_append(run_cp, scala_run_prod)
            }
            run_cp = build._cp_append(run_cp, dep_cp)
            run_cp = build._cp_append(run_cp, maven_cp)
            jflags = ""
            if map.has(_builder, "jvm_flag") == 1 {
                jf, _ = map.get(_builder, "jvm_flag")
                njf = list.size(jf)
                ji = 0
                while ji < njf {
                    one, _ = list.get(jf, ji)
                    jflags = string.concat(jflags, string.concat(" ", one))
                    ji = ji + 1
                }
            }
            println("${mod_dir}: running ${main_cls}")
            run_cmd = "'${rjava}'${jflags} -cp '${run_cp}' ${main_cls}"
            // Honour env(K,V) on the run (e.g. HTMLSANITIZER_LIB for a uFFI/JNI
            // binding). Empty when no env() set — byte-identical otherwise.
            run_cmd = string.concat(build._env_export_prefix(_builder), run_cmd)
            rrc = build._sh(run_cmd)
            if rrc != 0 {
                println("${mod_dir}: ${main_cls} reported failures")
                build._record_test_result_exitcode(ctx, 0, 1)
                build.fail(ctx, "scala conformance run failed")
                return 1
            }
            build._record_test_result_exitcode(ctx, 1, 0)
        }
    }

    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// scala.assembly(b) — produce a single executable fat jar bundling
// this module's compiled classes + scala-library + maven deps + every
// transitive `build.dep` artifact's classpath.
//
// Setters consumed:
//   main_class("App")        — Main-Class attribute (required)
//   output_jar("app.jar")    — output filename (optional; defaults to
//                              `<module>-assembly.jar`)
//
// Resolves classpath entries (one per line in the
// `jvm_classpath_deps_including_transitive` artifact) by unzipping
// each .jar into a staging dir; for directory entries (e.g. another
// module's `classes/`) it `cp -a`s the contents. The hand-written
// MANIFEST.MF goes into `<stage>/META-INF/` so `jar cfM` picks it up.
// Output lands at `target/<mod>/bin/<jar_name>`.
//
// Why this builder exists: scala-cli ships its own `package` step,
// but the migration away from scala-cli wants a no-toolchain
// equivalent. sbt's `assembly` plugin (sbt-assembly) and mill's
// `assembly` task are the upstream analogues. aeb's shape is closer
// to java.shade (which fills the same gap on the Java side), with
// the difference that scala-library MUST be inlined: without it the
// resulting jar exits with `NoClassDefFoundError: scala/Predef`.
builder assembly(ctx: ptr) {
    target_dir = build._get(ctx, "target_dir")
    source_dir = build._get(ctx, "source_dir")
    mod_dir = build._get(ctx, "module_dir")

    if _builder == null {
        println("${mod_dir}: scala.assembly: empty builder block — declare main_class(...)")
        build.fail(ctx, "scala.assembly: empty builder block — declare main_class(...)")
        return 1
    }
    if map.has(_builder, "main_class") == 0 {
        println("${mod_dir}: scala.assembly: missing main_class(\"...\")")
        build.fail(ctx, "scala.assembly: missing main_class(\"...\")")
        return 1
    }
    main_cls, _ = map.get(_builder, "main_class")

    jar_name = ""
    if map.has(_builder, "scala_output_jar") == 1 {
        jar_name, _ = map.get(_builder, "scala_output_jar")
    }
    if string.length(jar_name) == 0 {
        // Default: derive from source_dir's basename.
        base = path.basename(source_dir)
        jar_name = string.concat(base, "-assembly.jar")
    }

    bin_dir = path.join(target_dir, "bin")
    build._mkdirs(bin_dir)
    jar_path = path.join(bin_dir, jar_name)

    // Staging dir under target/<mod>/_assembly/. Nuke and recreate so
    // a previous run's leftovers don't bleed into this jar.
    stage_dir = path.join(target_dir, "_assembly")
    _e1 = build._sh("rm -rf '${stage_dir}'")
    build._mkdirs(stage_dir)

    // Stage this module's compiled classes first.
    classes_dir = path.join(target_dir, "classes")
    if dir.exists(classes_dir) == 1 {
        rc_cls = build._sh(assembly_copy_classes_cmd(classes_dir, stage_dir))
        if rc_cls != 0 {
            println("${mod_dir}: scala.assembly: copying classes failed")
            build.fail(ctx, "scala.assembly: copying classes failed")
            return rc_cls
        }
    }

    // Compose the runtime classpath. Read directly from the
    // `jvm_classpath_deps_including_transitive` artifact that
    // `scala.scalac` writes into the module's target_dir — same shape
    // java.shade uses. The artifact already contains scala-library +
    // every resolved maven dep + this module's own classes, in the
    // exact set scalac used at compile time. Falling back to live
    // re-resolution via maven.classpath / _library_classpath would
    // diverge from the compile-time set on a stale cache.
    cp_file = path.join(target_dir, "jvm_classpath_deps_including_transitive")
    full_cp = ""
    if file.exists(cp_file) == 1 {
        full_cp_raw, _er_cp = io.read_file(cp_file)
        full_cp = string.trim(full_cp_raw)
    }

    // Also fold in any transitive build.dep classpaths the dep walker
    // can resolve — covers cross-module deps where the dep's artifact
    // dir is under a sibling target/<other-mod>/.
    dep_cp = build._build_dep_classpath(ctx)
    if string.length(dep_cp) > 0 {
        if string.length(full_cp) > 0 {
            full_cp = string.concat(full_cp, ":")
        }
        full_cp = string.concat(full_cp, dep_cp)
    }

    // Walk colon-separated classpath. For each entry: if it's a .jar,
    // unzip into stage_dir; if it's a directory, copy its contents.
    // Empty entries (a stray "::") are skipped.
    parts = string.split(full_cp, ":")
    np = string.array_size(parts)
    pi = 0
    while pi < np {
        entry = string.array_get(parts, pi)
        if string.length(entry) > 0 {
            if _ends_with_jar(entry) == 1 {
                rc_uz = build._sh(assembly_unzip_jar_cmd(entry, stage_dir))
                if rc_uz != 0 {
                    println("${mod_dir}: scala.assembly: unzipping ${entry} failed")
                    build.fail(ctx, "scala.assembly: unzipping ${entry} failed")
                    string.array_free(parts)
                    return rc_uz
                }
            } else {
                if dir.exists(entry) == 1 {
                    rc_cp = build._sh(assembly_copy_classes_cmd(entry, stage_dir))
                    if rc_cp != 0 {
                        println("${mod_dir}: scala.assembly: copying ${entry} failed")
                        build.fail(ctx, "scala.assembly: copying ${entry} failed")
                        string.array_free(parts)
                        return rc_cp
                    }
                }
            }
        }
        pi = pi + 1
    }
    string.array_free(parts)

    // Write the manifest into stage/META-INF/.
    meta_dir = path.join(stage_dir, "META-INF")
    build._mkdirs(meta_dir)
    manifest_path = path.join(meta_dir, "MANIFEST.MF")
    mf = string.concat("Manifest-Version: 1.0\nMain-Class: ", main_cls)
    mf = string.concat(mf, "\n")
    _ew = io.write_file(manifest_path, mf)

    println("${mod_dir}: assembling ${jar_name}")
    rc = build._sh(assembly_jar_cmd(jar_path, stage_dir))
    if rc != 0 {
        println("${mod_dir}: scala.assembly: jar command failed")
        build.fail(ctx, "scala.assembly: jar command failed")
        return rc
    }

    println("${mod_dir}: built ${jar_path}")
    println("  run: java -jar ${jar_path}")
    build._write_artifact(ctx, "scala_assembly_jar", jar_path)
    _ts = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// _ends_with_jar(s) — return 1 iff `s` ends in ".jar". Pure.
_ends_with_jar(s: string) {
    sl = string.length(s)
    if sl < 4 { return 0 }
    tail = string.substring(s, sl - 4, sl)
    if string.equals(tail, ".jar") == 1 { return 1 }
    return 0
}

// Run compiled test classes via JUnit (munit integrates with JUnit 4).
builder munit(ctx: ptr) {
    target_dir = build._get(ctx, "target_dir")
    mod_dir = build._get(ctx, "module_dir")

    println("${mod_dir}: running tests (munit)")

    test_classes = path.join(target_dir, "test-classes")

    // Build runtime classpath
    library_cp = _library_classpath(ctx)
    dep_cp = build._build_dep_classpath(ctx)
    maven_cp = maven.classpath(ctx)

    cp = test_classes
    cp = build._cp_append(cp, library_cp)
    cp = build._cp_append(cp, dep_cp)
    cp = build._cp_append(cp, maven_cp)

    // Discover test classes
    cl_raw, _ecl = build._sh_capture("find '${test_classes}' -name '*.class' ! -name '*$*' | sed 's|^${test_classes}/||; s|/|.|g; s|\\.class$||'")
    class_list = string.trim(cl_raw)
    if string.length(class_list) == 0 {
        println("${mod_dir}: no test classes found")
        return 0
    }

    c_raw, _ec = build._sh_capture("echo '${class_list}' | tr '\\n' ' '")
    classes = string.trim(c_raw)
    cmd = munit_cmd(cp, classes)

    exit_code = build._sh(cmd)
    if exit_code != 0 {
        // munit per-test count parsing not yet wired; coarse record.
        build._record_test_result(ctx, 0, 1)
        println("${mod_dir}: tests FAILED")
        build.fail(ctx, "munit tests FAILED")
        return exit_code
    }
    build._record_test_result(ctx, 1, 0)
    println("${mod_dir}: tests PASSED")
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}
