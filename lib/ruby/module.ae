// ruby — Ruby SDK for aether.build
//
// TOOL-NAMED GRAMMAR. The verb names the external tool the node leans on, so a
// call site declares its dependency rather than hiding it — mirroring how
// java.javac (JDK-only) sits beside the Maven-coordinate path. Four verbs:
//
//   ruby.bundle() { ... }   — the Bundler tool. install() resolves the gem
//                             closure (`bundle install`); rspec()/minitest()/
//                             rubocop() run that tool via `bundle exec`. NEEDS
//                             Bundler + a Gemfile.
//   ruby.gem()    { build("foo.gemspec") }  — the `gem` tool: `gem build` → .gem.
//   ruby.rake()   { task("test") }          — the Rake tool: `rake <task>`.
//   ruby.mri()    { test_file("t.rb") }     — NO tool. Plain MRI (`ruby -Ilib
//                             -Ispec -Itest`), env-injected, no Gemfile/Bundler
//                             assumption. The toolchain-only lane for an FFI
//                             binding that wraps a C .so — symmetric with
//                             lua.conformance / python.test's minimal form.
//
// The tool-free ruby.mri() is the point of the tiering: a binding that only
// needs MRI + the engine .so should not be forced through Bundler/gem/rake.
// "alludes to future work where those would be avoided in an invocation."
//
// Project-local isolation: gems install into `${root}/.aeb/bundle/` (parallel to
// lib/python's `.aeb/venv/`). env(K,V) on any verb rides _env_export_prefix (a
// native library path a Fiddle/FFI binding dlopens).
//
// Common shapes:
//
//     ruby.bundle() { install() rspec() }            // resolve + test
//     ruby.gem()    { build("selenium-webdriver.gemspec") }
//     ruby.rake()   { task("compile") task("test") }
//     ruby.mri()    { test_file("test/ffi_test.rb") env("CORE_LIB", lib) }
//
// INTERPRETER. Default is the system Ruby on PATH — unchanged and still the norm.
// To run a node under an rbenv-managed Ruby, DECLARE it — never a silent PATH
// accident. The builder logs the resolved interpreter either way:
//
//     ruby.bundle() { ruby_manager("rbenv") install() rspec() }   // rbenv current
//     ruby.mri()    { ruby_manager("rbenv") ruby_version("3.3.1") test_file("t.rb") }
//     ruby.gem()    { build("foo.gemspec") }                  // system (default)

import bldr
import std.string
import std.io
import std.os
import std.file
import std.fs
import std.list
import std.map
import std.path
import std.dir

// --- shared setters (used across the tool verbs) -----------------------------

// gem_dep("rspec ~> 3.13") — a gem line appended to the Gemfile at bundle
// install time. Repeatable. (Named gem_dep, not gem: `gem` is a top-level verb.)
gem_dep(_ctx: ptr, line: string) {
    if map.has(_ctx, "ruby_gems") == 0 { _e1 = map.put(_ctx, "ruby_gems", list.new()) }
    gems, _ = map.get(_ctx, "ruby_gems")
    _e2 = list.add(gems, line)
}

// gemfile("Gemfile.aeb") — override the default Gemfile location (rel source_dir).
gemfile(_ctx: ptr, path: string) {
    _e = map.put(_ctx, "ruby_gemfile", path)
}

// bundle_path("vendor/bundle") — where `bundle install` writes the closure.
// Default: `${root}/.aeb/bundle`.
bundle_path(_ctx: ptr, dir: string) {
    _e = map.put(_ctx, "ruby_bundle_path", dir)
}

// env(K, V) — an env var exported for the run (e.g. a native .so path an FFI
// binding dlopens). Rides bldr's proc_env / _env_export_prefix like every SDK.
env(_ctx: ptr, k: string, v: string) {
    bldr.env(_ctx, k, v)
}

// ruby_manager("rbenv") — DECLARE which Ruby this node runs under. Default
// (setter absent) is the system Ruby on PATH — unchanged, and still the norm.
// Declaring ruby_manager("rbenv") routes ruby/gem/bundle/rake through `rbenv
// which …` (so an rbenv-managed Ruby is used even though rbenv's shims are NOT
// on the non-interactive PATH aeb's _sh runs under). The builder LOGS the
// resolved interpreter ("using rbenv ruby <ver> at <path>") — never a silent
// PATH accident. Only "rbenv" is understood today; any other value fails loud.
// Pair with ruby_version("3.3.1") to pin a specific installed version.
//
// NB the name is ruby_MANAGER, not ruby_env: inside a `ruby.<verb>() { … }`
// block the compiler mangles the bare `env` setter to `ruby_env`, so a
// function literally named `ruby_env` collides with it — and (as of ae 0.666)
// that collision silently mis-dispatches `env("K","V")` to the 1-arg ruby_env
// and SEGFAULTS in map.put rather than erroring. See asks/
// setter-mangle-collides-with-function-name.md. Keep this name off `*_env`.
ruby_manager(_ctx: ptr, manager: string) { _e = map.put(_ctx, "ruby_env_manager", manager) }

// ruby_version("3.3.1") — pin the version the declared ruby_manager resolves.
// With ruby_manager("rbenv") this exports RBENV_VERSION so `rbenv which` picks
// that install; absent → rbenv's current selection (.ruby-version / global).
// No-op without a ruby_manager() (system Ruby is whatever's on PATH).
ruby_version(_ctx: ptr, version: string) { _e = map.put(_ctx, "ruby_env_version", version) }

// --- ruby.bundle block setters ---

// _reject_node_call — the v0.303 tool-named reshape demoted rspec/install/
// minitest/rubocop from top-level builders to block SETTERS (they live only
// inside `ruby.bundle() { … }`). The OLD form `ruby.rspec() { … }` still
// type-checks — the name resolves — but a setter invoked as a NODE gets the
// graph build ctx auto-injected instead of a fresh block map, and no ruby
// *builder* ever reads it, so it either silently runs nothing or crashes in
// map.put. Either way it's a dishonest "test" node that tested nothing.
//
// This guard makes that a HARD, LOUD error. Discriminator: a fresh block map
// (the correct call site, `map_new()` pushed by the block) carries none of the
// graph-ctx keys; the graph ctx a node receives carries "target_dir" + "_session"
// (bldr sets them at node setup). So `_ctx` holding "target_dir" means the setter
// was called in builder position — abort with the migration hint.
_reject_node_call(_ctx: ptr, verb: string) {
    if _ctx == null { return 0 }
    if map.has(_ctx, "target_dir") == 0 { return 0 }   // fresh block map → correct use
    println("ruby.${verb}() is a block setter, not a builder.")
    println("  The v0.303 tool-named grammar moved it inside ruby.bundle():")
    println("      ruby.bundle() { ${verb}() }")
    println("  (install/rspec/minitest/rubocop are setters of ruby.bundle; the")
    println("   node builders are bundle / mri / rake / gem / consumer_example.)")
    os.exit(1)   // [[noreturn]] — every reachable path already returned above
}

// install() — resolve + install the gem closure (`bundle install`) as part of
// this bundle node.
install(_ctx: ptr) { _r = _reject_node_call(_ctx, "install") _e = map.put(_ctx, "ruby_do_install", "1") }
// rspec() — run RSpec via `bundle exec rspec`.
rspec(_ctx: ptr) { _r = _reject_node_call(_ctx, "rspec") _e = map.put(_ctx, "ruby_do_rspec", "1") }
// minitest() — run Minitest via `bundle exec ruby` (or plain ruby if no Gemfile).
minitest(_ctx: ptr) { _r = _reject_node_call(_ctx, "minitest") _e = map.put(_ctx, "ruby_do_minitest", "1") }
// rubocop() — run RuboCop via `bundle exec rubocop`.
rubocop(_ctx: ptr) { _r = _reject_node_call(_ctx, "rubocop") _e = map.put(_ctx, "ruby_do_rubocop", "1") }

// rspec_arg("--format=doc") — append a CLI arg to `bundle exec rspec`. Repeatable.
rspec_arg(_ctx: ptr, arg: string) {
    if map.has(_ctx, "ruby_rspec_args") == 0 { _e1 = map.put(_ctx, "ruby_rspec_args", list.new()) }
    args, _ = map.get(_ctx, "ruby_rspec_args")
    _e2 = list.add(args, arg)
}
// minitest_file("spec/ffi_test.rb") — a minitest file to run (bundle or mri).
// Repeatable; none set → glob *_test.rb / test_*.rb under spec/ + test/.
minitest_file(_ctx: ptr, path: string) {
    if map.has(_ctx, "ruby_minitest_files") == 0 { _e1 = map.put(_ctx, "ruby_minitest_files", list.new()) }
    files, _ = map.get(_ctx, "ruby_minitest_files")
    _e2 = list.add(files, path)
}
// rubocop_config(".rubocop.yml") — explicit rubocop config (rel source_dir).
rubocop_config(_ctx: ptr, path: string) {
    _e = map.put(_ctx, "ruby_rubocop_config", path)
}

// --- ruby.gem block setters ---

// build("foo.gemspec") — the .gemspec `gem build` packages (rel source_dir).
build(_ctx: ptr, gemspec: string) { _e = map.put(_ctx, "ruby_gemspec", gemspec) }

// --- ruby.rake block setters ---

// task("test") — a rake task to run (`rake <task>`). Repeatable; order preserved.
task(_ctx: ptr, name: string) {
    if map.has(_ctx, "ruby_rake_tasks") == 0 { _e1 = map.put(_ctx, "ruby_rake_tasks", list.new()) }
    l, _ = map.get(_ctx, "ruby_rake_tasks")
    _e2 = list.add(l, name)
}

// --- ruby.mri block setters (tool-free) ---

// test_file("test/ffi.rb") — a .rb to run under plain MRI (-Ilib -Ispec -Itest).
// Repeatable. No Gemfile/Bundler. (Shared list with bundle's minitest_file.)
test_file(_ctx: ptr, path: string) { minitest_file(_ctx, path) }
// mri_flag("-I/abs/inc") — a raw `ruby` flag for the MRI run. Repeatable.
mri_flag(_ctx: ptr, flag: string) {
    if map.has(_ctx, "ruby_mri_flags") == 0 { _e1 = map.put(_ctx, "ruby_mri_flags", list.new()) }
    l, _ = map.get(_ctx, "ruby_mri_flags")
    _e2 = list.add(l, flag)
}

// --- ruby.gem / consumer-example setters ---

consumer_script(_ctx: ptr, path: string) { _e = map.put(_ctx, "consumer_script", path) }
consumer_arg(_ctx: ptr, arg: string) {
    if map.has(_ctx, "consumer_args") == 0 { _e1 = map.put(_ctx, "consumer_args", list.new()) }
    l, _ = map.get(_ctx, "consumer_args")
    _e2 = list.add(l, arg)
}

// --- Command builders (pure) ---

// bundle_install_cmd — `bundle config set --local path <dir> && bundle install`.
// Bundler 2.x dropped `--path=DIR`; the config-set is its replacement. Pure.
bundle_install_cmd(bundle_bin: string, source_dir: string, bundle_path: string) {
    return "cd '${source_dir}' && '${bundle_bin}' config set --local path '${bundle_path}' && '${bundle_bin}' install"
}

// rspec_cmd — `bundle exec rspec [args]`. Pure.
rspec_cmd(bundle_bin: string, source_dir: string, args: string) {
    if string.length(args) == 0 {
        return "cd '${source_dir}' && '${bundle_bin}' exec rspec"
    }
    return "cd '${source_dir}' && '${bundle_bin}' exec rspec ${args}"
}

// minitest_cmd — run minitest files with lib/spec/test on the load path. Each
// file is `-r<basename>` (ruby runs only the first positional; the rest would
// become ARGV). `reqs` pre-joined; empty → glob. Runs under `bundle exec` when a
// Gemfile is present, else plain ruby. `ruby_bin` is the resolved interpreter
// (system or a declared ruby_env). Pure.
minitest_cmd(bundle_bin: string, ruby_bin: string, source_dir: string, reqs: string) {
    load = "-Ilib -Ispec -Itest"
    body = reqs
    if string.length(reqs) == 0 {
        body = "$(for f in spec/*_test.rb spec/test_*.rb test/*_test.rb test/test_*.rb; do [ -f \"$f\" ] && printf ' -r%s' \"$(basename \"$f\" .rb)\"; done)"
    }
    runner = "if [ -f Gemfile ]; then '${bundle_bin}' exec ruby ${load} ${body} -e ''; else '${ruby_bin}' ${load} ${body} -e ''; fi"
    return "cd '${source_dir}' && ${runner}"
}

// mri_cmd — TOOL-FREE: run test files with plain `ruby` (no bundle exec, no
// Gemfile). Same -r<basename> + load-path mechanism as minitest_cmd, plus any
// mri_flag()s; globs when no files named. Pure.
mri_cmd(ruby_bin: string, source_dir: string, reqs: string, extra_flags: string) {
    load = "-Ilib -Ispec -Itest"
    if string.length(extra_flags) > 0 { load = string.concat(load, string.concat(" ", extra_flags)) }
    body = reqs
    if string.length(reqs) == 0 {
        body = "$(for f in spec/*_test.rb spec/test_*.rb test/*_test.rb test/test_*.rb *_test.rb test_*.rb; do [ -f \"$f\" ] && printf ' -r%s' \"$(basename \"$f\" .rb)\"; done)"
    }
    return "cd '${source_dir}' && '${ruby_bin}' ${load} ${body} -e ''"
}

// rubocop_cmd — `bundle exec rubocop [--config cfg]`. Pure.
rubocop_cmd(bundle_bin: string, source_dir: string, config_path: string) {
    if string.length(config_path) == 0 {
        return "cd '${source_dir}' && '${bundle_bin}' exec rubocop"
    }
    return "cd '${source_dir}' && '${bundle_bin}' exec rubocop --config '${config_path}'"
}

// gem_build_cmd — `gem build <basename>` from source_dir (so gemspec `s.files`
// relative paths resolve), then move the .gem into dist_dir. Pure.
gem_build_cmd(gem_bin: string, source_dir: string, gemspec_basename: string, dist_dir: string) {
    return "cd '${source_dir}' && '${gem_bin}' build '${gemspec_basename}' && mv -f *.gem '${dist_dir}/'"
}

// rake_cmd — `rake <task> …` from source_dir, under `bundle exec` when a Gemfile
// is present (a Rakefile's tasks usually need the bundle), else the resolved
// `rake_bin` (system or a declared ruby_env). Pure.
rake_cmd(bundle_bin: string, rake_bin: string, source_dir: string, tasks: string) {
    runner = "if [ -f Gemfile ]; then '${bundle_bin}' exec rake ${tasks}; else '${rake_bin}' ${tasks}; fi"
    return "cd '${source_dir}' && ${runner}"
}

// --- resolvers ---

_resolve_bundle_path(builder_map: ptr, root: string) {
    if builder_map != null {
        if map.has(builder_map, "ruby_bundle_path") == 1 {
            p, _ = map.get(builder_map, "ruby_bundle_path")
            if string.length(p) > 0 {
                if bldr._is_abs_path(p) == 1 { return p }
                return path.join(root, p)
            }
        }
    }
    return path.join(root, ".aeb/bundle")
}

// --- Ruby-interpreter resolution: system PATH (default) vs a declared manager -
//
// Default (no ruby_env()): the system Ruby on PATH — `command -v`, with the
// RubyGems Gem.bin_path fallback for bundle. Declaring ruby_env("rbenv") swaps
// every resolver onto `rbenv which <tool>` so an rbenv-managed Ruby is used even
// though rbenv's shims are off the non-interactive PATH aeb's _sh runs under.
// All of this is LOGGED by the builders (see _announce_ruby_env) — never silent.

// The manager declared on this node, or "" for system Ruby.
_ruby_env_manager(builder_map: ptr) {
    if builder_map == null { return "" }
    if map.has(builder_map, "ruby_env_manager") == 0 { return "" }
    m, _ = map.get(builder_map, "ruby_env_manager")
    return string.trim(m)
}

// The version pinned on this node, or "".
_ruby_env_version(builder_map: ptr) {
    if builder_map == null { return "" }
    if map.has(builder_map, "ruby_env_version") == 0 { return "" }
    v, _ = map.get(builder_map, "ruby_env_version")
    return string.trim(v)
}

// An inline `RBENV_VERSION=<ver> ` prefix for a command, or "" when unpinned.
_rbenv_version_prefix(builder_map: ptr) {
    v = _ruby_env_version(builder_map)
    if v == "" { return "" }
    return "RBENV_VERSION='${v}' "
}

// Locate the rbenv binary for the non-interactive _sh (where rbenv's `init`
// shims are typically NOT on PATH): PATH `rbenv`, then $RBENV_ROOT/bin/rbenv,
// then ~/.rbenv/bin/rbenv. "" if none found.
_rbenv_bin() {
    p, _e = bldr._sh_capture("command -v rbenv 2>/dev/null")
    tp = string.trim(p)
    if tp != "" { return tp }
    r, _re = bldr._sh_capture("if [ -n \"$RBENV_ROOT\" ] && [ -x \"$RBENV_ROOT/bin/rbenv\" ]; then printf %s \"$RBENV_ROOT/bin/rbenv\"; elif [ -x \"$HOME/.rbenv/bin/rbenv\" ]; then printf %s \"$HOME/.rbenv/bin/rbenv\"; fi")
    return string.trim(r)
}

// Resolve `<tool>` to an rbenv path that ESTABLISHES the rbenv environment when
// run. Prefer the rbenv SHIM ($RBENV_ROOT|~/.rbenv/shims/<tool>): a shim run by
// absolute path re-execs through rbenv and sets up RUBYLIB/GEM_HOME/version
// selection, so `bundle install` + `bundle exec` agree on the gem home even off
// PATH. (A bare `rbenv which <tool>` path — the version-dir binary — does NOT do
// this: it falls back to the SYSTEM Ruby's rubygems, so `bundle exec` then can't
// find the just-installed gems — see asks/ruby-rbenv-exec-env-not-established.md.)
// A pinned RBENV_VERSION is honoured by the shim; we still verify via `rbenv
// which` that the tool exists for the resolved version. "" if rbenv/shim absent.
_rbenv_which(builder_map: ptr, tool: string) {
    rb = _rbenv_bin()
    if rb == "" { return "" }
    pfx = _rbenv_version_prefix(builder_map)
    // Confirm the tool resolves for this rbenv version (also validates rbenv).
    chk, _ce = bldr._sh_capture("${pfx}'${rb}' which ${tool} 2>/dev/null")
    // Prefer the shim (self-establishing); fall back to the which-path only if no
    // shims dir exists (older rbenv layout).
    shim, _se = bldr._sh_capture("if [ -n \"$RBENV_ROOT\" ] && [ -x \"$RBENV_ROOT/shims/${tool}\" ]; then printf %s \"$RBENV_ROOT/shims/${tool}\"; elif [ -x \"$HOME/.rbenv/shims/${tool}\" ]; then printf %s \"$HOME/.rbenv/shims/${tool}\"; fi")
    return _prefer_shim(string.trim(shim), string.trim(chk))
}

// _prefer_shim(shim, which) — the pure resolution rule behind _rbenv_which:
// a bare `rbenv which <tool>` path (the version-dir binary) does NOT establish
// the rbenv environment, so `bundle install` and a later `bundle exec` disagree
// on the gem home and exec falls back to the SYSTEM Ruby's rubygems. The shim
// self-establishes the env. So: if `rbenv which` found nothing, the tool isn't
// available for this version → "" (caller falls back to PATH). Else prefer the
// shim when present, and only use the which-path when no shim exists. Pure —
// covered in tests/test_ruby_cmd.ae. See asks/ruby-rbenv-exec-env-not-established.
_prefer_shim(shim: string, which: string) {
    if which == "" { return "" }
    if shim != "" { return shim }
    return which
}

// Resolve one Ruby tool ("ruby"/"gem"/"bundle"/"rake") honouring a declared
// manager. rbenv → `rbenv which`; system (default) → `command -v`.
_resolve_ruby_tool(builder_map: ptr, tool: string) {
    mgr = _ruby_env_manager(builder_map)
    if mgr == "rbenv" {
        w = _rbenv_which(builder_map, tool)
        if w != "" { return w }
        // rbenv declared but couldn't resolve — fall through to PATH so the
        // failure surfaces at the command, but the builder already announced it.
    }
    p, _e = bldr._sh_capture("command -v ${tool} 2>/dev/null")
    return string.trim(p)
}

// Resolve `bundle`: declared manager first, then PATH, then RubyGems' Gem.bin_path
// (modern RubyGems puts `bundle` in a gem bindir often off the non-interactive
// PATH). builder_map selects system (default) vs a declared ruby_env.
_resolve_bundle_bin(builder_map: ptr) {
    t = _resolve_ruby_tool(builder_map, "bundle")
    if t != "" { return t }
    // Gem.bin_path fallback, run under the resolved ruby (rbenv-aware).
    rb = _resolve_ruby_bin(builder_map)
    q, _qe = bldr._sh_capture("'${rb}' -e 'begin; print Gem.bin_path(\"bundler\",\"bundle\"); rescue Exception; end' 2>/dev/null")
    tq = string.trim(q)
    if tq != "" { return tq }
    return "bundle"
}

_resolve_gem_bin(builder_map: ptr) {
    t = _resolve_ruby_tool(builder_map, "gem")
    if t != "" { return t }
    return "gem"
}

// Resolve `ruby` itself (used by mri_cmd and the Gem.bin_path probe).
_resolve_ruby_bin(builder_map: ptr) {
    t = _resolve_ruby_tool(builder_map, "ruby")
    if t != "" { return t }
    return "ruby"
}

// Resolve `rake` (the no-Gemfile branch of rake_cmd).
_resolve_rake_bin(builder_map: ptr) {
    t = _resolve_ruby_tool(builder_map, "rake")
    if t != "" { return t }
    return "rake"
}

// Log the resolved interpreter, loud and once per node, so a declared ruby_env
// is never a silent choice. Prints the manager, pinned version (if any), and
// the absolute `ruby` path actually resolved.
_announce_ruby_env(mod_dir: string, builder_map: ptr) {
    mgr = _ruby_env_manager(builder_map)
    rb = _resolve_ruby_bin(builder_map)
    if mgr == "" {
        println("${mod_dir}: ruby = system (${rb})")
        return 0
    }
    ver = _ruby_env_version(builder_map)
    vshow = ver
    if vshow == "" { vshow = "current" }
    println("${mod_dir}: ruby = ${mgr} ${vshow} (${rb})")
    return 0
}

_rspec_args_str(builder_map: ptr) {
    if builder_map == null { return "" }
    if map.has(builder_map, "ruby_rspec_args") == 0 { return "" }
    args, _ = map.get(builder_map, "ruby_rspec_args")
    n = list.size(args)
    out = ""
    i = 0
    while i < n {
        a, _ = list.get(args, i)
        if i > 0 { out = string.concat(out, " ") }
        out = string.concat(out, a)
        i = i + 1
    }
    return out
}

_minitest_files_str(builder_map: ptr) {
    if builder_map == null { return "" }
    if map.has(builder_map, "ruby_minitest_files") == 0 { return "" }
    files, _ = map.get(builder_map, "ruby_minitest_files")
    n = list.size(files)
    out = ""
    i = 0
    while i < n {
        f, _ = list.get(files, i)
        base = bldr._basename(f)
        if string.ends_with(base, ".rb") == 1 {
            base = string.substring(base, 0, string.length(base) - 3)
        }
        if i > 0 { out = string.concat(out, " ") }
        out = string.concat(out, string.concat("-r", base))
        i = i + 1
    }
    return out
}

// Join a builder-map list of raw tokens into a space-separated string.
_join_toks(builder_map: ptr, key: string) {
    if builder_map == null { return "" }
    if map.has(builder_map, key) == 0 { return "" }
    l, _ = map.get(builder_map, key)
    n = list.size(l)
    out = ""
    i = 0
    while i < n {
        t, _ = list.get(l, i)
        if i > 0 { out = string.concat(out, " ") }
        out = string.concat(out, t)
        i = i + 1
    }
    return out
}

// --- ruby.bundle — the Bundler tool (install + bundle-exec test/lint) --------

builder bundle(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")
    root = bldr._get(ctx, "root")
    source_dir = bldr._get(ctx, "source_dir")
    bldr._mkdirs(target_dir)

    _a = _announce_ruby_env(mod_dir, _builder)
    bundle_bin = _resolve_bundle_bin(_builder)
    ruby_bin = _resolve_ruby_bin(_builder)
    did_test = 0
    tests_ok = 1

    // install() — resolve the gem closure.
    if _builder != null {
        if map.has(_builder, "ruby_do_install") == 1 {
            println("${mod_dir}: installing gems (bundle)")
            bp = _resolve_bundle_path(_builder, root)
            bldr._mkdirs(bp)
            rc = bldr._sh(bundle_install_cmd(bundle_bin, source_dir, bp))
            if rc != 0 {
                println("${mod_dir}: bundle install FAILED")
                bldr.fail(ctx, "bundle install FAILED")
                return rc
            }
        }
    }

    // rspec() — bundle exec rspec.
    if _builder != null {
        if map.has(_builder, "ruby_do_rspec") == 1 {
            println("${mod_dir}: running tests (rspec)")
            did_test = 1
            cmd = string.concat(bldr._env_export_prefix(_builder), rspec_cmd(bundle_bin, source_dir, _rspec_args_str(_builder)))
            if bldr._sh(cmd) != 0 { tests_ok = 0 }
        }
    }

    // minitest() — bundle exec ruby (or plain ruby if no Gemfile).
    if _builder != null {
        if map.has(_builder, "ruby_do_minitest") == 1 {
            println("${mod_dir}: running tests (minitest)")
            did_test = 1
            cmd = string.concat(bldr._env_export_prefix(_builder), minitest_cmd(bundle_bin, ruby_bin, source_dir, _minitest_files_str(_builder)))
            if bldr._sh(cmd) != 0 { tests_ok = 0 }
        }
    }

    // rubocop() — bundle exec rubocop.
    if _builder != null {
        if map.has(_builder, "ruby_do_rubocop") == 1 {
            println("${mod_dir}: linting (rubocop)")
            cfg = ""
            if map.has(_builder, "ruby_rubocop_config") == 1 { cfg, _ = map.get(_builder, "ruby_rubocop_config") }
            if bldr._sh(rubocop_cmd(bundle_bin, source_dir, cfg)) != 0 {
                println("${mod_dir}: lint FAILED")
                bldr.fail(ctx, "lint FAILED")
                return 1
            }
        }
    }

    if did_test == 1 {
        if tests_ok == 0 {
            bldr._record_test_result(ctx, 0, 1)
            println("${mod_dir}: tests FAILED")
            bldr.fail(ctx, "tests FAILED")
            return 1
        }
        bldr._record_test_result(ctx, 1, 0)
        println("${mod_dir}: tests PASSED")
    }
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// --- ruby.mri — the TOOL-FREE lane (plain MRI, no Bundler/gem/rake) ----------

builder mri(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")
    source_dir = bldr._get(ctx, "source_dir")
    bldr._mkdirs(target_dir)
    println("${mod_dir}: running tests (mri — no bundler)")
    _a = _announce_ruby_env(mod_dir, _builder)

    ruby_bin = _resolve_ruby_bin(_builder)
    reqs = _minitest_files_str(_builder)
    flags = _join_toks(_builder, "ruby_mri_flags")
    cmd = string.concat(bldr._env_export_prefix(_builder), mri_cmd(ruby_bin, source_dir, reqs, flags))
    rc = bldr._sh(cmd)
    if rc != 0 {
        bldr._record_test_result(ctx, 0, 1)
        println("${mod_dir}: tests FAILED")
        bldr.fail(ctx, "tests FAILED")
        return rc
    }
    bldr._record_test_result(ctx, 1, 0)
    println("${mod_dir}: tests PASSED")
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// --- ruby.rake — the Rake tool -----------------------------------------------

builder rake(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")
    source_dir = bldr._get(ctx, "source_dir")
    bldr._mkdirs(target_dir)

    tasks = _join_toks(_builder, "ruby_rake_tasks")
    if string.length(tasks) == 0 { tasks = "" }   // bare `rake` (default task)
    println("${mod_dir}: running rake ${tasks}")
    _a = _announce_ruby_env(mod_dir, _builder)
    bundle_bin = _resolve_bundle_bin(_builder)
    rake_bin = _resolve_rake_bin(_builder)
    cmd = string.concat(bldr._env_export_prefix(_builder), rake_cmd(bundle_bin, rake_bin, source_dir, tasks))
    rc = bldr._sh(cmd)
    if rc != 0 {
        println("${mod_dir}: rake FAILED")
        bldr.fail(ctx, "rake FAILED")
        return rc
    }
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// --- ruby.gem — the `gem` tool (build a .gem) --------------------------------

builder gem(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")
    source_dir = bldr._get(ctx, "source_dir")

    if _builder == null {
        bldr.fail(ctx, "ruby.gem: no builder context")
        return 1
    }
    if map.has(_builder, "ruby_gemspec") == 0 {
        println("${mod_dir}: ruby.gem requires build(\"<name>.gemspec\")")
        bldr.fail(ctx, "ruby.gem requires build(\"...gemspec\")")
        return 1
    }
    gemspec_rel, _ = map.get(_builder, "ruby_gemspec")
    gemspec_abs = path.join(source_dir, gemspec_rel)
    if file.exists(gemspec_abs) == 0 {
        println("${mod_dir}: ruby.gem: gemspec not found at ${gemspec_abs}")
        bldr.fail(ctx, "gemspec not found")
        return 1
    }

    dist_dir = path.join(target_dir, "dist")
    bldr._mkdirs(dist_dir)
    println("${mod_dir}: packaging (gem build)")
    _a = _announce_ruby_env(mod_dir, _builder)

    gem_bin = _resolve_gem_bin(_builder)
    gemspec_basename = path.basename(gemspec_rel)
    rc = bldr._sh(gem_build_cmd(gem_bin, source_dir, gemspec_basename, dist_dir))
    if rc != 0 {
        println("${mod_dir}: gem build FAILED")
        bldr.fail(ctx, "gem build FAILED")
        return rc
    }
    println("${mod_dir}: packaging done → ${dist_dir}")
    bldr._write_artifact(ctx, "gem_dir", dist_dir)
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// --- ruby.consumer_example — prove the gem installs + runs from clean --------
// Part of the `gem` tool family (it `gem install`s the dep's built .gem into a
// clean GEM_HOME, then runs the consumer against only the installed gem + its
// bundled .so). Reads the "gem_dir" artifact from the dep'd ruby.gem node.
builder consumer_example(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    source_dir = bldr._get(ctx, "source_dir")
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")
    bldr._mkdirs(target_dir)

    deps, _ = map.get(ctx, "deps")
    gem_dir = ""
    nd = list.size(deps)
    di = 0
    while di < nd {
        dp, _ = list.get(deps, di)
        dm = bldr._strip_lang(dp)
        gd = bldr._read_dep_artifact(ctx, dm, "gem_dir")
        if string.length(gd) > 0 { gem_dir = gd }
        di = di + 1
    }
    if string.length(gem_dir) == 0 {
        bldr.fail(ctx, "ruby.consumer_example: no gem_dir artifact on the dep")
        return 1
    }

    script = ""
    if _builder != null {
        if map.has(_builder, "consumer_script") == 1 { script, _ = map.get(_builder, "consumer_script") }
    }
    if string.length(script) == 0 {
        bldr.fail(ctx, "ruby.consumer_example: consumer_script(\"...\") is required")
        return 1
    }

    gemhome = path.join(target_dir, "consumer-gems")
    bldr._sh("rm -rf '${gemhome}' && mkdir -p '${gemhome}'")
    gi = bldr._sh("gem install --no-document --local --install-dir '${gemhome}' '${gem_dir}'/*.gem")
    if gi != 0 {
        println("${mod_dir}: gem install into clean dir failed")
        bldr.fail(ctx, "gem install failed")
        return 1
    }

    script_abs = path.join(source_dir, script)
    run_dir = path.dirname(script_abs)
    base = "cd '${run_dir}' && env -u SELENIUM_CORE_LIB GEM_HOME='${gemhome}' GEM_PATH='${gemhome}' ruby '${script_abs}'"
    args = null
    if _builder != null {
        if map.has(_builder, "consumer_args") == 1 { args, _ = map.get(_builder, "consumer_args") }
    }
    if args == null {
        if bldr._sh(base) != 0 { bldr.fail(ctx, "consumer run failed"); return 1 }
    } else {
        na = list.size(args)
        ai = 0
        while ai < na {
            a, _ = list.get(args, ai)
            println("${mod_dir}: consumer run (${a})")
            if bldr._sh("${base} ${a}") != 0 {
                println("${mod_dir}: consumer run (${a}) failed")
                bldr.fail(ctx, "consumer run (${a}) failed")
                return 1
            }
            ai = ai + 1
        }
    }
    println("${mod_dir}: PASS — installed gem loaded its bundled .so from clean")
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}
