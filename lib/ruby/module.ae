// ruby — Ruby SDK for aether.build
//
// Drives Bundler, RSpec, RuboCop, and `gem build` against a project
// that ships a Gemfile + (optionally) a .gemspec. Bundler is the
// load-bearing entry point: every other command goes through
// `bundle exec` so the resolved gem closure is in scope.
//
// Project-local isolation: gems install into `.aeb/bundle/` (parallel
// to `lib/python`'s `.aeb/venv/`). Avoids touching the system
// rubygems repo and lets aeb's per-project cache claim the closure.
//
// Common shape:
//
//     import bldr
//     import ruby
//
//     main() {
//         b = bldr.start()
//         ruby.install(b)
//         ruby.rspec(b)
//         ruby.rubocop(b)
//     }
//
// Packaging shape:
//
//     import ruby (gemspec)
//
//     main() {
//         b = bldr.start()
//         ruby.install(b)
//         ruby.package(b) {
//             gemspec("selenium-webdriver.gemspec")
//         }
//     }

import bldr
import std.string
import std.io
import std.os
import std.file
import std.fs
import std.list
import std.map
import std.path
import std.dir

// --- DSL setters ---

// gem("rspec ~> 3.13") — declare a gem to append to the project's
// Gemfile at install time. Repeatable; each entry is one `gem '...'`
// line. Use the bundler-syntax string verbatim (name + optional
// version constraint, possibly groups/platforms). For projects that
// already maintain a Gemfile in-tree, prefer leaving it alone and
// let bundler resolve from there — this setter is for ad-hoc
// additions, the same way `python.pip` is.
gem(_ctx: ptr, line: string) {
    if map.has(_ctx, "ruby_gems") == 0 {
        _e1 = map.put(_ctx, "ruby_gems", list.new())
    }
    gems, _ = map.get(_ctx, "ruby_gems")
    _e2 = list.add(gems, line)
}

// gemfile("Gemfile.aeb") — override the default Gemfile location.
// Path resolved against source_dir. Default: `Gemfile`.
gemfile(_ctx: ptr, path: string) {
    _e = map.put(_ctx, "ruby_gemfile", path)
}

// gemspec("selenium-webdriver.gemspec") — point `ruby.package(b)` at
// the .gemspec file to build. Path resolved against source_dir.
// Required for `ruby.package`; ignored by `ruby.install` /
// `ruby.rspec` / `ruby.rubocop`.
gemspec(_ctx: ptr, path: string) {
    _e = map.put(_ctx, "ruby_gemspec", path)
}

// bundle_path("vendor/bundle") — override the bundle install path
// (where `bundle install --path=<dir>` writes the gem closure).
// Default: `${root}/.aeb/bundle`. Use when interoperating with an
// existing project convention.
bundle_path(_ctx: ptr, dir: string) {
    _e = map.put(_ctx, "ruby_bundle_path", dir)
}

// rspec_arg("--format=doc") — append one CLI argument to the
// `bundle exec rspec` invocation. Repeatable.
rspec_arg(_ctx: ptr, arg: string) {
    if map.has(_ctx, "ruby_rspec_args") == 0 {
        _e1 = map.put(_ctx, "ruby_rspec_args", list.new())
    }
    args, _ = map.get(_ctx, "ruby_rspec_args")
    _e2 = list.add(args, arg)
}

// minitest_file("spec/ffi_test.rb") — a minitest test file to run under
// `ruby.minitest()`. Repeatable. Each file `require`s minitest/autorun, so the
// builder just runs them with -Ilib -Ispec on the load path. When none is set,
// minitest() runs every *_test.rb / test_*.rb under the default test/ + spec/
// dirs (see _minitest_files_str). Minitest is one of Ruby's two standard test
// frameworks; this is its builder alongside rspec().
minitest_file(_ctx: ptr, path: string) {
    if map.has(_ctx, "ruby_minitest_files") == 0 {
        _e1 = map.put(_ctx, "ruby_minitest_files", list.new())
    }
    files, _ = map.get(_ctx, "ruby_minitest_files")
    _e2 = list.add(files, path)
}

// rubocop_config(".rubocop.yml") — explicit rubocop config path.
// Default: rubocop searches upward from source_dir for a
// `.rubocop.yml` (its standard behaviour).
rubocop_config(_ctx: ptr, path: string) {
    _e = map.put(_ctx, "ruby_rubocop_config", path)
}

// ruby_version("3.3") — declared required Ruby major.minor. Today
// this is only echoed in the build log and doesn't gate compilation;
// future work could check `ruby --version` matches.
ruby_version(_ctx: ptr, ver: string) {
    _e = map.put(_ctx, "ruby_version", ver)
}

// --- Command builders (pure) ---

// bundle_install_cmd — `bundle config set --local path <bundle_path>`
// then `bundle install`. Pure.
//
// Bundler 2.x removed the `--path=DIR` flag from `bundle install` (it
// relied on being remembered across invocations, which bundler no
// longer does). The replacement is `bundle config set --local path
// <DIR>` (writes to `<src>/.bundle/config`), followed by a plain
// `bundle install` which reads the path from the local config.
//
// Two-statement compound (`&&` chained) so a config-write failure
// short-circuits the install. Single-quoted args survive paths with
// spaces.
bundle_install_cmd(bundle_bin: string, source_dir: string, bundle_path: string) {
    return "cd '${source_dir}' && '${bundle_bin}' config set --local path '${bundle_path}' && '${bundle_bin}' install"
}

// bundle_exec_cmd — `bundle exec <argv>` from source_dir. The
// `argv_str` is appended verbatim; caller is responsible for any
// shell quoting needed. Pure.
bundle_exec_cmd(bundle_bin: string, source_dir: string, argv_str: string) {
    return "cd '${source_dir}' && '${bundle_bin}' exec ${argv_str}"
}

// rspec_cmd — bundle exec rspec with appended args. args is a
// pre-joined space-separated string (caller built it from the
// rspec_arg list). Empty args → bare `bundle exec rspec`. Pure.
rspec_cmd(bundle_bin: string, source_dir: string, args: string) {
    if string.length(args) == 0 {
        return "cd '${source_dir}' && '${bundle_bin}' exec rspec"
    }
    return "cd '${source_dir}' && '${bundle_bin}' exec rspec ${args}"
}

// minitest_cmd — run minitest files with lib/ + spec/ + test/ on the load path
// (`-Ilib -Ispec -Itest`). Multiple test files can't be passed positionally
// (ruby runs only the first; the rest become ARGV), so each is loaded with a
// `-r<basename>` require against the load path — every file requires
// minitest/autorun, and minitest's at_exit runs all the defined tests once.
// `reqs` is a pre-joined `-r...` string (from _minitest_files_str); when empty,
// a shell glob builds the -r list from *_test.rb / test_*.rb under spec/ + test/.
// Runs under `bundle exec` ONLY when a Gemfile is present (minitest is often
// stdlib-only, no Bundler); otherwise plain `ruby`. Pure.
minitest_cmd(bundle_bin: string, source_dir: string, reqs: string) {
    load = "-Ilib -Ispec -Itest"
    body = reqs
    if string.length(reqs) == 0 {
        // Glob the conventional locations and turn each into `-r<basename>`.
        body = "$(for f in spec/*_test.rb spec/test_*.rb test/*_test.rb test/test_*.rb; do [ -f \"$f\" ] && printf ' -r%s' \"$(basename \"$f\" .rb)\"; done)"
    }
    runner = "if [ -f Gemfile ]; then '${bundle_bin}' exec ruby ${load} ${body} -e ''; else ruby ${load} ${body} -e ''; fi"
    return "cd '${source_dir}' && ${runner}"
}

// rubocop_cmd — bundle exec rubocop, optionally with --config flag.
// Empty config_path → no --config (rubocop searches the tree). Pure.
rubocop_cmd(bundle_bin: string, source_dir: string, config_path: string) {
    if string.length(config_path) == 0 {
        return "cd '${source_dir}' && '${bundle_bin}' exec rubocop"
    }
    return "cd '${source_dir}' && '${bundle_bin}' exec rubocop --config '${config_path}'"
}

// gem_build_cmd — `gem build <basename>` from `source_dir`, then
// move the resulting `.gem` into `<dist_dir>`. Pure.
//
// Why not `cd dist_dir && gem build /abs/path.gemspec`: the gemspec
// has its `s.files` paths resolved against the **cwd** of the gem
// build invocation, not the gemspec's directory. Real-world
// gemspecs (Selenium's included) reference relative paths like
// "LICENSE", "lib/foo.rb"; running gem build from dist_dir would
// fail with "[LICENSE, lib/foo.rb, ...] are not files."
//
// Output `.gem` lands in dist_dir via the `mv` step. `mv -f *.gem`
// requires that source_dir not contain pre-existing `.gem` files
// from a manual gem build; an idempotent build run is the contract.
gem_build_cmd(gem_bin: string, source_dir: string, gemspec_basename: string, dist_dir: string) {
    return "cd '${source_dir}' && '${gem_bin}' build '${gemspec_basename}' && mv -f *.gem '${dist_dir}/'"
}

// --- Internal: ensure bundler-installed dirs exist ---

// Resolve the bundle install path. Returns the absolute path. If
// the builder declared `bundle_path(...)`, use it (resolving
// relative against root). Otherwise default to `<root>/.aeb/bundle`.
_resolve_bundle_path(builder_map: ptr, root: string) {
    if builder_map != null {
        if map.has(builder_map, "ruby_bundle_path") == 1 {
            p, _ = map.get(builder_map, "ruby_bundle_path")
            if string.length(p) > 0 {
                if bldr._is_abs_path(p) == 1 { return p }
                return path.join(root, p)
            }
        }
    }
    return path.join(root, ".aeb/bundle")
}

// Resolve the bundle binary to an absolute path. PATH first (the
// common case: rbenv/rvm/chruby shims, a distro `bundle`), then ask
// Ruby where the bundler gem's `bundle` executable lives. Modern
// RubyGems (bundler ships as a gem, e.g. Ruby 3.4 + bundler 4) puts
// `bundle` in the user gem bindir, which is frequently NOT on the
// non-interactive PATH aeb's `_sh` runs under — so a bare "bundle"
// hits `command not found`. `gem contents bundler` names the actual
// exe file regardless of PATH; `Gem.bin_path` is the RubyGems API for
// the same and is the reliable fallback. Bare "bundle" is the last
// resort so behaviour never regresses when Ruby can't be probed.
_resolve_bundle_bin() {
    p, _e = bldr._sh_capture("command -v bundle 2>/dev/null")
    tp = string.trim(p)
    if tp != "" {
        return tp
    }
    // Ask RubyGems for the bundler gem's `bundle` executable path.
    q, _qe = bldr._sh_capture("ruby -e 'begin; print Gem.bin_path(\"bundler\",\"bundle\"); rescue Exception; end' 2>/dev/null")
    tq = string.trim(q)
    if tq != "" {
        return tq
    }
    return "bundle"
}

_resolve_gem_bin() {
    p, _e = bldr._sh_capture("command -v gem 2>/dev/null")
    tp = string.trim(p)
    if tp != "" {
        return tp
    }
    return "gem"
}

// Build the rspec args string from the accumulated list. Empty list → "".
_rspec_args_str(builder_map: ptr) {
    if builder_map == null { return "" }
    if map.has(builder_map, "ruby_rspec_args") == 0 { return "" }
    args, _ = map.get(builder_map, "ruby_rspec_args")
    n = list.size(args)
    if n == 0 { return "" }
    out = ""
    i = 0
    while i < n {
        a, _ = list.get(args, i)
        if i > 0 { out = string.concat(out, " ") }
        out = string.concat(out, a)
        i = i + 1
    }
    return out
}

// Turn the accumulated minitest_file list into a `-r<basename>` require string
// (files load via the -Ispec/-Itest load path, so the dir + .rb are stripped:
// "spec/ffi_test.rb" -> "-rffi_test"). Empty list -> "" (minitest_cmd globs).
_minitest_files_str(builder_map: ptr) {
    if builder_map == null { return "" }
    if map.has(builder_map, "ruby_minitest_files") == 0 { return "" }
    files, _ = map.get(builder_map, "ruby_minitest_files")
    n = list.size(files)
    if n == 0 { return "" }
    out = ""
    i = 0
    while i < n {
        f, _ = list.get(files, i)
        // basename without .rb
        base = bldr._basename(f)
        if string.ends_with(base, ".rb") == 1 {
            base = string.substring(base, 0, string.length(base) - 3)
        }
        if i > 0 { out = string.concat(out, " ") }
        out = string.concat(out, string.concat("-r", base))
        i = i + 1
    }
    return out
}

// --- SDK functions ---

// Install bundler-managed gems into the project-local bundle path.
// Idempotent at the bundler level: `bundle install` is a no-op when
// Gemfile.lock matches the closure on disk. The `.timestamp` file
// lets aeb's dep-edge handling see "install ran."
builder install(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")
    root = bldr._get(ctx, "root")
    source_dir = bldr._get(ctx, "source_dir")

    bldr._mkdirs(target_dir)
    println("${mod_dir}: installing gems (bundle)")

    bundle = _resolve_bundle_bin()
    bp = _resolve_bundle_path(_builder, root)
    bldr._mkdirs(bp)

    cmd = bundle_install_cmd(bundle, source_dir, bp)
    rc = bldr._sh(cmd)
    if rc != 0 {
        println("${mod_dir}: bundle install FAILED")
        bldr.fail(ctx, "bundle install FAILED")
        return rc
    }
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// Run rspec via bundler. Reads rspec_arg(...) entries.
builder rspec(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")
    source_dir = bldr._get(ctx, "source_dir")

    bldr._mkdirs(target_dir)
    println("${mod_dir}: running tests (rspec)")

    bundle = _resolve_bundle_bin()
    args_str = _rspec_args_str(_builder)
    cmd = string.concat(bldr._env_export_prefix(_builder), rspec_cmd(bundle, source_dir, args_str))
    rc = bldr._sh(cmd)
    if rc != 0 {
        // rspec exits non-zero on test failure; record one logical
        // failure. A future iteration could parse rspec's
        // `--format=json` output for per-example pass/fail counts.
        bldr._record_test_result(ctx, 0, 1)
        println("${mod_dir}: tests FAILED")
        bldr.fail(ctx, "tests FAILED")
        return rc
    }
    bldr._record_test_result(ctx, 1, 0)
    println("${mod_dir}: tests PASSED")
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// Run minitest test files via bundler. The sibling of rspec() for projects that
// use Minitest (Ruby's other standard test framework). Each file requires
// minitest/autorun and self-runs; the builder loads them with -Ilib -Ispec
// -Itest. Files come from minitest_file(); with none set, it globs *_test.rb /
// test_*.rb under spec/ and test/. Honours env(K,V) via _env_export_prefix
// (e.g. a native library path a Fiddle binding dlopens). Ruby exits non-zero if
// any test fails or errors, which the builder propagates as a node failure.
builder minitest(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")
    source_dir = bldr._get(ctx, "source_dir")

    bldr._mkdirs(target_dir)
    println("${mod_dir}: running tests (minitest)")

    bundle = _resolve_bundle_bin()
    files_str = _minitest_files_str(_builder)
    cmd = string.concat(bldr._env_export_prefix(_builder), minitest_cmd(bundle, source_dir, files_str))
    rc = bldr._sh(cmd)
    if rc != 0 {
        bldr._record_test_result(ctx, 0, 1)
        println("${mod_dir}: tests FAILED")
        bldr.fail(ctx, "tests FAILED")
        return rc
    }
    bldr._record_test_result(ctx, 1, 0)
    println("${mod_dir}: tests PASSED")
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// Run rubocop via bundler.
builder rubocop(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")
    source_dir = bldr._get(ctx, "source_dir")

    bldr._mkdirs(target_dir)
    println("${mod_dir}: linting (rubocop)")

    bundle = _resolve_bundle_bin()
    cfg = ""
    if _builder != null {
        if map.has(_builder, "ruby_rubocop_config") == 1 {
            cfg, _ = map.get(_builder, "ruby_rubocop_config")
        }
    }
    cmd = rubocop_cmd(bundle, source_dir, cfg)
    rc = bldr._sh(cmd)
    if rc != 0 {
        println("${mod_dir}: lint FAILED")
        bldr.fail(ctx, "lint FAILED")
        return rc
    }
    println("${mod_dir}: lint PASSED")
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}

// Build a .gem package from a .gemspec. Requires `gemspec("path")`.
// Output lands in `target/<module>/dist/<name>-<version>.gem`.
//
// **Name note:** this builder is `package`, not `gem`, because
// `gem` is also the setter that appends a line to the in-memory
// Gemfile (`gem("rspec ~> 3.13")`). aeb's compile-to-C name
// mangling collides on `ruby_gem` for both, so the builder takes
// the `package` name to match `python.package`'s convention.
// LLM.md § "a builder must not share a name with a function in
// its module" formalises this rule.
builder package(): int {
    ctx = builder_context()
    if ctx == 0 { return 0 }
    target_dir = bldr._get(ctx, "target_dir")
    mod_dir = bldr._get(ctx, "module_dir")
    source_dir = bldr._get(ctx, "source_dir")

    if _builder == null {
        bldr.fail(ctx, "ruby.package: no builder context")
        return 1
    }
    if map.has(_builder, "ruby_gemspec") == 0 {
        println("${mod_dir}: ruby.package requires gemspec(\"<name>.gemspec\")")
        bldr.fail(ctx, "ruby.package requires gemspec")
        return 1
    }
    gemspec_rel, _ = map.get(_builder, "ruby_gemspec")
    gemspec_abs = path.join(source_dir, gemspec_rel)
    if file.exists(gemspec_abs) == 0 {
        println("${mod_dir}: ruby.package: gemspec not found at ${gemspec_abs}")
        bldr.fail(ctx, "gemspec not found")
        return 1
    }

    dist_dir = path.join(target_dir, "dist")
    bldr._mkdirs(dist_dir)
    println("${mod_dir}: packaging (gem build)")

    gem_bin = _resolve_gem_bin()
    gemspec_basename = path.basename(gemspec_rel)
    cmd = gem_build_cmd(gem_bin, source_dir, gemspec_basename, dist_dir)
    rc = bldr._sh(cmd)
    if rc != 0 {
        println("${mod_dir}: gem build FAILED")
        bldr.fail(ctx, "gem build FAILED")
        return rc
    }
    println("${mod_dir}: packaging done → ${dist_dir}")
    // Publish the dist dir (holds the built .gem) so a consumer-install proof
    // (.example) can read it back via dep_artifact(..., "gem_dir").
    bldr._write_artifact(ctx, "gem_dir", dist_dir)
    _ew = io.write_file(path.join(target_dir, ".timestamp"), "")
    return 0
}
