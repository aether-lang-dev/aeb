// Step 1 of 3 — bring a container UP (detached) and wait until it serves.
//
// A three-step container lifecycle expressed as three dep-ordered aeb
// nodes, each an inline-Aether build step (see ../../inline-build-steps.md):
//
//   up   (this file)        -> poke -> down
//
// All three share two constants — the container NAME and host PORT —
// so no artifact hand-off is needed; the `dep()` edges alone guarantee
// up → poke → down ordering. We use the locally-available
// `caddy:2-alpine` image, which serves an HTTP welcome page on :80.
//
// Engine-agnostic: prefers podman, falls back to docker.

import build
import std.os
import std.io
import std.string
import std.path

// Container engine: podman if present, else docker. Inline same-file
// helper, called like any Aether function.
_engine() {
    out, _ = os.exec("command -v podman >/dev/null 2>&1 && echo podman || echo docker")
    return string.trim(out)
}

main() {
    b = build.start()
    eng = _engine()
    name = "aeb-cldemo"
    port = "18080"

    // Idempotent: clear any container left over from a prior run.
    _rm = os.system("${eng} rm -f ${name} >/dev/null 2>&1")

    // Bring it up, detached, mapping host ${port} -> container :80.
    rc = os.system("${eng} run -d --name ${name} -p ${port}:80 caddy:2-alpine >/dev/null")
    if rc != 0 {
        println("up: failed to start ${name}")
        return 1
    }

    // Poll until it actually serves — don't declare "up" on a race.
    ready = 0
    i = 0
    while i < 50 {
        probe = os.system("curl -fsS -o /dev/null http://localhost:${port}/ 2>/dev/null")
        if probe == 0 {
            ready = 1
            i = 50
        } else {
            _s = os.system("sleep 0.2")
            i = i + 1
        }
    }
    if ready == 0 {
        println("up: ${name} never became ready on :${port}")
        _rm2 = os.system("${eng} rm -f ${name} >/dev/null 2>&1")
        return 1
    }

    // Record the endpoint as an artifact (handy for a human; the
    // sibling steps use the shared constants, not this file).
    tdir = build.target_dir(b)
    build.mkdirs(tdir)
    _w = io.write_file(path.join(tdir, "endpoint.txt"), "http://localhost:${port}/")
    println("up: ${name} serving at http://localhost:${port}/")
    return 0
}
