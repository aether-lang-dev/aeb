// Step 2 of 3 — POKE an endpoint inside the running container.
//
// `dep(b, "...up/.build.ae")` (repo-root-relative) orders this after
// the up step, so the container is already serving. We curl the
// endpoint, capture the HTTP status + first body line, and write a
// `response.txt` artifact into this step's target dir (a later archive
// step could bundle it — see ../../inline-build-steps.md).
//
// Returns 0 even on a non-200 so the teardown step ALWAYS runs —
// cleanup shouldn't be skipped by a bad response. The verdict is in
// the log and in response.txt.

import build
import build (dep)
import std.os
import std.io
import std.string
import std.path

main() {
    b = build.start()
    dep(b, "docs/examples/container-lifecycle/up/.build.ae")

    port = "18080"
    url = "http://localhost:${port}/"

    // Poke: capture status code, then the first line of the body.
    status_raw, _ = os.exec("curl -fsS -o /dev/null -w '%{http_code}' '${url}' 2>/dev/null")
    status = string.trim(status_raw)
    body_raw, _ = os.exec("curl -fsS '${url}' 2>/dev/null | head -1")
    body = string.trim(body_raw)

    tdir = build.target_dir(b)
    build.mkdirs(tdir)
    report = "url=${url}\nstatus=${status}\nfirst-line=${body}\n"
    _w = io.write_file(path.join(tdir, "response.txt"), report)

    if string.equals(status, "200") == 1 {
        println("poke: PASS — ${url} -> HTTP ${status}")
    } else {
        println("poke: FAIL — ${url} -> HTTP ${status} (expected 200)")
    }
    return 0
}
